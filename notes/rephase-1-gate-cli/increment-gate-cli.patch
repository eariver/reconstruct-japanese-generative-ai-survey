+    def test_unrelated_same_issue_manuscript_rejected(self) -> None:
+        root, _main_tex, manifest, review_path = self._direct_fixture()
+        manifest_rel = str(manifest.relative_to(root)).replace("\\", "/")
+        review_rel = str(review_path.relative_to(root)).replace("\\", "/")
+
+        # Genuinely validator-valid second same-issue manifest: identical canonical
+        # primary/support, changed permitted accountability metadata, fresh digest.
+        alt_doc = core.load_json(manifest)
+        alt_doc.pop("manifest_sha256")
+        alt_doc["authored_by"] = "synthetic Gate CLI alternate same-issue author"
+        alt_doc["recorded_at"] = "2026-09-14T13:00:00Z"
+        alt_doc["manifest_sha256"] = core.sha256_object(alt_doc)
+        alt_manifest = root / f"sources/{DIRECT_ISSUE}/publication/v2/reader-manuscript-alt-v2.json"
+        core.write_json(alt_manifest, alt_doc)
+
+        selected_validated = reader.validate_manuscript_manifest(root, manifest)
+        alt_validated = reader.validate_manuscript_manifest(root, alt_manifest)
+        self.assertEqual(selected_validated["issue_id"], DIRECT_ISSUE)
+        self.assertEqual(alt_validated["issue_id"], DIRECT_ISSUE)
+        self.assertEqual(alt_validated["primary_source"], selected_validated["primary_source"])
+        self.assertNotEqual(
+            alt_validated["authored_by"], selected_validated["authored_by"]
+        )
+
+        out_rel = f"sources/{DIRECT_ISSUE}/publication/v2/gate-selected.json"
+        proc = self._run_cli(
+            root, ["--manuscript", manifest_rel, "--semantic-authority", review_rel, "--output", out_rel]
+        )
+        self.assertEqual(proc.returncode, 0, msg=proc.stderr)
+        gate_path = root / out_rel
+
+        with self.subTest(case="selected-exact-manuscript-passes"):
