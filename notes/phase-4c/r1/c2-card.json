  "claims": [
    {
      "statement_id": "d-method",
      "text": "DFlashはtargetの複数層のhidden featuresを各draft層のKVへ渡し、block diffusionで一回のpassから複数tokenを提案しtargetが検証する。",
      "subject_id": "dflash",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "dflash-paper-v1"
      ],
      "context": "§3–4.1; distinct conditioning from P-EAGLE"
    },
    {
      "statement_id": "d-training",
      "text": "target生成応答で専用drafterを学習する。埋め込みとLM headを共有・固定し、draft transformerを更新。hidden featuresのoffline保存量は抽出層数に比例する。",
      "subject_id": "dflash",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "dflash-paper-v1"
      ],
      "context": "§4.2, §5, §5.4.3, Appendix A.1; training/storage costs remain"
    },
    {
      "statement_id": "d-serving",
      "text": "論文にはTransformersだけでなくSGLang/FA4、B200 1基、Spec-v2 scheduling overlapでconcurrency 1–32を調べたserving評価がある。",
      "subject_id": "dflash",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "dflash-paper-v1"
      ],
      "context": "§5.3/Table3; Qwen3-4B/8B/Coder30B; baseline vanilla AR"
    },
    {
      "statement_id": "d-eagle-serving",
      "text": "別のLLaMA-3.1-8B評価ではEAGLE-3と同じ学習dataと公式checkpointを用いて比較し、tree draftingに対応するSpec-v1を両者に用いる。",
      "subject_id": "dflash",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "dflash-paper-v1"
      ],
      "context": "§5.4.1/Table4; single B200 Flashinfer; do not conflate with §5.3"
    }
  ],
