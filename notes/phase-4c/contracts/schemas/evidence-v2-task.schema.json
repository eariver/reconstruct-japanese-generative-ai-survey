{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-v2-task.schema.json",
  "title": "Survey Production Core v2 Evidence Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "evidence_task_id", "discovery_ids", "source_records", "verification_targets", "screening_basis"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "evidence_task_id": {"type": "string", "minLength": 1},
    "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verification_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_supplement_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^supplement-src-[0-9a-f]{16}$"}},
    "screening_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screening_acceptance_sha256", "decisions"],
      "properties": {
        "screening_acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["discovery_id", "decision", "scope_tags"],
            "properties": {
              "discovery_id": {"type": "string", "minLength": 1},
              "decision": {"enum": ["KEEP", "MAYBE", "INSPECT"]},
              "scope_tags": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
