{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-v2-card.schema.json",
  "title": "Survey Production Core v2 Factual Evidence Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "evidence_task_id", "basis", "status", "entities", "artifact", "temporal", "sources", "claims", "metrics", "limitations", "verification"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "evidence_task_id": {"type": "string", "minLength": 1},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_sha256", "screening_acceptance_sha256", "prompt_sha256", "result_contract_sha256"],
      "properties": {
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "result_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {"enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"]},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "canonical_name", "entity_type", "organization", "canonical_url"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "canonical_name": {"type": "string", "minLength": 1},
          "entity_type": {"enum": ["MODEL", "MODEL_FAMILY", "VARIANT", "API", "PRODUCT", "AGENT", "FRAMEWORK", "PAPER", "BENCHMARK", "DATASET", "ORGANIZATION", "OTHER"]},
          "organization": {"type": ["string", "null"]},
          "canonical_url": {"type": ["string", "null"]}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_subject_id", "artifact_type", "canonical_name", "canonical_url"],
      "properties": {
        "primary_subject_id": {"type": "string", "minLength": 1},
        "artifact_type": {"enum": ["MODEL", "MODEL_UPDATE", "OPEN_WEIGHT", "API", "PRODUCT", "AGENT", "FRAMEWORK", "PAPER", "BENCHMARK", "DATASET", "SAFETY_EVENT", "SECURITY_EVENT", "INTEGRATION", "OTHER"]},
        "canonical_name": {"type": "string", "minLength": 1},
        "canonical_url": {"type": ["string", "null"]}
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "events"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "event_type", "event_date", "subject_id", "subject_role", "source_ids"],
            "properties": {
              "event_id": {"type": "string", "minLength": 1},
              "event_type": {"type": "string", "minLength": 1},
              "event_date": {"type": ["string", "null"]},
              "subject_id": {"type": "string", "minLength": 1},
              "subject_role": {"$ref": "#/$defs/subject_role"},
              "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "source_class", "title", "published_at", "accessed_at", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["PRIMARY_OFFICIAL", "PRIMARY_PAPER", "PRIMARY_REPOSITORY", "SOCIAL", "SECONDARY"]},
          "title": {"type": "string", "minLength": 1},
          "published_at": {"type": ["string", "null"]},
          "accessed_at": {"type": "string", "format": "date-time"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/bound_statement"}
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "name", "value", "unit", "context", "subject_id", "subject_role", "comparison_subject_ids", "evidence_class", "source_ids"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "unit": {"type": ["string", "null"]},
          "context": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "subject_role": {"$ref": "#/$defs/subject_role"},
          "comparison_subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_class": {"$ref": "#/$defs/evidence_class"},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/bound_statement"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "unresolved_questions", "contradictions"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "status", "finding", "subject_ids", "source_ids"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "status": {"enum": ["VERIFIED", "UNRESOLVED", "CONTRADICTED", "NOT_APPLICABLE"]},
              "finding": {"type": "string", "minLength": 1},
              "subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_class": {"enum": ["PRIMARY_FACT", "VENDOR_CLAIM", "PROJECT_CLAIM", "AUTHOR_CLAIM", "SOCIAL_OBSERVATION", "INFERENCE"]},
    "subject_role": {"enum": ["PRIMARY_SUBJECT", "COMPARATOR", "RELATED"]},
    "bound_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "text", "subject_id", "subject_role", "evidence_class", "source_ids", "context"],
      "properties": {
        "statement_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_role": {"$ref": "#/$defs/subject_role"},
        "evidence_class": {"$ref": "#/$defs/evidence_class"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context": {"type": ["string", "null"]}
      }
    }
  }
}
