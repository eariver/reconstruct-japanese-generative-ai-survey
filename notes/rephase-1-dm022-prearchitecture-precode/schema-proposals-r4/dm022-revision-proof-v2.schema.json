{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dm022-revision-proof-v2.schema.json",
  "title": "DM022 revision proof (deterministic, proposed-bytes only) R4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "revision_id", "revision_root", "manifest", "decision", "before_state", "proposed", "affected_ids", "unaffected_comparison", "validations", "recorded_at", "executor", "revision_proof_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision_root": {"$ref": "#/$defs/safePath"},
    "manifest": {"$ref": "#/$defs/SizedRef"},
    "decision": {"$ref": "#/$defs/SizedRef"},
    "before_state": {"$ref": "#/$defs/SizedRef"},
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "tasks", "cards", "views", "evidence_acceptance", "views_acceptance", "ledger", "completeness", "result_set_sha256", "view_set_sha256"],
      "properties": {
        "package": {"$ref": "#/$defs/SizedRef"},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "views": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "evidence_acceptance": {"$ref": "#/$defs/SizedRef"},
        "views_acceptance": {"$ref": "#/$defs/SizedRef"},
        "ledger": {"$ref": "#/$defs/SizedRef"},
        "completeness": {"$ref": "#/$defs/SizedRef"},
        "result_set_sha256": {"$ref": "#/$defs/sha256"},
        "view_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unaffected_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows_checked", "mechanical_projections"],
      "properties": {
        "rows_checked": {"type": "integer", "minimum": 0},
        "mechanical_projections": {"type": "array", "items": {"$ref": "#/$defs/mechanicalProjection"}}
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "kind", "status", "executor", "evidence", "result"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "kind": {"const": "DETERMINISTIC"},
          "status": {"const": "PASS"},
          "executor": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/SizedRef"}
        }
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1},
    "revision_proof_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$"},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "SizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "NamedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "old_sha256", "new_sha256", "reason"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1},
        "old_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "new_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidenceAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "research_profile", "result_set_sha256", "package_sha256", "screening_acceptance_sha256", "result_count", "results"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
        "result_set_sha256": {"$ref": "#/$defs/sha256"},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "result_count": {"type": "integer", "minimum": 1},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_task_id", "discovery_ids", "sha256", "status", "filename"],
            "properties": {
              "evidence_task_id": {"type": "string", "minLength": 1},
              "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "sha256": {"$ref": "#/$defs/sha256"},
              "status": {"enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"]},
              "filename": {"type": "string", "pattern": "^task-[0-9a-f]{20}\\.json$"}
            }
          }
        }
      }
    },
    "viewsAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "research_profile", "view_set_sha256", "profile_sha256", "evidence_acceptance_sha256", "views"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
        "view_set_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_task_id", "evidence_sha256", "view_sha256", "materiality", "scope_dimensions"],
            "properties": {
              "evidence_task_id": {"type": "string", "minLength": 1},
              "evidence_sha256": {"$ref": "#/$defs/sha256"},
              "view_sha256": {"$ref": "#/$defs/sha256"},
              "materiality": {"enum": ["MATERIAL", "CONTEXT", "NON_MATERIAL", "HOLD"]},
              "scope_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
