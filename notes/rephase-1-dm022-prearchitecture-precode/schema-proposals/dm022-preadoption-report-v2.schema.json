{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dm022-preadoption-report-v2.schema.json",
  "title": "DM022 pre-adoption report (no checkpoint/afterState/guard-hash refs)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "revision_id", "revision_root", "request", "manifest", "proof", "decision", "before_state", "before_checkpoint", "proposed_artifacts", "operation", "producer_boundary", "affected_ids", "mechanical_projections", "tool_pins", "work_ref", "recorded_at", "executor", "preadoption_report_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision_root": {"$ref": "#/$defs/safePath"},
    "request": {"$ref": "#/$defs/SizedRef"},
    "manifest": {"$ref": "#/$defs/SizedRef"},
    "proof": {"$ref": "#/$defs/SizedRef"},
    "decision": {"$ref": "#/$defs/SizedRef"},
    "before_state": {"$ref": "#/$defs/SizedRef"},
    "before_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "materiality", "completeness"],
      "properties": {
        "evidence": {"$ref": "#/$defs/ArtifactRef"},
        "materiality": {"$ref": "#/$defs/ArtifactRef"},
        "completeness": {"$ref": "#/$defs/ArtifactRef"}
      }
    },
    "proposed_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_acceptance", "views_acceptance", "ledger", "completeness"],
      "properties": {
        "evidence_acceptance": {"$ref": "#/$defs/SizedRef"},
        "views_acceptance": {"$ref": "#/$defs/SizedRef"},
        "ledger": {"$ref": "#/$defs/SizedRef"},
        "completeness": {"$ref": "#/$defs/SizedRef"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state"],
      "properties": {
        "from_state": {"const": "EVIDENCE_REVIEWED"},
        "to_state": {"const": "EVIDENCE_REVIEWED"}
      }
    },
    "producer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state"],
      "properties": {
        "from_state": {"const": "CANDIDATES_NORMALIZED"},
        "to_state": {"const": "EVIDENCE_REVIEWED"}
      }
    },
    "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mechanical_projections": {"type": "array", "items": {"$ref": "#/$defs/mechanicalProjection"}},
    "tool_pins": {"$ref": "#/$defs/toolPins"},
    "work_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "tree_sha", "contract"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "tree_sha": {"$ref": "#/$defs/gitsha"},
        "contract": {"$ref": "#/$defs/contract8"}
      }
    },
    "guard_claimed": {"type": "boolean"},
    "guard_path": {"$ref": "#/$defs/safePath"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1},
    "preadoption_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$"},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "SizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "NamedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "old_sha256", "new_sha256", "reason"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1},
        "old_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "new_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_contract_version", "pipeline_contract_sha256", "quality_contract_version", "quality_contract_sha256", "research_profile_version", "research_profile_sha256", "publication_profile_version", "publication_profile_sha256"],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "orchestrator_version", "contract", "tool_shas"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "orchestrator_version": {"type": "string", "minLength": 1},
        "contract": {"$ref": "#/$defs/contract8"},
        "tool_shas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/safePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "roleSchemaRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence-acceptance", "edition-views-acceptance", "materiality-ledger", "profile-completeness", "candidate-matrix", "candidate-selection"],
      "properties": {
        "evidence-acceptance": {"const": "https://example.invalid/schemas/dm022-revision-proof-v2.schema.json#/$defs/proposedEvidence"},
        "edition-views-acceptance": {"const": "https://example.invalid/schemas/dm022-revision-proof-v2.schema.json#/$defs/proposedViews"},
        "materiality-ledger": {"const": "https://github.com/eariver/japanese-generative-ai-survey/schemas/materiality-ledger.schema.json"},
        "profile-completeness": {"const": "https://example.invalid/schemas/profile-completeness-result.schema.json"},
        "candidate-matrix": {"const": "https://github.com/eariver/japanese-generative-ai-survey/schemas/candidate-matrix-v2.schema.json"},
        "candidate-selection": {"const": "https://github.com/eariver/japanese-generative-ai-survey/schemas/candidate-selection-v2.schema.json"}
      }
    },
    "retentionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "revision_id", "rows"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "rows": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "accepted_bound", "gate_bound"],
            "properties": {
              "slot": {"enum": ["candidate-matrix-v2.json", "candidate-selection-v2.json", "architecture-v2.json", "architecture-review-summary-v2.json", "architecture-review-attention-v2.json", "orchestration/v2/interactive/selection-architecture-input.json", "orchestration/v2/interactive/selection-architecture-audit.json"]},
              "source_rel": {"$ref": "#/$defs/safePath"},
              "copy_rel": {"$ref": "#/$defs/safePath"},
              "present": {"type": "boolean"},
              "source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "copy_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "accepted_bound": {"type": "boolean"},
              "gate_bound": {"type": "boolean"}
            }
          }
        }
      }
    },
    "guardIntentCoord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_path", "issue_id", "revision_id", "attempt_nonce", "planned_checkpoint_ref", "before_state_sha256", "expected_after_state_sha256", "work"],
      "properties": {
        "guard_path": {"const": "orchestration/v2/acceptance-revision.guard.json"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "attempt_nonce": {"type": "string", "pattern": "^[0-9a-f]{16,}$"},
        "planned_checkpoint_ref": {"$ref": "#/$defs/SizedRef"},
        "before_state_sha256": {"$ref": "#/$defs/sha256"},
        "expected_after_state_sha256": {"$ref": "#/$defs/sha256"},
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "tree"],
          "properties": {
            "head": {"$ref": "#/$defs/gitsha"},
            "tree": {"$ref": "#/$defs/gitsha"}
          }
        }
      }
    },
    "completionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "revision_id", "attempt_nonce", "checkpoint", "expected_after_state", "seven_plan", "postread", "recorded_at", "executor"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "attempt_nonce": {"type": "string", "pattern": "^[0-9a-f]{16,}$"},
        "checkpoint": {"$ref": "#/$defs/SizedRef"},
        "expected_after_state": {"$ref": "#/$defs/SizedRef"},
        "seven_plan": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "disposition", "captured_sha", "copy_sha"],
            "properties": {
              "slot": {"enum": ["candidate-matrix-v2.json", "candidate-selection-v2.json", "architecture-v2.json", "architecture-review-summary-v2.json", "architecture-review-attention-v2.json", "orchestration/v2/interactive/selection-architecture-input.json", "orchestration/v2/interactive/selection-architecture-audit.json"]},
              "disposition": {"enum": ["cleared", "absent_legitimate"]},
              "captured_sha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "copy_sha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
            }
          }
        },
        "postread": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_sha", "triplet_match", "artifacts_rehashed"],
          "properties": {
            "state_sha": {"$ref": "#/$defs/sha256"},
            "triplet_match": {"const": true},
            "artifacts_rehashed": {"const": true}
          }
        },
        "recorded_at": {"type": "string", "format": "date-time"},
        "executor": {"type": "string", "minLength": 1}
      }
    }
  }
}
