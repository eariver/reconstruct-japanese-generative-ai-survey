+)
+VISIBLE_TEXT = {
+    "frontmatter_boundary": "Evidence / scope boundary",
+    "claim_boundary": "Claim boundary",
+    "summary_kicker": "WEEKLY SYNTHESIS",
+    "references_title": "References / Source Notes",
