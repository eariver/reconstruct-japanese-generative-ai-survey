+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://example.invalid/schemas/weekly-publication-source-manifest-v2.schema.json",
+  "title": "Survey Production Core v2 Weekly Derivation Receipt",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schema_version", "issue_id", "route", "status", "production_state_basis", "accepted_refs", "authored_refs", "reviewed_reader_input", "semantic_review", "current_tools", "outputs", "receipt_sha256"],
+  "properties": {
+    "schema_version": {"const": "2.0-rc1"},
+    "issue_id": {"type": "string", "minLength": 1},
+    "route": {"const": "WEEKLY_GENERATED_V2"},
+    "status": {"const": "ESTABLISHED"},
+    "production_state_basis": {
+      "type": "object", "additionalProperties": false,
+      "required": ["path", "historical_sha256", "lifecycle_state"],
+      "properties": {
+        "path": {"type": "string", "minLength": 1},
+        "historical_sha256": {"$ref": "#/$defs/sha256"},
+        "lifecycle_state": {"type": "string", "minLength": 1}
+      }
+    },
+    "accepted_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedArtifact"}},
+    "authored_refs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/namedArtifact"}},
+    "reviewed_reader_input": {"$ref": "#/$defs/artifact"},
+    "semantic_review": {"$ref": "#/$defs/artifact"},
+    "current_tools": {
+      "type": "object", "additionalProperties": false,
+      "required": ["repository_commit_sha", "contract", "closure"],
+      "properties": {
+        "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
+        "contract": {"type": "object"},
+        "closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedArtifact"}}
+      }
+    },
+    "outputs": {
+      "type": "object", "additionalProperties": false,
+      "required": ["primary", "bibliography", "style"],
+      "properties": {
+        "primary": {"$ref": "#/$defs/artifact"},
+        "bibliography": {"$ref": "#/$defs/artifact"},
+        "style": {"$ref": "#/$defs/artifact"}
+      }
+    },
+    "receipt_sha256": {"$ref": "#/$defs/sha256"}
+  },
+  "$defs": {
+    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
+    "artifact": {
+      "type": "object", "additionalProperties": false,
+      "required": ["path", "sha256"],
+      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
+    },
+    "namedArtifact": {
+      "type": "object", "additionalProperties": false,
+      "required": ["name", "path", "sha256"],
+      "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
+    }
+  }
+}
