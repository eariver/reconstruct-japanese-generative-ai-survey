{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reader-surface-input-v2.schema.json",
  "title": "Survey Production Core v2 Complete Weekly Reader Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "issue_id", "research_profile", "publication_profile", "issue_metadata", "visible_text", "cover", "frontmatter", "closing_synthesis", "final_summary", "packages", "bibliography"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "route": {"const": "WEEKLY_GENERATED_V2"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"const": "WEEKLY"},
    "publication_profile": {"const": "WEEKLY_MAGAZINE"},
    "issue_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "display_date", "window_boundary"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "display_date": {"type": "string", "format": "date"},
        "window_boundary": {"type": "string", "minLength": 1}
      }
    },
    "visible_text": {
      "type": "object", "additionalProperties": false,
      "required": ["frontmatter_boundary", "claim_boundary", "summary_kicker", "references_title", "cover_cutoff_label", "cover_repository_label", "cover_build_label", "repository_value", "build_value", "edition_descriptor", "strapline"],
      "properties": {
        "frontmatter_boundary": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1},
        "summary_kicker": {"type": "string", "minLength": 1},
        "references_title": {"type": "string", "minLength": 1},
        "cover_cutoff_label": {"type": "string", "minLength": 1},
        "cover_repository_label": {"type": "string", "minLength": 1},
        "cover_build_label": {"type": "string", "minLength": 1},
        "repository_value": {"type": "string", "minLength": 1},
        "build_value": {"type": "string", "minLength": 1},
        "edition_descriptor": {"type": "string", "minLength": 1},
        "strapline": {"type": "string", "minLength": 1}
      }
    },
    "cover": {"$ref": "#/$defs/cover"},
    "frontmatter": {"$ref": "#/$defs/frontmatter"},
    "closing_synthesis": {"type": "string", "minLength": 1},
    "final_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "paragraphs": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
      }
    },
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package_id", "section_label", "headline", "deck", "deck_citations", "blocks"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "section_label": {"type": "string", "minLength": 1},
          "headline": {"type": "string", "minLength": 1},
          "deck": {"type": "string", "minLength": 1},
          "deck_citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
          "blocks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["block_id", "block_type", "text", "attribution_mode", "citations"],
              "properties": {
                "block_id": {"type": "string", "minLength": 1},
                "block_type": {"enum": ["HEADING", "PARAGRAPH", "BULLET_LIST", "TABLE", "CLAIM_BOUNDARY", "NOTE"]},
                "text": {"type": "string", "minLength": 1},
                "attribution_mode": {"enum": ["NONE", "FACTUAL", "ATTRIBUTED", "SOCIAL", "INFERENCE", "MIXED"]},
                "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
              }
            }
          }
        }
      }
    },
    "bibliography": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bibliography"}}
  },
  "$defs": {
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "deck", "anchors"],
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "deck": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "frontmatter": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "lede", "scope_notes"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "lede": {"type": "string", "minLength": 1},
        "scope_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery_id", "key"],
      "properties": {
        "discovery_id": {"type": "string", "minLength": 1},
        "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"}
      }
    },
    "bibliography": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery_id", "key", "title", "author", "url", "urldate"],
      "properties": {
        "discovery_id": {"type": "string", "minLength": 1},
        "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "urldate": {"type": "string", "format": "date"}
      }
    }
  }
}
