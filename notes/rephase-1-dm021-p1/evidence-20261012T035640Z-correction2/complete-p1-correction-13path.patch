+def _load_profile(col: _Collector, state: dict[str, Any]) -> dict[str, Any]:
+    prof_ref = state.get("profile") or {}
+    if not isinstance(prof_ref, dict) or set(prof_ref) != {"path", "sha256"}:
+        raise _fail("STATE_PROFILE_SHAPE", "State lacks exact Production Profile reference")
+    profile_path = col.safe(prof_ref["path"], "Production Profile")
+    rel = col.rel(profile_path)
+    if core.sha256_bytes(col.files[rel]) != prof_ref.get("sha256"):
+        raise _fail("PROFILE_DRIFT", "State-bound Production Profile bytes drifted")
+    try:
+        profile = json.loads(col.files[rel].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("PROFILE_UNREADABLE", f"Production Profile not JSON: {exc}") from exc
+    if profile.get("issue_id") != state.get("issue_id"):
+        raise _fail("PROFILE_ISSUE_MISMATCH", "Production Profile/State issue identity mismatch")
+    return profile
