+def _assert_no_write_except(testcase: unittest.TestCase, before: dict, after: dict,
+                            excluded: tuple[str, ...] = ()) -> None:
+    """No tree/Git mutation except the explicitly injected file itself.
+
+    The deliberately mutated dependency is excluded from the comparison
+    explicitly (callers name it); every other file/dir/symlink and the fixture
+    HEAD must be identical. Repairs happen only after this assertion.
+    """
+    excluded_set = set(excluded)
+    for key in ("files", "dirs", "symlinks"):
+        b = before[key] if key == "dirs" else {k: v for k, v in before[key].items() if k not in excluded_set}
+        a = after[key] if key == "dirs" else {k: v for k, v in after[key].items() if k not in excluded_set}
+        if key == "dirs":
+            testcase.assertEqual(sorted(a), sorted(b), f"unexpected {key} delta")
+        else:
+            testcase.assertEqual(a, b, f"unexpected {key} delta")
+    testcase.assertEqual(after["git"]["head"], before["git"]["head"])
