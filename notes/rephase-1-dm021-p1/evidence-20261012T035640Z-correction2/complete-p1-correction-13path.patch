+        _assert_no_write_except(self, before, _snapshot(self.root), (control_rel,))
+        control_file.write_bytes(control_saved)
+        # (j) P3 post-write seam: same unlisted control drift lands during the
+        # final source write — outputs complete, but the before-receipt recheck
+        # refuses with the retained set and no final receipt.
+        real_write_j = longform_publication._write_bytes_exclusive
+        writes_seen: list[str] = []
+
+        def _drift_control_on_last_write(path: Path, data: bytes, label: str) -> None:
+            writes_seen.append(str(path))
+            if len(writes_seen) == 4:
+                with control_file.open("a", encoding="utf-8") as handle:
+                    handle.write("\n# synthetic unlisted-control drift (post-write seam)\n")
+            return real_write_j(path, data, label)
+
+        before = _snapshot(self.root)
+        with mock.patch.object(longform_publication, "_write_bytes_exclusive",
+                               side_effect=_drift_control_on_last_write):
+            with mock.patch.object(sys, "argv", argv_pass2):
+                with self.assertRaisesRegex(SystemExit, "implementation-control.*drift"):
+                    longform_publication.main()
+        post_outputs = (self.survey_root / "main.tex", self.survey_root / "references.bib",
+                        self.survey_root / "jgaisurvey.sty",
+                        self.publication_root / "interactive-semantic-publication-input.json")
+        for path in post_outputs:
+            self.assertTrue(path.is_file(), f"retained output missing: {path.name}")
+        self.assertFalse((self.publication_root / "validated-source-manifest.json").exists())
+        self.assertEqual(control_file.read_bytes(), control_saved + b"\n# synthetic unlisted-control drift (post-write seam)\n")
+        _assert_no_write_except(self, before, _snapshot(self.root),
+                                (control_rel, *(str(p.relative_to(self.root)) for p in post_outputs)))
+        control_file.write_bytes(control_saved)
+        with mock.patch.object(sys, "argv", argv_pass2):
