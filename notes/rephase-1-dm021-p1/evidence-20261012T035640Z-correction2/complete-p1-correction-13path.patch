+def _assert_transitives_expected_set(testcase: unittest.TestCase, root: Path,
+                                     source_root: Path, prepared: dict) -> None:
+    # C1 independent oracle: EXPECTEDPATHSET from REAL fixture filesystem
+    # (known parent dirs + implicit paths), NOT from receipt.accepted_refs.
+    # Proves each transitive in graph/retention with proper policy and frozen
+    # inclusion/exclusion.
+    graph = prepared["graph"]
+    frozen = prepared["frozen"]
+    nodes_by_path = {n["path"]: n for n in graph["nodes"]}
+    frozen_by_path = {}
+    for row in frozen:
+        frozen_by_path.setdefault(row["path"], set()).add(row["kind"])
+    # Checkpoint wrappers via known dir (independent, not receipt list).
+    cp_dir = source_root / "orchestration" / "v2" / "checkpoints"
+    testcase.assertTrue(cp_dir.is_dir(), "checkpoint dir missing for C1 oracle")
+    for child in sorted(cp_dir.iterdir()):
+        if not child.is_file() or child.suffix != ".json":
+            continue
+        rel = str(child.relative_to(root).as_posix())
+        testcase.assertIn(rel, nodes_by_path, f"checkpoint wrapper missing in graph: {rel}")
+        node = nodes_by_path[rel]
+        testcase.assertIn("KEEP_IMMUTABLE", [node["policy"]])
+        testcase.assertTrue(any(r.startswith("checkpoint-wrapper:") for r in node["roles"]),
+                            f"wrapper roles missing: {rel}")
+        testcase.assertNotIn(rel, frozen_by_path, f"wrapper must stay operational (not frozen): {rel}")
+    # Evidence package/tasks via known runs dirs (independent glob, not receipt list).
+    for pkg in sorted((source_root / "evidence" / "v2" / "runs").glob("*/package.json")):
+        rel = str(pkg.relative_to(root).as_posix())
+        testcase.assertIn(rel, nodes_by_path, f"evidence package missing: {rel}")
+        testcase.assertEqual(nodes_by_path[rel]["policy"], "KEEP_IMMUTABLE")
+        testcase.assertIn(rel, frozen_by_path, f"evidence package must be frozen: {rel}")
+        run_dir = pkg.parent
+        for task in sorted((run_dir / "tasks").glob("*.json")):
+            trel = str(task.relative_to(root).as_posix())
+            testcase.assertIn(trel, nodes_by_path, f"evidence task missing: {trel}")
+            testcase.assertEqual(nodes_by_path[trel]["policy"], "KEEP_IMMUTABLE")
+            testcase.assertIn(trel, frozen_by_path, f"evidence task must be frozen: {trel}")
+    # Screening acceptance/package/results/batches via known runs dirs.
+    for sacc in sorted((source_root / "screening" / "v2" / "runs").glob("*/screening-accepted.json")):
+        rel = str(sacc.relative_to(root).as_posix())
+        testcase.assertIn(rel, nodes_by_path, f"screening acceptance missing: {rel}")
+        testcase.assertIn(rel, frozen_by_path, f"screening acceptance must be frozen: {rel}")
+        run_dir = sacc.parent
+        pkg = run_dir / "package.json"
+        if pkg.is_file():
+            prel = str(pkg.relative_to(root).as_posix())
+            testcase.assertIn(prel, nodes_by_path, f"screening package missing: {prel}")
+            testcase.assertIn(prel, frozen_by_path)
+        for res in sorted((run_dir / "results").glob("*.json")):
+            rrel = str(res.relative_to(root).as_posix())
+            testcase.assertIn(rrel, nodes_by_path, f"screening result missing: {rrel}")
+            testcase.assertIn(rrel, frozen_by_path)
+        for batch in sorted((run_dir / "input" / "batches").glob("*.jsonl")):
+            brel = str(batch.relative_to(root).as_posix())
+            testcase.assertIn(brel, nodes_by_path, f"screening batch missing: {brel}")
+            testcase.assertIn(brel, frozen_by_path)
+    # Discovery raw + completeness via known implicit paths (independent, not receipt).
+    for implicit, must_frozen in (("discovery/discovery.jsonl", True),
+                                  ("profile-completeness.json", True),
+                                  ("profile-completeness-v2.json", False)):
+        cand = source_root / implicit
+        if not cand.is_file():
+            continue
+        rel = str(cand.relative_to(root).as_posix())
+        testcase.assertIn(rel, nodes_by_path, f"implicit upstream missing: {rel}")
+        if must_frozen:
+            testcase.assertIn(rel, frozen_by_path, f"implicit upstream must be frozen: {rel}")
+    # Exclusion: State wrappers/QA/tool/pub outputs must stay out of frozen.
+    for row in frozen:
+        testcase.assertFalse(row["path"].endswith("production-state.json"), "State must stay operational")
+        testcase.assertFalse("orchestration/v2/checkpoints" in row["path"], "wrappers must stay operational")
+        testcase.assertFalse("/quality/" in row["path"] and "subject-entity" in row["path"], "QA must stay excluded")
+        testcase.assertFalse(row["path"].endswith("validated-source-manifest.json"), "receipt must stay operational")
+        testcase.assertFalse("publication-candidate-v2.json" in row["path"], "candidate must stay operational")
