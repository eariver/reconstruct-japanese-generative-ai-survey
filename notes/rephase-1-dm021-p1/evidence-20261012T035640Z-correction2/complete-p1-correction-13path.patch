+    def test_alias_outside_sentinel_never_opened(self) -> None:
+        # P1 read observation: State leaf and input parent aliases pointing at
+        # outside FIFO sentinels must refuse via containment BEFORE any content
+        # read. A FIFO blocks its opener until a writer appears, so any read
+        # attempt would hang: the test runs main() in a daemon thread with a
+        # join timeout and fails if the call does not refuse promptly. On
+        # timeout the FIFO is unblocked via a write-end open purely for cleanup.
+        chain = self._complete(self._chain())
+        state_path = self._state_path(chain)
+
+        def _run_main(argv: list[str]) -> tuple[threading.Thread, dict]:
+            box: dict = {}
+
+            def _target() -> None:
+                try:
+                    with mock.patch.object(sys, "argv", argv):
+                        box["rc"] = longform_publication.main()
+                except SystemExit as exc:
+                    box["exit"] = exc.code
+                except BaseException as exc:  # pragma: no cover - diagnostic only
+                    box["error"] = repr(exc)
+
+            thread = threading.Thread(target=_target, daemon=True)
+            thread.start()
+            return thread, box
+
+        def _unblock_fifo(fifo: Path) -> None:
+            try:
+                fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
+                os.close(fd)
+            except OSError:
+                pass
+
+        # State leaf alias -> outside FIFO.
+        outside = self.root / "outside-sneak"
+        outside.mkdir(exist_ok=True)
+        fifo_state = outside / "state-fifo.json"
+        if fifo_state.exists() or os.path.lexists(fifo_state):
+            os.unlink(fifo_state)
+        os.mkfifo(fifo_state)
+        alias_state = chain["source_root"] / "alias-state.json"
+        os.symlink(str(fifo_state), str(alias_state))
+        try:
+            before = _snapshot(self.root)
+            argv = ["survey_longform_semantic_publication_v2.py", "--repo-root", str(self.root),
+                    "--state", str(alias_state.relative_to(self.root)), "--input",
+                    str(chain["authored_path"].relative_to(self.root)), "--materialize-surface-only"]
+            thread, box = _run_main(argv)
+            thread.join(timeout=120)
+            if thread.is_alive():
+                _unblock_fifo(fifo_state)
+                thread.join(timeout=30)
+                self.fail("State alias-to-FIFO call blocked: sentinel was opened for read")
+            self.assertIn("exit", box)
+            self.assertRegex(str(box["exit"]), "leaf alias is unsafe|containment invalid")
+            self.assertEqual(_snapshot(self.root), before)
+        finally:
+            if os.path.lexists(alias_state):
+                os.unlink(alias_state)
+            if os.path.lexists(fifo_state):
+                os.unlink(fifo_state)
+        # Input parent alias -> outside directory holding a FIFO input file.
+        outside_in = self.root / "outside-in"
+        outside_in.mkdir(exist_ok=True)
+        fifo_input = outside_in / "semantic-publication-input.json"
+        if fifo_input.exists() or os.path.lexists(fifo_input):
+            os.unlink(fifo_input)
+        os.mkfifo(fifo_input)
+        alias_parent = chain["source_root"] / "alias-in-parent"
+        os.symlink(str(outside_in), str(alias_parent))
+        try:
+            before = _snapshot(self.root)
+            argv = ["survey_longform_semantic_publication_v2.py", "--repo-root", str(self.root),
+                    "--state", str(state_path.relative_to(self.root)), "--input",
+                    str((alias_parent / "semantic-publication-input.json").relative_to(self.root)),
+                    "--materialize-surface-only"]
+            thread, box = _run_main(argv)
+            thread.join(timeout=120)
+            if thread.is_alive():
+                _unblock_fifo(fifo_input)
+                thread.join(timeout=30)
+                self.fail("Input parent-alias-to-FIFO call blocked: sentinel was opened for read")
+            self.assertIn("exit", box)
+            self.assertRegex(str(box["exit"]), "symlinked ancestor|leaf alias|containment invalid")
+            self.assertEqual(_snapshot(self.root), before)
+        finally:
+            if os.path.lexists(alias_parent):
+                os.unlink(alias_parent)
+            if os.path.lexists(fifo_input):
+                os.unlink(fifo_input)
+
