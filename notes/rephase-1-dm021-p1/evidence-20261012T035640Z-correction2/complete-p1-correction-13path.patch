+        def _drift_control_after_verify(root: Path, raw: str) -> Path:
+            out = real_build_dir(root, raw)
+            if not drifted_pre:
+                drifted_pre.append(True)
+                with control_file.open("a", encoding="utf-8") as handle:
+                    handle.write("\n# synthetic unlisted-control drift (pre-write seam)\n")
