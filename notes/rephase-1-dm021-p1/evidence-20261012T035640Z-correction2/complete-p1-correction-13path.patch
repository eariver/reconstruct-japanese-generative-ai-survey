+def _reversed_keys(value):
+    if isinstance(value, dict):
+        return {key: _reversed_keys(value[key]) for key in reversed(list(value.keys()))}
+    if isinstance(value, list):
+        return [_reversed_keys(item) for item in value]
+    return value
+
