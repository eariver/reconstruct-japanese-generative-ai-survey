diff --git a/schemas/editorial-correction-proposal-v2.schema.json b/schemas/editorial-correction-proposal-v2.schema.json
new file mode 100644
index 0000000..fa71d0f
--- /dev/null
+++ b/schemas/editorial-correction-proposal-v2.schema.json
@@ -0,0 +1,112 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://example.invalid/schemas/editorial-correction-proposal-v2.schema.json",
+  "title": "Survey Production Core v2 Editorial Correction Proposal (read-only preparation)",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "proposal_id",
+    "issue_id",
+    "research_profile",
+    "publication_profile",
+    "route",
+    "status",
+    "basis",
+    "proposed",
+    "retention_plan"
+  ],
+  "properties": {
+    "schema_version": {"const": "2.0-rc1"},
+    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
+    "issue_id": {"type": "string", "minLength": 1},
+    "research_profile": {"type": "string", "minLength": 1},
+    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
+    "route": {"const": "EDITORIAL_CORRECTION_PROPOSAL_V1"},
+    "status": {"const": "PROPOSED"},
+    "basis": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "state_ref",
+        "validation_checkpoint_ref",
+        "active_revalidation_ref",
+        "active_reader_input_ref",
+        "before_graph_digest",
+        "preserved_upstream_digest",
+        "generated_receipt_ref",
+        "renderer_commit",
+        "contract_identity"
+      ],
+      "properties": {
+        "state_ref": {"$ref": "#/$defs/ref"},
+        "validation_checkpoint_ref": {"$ref": "#/$defs/ref"},
+        "active_revalidation_ref": {
+          "anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]
+        },
+        "active_reader_input_ref": {"$ref": "#/$defs/ref"},
+        "before_graph_digest": {"$ref": "#/$defs/sha256"},
+        "preserved_upstream_digest": {"$ref": "#/$defs/sha256"},
+        "generated_receipt_ref": {"$ref": "#/$defs/ref"},
+        "renderer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
+        "contract_identity": {"type": "object"}
+      }
+    },
+    "proposed": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "authoring_input_ref",
+        "proposed_reader_ref",
+        "proposed_reader_canonical_sha256",
+        "change_description"
+      ],
+      "properties": {
+        "authoring_input_ref": {"$ref": "#/$defs/ref"},
+        "proposed_reader_ref": {"$ref": "#/$defs/ref"},
+        "proposed_reader_canonical_sha256": {"$ref": "#/$defs/sha256"},
+        "change_description": {"type": "string", "minLength": 1}
+      }
+    },
+    "retention_plan": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["roles", "path", "sha256", "byte_count", "policy"],
+        "properties": {
+          "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
+          "path": {"type": "string", "minLength": 1},
+          "sha256": {"$ref": "#/$defs/sha256"},
+          "byte_count": {"type": "integer", "minimum": 1},
+          "policy": {"enum": ["KEEP_IMMUTABLE", "COPY_BEFORE_REPLACEMENT"]},
+          "retained_ref": {"$ref": "#/$defs/ref"},
+          "retained_dest": {"type": "string", "minLength": 1}
+        },
+        "allOf": [
+          {
+            "if": {"properties": {"policy": {"const": "KEEP_IMMUTABLE"}}},
+            "then": {"required": ["retained_ref"], "not": {"required": ["retained_dest"]}}
+          },
+          {
+            "if": {"properties": {"policy": {"const": "COPY_BEFORE_REPLACEMENT"}}},
+            "then": {"required": ["retained_dest"], "not": {"required": ["retained_ref"]}}
+          }
+        ]
+      }
+    }
+  },
+  "$defs": {
+    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
+    "ref": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["path", "sha256"],
+      "properties": {
+        "path": {"type": "string", "minLength": 1},
+        "sha256": {"$ref": "#/$defs/sha256"}
+      }
+    }
+  }
+}
