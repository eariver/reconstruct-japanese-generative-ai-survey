+def _observe_with_timeout(testcase: unittest.TestCase, obs_mod, kwargs: dict,
+                          timeout_s: int = 30):
+    """Run observe_current_authority in a worker thread with explicit timeout.
+
+    Proves FIFO/special refusals do not block on open (regression would hang
+    until timeout and fail explicitly instead of hanging the suite).
+    """
+    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
+        future = pool.submit(obs_mod.observe_current_authority, **kwargs)
+        try:
+            return future.result(timeout=timeout_s)
+        except concurrent.futures.TimeoutError:
+            testcase.fail(f"observe blocked beyond {timeout_s}s (FIFO/special open hung)")
