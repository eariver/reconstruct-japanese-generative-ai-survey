+    "research_profile": {"const": "THEMATIC"},
+    "publication_profile": {"const": "LONGFORM_SPECIAL"},
+    "issue_metadata": {
+      "type": "object", "additionalProperties": false,
+      "required": ["title", "display_as_of"],
+      "properties": {
+        "title": {"const": "Japanese Generative AI Technical Survey Special"},
+        "display_as_of": {"type": "string", "minLength": 1}
+      }
+    },
