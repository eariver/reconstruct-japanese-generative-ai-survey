+def verify_renewal_rerender_equality(root: str | Path, basis_path: str | Path,
+                                     proof_path: str | Path) -> dict[str, Any]:
+    """U NEW: CURRENT renderer/style to disposable temp trio + complete reader
+    vs OLD prior-relative bytes at PRIOR paths (never P/publication vs R
+    confusion). Mismatch -> REUSE_TARGET_MISMATCH, no auto-convert to C."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    proof_rel = _lexical_rel(repo, str(proof_path), "renewal proof")
+    basis = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, basis_rel, "renewal basis"), "renewal basis")
+    proof = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, proof_rel, "renewal proof"), "renewal proof")
+    try:
+        current = srcmod.load_renewal_accepted_authority(repo, basis_rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "BASIS_ACCEPTED_SET_DRIFT"
+        raise _fail(str(code), "RERENDER", "REFUSED_PRE_WRITE",
+                    f"accepted-authority assembly failed: {exc}") from exc
+    surface = current.get("surface")
+    route = basis.get("generator_route")
+    if route == WEEKLY_ROUTE:
+        reader_bytes = core.json_bytes(surface)
+        from scripts.survey_weekly_derivation_v2 import (
+            render_bibliography as _w_render_bib, render_main as _w_render_main)
+        main_bytes = _w_render_main(surface).encode("utf-8")
+        bib_bytes = _w_render_bib(surface).encode("utf-8")
+    elif route == LONGFORM_ROUTE:
+        from scripts.survey_longform_derivation_v2 import (
+            canonical_reader_bytes as _lf_bytes)
+        from scripts.survey_longform_generated_v2 import (
+            render_bibliography as _lf_render_bib, render_main as _lf_render_main)
+        reader_bytes = _lf_bytes(surface)
+        main_bytes = _lf_render_main(surface).encode("utf-8")
+        bib_bytes = _lf_render_bib(surface).encode("utf-8")
+    else:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "RERENDER", "REFUSED_PRE_WRITE",
+                    f"unsupported route: {route}")
+    reviewed = basis.get("reviewed_reader_ref", {})
+    live_reader = _read_bytes_bounded(repo, _lexical_rel(repo, str(reviewed.get("path", "")),
+                                                         "reviewed reader"), "reviewed reader")
+    reader_equal = (live_reader == reader_bytes)
+    trio = proof.get("output_trio_refs", {})
+    trio_equal = True
+    for key, rendered in (("primary", main_bytes), ("bibliography", bib_bytes)):
+        ref = trio.get(key, {})
+        live = _read_bytes_bounded(repo, _lexical_rel(repo, str(ref.get("path", "")),
+                                                      f"rerender trio {key}"),
+                                   f"rerender trio {key}")
+        if live != rendered or _sha_bytes(live) != ref.get("sha256"):
+            trio_equal = False
+    from scripts.survey_editorial_staged_source_v2 import STYLE_PATH as _rerender_style_const
+    current_style_data = _read_bytes_bounded(
+        repo, _lexical_rel(repo, _rerender_style_const.as_posix(), "current style template"),
+        "current style template")
+    style_ref = trio.get("style", {})
+    style_live = _read_bytes_bounded(repo, _lexical_rel(repo, str(style_ref.get("path", "")),
+                                                       "rerender trio style"),
+                                     "rerender trio style")
+    if _sha_bytes(style_live) != style_ref.get("sha256"):
+        trio_equal = False
+    if _sha_bytes(current_style_data) != _sha_bytes(style_live):
+        trio_equal = False
+    # Descriptive digests recomputed with the EXACT Layer-B formulas (weekly:
+    # json_bytes surface; trio object {primary,bibliography,style} via
+    # sha256_object) using CURRENT style input for both C writes and U proof
+    # old output (ROOT clarification). S must compare the same current style;
+    # if S needs a change, report the exact interface for root to coordinate.
+    trio_digest = core.sha256_object({
+        "primary": _sha_bytes(main_bytes),
+        "bibliography": _sha_bytes(bib_bytes),
+        "style": _sha_bytes(current_style_data)})
+    disposition = "REUSED_TARGETS" if (reader_equal and trio_equal) else "MISMATCH"
+    return {"reader_equal": reader_equal, "trio_equal": trio_equal,
+            "disposition": disposition, "reader_digest": _sha_bytes(reader_bytes),
+            "trio_digest": trio_digest}
+
