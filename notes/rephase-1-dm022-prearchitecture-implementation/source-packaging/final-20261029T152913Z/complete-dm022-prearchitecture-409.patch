+    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
+    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR",
+)
+
+# C2 P2R fixture MUST include full inherited53 + new7 (explicit finite list).
+# `git ls-files` drops ALL untracked including old inherited sources (e.g.
+# editorial-manuscript-spec); config pipeline closure pins actual bytes via
+# aggregate_file_hash. Missing inherited schema is a fixture bug, NOT an
+# unrelated DM022 skip. P1T now carries INHERITED53 (53) + DM022_NEW7 (7);
+# P2R_EXTRA kept for explicitness (already in 53, deduped by copy).
+P2R_EXTRA = (
+    "scripts/survey_editorial_retention_v2.py",
