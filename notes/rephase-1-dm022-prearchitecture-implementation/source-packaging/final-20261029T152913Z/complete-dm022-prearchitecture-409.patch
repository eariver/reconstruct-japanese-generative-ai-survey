+        def duplicate_package() -> None:
+            data = json.loads(original_bytes.decode("utf-8"))
+            data["packages"].append(copy.deepcopy(data["packages"][0]))
+            archive_path.write_bytes(core.json_bytes(data))
+
+        def extra_block() -> None:
