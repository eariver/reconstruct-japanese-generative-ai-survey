+def _require_regular(st: os.stat_result, path: Path, label: str) -> None:
+    if not _stat.S_ISREG(st.st_mode):
+        raise AcceptanceError(f"{label} is not a regular file: {path} (mode={oct(st.st_mode)})")
+
