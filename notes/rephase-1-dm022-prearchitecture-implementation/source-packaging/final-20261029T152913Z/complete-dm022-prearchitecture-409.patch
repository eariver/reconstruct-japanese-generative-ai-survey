+def _scope_row_key(b: dict[str, Any]) -> tuple[str, ...]:
+    sr = b.get("source_ref", {}) if isinstance(b.get("source_ref"), dict) else {}
+    return (str(sr.get("path")), str(sr.get("sha256")), str(b.get("binding")),
+            str(b.get("schema_path", "")), str(b.get("schema_pointer", "")),
+            str(b.get("repository_commit_sha")), str(b.get("schema_sha256", "")))
