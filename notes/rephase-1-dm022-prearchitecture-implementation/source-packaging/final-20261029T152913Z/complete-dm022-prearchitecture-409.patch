+class TestC1ResearchGraph(unittest.TestCase):
+    def _write_prearch_file(self, tmp: Path) -> Path:
+        rec = {
+            "kind": "PREARCHITECTURE_ACCEPTANCE_SUPERSESSION_V1",
+            "reason": "REVIEWED_ACCEPTED_UPSTREAM_CORRECTION",
+        }
+        p = tmp / "prearch.json"
+        p.write_text(json.dumps(rec, sort_keys=True), encoding="utf-8")
+        return p
+
+    def test_prearch_file_public_discriminators(self):
+        hist = _load("survey_versioned_renewal_history_v2")
+        low = _load("survey_research_authority_v2")
+        with tempfile.TemporaryDirectory(prefix="dm022-c1-rg-") as td:
+            tmp = Path(td)
