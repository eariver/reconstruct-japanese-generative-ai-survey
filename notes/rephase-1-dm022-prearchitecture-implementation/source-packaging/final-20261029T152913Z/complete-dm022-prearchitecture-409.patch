+    def _forge_wrapper(self, sc: Scratch, basis_rel: str, stage: str, fn, code: str):
+        from scripts import survey_versioned_renewal_source_v2 as src
+        basis_path = sc.work / basis_rel
+        basis = json.loads(basis_path.read_bytes())
+        ret_rel = basis["retained_copy_ref"]["path"]
+        state_rel = f"sources/{sc.issue}/production-state.json"
+        prov = json.loads((sc.work / state_rel).read_bytes())["checkpoint_provenance"]
+        wrapper_rel = prov[stage]["path"]
+        backed = {}
+        for rel in (wrapper_rel, ret_rel, basis_rel):
+            backed[rel] = (sc.work / rel).read_bytes()
+        try:
+            doc = json.loads((sc.work / wrapper_rel).read_bytes())
+            fn(doc)
+            (sc.work / wrapper_rel).write_text(json.dumps(doc, indent=1, sort_keys=True), encoding="utf-8")
+            new_wrapper_sha = _sha_file(sc.work / wrapper_rel)
+            ret = json.loads((sc.work / ret_rel).read_bytes())
+            ret["checkpoint_provenance"][stage] = {"path": wrapper_rel, "sha256": new_wrapper_sha}
+            (sc.work / ret_rel).write_text(json.dumps(ret, indent=1, sort_keys=True), encoding="utf-8")
+            new_ret_sha = _sha_file(sc.work / ret_rel)
+            new_ret_n = len((sc.work / ret_rel).read_bytes())
+            basis["before_state_ref"] = {"path": state_rel, "sha256": new_ret_sha}
+            basis["retained_copy_ref"] = {"path": ret_rel, "sha256": new_ret_sha, "byte_count": new_ret_n}
+            for row in basis.get("retention_rows", []):
+                if isinstance(row, dict) and row.get("policy") == "COPY_BEFORE_REPLACEMENT" and row.get("path") == state_rel:
+                    row["sha256"] = new_ret_sha
+                    row["byte_count"] = new_ret_n
+                    row["retained_sha256"] = new_ret_sha
+                    row["retained_byte_count"] = new_ret_n
+            basis["basis_sha256"] = _sha_obj({k: v for k, v in basis.items() if k != "basis_sha256"})
+            basis_path.write_text(json.dumps(basis, indent=1, sort_keys=True), encoding="utf-8")
+            with self.assertRaises(Exception) as cm:
+                src.load_renewal_accepted_authority(sc.work, basis_rel)
+            self.assertIn(code, str(cm.exception), f"wrapper mutation must hit {code}: {cm.exception}")
+            (sc.rawdir / f"ckpt-{code}.txt").write_text(str(cm.exception), encoding="utf-8")
+        finally:
+            for rel, data in backed.items():
+                (sc.work / rel).write_bytes(data)
+        out = src.load_renewal_accepted_authority(sc.work, basis_rel)
+        self.assertTrue(out["records"])
