+def observe_renewal_authority(root: str | Path, state_path: str | Path,
+                              basis_path: str | Path) -> dict[str, Any]:
+    """HIGH basis-bound observation after basis capture, before finalize and
+    immediately before activation. Reopens ALL inputs and demands: LIVE State
+    bytes equal the fresh before_state_ref (live-live), retained COPY equals the
+    basis binding, selected predecessor equals the State-selected seal
+    (prior-relative + lineage-reachable), and basis.current_tool_epoch equals a
+    CURRENT disk closure/contract recompute member-wise (current-current). No
+    expected_contract caller argument; no old-State-vs-new-contract compare; no
+    verify_state_basis transitively. Detached readback never calls this function.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    repo = Path(root).resolve()
+    entry = _observe_renewal_entry(repo, state_path)
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    basis_bytes = _read_bytes_bounded(repo, basis_rel, "renewal basis")
+    basis = _strict_json_from_bytes(basis_bytes, "renewal basis")
+    if not isinstance(basis, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis must be an object")
+    if basis.get("schema_version") != "2.0-rc1" or basis.get("kind") != "VERSIONED_RENEWAL_BASIS_V1":
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis kind/version mismatch")
+    if core.sha256_object({k: v for k, v in basis.items() if k != "basis_sha256"}) != basis.get("basis_sha256"):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis self-digest mismatch")
+    before_ref = basis.get("before_state_ref")
+    if not isinstance(before_ref, dict) or before_ref.get("path") != entry["state_rel"] \
+            or before_ref.get("sha256") != entry["state_sha"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "LIVE State must equal the fresh before_state_ref (live-live)")
+    retained_ref = basis.get("retained_copy_ref")
+    if not isinstance(retained_ref, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained_copy_ref invalid")
+    retained_data = _read_bytes_bounded(repo, _lexical_rel(repo, str(retained_ref["path"]),
+                                                           "retained COPY"), "retained COPY")
+    if _sha_bytes(retained_data) != retained_ref.get("sha256") \
+            or len(retained_data) != retained_ref.get("byte_count"):
+        raise _fail("RETAINED_COPY_MISSING", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained COPY bytes changed")
+    if _sha_bytes(retained_data) != before_ref.get("sha256"):
+        raise _fail("RETAINED_COPY_MISSING", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained COPY SHA must equal before_state_ref")
+    for key in ("prior_record_ref", "prior_selected_ref", "prior_candidate_ref"):
+        ref = basis.get(key)
+        want = {"prior_record_ref": entry["prior_record_ref"],
+                "prior_selected_ref": entry["prior_set_ref"],
+                "prior_candidate_ref": entry["prior_candidate_ref"]}[key]
+        if not isinstance(ref, dict) or ref.get("path") != want["path"] \
+                or ref.get("sha256") != want["sha256"]:
+            raise _fail("REVIEW_TARGET_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                        f"basis.{key} must equal the State-selected predecessor (prior-relative)")
+    epoch = basis.get("current_tool_epoch", {})
+    if epoch.get("repository_commit_sha") != entry["current_commit"]:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis current epoch moved (fresh basis required)")
+    if epoch.get("contract") != entry["current_contract"]:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis current contract moved (fresh basis required)")
+    try:
+        # CURRENT proof derives actually current toolset from disk (never
+        # hardcoded G76). Historical G67/G71 stay OWN-epoch via hist verifiers.
+        _cur_fam = hist._derive_current_family_from_disk(repo, "renewal observe current")
+        expected_names = hist._expected_receipt_closure(entry["generator_route"], _cur_fam)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "UNSUPPORTED_MIGRATION"
+        raise _fail(str(code), "OBSERVE", "REFUSED_PRE_WRITE",
+                    f"closure expectation unavailable: {exc}") from exc
+    live_closure: dict[str, str] = {}
+    for name in expected_names:
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, name, f"current closure {name}"),
+                                   f"current closure {name}")
+        live_closure[name] = _sha_bytes(data)
+    pinned = {str(r.get("name")): str(r.get("sha256"))
+              for r in epoch.get("closure", []) if isinstance(r, dict)}
+    if set(pinned) != set(expected_names):
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis closure membership moved")
+    drifted = sorted(n for n in expected_names if pinned.get(n) != live_closure.get(n))
+    if drifted:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    f"current tools drifted since basis capture: {drifted[:8]}")
+    return {"entry": entry, "basis": basis, "basis_rel": basis_rel,
+            "live_current_before": {"path": entry["state_rel"], "sha256": entry["state_sha"]},
+            "retained_before": {"path": str(retained_ref["path"]),
+                                "sha256": str(retained_ref["sha256"])},
+            "selected_predecessor": entry["prior_set_ref"],
+            "current_tools": {"repository_commit_sha": entry["current_commit"],
+                              "contract": entry["current_contract"]}}
+
