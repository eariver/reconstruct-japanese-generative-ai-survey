+def _validate_before_renewal_receipt(repo: Path, gen_rel: str, phase: str) -> dict[str, Any]:
+    # Explicit kind-aware renewal before-receipt validation (no old-shape fallback).
+    # Only for VERSIONED_RENEWAL_SOURCE_V1. Fully validated public context:
+    # detached CURRENT proof, fully reloads basis/proof/build + Layer-B
+    # HIST+CURRENT closure/contract. Raw kind/sha unchanged, no normalization
+    # of untrusted raw receipt into old authored_refs shape, no caller dict/token.
+    try:
+        from scripts import survey_versioned_renewal_v2 as _renewal_high
+    except ImportError as exc:
+        raise _fail("RENEWAL_MISSING", phase, "REFUSED_PRE_WRITE", f"renewal high module missing for before renewal receipt: {exc}") from exc
+    if not hasattr(_renewal_high, "validate_renewal_receipt"):
+        raise _fail("RENEWAL_MISSING", phase, "REFUSED_PRE_WRITE", "validate_renewal_receipt missing; need concrete helper to root")
+    try:
+        _verdict = _renewal_high.validate_renewal_receipt(repo, gen_rel)
+    except Exception as exc:
+        raise _fail("BEFORE_RENEWAL_INVALID", phase, "REFUSED_PRE_WRITE", f"before renewal receipt invalid (fully validated public context required): {exc}") from exc
+    _validated = _verdict.get("receipt") if isinstance(_verdict, dict) else None
+    if not isinstance(_validated, dict) or _validated.get("kind") != "VERSIONED_RENEWAL_SOURCE_V1":
+        raise _fail("BEFORE_RENEWAL_KIND", phase, "REFUSED_PRE_WRITE", "validated before renewal kind mismatch (raw kind/sha unchanged, no normalization)")
+    _before_gen = _validated.get("generator_route")
+    if _before_gen not in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
+        raise _fail("BEFORE_RENEWAL_ROUTE", phase, "REFUSED_PRE_WRITE", f"before renewal generator_route invalid: {_before_gen!r}")
+    return _validated
