+        if self.base.exists():
+            shutil.rmtree(self.base)
+        self.base.mkdir(parents=True)
+        work = self.base / "work"
+        # Fresh bootstrap copy (retains 721a04d ancestry + old E untracked).
+        shutil.copytree(_bootstrap(kind), work, symlinks=False)
+        # Overlay frozen 731 stable base (not live candidate-work).
+        _copy_tree_no_git(_frozen_snapshot(), work)
+        # Overlay ONLY own fixed file (parallel-disjoint, others concurrent).
+        own_src = _candidate_work() / "scripts" / "survey_versioned_renewal_source_v2.py"
+        assert own_src.is_file(), f"own fixed source missing: {own_src}"
+        data = own_src.read_bytes()
