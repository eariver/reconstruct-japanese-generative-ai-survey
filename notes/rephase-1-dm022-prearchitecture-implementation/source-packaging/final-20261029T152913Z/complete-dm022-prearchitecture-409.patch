+    def _run_fixture_p3s_materialize(self, root: Path, state_abs: Path,
+                                         proposal_path: Path, manifest_path: Path,
+                                         scope_path: Path, tag: str) -> dict:
+        """Materialize P3S staged source in a fresh fixture-code subprocess.
+
+        P3S pins the ACTUALLY LOADED runtime modules to fixture paths (no ambient
+        stale code); the test runner's in-process imports bind the private copy,
+        so this step runs `python -c` with cwd=fixture root (imports resolve to
+        fixture code, matching C1's fresh fixture-code subprocess precedent —
+        NOT an old saved runner). Unique raw transcript preserved in the packet
+        (never overwritten); pid recorded before any duplicate check.
+        """
+        driver = (
+            "import json, sys; from pathlib import Path; "
+            "root = Path(sys.argv[1]).resolve(); "
+            "state_path = Path(sys.argv[2]); proposal_path = Path(sys.argv[3]); "
+            "manifest_path = Path(sys.argv[4]); scope_path = Path(sys.argv[5]); "
+            "from scripts import survey_editorial_staged_source_v2 as staged; "
+            "out = staged.materialize_staged_source(root, state_path, proposal_path, manifest_path, scope_path); "
+            "print(json.dumps({'staged_manifest_ref': out.get('staged_manifest_ref'), 'result_keys': sorted(out.keys())}))"
+        )
+        proc = subprocess.Popen(
+            [sys.executable, "-c", driver, str(root),
+             str(state_abs.relative_to(root)), str(proposal_path.relative_to(root)),
+             str(manifest_path.relative_to(root)), str(scope_path.relative_to(root))],
+            cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            env={k: v for k, v in os.environ.items() if not k.startswith("GIT_")})
+        pid = proc.pid
+        self.assertIsInstance(pid, int)
+        try:
+            out_text, err_text = proc.communicate(timeout=900)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            out_text, err_text = proc.communicate()
+            self.fail(f"P3S fixture subprocess timed out (pid {pid})")
+        # Unique raw transcript in the packet (never overwrite prior runs).
+        packet_base: Path | None = None
+        for parent in [REPO_ROOT, *REPO_ROOT.parents]:
+            candidate = parent / "notes" / "rephase-1-dm022-prearchitecture-implementation" / "evidence"
+            if candidate.is_dir():
+                packet_base = candidate / "full-lifecycle-v2-retained"
+                break
+        self.assertIsNotNone(packet_base, "packet evidence dir must exist")
+        assert packet_base is not None
+        run_stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+        dest = packet_base / f"{tag}-p3s-{run_stamp}"
+        self.assertFalse(dest.exists(), "run dir must be run-unique")
+        dest.mkdir(parents=True)
+        (dest / "stdout.txt").write_text(out_text, encoding="utf-8")
+        (dest / "stderr.txt").write_text(err_text, encoding="utf-8")
+        (dest / "meta.json").write_text(json.dumps(
+            {"pid": pid, "exit": proc.returncode, "argv": "P3S materialize_staged_source",
+             "fixture_root": str(root)}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+        self.assertEqual(proc.returncode, 0,
+                         f"P3S materialize must succeed (pid {pid}): {err_text[-3000:]}")
+        result = json.loads(out_text.strip().splitlines()[-1])
+        staged_rel = result["staged_manifest_ref"]["path"]
+        self.assertTrue((root / staged_rel).is_file())
+        return {"staged_manifest_path": root / staged_rel, "raw_dir": dest}
+
