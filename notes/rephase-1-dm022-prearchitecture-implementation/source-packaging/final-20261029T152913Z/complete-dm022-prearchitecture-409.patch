+        raise _fail("STATE_PROFILE_SHAPE", "State lacks exact Production Profile reference")
+    if bundle_profile.get("path") != state_prof.get("path") or \
+            bundle_profile.get("sha256") != state_prof.get("sha256"):
+        raise _fail("BUNDLE_PROFILE_DIVERGED",
+                    "quality bundle Production Profile differs from State-bound Profile")
+    manip_prof = (manuscript or {}).get("production_profile") or {}
+    if manip_prof.get("path") != state_prof.get("path") or \
+            manip_prof.get("sha256") != state_prof.get("sha256"):
+        raise _fail("MANUSCRIPT_PROFILE_DIVERGED",
+                    "selected manuscript Profile differs from State-bound Profile")
+    if core.sha256_bytes(col.files[col.rel(col.safe(
+            state_prof["path"], "State-bound Production Profile"))]) != state_prof.get("sha256"):
+        raise _fail("PROFILE_DRIFT", "State-bound Production Profile bytes drifted")
