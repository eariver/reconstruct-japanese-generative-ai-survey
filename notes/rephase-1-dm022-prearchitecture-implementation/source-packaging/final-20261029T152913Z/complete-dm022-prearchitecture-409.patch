+def _build_proof_object(repo: Path, basis: dict[str, Any], basis_rel: str,
+                        entry: dict[str, Any], executor: str, ts: str) -> dict[str, Any]:
+    """Construct the detached source proof via Layer-A accepted content.
+
+    Calls the SOURCE module's accepted-authority loader by persisted path (fully
+    reloaded every use; no caller dict/verified set). Propagates the SOURCE
+    module's exact error codes (including the S-owned scope-row coordination
+    refusal) without bypass or subset shortcut.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    try:
+        accepted = srcmod.load_renewal_accepted_authority(repo, basis_rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "BASIS_ACCEPTED_SET_DRIFT"
+        raise _fail(str(code), "PROOF", "REFUSED_PRE_WRITE",
+                    f"accepted-authority assembly failed: {exc}") from exc
+    surface = accepted.get("surface")
+    if not isinstance(surface, dict):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PROOF", "REFUSED_PRE_WRITE",
+                    "accepted surface missing")
+    route = basis.get("generator_route")
+    requested = basis.get("requested")
+    # Style bytes source (ROOT clarification): U must compare CURRENT style
+    # template bytes (current renderer style part, not generated text) to
+    # retained trio.style. Current style changes under an allowed Core epoch
+    # cause U REUSE_TARGET_MISMATCH (fresh C allowed), not a silent pass where
+    # closure contains the new style while U keeps the old style. C renders
+    # against the live template style; the new R trio style carries exactly
+    # these bytes. Template path is the staged STYLE_PATH constant (pure path
+    # constant, no P3S validator call). S Layer-B must compare the same current
+    # style; if S needs a change, report the exact interface for root to
+    # coordinate (do NOT edit S here).
+    from scripts.survey_editorial_staged_source_v2 import STYLE_PATH as _style_path_const
+    current_style_rel = _style_path_const.as_posix()
+    current_style_data = _read_bytes_bounded(
+        repo, _lexical_rel(repo, current_style_rel, "current style template"),
+        "current style template")
+    if requested == "REUSE_TARGETS":
+        retained_style_path = basis_proof_trio_placeholder(repo, basis)["style"]["path"]
+        retained_style_data = _read_bytes_bounded(
+            repo, _lexical_rel(repo, retained_style_path, "retained trio style"),
+            "retained trio style")
+        if _sha_bytes(current_style_data) != _sha_bytes(retained_style_data):
+            raise _fail("REUSE_TARGET_MISMATCH", "PROOF", "REFUSED_PRE_WRITE",
+                        "current style template changed vs retained trio.style "
+                        "(U keeps old style refuses; fresh C allowed; not merely "
+                        "closure-contains-new-style while U keeps old)")
+        style_rel = retained_style_path
+        style_data = retained_style_data
+    else:
+        style_rel = current_style_rel
+        style_data = current_style_data
+    _ = style_rel
+    if route == WEEKLY_ROUTE:
+        reader_bytes = core.json_bytes(surface)
+        from scripts.survey_weekly_derivation_v2 import (
+            render_bibliography as _w_render_bib, render_main as _w_render_main,
+            validate_generated_closure as _w_validate_closure)
+        main_text = _w_render_main(surface)
+        bib_text = _w_render_bib(surface)
+        try:
+            _w_validate_closure(main_text, style_data.decode("utf-8"))
+        except (ValueError, UnicodeDecodeError) as exc:
+            raise _fail("REUSE_TARGET_MISMATCH", "PROOF", "REFUSED_PRE_WRITE",
+                        f"current render closure invalid: {exc}") from exc
+        reader_digest = _sha_bytes(reader_bytes)
+        trio_digest = core.sha256_object({
+            "primary": _sha_bytes(main_text.encode("utf-8")),
+            "bibliography": _sha_bytes(bib_text.encode("utf-8")),
+            "style": _sha_bytes(style_data)})
+        rendered = {"primary": main_text.encode("utf-8"), "bibliography": bib_text.encode("utf-8"),
+                    "style": style_data}
+    elif route == LONGFORM_ROUTE:
+        from scripts.survey_longform_derivation_v2 import (
+            canonical_reader_bytes as _lf_bytes)
+        from scripts.survey_longform_generated_v2 import (
+            render_bibliography as _lf_render_bib, render_main as _lf_render_main,
+            validate_generated_closure as _lf_validate_closure)
+        reader_bytes = _lf_bytes(surface)
+        main_text = _lf_render_main(surface)
+        bib_text = _lf_render_bib(surface)
+        try:
+            _lf_validate_closure(main_text, style_data.decode("utf-8"))
+        except (ValueError, UnicodeDecodeError) as exc:
+            raise _fail("REUSE_TARGET_MISMATCH", "PROOF", "REFUSED_PRE_WRITE",
+                        f"current render closure invalid: {exc}") from exc
+        reader_digest = _sha_bytes(reader_bytes)
+        trio_digest = core.sha256_object({
+            "primary": _sha_bytes(main_text.encode("utf-8")),
+            "bibliography": _sha_bytes(bib_text.encode("utf-8")),
+            "style": _sha_bytes(style_data)})
+        rendered = {"primary": main_text.encode("utf-8"), "bibliography": bib_text.encode("utf-8"),
+                    "style": style_data}
+    else:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PROOF", "REFUSED_PRE_WRITE",
+                    f"unsupported route: {route}")
+    return {"surface": surface, "reader_digest": reader_digest, "trio_digest": trio_digest,
+            "rendered": rendered}
+
