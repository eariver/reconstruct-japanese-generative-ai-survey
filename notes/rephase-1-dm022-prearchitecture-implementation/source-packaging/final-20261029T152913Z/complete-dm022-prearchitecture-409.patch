+    if not isinstance(receipt, dict) or receipt.get("kind") != "VERSIONED_RENEWAL_SOURCE_V1":
+        raise _fail("RENEWAL_SCOPE_KIND", "lineage scope requires VERSIONED_RENEWAL_SOURCE_V1 receipt")
+    basis_ref = receipt.get("renewal_basis_ref")
