+        where present from bootstrap? Here complete source only, no old E — for narrow synthetic
+        NEW63 unit, old E not needed (E live/COPY for synthetic docs, not tool commit).
+        Returns (work, head_NEW, tmp). Prints unique pins. No old runners/network/cleanup/reset.
+        """
+        import shutil as _sh
+        tmp = tempfile.TemporaryDirectory(prefix=f"jgas-authorH-{tag}-", dir=str(_scratch_base()))
+        root = Path(tmp.name).resolve() / "work"
+        src = _candidate_work()
