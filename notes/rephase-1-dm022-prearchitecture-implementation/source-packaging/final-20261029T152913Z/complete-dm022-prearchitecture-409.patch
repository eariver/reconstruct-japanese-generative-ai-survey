+            # Minimal fixture lacks report/before_copy + full pipeline → refuses with expected
+            # code (proving actual epoch/files used, not hardcoded, not identity pass).
+            with self.assertRaises(Exception) as cm:
+                hist.verify_prearch_accepted_graph(r, "research/prearch.json", "research/report.json", "research/before.json", epoch, "c1-test")
+            msg = str(cm.exception)
+            self.assertTrue("UNSUPPORTED_MIGRATION" in msg or "HISTORY_DIGEST_MISMATCH" in msg or "HISTORY_BLOB_MISSING" in msg)
+
+    def test_g71_g76_control_literal(self):
+        hist = _load("survey_versioned_renewal_history_v2")
+        root = _repo_root()
+        for route in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
