+def _prepin_known_live_refs(live: Any, proposal_obj: dict[str, Any],
+                            phase: str, disp: str) -> tuple[dict[str, str], dict[str, str]]:
+    """Pin known explicit proposal/retention-plan live refs.
+
+    Pins via live Collector (hash-bound, no fabricated authority):
+    basis refs, proposed refs, and retention-plan live source refs. The
+    validation-checkpoint record itself is immutable-pinned (as a basis ref)
+    and its artifact rows are recorded for evidence only — they are NOT
+    live-pinned to historical sha (P1 distinguishes original checkpoint vs
+    active-before; R1 supersede legitimately changes live bytes; history is
+    covered by retained verification). Returns (retention_plan_map,
+    checkpoint_artifact_map); only the retention map is used for supplemental
+    conflict checks. Failures refuse (honest stale basis), never silently skipped.
+    """
+    retention_map: dict[str, str] = {}
+    checkpoint_map: dict[str, str] = {}
+    basis = proposal_obj.get("basis") or {}
+    for key in ("state_ref", "validation_checkpoint_ref", "active_revalidation_ref",
+                "active_reader_input_ref", "generated_receipt_ref"):
+        ref = basis.get(key)
+        if ref is None:
+            continue
+        if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+            raise _fail("BASIS_REF_SHAPE", phase, disp,
+                        f"proposal basis {key} must be exact {{path,sha256}}")
+        try:
+            # live.pinned does safe + sha equality (REF_DRIFT on mismatch).
+            live.pinned({"path": ref["path"], "sha256": ref["sha256"]},
+                        f"known basis {key}")
+        except Exception as exc:
+            # Preserve typed refusal (REF_DRIFT/PATH_*) as pre-write refusal.
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known basis {key} pin failed: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known basis {key} pin failed: {exc}") from exc
+    proposed = proposal_obj.get("proposed") or {}
+    for key in ("authoring_input_ref", "proposed_reader_ref"):
+        ref = proposed.get(key)
+        if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+            raise _fail("PROPOSED_REF_SHAPE", phase, disp,
+                        f"proposal proposed {key} must be exact {{path,sha256}}")
+        try:
+            live.pinned({"path": ref["path"], "sha256": ref["sha256"]},
+                        f"known proposed {key}")
+        except Exception as exc:
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known proposed {key} pin failed: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known proposed {key} pin failed: {exc}") from exc
+    plan = proposal_obj.get("retention_plan")
+    if not isinstance(plan, list):
+        raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                    "proposal retention_plan must be a list")
+    for row in plan:
+        if not isinstance(row, dict):
+            raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                        "retention plan row must be an object")
+        rp = row.get("path")
+        rs = row.get("sha256")
+        if not isinstance(rp, str) or not isinstance(rs, str) or len(rs) != 64:
+            raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                        f"retention plan row lacks exact path/sha: {row}")
+        retention_map[rp] = rs
+        try:
+            live.pinned({"path": rp, "sha256": rs},
+                        f"known retention plan {rp}")
+        except Exception as exc:
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known retention plan pin failed {rp}: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known retention plan pin failed {rp}: {exc}") from exc
+    # Before-graph: validation-checkpoint record is itself immutable pinned
+    # (as a basis ref above). Its artifact rows are HISTORICAL (original
+    # checkpoint) and must NOT be required at live active paths: P1
+    # distinguishes original checkpoint (_original_checkpoint) vs active-before
+    # (_active_effective, which legitimately supersedes rows on R1 refresh —
+    # e.g. changed receipt/Gate). Requiring historical bytes live would break
+    # real R1 same-chain viability. Historical rows are checked via the actual
+    # retained representation (P2R retained verification), not live equality.
+    # Current-before exact refs come from proposal/verified retention_plan and
+    # the active-effective basis (pinned above). Record the map for evidence
+    # only; never live-pin to old sha nor conflict supplemental pins against it.
+    try:
+        vref = basis.get("validation_checkpoint_ref") or {}
+        vrel = vref.get("path")
+        vbytes = live.files.get(vrel) if isinstance(vrel, str) else None
+        if vbytes is None:
+            raise _fail("PIN_FAILED", phase, disp,
+                        "validation checkpoint bytes missing for artifact record")
+        import json as _js
+        record = _js.loads(vbytes.decode("utf-8"))
+        for art in record.get("artifacts", []) or []:
+            if not isinstance(art, dict):
+                continue
+            ap = art.get("path")
+            ah = art.get("sha256")
+            if not isinstance(ap, str) or not isinstance(ah, str) or len(ah) != 64:
+                continue
+            checkpoint_map[ap] = ah
+    except StagedSourceError:
+        raise
+    except Exception as exc:
+        raise _fail("PIN_FAILED", phase, disp,
+                    f"checkpoint artifact record read failed: {exc}") from exc
+    return retention_map, checkpoint_map
+
+
+def _recheck_consumed_pins(live: Any, session: Any, orig_live_map: dict[str, bytes],
+                           orig_ret_map: dict[str, bytes], head_pinned: str,
+                           root_path: Path, phase: str, disp: str,
+                           owned: dict[str, Any] | None,
+                           supplemental: dict[str, bytes] | None = None) -> None:
+    """Recheck every original consumed pin + HEAD (no newly captured baseline).
+
+    Supplemental first-observer pins (immutable, hash-bound to the first
+    observation) are rechecked alongside originals; they never replace
+    original values.
+    """
+    if retention._git_head(root_path, "boundary HEAD", phase, disp or "REFUSED_PRE_WRITE") != head_pinned:
+        raise _fail("HEAD_MOVED", phase, disp or "REFUSED_PRE_WRITE",
+                    "HEAD changed at boundary", owned)
+    if live.head != head_pinned:
+        raise _fail("HEAD_MOVED", phase, disp or "REFUSED_PRE_WRITE",
+                    "collector HEAD changed at boundary", owned)
+    for rel, orig_bytes in orig_ret_map.items():
+        cur = session.files.get(rel)
+        if cur is None or cur != orig_bytes:
+            raise _fail("PIN_DRIFT", phase, disp or "REFUSED_PRE_WRITE",
+                        f"retained pin changed at boundary: {rel}", owned)
+    for rel, orig_bytes in orig_live_map.items():
+        cur = live.files.get(rel)
+        if cur is None or cur != orig_bytes:
+            raise _fail("PIN_DRIFT", phase, disp or "REFUSED_PRE_WRITE",
+                        f"live pin changed at boundary: {rel}", owned)
