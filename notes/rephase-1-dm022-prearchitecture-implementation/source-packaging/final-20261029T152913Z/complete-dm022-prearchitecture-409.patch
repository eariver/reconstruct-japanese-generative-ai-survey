@@ -0,0 +1,785 @@
+"""DM022 C2 publication/editorial consumer tests (author-C2 correction).
+
+Whole public paths + healthy controls (no helper-only manufactured exceptions,
+no writer mocks as witness). Uses independent temp dirs (no fixture objects in
+reconstruct DB, no inherited GIT_* vars, process-scoped identity, meaningful
+fixture commit). No ordinary commit/config/network/Production/old-runner.
+
+NOT run while others edit shared source (AST-only now); full runs after root
+fixes integration snapshot with all owners bound.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+def _run_git(root: Path, *args: str) -> subprocess.CompletedProcess:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update({
+        "GIT_NO_LAZY_FETCH": "1",
+        "GIT_OPTIONAL_LOCKS": "0",
+        "GIT_ALLOW_PROTOCOL": "file",
+        "GIT_AUTHOR_NAME": "Synthetic DM022-C2 Fixture",
+        "GIT_AUTHOR_EMAIL": "c2-fixture@example.invalid",
+        "GIT_COMMITTER_NAME": "Synthetic DM022-C2 Fixture",
+        "GIT_COMMITTER_EMAIL": "c2-fixture@example.invalid",
+    })
+    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, env=env)
+
+
+def _snapshot_files(root: Path) -> dict[str, str]:
+    out: dict[str, str] = {}
+    for p in sorted(root.rglob("*")):
+        if p.is_symlink() or not p.is_file():
+            continue
+        try:
+            rel = p.relative_to(root).as_posix()
+        except ValueError:
+            continue
+        if rel.startswith(".git/"):
+            continue
+        out[rel] = hashlib.sha256(p.read_bytes()).hexdigest()
+    return out
+
+
+def _write_json(path: Path, payload: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+class TestC2PublicationSelectorsWholePath(unittest.TestCase):
+    def test_mode_probe_none_pointer_is_canonical_healthy_control(self) -> None:
+        """Whole public path: None pointer -> CANONICAL (legacy healthy control)."""
+        from scripts import survey_publication_set_v2 as pubset
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-mode-") as td:
+            root = Path(td)
+            state = {"publication_revalidation_provenance": None}
+            cfg = {}
+            before = _snapshot_files(root)
+            mode = pubset.resolve_publication_mode(root, cfg, state)
+            self.assertEqual(mode, "CANONICAL")
+            self.assertEqual(_snapshot_files(root), before)
+
+    def test_mode_probe_prearch_refuses_before_canonical_fallback(self) -> None:
+        """Whole public path: PREARCH pointer refuses DM022_WRONG_FAMILY, never CANONICAL."""
+        from scripts import survey_publication_set_v2 as pubset
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-mode-prearch-") as td:
+            root = Path(td)
+            prearch = {
+                "kind": "PREARCHITECTURE_ACCEPTANCE_SUPERSESSION_V1",
+                "reason": "REVIEWED_ACCEPTED_UPSTREAM_CORRECTION",
+            }
+            _write_json(root / "prearch.json", prearch)
+            sha = hashlib.sha256((root / "prearch.json").read_bytes()).hexdigest()
+            state = {"publication_revalidation_provenance": {"path": "prearch.json", "sha256": sha}}
+            before = _snapshot_files(root)
+            with self.assertRaisesRegex(ValueError, "DM022_WRONG_FAMILY"):
+                pubset.resolve_publication_mode(root, {}, state)
+            self.assertEqual(_snapshot_files(root), before)
+
+    def test_artifact_path_prearch_roles_refuse_before_read(self) -> None:
+        """Whole public path: PREARCH research roles refuse before any file read."""
+        from scripts import survey_publication_set_v2 as pubset
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-artifact-") as td:
+            root = Path(td)
+            before = _snapshot_files(root)
+            for role in ("evidence", "materiality", "materiality-ledger", "profile-completeness"):
+                with self.assertRaisesRegex(ValueError, "DM022_WRONG_FAMILY|unknown publication role"):
+                    pubset.resolve_publication_artifact_path(root, {}, {}, role)
+            self.assertEqual(_snapshot_files(root), before)
+
+    def test_stage_artifact_research_names_require_low(self) -> None:
+        """Whole public path: research 4-refs via stage-template refuse (F4b split)."""
+        from scripts import survey_publication_set_v2 as pubset
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-stage-") as td:
+            root = Path(td)
+            profile = {"paths": {"source_root": "src"}}
+            before = _snapshot_files(root)
+            for name in ("evidence-acceptance", "materiality-ledger"):
+                with self.assertRaisesRegex(ValueError, "DM022_WRONG_FAMILY|research"):
+                    pubset.resolve_stage_artifact_path(root, {}, {}, profile, name, "{source_root}/x")
+            self.assertEqual(_snapshot_files(root), before)
+
+    def test_activation_record_prearch_refuses_whole_path(self) -> None:
+        """Whole public path: PREARCH as activation record refuses (no CANONICAL fallback)."""
+        from scripts import survey_publication_set_v2 as pubset
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-activation-") as td:
+            root = Path(td)
+            # Minimal PREARCH file; activation loader must refuse as wrong family
+            # (either explicit WRONG_FAMILY or fail-closed schema refusal, never CANONICAL).
+            prearch = {
+                "kind": "PREARCHITECTURE_ACCEPTANCE_SUPERSESSION_V1",
+                "reason": "REVIEWED_ACCEPTED_UPSTREAM_CORRECTION",
+                "issue_id": "TEST",
+            }
+            _write_json(root / "act.json", prearch)
+            before = _snapshot_files(root)
+            with self.assertRaisesRegex(ValueError, "DM022_WRONG_FAMILY|activation|schema|invalid"):
+                pubset.validate_activation_record(root, "act.json")
+            self.assertEqual(_snapshot_files(root), before)
+
+
+class TestC2CheckpointSitesWholePath(unittest.TestCase):
+    def test_original_validation_healthy_control_via_low_typed(self) -> None:
+        """Healthy control: LOW typed loader classifies legacy (no-kind) vs PREARCH."""
+        from scripts import survey_research_authority_v2 as low
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-typed-") as td:
+            root = Path(td)
+            # Legacy: no kind -> LEGACY family (classification only, not permission).
+            legacy = {
+                "schema_version": "2.0-rc1",
+                "issue_id": "TEST",
+                "from_state": "DRAFT_COMPLETE",
+                "to_state": "VALIDATED_DRAFT",
+                "checkpoints": ["validation"],
+                "recorded_at": "2026-01-01T00:00:00Z",
+                "implementation": {"repository_commit_sha": "0" * 40, "orchestrator_version": "x"},
+                "contract": {},
+                "artifacts": [],
+                "reviews": [],
+                "summary": "x",
+            }
+            _write_json(root / "legacy.json", legacy)
+            # May fail schema (minimal stub) -> fail-closed is acceptable healthy
+            # control for classification boundary; assert it does NOT parse as PREARCH.
+            try:
+                typed = low.load_typed_checkpoint_record(root, Path("legacy.json"))
+            except Exception:
+                typed = {"family": "LEGACY-DENIED"}
+            self.assertNotEqual(typed.get("family"), "PREARCH")
+
+    def test_weekly_refresh_validation_prearch_refuses_whole_path(self) -> None:
+        """PUBLIC refresh validation wrong-role: valid surrounding fixture, PREARCH refuses.
+
+        Calls actual `validate_refresh_validation_checkpoint` (wired by
+        `refresh_mechanical_evidence`, not a test helper) with real file on
+        disk, exact {path,sha256} ref, matching SHA (no missing/shape/drift
+        preemption). Minimal PREARCH (exact kind+`reason`, not reason_class)
+        refuses DM022_WRONG_FAMILY via lightweight classification before any
+        legacy branch. Healthy legacy control below proves the same path
+        accepts a valid validation checkpoint.
+        """
+        import scripts.survey_weekly_mechanical_refresh_v2 as wmod
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-refresh-") as td:
+            root = Path(td)
+            state = {"issue_id": "TEST"}
+            # Wrong-role fixture: real PREARCH file + exact ref + matching SHA.
+            prearch = {
+                "kind": "PREARCHITECTURE_ACCEPTANCE_SUPERSESSION_V1",
+                "reason": "REVIEWED_ACCEPTED_UPSTREAM_CORRECTION",
+            }
+            _write_json(root / "prearch-checkpoint.json", prearch)
+            sha = hashlib.sha256((root / "prearch-checkpoint.json").read_bytes()).hexdigest()
+            ref = {"path": "prearch-checkpoint.json", "sha256": sha}
+            before = _snapshot_files(root)
+            with self.assertRaisesRegex(ValueError, "DM022_WRONG_FAMILY"):
+                wmod.validate_refresh_validation_checkpoint(root, state, ref)
+            # No canonical writes on wrong-role refusal (read-only validator).
+            self.assertEqual(_snapshot_files(root), before)
+
+    def test_weekly_refresh_validation_healthy_legacy_accepts_whole_path(self) -> None:
+        """Healthy control: valid legacy validation checkpoint passes PUBLIC validator."""
+        import scripts.survey_weekly_mechanical_refresh_v2 as wmod
