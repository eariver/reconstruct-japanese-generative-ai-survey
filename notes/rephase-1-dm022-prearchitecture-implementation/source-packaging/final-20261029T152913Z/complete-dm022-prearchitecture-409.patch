+def _git_run(repo: Path, args: list[str], label: str) -> subprocess.CompletedProcess[str]:
+    if os.environ.get("GIT_DIR") or os.environ.get("GIT_WORK_TREE") or os.environ.get("GIT_INDEX_FILE"):
+        raise RuntimeError(f"refusing with inherited GIT_* for {label}")
+    env = dict(os.environ)
+    env["GIT_OPTIONAL_LOCKS"] = "0"
+    env["GIT_CONFIG_NOSYSTEM"] = "1"
+    env["GIT_CONFIG_GLOBAL"] = "/dev/null"
