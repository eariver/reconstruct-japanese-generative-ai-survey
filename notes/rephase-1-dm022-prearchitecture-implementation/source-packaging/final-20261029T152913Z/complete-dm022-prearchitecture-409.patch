+def _check_editorial_rows(
+    repo_root: Path, cfg: dict[str, Any], state: dict[str, Any],
+    record: dict[str, Any], prior_record: dict[str, Any], *, live: bool,
+) -> list[str]:
+    """Editorial branch: 15-role seal table binding, no second active table.
+
+    Delegates file/hash/schema/retained-COPY/digest work to the low-level
+    identity layer (pubset) which uses only schema/low-level primitives.
+    Checks here: seal binding, table shape, prior-checkpoint binding, anchor
+    shape, no fake legacy rows, no second active-role table. Full
+    retained-COPY/digest per-link proofs run in the chain walk and head
+    resolve via pubset.validate_activation_record on exact record files, so
+    every linked activation is proved, not table-checked only. Historical reads
+    use retained State COPY, never live-State hash equality.
+    """
+    errors: list[str] = []
+    # Authoritative low-level seal check (15 files, bundle refs, cross-bindings).
+    # Full activation proofs run per-link in the chain walk and at the head via
+    # pubset.validate_activation_record on exact files; this row check covers
+    # table binding in all cases.
+    try:
+        set_ref = record.get("set_ref")
+        if not isinstance(set_ref, dict):
+            return ["editorial activation set_ref fields invalid"]
