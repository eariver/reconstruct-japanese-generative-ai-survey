+def _load_proof_strict(root: Path, proof_path: Path | str) -> tuple[dict[str, Any], str, str]:
+    from scripts import survey_schema_v2 as schema_gate
+    rel = str(proof_path)
+    if Path(rel).is_absolute():
+        try:
+            rel = Path(rel).relative_to(root.resolve()).as_posix()
+        except ValueError as exc:
+            raise RenewalSourceError("RENEWAL_PROOF_MODE", f"proof path escapes repository: {proof_path}") from exc
+    rel = _to_rel(root, rel, "renewal proof")
+    raw = _fd_read(root, rel, "renewal proof")
+    proof = _parse_json_strict_bytes(raw, "renewal proof")
+    if not isinstance(proof, dict):
+        raise RenewalSourceError("RENEWAL_PROOF_DIGEST", "renewal proof must be an object")
+    _validate_pinned(proof, _fd_read(root, "schemas/versioned-renewal-source-proof-v2.schema.json", "proof schema"), "renewal proof", "RENEWAL_PROOF_DIGEST")
+    if proof.get("schema_version") != "2.0-rc1" or proof.get("kind") != "VERSIONED_RENEWAL_SOURCE_PROOF_V1":
+        raise RenewalSourceError("RENEWAL_PROOF_DIGEST", "renewal proof kind/version mismatch")
+    expect = proof.get("proof_sha256")
+    from scripts import survey_production_v2 as core
+    calc = core.sha256_object({k: v for k, v in proof.items() if k != "proof_sha256"})
+    if expect != calc:
+        raise RenewalSourceError("RENEWAL_PROOF_DIGEST", "renewal proof self-digest mismatch")
+    return proof, calc, rel
