+                synthesis_input = drafting.build_synthesis_input(
+                    self.root, chain["profile_path"], chain["source_root"] / "architecture-v2.json",
+                    chain["source_root"] / "architecture-review-summary-v2.json",
+                    chain["approval_path"], [
