+        raise _fail("RENEWAL_SCOPE_SHAPE", "renewal receipt lacks exact renewal_basis_ref")
+    basis_rel = col.pinned({"path": basis_ref["path"], "sha256": basis_ref["sha256"]},
+                           "renewal basis for lineage scope")
+    try:
