+        _run_git(work, "config", "commit.gpgsign", "false")
+        _run_git(work, "remote", "remove", "origin")
+        _run_git(work, "remote", "add", "origin", "https://example.invalid/authorS-fixture.git")
+        add = _run_git(work, "add", *_SOURCE_PATHS)
+        assert add.returncode == 0, add.stderr[:2000]
+        cm = _run_git(work, "commit", "-m", f"author-S {tag}: exact intended source snapshot (isolated, not public)")
+        assert cm.returncode == 0, cm.stderr[:2000]
+        self.head = _run_git(work, "rev-parse", "HEAD").stdout.decode().strip()
