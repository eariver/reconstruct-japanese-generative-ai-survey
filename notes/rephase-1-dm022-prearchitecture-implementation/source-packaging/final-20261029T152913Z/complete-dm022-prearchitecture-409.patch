+def _derive_old_tool_epoch(repo: Path, basis: dict[str, Any]) -> str:
+    """Old tool epoch for the REUSED wrapper: the staged producer head of the
+    immediate predecessor (editorial) or the prior basis CURRENT epoch
+    (renewal predecessor). Derived from history-graph fields, never caller."""
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    try:
+        verdict = hist.verify_versioned_history(repo, basis["prior_record_ref"]["path"])
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_DIGEST_MISMATCH"
+        raise _fail(str(code), "BUILD", "REFUSED_PRE_WRITE",
+                    f"old epoch history invalid: {exc}") from exc
+    lineage = verdict.get("materialization_lineage", [])
+    if lineage:
+        last = lineage[-1]
+        for key in ("staged_producer_head", "receipt_epoch", "basis_current_epoch"):
+            value = last.get(key)
+            if isinstance(value, str) and len(value) == 40 \
+                    and all(c in "0123456789abcdef" for c in value):
+                return value
+    prior_seal = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                               "prior seal"), "prior seal"), "prior seal")
+    receipt_role = (prior_seal.get("roles", {}) or {}).get("source-receipt", {})
+    receipt = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, str(receipt_role.get("path", "")),
+                                               "prior receipt"), "prior receipt"),
+        "prior receipt")
+    tools = receipt.get("current_tools", {}) if isinstance(receipt, dict) else {}
+    epoch = tools.get("repository_commit_sha", "")
+    if not _is_gitsha(epoch):
+        raise _fail("HISTORY_TOOL_EPOCH_DRIFT", "BUILD", "REFUSED_PRE_WRITE",
+                    "old tool epoch underivable from prior receipt")
+    return str(epoch)
+
