+        final_package = max(architecture["packages"], key=lambda row: row["drafting_order"])["package_id"]
+        paths: dict[str, Path] = {}
+        for kind, name in (("SEMANTIC_EDITORIAL", f"{prefix}semantic-editorial-review-v2.json"),
