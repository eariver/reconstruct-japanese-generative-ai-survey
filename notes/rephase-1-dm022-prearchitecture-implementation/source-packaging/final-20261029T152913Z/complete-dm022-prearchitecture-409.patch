+class RenewalHighError(ValueError):
+    def __init__(self, code: str, detail: str, *, phase: str = "HIGH",
+                 disposition: str = "REFUSED_PRE_WRITE"):
+        super().__init__(f"{code}: {detail}")
+        self.code = code
+        self.detail = detail
+        self.phase = phase
+        self.disposition = disposition
+
+
+def _fail(code: str, phase: str, disposition: str, detail: str) -> RenewalHighError:
+    return RenewalHighError(code, detail, phase=phase, disposition=disposition)
+
+
+def _copy_hist_anchor(history: dict[str, Any], validation_ref: dict[str, Any]) -> dict[str, Any]:
+    """Copy chain-derived canonical_anchor verbatim from HIST (no default).
+
+    HIST verify_versioned_history returns complete independently derived
+    {kind,ref} from the verified actual chain (latest legacy before FIRST
+    versioned, no rolling). HIGH basis must copy it verbatim; it must NOT
+    synthesize kind from history.anchor_kind + original validation default
+    (the exact r4 defect: LEGACY kind with DRAFT_COMPLETE ref vs expected r2).
+    No fallback to originalPath when kind is LEGACY: a LEGACY anchor whose
+    ref equals the original validation checkpoint refuses here.
+    """
+    anchor = history.get("canonical_anchor")
+    if not isinstance(anchor, dict) or set(anchor) != {"kind", "ref"}:
+        raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian canonical_anchor missing (chain-derived identity required)")
+    kind = anchor.get("kind")
+    ref = anchor.get("ref")
+    if kind not in ("VALIDATION_CHECKPOINT", "LEGACY_REVALIDATION"):
+        raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian canonical_anchor kind invalid")
+    if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+        raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian canonical_anchor ref fields invalid")
+    if not isinstance(ref.get("path"), str) or not ref.get("path"):
+        raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian canonical_anchor ref path invalid")
+    sha = ref.get("sha256")
+    if not isinstance(sha, str) or len(sha) != 64 or any(c not in "0123456789abcdef" for c in sha):
+        raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian canonical_anchor ref sha invalid")
+    if kind == "LEGACY_REVALIDATION":
+        vr = validation_ref if isinstance(validation_ref, dict) else {}
+        if ref.get("path") == vr.get("path") and ref.get("sha256") == vr.get("sha256"):
+            raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                        "historian LEGACY anchor must not fallback to originalPath (expected legacy record, not DRAFT_COMPLETE)")
+    else:
+        vr = validation_ref if isinstance(validation_ref, dict) else {}
+        if ref.get("path") != vr.get("path") or ref.get("sha256") != vr.get("sha256"):
+            raise _fail("HISTORY_ANCESTOR", "PREPARE", "PRESERVED_INCOMPLETE",
+                        "historian VALIDATION anchor must equal original validation checkpoint")
+    return {"kind": str(kind), "ref": {"path": str(ref["path"]), "sha256": str(ref["sha256"])}}
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _sha_object(value: Any) -> str:
+    return _sha_bytes(json.dumps(value, ensure_ascii=False, sort_keys=True,
+                                 separators=(",", ":")).encode("utf-8"))
+
+
+def _no_duplicate_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for k, v in pairs:
+        if k in out:
+            raise RenewalHighError("HIGH_DIGEST_MISMATCH", f"duplicate JSON key: {k}",
+                                   phase="LOAD", disposition="REFUSED_PRE_WRITE")
+        out[k] = v
+    return out
+
+
+def _parse_instant_str(value: str) -> datetime:
+    try:
+        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as exc:
+        raise _fail("ARGS", "TIME", "REFUSED_PRE_WRITE",
+                    f"instant invalid: {exc}") from exc
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    return dt.astimezone(timezone.utc)
+
+
+def _now_utc(recorded_at: datetime | str | None = None) -> str:
+    if isinstance(recorded_at, datetime):
+        dt = recorded_at
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+    if isinstance(recorded_at, str):
+        if not recorded_at:
+            raise _fail("ARGS", "TIME", "REFUSED_PRE_WRITE", "recorded_at empty")
+        try:
+            dt = datetime.fromisoformat(recorded_at.replace("Z", "+00:00"))
+        except ValueError as exc:
+            raise _fail("ARGS", "TIME", "REFUSED_PRE_WRITE",
+                        f"recorded_at invalid: {exc}") from exc
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _lexical_rel(repo: Path, raw: str | Path, label: str) -> str:
+    s = str(raw)
+    if Path(s).is_absolute():
+        try:
+            return Path(s).relative_to(repo.resolve()).as_posix()
+        except ValueError as exc:
+            raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} escapes repository root: {raw}") from exc
+    if not s or "\\" in s or s.startswith("/"):
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE", f"{label} path invalid: {raw}")
+    parts = Path(s).parts
+    if any(p in ("..", ".", "") for p in parts):
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} unsafe component: {raw}")
+    if len(s) > 1024 or len(parts) > 64:
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE", f"{label} path too long: {raw}")
+    return s
+
+
+def _lexical_parts(rel: str, label: str) -> tuple[str, ...]:
+    if not isinstance(rel, str) or not rel or "\\" in rel:
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} must be repository-relative without traversal: {rel!r}")
+    if len(rel) > 1024:
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} path too long: {len(rel)}")
+    if rel.startswith("/") or rel == "." or rel.startswith("./"):
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} must be repository-relative: {rel!r}")
+    parts = tuple(rel.split("/"))
+    if len(parts) > 64:
+        raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} path too deep: {len(parts)}")
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} has unsafe path component: {rel!r}")
+        if len(part) > 255:
+            raise _fail("HIGH_PATH", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} path component too long: {part!r}")
+    return parts
+
+
+def _walk_existing_ancestors(repo: Path, parts: tuple[str, ...], label: str) -> None:
+    root = repo.resolve()
+    try:
+        lst = os.lstat(root)
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} cannot lstat repo root: {exc}") from exc
+    if stat.S_ISLNK(lst.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} repo root is symlink")
+    if not stat.S_ISDIR(lst.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} repo root is not a directory")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        try:
+            st = os.lstat(current)
+        except FileNotFoundError:
+            return
+        except OSError as exc:
+            raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} ancestor check failed: {current}: {exc}") from exc
+        if stat.S_ISLNK(st.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} has symlinked ancestor component: {current}")
+        if not stat.S_ISDIR(st.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} has non-directory ancestor component: {current}")
+
+
+def _fd_safe_read(repo: Path, rel: str, label: str) -> bytes:
+    root_resolved = repo.resolve()
+    try:
+        lst = os.lstat(root_resolved)
+    except OSError as exc:
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} cannot lstat repo root: {exc}") from exc
+    if stat.S_ISLNK(lst.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} repo root is symlink")
+    if not stat.S_ISDIR(lst.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} repo root is not a directory")
+    parts = _lexical_parts(rel, label)
+    dir_parts, leaf = parts[:-1], parts[-1]
+    held: list[int] = []
+    try:
+        try:
+            root_fd = os.open(root_resolved, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} cannot open repo root no-follow: {exc}") from exc
+        held.append(root_fd)
+        try:
+            rst = os.fstat(root_fd)
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} root fstat failed: {exc}") from exc
+        if not stat.S_ISDIR(rst.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} root is not a directory after open")
+        if (lst.st_dev, lst.st_ino) != (rst.st_dev, rst.st_ino):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} repo root replaced between lstat and open")
+        parent = root_fd
+        cur: list[str] = []
+        for part in dir_parts:
+            cur.append(part)
+            try:
+                fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0), dir_fd=parent)
+            except FileNotFoundError as exc:
+                raise _fail("HIGH_MISSING", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor missing: {'/'.join(cur)}: {exc}") from exc
+            except OSError as exc:
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor not openable as dir (symlink?): {'/'.join(cur)}: {exc}") from exc
+            held.append(fd)
+            try:
+                st = os.fstat(fd)
+            except OSError as exc:
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor fstat failed: {'/'.join(cur)}: {exc}") from exc
+            if not stat.S_ISDIR(st.st_mode):
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor not a directory: {'/'.join(cur)}")
+            try:
+                est = os.stat(part, dir_fd=parent, follow_symlinks=False)
+            except OSError as exc:
+                raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor entry unreadable: {'/'.join(cur)}: {exc}") from exc
+            if stat.S_ISLNK(est.st_mode):
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor is symlink: {'/'.join(cur)}")
+            if (est.st_dev, est.st_ino) != (st.st_dev, st.st_ino):
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} ancestor replaced during open: {'/'.join(cur)}")
+            parent = fd
+        try:
+            ent = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
+        except FileNotFoundError as exc:
+            raise _fail("HIGH_MISSING", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} missing: {rel}: {exc}") from exc
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} leaf entry unreadable: {rel}: {exc}") from exc
+        if stat.S_ISLNK(ent.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} is a symlink/refusal: {rel}")
+        if not stat.S_ISREG(ent.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} is not a regular file (FIFO/socket/device/dir refused): {rel}")
+        try:
+            fd = os.open(leaf, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0), dir_fd=parent)
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} open refused (symlink/unsafe): {rel}: {exc}") from exc
+        held.append(fd)
+        try:
+            fst = os.fstat(fd)
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} fstat failed: {rel}: {exc}") from exc
+        if not stat.S_ISREG(fst.st_mode):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} is not a regular file after open: {rel}")
+        if (fst.st_dev, fst.st_ino) != (ent.st_dev, ent.st_ino):
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} replaced between entry check and open: {rel}")
+        chunks: list[bytes] = []
+        total = 0
+        while True:
+            try:
+                chunk = os.read(fd, 65536)
+            except OSError as exc:
+                raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} read failed: {rel}: {exc}") from exc
+            if not chunk:
+                break
+            total += len(chunk)
+            if total > MAX_FILE_BYTES:
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} file too large (limit {MAX_FILE_BYTES}): {rel}")
+            chunks.append(chunk)
+        data = b"".join(chunks)
+        try:
+            os.close(fd)
+        except OSError as exc:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} close after read failed: {rel}: {exc}") from exc
+        finally:
+            if fd in held:
+                try:
+                    held.remove(fd)
+                except ValueError:
+                    pass
+        if len(data) < 1:
+            raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                        f"{label} size out of bounds: {rel} (0)")
+        return data
+    finally:
+        for hfd in reversed(list(held)):
+            try:
+                os.close(hfd)
+            except OSError as exc:
+                raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                            f"{label} descriptor close failed: {exc}") from exc
+
+
+def _safe_path(repo: Path, rel: str, label: str) -> Path:
+    parts = _lexical_parts(rel, label)
+    _walk_existing_ancestors(repo, parts, label)
+    target = repo.resolve().joinpath(*parts)
+    try:
+        st = os.lstat(target)
+    except FileNotFoundError as exc:
+        raise _fail("HIGH_MISSING", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} not a regular file: {rel}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} unreadable: {rel}: {exc}") from exc
+    if stat.S_ISLNK(st.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} symlink refused: {rel}")
+    if not stat.S_ISREG(st.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} not a regular file: {rel}")
+    return target
+
+
+def _read_bytes_bounded(repo: Path, rel: str, label: str) -> bytes:
+    return _fd_safe_read(repo, rel, label)
+
+
+def _strict_json_from_bytes(data: bytes, label: str) -> Any:
+    if len(data) > MAX_JSON_BYTES:
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE", f"{label} JSON too large")
+    try:
+        return json.loads(data.decode("utf-8"), object_pairs_hook=_no_duplicate_object)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise _fail("HIGH_DIGEST_MISMATCH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} strict JSON invalid: {exc}") from exc
+
+
+def _is_hex64(value: Any) -> bool:
+    return (isinstance(value, str) and len(value) == 64
+            and all(c in "0123456789abcdef" for c in value))
+
+
+def _is_gitsha(value: Any) -> bool:
+    return (isinstance(value, str) and len(value) == 40
+            and all(c in "0123456789abcdef" for c in value))
+
+
+def _git(repo: Path, *args: str, label: str) -> str:
+    try:
+        proc = subprocess.run(
+            ["git", "--no-optional-locks", *args],
+            cwd=str(repo), capture_output=True, text=True, timeout=120,
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise _fail("HISTORY_BLOB_MISSING", "GIT", "REFUSED_PRE_WRITE",
+                    f"{label} git invocation failed: {exc}") from exc
+    if proc.returncode != 0:
+        raise _fail("HISTORY_BLOB_MISSING", "GIT", "REFUSED_PRE_WRITE",
+                    f"{label} git failed ({proc.returncode}): {proc.stderr.strip()[:300]}")
+    return proc.stdout
+
+
+def _current_commit(repo: Path) -> str:
+    out = _git(repo, "rev-parse", "HEAD", label="current tool epoch").strip()
+    if not _is_gitsha(out):
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "EPOCH", "REFUSED_PRE_WRITE",
+                    "current HEAD is not a 40-hex commit")
+    return out
+
+
+def _atomic_write_new(repo: Path, rel: str, data: bytes, label: str) -> dict[str, Any]:
+    """Exclusive new-file claim: O_CREAT|O_EXCL|O_NOFOLLOW, fsync, post-read verify.
+
+    Refuses when the target already exists (no same-byte takeover, no cleanup of
+    foreign/unknown residue). Returns observed file identity (dev/ino/size/sha).
+    Primary + secondary errors are both preserved; referenced records are never
+    deleted.
+    """
+    _lexical_rel(repo, rel, label)
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    directory = (repo / rel).parent
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+    except OSError as exc:
+        raise _fail("RECORD_COLLISION", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} parent unavailable: {rel}: {exc}") from exc
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    target = repo.resolve().joinpath(*rel.split("/"))
+    try:
+        fd = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
+    except FileExistsError as exc:
+        raise _fail("RECORD_COLLISION", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} target already claimed (fresh id required, no takeover): "
+                    f"{rel}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} exclusive claim failed: {rel}: {exc}") from exc
+    primary: Exception | None = None
+    try:
+        os.write(fd, data)
+        os.fsync(fd)
+    except OSError as exc:
+        primary = exc
+    try:
+        created_st = os.fstat(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+    try:
+        os.close(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+        else:
+            raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                        f"{label} write failed: {exc}; close also failed: {primary}") from exc
+    if primary is not None:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} write failed: {primary}") from primary
+    try:
+        lst = os.lstat(target)
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write lstat failed: {rel}: {exc}") from exc
+    if stat.S_ISLNK(lst.st_mode):
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write target is symlink: {rel}")
+    if (lst.st_dev, lst.st_ino) != (created_st.st_dev, created_st.st_ino):
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write target replaced (dev/ino changed): {rel}")
+    if lst.st_nlink != 1:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} hardlink sharing refused: {rel}")
+    observed = _fd_safe_read(repo, rel, f"{label} post-write")
+    if observed != data:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write bytes differ: {rel}")
+    return {"path": rel, "sha256": _sha_bytes(observed), "byte_count": len(observed),
+            "st_dev": lst.st_dev, "st_ino": lst.st_ino}
+
+
+def _write_json_bound(repo: Path, rel: str, doc: dict[str, Any], digest_key: str,
+                      label: str, phase: str, code: str) -> bytes:
+    """Exclusive JSON write with self-digest binding on reparse.
+
+    File-ref SHA is the full serialized bytes, distinct from the object
+    self-digest by design (indent=2 file bytes vs compact sorted digest).
+    The self-digest binds when the written bytes reparse to the same digest;
+    that reparse check happens here, before any schema validation or use.
+    """
+    from scripts import survey_production_v2 as core
+    data = core.json_bytes(doc)
+    _atomic_write_new(repo, rel, data, label)
+    reparsed = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, rel, f"{label} reparse"), f"{label} reparse")
+    if not isinstance(reparsed, dict) or core.sha256_object(
+            {k: v for k, v in reparsed.items() if k != digest_key}) != doc.get(digest_key):
+        raise _fail(code, phase, "REFUSED_PRE_WRITE",
+                    f"{label} written bytes do not reparse to the declared self-digest")
+    return data
+
