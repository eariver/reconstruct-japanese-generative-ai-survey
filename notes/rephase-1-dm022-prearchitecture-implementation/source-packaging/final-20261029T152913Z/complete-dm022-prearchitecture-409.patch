+def validate_prepared_renewal_set(root: str | Path, state_path: str | Path,
+                                  set_path: str | Path) -> dict[str, Any]:
+    """Full-set validation: Candidate/QA/Gate/receipt/seal must agree on the
+    SAME proof (equal-SHA different proof paths are never silently substituted).
+    finalize/validate-set MUST refuse a renewed set whose NEW Candidate/QA/Gate
+    files lack the NEW proof ref (absence -> REVIEW_TARGET_MISMATCH, never a
+    silent fallback to the embedded PRIOR proof)."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_publication_set_v2 as setmod
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    set_rel = _lexical_rel(repo, str(set_path), "renewal publication set")
+    seal_bytes = _read_bytes_bounded(repo, set_rel, "renewal publication set")
+    seal = _strict_json_from_bytes(seal_bytes, "renewal publication set")
+    if not isinstance(seal, dict):
+        raise _fail("SEAL_BIND", "SET", "REFUSED_PRE_WRITE", "seal must be an object")
+    try:
+        _validate_pinned_instance(repo, seal, set_rel, _sha_bytes(seal_bytes),
+                                  RENEWAL_SET_SCHEMA, "Renewal Publication Set", "SET",
+                                  fail_code="SEAL_BIND")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("SEAL_BIND", "SET", "REFUSED_PRE_WRITE",
+                    f"seal schema invalid: {exc}") from exc
+    if core.sha256_object({k: v for k, v in seal.items() if k != "set_sha256"}) \
+            != seal.get("set_sha256"):
+        raise _fail("SEAL_BIND", "SET", "REFUSED_PRE_WRITE", "seal self-digest mismatch")
+    for key in ("renewal_basis_ref", "renewal_proof_ref", "source_receipt_ref",
+                "build_record_ref"):
+        ref = seal.get(key)
+        if not isinstance(ref, dict) or not isinstance(ref.get("path"), str) \
+                or not _is_hex64(ref.get("sha256")):
+            raise _fail("SEAL_BIND", "SET", "REFUSED_PRE_WRITE", f"seal {key} invalid")
+        live = _read_bytes_bounded(repo, _lexical_rel(repo, str(ref["path"]),
+                                                      f"seal {key}"), f"seal {key}")
+        if _sha_bytes(live) != ref["sha256"]:
+            raise _fail("SEAL_BIND", "SET", "REFUSED_PRE_WRITE", f"seal {key} bytes changed")
+    proof_ref = seal["renewal_proof_ref"]
+    basis_ref = seal["renewal_basis_ref"]
+    try:
+        validated_seal = setmod.validate_seal(repo, Path(set_rel))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "SEAL_BIND"
+        raise _fail(str(code), "SET", "REFUSED_PRE_WRITE",
+                    f"low seal validation failed: {exc}") from exc
+    _ = validated_seal
+    try:
+        receipt_valid = validate_renewal_receipt(repo, str(seal["source_receipt_ref"]["path"]))
+    except RenewalHighError:
+        raise
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "SEAL_BIND"
+        raise _fail(str(code), "SET", "REFUSED_PRE_WRITE",
+                    f"seal receipt invalid: {exc}") from exc
+    _ = receipt_valid
+    try:
+        proof_verdict = srcmod.verify_renewal_source_proof(repo, str(basis_ref["path"]),
+                                                           str(proof_ref["path"]))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+        raise _fail(str(code), "SET", "REFUSED_PRE_WRITE",
+                    f"seal proof readback failed: {exc}") from exc
+    _ = proof_verdict
+    roles = seal.get("roles", {})
+    candidate_role = roles.get("publication-candidate", {})
+    bundle_role = roles.get("quality-regression-bundle", {})
+    gate_role = roles.get("reader-surface-gate", {})
+    expected = {"path": str(proof_ref["path"]), "sha256": str(proof_ref["sha256"])}
+    receipt_expected = {"path": str(seal["source_receipt_ref"]["path"]),
+                        "sha256": str(seal["source_receipt_ref"]["sha256"])}
+    try:
+        from scripts import survey_publication_v2 as pubmod
+        from scripts import survey_quality_v2 as quality
+        from scripts import survey_reader_surface_gate_v2 as gatemod
+        candidate = pubmod.validate_candidate(repo, repo / str(candidate_role.get("path", "")),
+                                              expected_proof_ref=dict(expected))
+        bundle = quality.validate_bundle(repo, repo / str(bundle_role.get("path", "")),
+                                         expected_proof_ref=dict(expected))
+        gate = gatemod.validate_reader_surface_gate(repo, repo / str(gate_role.get("path", "")),
+                                                    expected_proof_ref=dict(expected),
+                                                    expected_receipt_ref=dict(receipt_expected))
+    except TypeError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "SET", "REFUSED_PRE_WRITE",
+                    "consumer validator lacks the renewal proof context "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except (ValueError, OSError) as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "SET", "REFUSED_PRE_WRITE",
+                    f"set member validation refused: {exc}") from exc
+    for name, doc in (("candidate", candidate), ("bundle", bundle), ("gate", gate)):
+        if name == "gate":
+            got = ((doc.get("derivation") or {}).get("renewal_source_proof_ref")
+                   if isinstance(doc.get("derivation"), dict) else None)
+        else:
+            got = doc.get("renewal_source_proof_ref")
+        if not isinstance(got, dict) or got.get("path") != expected["path"] \
+                or got.get("sha256") != expected["sha256"]:
+            raise _fail("REVIEW_TARGET_MISMATCH", "SET", "REFUSED_PRE_WRITE",
+                        f"full-set SAME-proof equality failed: {name} does not bind the "
+                        f"seal proof (no silent fallback to an embedded prior proof)")
+    return {"SET_VALID": True, "set": seal, "set_path": set_rel,
+            "proof_ref": expected}
