+    family. Healthy LEGACY same-triplet states return LEGACY. Malformed
+    records raise (fail closed, never fall back to the other branch).
+    Diagnostic only; never grants write permission (caller producer
+    readiness separate).
+    """
+    prov = state.get("checkpoint_provenance", {})
+    if not isinstance(prov, dict):
+        return "LEGACY"
+    ev = prov.get("evidence")
+    if not isinstance(ev, dict) or set(ev) != {"path", "sha256"}:
+        return "LEGACY"
+    fam = low.load_typed_checkpoint_record(repo_root, repo_root / str(ev["path"]))
