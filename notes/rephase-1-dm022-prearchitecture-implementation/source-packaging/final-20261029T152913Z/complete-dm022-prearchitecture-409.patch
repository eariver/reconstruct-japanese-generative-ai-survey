+# Explicit C1 copy lists (staged/renewal/derivation/integration).
+# Historical G71 sets retained; G76 adds 2+5. No wildcard, no silent omit.
+C1_EXPLICIT_COPY_LIST_G71_STAGED_PY = 35
+C1_EXPLICIT_COPY_LIST_G71_STAGED_SCHEMAS = 22
+C1_EXPLICIT_COPY_LIST_G76_STAGED_PY = 37
+C1_EXPLICIT_COPY_LIST_G76_STAGED_SCHEMAS = 27
+C1_EXPLICIT_COPY_LIST_G71_RECEIPT_PER_ROUTE = 63
+C1_EXPLICIT_COPY_LIST_G76_RECEIPT_PER_ROUTE = 70
