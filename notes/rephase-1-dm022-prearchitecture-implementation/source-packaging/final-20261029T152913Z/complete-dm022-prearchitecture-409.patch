+        rfd = os.open(tmp, os.O_RDONLY | os.O_NOFOLLOW)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} temp re-open failed, temp preserved at {tmp}: {exc}") from exc
+    try:
+        fst = os.fstat(rfd)
+        if not _stat.S_ISREG(fst.st_mode):
+            raise AcceptanceError(f"{label} temp fstat not regular, temp preserved at {tmp}")
+        chunks: list[bytes] = []
+        while True:
+            chunk = os.read(rfd, 65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        temp_bytes = b"".join(chunks)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} temp re-read failed, temp preserved at {tmp}: {exc}") from exc
+    finally:
+        try:
+            os.close(rfd)
+        except OSError as exc:
+            raise AcceptanceError(f"{label} temp re-close failed, temp preserved at {tmp}: {exc}") from exc
+    if temp_bytes != data:
+        raise AcceptanceError(f"{label} temp bytes differ after write, temp preserved at {tmp}")
+    try:
+        os.link(tmp, path)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} atomic link claim refused (final present or error; no overwrite): {path}: errno={exc.errno}; temp preserved at {tmp}") from exc
