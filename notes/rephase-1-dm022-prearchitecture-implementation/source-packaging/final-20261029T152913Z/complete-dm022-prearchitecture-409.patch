+    def _write_interactive_evidence_for_longform(self, root: Path, chain: dict,
+                                                state_abs: Path, tag: str) -> Path:
+        """Materialize the interactive-evidence input beside the revised R4 acceptance.
+
+        The LONGFORM renderer reads `interactive-evidence.json` next to the active
+        evidence acceptance for cited records (entity/sources/materiality/status).
+        Contents mirror the revised accepted graph exactly (same IDs, verdicts,
+        entity/sources bytes from the accepted cards); synthetic fixture input,
+        explicitly not a genuine assessment.
+        """
+        from scripts import survey_agent_control_v2 as agent
+        state = core.load_json(state_abs)
+        four = agent.resolve_active_research_four_refs(
+            root, core.load_json(root / core.DEFAULT_CONFIG), state)
+        self.assertEqual(four.get("family"), "PREARCH")
+        ev_abs = root / str(four["artifact_refs"]["evidence-acceptance"]["path"])
+        acceptance = core.load_json(ev_abs)
+        card_by_task: dict[str, dict] = {}
+        for row in acceptance.get("results", []):
+            card_path = ev_abs.parent / "results" / row["filename"]
+            card_by_task[row["evidence_task_id"]] = core.load_json(card_path)
+        task_by_did: dict[str, dict] = {}
+        for row in acceptance.get("results", []):
+            for did in row.get("discovery_ids", []):
+                task_by_did[did] = row
+        records = []
+        for did in sorted(task_by_did):
+            row = task_by_did[did]
+            card = card_by_task[row["evidence_task_id"]]
+            entity = (card.get("entities") or [{}])[0]
+            records.append({
+                "discovery_id": did,
+                "status": row.get("status", "VERIFIED"),
+                "materiality": "MATERIAL",
+                "entity": {
+                    "canonical_name": entity.get("canonical_name") or "Synthetic verified model",
+                    "canonical_url": entity.get("canonical_url"),
+                },
+                "sources": card.get("sources", []),
+            })
+            self.assertTrue(records[-1]["entity"]["canonical_url"],
+                            f"chain card must carry canonical_url: {did}")
+            self.assertTrue(records[-1]["sources"], f"chain card must carry sources: {did}")
+        out = ev_abs.parent / "interactive-evidence.json"
+        _write(out, {
+            "schema_version": "2.0-rc1",
+            "issue_id": chain["issue_id"],
+            "runner": {"provider": "SYNTHETIC_FIXTURE_PROVIDER",
+                       "model": "SYNTHETIC_FIXTURE_MODEL_DM022_FULL_V2",
+                       "invocation": f"SYNTHETIC_INTERACTIVE_EVIDENCE_{tag}",
+                       "generated_at": "2026-10-28T00:00:00Z"},
+            "records": records,
+        })
+        return out
