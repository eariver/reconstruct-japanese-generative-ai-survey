+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("RENEWAL_SCOPE_UNREADABLE", f"renewal basis not JSON: {exc}") from exc
+    if not isinstance(basis, dict):
+        raise _fail("RENEWAL_SCOPE_UNREADABLE", "renewal basis is not an object")
+    prior_ref = basis.get("prior_record_ref")
+    if not isinstance(prior_ref, dict) or set(prior_ref) != {"path", "sha256"}:
+        raise _fail("RENEWAL_SCOPE_SHAPE", "renewal basis lacks exact prior_record_ref")
+    # Pin prior record for stability (HIST reloads independently below).
+    prior_rel = col.pinned({"path": prior_ref["path"], "sha256": prior_ref["sha256"]},
+                           "prior record for lineage scope")
