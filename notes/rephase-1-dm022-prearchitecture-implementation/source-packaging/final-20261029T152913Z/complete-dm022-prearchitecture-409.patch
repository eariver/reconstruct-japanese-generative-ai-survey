+        add = _run_git(root, "add", *_src_paths)
+        assert add.returncode == 0, add.stderr[:2000]
+        cm = _run_git(root, "commit", "-m", f"author-H {tag}: NEW fixed complete-source (731, corrected + H fix, isolated)")
