+def _fresh_checks_for_u(sc: Scratch) -> str:
+    # Derive deterministic-checks path from actual layout (not old hardcoded constant):
+    # legacy bootstrap has sources/*/publication/v2/editorial-corrections/*/deterministic-checks.json,
+    # durable versioned-active has .../*/publication/deterministic-checks.json.
+    # Require exactly one overall (honest requires bound fixture, no silent fallback).
+    cands = sorted(sc.work.glob("sources/*/publication/v2/editorial-corrections/*/deterministic-checks.json"))
+    cands += sorted(sc.work.glob("sources/*/publication/v2/editorial-corrections/*/publication/deterministic-checks.json"))
+    # Filter to current issue/prop when multiple (derive from validated State/record manifest).
+    cands = [c for c in cands if f"sources/{sc.issue}/" in str(c) and f"/{sc.prop}/" in str(c)]
+    if len(cands) != 1:
+        raise AssertionError(f"honest requires bound fixture: deterministic-checks.json ambiguous for {sc.issue}/{sc.prop}: {cands}")
+    old = cands[0]
+    doc = json.loads(old.read_bytes())
+    fresh = []
+    for row in doc["checks"]:
+        res = row["result"]
+        live = sc.work / res["path"]
+        assert live.is_file(), f"QA result file missing: {res['path']}"
+        fresh.append({"check_id": row["check_id"], "kind": "DETERMINISTIC", "status": "PASS",
+                      "executor": "phase-S-test fresh deterministic assertions (synthetic, non-genuine)",
+                      "evidence": f"Exact clone bytes reinspected: {res['path']}",
+                      "recorded_at": "2026-10-24T14:00:00+00:00",
+                      "result": {"path": res["path"], "sha256": _sha_file(live)}})
+    out_rel = f"sources/{sc.issue}/publication/v2/editorial-corrections/{sc.prop}/phase-s-fresh-checks.json"
+    (sc.work / out_rel).write_text(json.dumps({"checks": fresh}, indent=1, sort_keys=True), encoding="utf-8")
+    return out_rel
+
