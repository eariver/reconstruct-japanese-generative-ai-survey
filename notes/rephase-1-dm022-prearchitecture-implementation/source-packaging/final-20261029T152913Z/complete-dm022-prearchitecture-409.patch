+def _planned_ref(repo_root: Path, rel: str, payload: dict[str, Any]) -> dict[str, Any]:
+    raw = core.json_bytes(payload)
+    return {
+        "path": rel,
+        "sha256": hashlib.sha256(raw).hexdigest(),
+        "byte_count": len(raw),
+        "payload": payload,
+    }
