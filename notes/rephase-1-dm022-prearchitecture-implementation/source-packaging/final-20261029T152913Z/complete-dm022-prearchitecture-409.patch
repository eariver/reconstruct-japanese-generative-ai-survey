+def _derive_current_editorial_family(repo: Path) -> str:
+    # CURRENT producer family via exact config/schema/member/module predicate
+    # (C1 H helper, pinned a9de2c97; S b139…; stage a1b977… registry).
+    # No hardcoded G76, no len-blanket, no caller flag.
+    try:
+        from scripts import survey_versioned_renewal_history_v2 as _hist_cur  # type: ignore
+    except ImportError as exc:
+        raise _fail("CLOSURE_HIST_MISSING", "PREPARE", "REFUSED_PRE_WRITE", f"history helper missing for current family: {exc}") from exc
+    try:
+        fam = _hist_cur._derive_current_family_from_disk(repo, "editorial closure current family")
+    except Exception as exc:
+        raise _fail("CLOSURE_FAMILY", "PREPARE", "REFUSED_PRE_WRITE", f"current family derive failed: {exc}") from exc
+    if fam not in ("G71", "G76"):
+        raise _fail("UNSUPPORTED_GENERATION", "PREPARE", "REFUSED_PRE_WRITE", f"editorial closure supports G71(63)/G76(70) only, got {fam!r} (G67 50 not editorial)")
+    return fam
+
