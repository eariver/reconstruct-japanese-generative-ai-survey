+
+    def test_healthy_editorial_pointer_positive(self) -> None:
+        # Healthy EDITORIAL revalidation pointer (real file, real SHA, correct kind).
+        # NOT PREARCH → must pass explicit check; mocked full resolve says valid.
+        editorial = {
+            "kind": "EDITORIAL_PUBLICATION_ACTIVATION_V1",
+            "reason_class": "REVIEWED_EDITORIAL_CORRECTION",
+            "issue_id": "SP-RELEASE-DECODER",
+        }
+        source, profile, state_path, verification, release_rec = self._fixture(editorial)
+        # Mock full resolve to valid (for speed; production top + pointer resolve still do full validation).
+        with self._release_mocks(source, profile, verification, release_rec)[0], \
+             self._release_mocks(source, profile, verification, release_rec)[1], \
+             self._release_mocks(source, profile, verification, release_rec)[2], \
+             mock.patch.object(agent, "validate_agent_state", return_value=[]), \
+             mock.patch.object(release_mod.agent, "resolve_active_publication_revalidation", return_value=({"kind": "EDITORIAL_PUBLICATION_ACTIVATION_V1"}, [])):
+            # Must reach lifecycle check (FROZEN ok) then stage_plan, not pointer refusal.
+            # Use real build with mocks for unrelated parts; pointer decoding real.
+            root = Path(".").resolve()
+            # Re-mock cleanly (avoid nested mock helper re-entry).
+            pass
+        # Clean single-mock run for positive (real pointer files, mocked unrelated).
+        with mock.patch.object(agent, "verify_agent_state_basis"), \
+             mock.patch.object(agent, "_profile_and_source", return_value=(source / "production-profile.json", profile, source)), \
+             mock.patch("scripts.survey_release_checkpoint_v2.publication.validate_release_record", return_value={"issue_id": "SP-RELEASE-DECODER", "merge_verification_path": str(verification.relative_to(Path('.').resolve())), "merge_verification_sha256": core.sha256_file(verification)}), \
