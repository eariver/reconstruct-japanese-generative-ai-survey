+                              env={**os.environ, "GIT_OPTIONAL_LOCKS": "0",
+                                    "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"})
+        if proc.returncode != 0 or not (dst / ".git").is_dir():
