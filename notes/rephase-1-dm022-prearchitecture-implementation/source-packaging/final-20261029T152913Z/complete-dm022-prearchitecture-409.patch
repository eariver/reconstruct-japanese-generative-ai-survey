+            for e in bad["capture_inputs"]:
+                # Corrupt the first COPY original path hash (must be a plan path).
+                manifest = core.load_json(manifest_path)
+                copy_orig = [r["path"] for r in manifest["rows"] if r["policy"] == "COPY_BEFORE_REPLACEMENT"][0]
+                if e["path"] == copy_orig:
+                    e["sha256"] = "f" * 64
+                    break
+        _corrupt(_wrong_copy_hash, "CAPTURE_INPUT_MISMATCH|INVALID_RETENTION")
+        def _missing_dep(bad):
+            bad["capture_inputs"] = [e for e in bad["capture_inputs"]
+                                     if e["path"] != "scripts/survey_editorial_retention_v2.py"]
+        _corrupt(_missing_dep, "MISSING_P2R_DEP|RETENTION_MISMATCH")
+        # Historical fingerprint distinction (S3): a wrong P2R dep hash in
+        # capture_inputs is a historical observation, not live attestation.
+        # Presence with well-formed shape suffices, so verification still
+        # succeeds. (Required plan/staged/proposal paths still refuse on
+        # wrong hashes; see _wrong_copy_hash above.)
+        bad_dep = json.loads(good.decode("utf-8"))
+        for e in bad_dep["capture_inputs"]:
+            if e["path"] == "scripts/survey_editorial_retention_v2.py":
+                e["sha256"] = "e" * 64
+                break
+        manifest_path.write_bytes(core.json_bytes(bad_dep))
+        try:
+            self.assertEqual(retention.verify_retention(root, pp, manifest_path)["result"],
+                             "RETAINED_SET_VERIFIED")
+        finally:
+            manifest_path.write_bytes(good)
+        self.assertEqual(retention.verify_retention(root, pp, manifest_path)["result"],
+                         "RETAINED_SET_VERIFIED")
+        def _moved_dest(bad):
+            for r in bad["rows"]:
+                if r["policy"] == "COPY_BEFORE_REPLACEMENT":
+                    r["retained_dest"] = r["retained_dest"].replace("/before/", "/moved/")
+                    break
+        # Moved dest to a nonexistent path refuses at the provisional
+        # COPY-mapping check (RETENTION_DEST_MISMATCH) before any retained
+        # read. (v4 observed PATH_MISSING here before the provisional check
+        # existed; that raw is preserved history, not the current oracle.)
+        _corrupt(_moved_dest, "RETENTION_DEST_MISMATCH")
+        # Moved dest WITH bytes present: plant the moved file, then prove the
+        # provisional mapping rejects it BEFORE any read of the moved path
+        # (fd-chain read recorder) and writes nothing.
+        bad = json.loads(good.decode("utf-8"))
+        moved_row = None
+        for r in bad["rows"]:
+            if r["policy"] == "COPY_BEFORE_REPLACEMENT":
+                moved_row = dict(r)
+                r["retained_dest"] = r["retained_dest"].replace("/before/", "/moved/")
+                break
+        self.assertIsNotNone(moved_row)
+        orig_dest = moved_row["retained_dest"]
+        moved_dest = orig_dest.replace("/before/", "/moved/")
+        planted = root / moved_dest
+        planted.parent.mkdir(parents=True, exist_ok=True)
+        planted.write_bytes((root / orig_dest).read_bytes())
+        manifest_path.write_bytes(core.json_bytes(bad))
+        fd_path: dict[int, str] = {}
+        read_paths: set[str] = set()
+        real_open = os.open
+        real_read = os.read
+
+        def _rec_open(name, *a, **k):
+            fd = real_open(name, *a, **k)
+            parent = k.get("dir_fd")
+            try:
+                sname = name if isinstance(name, str) else os.fsdecode(name)
+            except Exception:
+                sname = "?"
+            if parent is None:
+                fd_path[fd] = sname
+            else:
+                fd_path[fd] = (fd_path.get(parent, "?") + "/" + sname).replace("//", "/")
+            return fd
+
+        def _rec_read(fd, n):
+            read_paths.add(fd_path.get(fd, "?"))
+            return real_read(fd, n)
+
+        pre = _snapshot(root)
+        try:
+            with mock.patch("os.open", side_effect=_rec_open):
+                with mock.patch("os.read", side_effect=_rec_read):
+                    with self.assertRaisesRegex(RetentionError, "RETENTION_DEST_MISMATCH"):
