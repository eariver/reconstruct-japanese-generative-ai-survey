+    def _full_route_witness(self, research_profile: str, tag: str,
+                              discovery_id: str = "target-source") -> dict:
+        """Run DM022 adopt + 7-slot + regeneration + stage advance for one route."""
+        from scripts import survey_agent_control_v2 as agent
+        from scripts import run_selection_architecture_v2_interactive as sel_runner
+        chain = self._chain_root(research_profile, discovery_id=discovery_id)
+        state_abs = self._make_evidence_reviewed_state(chain)
+        root: Path = chain["root"]
+        cfg: dict = chain["cfg"]
+        source_root = self._source_root_of(chain)
+        # Record old canonical Ledger/Completeness bytes (must never be reused after adopt).
+        old_ledger_sha = _sha_file(chain["ledger_path"])
+        old_completeness_sha = _sha_file(chain["completeness_path"])
+        revision_id = f"rev-full-{tag}"
+        out, _, decision_path = self._prepare_and_decide(chain, state_abs, revision_id, [discovery_id])
+        rev_rel = out["revision_root"]
+        before_state_sha = _sha_file(state_abs)
+        adopted = high.adopt_revision(root, state_abs, root / rev_rel, decision_path)
+        self.assertEqual(adopted.get("status"), "ADOPTED")
+        self.assertTrue(adopted.get("guard_released"))
+        # Seven-slot exact inventory: all absent_legitimate at adopt (fresh fixture
+        # had no stale canonical outputs).
+        seven_plan = adopted.get("seven_plan", [])
+        self.assertEqual(len(seven_plan), 7, f"seven_plan must have 7 rows: {seven_plan}")
+        for row in seven_plan:
+            self.assertIn(row.get("slot"), tuple(sel_runner.DM022_SEVEN_SLOTS))
+        self.assertEqual(set(r["slot"] for r in seven_plan), set(sel_runner.DM022_SEVEN_SLOTS))
+        self.assertEqual(set(r["slot"] for r in seven_plan), set(low.SEVEN_SLOTS))
