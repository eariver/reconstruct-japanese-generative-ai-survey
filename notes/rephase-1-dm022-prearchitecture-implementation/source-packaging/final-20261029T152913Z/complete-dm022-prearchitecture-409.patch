+    t.add_argument("--root", required=True)
+    t.add_argument("--basis", required=True)
+    t.add_argument("--executor", required=True)
+    t.add_argument("--recorded-at", default=None)
+    vr = sub.add_parser("validate-receipt")
+    vr.add_argument("--root", required=True)
+    vr.add_argument("--receipt", required=True)
+    vs = sub.add_parser("validate-set")
