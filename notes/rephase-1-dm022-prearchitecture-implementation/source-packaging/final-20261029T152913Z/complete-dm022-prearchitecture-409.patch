+def _require_renewal_entry_window(state: dict[str, Any]) -> None:
+    """Pure named operation eligibility check on just-pinned State bytes.
+
+    Exact predicates of P1 _eligibility (lifecycle VALIDATED_DRAFT, Architecture
+    approved, Preview pending with no Preview Human provenance, downstream
+    publication_preview/freeze/release machine checkpoints all pending, Exception
+    inactive). Examines the pinned State only; never synthesizes State. This is
+    a named check, not a caller flag and not a replacement State validator.
+    """
+    problems: list[str] = []
+    if state.get("lifecycle_state") != "VALIDATED_DRAFT":
+        problems.append("requires healthy VALIDATED_DRAFT")
+    gates = state.get("human_gates", {})
+    if not isinstance(gates, dict) or gates.get("architecture_review") != "approved":
+        problems.append("requires approved Architecture Review")
+    if gates.get("publication_preview") != "pending":
+        problems.append("forbids decided Publication Preview")
+    prov = state.get("human_gate_provenance", {})
+    if isinstance(prov, dict) and prov.get("publication_preview") is not None:
+        problems.append("forbids Publication Preview Human provenance")
+    checkpoints = state.get("machine_checkpoints", {})
+    if not isinstance(checkpoints, dict) or any(
+            checkpoints.get(n) != "pending"
+            for n in ("publication_preview", "freeze", "release")):
+        problems.append("forbids resolved downstream checkpoint")
+    exc_gate = state.get("exception_gate", {})
+    if not isinstance(exc_gate, dict) or exc_gate.get("status") != "inactive":
+        problems.append("forbids active Exception Gate")
+    if problems:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", "ENTRY", "REFUSED_PRE_WRITE",
+                    "; ".join(problems))
+
+
+def _require_new_chain_capacity(prior_history: dict[str, Any], phase: str = "ENTRY") -> None:
+    """Pre-write cap for CREATING new renewal (selected 33 pre-write refusal).
+
+    Entry must check verified prior history.chain_length+1 <=32 BEFORE claiming
+    R/COPY/basis or record/temp writes. Uses actual verified history count
+    (legacy+editorial+renewal via HISTORICAL_IDENTITY_VERIFIED chain_length),
+    NOT filename maxseq (gaps/invalid orphan files don't count selected chain).
+    Guard also covers activation/resume-before old State writes through same
+    entry/observation; no invalid record may publish before known cap check.
+    ALREADY_ACTIVE readonly same active32 remains possible (ALREADY returns
+    before entry, no cap applied to readonly retry, matching CURRENT tools +
+    full source validation). History/source standalone 32 still valid (detached
+    readbacks don't use entry). Existing prior33 invalid still refuses as before
+    (prior_history verification fails before this check). No cap change (32),
+    no history loosening, no synthetic State, no caller count permit. Preserves
+    orphan matching-intent + anchor pre-write checks (called separately).
+    """
+    chain_length = prior_history.get("chain_length") if isinstance(prior_history, dict) else None
+    if not isinstance(chain_length, int):
+        raise _fail("HISTORY_DIGEST_MISMATCH", phase, "REFUSED_PRE_WRITE",
+                    "prior history chain_length missing (verified count required, not filename maxseq)")
+    if chain_length + 1 > CHAIN_LIMIT:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", phase, "REFUSED_PRE_WRITE",
+                    f"new renewal would exceed max32 (prior chain {chain_length}, max32)")
+
