+        "reviewed_at": "2026-09-19T07:00:00+09:00", "recorded_at": "2026-09-19T07:00:00+09:00",
+        "status": "PASSED", "findings": [],
+        "summary": "Synthetic scope PASS for P1 fixture.",
+        "editorial_correction_scope": block,
