+def _check_bundle_profile_exact(bundle_profile: dict[str, Any], state: dict[str, Any],
+                                manuscript: dict[str, Any], col: _Collector) -> None:
+    """Exact path+SHA equality to State-bound Profile (C2, no-op pass removed).
+
+    Requires bundle profile == State profile (path+SHA) and manuscript profile
+    == State profile (coherent selected manuscript). Same-issue valid alternate
+    path (same SHA, different path) must refuse via path mismatch, not broad
+    hash failure. Caller pins live bytes; this checks exact binding.
