+                    tracked.add(fd)
+            except Exception:
+                pass
+            return fd
+
+        def _write_fail(fd, data):
+            # Only fail retention write fds (tracked O_CREAT creates);
+            # subprocess pipe writes pass through.
+            if fd in tracked:
+                raise OSError("injected write failure")
+            return real_write(fd, data)
