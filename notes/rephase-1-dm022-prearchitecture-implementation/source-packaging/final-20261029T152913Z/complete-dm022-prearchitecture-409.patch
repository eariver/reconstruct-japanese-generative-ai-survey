+    def test_verifier_late_retained_additions_refuse(self) -> None:
+        # S1 final-boundary oracles: plant an unexpected retained file or
+        # empty dir LATE in standalone verification (hooked on the staged
+        # proposed-reader read, i.e. after the first retained inventory and
+        # all COPY/KEEP rehashes have passed) and prove the FINAL
+        # re-inventory refuses (INVALID_RETENTION at the final boundary),
+        # with immediate mutated-pre/post equality proving verifier
+        # no-write; removal restores VERIFIED.
+        scratch, root = self._fresh_weekly("jgas-p2r-lateadd-")
+        helper = p1t._new_weekly_helper(self, root)
+        built = p1t._build_weekly_validated(self, helper)
+        chain, state_path = built["chain"], built["state_path"]
+
+        def _mut():
+            authored = core.load_json(chain["authored_path"])
+            authored["cover"]["headline"] = "Weekly lateadd test, revised edition"
+            return authored
+
+        proposal_id = "fixture-wk-la-1"
+        pp, _ = _prepare_proposal_for(self, root, helper, chain, state_path, proposal_id, _mut)
+        out = retention.capture_retention(root, state_path, pp)
+        manifest_path = root / out["manifest_path"]
+        retained_root = manifest_path.parent
+        proposal_dir = f"sources/{W_ISSUE}/publication/v2/editorial-corrections/{proposal_id}"
+        staged_reader_rel = proposal_dir + "/reader-surface-input-v2.json"
+
+        def _run_with_late_plant(kind: str) -> None:
+            planted = {"done": False}
+            fd_path: dict[int, str] = {}
+            real_open = os.open
+            real_read = os.read
+
+            def _rec_open(name, *a, **k):
+                fd = real_open(name, *a, **k)
+                parent = k.get("dir_fd")
+                try:
+                    sname = name if isinstance(name, str) else os.fsdecode(name)
+                except Exception:
+                    sname = "?"
+                if parent is None:
+                    fd_path[fd] = sname
+                else:
+                    fd_path[fd] = (fd_path.get(parent, "?") + "/" + sname).replace("//", "/")
+                return fd
+
+            def _hook_read(fd, n):
+                data = real_read(fd, n)
+                p = fd_path.get(fd, "?")
+                if (p == staged_reader_rel or p.endswith("/" + staged_reader_rel)) and not planted["done"]:
+                    planted["done"] = True
+                    if kind == "file":
+                        (retained_root / "planted-final.txt").write_bytes(b"late plant\n")
+                    else:
+                        (retained_root / "empty-final-dir").mkdir(exist_ok=True)
+                return data
+
+            pre = _snapshot(root)
+            try:
+                with mock.patch("os.open", side_effect=_rec_open):
+                    with mock.patch("os.read", side_effect=_hook_read):
+                        with self.assertRaisesRegex(RetentionError, "INVALID_RETENTION") as ctx:
+                            retention.verify_retention(root, pp, manifest_path)
+            finally:
+                post = _snapshot(root)
+            self.assertTrue(planted["done"], f"late plant never triggered ({kind})")
+            self.assertIn("final retained", str(ctx.exception),
+                          f"refusal did not come from the final boundary ({kind})")
+            # The test's own mid-call plant is the only allowed post-call
+            # delta: remove it first, then the tree must equal pre-call
+            # state exactly (proving the verifier itself wrote nothing).
+            try:
+                target = retained_root / ("planted-final.txt" if kind == "file" else "empty-final-dir")
+                if kind == "file":
+                    target.unlink()
+                else:
+                    target.rmdir()
+            except OSError:
+                pass
+            _assert_no_write(self, pre, _snapshot(root), f"late retained {kind} no-write")
+            self.assertEqual(retention.verify_retention(root, pp, manifest_path)["result"],
+                             "RETAINED_SET_VERIFIED")
+
+        _run_with_late_plant("file")
+        _run_with_late_plant("dir")
