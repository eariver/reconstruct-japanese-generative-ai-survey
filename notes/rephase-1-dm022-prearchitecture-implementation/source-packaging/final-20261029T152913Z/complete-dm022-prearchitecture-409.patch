+    def _build_real_pdf_disposable(self, root: Path, survey_root: Path,
+                                     tag: str,
+                                     source_root: Path | None = None) -> dict:
+        """REAL lualatex+biber PDF in an isolated disposable dir, then exact transfer.
+
+        Copies the complete build inputs (main.tex, references.bib,
+        jgaisurvey.sty) with digest snapshot, builds with the existing TinyTeX
+        toolchain (no install/network), records every subprocess pid/exit/log
+        tail, and transfers the exact PDF bytes to the canonical survey root.
+        """
+        import shutil as _shutil
+        tex_bin = Path("/home/eariver/.TinyTeX/bin/x86_64-linux")
+        for exe in ("lualatex", "biber"):
+            self.assertTrue((tex_bin / exe).is_file(), f"TinyTeX {exe} missing")
+        build_dir = Path(tempfile.mkdtemp(prefix=f"dm022-realpdf-{tag}-"))
+        self.addCleanup(lambda: _shutil.rmtree(build_dir, ignore_errors=True))
+        inputs = {}
+        for name in ("main.tex", "references.bib", "jgaisurvey.sty"):
+            src = survey_root / name
+            self.assertTrue(src.is_file(), f"rendered build input missing: {name}")
+            data = src.read_bytes()
+            (build_dir / name).write_bytes(data)
+            inputs[name] = {"sha256": hashlib.sha256(data).hexdigest(),
+                            "byte_count": len(data)}
+        env = {**os.environ, "PATH": f"{tex_bin}{os.pathsep}{os.environ.get('PATH', '')}",
+               "TERM": "dumb"}
+        log: list[str] = []
+        full_log_paths: list[str] = []
+        steps = [
+            ["lualatex", "-interaction=nonstopmode", "-halt-on-error", "main.tex"],
+            ["biber", "main"],
+            ["lualatex", "-interaction=nonstopmode", "-halt-on-error", "main.tex"],
+            ["lualatex", "-interaction=nonstopmode", "-halt-on-error", "main.tex"],
+        ]
+        tex_log_base = (source_root if source_root is not None
+                          else survey_root.parent)
+        tex_log_dir = tex_log_base / "publication" / "v2" / "tex-build-logs" / tag
+        tex_log_dir.mkdir(parents=True, exist_ok=True)
+        for index, argv in enumerate(steps):
+            proc = subprocess.Popen(
+                [str(tex_bin / argv[0])] + argv[1:], cwd=str(build_dir),
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                text=True, env=env)
+            pid = proc.pid
+            self.assertIsInstance(pid, int)
+            try:
+                out, _ = proc.communicate(timeout=600)
+            except subprocess.TimeoutExpired:
+                proc.kill()
+                out, _ = proc.communicate()
+                self.fail(f"TeX step timed out (pid {pid}): {' '.join(argv)}")
+            step_log_path = tex_log_dir / f"{index:02d}-{argv[0]}-pid{pid}.log"
+            step_log_path.write_text(
+                f"cmd: {' '.join([str(tex_bin / argv[0])] + argv[1:])}\n"
+                f"cwd: {build_dir} (isolated disposable; inputs byte-copied, SHAs in manifest)\n"
+                f"pid: {pid}\nexit: {proc.returncode}\n--- full stdout+stderr ---\n{out}",
+                encoding="utf-8")
+            full_log_paths.append(str(step_log_path.relative_to(root)))
+            log.append(f"pid={pid} exit={proc.returncode} cmd={' '.join(argv)} "
+                       f"fulllog={step_log_path.relative_to(root)}\n"
+                       f"tail={out[-1500:]}")
+            self.assertEqual(proc.returncode, 0,
+                             f"REAL TeX build step failed ({tag}): {' '.join(argv)}\n"
+                             f"{out[-3000:]}")
+        pdf_bytes = (build_dir / "main.pdf").read_bytes()
+        self.assertTrue(pdf_bytes.startswith(b"%PDF"), "built artifact is not a PDF")
+        from pypdf import PdfReader
+        pages = len(PdfReader(build_dir / "main.pdf").pages)
+        self.assertGreaterEqual(pages, 1)
+        target = survey_root / "main.pdf"
+        self.assertFalse(target.exists(), "refusing to overwrite existing canonical PDF")
+        target.write_bytes(pdf_bytes)
+        return {"pdf_sha256": hashlib.sha256(pdf_bytes).hexdigest(),
+                "byte_count": len(pdf_bytes), "page_count": pages,
+                "inputs": inputs, "build_log": log,
+                "full_log_paths": full_log_paths,
+                "build_dir_inputs_sha256": hashlib.sha256(
+                    json.dumps(inputs, sort_keys=True).encode()).hexdigest()}
+
+    def _retain_publication_artifacts(self, root: Path, survey_root: Path,
+                                      source_root: Path, tag: str) -> Path:
+        """Retain the real PDF + full build logs + admission JSONs for later inspection.
+
+        Copies into the witness packet under a run-unique UTC directory (never
+        overwrites prior runs). Independent all-page visual inspection happens
+        later on exactly these bytes; the author inspect loop above is not it.
+        Best-effort: if the packet tree is unreachable from this source copy,
+        the test still passes (fixture evidence remains until cleanup).
+        """
+        packet_base: Path | None = None
+        for parent in [REPO_ROOT, *REPO_ROOT.parents]:
+            candidate = parent / "notes" / "rephase-1-dm022-prearchitecture-implementation" / "evidence"
+            if candidate.is_dir():
+                packet_base = candidate / "full-lifecycle-v2-retained"
+                break
+        if packet_base is None:
+            return Path(".")
+        run_stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+        dest = packet_base / f"{tag}-{run_stamp}"
+        self.assertFalse(dest.exists(), f"retain dir must be run-unique, refusing overwrite: {dest}")
+        dest.mkdir(parents=True)
+        retained: dict[str, str] = {}
+        for rel in ("main.pdf", "main.tex", "references.bib", "jgaisurvey.sty"):
+            src = survey_root / rel
+            if src.is_file():
+                data = src.read_bytes()
+                (dest / rel).write_bytes(data)
+                retained[rel] = hashlib.sha256(data).hexdigest()
+        pub = source_root / "publication" / "v2"
+        for rel in ("reader-manuscript-v2.json", "validated-source-manifest.json",
+                    "quality-regression-bundle-v2.json",
+                    "semantic-editorial-review-v2.json", "visual-review-v2.json",
+                    "reader-surface-gate-v2.json", "reader-surface-input-v2.json",
+                    "reader-surface-semantic-review-v2.json",
+                    "publication-candidate-v2.json",
+                    f"author-pdf-inspection-{tag}.json"):
+            src = pub / rel
+            if src.is_file():
+                (dest / rel.replace("/", "__")).write_bytes(src.read_bytes())
+        logs_src = pub / "tex-build-logs" / tag
+        if logs_src.is_dir():
+            (dest / "tex-build-logs").mkdir()
+            for log_file in sorted(logs_src.iterdir()):
+                (dest / "tex-build-logs" / log_file.name).write_bytes(log_file.read_bytes())
+        _write(dest / "retained-manifest.json", {
+            "tag": tag, "run_stamp": run_stamp,
+            "pdf_sha256": retained.get("main.pdf"),
+            "files": sorted(p.name for p in dest.rglob("*") if p.is_file()),
+        })
+        return dest
+
