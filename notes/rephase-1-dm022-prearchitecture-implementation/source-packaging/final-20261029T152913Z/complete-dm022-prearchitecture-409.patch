+        fds_post_a = set(os.listdir("/proc/self/fd"))
+        self.assertEqual(fds_post_a, fds_pre_a, "fd leak after success-path close fault")
+        # Success again after fault (proves no lingering corruption).
+        before2 = p1t._snapshot(root)
+        out2 = obs.observe_current_authority(root, pair["state_path"], pair["proposal_path"], pair["manifest_path"])
+        self.assertEqual(out2["result"], "CURRENT_BASIS_OBSERVED_NEEDS_SCOPE")
+        p1t._assert_no_write(self, before2, p1t._snapshot(root), "post-fault success no-write")
+        # (b) Primary preserved with secondary close failure at the session
+        # boundary: a pre-observe KEEP mutation deterministically raises
+        # REF_DRIFT at the first retained re-pin (RETAINED phase, observer
+        # session still open); the outer _close_all (2nd _close_all call:
+        # 1 P2R-internal + 1 outer) then fails after really closing, so the
+        # primary code must survive with secondaries attached (not replaced
+        # by CLOSE_FAILED).
+        manifest_obj = core.load_json(pair["manifest_path"])
+        keep_row = next(r for r in manifest_obj["rows"] if r["policy"] == "KEEP_IMMUTABLE")
+        keep_path = root / keep_row["retained_ref"]["path"]
