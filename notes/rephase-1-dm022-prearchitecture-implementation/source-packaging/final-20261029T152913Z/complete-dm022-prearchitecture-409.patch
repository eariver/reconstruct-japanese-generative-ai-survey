+    record: dict[str, Any],
+    ref: dict[str, Any],
+    expected_predecessor: list[dict[str, Any]] | None = None,
+    chain: list[tuple[dict[str, Any], dict[str, Any]]] | None = None,
+    _cache: dict | None = None,
+) -> dict[str, Any]:
+    """HIST structural for one versioned ancestor (no current replay, no State).
+
