+def _canonical_closure_names_for_family(generator_route: str, family: str) -> list[str]:
+    # Family-aware canonical subset: G71 29/34 historical OWN-epoch,
+    # G76 36/41 CURRENT. No hardcoded current-only, no blanket len.
+    if family not in ("G71", "G76"):
+        raise _fail("UNSUPPORTED_GENERATION", "VALIDATE", "REFUSED_PRE_WRITE", f"canonical family must be G71/G76, got {family!r}")
+    if generator_route == "WEEKLY_GENERATED_V2":
+        from scripts import survey_weekly_derivation_v2 as weekly
+        if family == "G71":
+            return [p.as_posix() for p in weekly._CANON_WEEKLY_G71]
+        return [p.as_posix() for p in weekly._CANON_WEEKLY_G76]
+    if generator_route == "LONGFORM_GENERATED_V1":
+        from scripts import survey_longform_generated_v2 as generated
+        if family == "G71":
+            return [p.as_posix() for p in generated._CANON_LONGFORM_G71]
+        return [p.as_posix() for p in generated._CANON_LONGFORM_G76]
+    raise _fail("CLOSURE_ROUTE", "VALIDATE", "REFUSED_PRE_WRITE", f"unknown generator_route: {generator_route!r}")
+
