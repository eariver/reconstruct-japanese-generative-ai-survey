+def readback_revision(repo_root: Path, state_path: Path, revision_path: Path | None = None) -> dict:
+    """Truthful same-State readback + separate producer boundary.
+
+    Reports the adopted operation (triplet same-record, lineage, retained
+    context, completion) WITHOUT claiming publication activation. The separate
+    artifact-producer boundary (Matrix/Selection/Architecture regeneration)
+    is reported as a distinct section, never merged. Works after forward
+    progress (no LIVE EVIDENCE_REVIEWED window re-imposed; genuine-typed public
+    advance reads the adopted record via retained lineage, not a LIVE creation
+    window).
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    state_path = _norm_path(state_path, "state path")
+    resolved = low.resolve_research_authority(repo_root, state_path)
+    out: dict[str, Any] = {
+        "research_acceptance": {
+            "family": resolved["family"],
+            "checkpoint_path": (resolved["lineage"] or {}).get("checkpoint_path"),
+            "triplet": (resolved["lineage"] or {}).get("triplet", False),
+            "lineage": resolved.get("lineage", {}),
+        },
+        "artifact_producer_boundary": {
+            "note": "Matrix/Selection/Architecture regeneration is a separate normal-producer operation; readback here reports research authority only, not regenerated outputs.",
