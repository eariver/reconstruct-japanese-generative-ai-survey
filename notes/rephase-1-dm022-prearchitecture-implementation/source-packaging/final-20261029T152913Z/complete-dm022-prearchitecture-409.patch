+        rb = high.readback_revision(root, validated["state_abs"], root / validated["witness"]["rev_rel"])
+        self.assertEqual(rb["research_acceptance"]["family"], "PREARCH")
+        # Publication selection for VALIDATED_DRAFT with pointer None is CANONICAL (NOT VERSIONED_ACTIVE, NOT PREARCH).
