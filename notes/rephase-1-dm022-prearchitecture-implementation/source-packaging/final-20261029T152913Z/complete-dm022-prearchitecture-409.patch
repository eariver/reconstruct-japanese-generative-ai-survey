+_TRY_TMP_COUNTER = 0
+
+
+def _exclusive_write_bytes(path: Path, data: bytes, label: str) -> dict[str, Any]:
+    """Atomic exclusive claim for immutable R/guard/checkpoint/completion files.
+
+    Single atomic claim, no check-then-act race: bytes go to a sibling temp
+    (O_CREAT|O_EXCL, short-write loop, fsync, checked close, re-read verify),
+    then the final name is claimed atomically with os.link (fails EEXIST when
+    the final already exists — never overwrites an immutable artifact).
+    Partial temp files are PRESERVED on failure (path reported in the error;
+    no hidden unlink) so interrupted attempts stay diagnosable; callers treat
+    an existing final as refuse (new bounded attempt per contract F2), never
+    as overwrite. The State triplet switch (replace_state_triplet) is the ONLY
+    replace-over-existing path (single-writer, held-descriptor, known-byte,
+    inode-pinned); this helper never replaces.
