+#!/usr/bin/env python3
+"""DM022 G71->G76 compatibility witness fixture helper (Owner: G71-G76 witness ONLY).
+
+Test-only helper, never runtime authority, never enters source closures.
+Builds isolated independent fixture DBs from EXACT OLD 742 code (final93
+proof-copy, actual409/tree8ce, pipeline71) with byte-copy .git (no shares,
+inert origin, actual409 ancestry), process-scoped identity, no global config,
+no empty commits, no fixture objects in reconstruct, no ordinary commits.
+G76 TOOL delta install is explicit byte-copy of intended files only, never
+accepted research/Profile/Architecture/Draft/reader/reviews or State pointer.
+All runtime APIs run as fresh subprocess inside fixture (cwd=fixture root)
+to verify imported code matches fixture commit, never hot root modules.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+def write_json(path: Path, payload: Any) -> bytes:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    raw = (json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode()
+    path.write_bytes(raw)
+    return raw
+
+
+def sha_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _run_git(root: Path, *args: str, env: dict | None = None) -> str:
+    base = {**os.environ}
+    if env:
+        base.update(env)
+    base["GIT_OPTIONAL_LOCKS"] = "0"
+    base["GIT_CONFIG_NOSYSTEM"] = "1"
+    for var in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
+                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
+                "GIT_COMMON_DIR"):
+        if var in os.environ and var not in (env or {}):
+            # Fail closed on inherited Git root overrides.
+            raise AssertionError(f"unsafe inherited Git override: {var}")
+    res = subprocess.run(["git", *args], cwd=str(root),
+                         capture_output=True, text=True, env=base, timeout=120)
+    if res.returncode != 0:
+        raise AssertionError(f"git {' '.join(args)} failed: {res.stderr[:2000]}")
+    return res.stdout.strip()
+
+
+def copy_old_source_to_fixture(old_root: Path, fixture_root: Path) -> dict:
+    """Byte-copy OLD .git (no shares) + worktree (excluding .git) to fixture."""
+    old_git = old_root / ".git"
+    dst_git = fixture_root / ".git"
+    if dst_git.exists():
+        raise AssertionError(f"fixture root already has .git: {fixture_root}")
+    fixture_root.mkdir(parents=True, exist_ok=True)
+    # Byte copy .git (no --link, no hardlinks).
+    shutil.copytree(old_git, dst_git, symlinks=False)
+    # Copy worktree excluding .git, __pycache__.
+    for item in old_root.iterdir():
+        if item.name == ".git":
+            continue
+        dst = fixture_root / item.name
+        if item.is_dir():
+            if item.name == "__pycache__":
+                continue
+            shutil.copytree(item, dst, symlinks=False)
+        else:
+            shutil.copy2(item, dst)
+    # Verify no shares, inert origin, no alternates.
+    if (fixture_root / ".git" / "objects" / "info" / "alternates").exists():
+        raise AssertionError("fixture Git DB must not use alternates")
+    origin = _run_git(fixture_root, "remote", "get-url", "origin")
+    if "example.invalid" not in origin:
+        raise AssertionError(f"fixture origin must be inert example.invalid: {origin}")
+    head = _run_git(fixture_root, "rev-parse", "HEAD")
+    tree = _run_git(fixture_root, "rev-parse", "HEAD^{tree}")
+    return {"head": head, "tree": tree, "origin": origin}
+
+
+def configure_process_identity(root: Path, identity: str) -> None:
+    _run_git(root, "config", "user.name", f"Synthetic {identity}")
+    _run_git(root, "config", "user.email", f"{identity}@example.invalid")
+
+
+def commit_all(root: Path, message: str) -> tuple[str, str]:
+    _run_git(root, "add", "-A")
+    # Fail on empty commit: check status first.
+    status = _run_git(root, "status", "--porcelain=v1")
+    if not status.strip():
+        raise AssertionError("refusing empty commit: nothing to commit")
+    _run_git(root, "commit", "-q", "-m", message)
+    head = _run_git(root, "rev-parse", "HEAD")
+    tree = _run_git(root, "rev-parse", "HEAD^{tree}")
+    if len(head) != 40:
+        raise AssertionError(f"bad HEAD after commit: {head}")
+    return head, tree
+
+
+def verify_no_object_share(src_git: Path, dst_git: Path) -> int:
+    """Return overlapping object inode count (must be 0)."""
+    import os as _os
+    src_objs = list((src_git / "objects").rglob("*"))
+    dst_objs = list((dst_git / "objects").rglob("*"))
+    src_inodes = set()
+    for p in src_objs:
+        if p.is_file():
+            try:
+                src_inodes.add((_os.stat(p).st_dev, _os.stat(p).st_ino))
+            except OSError:
+                pass
+    overlap = 0
+    for p in dst_objs:
+        if p.is_file():
+            try:
+                if (_os.stat(p).st_dev, _os.stat(p).st_ino) in src_inodes:
+                    overlap += 1
+            except OSError:
