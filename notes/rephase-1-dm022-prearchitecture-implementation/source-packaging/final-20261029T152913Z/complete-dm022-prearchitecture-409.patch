+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://example.invalid/schemas/versioned-renewal-basis-v2.schema.json",
+  "title": "Survey Versioned Same-Reader Renewal Basis (VERSIONED_RENEWAL_BASIS_V1)",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "kind",
+    "renewal_id",
+    "proposal_namespace",
+    "issue_id",
+    "research_profile",
+    "publication_profile",
+    "generator_route",
+    "original_proposal_ref",
+    "profile_ref",
+    "reviewed_reader_ref",
+    "authoring_refs",
+    "accepted_refs",
+    "original_validation_ref",
+    "prior_selected_ref",
+    "prior_record_ref",
+    "prior_candidate_ref",
+    "canonical_anchor",
+    "before_state_ref",
+    "retained_copy_ref",
+    "observed_source_bindings",
+    "current_tool_epoch",
+    "retention_rows",
+    "requested",
+    "executor",
+    "recorded_at",
+    "basis_sha256"
+  ],
+  "properties": {
+    "schema_version": {"const": "2.0-rc1"},
+    "kind": {"const": "VERSIONED_RENEWAL_BASIS_V1"},
+    "renewal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
+    "proposal_namespace": {"type": "string", "minLength": 1},
+    "issue_id": {"type": "string", "minLength": 1},
+    "research_profile": {"enum": ["WEEKLY", "THEMATIC"]},
+    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
+    "generator_route": {"enum": ["WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"]},
+    "original_proposal_ref": {"$ref": "#/$defs/ref"},
+    "profile_ref": {"$ref": "#/$defs/ref"},
+    "reviewed_reader_ref": {"$ref": "#/$defs/ref"},
+    "authoring_refs": {
+      "type": "array",
+      "minItems": 2,
+      "maxItems": 2,
+      "items": {"$ref": "#/$defs/namedRow"},
+      "uniqueItems": true
+    },
+    "accepted_refs": {
+      "type": "array",
+      "minItems": 1,
+      "items": {"$ref": "#/$defs/namedRow"},
+      "uniqueItems": true
+    },
+    "original_validation_ref": {"$ref": "#/$defs/ref"},
+    "prior_selected_ref": {"$ref": "#/$defs/ref"},
+    "prior_record_ref": {"$ref": "#/$defs/ref"},
+    "prior_candidate_ref": {"$ref": "#/$defs/ref"},
+    "canonical_anchor": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "ref"],
+      "properties": {
+        "kind": {"enum": ["VALIDATION_CHECKPOINT", "LEGACY_REVALIDATION"]},
+        "ref": {"$ref": "#/$defs/ref"}
+      }
+    },
+    "before_state_ref": {"$ref": "#/$defs/ref"},
+    "retained_copy_ref": {"$ref": "#/$defs/sizedRef"},
+    "observed_source_bindings": {
+      "type": "array",
+      "minItems": 1,
+      "items": {"$ref": "#/$defs/observedSourceBinding"},
+      "uniqueItems": true
+    },
+    "current_tool_epoch": {"$ref": "#/$defs/toolEpoch"},
+    "retention_rows": {
+      "type": "array",
+      "minItems": 1,
+      "items": {"$ref": "#/$defs/retentionRow"},
+      "uniqueItems": true
+    },
+    "requested": {"enum": ["REUSE_TARGETS", "RENDER_TARGETS"]},
+    "toolchain_spec_ref": {"$ref": "#/$defs/ref"},
+    "manuscript_spec_ref": {"$ref": "#/$defs/ref"},
+    "executor": {"type": "string", "minLength": 1},
+    "recorded_at": {"type": "string", "format": "date-time"},
+    "basis_sha256": {"$ref": "#/$defs/sha256"}
+  },
+  "allOf": [
+    {
+      "if": {"properties": {"requested": {"const": "REUSE_TARGETS"}}},
+      "then": {"not": {"required": ["toolchain_spec_ref"]}}
+    },
+    {
+      "if": {"properties": {"requested": {"const": "RENDER_TARGETS"}}},
+      "then": {"required": ["toolchain_spec_ref", "manuscript_spec_ref"]}
+    }
+  ],
+  "$defs": {
+    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
+    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
+    "ref": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["path", "sha256"],
+      "properties": {
+        "path": {"type": "string", "minLength": 1},
