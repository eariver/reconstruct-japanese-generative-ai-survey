+def _copy_c2_workspace(testcase: unittest.TestCase, root: Path) -> None:
+    """Full worktree copy for P1-chain fixtures (no git dependence for copy).
+
+    Copies every workspace entry except .git/__pycache__ (byte copy, no
+    hardlinks), so no untracked new module/schema is dropped; .github is
+    included because .github/workflows is a pinned control root (see
+    implementation_control_roots). Asserts the 2 LOW/HIGH modules + 5 DM022
+    schemas are present (explicit list, not count-only). Initializes an
+    independent fixture Git DB (process-scoped identity, inert origin) and
+    verifies a clean tree, mirroring P1 helper discipline.
+    """
+    import tests.test_survey_editorial_correction_proposal_v2 as p1t
+    workspace = Path(__file__).resolve().parents[1]
+    for child in sorted(workspace.iterdir()):
+        if child.name in (".git", "__pycache__"):
+            continue
+        if child.is_symlink():
+            testcase.fail(f"workspace symlink unexpected: {child}")
+        dst = root / child.name
+        if child.is_dir():
+            shutil.copytree(child, dst, symlinks=False,
+                            ignore=shutil.ignore_patterns("__pycache__"))
+        else:
+            shutil.copy2(child, dst)
+    for rel in ("config", "schemas", "scripts", "templates", "prompts", "docs", "data"):
+        src = workspace / rel
+        if src.is_dir():
+            testcase.assertTrue((root / rel).is_dir(), f"C2 workspace copy missing dir: {rel}")
+    for rel in list(p1t.UNTRACKED_SOURCES) + list(p1t.DM022_UNTRACKED_SOURCES):
+        src = workspace / rel
+        if src.is_file() and not (root / rel).is_file():
+            dst = root / rel
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(src, dst)
+    for rel in (
+        "scripts/survey_research_authority_v2.py",
+        "scripts/survey_prearchitecture_acceptance_v2.py",
+        "schemas/dm022-revision-request-v2.schema.json",
+        "schemas/dm022-revision-manifest-v2.schema.json",
+        "schemas/dm022-revision-proof-v2.schema.json",
+        "schemas/dm022-preadoption-report-v2.schema.json",
+        "schemas/dm022-supersession-checkpoint-v2.schema.json",
+    ):
+        testcase.assertTrue((root / rel).is_file(), f"C2 workspace copy missing: {rel}")
+    recipe_src = workspace / ".latexmkrc"
+    testcase.assertTrue(recipe_src.is_file(), "tracked recipe missing: .latexmkrc")
+    shutil.copy2(recipe_src, root / ".latexmkrc")
+    # Fresh independent Git DB for P2V/retention HEAD pins (process-scoped identity).
+    for command in (
+        ["init", "-q"],
+        ["remote", "add", "origin", "https://example.invalid/dm022-c2-fixture.git"],
+        ["add", "-A"],
+        ["-c", "user.name=Synthetic DM022-C2 Fixture",
+         "-c", "user.email=c2-fixture@example.invalid",
+         "commit", "-q", "-m", "Synthetic isolated DM022-C2 fixture basis"],
+    ):
+        proc = _run_git(root, *command)
+        testcase.assertEqual(proc.returncode, 0, f"git {command}: {proc.stderr}")
+    testcase.assertEqual(_run_git(root, "status", "--porcelain").stdout, "")
+
