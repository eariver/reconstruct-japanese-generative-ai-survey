+def _fixture_src(kind: str) -> Path:
+    root = _reconstruct_root()
+    if kind == "weekly":
+        override = os.environ.get("READER_F4_WEEKLY_SRC", "")
+        p = Path(override) if override else (root / WEEKLY_REL)
+    else:
+        override = os.environ.get("READER_F4_LONGFORM_SRC", "")
+        p = Path(override) if override else (root / LONGFORM_REL)
+    # Fail-closed: never allow foreign pre-fix epoch repo (would be tool drift).
+    lowered = str(p).lower()
+    if "high24" in lowered or "040000z" in lowered:
+        raise RuntimeError(f"refusing foreign fixture src: {p}")
+    if not p.is_dir() or not (p / ".git").is_dir():
