+def _classify_live(repo_root: Path, abs_state: Path, before_sha: str, expected_sha: str) -> tuple[str, bytes, str]:
+    try:
+        live_raw = _safe_read_bytes(abs_state, "LIVE at resume")
+    except AcceptanceError as exc:
+        raise AcceptanceError(f"INDETERMINATE: LIVE unreadable at resume: {exc}") from exc
+    live_sha = hashlib.sha256(live_raw).hexdigest()
+    if live_sha == before_sha:
+        return "B", live_raw, live_sha
+    if live_sha == expected_sha:
+        return "E", live_raw, live_sha
+    return "UNKNOWN", live_raw, live_sha
+
+
+def resume_bound_attempt(repo_root: Path, state_path: Path, revision_path: Path) -> dict:
+    """Explicit resume with BOUNDED remaining execution (no blind takeover).
+
+    Known old/new/unknown/nonce-bound context from the retained guard +
+    retention + planned bytes. Executes the remaining state/slot/completion
+    steps (not advice): S==B performs switch+clear+completion+release; S==E
+    clears remaining exact old slots + completion + release; S==E + completion
+    + guard absent reports ALREADY_ACTIVE (no writes); otherwise INDETERMINATE
+    (preserve, no automatic restoration/deletion).
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    state_path = _norm_path(state_path, "state path")
+    revision_path = _norm_path(revision_path, "revision path")
+    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
+    rev_abs = revision_path if revision_path.is_absolute() else (repo_root / str(revision_path))
+    manifest = schema_gate.parse_json_strict_bytes(_safe_read_bytes(rev_abs / "revision-manifest.json", "manifest"), "manifest")
+    before_sha = manifest["before_state"]["sha256"]
+    # Planned expected_after: recompute from retained planned bytes or checkpoint.
+    planned_candidates = [rev_abs / "checkpoint.planned.json", rev_abs / "checkpoint" / "record.json"]
+    planned_raw = None
+    for cand in planned_candidates:
+        if _lstat_single(cand, "planned candidate") is not None:
+            planned_raw = _safe_read_bytes(cand, "planned candidate")
+            break
+    if planned_raw is None:
+        return {"status": "INDETERMINATE", "reason": "no planned/record bytes; preserve guard+retention; manual resolution required"}
+    planned_sha = hashlib.sha256(planned_raw).hexdigest()
+    copy_raw = _safe_read_bytes(rev_abs / "retention" / "state-before.json", "retained COPY")
+    rev_rel = manifest["revision_root"]
+    # Checkpoint rel for expected State: prefer actual record path if present.
+    checkpoint_rel = f"{rev_rel}/checkpoint/record.json"
+    expected_raw = _expected_state_bytes(copy_raw, {"path": checkpoint_rel, "sha256": planned_sha})
+    expected_sha = hashlib.sha256(expected_raw).hexdigest()
+    try:
+        disposition, live_raw, live_sha = _classify_live(repo_root, abs_state, before_sha, expected_sha)
+    except AcceptanceError as exc:
+        return {"status": "INDETERMINATE", "reason": f"LIVE state unreadable at resume; preserve records/bytes/guard: {exc}", "live_sha256": None}
+    if disposition == "UNKNOWN":
+        return {"status": "INDETERMINATE", "reason": "State neither before nor expected-after; preserve records/bytes/guard; no automatic restoration", "live_sha256": live_sha}
+    # Guard context (nonce-bound): load guard if present, verify intent.
+    try:
+        _, _, source_root = _profile_and_source(repo_root, schema_gate.parse_json_strict_bytes(live_raw, "LIVE at resume"))
+    except AcceptanceError as exc:
+        return {"status": "INDETERMINATE", "reason": f"LIVE state unloadable at resume; preserve records/bytes/guard: {exc}", "live_sha256": live_sha}
+    guard_abs = low.guard_path_for(source_root)
+    guard_st = _lstat_single(guard_abs, "guard at resume")
+    if disposition == "B":
+        if guard_st is None:
+            return {"status": "INDETERMINATE", "reason": "State still before but guard absent (lost-guard window before switch); preserve retention; NEW bounded attempt or manual resolution required", "expected_after_state_sha256": expected_sha}
+        guard_doc = schema_gate.parse_json_strict_bytes(_safe_read_bytes(guard_abs, "guard at resume"), "guard")
+        if guard_doc.get("planned_checkpoint_ref", {}).get("sha256") != planned_sha:
+            return {"status": "INDETERMINATE", "reason": "guard planned sha does not match retained intent; preserve; no takeover", "live_sha256": live_sha}
+        if guard_doc.get("before_state_sha256") != before_sha or guard_doc.get("expected_after_state_sha256") != expected_sha:
+            return {"status": "INDETERMINATE", "reason": "guard before/expected shas do not match retained intent; preserve; no takeover", "live_sha256": live_sha}
+        # Execute remaining: ensure checkpoint present, switch, clear, complete, release.
+        retention = schema_gate.parse_json_strict_bytes(_safe_read_bytes(rev_abs / "retention" / "inventory.json", "retention"), "retention")
+        man_snapshots = {r.get("slot"): r for r in manifest.get("retention_snapshots", []) if isinstance(r, dict)}
+        for row in retention.get("rows", []):
+            other = man_snapshots.get(row.get("slot"))
+            if not isinstance(other, dict) or row != other:
+                return {"status": "INDETERMINATE", "reason": f"retention inventory row != stored manifest snapshot for slot: {row.get('slot')}; preserve; manual resolution required", "live_sha256": live_sha}
+        bound = {"repo_root": str(repo_root), "state_path": str(abs_state), "rev_root": str(rev_abs), "source_root": str(source_root), "planned_bytes": planned_raw, "expected_raw": expected_raw, "expected_sha": expected_sha, "retention": retention, "manifest": manifest, "guard": guard_doc}
+        write_checkpoint_as_planned(bound)
+        replace_state_triplet(bound)
+        cleared = clear_remaining_exact_slots(bound)
+        bound["seven_plan"] = cleared["seven_plan"]
+        write_cleanup_completion(bound)
+        release_guard(bound)
