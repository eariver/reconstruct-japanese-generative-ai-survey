+def release_guard(guard: dict) -> dict:
+    """Release OWN guard (held-by-self verified) + verify absent."""
+    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
+    if ctx is None:
+        raise AcceptanceError("release_guard requires HIGH adopt context; see adopt_revision")
+    repo_root = _norm_path(ctx["repo_root"], "repo_root")
+    source_root = Path(ctx["source_root"])
+    guard_doc = ctx["guard"]
+    guard_abs = low.guard_path_for(source_root)
+    st = _lstat_single(guard_abs, "guard at release")
+    if st is None:
+        raise AcceptanceError("guard absent at release (lost-guard window; INDETERMINATE, writers must still require completion; do NOT silently proceed)")
+    guard_cur = _safe_read_bytes(guard_abs, "guard at release")
+    if guard_cur != core.json_bytes(guard_doc):
+        raise AcceptanceError("guard changed before release (foreign/mismatched; refuse, no takeover/delete)")
+    try:
+        os.unlink(guard_abs)
+    except OSError as exc:
+        raise AcceptanceError(f"guard release unlink failed: {exc}") from exc
+    try:
+        dir_fd = os.open(guard_abs.parent, os.O_RDONLY)
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+    except OSError as exc:
+        raise AcceptanceError(f"guard dir fsync failed: {exc}") from exc
+    if _lstat_single(guard_abs, "guard post-release") is not None:
+        raise AcceptanceError("guard still present after release")
+    return {"released": True}
+
