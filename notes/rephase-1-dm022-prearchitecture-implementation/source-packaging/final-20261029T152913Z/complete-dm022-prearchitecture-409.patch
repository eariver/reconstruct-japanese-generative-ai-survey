+def _build_graph(col: _Collector, root: Path, cfg: dict[str, Any], state: dict[str, Any],
+                 original_rows: list[dict[str, str]], effective: dict[str, Any],
+                 active_record: dict[str, Any] | None, receipt: dict[str, Any],
+                 receipt_rel: str, gate_record: dict[str, Any], manuscript: dict[str, Any],
+                 bundle: dict[str, Any], pretex: dict[str, Any],
+                 state_rel: str, profile: dict[str, Any],
+                 renewal_scope_rel: str | None = None,
+                 state_path: Path | None = None) -> tuple[dict[str, Any], list[dict[str, str]]]:
+    graph = _Graph()
+
+    # Strict kind dispatch (no fallback field guess): renewal carries
+    # reviewed_reader_ref/authoring_refs and no staged/scope keys; editorial
+    # carries reviewed_reader_input/authored_refs/scope_review_ref; old canonical
+    # carries reviewed_reader_input/authored_refs/semantic_review.
+    _receipt_kind = receipt.get("kind") if isinstance(receipt, dict) else None
+    _is_renewal_receipt = _receipt_kind == "VERSIONED_RENEWAL_SOURCE_V1"
+    _is_editorial_receipt = _receipt_kind == "EDITORIAL_PUBLICATION_SOURCE_V1"
+    if _is_renewal_receipt and renewal_scope_rel is None:
+        raise _fail("RENEWAL_SCOPE_MISSING", "renewal graph requires lineage scope rel (caller must derive via HIST)")
+
+    # Mutable (COPY) = old mutable publication/State artifacts; KEEP = immutable
+    # research/checkpoints/prior records/tools. Includes ALL effective rows
+    # (later semantic/visual reviews are mutable, not excluded).
