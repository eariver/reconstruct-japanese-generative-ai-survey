+    def _materialize_canonical_accepted_evidence_tree(self, root: Path, chain: dict,
+                                                      state_abs: Path) -> Path:
+        """Mirror the revised R4 Evidence bytes into the canonical accepted tree.
+
+        Drafting's frozen raw-authority check (`_historical_raw_authority_hashes`)
+        requires `source_root/evidence/v2/accepted/<result_set>/evidence-accepted.json`
+        + `results/<filename>` cards with bytes parsed-equal to the package's
+        embedded acceptance. This copies the exact revised R4 bytes (no
+        re-serialization drift: byte copy); the Matrix file is already the
+        canonical regenerated `source_root/candidate-matrix-v2.json`.
+        """
+        from scripts import survey_agent_control_v2 as agent
+        state = core.load_json(state_abs)
+        four = agent.resolve_active_research_four_refs(
+            root, core.load_json(root / core.DEFAULT_CONFIG), state)
+        self.assertEqual(four.get("family"), "PREARCH")
+        refs = four["artifact_refs"]
+        ev_abs = root / str(refs["evidence-acceptance"]["path"])
+        acceptance = core.load_json(ev_abs)
+        result_set = acceptance.get("result_set_sha256")
+        self.assertTrue(isinstance(result_set, str) and result_set,
+                        "revised Evidence acceptance must carry result_set_sha256")
+        profile = core.load_json(chain["profile_path"])
+        source_root = root / profile["paths"]["source_root"]
+        dest_dir = source_root / "evidence" / "v2" / "accepted" / result_set
+        dest_dir.mkdir(parents=True, exist_ok=True)
+        (dest_dir / "evidence-accepted.json").write_bytes(ev_abs.read_bytes())
+        (dest_dir / "results").mkdir(parents=True, exist_ok=True)
+        for row in acceptance.get("results", []):
+            filename = row.get("filename")
+            self.assertTrue(isinstance(filename, str) and filename)
+            src_card = ev_abs.parent / "results" / filename
+            self.assertTrue(src_card.is_file(), f"R4 result card missing: {src_card}")
+            (dest_dir / "results" / filename).write_bytes(src_card.read_bytes())
+        return dest_dir
+
+    def _build_drafting_input(self, root: Path, chain: dict, tag: str) -> Path:
+        """Build independent Drafting semantic input from the real Architecture."""
+        source_root = self._source_root_of(chain)
+        arch = core.load_json(source_root / "architecture-v2.json")
+        cfg = core.load_json(root / "config/survey-production-v2.json")
+        profile = core.load_json(chain["profile_path"])
+        research_reqs = cfg["research_profiles"][profile["research_profile"]]["synthesis_payload_required"]
+        publication_reqs = cfg["publication_profiles"][profile["publication_profile"]]["synthesis_payload_required"]
+        packages = []
+        for plan_row in sorted(arch["packages"], key=lambda r: (r["drafting_order"], r["package_id"])):
+            pid = plan_row["package_id"]
+            primaries = list(plan_row.get("primary_candidate_ids", []))
+            # Resolve one Discovery ID per package from the Matrix for deck refs.
+            matrix = core.load_json(source_root / "candidate-matrix-v2.json")
+            cand_to_dids = {row["candidate_id"]: list(row["discovery_ids"]) for row in matrix["rows"]}
+            deck_dids: list[str] = []
+            for cid in primaries:
+                for did in cand_to_dids.get(cid, []):
+                    if did not in deck_dids:
+                        deck_dids.append(did)
+            packages.append({
+                "package_id": pid,
+                "headline": f"Synthetic headline for {pid} ({tag}): revised MATERIAL finding carried",
+                "deck": f"Synthetic deck for {pid} ({tag}): independent reasoning on the revised graph.",
+                "deck_discovery_ids": deck_dids[:1],
+                "blocks": [{
+                    "block_id": f"{pid}-body",
+                    "block_type": "PARAGRAPH",
+                    "text": f"Synthetic body for {pid} ({tag}): the revised MATERIAL claim is preserved; no HOLD promotion, no fabricated fulfilment.",
+                    "ref_mode": "NONE",
+                    "discovery_ids": [],
+                }],
+            })
+        doc = {
+            "schema_version": "2.0-rc1",
+            "issue_id": chain["issue_id"],
+            "draft_version": f"draft-{tag}",
+            "runner": {"provider": "SYNTHETIC_FIXTURE_PROVIDER",
+                       "model": "SYNTHETIC_FIXTURE_MODEL_DM022_FULL_V2",
+                       "invocation": f"SYNTHETIC_DRAFTING_INPUT_{tag}",
+                       "generated_at": "2026-10-28T00:00:00Z",
+                       "run_reference": None},
+            "packages": packages,
+            "synthesis": {
+                "profile_payload": {k: f"Synthetic {k} for {tag}" for k in research_reqs},
+                "publication_payload": {k: f"Synthetic {k} for {tag}" for k in publication_reqs},
+            },
+        }
+        input_path = root / f"drafting-input-{tag}.json"
+        _write(input_path, doc)
+        return input_path
