+def adopt_revision(repo_root: Path, state_path: Path, revision_path: Path, decision_path: Path) -> dict:
+    """Validate decision + seal + guard + record + switch + clear + verify.
+
+    Destructive order: pin basis -> reverify retention -> claim+revalidate
+    guard -> deterministic proof -> pre-adoption report -> planned checkpoint
+    -> State switch -> checked clearing -> postread -> completion -> release.
+    Unknown LIVE is never rewritten; failures preserve records/bytes/guard
+    with explicit INDETERMINATE posture (no automatic rollback). Original
+    anchor is preserved on repeat (previous PREARCH original_anchor carried;
+    first correction anchors to before evidence).
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    state_path = _norm_path(state_path, "state path")
+    revision_path = _norm_path(revision_path, "revision path")
+    decision_path = _norm_path(decision_path, "decision path")
+    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
+    rev_abs = revision_path if revision_path.is_absolute() else (repo_root / str(revision_path))
+    dec_abs = decision_path if decision_path.is_absolute() else (repo_root / str(decision_path))
+    state_raw = _safe_read_bytes(abs_state, "LIVE state at adopt")
+    try:
+        state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE state at adopt")
+    except Exception as exc:
+        raise AcceptanceError(f"LIVE State strict parse failed: {exc}") from exc
+    cfg = core.load_json(repo_root / str(core.DEFAULT_CONFIG))
+    eligibility = verify_live_eligibility(repo_root, cfg, state)
+    if eligibility:
+        raise AcceptanceError("LIVE eligibility refused at adopt: " + "; ".join(eligibility))
+    _, profile, source_root = _profile_and_source(repo_root, state)
+    manifest_raw = _safe_read_bytes(rev_abs / "revision-manifest.json", "revision manifest")
+    manifest = schema_gate.parse_json_strict_bytes(manifest_raw, "revision manifest")
+    schema_gate.validate_instance(manifest, repo_root / "schemas/dm022-revision-manifest-v2.schema.json", label="revision manifest")
+    # HEAD/tree/contract/tool recheck (no stale pins, no silent overwrite).
+    head_tree_now = _current_head_tree(repo_root)
+    if head_tree_now["head"] != manifest["work"]["expected_head"] or head_tree_now["tree"] != manifest["work"]["expected_tree"]:
+        raise AcceptanceError("LIVE HEAD/tree moved since prepare (stale pins; NEW bounded attempt required, no silent expected_head overwrite)")
+    live_contract_now, live_tools_now = _contract_and_tools(repo_root, cfg, state)
+    if (manifest.get("tool_pins") or {}).get("contract") != live_contract_now:
+        raise AcceptanceError("contract drift since prepare (refuse; NEW attempt required)")
+    manifest_tools = {e.get("path"): e.get("sha256") for e in (manifest.get("tool_pins") or {}).get("tool_shas", []) or []}
+    if manifest_tools != {e["path"]: e["sha256"] for e in live_tools_now}:
+        raise AcceptanceError("tool SHAs drift since prepare (refuse; NEW attempt required)")
+    if hashlib.sha256(state_raw).hexdigest() != manifest["before_state"]["sha256"]:
+        raise AcceptanceError("LIVE State is not exactly before-State at adopt (stale/advanced)")
+    retention_raw = _safe_read_bytes(rev_abs / "retention" / "inventory.json", "retention inventory")
+    retention = schema_gate.parse_json_strict_bytes(retention_raw, "retention inventory")
+    # Exact bind: retention inventory rows must equal the stored manifest
+    # retention_snapshots per slot (identical key sets incl. inodes/byte_count).
+    man_snapshots = {r.get("slot"): r for r in manifest.get("retention_snapshots", []) if isinstance(r, dict)}
+    if set(man_snapshots) != set(low.SEVEN_SLOTS):
