+
+
+def _load(modname: str):
+    root = _repo_root()
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    try:
+        import importlib as _il
+        return _il.import_module(f"scripts.{modname}")
+    finally:
+        if str(root) in sys.path:
+            sys.path.remove(str(root))
