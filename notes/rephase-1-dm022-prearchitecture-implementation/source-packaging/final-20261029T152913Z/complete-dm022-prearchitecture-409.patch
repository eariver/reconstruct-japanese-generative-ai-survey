+++ b/tests/test_survey_versioned_renewal_depth_prewrite_v2.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Versioned renewal depth pre-write cap: 32 allows, 33 refuses before writes.
+
+AUTHOR HIGH boundary fix ONLY (CHAIN_LIMIT 32 preserved, H74275d/S229 unchanged).
+Entry for CREATING new renewal must check verified prior history.chain_length+1
+<=32 BEFORE claiming R/COPY/basis or record/temp writes. Uses actual verified
+history count (legacy+editorial+renewal), NOT filename maxseq (gaps/invalid
+orphan files don't count selected chain). Guard also covers activation/resume-
+before old State writes through same entry/observation; no invalid record may
+publish before known cap check. ALREADY_ACTIVE readonly same active32 remains
+possible under matching CURRENT tools + full source validation (no cap applied
+to readonly retry). History/source standalone 32 still valid. Existing prior33
+invalid still refuses as before. No cap change, no history loosening, no
+synthetic State, no caller count permit.
+
+Scope: exact 32/33/read-only controls, terminal exits. Private fixture provided
+legacy history (r1..r30 clones) != R1x30 actual ops (explicit label, ROOT
+accepts finite construction).
+"""
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+
+def _repo() -> Path:
+    # Fixture root (this test file lives in <fixture>/tests/).
+    return Path(__file__).resolve().parents[1]
+
+
+class DepthPrewriteCapTests(unittest.TestCase):
+    def test_chain_limit_is_32(self) -> None:
+        from scripts import survey_versioned_renewal_v2 as high
+        self.assertEqual(high.CHAIN_LIMIT, 32)
+
+    def test_require_cap_allows_31_refuses_32(self) -> None:
+        from scripts import survey_versioned_renewal_v2 as high
+        # 31+1<=32 allows (new would be 32, no write yet, helper only).
+        high._require_new_chain_capacity({"chain_length": 31}, "ENTRY")
+        # 32+1>32 refuses BEFORE writes (new would be 33).
+        with self.assertRaises(high.RenewalHighError) as ctx:
+            high._require_new_chain_capacity({"chain_length": 32}, "ENTRY")
+        self.assertEqual(ctx.exception.code, "BASIS_ENTRY_INELIGIBLE")
+        self.assertEqual(ctx.exception.phase, "ENTRY")
+        self.assertEqual(ctx.exception.disposition, "REFUSED_PRE_WRITE")
+
+    def test_require_cap_uses_chain_length_not_filename_maxseq(self) -> None:
+        from scripts import survey_versioned_renewal_v2 as high
+        # Gaps/orphans: chain_length 31 with filename max 33 (r32/r33 orphans
+        # preserved) still allows (31+1<=32), NOT refused due to filename max.
+        high._require_new_chain_capacity({"chain_length": 31}, "PREPARE")
+        # Chain_length 32 with filename max 33 still refuses due to verified
