+
+def _safe_read_bytes(path: Path, label: str) -> bytes:
+    try:
+        lst = os.lstat(path)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} absent: {path}: errno={exc.errno}") from exc
+    if not _stat.S_ISREG(lst.st_mode):
+        raise AcceptanceError(f"{label} is not a regular file: {path} (mode={oct(lst.st_mode)})")
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} open(O_NOFOLLOW) failed: errno={exc.errno}") from exc
+    try:
+        fst = os.fstat(fd)
+        if not _stat.S_ISREG(fst.st_mode):
+            raise AcceptanceError(f"{label} fstat not regular: {path}")
+        if (fst.st_dev, fst.st_ino) != (lst.st_dev, lst.st_ino):
+            raise AcceptanceError(f"{label} inode changed between lstat and open (replaced): {path}")
+        chunks: list[bytes] = []
+        while True:
+            data = os.read(fd, 65536)
+            if not data:
+                break
+            chunks.append(data)
+        return b"".join(chunks)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} read failed: {exc}") from exc
+    finally:
+        try:
+            os.close(fd)
+        except OSError as exc:
+            raise AcceptanceError(f"{label} checked close failed: {exc}") from exc
+
+
+def _copy_regular_exclusive(src: Path, dst: Path, label: str) -> dict[str, Any]:
+    """Backup-verified exclusive COPY (source re-read must equal capture)."""
+    if _lstat_single(dst, label + " copy target") is not None:
+        raise AcceptanceError(f"{label} copy target already exists (no overwrite): {dst}")
+    src_bytes = _safe_read_bytes(src, label + " source")
+    src_st = _lstat_single(src, label + " source")
+    if src_st is None:
+        raise AcceptanceError(f"{label} source vanished")
+    info = _exclusive_write_bytes(dst, src_bytes, label + " copy")
+    re_bytes = _safe_read_bytes(src, label + " source re-verify")
+    if re_bytes != src_bytes:
+        raise AcceptanceError(f"{label} source changed during COPY")
+    dst_st = _lstat_single(dst, label + " copy")
+    if dst_st is None:
+        raise AcceptanceError(f"{label} copy vanished")
+    if (dst_st.st_dev, dst_st.st_ino) == (src_st.st_dev, src_st.st_ino):
+        raise AcceptanceError(f"{label} COPY shares inode with source")
+    return {
+        "sha256": hashlib.sha256(src_bytes).hexdigest(),
+        "byte_count": len(src_bytes),
+        "source_dev": src_st.st_dev,
+        "source_ino": src_st.st_ino,
+        "copy_dev": dst_st.st_dev,
+        "copy_ino": dst_st.st_ino,
+    }
+
+
+def _current_head_tree(repo_root: Path) -> dict[str, str]:
+    repo_root = _norm_path(repo_root, "repo_root")
+    try:
+        head = subprocess.run(
+            ["git", "rev-parse", "HEAD"], cwd=repo_root, check=True,
+            capture_output=True, text=True,
+        ).stdout.strip()
+        tree = subprocess.run(
+            ["git", "rev-parse", "HEAD^{tree}"], cwd=repo_root, check=True,
+            capture_output=True, text=True,
+        ).stdout.strip()
+    except Exception as exc:
+        raise AcceptanceError(f"HEAD/tree observation failed: {exc}") from exc
+    if not _HEX40_RE.fullmatch(head) or not _HEX40_RE.fullmatch(tree):
+        raise AcceptanceError("HEAD/tree observation not 40-hex")
+    return {"head": head, "tree": tree}
+
+
+def _revision_root_for(source_root: Path, revision_id: str) -> Path:
+    source_root = _norm_path(source_root, "source_root")
+    if not _REVISION_ID_RE.fullmatch(revision_id):
+        raise AcceptanceError(f"invalid revision_id: {revision_id!r}")
+    return Path(source_root) / "research" / "v2" / "acceptance-revisions" / revision_id
+
+
+def _profile_and_source(repo_root: Path, state: dict[str, Any]) -> tuple[Path, dict[str, Any], Path]:
+    repo_root = _norm_path(repo_root, "repo_root")
+    profile_ref = state.get("profile")
+    if not isinstance(profile_ref, dict) or set(profile_ref) != {"path", "sha256"}:
+        raise AcceptanceError("state.profile authority fields invalid")
+    try:
+        profile_abs = core.repo_local_path(repo_root, profile_ref["path"], "state.profile.path")
+    except ValueError as exc:
+        raise AcceptanceError(f"Production Profile path invalid: {exc}") from exc
+    profile_raw = _safe_read_bytes(profile_abs, "Production Profile")
+    if hashlib.sha256(profile_raw).hexdigest() != profile_ref.get("sha256"):
+        raise AcceptanceError("Production Profile bytes differ from State authority")
+    try:
+        profile = schema_gate.parse_json_strict_bytes(profile_raw, "Production Profile")
+    except Exception as exc:
+        raise AcceptanceError(f"Production Profile strict parse failed: {exc}") from exc
+    try:
+        schema_gate.validate_instance(profile, repo_root / "schemas/survey-production-profile.schema.json", label="Production Profile")
+    except Exception as exc:
+        raise AcceptanceError(f"Production Profile schema invalid: {exc}") from exc
+    try:
+        source_rel = profile["paths"]["source_root"]
+    except (KeyError, TypeError) as exc:
+        raise AcceptanceError(f"profile source_root invalid: {exc}") from exc
+    try:
+        source_root = core.repo_local_path(repo_root, source_rel, "paths.source_root")
+    except ValueError as exc:
+        raise AcceptanceError(f"source_root invalid: {exc}") from exc
+    return profile_abs, profile, source_root
+
+
+def verify_live_eligibility(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any]) -> list[str]:
+    """HIGH-ONLY full strict LIVE State validation (no synthetic bypass).
+
+    Calls public agent.validate_agent_state on the same LIVE bytes, then
+    enforces the exact S3 EVIDENCE_REVIEWED window with actual State shapes:
+    lifecycle, passed Discovery/Screening/Evidence/Materiality/Completeness with
+    valid provenance, no accepted downstream (selection/architecture/draft/
+    validation/publication_preview/freeze/release must be pending/None), no
+    Human approval/provenance (both gates pending, both provenances null, no
+    approval files), no active Exception (status must be inactive), null
+    publication revalidation pointer. Returns error list (empty = eligible).
+    Never writes.
+    """
+    from scripts import survey_agent_control_v2 as agent
+
+    repo_root = _norm_path(repo_root, "repo_root")
+    errors: list[str] = []
+    try:
+        agent_errors = agent.validate_agent_state(repo_root, cfg, state)
+    except Exception as exc:
+        return [f"agent strict State validation raised: {exc}"]
+    if agent_errors:
+        return [f"agent strict State invalid: {agent_errors[0]}"] + agent_errors[1:]
+    if state.get("lifecycle_state") != "EVIDENCE_REVIEWED":
+        errors.append("lifecycle_state must be exactly EVIDENCE_REVIEWED")
+    prov = state.get("checkpoint_provenance", {})
+    if not isinstance(prov, dict):
+        errors.append("checkpoint_provenance invalid")
+    else:
+        for key in ("evidence", "materiality", "completeness"):
+            ref = prov.get(key)
+            if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+                errors.append(f"checkpoint_provenance.{key} authority fields invalid")
+        for key in ("selection", "architecture", "draft", "validation", "publication_preview", "freeze", "release"):
+            if prov.get(key) is not None:
+                errors.append(f"checkpoint_provenance.{key} must be pending (no accepted downstream)")
+    gates = state.get("human_gates", {})
+    if not isinstance(gates, dict):
+        errors.append("human_gates invalid")
+    else:
+        for name in ("architecture_review", "publication_preview"):
+            if gates.get(name) != "pending":
+                errors.append(f"human gate {name} must be pending in S3 window (got {gates.get(name)!r})")
+    gate_prov = state.get("human_gate_provenance", {})
+    if not isinstance(gate_prov, dict):
+        errors.append("human_gate_provenance invalid")
+    else:
+        for name in ("architecture_review", "publication_preview"):
+            if gate_prov.get(name) is not None:
+                errors.append(f"human_gate_provenance.{name} must be null in S3 window (no prior Human review)")
+    exc_gate = state.get("exception_gate", {})
+    if not isinstance(exc_gate, dict):
+        errors.append("exception_gate invalid")
+    else:
+        if exc_gate.get("status") != "inactive":
+            errors.append(f"exception_gate.status must be inactive in S3 window (got {exc_gate.get('status')!r})")
+    if state.get("publication_revalidation_provenance") is not None:
+        errors.append("publication_revalidation_provenance must be null in S3 window")
+    return errors
+
+
+def _rel_of(repo_root: Path, abs_path: Path) -> str:
+    return str(abs_path.resolve().relative_to(repo_root.resolve()))
+
+
+def _prove_before_graph_unbound(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any], source_root: Path, issue_id: str) -> None:
+    """Prove no accepted downstream and no prior Human presentation/review.
+
+    Strict State + review/presentation absence + exact prior refs: downstream
+    machine_checkpoints/provenance pending/None, both Human gates pending with
+    null provenances, no approval files under source_root/gates review paths,
+    and NO prior recorded Human Gate review/decision of ANY kind in a valid
+    review index — including REQUEST_CHANGES, even when the current gates read
+    pending/null and every one of the seven canonical slots is absent. The
+    selected DM022 entry window excludes prior Human presentation/review, not
+    just active approval; absent artifacts or differing SHAs never waive it.
+    An absent index, or a present index that is schema-valid, issue-matched and
+    genuinely empty (reviews: []), remains eligible — absence alone never
+    confers approval. Malformed/unreadable/issue-mismatched index content
+    refuses fail-closed. Raises on any bound or historical evidence: the
+    caller must refuse retention/clearing before any COPY. This predicate
+    applies at DM022 entry (prepare, re-verified at adopt) only — never on
+    the adopted readback/READY path, where the creation window must not be
+    reapplied.
+    """
+    for key in ("selection", "architecture", "draft", "validation", "publication_preview", "freeze", "release"):
+        if state.get("machine_checkpoints", {}).get(key) != "pending":
+            raise AcceptanceError(f"slot retention refused: machine checkpoint {key} is not pending (accepted downstream exists)")
+        if state.get("checkpoint_provenance", {}).get(key) is not None:
+            raise AcceptanceError(f"slot retention refused: checkpoint_provenance.{key} carries accepted downstream")
+    for name in ("architecture_review", "publication_preview"):
+        if state.get("human_gates", {}).get(name) != "pending":
+            raise AcceptanceError(f"slot retention refused: human gate {name} is not pending")
+        if state.get("human_gate_provenance", {}).get(name) is not None:
+            raise AcceptanceError(f"slot retention refused: human_gate_provenance.{name} is set (prior Human review)")
+    authority = cfg.get("state_authority", {})
+    for key in ("architecture_approval_path", "publication_preview_approval_path"):
+        rel = authority.get(key)
+        if not isinstance(rel, str) or not rel:
+            raise AcceptanceError(f"slot retention refused: state_authority.{key} missing from config")
+        probe = source_root / rel
+        st = _lstat_single(probe, f"Human approval probe {rel}")
+        if st is not None:
+            raise AcceptanceError(f"slot retention refused: Human-bound approval file present: {rel}")
+    idx_rel = authority.get("human_review_index_path")
+    if not isinstance(idx_rel, str) or not idx_rel:
+        raise AcceptanceError("slot retention refused: state_authority.human_review_index_path missing from config")
+    idx_abs = source_root / idx_rel
+    if _lstat_single(idx_abs, "Human review index probe") is None:
+        return
+    idx_raw = _safe_read_bytes(idx_abs, "Human review index")
+    try:
+        idx_doc = schema_gate.parse_json_strict_bytes(idx_raw, "Human review index")
+    except Exception as exc:
+        raise AcceptanceError(f"slot retention refused: review index unparseable: {exc}") from exc
+    try:
+        schema_gate.validate_instance(idx_doc, repo_root / "schemas/human-gate-review-index-v2.schema.json", label="Human review index")
+    except Exception as exc:
+        raise AcceptanceError(f"slot retention refused: review index schema invalid: {exc}") from exc
+    if idx_doc.get("issue_id") != issue_id:
+        raise AcceptanceError("slot retention refused: review index issue mismatch")
+    rows = idx_doc.get("reviews", [])
+    if not isinstance(rows, list):
+        raise AcceptanceError("slot retention refused: review index reviews must be an array")
+    for row in rows:
+        if not isinstance(row, dict):
+            raise AcceptanceError("slot retention refused: review index row malformed")
+        gate = row.get("gate")
+        decision = row.get("decision")
+        if gate not in ("ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW") or decision not in ("APPROVED", "REQUEST_CHANGES"):
+            raise AcceptanceError(f"slot retention refused: review index row has unknown gate/decision: {row.get('gate')}/{row.get('decision')}")
+        raise AcceptanceError(
+            f"slot retention refused: prior Human Gate {decision} recorded for {gate} "
+            f"(DM022 entry requires no prior Human presentation/review, not just no active approval)"
+        )
+    return None
+
+
+def _contract_and_tools(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any]) -> tuple[dict[str, Any], list[dict[str, str]]]:
+    contract = core.contract_identity(repo_root, cfg, state.get("research_profile"), state.get("publication_profile"))
+    tool_paths = sorted({str(p) for p in [
+        "scripts/survey_research_authority_v2.py",
+        "scripts/survey_prearchitecture_acceptance_v2.py",
+        "schemas/dm022-revision-request-v2.schema.json",
+        "schemas/dm022-revision-manifest-v2.schema.json",
+        "schemas/dm022-revision-proof-v2.schema.json",
+        "schemas/dm022-preadoption-report-v2.schema.json",
+        "schemas/dm022-supersession-checkpoint-v2.schema.json",
+    ]})
+    tool_shas = []
+    for rel in tool_paths:
+        abs_p = core.repo_local_path(repo_root, rel, "tool pin")
+        raw = _safe_read_bytes(abs_p, f"tool pin {rel}")
+        tool_shas.append({"path": rel, "sha256": hashlib.sha256(raw).hexdigest()})
+    return contract, tool_shas
+
+
+def prepare_revision(repo_root: Path, state_path: Path, request_path: Path, revision_id: str) -> dict:
+    """Pin basis + immutable R snapshots + truthful candidate (no guard/State).
+
+    Inert preparation: no canonical writes, no State writes, no guard claim.
+    Writes ONLY new owned R files via exclusive primitive. Calls FULL content
+    validators after each write (package/cards/views/acceptances/ledger/
+    completeness). Returns {"revision_root", "manifest_ref", "retention",
+    "planned_files"}.
+    """
+    from scripts import survey_agent_control_v2 as agent
+
+    repo_root = _norm_path(repo_root, "repo_root")
+    state_path = _norm_path(state_path, "state path")
+    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
+    state_raw = _safe_read_bytes(abs_state, "LIVE production state")
+    try:
+        state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE production state")
+    except Exception as exc:
+        raise AcceptanceError(f"LIVE State strict parse failed: {exc}") from exc
+    if not isinstance(state, dict):
+        raise AcceptanceError("LIVE State must be an object")
+    cfg = core.load_json(repo_root / str(core.DEFAULT_CONFIG))
+    eligibility = verify_live_eligibility(repo_root, cfg, state)
+    if eligibility:
+        raise AcceptanceError("LIVE eligibility refused: " + "; ".join(eligibility))
+    _, profile, source_root = _profile_and_source(repo_root, state)
+    # Canonical State path check: state_path must be the canonical
+    # <source_root>/production-state.json (not a COPY or temp).
+    try:
+        canonical_state = core.repo_local_path(repo_root, f"{profile['paths']['source_root']}/production-state.json", "canonical state")
+    except ValueError as exc:
+        raise AcceptanceError(f"canonical State path invalid: {exc}") from exc
+    if abs_state.resolve() != canonical_state.resolve():
+        raise AcceptanceError("state_path must be the canonical LIVE production-state.json (not a COPY)")
+    rev_root = _revision_root_for(source_root, revision_id)
+    try:
+        rev_rel_str = str(rev_root.resolve().relative_to(repo_root.resolve()))
+    except ValueError:
+        raise AcceptanceError("revision root must be under repo_root")
+    low.require_no_active_guard(source_root)
+    # Human-window entry check BEFORE any R writes or COPY: refuse prior
+    # recorded Human presentation/review/decision (even REQUEST_CHANGES, even
+    # with all slots absent). Must precede the first exclusive write below.
+    _prove_before_graph_unbound(repo_root, cfg, state, source_root, state.get("issue_id", ""))
+    head_tree = _current_head_tree(repo_root)
+    request_path = _norm_path(request_path, "revision request path")
+    request_abs = request_path if request_path.is_absolute() else (repo_root / str(request_path))
+    request_raw = _safe_read_bytes(request_abs, "revision request")
+    try:
+        request = schema_gate.parse_json_strict_bytes(request_raw, "revision request")
+    except Exception as exc:
+        raise AcceptanceError(f"request strict parse failed: {exc}") from exc
+    schema_gate.validate_instance(request, repo_root / "schemas/dm022-revision-request-v2.schema.json", label="revision request")
+    if request.get("revision_id") != revision_id:
+        raise AcceptanceError("request.revision_id must equal revision_id argument")
+    work = request.get("work", {})
+    if work.get("expected_head") != head_tree["head"] or work.get("expected_tree") != head_tree["tree"]:
+        raise AcceptanceError("request work HEAD/tree does not match LIVE invocation HEAD/tree")
+    # Contract + tool pins must bind actual current files (no stale pins).
+    live_contract, live_tools = _contract_and_tools(repo_root, cfg, state)
+    req_contract = (request.get("tool_pins") or {}).get("contract")
+    if req_contract != live_contract:
+        raise AcceptanceError("request tool_pins.contract does not match LIVE contract_identity (stale pins refused)")
+    req_tools = {e.get("path"): e.get("sha256") for e in (request.get("tool_pins") or {}).get("tool_shas", []) or []}
+    live_map = {e["path"]: e["sha256"] for e in live_tools}
+    if req_tools != live_map:
+        raise AcceptanceError("request tool_pins.tool_shas do not match LIVE tool SHAs (stale pins refused)")
+    # Immutable snapshots: S_before COPY + every present 7-slot COPY.
+    before_ref = request.get("before_state", {})
+    live_rel = before_ref.get("path")
+    if not isinstance(live_rel, str) or not live_rel:
+        raise AcceptanceError("request.before_state.path missing")
+    live_abs = core.repo_local_path(repo_root, live_rel, "before_state.path")
+    if live_abs.resolve() != abs_state.resolve():
+        raise AcceptanceError("request.before_state.path must be the canonical LIVE State path")
+    live_raw = _safe_read_bytes(live_abs, "LIVE state-before")
+    if hashlib.sha256(live_raw).hexdigest() != before_ref.get("sha256"):
+        raise AcceptanceError("LIVE state-before bytes != request.before_state.sha256")
+    if len(live_raw) != before_ref.get("byte_count"):
+        raise AcceptanceError("LIVE state-before byte_count mismatch")
+    retention_dir = rev_root / "retention"
+    state_copy = retention_dir / "state-before.json"
+    state_copy_info = _copy_regular_exclusive(live_abs, state_copy, "state-before COPY")
+    # Previous checkpoint for OLD prompt/contracts + OLD completeness dimension
+    # fallback: from request.before_checkpoint evidence ref.
+    prev_ev_ref = (request.get("before_checkpoint") or {}).get("evidence")
+    if not isinstance(prev_ev_ref, dict):
+        raise AcceptanceError("request.before_checkpoint.evidence missing")
+    prev_abs_for_old = core.repo_local_path(repo_root, prev_ev_ref["path"], "previous checkpoint")
+    prev_raw_for_old = _safe_read_bytes(prev_abs_for_old, "previous checkpoint")
+    if hashlib.sha256(prev_raw_for_old).hexdigest() != prev_ev_ref.get("sha256"):
+        raise AcceptanceError("previous checkpoint FILE sha drift (prepare)")
+    prev_typed_for_old = low.load_typed_checkpoint_record(repo_root, prev_abs_for_old)
+    prev_rec_for_old = prev_typed_for_old["record"]
+    # OLD completeness for dimension/description fallback.
+    old_art_by_name = {r.get("name"): r for r in prev_rec_for_old.get("artifacts", []) if isinstance(r, dict)}
+    old_comp_ref = old_art_by_name.get("profile-completeness")
+    if old_comp_ref is None:
+        raise AcceptanceError("previous record lacks profile-completeness artifact")
+    old_comp_abs = core.repo_local_path(repo_root, old_comp_ref["path"], "OLD completeness")
+    old_comp_raw = _safe_read_bytes(old_comp_abs, "OLD completeness")
+    if hashlib.sha256(old_comp_raw).hexdigest() != old_comp_ref.get("sha256"):
+        raise AcceptanceError("OLD completeness FILE sha drift")
+    old_comp_path_rel = str(old_comp_abs.resolve().relative_to(repo_root.resolve()))
+    # accepted_bound/gate_bound False below is the PROVEN outcome of the entry
+    # window check above (no accepted downstream, no prior Human presentation/
+    # review of any kind), never an unobserved constant.
+    slot_rows: list[dict[str, Any]] = []
+    for slot in low.SEVEN_SLOTS:
+        slot_abs = source_root / slot
+        slot_rel = f"{profile['paths']['source_root']}/{slot}"
+        st = low.lstat_slot(source_root, slot)
+        # lstat_slot returns present True/False; for present nonregular refuse.
+        if st["lstat_kind"] == "nonregular":
+            raise AcceptanceError(f"slot {slot} is nonregular (refuse; never coerce)")
+        if st["lstat_kind"] == "refused":
+            raise AcceptanceError(f"slot {slot} lstat refused (fail-closed)")
+        copy_rel = f"{rev_rel_str}/retention/slots/{slot.replace('/', '__')}"
+        copy_abs = repo_root / copy_rel
+        if not st["present"]:
+            slot_rows.append({
+                "slot": slot, "source_rel": slot_rel, "copy_rel": copy_rel,
+                "present": False, "source_sha256": None, "copy_sha256": None,
+                "byte_count": None, "source_dev": None, "source_ino": None,
+                "copy_dev": None, "copy_ino": None,
+                "accepted_bound": False, "gate_bound": False,
+            })
+            continue
+        cur_st = _lstat_single(slot_abs, f"slot {slot}")
+        if cur_st is None:
+            raise AcceptanceError(f"slot {slot} vanished between lstat and read")
+        slot_raw = _safe_read_bytes(slot_abs, f"slot {slot}")
+        slot_sha = hashlib.sha256(slot_raw).hexdigest()
+        # No per-slot record scan here: the global before-graph proof above
+        # already refuses ANY prior recorded Human review/decision, so no
+        # presented slot can reach the COPY.
+        info = _copy_regular_exclusive(slot_abs, copy_abs, f"slot {slot} COPY")
+        slot_rows.append({
+            "slot": slot, "source_rel": slot_rel, "copy_rel": copy_rel,
+            "present": True, "source_sha256": slot_sha,
+            "copy_sha256": info["sha256"], "byte_count": len(slot_raw),
+            "source_dev": info["source_dev"], "source_ino": info["source_ino"],
+            "copy_dev": info["copy_dev"], "copy_ino": info["copy_ino"],
+            "accepted_bound": False, "gate_bound": False,
+        })
+    # Candidate generation via LOW pure builders (in-memory; HIGH writes).
+    # Package (REAL Discovery/Screening/tasks, REAL prompt/contracts from OLD).
+    built_pkg = low.build_revision_package_from_paths(repo_root, request_abs, state_copy, rev_root / "candidate")
+    pkg_payload = built_pkg["package"]
+    _exclusive_write_bytes(rev_root / "candidate" / "package.json", core.json_bytes(pkg_payload), "R package")
+    for meta in built_pkg["tasks"]:
+        task_raw = core.json_bytes(meta["_task"])
+        _exclusive_write_bytes(rev_root / "candidate" / "tasks" / Path(meta["path"]).name, task_raw, f"R task {meta['evidence_task_id']}")
+    # Cards/views (REAL _build_card/_build_view + REAL validators).
+    results_dir = rev_root / "candidate" / "results"
+    views_dir = rev_root / "candidate" / "views"
+    results_dir.mkdir(parents=True, exist_ok=True)
+    views_dir.mkdir(parents=True, exist_ok=True)
+    # Build cards/views in-memory first (LOW pure reads package file we wrote).
+    # LOW builder reads tasks from package-adjacent tasks dir (we wrote them).
+    from scripts import survey_evidence_v2 as _ev
+
+    cv = low.build_revision_cards_views_from_paths(repo_root, rev_root / "candidate" / "package.json", request_abs, results_dir, views_dir)
+    # Write each card/view DIRECTLY under its exact acceptance filename
+    # (package task basename / view_filename): single atomic exclusive claim
+    # per file, no temp-rename dance, no unlinks of owned outputs.
+    pkg_tasks = {m["evidence_task_id"]: m for m in pkg_payload.get("tasks", [])}
+    if not cv["cards"] or not cv["views"]:
+        raise AcceptanceError("revision produced empty card/view set (refuse empty acceptance inputs)")
+    for card in cv["cards"]:
+        meta = pkg_tasks.get(card["evidence_task_id"])
+        if meta is None:
+            raise AcceptanceError(f"card task missing in package: {card['evidence_task_id']}")
+        _exclusive_write_bytes(results_dir / Path(meta["path"]).name, core.json_bytes(card), f"R card {Path(meta['path']).name}")
+    for view in cv["views"]:
+        _exclusive_write_bytes(views_dir / _ev.view_filename(view["evidence_task_id"]), core.json_bytes(view), f"R view {_ev.view_filename(view['evidence_task_id'])}")
+    # Acceptances (REAL validators + REAL digests). HIGH writes into
+    # digest-named run dirs to satisfy run_dir.name == digest.
+    # First compute acceptances in-memory via LOW (reads results/views dirs).
+    # LOW needs profile_path + accepted roots (planned R dirs); it returns
