+def _write_renewal_seal(repo: Path, basis: dict[str, Any], basis_rel: str,
+                         entry: dict[str, Any], proof: dict[str, Any],
+                         proof_rel: str, receipt_rel: str, build_record_rel: str,
+                         bundle_rel: str, gate_rel: str, candidate_rel: str,
+                         executor: str, ts: str) -> str:
+    """Seal LAST: new set kind VERSIONED_RENEWAL_SET_V1 (not a relaxation of
+    old fixed publication paths). The low validator cross-binds proof/basis/
+    receipt refs in addition to role maps. U keeps original target paths and
+    exact old manuscript/source/PDF/build/review records; receipt/QA/Gate/
+    Candidate point at NEW R paths. C roles bind new R paths (reader/authoring
+    retention/scope-history stay at ORIGINAL P paths via basis)."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    requested = basis.get("requested")
+    if requested == "REUSE_TARGETS":
+        prior_seal = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                                   "prior seal"), "prior seal"), "prior seal")
+        roles = prior_seal.get("roles", {})
+        man_path = str((roles.get("reader-manuscript") or {}).get("path", ""))
+        trio_paths = {k: str((roles.get(rn) or {}).get("path", ""))
+                      for k, rn in (("primary", "validated-source"),
+                                    ("bibliography", "bibliography"), ("style", "style"))}
+        pdf_path = str((roles.get("publication-pdf") or {}).get("path", ""))
+        log_path = str((roles.get("build-log") or {}).get("path", ""))
+        digest_path = str((roles.get("pdf-digest") or {}).get("path", ""))
+        sem_path = str((roles.get("semantic-review") or {}).get("path", ""))
+        vis_path = str((roles.get("visual-review") or {}).get("path", ""))
+    else:
+        man_path = _proof_paths_for_request(basis)["manuscript"]
+        trio_paths = {k: str(v["path"]) for k, v in proof["output_trio_refs"].items()}
+        build_rec = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, build_record_rel, "build record"),
+                                "build record"), "build record")
+        outs = build_rec.get("outputs", {})
+        pdf_path = str((outs.get("publication-pdf") or {}).get("path", ""))
+        log_path = str((outs.get("build-log") or {}).get("path", ""))
+        digest_path = str((outs.get("pdf-digest") or {}).get("path", ""))
+        candidate_doc = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, candidate_rel, "candidate"),
+                                "candidate"), "candidate")
+        sem_path = str((candidate_doc.get("semantic_review") or {}).get("path", ""))
+        vis_path = str((candidate_doc.get("visual_review") or {}).get("path", ""))
+
+    def fr_rel(rel: str, role: str) -> dict[str, Any]:
+        rrel = _lexical_rel(repo, rel, f"seal role {role}")
+        data = _read_bytes_bounded(repo, rrel, f"seal role {role}")
+        if len(data) < 1:
+            raise _fail("SEAL_ROLE", "SEAL", "REFUSED_PRE_WRITE", f"seal role empty: {rrel}")
+        return {"path": rrel, "sha256": _sha_bytes(data), "byte_count": len(data)}
+    roles_new = {
+        "reader-input": fr_rel(str(basis["reviewed_reader_ref"]["path"]), "reader-input"),
+        "authoring-input": fr_rel(str(basis["authoring_refs"][0]["path"]), "authoring-input"),
+        "source-receipt": fr_rel(receipt_rel, "source-receipt"),
+        "reader-manuscript": fr_rel(man_path, "reader-manuscript"),
+        "validated-source": fr_rel(trio_paths["primary"], "validated-source"),
+        "bibliography": fr_rel(trio_paths["bibliography"], "bibliography"),
+        "style": fr_rel(trio_paths["style"], "style"),
+        "publication-pdf": fr_rel(pdf_path, "publication-pdf"),
+        "build-log": fr_rel(log_path, "build-log"),
+        "pdf-digest": fr_rel(digest_path, "pdf-digest"),
+        "quality-regression-bundle": fr_rel(bundle_rel, "quality-regression-bundle"),
+        "semantic-review": fr_rel(sem_path, "semantic-review"),
+        "visual-review": fr_rel(vis_path, "visual-review"),
+        "reader-surface-gate": fr_rel(gate_rel, "reader-surface-gate"),
+        "publication-candidate": fr_rel(candidate_rel, "publication-candidate"),
+    }
+    if set(roles_new) != {"reader-input", "authoring-input", "source-receipt",
+                          "reader-manuscript", "validated-source", "bibliography", "style",
+                          "publication-pdf", "build-log", "pdf-digest",
+                          "quality-regression-bundle", "semantic-review", "visual-review",
+                          "reader-surface-gate", "publication-candidate"}:
+        raise _fail("SEAL_ROLES", "SEAL", "REFUSED_PRE_WRITE", "seal roles must be exactly 15")
+    seen: set[str] = set()
+    for role, ref in roles_new.items():
+        if ref["path"] in seen:
+            raise _fail("SEAL_DUP", "SEAL", "REFUSED_PRE_WRITE",
+                        f"seal duplicated role path: {ref['path']}")
+        seen.add(ref["path"])
+    seal: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_SET_V1",
+        "status": "SEALED_INERT", "issue_id": basis["issue_id"],
+        "research_profile": basis["research_profile"],
+        "publication_profile": basis["publication_profile"],
+        "proposal_ref": dict(basis["original_proposal_ref"]),
+        "renewal_basis_ref": _file_ref(repo, basis_rel, "seal renewal basis"),
+        "renewal_proof_ref": _file_ref(repo, proof_rel, "seal renewal proof"),
+        "source_receipt_ref": {"path": receipt_rel,
+                               "sha256": _sha_bytes(_read_bytes_bounded(
+                                   repo, receipt_rel, "seal receipt"))},
+        "build_record_ref": {"path": build_record_rel,
+                             "sha256": _sha_bytes(_read_bytes_bounded(
+                                 repo, _lexical_rel(repo, build_record_rel, "build record"),
+                                 "seal build record"))},
+        "roles": roles_new,
+    }
+    seal["set_sha256"] = core.sha256_object({k: v for k, v in seal.items()
+                                             if k != "set_sha256"})
+    rel = _proof_paths_for_request(basis)["set"]
+    _write_json_bound(repo, rel, seal, "set_sha256", "renewal publication set",
+                      "SEAL", "SEAL_BIND")
+    try:
+        seal_file_sha = _sha_bytes(_read_bytes_bounded(repo, rel, "renewal seal pin"))
+        _validate_pinned_instance(repo, seal, rel, seal_file_sha,
+                                  RENEWAL_SET_SCHEMA, "Renewal Publication Set", "SEAL",
+                                  fail_code="SEAL_BIND")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("SEAL_BIND", "SEAL", "REFUSED_PRE_WRITE",
+                    f"renewal seal schema invalid: {exc}") from exc
+    return rel
+
