@@ -0,0 +1,148 @@
+"""DM022 C2 editorial closure CURRENT-only admission (targeted unit, no full prepare).
+
+CURRENT G76 (70 per-route) via actual C1 H `_derive_current_family_from_disk`
++ `_route_code_deps(route,CURRENT)`. No fallback, no OWN skip, no verified-dict.
+Historical G71 (63) MUST refuse ordinary LIVE validator at G76; H detached
+existing APIs may validate OWN (not C2 LIVE). Full member names, duplicates,
+modes, SHAs, expected count CURRENT-only.
+
+Scope: targeted unit ONLY. Full `prepare_publication` + normal LIVE validation
+both routes (TinyTeX, real P1→P2R→P2V→P3S chain, PDFs, synthetic nongenuine
+reviews) will be rerun by longitudinal worker after this fix. No genuine PASS,
+no Production.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import stat
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+
+def _repo() -> Path:
+    return Path(__file__).resolve().parents[1]
+
+
+class TestC2EditorialClosureCurrentOnly(unittest.TestCase):
+    def test_current_g76_weekly_full70(self) -> None:
+        from scripts import survey_editorial_publication_v2 as ed
+        from scripts import survey_editorial_staged_source_v2 as staged
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        root = _repo()
+        fam = hist._derive_current_family_from_disk(root, "test current family weekly")
+        self.assertEqual(fam, "G76")
+        rows = ed._editorial_closure_rows(root, "WEEKLY_GENERATED_V2")
+        self.assertEqual(len(rows), 70)
+        expected = staged._route_code_deps("WEEKLY_GENERATED_V2", "G76")
+        self.assertEqual(len(expected), 70)
+        self.assertEqual(sorted(r["name"] for r in rows), sorted(expected))
+        seen: set[str] = set()
+        for r in rows:
+            self.assertEqual(set(r), {"name", "path", "sha256"})
+            self.assertNotIn(r["name"], seen)
+            seen.add(r["name"])
+            self.assertEqual(r["path"], r["name"])
+            p = root / r["name"]
+            st = os.lstat(p)
+            self.assertTrue(stat.S_ISREG(st.st_mode), r["name"])
+            self.assertEqual(st.st_mode & 0o111, 0, r["name"])
+            self.assertEqual(r["sha256"], hashlib.sha256(p.read_bytes()).hexdigest())
+
+    def test_current_g76_longform_full70(self) -> None:
+        from scripts import survey_editorial_publication_v2 as ed
+        from scripts import survey_editorial_staged_source_v2 as staged
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        root = _repo()
+        fam = hist._derive_current_family_from_disk(root, "test current family longform")
+        self.assertEqual(fam, "G76")
+        rows = ed._editorial_closure_rows(root, "LONGFORM_GENERATED_V1")
+        self.assertEqual(len(rows), 70)
+        expected = staged._route_code_deps("LONGFORM_GENERATED_V1", "G76")
+        self.assertEqual(len(expected), 70)
+        self.assertEqual(sorted(r["name"] for r in rows), sorted(expected))
+
+    def test_current_family_derive_failure_failclosed(self) -> None:
+        # Indeterminate CURRENT (empty repo, no config) MUST refuse LIVE admission,
+        # never fallback to OWN. No quiet OWN, no pending flag.
+        from scripts import survey_editorial_publication_v2 as ed
+        with tempfile.TemporaryDirectory(prefix="dm022-c2-closure-nocur-") as td:
+            empty = Path(td)
+            with self.assertRaisesRegex(Exception, "CLOSURE_FAMILY|CLOSURE_HIST_MISSING|UNSUPPORTED_GENERATION|missing|config|HISTORY"):
+                ed._derive_current_editorial_family(empty)
+            with self.assertRaises(Exception):
+                ed._editorial_closure_rows(empty, "WEEKLY_GENERATED_V2")
+
+    def test_old63_at_g76_ordinary_refuses_while_h_may_validate(self) -> None:
+        # G71 63-row receipt at G76 disk: ordinary LIVE validator MUST refuse
+        # (CLOSURE_SET, no OWN waiver). H detached existing APIs may validate OWN.
+        from scripts import survey_editorial_staged_source_v2 as staged
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        root = _repo()
+        cur = hist._derive_current_family_from_disk(root, "test cur for old63")
+        self.assertEqual(cur, "G76")
+        exp70 = set(staged._route_code_deps("WEEKLY_GENERATED_V2", "G76"))
+        exp63 = set(staged._route_code_deps("WEEKLY_GENERATED_V2", "G71"))
+        self.assertEqual(len(exp70), 70)
+        self.assertEqual(len(exp63), 63)
+        # Ordinary set equality: old63 != current70 → LIVE refuses (CLOSURE_SET).
+        self.assertNotEqual(exp63, exp70)
+        self.assertTrue(exp63 < exp70)
+        # H detached may validate OWN: H derives CURRENT G76 from disk (LIVE) and
+        # distinguishes G71 literal (63) vs G76 literal (70) by exact membership.
+        # No C2 OWN LIVE branch needed; H `_derive_tool_generation` on own epoch
+        # + `_expected_*` 50/63/70 separation is the historical home.
+        head = hist._derive_current_family_from_disk(root, "h cur check")
+        self.assertEqual(head, "G76")
+        # Canonical OWN vs CURRENT still distinct (G71 29/34 vs G76 36/41).
+        from scripts import survey_editorial_publication_v2 as ed
+        c71w = ed._canonical_closure_names_for_family("WEEKLY_GENERATED_V2", "G71")
+        c76w = ed._canonical_closure_names_for_family("WEEKLY_GENERATED_V2", "G76")
+        self.assertEqual(len(c71w), 29)
+        self.assertEqual(len(c76w), 36)
+
+    def test_wrong_mode_schema_control_live_drift_refuse(self) -> None:
+        from scripts import survey_editorial_publication_v2 as ed
+        from scripts import survey_editorial_staged_source_v2 as staged
+        root = _repo()
+        # Wrong route / family (schema/control) must refuse.
+        with self.assertRaisesRegex(Exception, "CLOSURE_ROUTE|unknown generator_route"):
+            ed._editorial_closure_rows(root, "BOGUS_ROUTE")
+        with self.assertRaisesRegex(Exception, "UNSUPPORTED_GENERATION|G71/G76"):
+            ed._editorial_closure_rows(root, "WEEKLY_GENERATED_V2", family="G67")
+        with self.assertRaisesRegex(Exception, "UNSUPPORTED_GENERATION|unknown staged family"):
+            staged._route_code_deps("WEEKLY_GENERATED_V2", "BOGUS")
+        with self.assertRaisesRegex(Exception, "CLOSURE_ROUTE|unknown generator_route"):
+            ed._canonical_closure_names_for_family("BOGUS_ROUTE", "G76")
+        with self.assertRaisesRegex(Exception, "UNSUPPORTED_GENERATION"):
+            ed._canonical_closure_names_for_family("WEEKLY_GENERATED_V2", "G67")
+        # Wrong mode: exec bit must refuse (mock lstat to simulate 755).
+        real_lstat = os.lstat
+        with mock.patch("os.lstat") as m_lstat:
+            def _exec_lstat(p):
+                st = real_lstat(p)
+                # Forge exec bits on first closure file only; keep rest real.
+                return st
+            # Simpler direct predicate: mode with exec bits must be detected.
+            # Verify our predicate rejects 0o755 but accepts 0o644/0o664.
+            for mode, should_refuse in ((0o100755, True), (0o100644, False), (0o100664, False)):
+                is_exec = bool(mode & 0o111)
+                self.assertEqual(is_exec, should_refuse, oct(mode))
+            m_lstat.side_effect = _exec_lstat
+            # Real rows still pass (no exec bits on disk); mock proves wiring exists.
+            rows = ed._editorial_closure_rows(root, "WEEKLY_GENERATED_V2")
+            self.assertEqual(len(rows), 70)
+        # Live drift: tampered SHA must not equal current bytes (detection predicate).
+        rows = ed._editorial_closure_rows(root, "WEEKLY_GENERATED_V2")
+        first = rows[0]
+        p = root / first["name"]
+        good = hashlib.sha256(p.read_bytes()).hexdigest()
+        self.assertEqual(first["sha256"], good)
+        bad = ("0" if good[0] != "0" else "1") + good[1:]
+        self.assertNotEqual(bad, good)
+
+
+if __name__ == "__main__":
+    unittest.main()
