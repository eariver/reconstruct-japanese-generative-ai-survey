+    def test_replacement_owned_file_midcapture_refuses(self) -> None:
+        # Capture-time owned COPY file replacement (R4/B1): after all COPY
+        # writes complete, swap one owned COPY file for same bytes under a
+        # new inode just as manifest publish opens. The capture's pre-close
+        # reverify must refuse with FILE_REPLACED (pinned identity vs live
+        # entry); the partial is preserved, retry refuses, live originals
+        # are unchanged and no foreign path is written.
+        scratch, root = self._fresh_weekly("jgas-p2r-repl3-")
+        helper = p1t._new_weekly_helper(self, root)
+        built = p1t._build_weekly_validated(self, helper)
+        chain, state_path = built["chain"], built["state_path"]
+
+        def _mut():
+            authored = core.load_json(chain["authored_path"])
+            authored["cover"]["headline"] = "Weekly repl3 test, revised edition"
+            return authored
+
+        proposal_id = "fixture-wk-rp-own"
+        pp, _ = _prepare_proposal_for(self, root, helper, chain, state_path, proposal_id, _mut)
+        ppath = root / (pp.relative_to(root) if isinstance(pp, Path) and pp.is_absolute() else pp)
+        proposal = core.load_json(ppath)
+        copy_paths = [r["path"] for r in proposal["retention_plan"]
+                      if r["policy"] == "COPY_BEFORE_REPLACEMENT"]
+        self.assertTrue(copy_paths)
+        proposal_dir = f"sources/{W_ISSUE}/publication/v2/editorial-corrections/{proposal_id}"
+        victim_rel = proposal_dir + "/retained/before/" + copy_paths[0]
+        victim = root / victim_rel
+        swapped = {"done": False}
+        orig_open = os.open
+
+        def _open_swap_manifest(name, *a, **k):
+            fd = orig_open(name, *a, **k)
+            try:
+                sname = name if isinstance(name, str) else str(name)
+            except Exception:
+                sname = ""
+            flags = a[0] if a else k.get("flags", 0)
+            try:
+                is_create = bool(flags & os.O_CREAT)
+            except Exception:
+                is_create = False
+            # Manifest publish opens after every COPY write+readback; swap
+            # one owned COPY file now so the pre-close recheck must catch it.
+            # TEST-ONLY proven minimal (readonly diagnosis): unlink+write on
+            # the same path reused the same inode on ext4 (both baseline and
+            # current), so no replacement happened and FILE_REPLACED correctly
+            # did not fire (old raw failure preserved, not product defect).
+            # Rename old victim to UNIQUE backup OUTSIDE the closed retained
+            # namespace, then write same bytes to the freed victim path:
+            # guarantees a new inode (old inode moves to backup). Backup is
+            # outside retained/ so inventory does not preempt with extra-file
+            # before FILE_REPLACED; it is preserved (not deleted) with the
+            # failed fixture for evidence.
+            if sname == "retention-manifest.json" and is_create and not swapped["done"]:
+                swapped["done"] = True
+                data = victim.read_bytes()
+                old_ino = victim.stat().st_ino
+                backup_rel = proposal_dir + "/retained-victim-backup-" + copy_paths[0].replace("/", "_")
+                backup = root / backup_rel
+                assert not backup.exists(), f"backup collision (not UNIQUE): {backup_rel}"
+                victim.rename(backup)
+                victim.write_bytes(data)  # same bytes, new path => new inode
+                new_ino = victim.stat().st_ino
+                backup_ino = backup.stat().st_ino
+                assert backup_ino == old_ino, "rename must preserve old inode at backup"
+                assert old_ino != new_ino, f"replacement requires new inode: old={old_ino} new={new_ino}"
+                assert backup.read_bytes() == data and victim.read_bytes() == data
+                swapped["data"] = data
+                swapped["backup_rel"] = backup_rel
+                swapped["oldino"] = old_ino
+                swapped["newino"] = new_ino
+            return fd
+
+        before = _snapshot(root)
+        with mock.patch("os.open", side_effect=_open_swap_manifest):
+            with self.assertRaisesRegex(RetentionError, "FILE_REPLACED") as ctx:
+                retention.capture_retention(root, state_path, pp)
+        self.assertTrue(swapped["done"], "manifest-open hook never fired")
+        # Actual metadata proof BEFORE expecting FILE_REPLACED (hook already
+        # asserted oldino!=newino; re-assert on live paths here).
+        self.assertIn("backup_rel", swapped, "hook must preserve backup path")
+        self.assertIn("data", swapped, "hook must preserve original bytes")
+        self.assertIn("oldino", swapped, "hook must record old inode")
+        self.assertIn("newino", swapped, "hook must record new inode")
+        _backup = root / swapped["backup_rel"]
+        self.assertTrue(_backup.exists(), "backup must be preserved (not deleted)")
+        self.assertEqual(_backup.read_bytes(), swapped["data"], "backup must preserve original bytes")
+        self.assertEqual(victim.read_bytes(), swapped["data"], "victim must carry same bytes under new inode")
+        self.assertEqual(_backup.stat().st_ino, swapped["oldino"], "backup must keep old inode")
+        self.assertEqual(victim.stat().st_ino, swapped["newino"], "victim must have new inode")
+        self.assertNotEqual(swapped["oldino"], swapped["newino"], "actual metadata: oldino!=newino")
+        self.assertEqual(ctx.exception.disposition, "OWNED_PARTIAL")
+        proposal_retained = proposal_dir + "/retained"
+        self.assertTrue((root / proposal_retained).exists(), "partial not preserved")
+        after = _snapshot(root)
+        for rel, sha in before["files"].items():
+            self.assertIn(rel, after["files"], f"live loss: {rel}")
+            self.assertEqual(after["files"][rel], sha, f"live drift: {rel}")
+        for rel in sorted(set(after["files"]) - set(before["files"])):
+            self.assertTrue(rel.startswith(proposal_retained) or rel == swapped["backup_rel"],
+                            f"foreign write during owned-file refusal: {rel}")
+        with self.assertRaisesRegex(RetentionError, "RETAINED_ROOT_EXISTS"):
+            retention.capture_retention(root, state_path, pp)
