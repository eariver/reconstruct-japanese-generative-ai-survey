+    def _commit_new_tool_epoch(self, root: Path, tag: str, note: str) -> tuple[str, str]:
+        """Commit a new meaningful fixture tool epoch (genuine SHA change).
+
+        Writes a synthetic renewal-intent record (non-closure path, never a
+        tool file) then commits ALL working-tree changes (including the
+        editorial VERSIONED_ACTIVE State) with process-scoped identity.
+        New HEAD differs from prior epoch, satisfying U REUSED_BUILD
+        old != new while preserving G76 CURRENT closure (70 tool files
+        untouched). No empty commits, no global Git config, no alternates.
+        """
+        from tests import dm022_lifecycle_fixture_v2 as fix
+        intent_path = root / "sources" / f"renewal-tool-epoch-{tag}.json"
+        _write(intent_path, {
+            "schema_version": "2.0-rc1",
+            "kind": "SYNTHETIC_RENEWAL_TOOL_EPOCH_INTENT_V1",
+            "tag": tag,
+            "note": note,
+            "reviewer": "SYNTHETIC_FIXTURE_REVIEWER_GENERAL_FULL_V2",
+            "executor": "SYNTHETIC_FIXTURE_EXECUTOR_GENERAL_FULL_V2",
+            "recorded_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+            "closure_preserved": "G76 70 tool files untouched",
+        })
+        old_head = subprocess.run(
+            ["git", "rev-parse", "HEAD"], cwd=str(root),
+            capture_output=True, text=True, timeout=120).stdout.strip()
+        new_head, new_tree = fix.fixture_commit(
+            root, f"Synthetic G76 renewal tool epoch ({tag}): {note}")
+        self.assertNotEqual(new_head, old_head, "new tool epoch must differ (genuine SHA change)")
+        self.assertEqual(len(new_head), 40)
+        return new_head, new_tree
