+
+
+def main(argv: list[str] | None = None) -> int:
+    """Actual CLI with four operations: prepare/adopt/resume/readback."""
+    parser = argparse.ArgumentParser(prog="survey_prearchitecture_acceptance_v2", description="DM022 pre-Architecture acceptance operation (HIGH, sole mutator).")
+    sub = parser.add_subparsers(dest="op", required=True)
+    p = sub.add_parser("prepare", help="Pin basis + immutable R snapshots + truthful candidate.")
+    p.add_argument("--repo-root", required=True)
+    p.add_argument("--state-path", required=True)
+    p.add_argument("--request-path", required=True)
+    p.add_argument("--revision-id", required=True)
+    a = sub.add_parser("adopt", help="Validate decision + seal + guard + switch + clear + verify.")
+    a.add_argument("--repo-root", required=True)
+    a.add_argument("--state-path", required=True)
+    a.add_argument("--revision-path", required=True)
+    a.add_argument("--decision-path", required=True)
+    r = sub.add_parser("resume", help="Explicit bound resume (executes remaining steps).")
+    r.add_argument("--repo-root", required=True)
+    r.add_argument("--state-path", required=True)
+    r.add_argument("--revision-path", required=True)
+    b = sub.add_parser("readback", help="Truthful same-State readback + producer boundary.")
+    b.add_argument("--repo-root", required=True)
+    b.add_argument("--state-path", required=True)
+    b.add_argument("--revision-path", required=False, default=None)
+    args = parser.parse_args(argv)
+    try:
+        if args.op == "prepare":
+            out = prepare_revision(Path(args.repo_root), Path(args.state_path), Path(args.request_path), args.revision_id)
+        elif args.op == "adopt":
+            out = adopt_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path), Path(args.decision_path))
+        elif args.op == "resume":
+            out = resume_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path))
+        elif args.op == "readback":
+            out = readback_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path) if args.revision_path else None)
+        else:
+            parser.error(f"unknown op {args.op}")
+            return 2
+    except (AcceptanceError, ValueError, OSError) as exc:
+        print(json.dumps({"status": "REFUSED", "error": str(exc)}, indent=2), file=sys.stderr)
+        return 1
+    print(json.dumps(out, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
