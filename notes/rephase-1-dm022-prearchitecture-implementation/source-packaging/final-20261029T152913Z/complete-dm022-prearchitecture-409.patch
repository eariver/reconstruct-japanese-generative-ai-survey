+                    f"low activation-record validation failed: {exc}") from exc
+    # Pre-write chain/anchor/seal/basis validation BEFORE any State mutation.
+    # New record/seal/basis/chain anchors must all equal the independently
+    # derived chain identity (latest legacy before FIRST versioned, no rolling,
+    # no originalPath fallback when kind is LEGACY). A known anchor
+    # contradiction must refuse BEFORE State write (never write bad State
+    # then report INDETERMINATE). Post-check below stays strict.
+    try:
+        from scripts import survey_versioned_renewal_history_v2 as hist
+    except ImportError as exc:
+        raise _fail("HISTORY_DIGEST_MISMATCH", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"historian unavailable for pre-write anchor check: {exc}") from exc
+    try:
+        _hist_pre = hist.verify_versioned_history(repo, record_rel_out)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_ANCESTOR"
+        raise _fail(str(code), "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"pre-write history anchor invalid (refused before State mutation): {exc}") from exc
+    _derived_pre = _hist_pre.get("canonical_anchor")
+    if not isinstance(_derived_pre, dict) or set(_derived_pre) != {"kind", "ref"}:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write historian canonical_anchor missing")
+    _rec_anchor = record.get("canonical_anchor")
+    _basis_anchor = basis.get("canonical_anchor") if isinstance(basis, dict) else None
+    if not isinstance(_rec_anchor, dict) or _rec_anchor != _derived_pre:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write new record anchor must equal chain-derived identity (refused before State mutation)")
+    if not isinstance(_basis_anchor, dict) or _basis_anchor != _derived_pre:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write basis anchor must equal chain-derived identity (refused before State mutation)")
+    # No fallback: LEGACY kind must reference an actual legacy record, never
+    # the original validation checkpoint path.
+    if isinstance(_derived_pre, dict) and _derived_pre.get("kind") == "LEGACY_REVALIDATION":
+        _dr = _derived_pre.get("ref", {})
+        _vr = (state.get("checkpoint_provenance") or {}).get("validation", {})
+        if isinstance(_dr, dict) and isinstance(_vr, dict) and _dr.get("path") == _vr.get("path") and _dr.get("sha256") == _vr.get("sha256"):
+            raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        "pre-write LEGACY anchor must not fallback to originalPath")
+    # Simulate expected-after State readback BEFORE mutation (read-only, no
+    # write): strict agent validation + selection on hypothetical post-State.
+    # Catches anchor contradiction and Gate/receipt drift pre-write (e.g.
+    # reader-surface-gate drift caused by wrong anchor via revalidation None
+    # fallback to original). Any failure refuses BEFORE State write.
+    _hypo_state = dict(state)
+    _hypo_state["publication_revalidation_provenance"] = {"path": record_rel_out, "sha256": _sha_bytes(record_bytes)}
+    try:
+        _pre_errors = agent.validate_agent_state(repo, cfg, _hypo_state)
+    except Exception as exc:
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"pre-write hypothetical post-State validation raised (refused before mutation): {exc}") from exc
+    if _pre_errors:
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write hypothetical post-State invalid (refused before State mutation): " + "; ".join(_pre_errors))
+    try:
+        _sel_pre = setmod.resolve_publication_selection(repo, cfg, _hypo_state)
+    except Exception as exc:
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"pre-write hypothetical post-State selection failed (refused before mutation): {exc}") from exc
+    if _sel_pre.get("mode") != "VERSIONED_ACTIVE":
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write hypothetical post-State is not VERSIONED_ACTIVE (refused before mutation)")
+    new_state = dict(state)
+    new_state["publication_revalidation_provenance"] = {"path": record_rel_out,
+                                                        "sha256": _sha_bytes(record_bytes)}
+    new_bytes = core.json_bytes(new_state)
+    _replace_state_bytes(repo, state_rel, expected_old, new_bytes, "activation State")
+    post_bytes = _read_bytes_bounded(repo, state_rel, "activated State")
+    post_state = _strict_json_from_bytes(post_bytes, "activated State")
+    post_errors = agent.validate_agent_state(repo, cfg, post_state)
+    if post_errors:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "post-activation State invalid (preserved, no rollback/overwrite/adoption): "
+                    + "; ".join(post_errors))
+    try:
+        selection_after = setmod.resolve_publication_selection(repo, cfg, post_state)
+    except Exception as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"post-activation selection failed (preserved): {exc}") from exc
+    if selection_after.get("mode") != "VERSIONED_ACTIVE":
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "post-activation selection is not VERSIONED_ACTIVE (preserved)")
+    validate_prepared_renewal_set(repo, state_rel, set_rel)
+    return {"status": "ACTIVATED", "record_path": record_rel_out, "state_path": state_rel,
+            "set_path": set_rel, "observed": "new"}
+
+
+def _replace_state_bytes(repo: Path, state_rel: str, expected_old: bytes,
+                         new_bytes: bytes, label: str) -> dict[str, Any]:
+    """Known-byte State temp/replace: exclusive temp, fsync, os.replace,
+    post-read verify. Write/close/fsync/replace/postread/foreign-inode seams
+    are primary/secondary classified; referenced records are never deleted."""
+    tmp_rel = f"{state_rel}.renewal-tmp"
+    _lexical_rel(repo, tmp_rel, f"{label} temp")
+    _walk_existing_ancestors(repo, _lexical_parts(tmp_rel, f"{label} temp"), label)
+    _walk_existing_ancestors(repo, _lexical_parts(state_rel, label), label)
+    try:
+        os.lstat(repo.resolve().joinpath(*tmp_rel.split("/")))
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp already exists (preserved, no overwrite): {tmp_rel}")
+    except FileNotFoundError:
+        pass
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp check failed (preserved): {exc}") from exc
+    primary: Exception | None = None
+    try:
+        fd = os.open(str(repo.resolve().joinpath(*tmp_rel.split("/"))),
+                     os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp claim failed (preserved): {exc}") from exc
+    try:
+        os.write(fd, new_bytes)
+        os.fsync(fd)
+    except OSError as exc:
+        primary = exc
+    try:
+        os.close(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+        else:
+            try:
+                os.unlink(str(repo / tmp_rel))
+            except OSError:
+                pass
+            raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} temp write failed: {exc}; close also failed: "
+                        f"{primary}") from exc
+    if primary is not None:
+        try:
+            os.unlink(str(repo / tmp_rel))
+        except OSError:
+            pass
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp write failed (preserved): {primary}") from primary
+    try:
+        if _fd_safe_read(repo, tmp_rel, f"{label} temp post-write") != new_bytes:
+            raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} temp post-write mismatch (preserved)")
+        before_st = os.stat(repo.resolve().joinpath(*state_rel.split("/")))
+        os.replace(str(repo.resolve().joinpath(*tmp_rel.split("/"))),
+                   str(repo.resolve().joinpath(*state_rel.split("/"))))
+        after_st = os.stat(repo.resolve().joinpath(*state_rel.split("/")))
+        observed = _fd_safe_read(repo, state_rel, f"{label} post-replace")
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} replace failed (preserved): {exc}") from exc
+    if observed != new_bytes:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-replace mismatch (preserved)")
+    return {"before_dev": before_st.st_dev, "before_ino": before_st.st_ino,
+            "after_dev": after_st.st_dev, "after_ino": after_st.st_ino,
+            "foreign_inode": (before_st.st_dev, before_st.st_ino)
+                             != (after_st.st_dev, after_st.st_ino)}
+
