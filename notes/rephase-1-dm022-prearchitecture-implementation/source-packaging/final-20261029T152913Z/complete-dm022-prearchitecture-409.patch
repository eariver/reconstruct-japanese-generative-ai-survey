+        log = _run_git(work, "log", "--oneline", "-5").stdout.decode()
+        assert "721a04d" in log or len(log.strip().splitlines()) >= 2, f"ancestry not retained: {log[:500]}"
+        snap = [
+            f"HEAD {self.head}",
