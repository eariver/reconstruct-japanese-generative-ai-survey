+            rhigh.prepare_renewal(root, state_abs, ren33_id, "REUSE_TARGETS", ren_spec_path, None, SYNTHETIC_EXECUTOR, datetime(2026, 10, 28, 23, 0, 0, tzinfo=timezone.utc))
+            self.fail("renewal33 prepare must refuse BEFORE R (BASIS_ENTRY_INELIGIBLE, chain32->33)")
+        except rhigh.RenewalHighError as exc33:
