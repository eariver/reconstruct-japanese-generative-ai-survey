+    # Final fresh Evidence recheck before history return (malicious swap between first
+    # node validation and later repeated edges refuses). Every PUBLIC call resets
+    # (_inv_cache fresh). Rechecks live bytes for all derived bindings + prior checkpoint.
+    # No writes, no HEAD/dirty cache, no authority bypass. Late payload swap across
+    # repeated edge already fails fresh SHA on that edge; this catches swap after last
+    # edge but before return.
+    for _b in ordered_bindings:
+        if not isinstance(_b, dict):
+            raise RenewalHistoryError("HISTORY_DIGEST_MISMATCH", "history final live recheck binding must be an object")
+        _sr = _b.get("source_ref", {})
+        if not isinstance(_sr, dict) or set(_sr) != {"path", "sha256"}:
+            raise RenewalHistoryError("HISTORY_DIGEST_MISMATCH", "history final live recheck source_ref invalid")
+        _check_authority_ref(root, {"path": str(_sr.get("path")), "sha256": str(_sr.get("sha256"))}, "history final live recheck")
+    _check_authority_ref(root, prior_checkpoint, "history final prior checkpoint recheck")
+    return {
+        "HISTORICAL_IDENTITY_VERIFIED": True,
+        "observed_refs": observed,
+        "observed_source_bindings": ordered_bindings,
+        "materialization_lineage": materialization_lineage,
+        "chain_length": len(chronological),
+        "anchor_kind": str(_derived_anchor.get("kind")),
+        "canonical_anchor": {"kind": str(_derived_anchor.get("kind")), "ref": {"path": str(_derived_anchor.get("ref", {}).get("path")), "sha256": str(_derived_anchor.get("ref", {}).get("sha256"))}},
+    }
+
+
+def verify_renewal_retention(root: Path | str, basis_path: Path | str) -> dict[str, Any]:
+    repo = Path(root).resolve()
+    rel = str(basis_path)
+    if Path(rel).is_absolute():
+        try:
+            rel = Path(rel).relative_to(repo).as_posix()
+        except ValueError as exc:
+            raise RenewalHistoryError("HISTORY_MODE", "basis path escapes repository root") from exc
+    basis = load_and_validate_json_strict(repo, rel, BASIS_SCHEMA, "renewal basis retention")
+    before_ref = basis.get("before_state_ref")
+    retained_ref = basis.get("retained_copy_ref")
+    if not isinstance(before_ref, dict) or set(before_ref) != {"path", "sha256"}:
+        raise RenewalHistoryError("HISTORY_DIGEST_MISMATCH", "retention before_state_ref fields invalid")
+    if not isinstance(retained_ref, dict) or set(retained_ref) != {"path", "sha256", "byte_count"}:
+        raise RenewalHistoryError("HISTORY_DIGEST_MISMATCH", "retention retained_copy_ref fields invalid")
+    # Do NOT validate live before_state path as mutable authority; validate retained COPY.
