+    def _author_inspect_pdf(self, root: Path, pdf_path: Path,
+                              tag: str, out_dir: Path | None = None) -> dict:
+        """Author-side PDF inspection loop (NOT independent visual review).
+
+        Extracts per-page text with pypdf, records page count, per-page char
+        counts and text digests plus a head excerpt. Explicitly labeled AUTHOR
+        inspection; never a genuine approval and never a substitute for the
+        independent all-page visual inspection (PDF artifacts are retained for
+        that later pass).
+        """
+        from pypdf import PdfReader
+        reader = PdfReader(str(pdf_path))
+        pages = []
+        for index, page in enumerate(reader.pages):
+            text = page.extract_text() or ""
+            pages.append({"page": index + 1, "chars": len(text),
+                          "text_sha256": hashlib.sha256(
+                              text.encode("utf-8")).hexdigest(),
+                          "head": text[:200]})
+        record = {
+            "schema_version": "2.0-rc1",
+            "inspector": "AUTHOR_GENERAL_FULL_V2",
+            "independent_visual": False,
+            "pdf": {"path": str(pdf_path.relative_to(root)),
+                    "sha256": _sha_file(pdf_path),
+                    "byte_count": pdf_path.stat().st_size},
+            "page_count": len(pages),
+            "pages": pages,
+            "summary": (f"Author inspection ({tag}): {len(pages)} pages, "
+                        "explicitly not independent visual review."),
+        }
+        out = (out_dir if out_dir is not None else pdf_path.parent) / f"author-pdf-inspection-{tag}.json"
+        _write(out, record)
+        self.assertGreaterEqual(len(pages), 1)
+        return record
