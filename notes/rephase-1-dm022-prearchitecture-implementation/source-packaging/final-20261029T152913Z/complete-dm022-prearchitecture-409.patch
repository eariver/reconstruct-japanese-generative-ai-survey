+
+class TestC1FamilyClosure(unittest.TestCase):
+    def test_literal_membership_plus_actual_files(self):
+        hist = _load("survey_versioned_renewal_history_v2")
+        root = _repo_root()
+        for route in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
+            g71 = set(hist._expected_receipt_closure(route, "G71"))
+            g76 = set(hist._expected_receipt_closure(route, "G76"))
+            # Literal: delta ONLY 2+5 (R4/R5 literal, not count-only).
+            self.assertTrue(g71 < g76)
+            self.assertEqual(g76 - g71, set(h.DM022_NEW_UNTRACKED_7))
+            # Actual files exist in repo (not just names).
+            for p in g76:
+                self.assertTrue((root / p).is_file(), f"closure member missing on disk: {p}")
+            # Actual module imports subset of literal (AST, no imports/cache).
+            import ast as _ast
+            for modfile in ("survey_versioned_renewal_history_v2.py", "survey_versioned_renewal_source_v2.py"):
+                src = (root / "scripts" / modfile).read_text(encoding="utf-8")
+                tree = _ast.parse(src)
+                actual = set()
+                for node in _ast.walk(tree):
+                    if isinstance(node, (_ast.ImportFrom,)):
+                        if node.module and node.module.startswith("scripts."):
+                            actual.add(f"scripts/{node.module.split('.', 1)[1]}.py")
+                # Renewal history/source top-level must not import beyond family (function-local only).
+                self.assertTrue(actual <= set(hist._OLD_PY_30) | set(hist._NEW_PY_3) | set(hist._FAMILY_PY_2) | set(hist._NEW_DM022_MODULES_2) | {"scripts/survey_production_v2.py", "scripts/survey_schema_v2.py", "scripts/survey_agent_control_v2.py", "scripts/survey_evidence_v2.py", "scripts/survey_screening_v2.py", "scripts/survey_completeness_v2.py"} | set(h.DM022_NEW_UNTRACKED_7) | {"scripts/survey_versioned_renewal_history_v2.py", "scripts/survey_versioned_renewal_source_v2.py", "scripts/survey_versioned_renewal_v2.py"},
+                                f"unexpected top-level import in {modfile}: {sorted(actual)}")
+
+    def test_staged_literal_plus_ast(self):
+        staged = _load("survey_editorial_staged_source_v2")
+        root = _repo_root()
+        for route in (staged.WEEKLY_ROUTE, staged.LONGFORM_ROUTE):
+            g71 = set(staged._route_code_deps(route, "G71"))
+            g76 = set(staged._route_code_deps(route, "G76"))
