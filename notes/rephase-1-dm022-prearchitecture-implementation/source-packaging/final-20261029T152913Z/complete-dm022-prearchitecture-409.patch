+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="survey_versioned_renewal_v2",
+                                     description="Versioned same-reader renewal HIGH operation")
+    sub = parser.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("prepare")
+    p.add_argument("--root", required=True)
+    p.add_argument("--state", required=True)
+    p.add_argument("--renewal-id", required=True)
+    p.add_argument("--intent", required=True, choices=list(INTENTS))
+    p.add_argument("--manuscript-spec", required=True)
+    p.add_argument("--toolchain-spec", default=None)
+    p.add_argument("--executor", required=True)
+    p.add_argument("--recorded-at", default=None)
