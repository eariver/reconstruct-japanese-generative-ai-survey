+        for rel, sup_bytes in supplemental.items():
+            # Supplemental may not replace an original value (B1).
+            if rel in orig_live_map or rel in orig_ret_map:
+                raise _fail("SUPPLEMENTAL_CONFLICT", phase, disp or "REFUSED_PRE_WRITE",
+                            f"supplemental path replaces original pin: {rel}", owned)
+            cur = live.files.get(rel)
+            if cur is None or cur != sup_bytes:
+                raise _fail("PIN_DRIFT", phase, disp or "REFUSED_PRE_WRITE",
