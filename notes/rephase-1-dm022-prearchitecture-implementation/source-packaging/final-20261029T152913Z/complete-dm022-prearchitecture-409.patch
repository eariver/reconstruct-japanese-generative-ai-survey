+        manifest["manifest_digest"] = core.sha256_object(
+            {k: v for k, v in manifest.items() if k != "manifest_digest"})
+        staged_manifest.write_bytes(core.json_bytes(
+            {k: manifest[k] for k in sorted(manifest)}))
