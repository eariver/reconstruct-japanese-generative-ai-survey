+    def test_verifier_capture_inputs_deps_dest_dirs_sizes(self) -> None:
+        scratch, root = self._fresh_weekly("jgas-p2r-bind-")
+        helper = p1t._new_weekly_helper(self, root)
+        built = p1t._build_weekly_validated(self, helper)
