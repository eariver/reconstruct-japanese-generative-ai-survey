+    f.add_argument("--root", required=True)
+    f.add_argument("--state", required=True)
+    f.add_argument("--basis", required=True)
+    f.add_argument("--checks", required=True)
+    f.add_argument("--semantic-review", default=None)
+    f.add_argument("--visual-review", default=None)
+    f.add_argument("--executor", required=True)
+    f.add_argument("--recorded-at", default=None)
