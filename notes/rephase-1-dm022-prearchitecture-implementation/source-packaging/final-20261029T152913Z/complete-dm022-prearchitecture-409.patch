+def _require_postrender_review_targets(repo: Path, basis: dict[str, Any],
+                                       proof: dict[str, Any], sem_path: str,
+                                       vis_path: str) -> None:
+    """C postrender reviews must target the exact new manuscript/source/PDF
+    (same SHA at a different target path is still C; source-only/comment-only
+    changes do not carry old exact-target reviews)."""
+    trio = proof["output_trio_refs"]
+    for rel, kind in ((sem_path, "SEMANTIC_EDITORIAL"), (vis_path, "VISUAL")):
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, rel, f"C {kind} review"),
+                                   f"C {kind} review")
+        doc = _strict_json_from_bytes(data, f"C {kind} review")
+        if not isinstance(doc, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"C {kind} review must be an object")
+        man = doc.get("reader_manuscript", {})
+        src = doc.get("source", {})
+        pdf = doc.get("pdf", {})
+        if not isinstance(man, dict) or not isinstance(src, dict) or not isinstance(pdf, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"C {kind} review lacks manuscript/source/pdf refs")
+
+
+def _pdf_page_count(repo: Path, pdf_rel: str) -> int:
+    rel = _lexical_rel(repo, pdf_rel, "publication PDF")
+    data = _read_bytes_bounded(repo, rel, "publication PDF")
+    try:
+        import io
+        from pypdf import PdfReader
+        count = len(PdfReader(io.BytesIO(data)).pages)
+    except Exception as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"PDF page count unreadable: {exc}") from exc
+    if count < 1:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "PDF page count invalid")
+    return count
+
