+def _assemble_reused_proof(repo: Path, basis: dict[str, Any], basis_rel: str,
+                           entry: dict[str, Any], built: dict[str, Any],
+                           executor: str, ts: str) -> dict[str, Any]:
+    """U proof: exact immediate-predecessor targets, older embedded producer
+    history carried opaquely (HIST lineage, never current authority)."""
+    from scripts import survey_production_v2 as core
+    trio_paths = basis_proof_trio_placeholder(repo, basis)
+    trio_refs: dict[str, Any] = {}
+    for key in ("primary", "bibliography", "style"):
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, trio_paths[key]["path"],
+                                                      f"prior trio {key}"), f"prior trio {key}")
+        trio_refs[key] = {"path": trio_paths[key]["path"], "sha256": _sha_bytes(data),
+                          "byte_count": len(data)}
+    if trio_refs["primary"]["sha256"] != _sha_bytes(built["rendered"]["primary"]) \
+            or trio_refs["bibliography"]["sha256"] != _sha_bytes(built["rendered"]["bibliography"]) \
+            or trio_refs["style"]["sha256"] != _sha_bytes(built["rendered"]["style"]):
+        raise _fail("REUSE_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "current renderer/style does not yield exactly the old trio "
+                    "(no auto-switch to C on a claimed U root)")
+    prior_seal = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                               "prior seal"), "prior seal"), "prior seal")
+    roles = prior_seal.get("roles", {})
+    man_role = roles.get("reader-manuscript")
+    if not isinstance(man_role, dict):
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "prior seal lacks reader-manuscript role")
+    man_rel = _lexical_rel(repo, str(man_role["path"]), "prior manuscript")
+    man_data = _read_bytes_bounded(repo, man_rel, "prior manuscript")
+    old_manuscript_ref = {"path": man_rel, "sha256": _sha_bytes(man_data),
+                          "byte_count": len(man_data)}
+    build_unit: dict[str, Any] = {}
+    for role_name, build_key in (("publication-pdf", "pdf"),
+                                   ("build-log", "log"),
+                                   ("pdf-digest", "digest")):
+        fr = roles.get(role_name)
+        if not isinstance(fr, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"prior seal lacks build role: {role_name}")
+        brel = _lexical_rel(repo, str(fr["path"]), f"prior build {build_key}")
+        bdata = _read_bytes_bounded(repo, brel, f"prior build {build_key}")
+        ref: dict[str, Any] = {"path": brel, "sha256": _sha_bytes(bdata),
+                               "byte_count": len(bdata)}
+        if build_key == "pdf":
+            try:
+                import io
+                from pypdf import PdfReader
+                ref["page_count"] = len(PdfReader(io.BytesIO(bdata)).pages)
+            except Exception as exc:
+                raise _fail("REUSE_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                            f"prior PDF page count unreadable: {exc}") from exc
+            if ref["page_count"] < 1:
+                raise _fail("REUSE_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                            "prior PDF page count invalid")
+        build_unit[build_key] = ref
+    old_record = _locate_prior_build_record(repo, basis, prior_seal)
+    build_unit["record"] = old_record
+    proof: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_SOURCE_PROOF_V1",
+        "basis_ref": _file_ref(repo, basis_rel, "REUSED proof basis pin"),
+        "issue_id": basis["issue_id"], "research_profile": basis["research_profile"],
+        "publication_profile": basis["publication_profile"],
+        "generator_route": basis["generator_route"],
+        "reviewed_reader_ref": dict(basis["reviewed_reader_ref"]),
+        "authoring_refs": [dict(r) for r in basis["authoring_refs"]],
+        "accepted_refs": [dict(r) for r in basis["accepted_refs"]],
+        "supported_contract": dict(basis["current_tool_epoch"]["contract"]),
+        "supported_source_bindings": [dict(b) for b in basis["observed_source_bindings"]],
+        "dependency_closure": [dict(r) for r in basis["current_tool_epoch"]["closure"]],
+        "output_trio_refs": trio_refs,
+        "reader_digest": built["reader_digest"], "trio_digest": built["trio_digest"],
+        "comparison": {"reader_equal": True, "trio_equal": True,
+                       "disposition": "REUSED_TARGETS"},
+        "old_manuscript_ref": old_manuscript_ref, "old_build_unit_refs": build_unit,
+        "executor": executor, "recorded_at": ts,
+    }
+    proof["proof_sha256"] = core.sha256_object({k: v for k, v in proof.items()
+                                                if k != "proof_sha256"})
+    return proof
