+            "paths": {"source_root": rel, "survey_root": f"{rel}/survey", "work_branch": "test/release-decoder"},
+        }
+        core.write_json(profile_path, profile)
+        publication = source / "publication/v2"
+        publication.mkdir(parents=True)
+        verification = publication / "merge-verification-v2.json"
+        release_rec = publication / "release-record-v2.json"
+        core.write_json(verification, {"fixture": "merge-verification"})
+        core.write_json(release_rec, {"fixture": "release-record"})
+        # Pointer file (when given): real file with real SHA, same State path pattern.
+        if pointer_payload is not None:
+            ptr_path = source / "publication/v2/publication-surface-revalidation-r1.json"
+            sha = _write_json(ptr_path, pointer_payload)
+            if pointer_sha is not None:
+                sha = pointer_sha  # tampered SHA for malformed test
+            ptr_rel = str(ptr_path.relative_to(root))
+            pointer = {"path": ptr_rel, "sha256": sha}
+        else:
+            pointer = None
+        state_path = source / "production-state.json"
+        state = {
+            "schema_version": "2.0-rc1",
+            "issue_id": "SP-RELEASE-DECODER",
+            "research_profile": "THEMATIC",
+            "publication_profile": "LONGFORM_SPECIAL",
+            "lifecycle_state": "FROZEN",
+            "profile": {"path": str(profile_path.relative_to(root)), "sha256": core.sha256_file(profile_path)},
+            "contract": core.contract_identity(root, core.load_json(root / core.DEFAULT_CONFIG), "THEMATIC", "LONGFORM_SPECIAL"),
+            "implementation": {"repository_commit_sha": core.repository_commit_sha(root), "orchestrator_version": core.load_json(root / core.DEFAULT_CONFIG)["orchestrator_version"]},
+            "history": [],
+            "human_gates": {"architecture_review": "approved", "publication_preview": "approved"},
+            "human_gate_provenance": {},
+            "target_gate": "ARCHITECTURE_REVIEW",
+            "next_action": "stage:release",
+            "terminal_reason": None,
+            "exception_gate": {"status": "inactive", "reason": None},
+            "machine_checkpoints": {},
+            "checkpoint_provenance": {},
+            "legacy_compatibility": {"mode": "NON_AUTHORITATIVE_READ_ONLY", "legacy_state_present": False, "legacy_state_path": f"{rel}/pipeline-state.json", "legacy_state_sha256": None},
+            "publication_revalidation_provenance": pointer,
+        }
+        core.write_json(state_path, state)
+        return source, profile, state_path, verification, release_rec
+
+    def _release_mocks(self, source, profile, verification, release_rec):
+        # Same mocks as existing release tests for unrelated parts (profile/source,
+        # release-record validation), BUT pointer decoding uses real files (not mocked).
+        # Top verify_agent_state_basis mocked for speed in positives (production top
+        # still does full LIVE validation; proven by code, not by mocked test).
+        release_payload = {
+            "issue_id": "SP-RELEASE-DECODER",
+            "merge_verification_path": str(verification.relative_to(Path('.').resolve())),
+            "merge_verification_sha256": core.sha256_file(verification),
