+def _file_identity(repo: Path, rel: str, label: str) -> tuple[int, int]:
+    _lexical_rel(repo, rel, label)
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    target = repo.resolve().joinpath(*rel.split("/"))
+    try:
+        st = os.stat(target)
+    except FileNotFoundError as exc:
+        raise _fail("HIGH_MISSING", "ALIAS", "REFUSED_PRE_WRITE",
+                    f"{label} missing for identity: {rel}: {exc}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "ALIAS", "REFUSED_PRE_WRITE",
+                    f"{label} identity unreadable: {rel}: {exc}") from exc
+    return (st.st_dev, st.st_ino)
