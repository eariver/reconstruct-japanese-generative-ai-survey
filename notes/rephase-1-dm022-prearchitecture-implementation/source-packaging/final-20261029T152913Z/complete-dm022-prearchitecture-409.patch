+        "work_ref": {"repository_commit_sha": manifest["work"]["expected_head"], "tree_sha": manifest["work"]["expected_tree"], "contract": manifest["tool_pins"]["contract"]},
+        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
+        "executor": "HIGH adopt_revision",
+    }
+    report_noself = dict(report_body)
+    report_body["preadoption_report_sha256"] = core.sha256_object(report_noself)
+    schema_gate.validate_instance(report_body, repo_root / "schemas/dm022-preadoption-report-v2.schema.json", label="pre-adoption report")
+    _exclusive_write_bytes(rev_abs / "proof" / "supersession-report.json", core.json_bytes(report_body), "R report")
+    # Lineage: preserve original_anchor on repeat (previous PREARCH), else anchor
+    # to before evidence. Parent is previous record; supersedes appends previous.
+    before_ev = manifest["before_checkpoint"]["evidence"]
+    prev_abs_lineage = core.repo_local_path(repo_root, before_ev["path"], "previous checkpoint")
+    prev_typed_lineage = low.load_typed_checkpoint_record(repo_root, prev_abs_lineage)
+    prev_rec_lineage = prev_typed_lineage["record"]
+    if prev_typed_lineage["family"] == "PREARCH":
+        parent_ref = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
+        original_anchor = prev_rec_lineage.get("original_anchor")
+        prev_sup = prev_rec_lineage.get("supersedes", []) or []
+        supersedes = list(prev_sup) + [{"path": before_ev["path"], "sha256": before_ev["sha256"], "revision_id": prev_rec_lineage.get("revision_id")}]
+    else:
+        parent_ref = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
+        original_anchor = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
+        supersedes = []
+    checkpoint_body = {
+        "schema_version": DM022_SCHEMA_VERSION, "kind": low.DM022_KIND,
+        "reason": low.DM022_REASON, "issue_id": manifest["issue_id"],
+        "operation": {"from_state": "EVIDENCE_REVIEWED", "to_state": "EVIDENCE_REVIEWED"},
+        "producer_boundary": {"from_state": "CANDIDATES_NORMALIZED", "to_state": "EVIDENCE_REVIEWED"},
+        "checkpoints": ["evidence", "materiality", "completeness"],
+        "artifacts": [
+            {"name": "evidence-acceptance", "path": manifest["candidate_outputs"]["evidence_acceptance"]["path"], "sha256": manifest["candidate_outputs"]["evidence_acceptance"]["sha256"]},
+            {"name": "edition-views-acceptance", "path": manifest["candidate_outputs"]["views_acceptance"]["path"], "sha256": manifest["candidate_outputs"]["views_acceptance"]["sha256"]},
+            {"name": "materiality-ledger", "path": manifest["candidate_outputs"]["ledger"]["path"], "sha256": manifest["candidate_outputs"]["ledger"]["sha256"]},
+            {"name": "profile-completeness", "path": manifest["candidate_outputs"]["completeness"]["path"], "sha256": manifest["candidate_outputs"]["completeness"]["sha256"]},
+        ],
+        "before_state": manifest["before_state"], "before_checkpoint": manifest["before_checkpoint"],
+        "parent_checkpoint": parent_ref,
+        "original_anchor": original_anchor,
+        "supersedes": supersedes, "revision_id": manifest["revision_id"], "revision_root": rev_rel,
+        "request": manifest["request"],
+        "retention_plan": {"path": f"{rev_rel}/retention/inventory.json", "sha256": hashlib.sha256(retention_raw).hexdigest(), "byte_count": len(retention_raw)},
+        "proof": report_body["proof"], "decision": report_body["decision"],
+        "report": {"path": f"{rev_rel}/proof/supersession-report.json", "sha256": hashlib.sha256(core.json_bytes(report_body)).hexdigest(), "byte_count": len(core.json_bytes(report_body))},
+        "contract": manifest["tool_pins"]["contract"],
+        "implementation": {"repository_commit_sha": manifest["work"]["expected_head"], "orchestrator_version": manifest["tool_pins"]["orchestrator_version"]},
+        "profile": {"path": manifest["profile_ref"]["path"], "sha256": manifest["profile_ref"]["sha256"]},
+        "executor": "HIGH adopt_revision",
+        "recorded_at": report_body["recorded_at"],
+        "reviews": [{"check_id": low.DM022_PROOF_CHECK_ID, "kind": "DETERMINISTIC", "status": "PASS", "executor": "HIGH adopt_revision", "evidence": f"{rev_rel}/proof/proposed-graph-proof.json", "result": report_body["proof"]}],
