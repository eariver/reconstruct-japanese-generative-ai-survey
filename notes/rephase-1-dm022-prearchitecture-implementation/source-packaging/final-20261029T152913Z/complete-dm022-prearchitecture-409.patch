+
+def _run_child(fixture: Path, dst_root: Path, code: str, timeout: int = 180):
+    # Fresh independent code epoch: cwd=DST so DST fixed code loads, fixture is data-only (absolute paths).
+    # No namespace alias mix: PYTHONPATH=DST only, never fixture in sys.path.
+    env = _base_env(fixture, dst_root)
+    import time as _t
+    t0 = _t.monotonic()
+    p = subprocess.run([sys.executable, "-B", "-c", code], cwd=str(dst_root), capture_output=True, text=True, timeout=timeout, env=env)
+    return {"exit": p.returncode, "stdout": p.stdout, "stderr": p.stderr, "dt": _t.monotonic() - t0, "env": env}
+
+
+def _run_cli(fixture: Path, dst_root: Path, argv: list[str], timeout: int = 120):
+    # Actual public CLI with DST fixed code: cwd=DST, --repo-root=fixture absolute (no SourceStub).
+    # Uses entry direct python -m actual supported style, root config default only flags.
+    env = _base_env(fixture, dst_root)
+    import time as _t
+    t0 = _t.monotonic()
+    p = subprocess.run([sys.executable, "-B", "-m", "scripts.survey_agent_control_v2"] + argv, cwd=str(dst_root), capture_output=True, text=True, timeout=timeout, env=env)
+    return {"exit": p.returncode, "stdout": p.stdout, "stderr": p.stderr, "dt": _t.monotonic() - t0}
