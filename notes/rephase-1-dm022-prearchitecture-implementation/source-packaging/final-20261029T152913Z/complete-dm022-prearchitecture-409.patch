+                f"from scripts import survey_publication_set_v2 as L; "
+                f"anchor=L.derive_canonical_anchor(repo,cfg,st,[dict(record=r,path=ref['path'],sha256=ref['sha256']) for r,ref in [(c['record'] if 'record' in c else c, dict(path=c['path'],sha256=c['sha256'])) for c in chain]] if False else [dict(record=rec,path=ref['path'],sha256=ref['sha256']) for rec,ref in [(x[0],x[1]) for x in [(y['record'] if 'record' in y else y, dict(path=y['path'],sha256=y['sha256'])) for y in chain]]]); "
+                f"print('anchor='+str(anchor.get('kind'))); "
+                f"allowed=(len(chain)+1<=32); print('allowed='+str(allowed)); "
+                f"import sys; sys.exit(0 if allowed=={str(expect_allow)} else 11)"
+            )
