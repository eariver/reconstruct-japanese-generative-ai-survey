+"""DM022 C2 release publication-pointer decoder (targeted, no full lifecycle).
+
+Strict REVALIDATION_SCHEMA separation (NEVER Stage/LOW). Healthy editorial +
+renewal pointers (real files, real SHA, same public full State path) must pass
+explicit PREARCH check + mocked full resolve (for speed; production top still
+does full LIVE validation via verify_agent_state_basis). Malformed (bad SHA,
+missing, not JSON, bad ref) + pinned PREARCH (real PREARCH file, correct SHA)
+must refuse with WRONG_FAMILY, not just dummy minimal-dict direct flag.
+
+Scope: targeted decoder ONLY. Full FROZEN→RELEASED both routes with real
+lifecycle (TinyTeX, prior binding, establishment, immutable rows) will be
+regenerated by fresh actual witnesses AFTER this fix (changed Source Proof).
+No hotpatch of old Frozen fixture, no ignore of current tool pin. No genuine
+PASS here.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from scripts import survey_agent_control_v2 as agent
+from scripts import survey_production_v2 as core
+from scripts import survey_release_checkpoint_v2 as release_mod
+
+
+def _write_json(path: Path, payload: dict) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+class TestC2ReleaseDecoder(unittest.TestCase):
+    def _fixture(self, pointer_payload: dict | None, pointer_sha: str | None = None):
+        # Same public full State path pattern as existing release tests:
+        # temp dir under exec repo root, real State file via public path,
+        # real pointer file (when given) with real SHA binding.
+        root = Path(".").resolve()
+        tmp = tempfile.TemporaryDirectory(dir=root)
+        self.addCleanup(tmp.cleanup)
+        source = Path(tmp.name)
+        rel = str(source.relative_to(root))
+        profile_path = source / "production-profile.json"
+        profile = {
+            "schema_version": "2.0-rc1",
+            "issue_id": "SP-RELEASE-DECODER",
+            "research_profile": "THEMATIC",
+            "publication_profile": "LONGFORM_SPECIAL",
