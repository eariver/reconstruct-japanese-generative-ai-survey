+        view = memoryview(data)
+        while view:
+            try:
+                n = os.write(fd, view)
+            except OSError as exc:
+                raise AcceptanceError(f"{label} short-write failed, partial temp preserved at {tmp}: {exc}") from exc
+            if n <= 0:
+                raise AcceptanceError(f"{label} short-write returned {n}, partial temp preserved at {tmp}")
+            view = view[n:]
+        try:
+            os.fsync(fd)
+        except OSError as exc:
+            raise AcceptanceError(f"{label} fsync failed, partial temp preserved at {tmp}: {exc}") from exc
