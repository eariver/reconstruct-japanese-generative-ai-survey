+        hist = _load("survey_versioned_renewal_history_v2")
+        with tempfile.TemporaryDirectory(prefix="dm022-c1-leg-") as td:
+            tmp = Path(td)
+            p = tmp / "legacy.json"
+            # Real typed old format: actual LEGACY_REASON value, no kind key,
+            # no manually faked kind strings. Uses actual constant (not literal
+            # "LEGACY_REASON") + real legacy shape (reason_class only, no kind).
+            p.write_text(json.dumps({"reason_class": hist.LEGACY_REASON}, sort_keys=True), encoding="utf-8")
+            rec = json.loads(p.read_text(encoding="utf-8"))
+            self.assertEqual(hist._record_kind(rec), "LEGACY")
+
+    def test_low_typed_loader_on_real_file(self):
+        low = _load("survey_research_authority_v2")
+        root = _repo_root()
