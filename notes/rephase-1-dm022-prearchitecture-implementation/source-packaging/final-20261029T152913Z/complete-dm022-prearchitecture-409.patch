+def _resolve_reused_terminal_record(repo: Path, basis: dict[str, Any]) -> dict[str, str]:
+    """Terminal activation record for a REUSED_BUILD wrapper (HIST chain anchor).
+
+    The R build record's original_record_ref must be a chain ACTIVATION record
+    (not a build-record.json): EDITORIAL terminal for first-U, or the VERSIONED
+    record whose build is EXECUTED terminal for repeats (older reachable
+    ancestor, skipping intermediate REUSED records, e.g. U3 -> R1). Bounded 32
+    hops, same issue, no cycles. This is the writer-side terminal resolution;
+    H walks from it to the terminal build at verify time.
+    """
+    issue = basis.get("issue_id")
+    rec_ref = basis.get("prior_record_ref")
+    if not isinstance(rec_ref, dict):
+        raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                    "prior record ref missing for terminal resolution")
+    current = {"path": str(rec_ref.get("path", "")), "sha256": str(rec_ref.get("sha256", ""))}
+    seen: set[str] = set()
+    for _ in range(CHAIN_LIMIT):
+        if current["path"] in seen:
+            raise _fail("HISTORY_ANCESTOR", "BUILD", "REFUSED_PRE_WRITE",
+                        "terminal resolution cycle (no REUSED loops)")
+        seen.add(current["path"])
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, current["path"],
+                                                      "terminal candidate record"),
+                                   "terminal candidate record")
+        if _sha_bytes(data) != current["sha256"]:
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        "terminal candidate record bytes changed")
+        doc = _strict_json_from_bytes(data, "terminal candidate record")
+        if not isinstance(doc, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        "terminal candidate record must be an object")
+        if doc.get("issue_id") != issue:
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        "terminal candidate record issue mismatch (foreign lineage)")
+        kind = doc.get("kind")
+        if kind == "EDITORIAL_PUBLICATION_ACTIVATION_V1":
+            return dict(current)
+        if kind != "VERSIONED_RENEWAL_ACTIVATION_V1":
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        f"terminal candidate record kind unsupported: {kind}")
+        set_ref = doc.get("set_ref", {})
+        seal_data = _read_bytes_bounded(repo, _lexical_rel(repo, str(set_ref.get("path", "")),
+                                                           "terminal candidate seal"),
+                                        "terminal candidate seal")
+        seal = _strict_json_from_bytes(seal_data, "terminal candidate seal")
+        build_ref = (seal.get("build_record_ref") or {}) if isinstance(seal, dict) else {}
+        build_data = _read_bytes_bounded(repo, _lexical_rel(repo, str(build_ref.get("path", "")),
+                                                           "terminal candidate build"),
+                                         "terminal candidate build")
+        build = _strict_json_from_bytes(build_data, "terminal candidate build")
+        if not isinstance(build, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        "terminal candidate build must be an object")
+        variant = build.get("variant")
+        if variant == "EXECUTED_BUILD":
+            return dict(current)
+        if variant != "REUSED_BUILD":
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        f"terminal candidate build variant unsupported: {variant}")
+        nxt = build.get("original_record_ref", {})
+        if not isinstance(nxt, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                        "intermediate REUSED record lacks onward terminal ref")
+        current = {"path": str(nxt.get("path", "")), "sha256": str(nxt.get("sha256", ""))}
+    raise _fail("HISTORY_ANCESTOR", "BUILD", "REFUSED_PRE_WRITE",
+                "terminal resolution exceeds chain bound 32")
+
+
+def _locate_prior_build_record(repo: Path, basis: dict[str, Any],
+                               prior_seal: dict[str, Any]) -> dict[str, str]:
+    """Immediate prior build record (prior-relative, never original-P fallback).
+
+    For an editorial predecessor it is P/publication/build-record.json located
+    via the prior receipt's build binding; for a renewal predecessor it is the
+    prior R/build-record.json located via the prior proof's build binding. The
+    REUSED chain is walked historically to the terminal EXECUTED/EDITORIAL
+    build only in Layer-B readback; here the immediate record is pinned.
+    """
+    prior_selected = basis["prior_selected_ref"]["path"]
+    roles = prior_seal.get("roles", {})
+    receipt_role = roles.get("source-receipt", {})
+    receipt = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, str(receipt_role.get("path", "")),
+                                               "prior receipt"), "prior receipt"),
+        "prior receipt") if isinstance(receipt_role, dict) else {}
+    candidates: list[str] = []
+    if isinstance(receipt, dict):
+        for key in ("build_record_ref", "build_record"):
+            ref = receipt.get(key)
+            if isinstance(ref, dict) and isinstance(ref.get("path"), str):
+                candidates.append(str(ref["path"]))
+    seal_dir = str(Path(prior_selected).parent.as_posix())
+    candidates.append(f"{seal_dir}/build-record.json")
+    for cand in candidates:
+        try:
+            rel = _lexical_rel(repo, cand, "prior build record")
+            data = _read_bytes_bounded(repo, rel, "prior build record")
+        except RenewalHighError:
+            continue
+        return {"path": rel, "sha256": _sha_bytes(data)}
+    raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                "immediate prior build record not found (no original-P fallback)")
+
