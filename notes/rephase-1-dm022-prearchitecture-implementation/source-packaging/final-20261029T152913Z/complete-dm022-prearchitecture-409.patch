+def _validate_prearchitecture_record_content(
+    record: dict[str, Any], checkpoint: str
+) -> list[str]:
+    """Strict PREARCH branch predicates for one expected research checkpoint.
+
+    Caller supplies expected checkpoint in {evidence, materiality,
+    completeness}; parsing valid never authorizes validation/freeze/release
+    or selection. Enforces kind/reason/operation/producer_boundary, exact
+    3-checkpoint set, 4 NamedRef artifacts with same-record triplet, lineage
+    (parent_checkpoint/original_anchor/supersedes), SELF digest and sole
+    DM022_SUPERSESSION_PROOF deterministic review. History/lifecycle fields
+    remain forward-truthful; forward schema is unchanged.
+    """
+    errors: list[str] = []
+    if checkpoint not in DM022_PREARCH_CHECKPOINTS:
+        return [f"DM022_WRONG_FAMILY for {checkpoint}: PREARCH refused outside upstream research roles"]
+    if not _is_prearchitecture_record(record):
+        return [f"DM022_WRONG_FAMILY for {checkpoint}: not a PREARCH record"]
+    # Strict schema exact objects (no from/to or list aliases).
+    if record.get("operation") != {"from_state": "EVIDENCE_REVIEWED", "to_state": "EVIDENCE_REVIEWED"}:
+        errors.append("PREARCH operation must be exactly {from_state:EVIDENCE_REVIEWED,to_state:EVIDENCE_REVIEWED}")
+    if record.get("producer_boundary") != {"from_state": "CANDIDATES_NORMALIZED", "to_state": "EVIDENCE_REVIEWED"}:
+        errors.append("PREARCH producer_boundary must be exactly {from_state:CANDIDATES_NORMALIZED,to_state:EVIDENCE_REVIEWED}")
+    checkpoints = record.get("checkpoints")
+    if not isinstance(checkpoints, list) or sorted(checkpoints) != sorted(DM022_PREARCH_CHECKPOINTS):
+        errors.append("PREARCH checkpoints must be exactly [evidence, materiality, completeness]")
+    artifacts = record.get("artifacts")
+    if not isinstance(artifacts, list):
+        errors.append("PREARCH artifacts must be an array of 4 NamedRefs")
+    else:
+        names = [row.get("name") for row in artifacts if isinstance(row, dict)]
+        if sorted(names) != sorted(DM022_PREARCH_ARTIFACT_NAMES):
+            errors.append("PREARCH artifacts must be exactly the 4 research NamedRefs")
+        for row in artifacts:
+            if not isinstance(row, dict) or set(row) != {"name", "path", "sha256"}:
+                errors.append(f"PREARCH artifact shape invalid: {row!r}" if isinstance(row, dict) else "PREARCH artifact row invalid")
+                continue
+            if not isinstance(row.get("path"), str) or not row.get("path").strip():
+                errors.append(f"PREARCH artifact path invalid: {row.get('name')}")
+            sha = row.get("sha256")
+            if not isinstance(sha, str) or len(sha) != 64 or any(c not in "0123456789abcdef" for c in sha):
+                errors.append(f"PREARCH artifact sha invalid: {row.get('name')}")
+    # Same-record triplet is enforced by the caller comparing the three State
+    # provenance refs; here require lineage fields exist.
+    for key in ("parent_checkpoint", "original_anchor", "supersedes"):
+        if key not in record:
+            errors.append(f"PREARCH lineage missing: {key}")
+    # Selected schema: reviews[].result is SizedRef {path,sha256,byte_count}
+    # (not 2-key ArtifactRef). Strict exact keys, no foreign keys; byte_count
+    # is int >= 1 (bool excluded). File rehash/size is enforced path-side in
+    # _validate_core_stage_report and via the A3 4-path checker before any
+    # authority consumer; this pure branch enforces shape only.
+    reviews = record.get("reviews")
+    if not isinstance(reviews, list) or len(reviews) != 1:
+        errors.append("PREARCH requires exactly one DM022_SUPERSESSION_PROOF review")
+    else:
+        review = reviews[0]
+        if not isinstance(review, dict) or review.get("check_id") != DM022_PREARCH_PROOF_CHECK_ID:
+            errors.append("PREARCH review must be DM022_SUPERSESSION_PROOF")
+        elif review.get("kind") != "DETERMINISTIC" or review.get("status") != "PASS":
+            errors.append("DM022_SUPERSESSION_PROOF must be a deterministic PASS review")
+        else:
+            result = review.get("result")
+            if not isinstance(result, dict) or set(result) != {"path", "sha256", "byte_count"}:
+                errors.append("DM022_SUPERSESSION_PROOF result must be SizedRef {path,sha256,byte_count}")
+            else:
+                if not isinstance(result.get("path"), str) or not result["path"].strip():
+                    errors.append("DM022_SUPERSESSION_PROOF result path invalid")
+                sha = result.get("sha256")
+                if not isinstance(sha, str) or len(sha) != 64 or any(c not in "0123456789abcdef" for c in sha):
+                    errors.append("DM022_SUPERSESSION_PROOF result sha invalid")
+                bc = result.get("byte_count")
+                if not isinstance(bc, int) or isinstance(bc, bool) or bc < 1:
+                    errors.append("DM022_SUPERSESSION_PROOF result byte_count must be int >= 1")
+    # New CP bindings: SIZED vs ArtifactRef per selected schema (exact keys,
+    # no inferred names, no generic subset).
+    for _sized_key in ("before_state", "request", "retention_plan", "proof", "decision", "report"):
+        _ref = record.get(_sized_key)
+        if not isinstance(_ref, dict) or set(_ref) != {"path", "sha256", "byte_count"}:
+            errors.append(f"PREARCH {_sized_key} must be SizedRef {{path,sha256,byte_count}}")
+            continue
+        _bc = _ref.get("byte_count")
+        if not isinstance(_bc, int) or isinstance(_bc, bool) or _bc < 1:
+            errors.append(f"PREARCH {_sized_key} byte_count must be int >= 1")
+    _before_cp = record.get("before_checkpoint")
+    if not isinstance(_before_cp, dict) or set(_before_cp) != {"evidence", "materiality", "completeness"}:
+        errors.append("PREARCH before_checkpoint must be {evidence,materiality,completeness} ArtifactRefs")
+    else:
+        for _k in ("evidence", "materiality", "completeness"):
+            _r = _before_cp.get(_k)
+            if not isinstance(_r, dict) or set(_r) != {"path", "sha256"}:
+                errors.append(f"PREARCH before_checkpoint.{_k} must be ArtifactRef {{path,sha256}}")
+    for _art_key in ("parent_checkpoint", "original_anchor", "profile"):
+        _r = record.get(_art_key)
+        if not isinstance(_r, dict) or set(_r) != {"path", "sha256"}:
+            errors.append(f"PREARCH {_art_key} must be ArtifactRef {{path,sha256}}")
+    # Forward lifecycle/history/gates are never rewritten by this record; the
+    # record must not claim from/to forward transition fields.
+    for forbidden in ("from_state", "to_state"):
+        if forbidden in record:
+            errors.append(f"PREARCH record must not carry forward field: {forbidden}")
+    return errors
+
