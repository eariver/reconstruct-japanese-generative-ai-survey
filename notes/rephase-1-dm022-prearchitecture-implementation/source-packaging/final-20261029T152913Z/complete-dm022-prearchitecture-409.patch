+def _editorial_closure_rows(repo: Path, generator_route: str, family: str | None = None) -> list[dict[str, str]]:
+    # Family-aware exact union: G71 63 (35py+22schemas+3route+1staged+1style+1recipe),
+    # G76 70 (63+2 DM022 modules+5 DM022 schemas) per-route (73 union).
+    # R4/R5 finite families G67/G71/G76; editorial supports G71/G76 only.
+    # No filesystem discovery, no +unknown, no len-in-(63,70) blanket.
+    # Compares full member names, duplicates, modes, SHAs, expected count family.
+    if generator_route not in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
+        raise _fail("CLOSURE_ROUTE", "PREPARE", "REFUSED_PRE_WRITE", f"unknown generator_route: {generator_route!r}")
+    if family is None:
+        family = _derive_current_editorial_family(repo)
+    if family not in ("G71", "G76"):
+        raise _fail("UNSUPPORTED_GENERATION", "PREPARE", "REFUSED_PRE_WRITE", f"editorial closure family must be G71/G76, got {family!r}")
+    try:
+        from scripts import survey_editorial_staged_source_v2 as _staged_mod
+    except ImportError as exc:
+        raise _fail("CLOSURE_STAGED_MISSING", "PREPARE", "REFUSED_PRE_WRITE", f"P3S staged module missing for editorial closure: {exc}") from exc
+    try:
+        expected_names_tuple = _staged_mod._route_code_deps(generator_route, family)
+    except Exception as exc:
+        raise _fail("CLOSURE_ROUTE_DEPS", "PREPARE", "REFUSED_PRE_WRITE", f"P3S route code deps failed: {exc}") from exc
+    # Full member check: no duplicates in expected literal (would shrink set).
+    if len(expected_names_tuple) != len(set(expected_names_tuple)):
+        raise _fail("CLOSURE_DUP", "PREPARE", "REFUSED_PRE_WRITE", "expected closure literal has duplicates (no silent omit)")
+    _want = 63 if family == "G71" else 70
+    if len(expected_names_tuple) != _want:
+        raise _fail("CLOSURE_SHAPE", "PREPARE", "REFUSED_PRE_WRITE", f"expected closure literal size != {_want} for {family}: got {len(expected_names_tuple)}")
+    names = list(expected_names_tuple)
+    # Sorted-unique, no overlap silently omitted (duplicates would shrink len and fail).
+    rows = []
+    seen: set[str] = set()
+    for name in sorted(set(names)):
+        if name in seen:
+            raise _fail("CLOSURE_DUP", "PREPARE", "REFUSED_PRE_WRITE", f"closure duplicate: {name}")
+        seen.add(name)
+        # Raw-first containment + bounded read (no symlink laundering, no FIFO).
+        resolved = _safe(repo, name, f"closure {name}")
+        # Mode check: regular file, no exec bits (100644 family, not 755).
+        try:
+            lst = os.lstat(resolved)
+        except OSError as exc:
+            raise _fail("CLOSURE_MODE", "PREPARE", "REFUSED_PRE_WRITE", f"closure lstat failed: {name}: {exc}") from exc
+        if not stat.S_ISREG(lst.st_mode):
+            raise _fail("CLOSURE_MODE", "PREPARE", "REFUSED_PRE_WRITE", f"closure not regular file: {name}")
+        if lst.st_mode & 0o111:
+            raise _fail("CLOSURE_MODE", "PREPARE", "REFUSED_PRE_WRITE", f"closure executable bit refused: {name}")
+        try:
+            data = _read_bytes_bounded(repo, name, f"closure {name}")
+        except EditorialError:
+            raise
+        rows.append({"name": name, "path": name, "sha256": core.sha256_bytes(data)})
+    # Exact count family-specific (not blanket len in (63,70)).
+    if len(rows) != _want:
+        raise _fail("CLOSURE_SHAPE", "PREPARE", "REFUSED_PRE_WRITE", f"editorial closure expected {_want} for {family}, got {len(rows)}")
+    # No duplicate names/paths (already sorted-unique, but verify paths equal names).
+    for row in rows:
+        if row["path"] != row["name"]:
+            raise _fail("CLOSURE_PATH", "PREPARE", "REFUSED_PRE_WRITE", f"closure path must equal name: {row!r}")
+    return rows
+
