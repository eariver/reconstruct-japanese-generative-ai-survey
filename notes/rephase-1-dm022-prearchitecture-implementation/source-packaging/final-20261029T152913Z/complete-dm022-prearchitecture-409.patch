+def _validate_prearchitecture_core_proof(
+    repo_root: Path,
+    checkpoint_path: Path,
+    record: dict[str, Any],
+) -> list[str]:
+    """Validate the bound proof/report/digest chain via LOW detached proof.
+
+    Selected LOW signature is
+    `check_supersession_record_from_paths(repo_root, checkpoint_path,
+    report_path, before_copy_path) -> list[str]`. Paths are derived from the
+    actual pinned checkpoint record and its revision retention mapping; no
+    caller proof dict is trusted. The record is crossbound before use
+    (same-record shape already checked by the caller; report/before refs must
+    exist with exact shapes here). No State validation, no guard read, no
+    recursion.
+    """
+    # Crossbind the pinned record before deriving paths: report + revision
+    # refs must exist with exact shapes; malformed records refuse here.
+    report_ref = record.get("report")
+    if not isinstance(report_ref, dict) or set(report_ref) != {"path", "sha256", "byte_count"}:
+        return ["PREARCH report ref shape invalid: expected SizedRef {path,sha256,byte_count}"]
+    revision_root = record.get("revision_root")
+    if not isinstance(revision_root, str) or not revision_root.strip() or ".." in revision_root:
+        return ["PREARCH revision_root invalid"]
+    report_path = repo_root / str(report_ref["path"])
+    before_copy_path = repo_root / str(revision_root).rstrip("/") / "retention" / "state-before.json"
+    result = low.check_supersession_record_from_paths(
+        repo_root, Path(checkpoint_path), Path(report_path), Path(before_copy_path)
+    )
+    if isinstance(result, list):
+        return [str(item) for item in result]
+    return ["PREARCH detached proof returned non-list"]
