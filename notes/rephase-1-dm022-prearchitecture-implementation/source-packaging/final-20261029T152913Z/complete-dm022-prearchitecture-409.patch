+            cur = _safe_read_bytes(slot_abs, f"retained slot {row['slot']}")
+            if hashlib.sha256(cur).hexdigest() != row.get("copy_sha256") and hashlib.sha256(cur).hexdigest() != row.get("source_sha256"):
+                raise AcceptanceError(f"retention drift for slot {row['slot']}")
+    # Re-verify the no-prior-Human-review entry window at adopt time (a review
+    # recorded between prepare and adopt refuses adoption before any
+    # guard/checkpoint/State mutation or R proof/report writes).
+    _prove_before_graph_unbound(repo_root, cfg, state, source_root, state.get("issue_id", ""))
+    dec_raw = _safe_read_bytes(dec_abs, "supplied decision")
+    try:
+        decision = schema_gate.parse_json_strict_bytes(dec_raw, "supplied decision")
+    except Exception as exc:
+        raise AcceptanceError(f"decision strict parse failed: {exc}") from exc
+    if decision.get("revision_id") != manifest.get("revision_id"):
