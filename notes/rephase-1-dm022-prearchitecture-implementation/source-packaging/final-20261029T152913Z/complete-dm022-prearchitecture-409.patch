+def _validate_build_record_container(repo: Path, rel: str, label: str) -> dict[str, Any]:
+    """Validate an R/build-record.json against the embedded #/$defs/buildRecord
+    container (fixed 4 schemas kept: the container lives in the renewal source
+    manifest schema file, never a 5th schema). The host file is loaded through
+    the pinned strict schema loader; inner #/$defs refs resolve against the
+    inlined host defs (same bytes, no remote fetch, no new file)."""
+    from scripts import survey_schema_v2 as schema_gate
+    import jsonschema
+    try:
+        host_schema_bytes = _read_bytes_bounded(repo, RENEWAL_RECEIPT_SCHEMA, "build container host schema")
+        host = schema_gate.load_schema(repo / RENEWAL_RECEIPT_SCHEMA)
+        if _sha_bytes(_read_bytes_bounded(repo, RENEWAL_RECEIPT_SCHEMA, "build container host recheck")) != _sha_bytes(host_schema_bytes):
+            raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                        "build container host schema moved during load")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    f"build container host schema unreadable: {exc}") from exc
+    if not isinstance(host.get("$defs"), dict) or "buildRecord" not in host["$defs"]:
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    "build container host lacks #/$defs/buildRecord")
+    wrapper = {"$schema": host.get("$schema",
+                                  "https://json-schema.org/draft/2020-12/schema"),
+               "$defs": host["$defs"], "$ref": "#/$defs/buildRecord"}
+    try:
+        jsonschema.Draft202012Validator.check_schema(wrapper)
+    except jsonschema.exceptions.SchemaError as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    f"build container wrapper invalid: {exc.message}") from exc
+    raw = _read_bytes_bounded(repo, _lexical_rel(repo, rel, label), label)
+    doc = _strict_json_from_bytes(raw, label)
+    if not isinstance(doc, dict):
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    f"{label} must be an object")
+    validator = jsonschema.Draft202012Validator(wrapper,
+                                                 format_checker=jsonschema.FormatChecker())
+    errors = sorted(validator.iter_errors(doc),
+                    key=lambda err: (list(err.absolute_path), err.message))
+    if errors:
+        first = errors[0]
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    f"{label} fails #/$defs/buildRecord: {first.message}") from None
+    return doc
+
+
+def _file_ref(repo: Path, rel: str, label: str) -> dict[str, str]:
+    """Live file ref {path, sha256} with FILE bytes SHA.
+
+    Convention (binding, selected contract §11.2): EVERY cross-document
+    `{path,sha256}` ref carries the FILE bytes SHA — including
+    `proof.basis_ref` (ROOT binding, no SELF exception, no dual field, no
+    either-tolerance). Object self-digests (basis_sha256/proof_sha256/...)
+    are always recomputed from reparsed bytes, never equated to file SHAs.
+    """
+    rrel = _lexical_rel(repo, rel, label)
+    return {"path": rrel, "sha256": _sha_bytes(_read_bytes_bounded(repo, rrel, label))}
+
+
+def _write_reused_build_record(repo: Path, basis: dict[str, Any], basis_rel: str,
+                               entry: dict[str, Any], proof: dict[str, Any],
+                               proof_rel: str, executor: str, ts: str) -> str:
+    """U-only REUSED_BUILD wrapper: no rebuild, original unit pinned, no new
+    TeX build invented. Receipt binds this record, never precedes it."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    old_build = proof["old_build_unit_refs"]
+    # Terminal activation record anchor (HIST chain): EDITORIAL terminal for
+    # first-U, EXECUTED-terminal VERSIONED record for repeats (older reachable
+    # ancestor, skipping intermediate REUSED records). This is the R build
+    # record's original_record_ref; the proof's old_build_unit_refs.record
+    # remains the immediate prior build-record.json (S checks its bytes).
+    terminal_ref = _resolve_reused_terminal_record(repo, basis)
+    record_data = _read_bytes_bounded(repo, _lexical_rel(repo, terminal_ref["path"],
+                                                         "terminal build record"),
+                                      "terminal build record")
+    if _sha_bytes(record_data) != terminal_ref["sha256"]:
+        raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                    "terminal record bytes changed")
+    old_epoch = _derive_old_tool_epoch(repo, basis)
+    record: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_BUILD_V1",
+        "variant": "REUSED_BUILD", "issue_id": basis["issue_id"],
+        "proposal_ref": dict(basis["original_proposal_ref"]),
+        "renewal_basis_ref": _file_ref(repo, basis_rel, "REUSED renewal basis"),
+        "renewal_proof_ref": _file_ref(repo, proof_rel, "REUSED renewal proof"),
+        "recipe_ref": {"path": ".latexmkrc",
+                       "sha256": _sha_bytes(_read_bytes_bounded(repo, ".latexmkrc",
+                                                                "build recipe"))},
+        "recorded_at": ts,
+        "original_record_ref": dict(terminal_ref),
+        "original_pdf_ref": dict(old_build["pdf"]),
+        "original_log_ref": {k: old_build["log"][k] for k in ("path", "sha256", "byte_count")},
+        "original_digest_ref": {k: old_build["digest"][k]
+                                for k in ("path", "sha256", "byte_count")},
+        "renewal_tools": {"old": old_epoch, "new": basis["current_tool_epoch"]["repository_commit_sha"]},
+        "no_rebuild": True,
+    }
+    record["build_sha256"] = core.sha256_object({k: v for k, v in record.items()
+                                                 if k != "build_sha256"})
+    rel = _proof_paths_for_request(basis)["build_record"]
+    _write_json_bound(repo, rel, record, "build_sha256", "renewal build record",
+                      "BUILD", "RENEWAL_PROOF_DIGEST")
+    _validate_build_record_container(repo, rel, "Renewal Build Record")
+    return rel
+
