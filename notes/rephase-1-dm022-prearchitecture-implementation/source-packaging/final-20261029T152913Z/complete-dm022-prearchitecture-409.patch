+def _refuse_if_intent_exists(repo: Path, record_base: dict[str, Any], exclude_rel: str) -> None:
+    # Detect exact existing operation intent (before-State/predecessor/set) and
+    # refuse ordinary activate pre-write. Explicit resume of that exact record
+    # after full revalidation is the only permitted path. No latest-directory
+    # authority, no duplicate same-intent auto adoption, no foreign same-bytes
+    # adoption (path+sha must match, not just bytes).
+    try:
+        from scripts import survey_production_v2 as _core2
+    except ImportError:
+        return
+    # Derive pub_dir from exclude path's parent (canonical publication/v2).
+    try:
+        pub_abs = (repo / exclude_rel).parent
+        children = sorted(pub_abs.iterdir())
+    except OSError:
+        return
+    want_issue = record_base.get("issue_id")
+    want_sup = record_base.get("supersedes")
+    want_before = record_base.get("before_state_ref")
+    want_set = record_base.get("set_ref")
+    want_prior = record_base.get("prior_checkpoint")
+    for child in children:
+        try:
+            cst = os.lstat(child)
+        except OSError:
+            continue
+        if stat.S_ISLNK(cst.st_mode) or not stat.S_ISREG(cst.st_mode):
+            continue
+        name = child.name
+        prefix = "publication-surface-revalidation-r"
+        suffix = ".json"
+        if not name.startswith(prefix) or not name.endswith(suffix):
+            continue
+        middle = name[len(prefix):-len(suffix)]
+        if not middle.isdigit() or (len(middle) > 1 and middle.startswith("0")):
+            continue
+        try:
+            rel = str(child.resolve().relative_to(repo.resolve()))
+        except ValueError:
+            continue
+        if rel == exclude_rel:
+            continue
+        # Only complete activation records with same intent match (incomplete or
+        # foreign same-bytes without exact refs never match).
+        try:
+            data = _read_bytes_bounded(repo, rel, "existing activation intent")
+            existing = _strict_json_from_bytes(data, "existing activation intent")
+        except Exception:
+            continue
+        if not isinstance(existing, dict):
+            continue
+        if existing.get("kind") != "EDITORIAL_PUBLICATION_ACTIVATION_V1":
+            continue
+        if existing.get("reason_class") != "REVIEWED_EDITORIAL_CORRECTION":
+            continue
+        if existing.get("issue_id") != want_issue:
+            continue
+        if existing.get("supersedes") != want_sup:
+            continue
+        if existing.get("before_state_ref") != want_before:
+            continue
+        if existing.get("set_ref") != want_set:
+            continue
+        if existing.get("prior_checkpoint") != want_prior:
+            continue
+        # Exact intent exists elsewhere: refuse ordinary activate, require
+        # explicit resume of that record after full revalidation.
+        raise _fail("INTENT_COLLISION", "ACTIVATE", "REFUSED_PRE_WRITE", f"exact operation intent already exists at {rel} (ordinary activate refuses; use resume_activation on that record after full revalidation; no auto adoption)")
+
