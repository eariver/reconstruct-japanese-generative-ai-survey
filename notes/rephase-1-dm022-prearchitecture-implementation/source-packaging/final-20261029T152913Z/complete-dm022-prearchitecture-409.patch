+#!/usr/bin/env python3
+"""DM022 pre-Architecture acceptance operation (HIGH, sole mutator) — A2 correction.
+
+Binding: contract a345bb95 INCLUDING S11, pre-code ROOT S5, R4 md/json +
+five literal schemas, R5 families, R6 roles. R3 mechanics as overridden.
+
+Role: SOLE mutator while a bound guard exists. Owns ALL writes: new
+revision R/package/task/card/view/acceptance/ledger/completeness/COPY
+snapshots/manifests/proof/report/checkpoint/guard/completion/State triplet
+switch + checked 7-slot clearing. Exclusive O_CREAT|O_EXCL + short-write
+loop + fsync + checked close + replace + dirfsync + postread. NEVER
+core.write_json / shutil.copy2 / Path.is_file for absence (single os.lstat
+per path per phase; ENOENT = absent legitimate; symlink/nonregular/unreadable
+= refuse).
+
+Top-level ONLY: core, schema_gate, LOW (survey_research_authority_v2).
+agent/evidence/screening/completeness/discovery imports are function-local
+inside each entry. CLI is a real argparse wrapper over the four entries;
+no new caller flags/verified dicts.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import stat as _stat
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from scripts import survey_production_v2 as core
+from scripts import survey_schema_v2 as schema_gate
+from scripts import survey_research_authority_v2 as low
+
+DM022_SCHEMA_VERSION = "2.0-rc1"
+_REVISION_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
+_HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
+_HEX40_RE = re.compile(r"^[0-9a-f]{40}$")
+
+
+class AcceptanceError(ValueError):
+    """Typed HIGH failure (retains primary/secondary + observed bytes)."""
+
+
+def _norm_path(value: Any, label: str) -> Path:
+    """Coerce a documented Path-or-string filesystem input (no IO).
+
+    Accepts exactly Path or non-empty string; anything else raises the typed
+    error instead of an AttributeError or a silent misresolution. Callers
+    still apply repo containment and no-follow reads after normalization.
+    """
+    if isinstance(value, Path):
+        return value
+    if isinstance(value, str) and value:
+        return Path(value)
+    raise AcceptanceError(f"{label} must be a Path or non-empty string, got {type(value).__name__}")
+
