+    except (ValueError, OSError) as exc:
+        return [f"editorial activation seal invalid: {exc}"]
+    # No second active-role table: seal is the single selection table (exactly 15).
+    if not isinstance(seal.get("roles"), dict) or set(seal["roles"]) != set(pubset.PUBLICATION_ROLES_15):
+        errors.append("editorial activation carries second active-role table or wrong role set")
+    # No fake legacy rows: editorial record must not contain legacy row keys.
+    for legacy_key in ("superseded_artifacts", "preserved_artifacts", "validation"):
+        if legacy_key in record:
+            errors.append(f"editorial activation must not carry legacy row table: {legacy_key}")
+    # before_state/supersedes/before-candidate/digest agreement via low level.
+    # Full digest + retained-COPY proof runs inside validate_activation_record;
+    # here re-verify the record file itself through pubset when its path is
+    # known to the caller chain (live/historical both use retained COPY, never
+    # live-State equality). If the record path cannot be re-derived here, the
+    # chain loader (_check_revalidation_chain / _resolve) already calls pubset
+    # with the exact file; this row check covers table binding only.
+    if record.get("prior_checkpoint") != (state.get("checkpoint_provenance") or {}).get("validation"):
