+        fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} exclusive temp create failed: {tmp}: errno={exc.errno}") from exc
