+def _lstat_single(path: Path, label: str) -> os.stat_result | None:
+    try:
+        return os.lstat(path)
+    except OSError as exc:
+        import errno as _errno
+
+        if exc.errno == _errno.ENOENT:
+            return None
+        raise AcceptanceError(f"{label} lstat failed: {path}: errno={exc.errno}") from exc
+
