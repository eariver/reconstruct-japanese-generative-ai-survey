+        # Isolated DB: remove candidate-work .git (actual409 with 39M42U), init fresh NEW DB.
+        import shutil as _sh2
+        _sh2.rmtree(root / ".git", ignore_errors=True)
+        _run_git(root, "init", "-b", "main")
