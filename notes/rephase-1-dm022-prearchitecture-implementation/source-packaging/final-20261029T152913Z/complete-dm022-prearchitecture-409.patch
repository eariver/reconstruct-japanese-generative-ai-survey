+def _route_code_deps(route: str, family: str = "G76") -> tuple[str, ...]:
+    """Exact fixed sorted-unique replay dependency set for one route.
+
+    G71 historical (63) stays OWN-epoch; G76 CURRENT (70=63+2+5) while G76
+    active. Family derived OWN epoch, never caller flag; explicit mismatch
+    elsewhere refuses. Counts not authority; exact membership verified
+    member-wise vs actual imports/contract + current committed source.
+    """
+    if route == LONGFORM_ROUTE:
+        extra = (LONGFORM_READER_SCHEMA.as_posix(), LONGFORM_RECEIPT_SCHEMA.as_posix(),
+                 LONGFORM_SEMANTIC_PUBLICATION.as_posix())
+    elif route == WEEKLY_ROUTE:
+        extra = (WEEKLY_READER_SCHEMA.as_posix(), WEEKLY_RECEIPT_SCHEMA.as_posix(),
+                 WEEKLY_SEMANTIC_PUBLICATION.as_posix())
+    else:
+        raise StagedSourceError("UNKNOWN_ROUTE", "PIN", "REFUSED_PRE_WRITE",
+                                f"unsupported staged route: {route}")
+    if family == "G71":
+        _py = _SHARED_PY_G71
+        _sch = _SHARED_SCHEMAS_G71
+        _want = 63
+    elif family == "G76":
+        _py = _SHARED_PY_G76
+        _sch = _SHARED_SCHEMAS_G76
+        _want = 70
+    else:
+        raise StagedSourceError("UNSUPPORTED_MIGRATION", "PIN", "REFUSED_PRE_WRITE",
+                                f"unknown staged family: {family!r} (must be G71 63 or G76 70)")
+    members = (set(_py) | set(_sch) | set(extra)
+               | {STAGED_MODULE.as_posix(), STYLE_PATH.as_posix(), RECIPE_PATH.as_posix()})
+    ordered = tuple(sorted(members))
+    if len(ordered) != _want:
+        raise StagedSourceError("CODE_DEPS_SHAPE", "PIN", "REFUSED_PRE_WRITE",
+                                f"fixed renewal set changed size: {len(ordered)} != {_want} "
+                                f"(_py={len(_py)} _sch={len(_sch)} family={family})")
+    if family == "G71" and (len(_py) != 35 or len(_sch) != 22):
+        raise StagedSourceError("CODE_DEPS_SHAPE", "PIN", "REFUSED_PRE_WRITE",
+                                "G71 shared closure must be exactly 35 py +22 schemas")
+    if family == "G76" and (len(_py) != 37 or len(_sch) != 27):
+        raise StagedSourceError("CODE_DEPS_SHAPE", "PIN", "REFUSED_PRE_WRITE",
+                                "G76 shared closure must be exactly 37 py +27 schemas")
+    # Edge classification (no silent omit): top-level AST + function-local dynamic (P2V observer
+    # in materialize) + file-pin-only (schemas/style/recipe/semantic producers never imported).
+    # Any actual extra import beyond this set must require expansion return flag.
+    try:
+        import ast as _ast
+        _src = Path(__file__).read_text(encoding="utf-8")
+        _tree = _ast.parse(_src)
+        _actual_py: set[str] = set()
+        for _node in _ast.walk(_tree):
+            if isinstance(_node, (_ast.ImportFrom,)):
+                if _node.module and _node.module.startswith("scripts."):
+                    _actual_py.add(f"scripts/{_node.module.split('.', 1)[1]}.py")
+                elif _node.module == "scripts":
+                    for _a in _node.names:
+                        _actual_py.add(f"scripts/{_a.name}.py")
+            elif isinstance(_node, (_ast.Import,)):
+                for _a in _node.names:
+                    if _a.name.startswith("scripts."):
+                        _actual_py.add(f"scripts/{_a.name.split('.', 1)[1]}.py")
+        # Top-level + dynamic P2V/DM022 edges must be subset of G76 shared set;
+        # else expansion requires return to Astra, never silent omit. Lazy P2V
+        # import stays function-local (never in verifier closure); DM022 modules
+        # are file-pin-only here (HIGH owns writes) but listed for G76 membership.
+        _allowed_py = set(_SHARED_PY_G76) | {STAGED_MODULE.as_posix()}
+        _missing = sorted(_actual_py - _allowed_py)
+        if _missing:
+            raise StagedSourceError("CODE_DEPS_EXPANSION_REQUIRED", "PIN", "REFUSED_PRE_WRITE",
+                                    f"actual import beyond fixed set requires expansion, never silent omit: {_missing}")
+        # File-pin-only legitimate: schemas/style/recipe/semantic producers are pinned but never imported.
+        # SET/EDITORIAL_OP modules pinned per root selection (future editorial path invokes them;
+        # actual transitive proof includes dynamic P2V path, not only old top-level AST).
+    except StagedSourceError:
+        raise
+    except Exception as exc:
+        raise StagedSourceError("CODE_DEPS_AUDIT_FAILED", "PIN", "REFUSED_PRE_WRITE",
+                                f"closure edge audit failed: {exc}") from exc
+    return ordered
+
