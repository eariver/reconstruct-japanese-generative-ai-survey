+#!/usr/bin/env python3
+"""DM022 C1 H presence controls (C1 owned): artifact presence at tool epoch irrelevant.
+
+- Absent-at-epoch positive (tool commit predates CP, request/CP live uncommitted) — proves old erroneous absence requirement removed, via same LIVE/KEEP/COPY predicates.
+- Committed-input positive (request/Raw committed at epoch2, CP live uncommitted) — proves both storage contexts handled without CP-itself hash cycle.
+- OwnEpoch tools/config/schemas strict in both (G76 76 pipeline, Contract8, 5 DM022 + stage-checkpoint pinned a1b97759…).
+- No State/agent/HEAD, no publication _record_kind/supersedes, no CP commit.
+"""
+from __future__ import annotations
+import os, sys, subprocess, hashlib, json, tempfile, unittest
+from pathlib import Path
+def _repo_root() -> Path:
+    return Path(__file__).resolve().parents[1]
+REPO_ROOT=_repo_root()
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0,str(REPO_ROOT))
+
+class TestC1HPresenceControls(unittest.TestCase):
+    def _run_one(self, research_profile, rev_id, commit_request=False):
+        from tests.test_survey_evidence_v2 import SurveyEvidenceV2Tests
+        from tests.test_dm022_prearchitecture_acceptance_v2 import Dm022A2OperationTests
+        a=Dm022A2OperationTests(methodName="test_weekly_prepare_adopt_resume_readback")
+        chain=a._chain_root(research_profile)
+        state_abs=a._make_evidence_reviewed_state(chain)
+        root=chain["root"]
+        def git(*args):
+            r=subprocess.run(["git",*args],cwd=str(root),capture_output=True,text=True,env={**os.environ,"GIT_OPTIONAL_LOCKS":"0","GIT_CONFIG_NOSYSTEM":"1"},timeout=30)
+            if r.returncode!=0:
+                raise RuntimeError(f"git {' '.join(args)} failed: {r.stderr[:500]}")
+            return r.stdout.strip()
+        epoch1=git("rev-parse","HEAD")
+        if not commit_request:
+            out, req_path, dec_path = a._prepare_and_decide(chain, state_abs, rev_id, ["target-source"])
+            epoch2=epoch1
+        else:
+            # Committed-inputs: build v1, commit (epoch2 has request/Raw, CP absent),
+            # then rebuild live v2 (expected_head=epoch2) + prepare + decision (no commit
+            # between prepare and adopt, so no stale pins; CP remains live, no hash cycle).
+            # Committed v1 (stale expected_head) exists at epoch2, live v2 differs — H must
+            # pass both via same LIVE/KEEP/COPY predicates (presence irrelevant).
+            _req1, _dec1 = a._build_request_and_decision(chain, state_abs, rev_id, ["target-source"])
+            env={**os.environ,"GIT_OPTIONAL_LOCKS":"0","GIT_CONFIG_NOSYSTEM":"1"}
+            subprocess.run(["git","add","-A"],cwd=str(root),check=True,capture_output=True,env=env,timeout=60)
+            subprocess.run(["git","commit","-q","-m",f"C1 presence control committed inputs {rev_id}"],cwd=str(root),check=True,capture_output=True,env=env,timeout=60)
+            epoch2=git("rev-parse","HEAD")
+            out, req_path, dec_path = a._prepare_and_decide(chain, state_abs, rev_id, ["target-source"])
+        from scripts import survey_prearchitecture_acceptance_v2 as high
+        adopted=high.adopt_revision(root, state_abs, root/out["revision_root"], dec_path)
+        self.assertEqual(adopted.get("status"),"ADOPTED")
+        rev_rel=out["revision_root"]
+        cp_rel=f"{rev_rel}/checkpoint/record.json"
+        report_rel=f"{rev_rel}/proof/supersession-report.json"
+        copy_rel=f"{rev_rel}/retention/state-before.json"
+        # CP itself must remain live uncommitted (no hash cycle): absent at epoch2.
+        r=subprocess.run(["git","-C",str(root),"show",f"{epoch2}:{cp_rel}"],capture_output=True,env={**os.environ,"GIT_OPTIONAL_LOCKS":"0","GIT_CONFIG_NOSYSTEM":"1"},timeout=30)
+        self.assertNotEqual(r.returncode,0,f"CP must remain live uncommitted (no CP hash cycle): {cp_rel}")
+        # Request presence depends on case (absent vs committed) — both legitimate, H must pass both via LIVE.
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        verdict=hist.verify_prearch_accepted_graph(root, cp_rel, report_rel, copy_rel, epoch2, f"c1-presence-{research_profile.lower()}-{rev_id}")
+        self.assertTrue(verdict.get("PREARCH_VERIFIED"))
+        self.assertEqual(verdict.get("family"),"G76")
+        from scripts import survey_research_authority_v2 as low
+        errs=low.check_supersession_record_from_paths(root, root/cp_rel, root/report_rel, root/copy_rel)
+        self.assertEqual(errs,[])
+        return {"epoch":epoch2,"rev":rev_rel,"record_sha":verdict["record_sha"]}
+
+    def test_absent_at_epoch_still_passes_via_live(self):
+        out=self._run_one("WEEKLY","rev-c1-pres-abs-w",commit_request=False)
+        self.assertTrue(len(out["record_sha"])==64)
+
+    def test_committed_inputs_still_pass_via_live_no_cp_cycle(self):
+        out=self._run_one("WEEKLY","rev-c1-pres-com-w",commit_request=True)
+        self.assertTrue(len(out["record_sha"])==64)
+
+    def test_thematic_absent_and_committed(self):
+        out1=self._run_one("THEMATIC","rev-c1-pres-abs-t",commit_request=False)
+        out2=self._run_one("THEMATIC","rev-c1-pres-com-t",commit_request=True)
+        self.assertNotEqual(out1["record_sha"],out2["record_sha"])
