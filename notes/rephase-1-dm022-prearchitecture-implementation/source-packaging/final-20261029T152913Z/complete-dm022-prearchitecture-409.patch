+def claim_guard(
+    repo_root: Path, state_path: Path, rev: str, request_ref: dict, retention_ref: dict,
+    planned_checkpoint_bytes: bytes, expected_after_sha: str, executor: dict, work: dict,
+) -> dict:
+    """Claim the fixed canonical guard (immutable bytes after claim).
+
+    Nonce is deterministic from planned bytes (no urandom, no time-based
+    novelty). Refuses if guard already present. Returns {guard, guard_path}.
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    state_path = _norm_path(state_path, "state path")
+    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
+    state_raw = _safe_read_bytes(abs_state, "LIVE state for guard")
+    state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE state for guard")
+    _, _, source_root = _profile_and_source(repo_root, state)
+    guard_abs = low.guard_path_for(source_root)
+    if _lstat_single(guard_abs, "guard pre-claim") is not None:
+        raise AcceptanceError("DM022_TRANSITION_ACTIVE: guard already present")
+    planned_sha = hashlib.sha256(planned_checkpoint_bytes).hexdigest()
+    nonce = hashlib.sha256(b"dm022-nonce:" + planned_checkpoint_bytes).hexdigest()[:16]
+    if len(nonce) < 16 or not re.fullmatch(r"[0-9a-f]{16,}", nonce):
+        raise AcceptanceError("guard nonce derivation failed")
+    guard = {
+        "schema_version": "1.0", "issue_id": state.get("issue_id"), "revision_id": rev,
+        "attempt_nonce": nonce,
+        "guard_path": low.DM022_GUARD_REL,
+        "planned_checkpoint_ref": {"path": f"{retention_ref.get('revision_root', rev)}/checkpoint.planned.json", "sha256": planned_sha, "byte_count": len(planned_checkpoint_bytes)},
+        "before_state_sha256": hashlib.sha256(state_raw).hexdigest(),
+        "expected_after_state_sha256": expected_after_sha,
+        "work": work, "executor": executor,
+        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
+    }
+    _exclusive_write_bytes(guard_abs, core.json_bytes(guard), "guard claim")
+    return {"guard": guard, "guard_path": str(guard_abs)}
+
+
+def _bound_context(repo_root: Path, guard: dict[str, Any]) -> dict[str, Any]:
+    """Extract bound adopt context from a guard dict (fail-closed if detached)."""
+    for key in ("repo_root", "state_path", "rev_root", "source_root", "planned_bytes", "expected_sha", "retention", "manifest"):
+        if key not in guard:
+            raise AcceptanceError(f"{key} requires HIGH adopt context; see adopt_revision (no detached misuse)")
+    return guard
+
+
+def write_checkpoint_as_planned(guard: dict) -> dict:
+    """Write actual checkpoint as byte-identical copy of planned bytes."""
+    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
+    if ctx is None:
+        raise AcceptanceError("write_checkpoint_as_planned requires HIGH adopt context; see adopt_revision")
+    repo_root = _norm_path(ctx["repo_root"], "repo_root")
+    rev_root = Path(ctx["rev_root"])
+    planned_bytes: bytes = ctx["planned_bytes"]
+    planned_sha = hashlib.sha256(planned_bytes).hexdigest()
+    checkpoint_rel = f"{ctx['manifest']['revision_root']}/checkpoint/record.json"
+    checkpoint_abs = repo_root / checkpoint_rel
+    st = _lstat_single(checkpoint_abs, "checkpoint record")
+    if st is not None:
+        existing = _safe_read_bytes(checkpoint_abs, "checkpoint record")
+        if hashlib.sha256(existing).hexdigest() != planned_sha:
+            raise AcceptanceError("checkpoint record already exists with different bytes (no overwrite)")
+        return {"path": checkpoint_rel, "sha256": planned_sha, "idempotent": True}
+    _exclusive_write_bytes(checkpoint_abs, planned_bytes, "checkpoint record")
+    if hashlib.sha256(_safe_read_bytes(checkpoint_abs, "checkpoint record")).hexdigest() != planned_sha:
+        raise AcceptanceError("checkpoint FILE sha != planned sha (INDETERMINATE, preserve guard)")
+    return {"path": checkpoint_rel, "sha256": planned_sha, "idempotent": False}
+
+
+def replace_state_triplet(guard: dict) -> dict:
+    """ONE known-byte State file switch (guard-held, single-writer, inode-pinned)."""
+    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
+    if ctx is None:
+        raise AcceptanceError("replace_state_triplet requires HIGH adopt context; see adopt_revision")
+    repo_root = _norm_path(ctx["repo_root"], "repo_root")
+    ctx_state_path = _norm_path(ctx["state_path"], "state path")
+    abs_state = ctx_state_path if ctx_state_path.is_absolute() else (repo_root / str(ctx_state_path))
+    expected_raw: bytes = ctx["expected_raw"]
+    expected_sha: str = ctx["expected_sha"]
+    before_sha: str = ctx["guard"]["before_state_sha256"]
+    nonce: str = ctx["guard"]["attempt_nonce"]
+    live_raw = _safe_read_bytes(abs_state, "LIVE recheck before switch")
+    if hashlib.sha256(live_raw).hexdigest() == expected_sha:
+        return {"switched": False, "already_after": True, "sha256": expected_sha}
+    if hashlib.sha256(live_raw).hexdigest() != before_sha:
+        raise AcceptanceError("LIVE State is not exactly before-State at switch (INDETERMINATE, preserve guard)")
+    live_st_before = _lstat_single(abs_state, "LIVE before switch")
+    if live_st_before is None:
+        raise AcceptanceError("LIVE State vanished before switch")
+    tmp_state = abs_state.with_name(abs_state.name + f".tmp.{nonce}")
+    if _lstat_single(tmp_state, "temp expected State") is not None:
+        raise AcceptanceError("temp State already exists (no overwrite)")
+    _exclusive_write_bytes(tmp_state, expected_raw, "temp expected State")
+    live_recheck = _safe_read_bytes(abs_state, "LIVE recheck at replace")
+    live_recheck_st = _lstat_single(abs_state, "LIVE recheck stat")
+    if hashlib.sha256(live_recheck).hexdigest() != before_sha:
+        raise AcceptanceError("LIVE State moved during temp write (INDETERMINATE, preserve temp+guard)")
+    if live_recheck_st is None or live_st_before is None or (live_recheck_st.st_dev, live_recheck_st.st_ino) != (live_st_before.st_dev, live_st_before.st_ino):
+        raise AcceptanceError("LIVE State inode changed before replace (INDETERMINATE)")
+    try:
+        os.replace(tmp_state, abs_state)
+    except OSError as exc:
+        raise AcceptanceError(f"State atomic replace failed (INDETERMINATE): {exc}") from exc
+    try:
+        dir_fd = os.open(abs_state.parent, os.O_RDONLY)
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+    except OSError as exc:
+        raise AcceptanceError(f"State dir fsync failed (INDETERMINATE): {exc}") from exc
+    after_raw = _safe_read_bytes(abs_state, "LIVE postread")
+    if hashlib.sha256(after_raw).hexdigest() != expected_sha:
+        raise AcceptanceError("LIVE postread != expected_after (INDETERMINATE, preserve guard)")
+    return {"switched": True, "already_after": False, "sha256": expected_sha}
+
+
+def clear_remaining_exact_slots(guard: dict) -> dict:
+    """Checked clearing of remaining exact old slots (guard-held only)."""
+    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
+    if ctx is None:
+        raise AcceptanceError("clear_remaining_exact_slots requires HIGH adopt context; see adopt_revision")
+    repo_root = _norm_path(ctx["repo_root"], "repo_root")
+    source_root = Path(ctx["source_root"])
+    retention = ctx["retention"]
+    cleared: list[dict[str, Any]] = []
+    for row in retention.get("rows", []):
+        slot = row["slot"]
+        slot_abs = source_root / slot
+        st = _lstat_single(slot_abs, f"slot {slot} pre-clear")
+        if st is None:
+            # Missing at clear time: if retained present, the slot was removed
+            # outside the single-writer window (operator recovery after a
+            # foreign plant was refused); record cleared with the captured
+            # SHAs preserved (F12 missing-cleared). If never present, record
+            # absent_legitimate with null SHAs. Either way the end state
+            # (absent) plus captured identity is attested, never a bare flag.
+            if row.get("present"):
+                cleared.append({"slot": slot, "disposition": "cleared", "captured_sha": row.get("source_sha256"), "copy_sha": row.get("copy_sha256")})
+            else:
+                cleared.append({"slot": slot, "disposition": "absent_legitimate", "captured_sha": None, "copy_sha": None})
+            continue
+        _require_regular(st, slot_abs, f"slot {slot} pre-clear")
+        cur = _safe_read_bytes(slot_abs, f"slot {slot} pre-clear")
+        cur_st = _lstat_single(slot_abs, f"slot {slot} stat")
+        if row.get("present"):
+            if hashlib.sha256(cur).hexdigest() != row.get("source_sha256"):
+                raise AcceptanceError(f"slot {slot} changed since capture (foreign/replaced; refuse)")
+            if cur_st is not None and row.get("source_ino") is not None and (cur_st.st_dev, cur_st.st_ino) != (row.get("source_dev"), row.get("source_ino")):
+                raise AcceptanceError(f"slot {slot} inode changed since capture (foreign file with same bytes; refuse)")
+            copy_abs = repo_root / row["copy_rel"]
+            copy_raw = _safe_read_bytes(copy_abs, f"COPY {slot}")
+            if hashlib.sha256(copy_raw).hexdigest() != row.get("copy_sha256"):
+                raise AcceptanceError(f"COPY drift for slot {slot}")
+        else:
+            raise AcceptanceError(f"slot {slot} present but retention planned absent (foreign planted; no unowned unlink)")
+        try:
+            os.unlink(slot_abs)
+        except OSError as exc:
+            raise AcceptanceError(f"slot {slot} unlink failed: {exc}") from exc
+        try:
+            dir_fd = os.open(slot_abs.parent, os.O_RDONLY)
+            try:
+                os.fsync(dir_fd)
+            finally:
+                os.close(dir_fd)
+        except OSError as exc:
+            raise AcceptanceError(f"slot {slot} dir fsync failed: {exc}") from exc
+        if _lstat_single(slot_abs, f"slot {slot} post-clear") is not None:
+            raise AcceptanceError(f"slot {slot} still present after unlink")
+        cleared.append({"slot": slot, "disposition": "cleared", "captured_sha": row.get("source_sha256"), "copy_sha": row.get("copy_sha256")})
+    return {"seven_plan": cleared}
+
+
+def write_cleanup_completion(guard: dict) -> dict:
+    """Write owned completion receipt (owned R, not canonical) after verification."""
+    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
+    if ctx is None:
+        raise AcceptanceError("write_cleanup_completion requires HIGH adopt context; see adopt_revision")
+    repo_root = _norm_path(ctx["repo_root"], "repo_root")
+    rev_root = Path(ctx["rev_root"])
+    manifest = ctx["manifest"]
+    seven_plan = ctx.get("seven_plan") or []
+    expected_sha = ctx["expected_sha"]
+    guard_doc = ctx["guard"]
+    checkpoint_rel = f"{manifest['revision_root']}/checkpoint/record.json"
+    checkpoint_abs = repo_root / checkpoint_rel
+    checkpoint_raw = _safe_read_bytes(checkpoint_abs, "checkpoint record")
+    checkpoint_sha = hashlib.sha256(checkpoint_raw).hexdigest()
+    # COPY-derived expected_after cross-binding (recompute, no trusted booleans).
+    copy_abs = rev_root / "retention" / "state-before.json"
+    copy_raw = _safe_read_bytes(copy_abs, "retained COPY")
+    expected_recomputed = _expected_state_bytes(copy_raw, {"path": checkpoint_rel, "sha256": checkpoint_sha})
+    if hashlib.sha256(expected_recomputed).hexdigest() != expected_sha:
+        raise AcceptanceError("completion expected_after does not match COPY-derived recomputation (no trusted booleans)")
+    # Postread: LIVE must equal expected_after + triplet same-record + FULL
+    # adopted-graph validation (recomputes triplet_match/artifacts_rehashed
+    # instead of trusting booleans; forward lifecycle tolerated).
+    ctx_state_path = _norm_path(ctx["state_path"], "state path")
+    abs_state = ctx_state_path if ctx_state_path.is_absolute() else (repo_root / str(ctx_state_path))
+    after_raw = _safe_read_bytes(abs_state, "LIVE postread for completion")
+    if hashlib.sha256(after_raw).hexdigest() != expected_sha:
+        raise AcceptanceError("LIVE postread != expected_after at completion (INDETERMINATE)")
+    after_state = schema_gate.parse_json_strict_bytes(after_raw, "LIVE postread")
+    structural = low._resolve_research_from_state_bytes(repo_root, after_state)
+    low.require_same_triplet(after_state, structural)
+    if structural.get("checkpoint_path") != checkpoint_rel or structural.get("checkpoint_sha256") != checkpoint_sha:
+        raise AcceptanceError("LIVE postread triplet does not reference this completion checkpoint")
+    try:
+        rel_cp = str(checkpoint_abs.resolve().relative_to(repo_root.resolve()))
+    except ValueError:
+        rel_cp = checkpoint_rel
+    try:
+        low._verify_adopted_graph_full(repo_root, rel_cp, checkpoint_sha)
+    except Exception as exc:
+        raise AcceptanceError(f"postread FULL adopted-graph validation failed (INDETERMINATE): {exc}") from exc
+    completion = {
+        "schema_version": "1.0", "issue_id": manifest["issue_id"], "revision_id": manifest["revision_id"],
+        "attempt_nonce": guard_doc["attempt_nonce"],
+        "checkpoint": {"path": checkpoint_rel, "sha256": checkpoint_sha, "byte_count": len(checkpoint_raw)},
+        "expected_after_state": {"path": manifest["before_state"]["path"], "sha256": expected_sha, "byte_count": len(expected_recomputed)},
+        "seven_plan": seven_plan,
+        "postread": {"state_sha": expected_sha, "triplet_match": True, "artifacts_rehashed": True},
+        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
+        "executor": "HIGH adopt_revision",
+    }
+    completion_abs = rev_root / "completion" / "cleanup-completion.json"
+    if _lstat_single(completion_abs, "completion") is not None:
+        # Immutable completion timestamp: an existing receipt is revalidated
+        # for EXACT intent reuse (semantic equality excluding recorded_at) and
+        # reused WITHOUT rewrite — never regenerate fresh bytes over it.
+        existing_raw = _safe_read_bytes(completion_abs, "completion")
+        try:
+            existing = schema_gate.parse_json_strict_bytes(existing_raw, "completion")
+        except Exception as exc:
+            raise AcceptanceError(f"existing completion unparseable (no overwrite): {exc}") from exc
+        if {k: v for k, v in existing.items() if k != "recorded_at"} != {k: v for k, v in completion.items() if k != "recorded_at"}:
+            raise AcceptanceError("completion already exists with different intent (no overwrite)")
+        return {"path": str(completion_abs), "idempotent": True}
+    _exclusive_write_bytes(completion_abs, core.json_bytes(completion), "R completion")
+    return {"path": str(completion_abs), "idempotent": False}
+
