+                        f"{label} alias path refused before writes "
+                        f"(spelling {supplied_rel!r} != expected {expected_rel!r})")
+        if supplied_id == expected_id or supplied_sha == expected_sha:
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"{label} alias input refused before writes "
+                        f"(spelling differs but same bytes/inode: {supplied_rel!r} vs {expected_rel!r}; "
+                        "NOT ALREADY_ACTIVE by same SHA)")
