+def _real_trio_and_old_refs(sc: Scratch):
+    pr = _prior(sc)
+    seal = pr["seal"]
+    brec = next(iter([str(p.relative_to(sc.work)) for p in (sc.work / pr["seal_rel"]).parent.glob("build-record.json")]), None)
+    if brec is None:
+        brec = next(iter([str(p.relative_to(sc.work)) for p in (sc.work / f"sources/{sc.issue}/publication/v2/editorial-corrections/{sc.prop}").rglob("build-record.json")]), None)
+    assert brec is not None
+    trio = {
+        "primary": dict(seal["roles"]["validated-source"]),
+        "bibliography": dict(seal["roles"]["bibliography"]),
+        "style": dict(seal["roles"]["style"]),
+    }
+    old_man = {"path": seal["roles"]["reader-manuscript"]["path"], "sha256": seal["roles"]["reader-manuscript"]["sha256"],
+               "byte_count": seal["roles"]["reader-manuscript"]["byte_count"]}
+    old_build = {
+        "pdf": dict(seal["roles"]["publication-pdf"], page_count=5),
+        "log": dict(seal["roles"]["build-log"]),
+        "digest": dict(seal["roles"]["pdf-digest"]),
+        "record": {"path": brec, "sha256": _sha_file(sc.work / brec)},
+    }
+    return trio, old_man, old_build
