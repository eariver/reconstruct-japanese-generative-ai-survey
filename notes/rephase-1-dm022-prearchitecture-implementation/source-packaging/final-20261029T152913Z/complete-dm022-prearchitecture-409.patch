+        dir_fd = os.open(path.parent, os.O_RDONLY)
+    except OSError as exc:
+        raise AcceptanceError(f"{label} dir open failed: {exc}") from exc
+    try:
+        try:
+            os.fsync(dir_fd)
+        except OSError as exc:
+            raise AcceptanceError(f"{label} dir fsync failed: {exc}") from exc
