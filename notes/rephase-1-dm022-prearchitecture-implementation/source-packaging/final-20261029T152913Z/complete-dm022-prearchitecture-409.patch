+    def test_weekly_present_old_seven_slots_retain_clear_regenerate(self) -> None:
+        """Present-old-7slots: ordinary regen BEFORE adopt, retained/cleared/verified, new regen.
+
+        Runs the ordinary selection/architecture runner while State is still the
+        unaccepted EVIDENCE_REVIEWED graph (no Human presentation anywhere),
+        producing 7 old canonical outputs. The later DM022 prepare retains all 7
+        exact bytes, adopt clears them after the State switch, and a NEW
+        independent Selection input regenerates the 7 slots against the revised
+        graph. An all-absent plan alone is not old-output coverage.
+        """
+        from scripts import survey_agent_control_v2 as agent
+        from scripts import run_selection_architecture_v2_interactive as sel_runner
+        chain = self._chain_root("WEEKLY")
+        state_abs = self._make_evidence_reviewed_state(chain)
+        root: Path = chain["root"]
+        cfg: dict = chain["cfg"]
+        source_root = self._source_root_of(chain)
+        self._materialize_production_discovery_acceptance(chain)
+        from scripts import survey_screening_v2 as screening_mod
+        discoveries = screening_mod.read_jsonl(chain["discovery_path"])
+        screening_doc = core.load_json(chain["screening_acceptance"])
+        dec_map = {r["discovery_id"]: r["decision"] for r in screening_doc.get("decisions", [])}
+        expected_ids = {d["discovery_id"] for d in discoveries
+                        if dec_map.get(d["discovery_id"]) in ("KEEP", "MAYBE", "INSPECT")}
+        # No Human presentation anywhere before old-output generation.
+        state_before_old = core.load_json(state_abs)
+        self.assertIsNone(state_before_old["human_gate_provenance"]["architecture_review"])
+        self.assertEqual(state_before_old["human_gates"]["architecture_review"], "pending")
+        # Ordinary runner BEFORE adopt: old accepted graph, old reasoning.
+        old_input = self._build_selection_input(
+            root, chain["issue_id"], expected_ids, "old-v2", "WEEKLY")
+        old_result = sel_runner.run(root, state_abs, old_input)
+        self.assertEqual(old_result.get("review_readiness"), "READY_FOR_ARCHITECTURE_REVIEW")
+        old_shas = {}
+        for rel in sel_runner.DM022_SEVEN_SLOTS:
+            p = source_root / rel
+            self.assertTrue(p.is_file(), f"old slot missing: {rel}")
+            old_shas[rel] = _sha_file(p)
+        # DM022 prepare retains all 7 exact old bytes (present, not absent).
+        revision_id = "rev-full-oldslots-v2"
+        out, _, decision_path = self._prepare_and_decide(chain, state_abs, revision_id, ["target-source"])
+        rev_rel = out["revision_root"]
+        manifest = core.load_json(root / out["manifest_ref"]["path"])
+        self.assertEqual(len(manifest["retention_snapshots"]), 7)
+        for row in manifest["retention_snapshots"]:
+            self.assertTrue(row["present"], f"old slot must be retained as present: {row['slot']}")
+            self.assertEqual(row["source_sha256"], old_shas[row["slot"]],
+                             f"retained bytes must equal old slot bytes: {row['slot']}")
+            copy_abs = root / row["copy_rel"]
+            self.assertTrue(copy_abs.is_file())
+            self.assertEqual(_sha_file(copy_abs), old_shas[row["slot"]])
+            self.assertFalse(row["accepted_bound"])
+            self.assertFalse(row["gate_bound"])
+        # Adopt: triplet switch, then checked clearing of the exact old slots.
+        adopted = high.adopt_revision(root, state_abs, root / rev_rel, decision_path)
+        self.assertEqual(adopted.get("status"), "ADOPTED")
+        self.assertTrue(adopted.get("guard_released"))
+        seven_plan = adopted.get("seven_plan", [])
+        self.assertEqual(len(seven_plan), 7)
+        for row in seven_plan:
+            self.assertEqual(row.get("disposition"), "cleared",
+                             f"old present slot must be cleared: {row['slot']}")
+            self.assertEqual(row.get("captured_sha"), old_shas[row["slot"]],
+                             f"cleared slot must attest captured old bytes: {row['slot']}")
+        for rel in sel_runner.DM022_SEVEN_SLOTS:
+            self.assertFalse((source_root / rel).exists(), f"old slot not cleared: {rel}")
+        state = core.load_json(state_abs)
+        self.assertEqual(agent.validate_agent_state(root, cfg, state), [])
+        # New independent reasoning regenerates the 7 slots on the revised graph.
+        new_input = self._build_selection_input(
+            root, chain["issue_id"], expected_ids, "new-v2", "WEEKLY")
+        new_result = sel_runner.run(root, state_abs, new_input)
+        self.assertEqual(new_result.get("review_readiness"), "READY_FOR_ARCHITECTURE_REVIEW")
+        for rel in sel_runner.DM022_SEVEN_SLOTS:
+            self.assertTrue((source_root / rel).is_file(), f"regenerated slot missing: {rel}")
+
