+    def _materialize_production_discovery_acceptance(self, chain: dict) -> Path:
+        """Materialize source_root/discovery/discovery-accepted-v2.json truthfully.
+
+        Uses the same Discovery JSONL bytes as the chain plus a real X manifest.
+        WEEKLY (REQUIRED_BY_PROFILE) gets a real REQUIRED run + recorded Grok
+        result binding the same raw bytes; THEMATIC (CHATGPT_DECIDES) uses
+        NOT_REQUIRED. Raw file root/raw/source.json is created with real bytes
+        (the chain's Discovery source.raw_paths). Never fabricated SHAs.
+        """
+        from scripts import survey_discovery_v2 as discovery_mod
+        from scripts import survey_x_intake_v2 as x_mod
+        root: Path = chain["root"]
+        cfg: dict = chain["cfg"]
+        profile_path: Path = chain["profile_path"]
+        profile = core.load_json(profile_path)
+        # Real Raw bytes for the chain's Discovery source.raw_paths.
+        raw_path = root / "raw" / "source.json"
+        if not raw_path.is_file():
+            raw_path.parent.mkdir(parents=True, exist_ok=True)
+            raw_path.write_bytes(b'{"synthetic": "full-lifecycle raw source", "locator": "https://example.invalid/target-source"}\n')
+        source_root = root / profile["paths"]["source_root"]
+        spec_path = source_root / "external" / "x" / "spec.json"
+        spec_path.parent.mkdir(parents=True, exist_ok=True)
+        manifest_path = source_root / "external" / "x" / "x-source-intake-v2.json"
+        if profile["research_profile"] == "WEEKLY":
+            if not spec_path.is_file():
+                core.write_json(spec_path, {
+                    "decision": "REQUIRED",
+                    "rationale": "WEEKLY profile requires Grok/X Source Intake (synthetic fixture run)",
+                    "series_context": None,
+                    "runs": [{
+                        "run_id": "run-001",
+                        "purpose": "Synthetic fixture X observation for target-source",
+                        "research_questions": ["What is the synthetic target finding?"],
+                        "coverage_focus": ["synthetic target-source"],
+                        "time_scope": "2026-08-22",
+                        "expected_result_filename": "result-001.md",
+                    }],
+                })
+            if not manifest_path.is_file():
+                x_mod.build_manifest(root, cfg, profile_path,
+                                     core.load_json(spec_path), manifest_path)
+            # Record the Grok result binding the same raw bytes + target-source.
+            manifest_doc = core.load_json(manifest_path)
+            if manifest_doc.get("status") != "COMPLETE":
+                grok_raw = source_root / "external" / "x" / "run-001" / "result-001-raw.json"
+                grok_raw.parent.mkdir(parents=True, exist_ok=True)
+                if not grok_raw.is_file():
+                    grok_raw.write_bytes(raw_path.read_bytes())
+                # Discovery must bind the imported Grok raw: ensure the chain
+                # Discovery JSONL's raw_paths includes this grok raw path.
+                # Our helper Discovery uses root-relative raw/source.json; point
+                # the X result at that same file so binding holds.
+                x_mod.record_result(
+                    root, cfg, manifest_path, "run-001", raw_path,
+                    "result-001.md", "2026-08-22T02:00:00+09:00",
+                    "2026-08-22T02:05:00+09:00", "SUCCESS",
+                    "DISCOVERY_RECORDED", ["target-source"],
+                    "Synthetic fixture Grok observation binds target-source raw bytes")
+        else:
+            if not spec_path.is_file():
+                core.write_json(spec_path, {
+                    "decision": "NOT_REQUIRED",
+                    "rationale": "full-lifecycle fixture does not require X intake",
+                    "series_context": None,
+                    "runs": [],
+                })
+            if not manifest_path.is_file():
+                x_mod.build_manifest(root, cfg, profile_path,
+                                     core.load_json(spec_path), manifest_path)
+        acceptance_path = source_root / "discovery" / "discovery-accepted-v2.json"
+        if not acceptance_path.is_file():
+            acceptance_path.parent.mkdir(parents=True, exist_ok=True)
+            discovery_mod.build_acceptance(
+                root, chain["discovery_path"], manifest_path,
+                chain["issue_id"], acceptance_path)
+        # Validate immediately (real validator, not test boolean).
+        discovery_mod.validate_acceptance(root, acceptance_path)
+        return acceptance_path
