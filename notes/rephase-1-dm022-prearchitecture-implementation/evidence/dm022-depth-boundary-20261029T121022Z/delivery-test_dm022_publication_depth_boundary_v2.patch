+    ):
+        p = REPO_ROOT / rel
+        pins[rel] = _sha_file(p)[:12] if p.is_file() else "MISSING"
+    try:
+        head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=str(REPO_ROOT), capture_output=True, text=True, timeout=60).stdout.strip()
+        tree = subprocess.run(["git", "rev-parse", "HEAD^{tree}"], cwd=str(REPO_ROOT), capture_output=True, text=True, timeout=60).stdout.strip()
+    except Exception:
+        head, tree = "UNKNOWN", "UNKNOWN"
+    pins["HEAD"] = head
+    pins["tree"] = tree
+    return pins
