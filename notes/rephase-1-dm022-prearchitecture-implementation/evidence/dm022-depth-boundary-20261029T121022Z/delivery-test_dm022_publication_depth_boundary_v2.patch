+def _check_no_duplicate(tag: str) -> str:
+    """ps check before duplicate run; returns ps text (recorded in raw)."""
+    proc = subprocess.run(["ps", "-ef"], capture_output=True, text=True, timeout=60)
+    text = proc.stdout if proc.returncode == 0 else proc.stderr
+    # Count our test file processes (current runner + possible duplicates).
+    # Current runner is `python -m unittest ...test_dm022_publication_depth_boundary_v2...`
+    # Subprocess drivers are `python -c ...` (cwd=fixture), NOT containing test name.
+    matches = [ln for ln in text.splitlines() if "test_dm022_publication_depth_boundary_v2" in ln and "grep" not in ln]
+    # Allow exactly 1 (current). If >1, duplicate (another same test running).
+    if len(matches) > 1:
+        raise AssertionError(f"duplicate test children before {tag}: {len(matches)} matches: {matches[:5]}")
+    return text
