{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/editorial-publication-build-record-v2.schema.json",
  "title": "Survey Editorial Publication Build Record (EDITORIAL_PUBLICATION_BUILD_V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "issue_id",
    "proposal_ref",
    "staged_manifest_ref",
    "recipe_ref",
    "declared_inputs",
    "recipe",
    "toolchain",
    "outputs",
    "exit_code",
    "recorded_at",
    "build_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "kind": {"const": "EDITORIAL_PUBLICATION_BUILD_V1"},
    "issue_id": {"type": "string", "minLength": 1},
    "proposal_ref": {"$ref": "#/$defs/artifact"},
    "staged_manifest_ref": {"$ref": "#/$defs/artifact"},
    "recipe_ref": {"$ref": "#/$defs/artifact"},
    "declared_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "bibliography", "style"],
      "properties": {
        "primary": {"$ref": "#/$defs/artifact"},
        "bibliography": {"$ref": "#/$defs/artifact"},
        "style": {"$ref": "#/$defs/artifact"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_steps"],
      "properties": {
        "fixed_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "versions", "argv", "env"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "versions": {"type": "object"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication-pdf", "build-log", "pdf-digest"],
      "properties": {
        "publication-pdf": {"$ref": "#/$defs/fileRef"},
        "build-log": {"$ref": "#/$defs/fileRef"},
        "pdf-digest": {"$ref": "#/$defs/fileRef"}
      }
    },
    "exit_code": {"const": 0},
    "recorded_at": {"type": "string", "format": "date-time"},
    "build_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
