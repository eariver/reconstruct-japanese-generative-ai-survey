{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/editorial-toolchain-spec-v2.schema.json",
  "title": "Survey Editorial Toolchain Spec (EDITORIAL_TOOLCHAIN_SPEC_V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "executor",
    "absolute_executable",
    "recipe",
    "argv",
    "env",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "kind": {"const": "EDITORIAL_TOOLCHAIN_SPEC_V1"},
    "executor": {"type": "string", "minLength": 1},
    "absolute_executable": {"type": "string", "minLength": 1},
    "recipe": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "items": {"type": "string"}},
    "env": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
