{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/editorial-manuscript-spec-v2.schema.json",
  "title": "Survey Editorial Manuscript Spec (EDITORIAL_MANUSCRIPT_SPEC_V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "issue_id",
    "proposal_ref",
    "architecture_coverage",
    "reader_requirements",
    "authored_by",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "kind": {"const": "EDITORIAL_MANUSCRIPT_SPEC_V1"},
    "issue_id": {"type": "string", "minLength": 1},
    "proposal_ref": {"$ref": "#/$defs/artifact"},
    "architecture_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "requirement", "status", "reader_locations", "detail"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "status": {"const": "FULFILLED"},
          "reader_locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "reader_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "reader_locations", "detail"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "status": {"const": "FULFILLED"},
          "reader_locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "authored_by": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
