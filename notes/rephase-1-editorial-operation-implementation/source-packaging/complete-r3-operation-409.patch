+        try:
+            _check_scope("malformed", malformed, "SCOPE_UNREADABLE")
+        finally:
+            malformed.unlink()
+        # Non-PASS review (decision FAIL, digest recomputed) -> SCOPE_ORDINARY_INVALID.
+        nonpass = p1t._scope_review_for(self, root, prepared, staged_reader_rel, "scope-nonpass.json")
+        raw_np = core.load_json(nonpass)
+        raw_np["decision"] = "FAIL"
+        raw_np.pop("review_sha256", None)
+        raw_np["review_sha256"] = core.sha256_object(raw_np)
+        core.write_json(nonpass, raw_np)
+        _check_scope("non-PASS", nonpass, "SCOPE_ORDINARY_INVALID")
+        # Wrong-before -> SCOPE_WRONG_BEFORE.
+        wrong_before = p1t._scope_review_for(
+            self, root, prepared, staged_reader_rel, "scope-wrong-before.json",
+            before_override={"path": staged_reader_rel, "sha256": "0" * 64})
+        _check_scope("wrong-before", wrong_before, "SCOPE_WRONG_BEFORE")
+        # Wrong-after (targets before-reader, not proposed) -> exact phase.
