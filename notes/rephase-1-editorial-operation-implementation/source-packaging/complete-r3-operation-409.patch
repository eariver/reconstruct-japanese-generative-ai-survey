+FORBIDDEN_READER_PATTERNS = (
+    "Core v2 Evidence:",
+    "materiality:",
+    "Selection済みEvidence",
+    "normalized claim",
+    "Source-bound record",
+    "This retained evidence note",
+    "The bound ",
+    "Evidence pass",
+    "本Evidence",
+)
