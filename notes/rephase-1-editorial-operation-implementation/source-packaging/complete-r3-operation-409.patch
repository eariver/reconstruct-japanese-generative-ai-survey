+def _pipeline(col: _Collector, root: Path, state_path: Path, new_authored_value: str | Path,
+              proposal_id: str, tree_entry: dict[str, str],
+              change_description: str | None = None) -> dict[str, Any]:
+    # Fixed P1 wrapper: data + required absence + stability/tree checks.
+    # Preserves exact public P1 behavior; no caller-selected policy.
+    data = _pipeline_data(col, root, state_path, new_authored_value,
+                          proposal_id, change_description)
+    _require_retention_dests_absent(col, data["proposal"]["retention_plan"])
+    col.reverify()
+    profile = data["profile"]
+    if _tree_map(root, Path(profile["paths"]["source_root"]),
+                 Path(profile["paths"]["survey_root"])) != tree_entry:
+        raise _fail("TREE_MOVED", "edition tree changed during inspection")
+    # Preserve historical public shape (no profile key) for existing callers.
+    return {k: data[k] for k in ("proposal", "proposed_canonical", "before_canonical",
+                                 "graph", "frozen", "effective", "original_rows",
+                                 "active_record", "route", "before_authored_rel",
+                                 "new_authored_rel", "reader_rel",
+                                 "planned_reader_ref", "proposal_dir")}
+
+
+def _frozen_names_check(receipt: dict[str, Any], context: dict[str, Any]) -> None:
+    receipt_names = {row["name"] for row in receipt.get("accepted_refs", [])}
+    context_names = {row["name"] for row in context.get("accepted_refs", [])}
+    if receipt_names != context_names:
+        raise _fail("UPSTREAM_SET_DRIFT", "receipt accepted authority differs from rederived authority")
+    for row in receipt.get("accepted_refs", []):
+        match = next(item for item in context["accepted_refs"] if item["name"] == row["name"])
+        if match["sha256"] != row["sha256"]:
+            raise _fail("UPSTREAM_REF_DRIFT", f"accepted authority drifted: {row['name']}")
+
+
+def _proposed_upstream_check(before_context: dict[str, Any], proposed_context: dict[str, Any]) -> None:
+    # Proposed derivation must share exact upstream authority with before;
+    # only the publication-authored input delta is allowed.
+    before_names = {row["name"] for row in before_context.get("accepted_refs", [])}
+    proposed_names = {row["name"] for row in proposed_context.get("accepted_refs", [])}
+    if before_names != proposed_names:
+        raise _fail("PROPOSED_UPSTREAM_SET_DRIFT",
+                    "proposed accepted authority differs from before authority")
+    for row in before_context.get("accepted_refs", []):
+        match = next(item for item in proposed_context["accepted_refs"] if item["name"] == row["name"])
+        if match["sha256"] != row["sha256"] or match["path"] != row["path"]:
+            raise _fail("PROPOSED_UPSTREAM_REF_DRIFT",
+                        f"proposed upstream differs from before: {row['name']}")
+    if before_context.get("archive_path") != proposed_context.get("archive_path"):
+        raise _fail("PROPOSED_ARCHIVE_DRIFT", "proposed drafting archive path differs from before")
+    # Archive bytes already pinned via _derive (both pinned); verify equality.
+    # Architecture authority equality is covered by accepted_refs (issue-architecture)
+    # plus manuscript validation; explicit check here for clarity.
+    if before_context.get("profile", {}).get("issue_id") != proposed_context.get("profile", {}).get("issue_id"):
+        raise _fail("PROPOSED_PROFILE_DRIFT", "proposed profile identity differs from before")
+
+
+def _canonical_state_path(root: Path, cfg: dict[str, Any], profile: dict[str, Any]) -> Path:
+    try:
+        src = core.repo_local_path(root, profile["paths"]["source_root"], "paths.source_root")
+        return (src / cfg["state_authority"]["authoritative_filename"]).resolve()
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("STATE_CANONICAL_INVALID", f"cannot derive canonical State path: {exc}") from exc
+
+
+def _validated_state_profile_for_tree(col: _Collector, root: Path,
+                                      state_path_value: str | Path
+                                      ) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+    """Strict State/Profile authority BEFORE any broad tree walk (C4).
+
+    Loads State/Profile ONLY via safe-pinned bytes (no broad reads), enforces
+    strict validation, eligibility, Profile SHA/issue binding and canonical
+    State path. Returns (state, cfg, profile) with validated roots. Preview
+    contents are never trusted for directory inspection.
+    """
+    state_abs = col.safe(state_path_value, "Production State")
+    try:
+        state = json.loads(col.files[col.rel(state_abs)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("STATE_UNREADABLE", f"Production State not JSON: {exc}") from exc
+    if not isinstance(state, dict):
+        raise _fail("STATE_UNREADABLE", "Production State is not a JSON object")
+    try:
+        cfg = json.loads(col.files[core.DEFAULT_CONFIG.as_posix()].decode("utf-8"))
+    except (KeyError, UnicodeDecodeError, ValueError) as exc:
+        raise _fail("CONFIG_UNREADABLE", f"implementation config not JSON: {exc}") from exc
+    if agent.validate_agent_state(root, cfg, state):
+        raise _fail("STATE_INVALID", "Production State fails strict validation")
+    _eligibility(state)
+    profile = _load_profile(col, state)
+    if state_abs.resolve() != _canonical_state_path(root, cfg, profile):
+        raise _fail("STATE_NOT_CANONICAL", "Production State path is not canonical authoritative State")
+    # Validate roots are repo-local (no traversal/absolute escape) before walking.
+    try:
+        core.repo_local_path(root, profile["paths"]["source_root"], "paths.source_root")
+        core.repo_local_path(root, profile["paths"]["survey_root"], "paths.survey_root")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("PROFILE_ROOT_INVALID", f"profile roots invalid: {exc}") from exc
+    return state, cfg, profile
+
+
+def _final_full_receipt_recheck(col: _Collector, root: Path,
+                                result: dict[str, Any], label: str) -> None:
+    """Re-run ACTUAL full receipt/current-tool predicate (ancestry/dirty/
+    untracked/closure/contract/replay), not contract-only (C3).
+
+    Uses pinned receipt/State refs from the proposal basis; re-pins for
+    stability, re-runs route's full `validate_receipt` (no pending bypass),
+    then reverifies pinned stability. Caller rechecks tree/snapshots after.
+    """
+    route = result.get("route")
+    basis = (result.get("proposal") or {}).get("basis") or {}
+    receipt_rel = (basis.get("generated_receipt_ref") or {}).get("path", "")
+    state_rel = (basis.get("state_ref") or {}).get("path", "")
+    if not receipt_rel or not state_rel:
+        raise _fail("RECHECK_SHAPE", f"{label} missing receipt/State refs for final recheck")
+    receipt_abs = col.safe(receipt_rel, f"{label} final receipt")
+    state_abs = col.safe(state_rel, f"{label} final State")
+    # True repeat: peek actual kind; editorial uses generator_route + H validator,
+    # never ordinary Weekly/Longform after activation. No ordinary receipt after activation.
+    try:
+        _peek = json.loads(col.files[col.rel(receipt_abs)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("RECEIPT_RECHECK_FAILED", f"{label} final receipt not JSON: {exc}") from exc
+    _peek_kind = _peek.get("kind") if isinstance(_peek, dict) else None
+    try:
+        if _peek_kind == "EDITORIAL_PUBLICATION_SOURCE_V1":
+            _gen = _peek.get("generator_route")
+            if _gen not in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
+                raise _fail("RECHECK_ROUTE", f"{label} editorial generator_route invalid: {_gen!r}")
+            # H requires repo-relative refs; col carries absolute safe pins.
+            _edpub.validate_editorial_receipt(root, col.rel(receipt_abs), col.rel(state_abs))
+        elif route == LONGFORM_ROUTE:
+            # Ordinary receipt after activation is refused: if State is versioned active, do not run old validator.
+            _st_for_check = None
+            try:
+                _st_for_check = json.loads(col.files[col.rel(state_abs)].decode("utf-8"))
+            except Exception:
+                pass
+            if isinstance(_st_for_check, dict) and _has_pointer(_st_for_check):
+                # When pointer present, ordinary recheck would be ordinary-after-activation; fail closed unless old initial.
+                # Peek if active selection is VERSIONED_ACTIVE via strict helper (propagate errors).
+                _sel_check = _versioned_active_selection(root, json.loads(col.files[col.rel(col.safe(core.DEFAULT_CONFIG.as_posix(), 'config'))].decode("utf-8")) if core.DEFAULT_CONFIG.as_posix() in col.files else {}, _st_for_check)
+                if _sel_check is not None:
+                    raise _fail("RECEIPT_AFTER_ACTIVATION", f"{label} ordinary receipt must not run after versioned activation")
+            longform_generated.validate_receipt(root, receipt_abs, state_abs)
+        elif route == WEEKLY_ROUTE:
+            _st_for_check = None
+            try:
+                _st_for_check = json.loads(col.files[col.rel(state_abs)].decode("utf-8"))
+            except Exception:
+                pass
+            if isinstance(_st_for_check, dict) and _has_pointer(_st_for_check):
+                try:
+                    _cfg_for_check = json.loads(col.files[col.rel(col.safe(core.DEFAULT_CONFIG.as_posix(), 'config'))].decode("utf-8"))
+                except Exception:
+                    _cfg_for_check = {}
+                _sel_check = _versioned_active_selection(root, _cfg_for_check, _st_for_check)
+                if _sel_check is not None:
+                    raise _fail("RECEIPT_AFTER_ACTIVATION", f"{label} ordinary receipt must not run after versioned activation")
+            weekly.validate_receipt(root, receipt_abs, state_abs)
+        else:
+            raise _fail("RECHECK_ROUTE", f"{label} unknown route for final recheck: {route}")
+    except ValueError as exc:
+        # _fail already typed; preserve it, else wrap.
+        if isinstance(exc, ProposalError):
+            raise
+        raise _fail("RECEIPT_RECHECK_FAILED", f"{label} final receipt predicate failed: {exc}") from exc
+    col.reverify()
+
