+        # Each injects exactly once AFTER the full receipt recheck (which runs
+        # after scope, before second verify/final boundary), then asserts
+        # exact refusal + injected-only delta BEFORE repair.
+        import scripts.survey_editorial_correction_proposal_v2 as p1mod
+
+        def _midcall_case(label: str, inject, expected_code: str, expected_new_rel: str | None,
+                          expected_changed_rel: str | None = None):
