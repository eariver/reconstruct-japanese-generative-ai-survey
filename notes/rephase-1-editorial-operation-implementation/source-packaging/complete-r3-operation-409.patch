+    if bundle.get("pdf", {}).get("path") != roles["publication-pdf"]["path"] or bundle.get("pdf", {}).get("sha256") != roles["publication-pdf"]["sha256"]:
+        raise _fail("SEAL_BIND", "FINALIZE", "REFUSED_PRE_WRITE", "bundle PDF differs from seal publication-pdf (path+SHA)")
+    if bundle.get("pdf", {}).get("byte_count") != roles["publication-pdf"]["byte_count"]:
+        raise _fail("SEAL_BIND", "FINALIZE", "REFUSED_PRE_WRITE", "bundle PDF byte_count differs from seal publication-pdf")
+    # QA external result refs: deterministic results must exist/hash-match (pinned, not generic scan).
