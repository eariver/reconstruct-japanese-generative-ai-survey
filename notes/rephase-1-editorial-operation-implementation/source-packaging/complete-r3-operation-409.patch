+    # ---- 9. Alias / FIFO (explicit no-read + timeout) + mid-call seams ----
+
+    def test_alias_fifo_no_read_and_late_addition(self) -> None:
+        from tests import test_survey_editorial_correction_proposal_v2 as p1t
+        from scripts import survey_editorial_current_authority_v2 as obs
+        _s, root = _make_p2v_source_root(self, "p2v-alias-")
+        pair = self._build_weekly_pair(self, root, "fixture-wk-alias-1", "Weekly P2V alias edition")
+        proposal_dir = pair["proposal_path"].parent
+        # (a) Alias inside proposal layout must refuse without reading through it.
+        link = proposal_dir / "alias-leaf.json"
+        try:
+            link.symlink_to(proposal_dir / "proposal.json")
+        except OSError as exc:
+            self.fail(f"symlink setup failed: {exc}")
+        try:
+            before = p1t._snapshot(root)
+            with self.assertRaisesRegex(obs.CurrentAuthorityError, "PATH_ALIAS|TREE_ALIAS|PROPOSAL_LAYOUT"):
+                _observe_with_timeout(self, obs, {"root": root, "state_path": pair["state_path"],
+                                                  "proposal_path": pair["proposal_path"],
+                                                  "manifest_path": pair["manifest_path"]})
+            p1t._assert_no_write(self, before, p1t._snapshot(root), "alias no-write")
+        finally:
+            link.unlink()
+        # (b) FIFO inside proposal layout must refuse WITHOUT blocking open.
+        # Explicit no-read guard: track os.open for the FIFO leaf (must never
+        # be opened for reading; refusal happens via lstat type check with
+        # O_NONBLOCK/O_NOFOLLOW). Explicit timeout proves no hang; setup
+        # failure is explicit (fail, not skip).
+        fifo = proposal_dir / "fifo-probe"
+        try:
+            os.mkfifo(fifo)
+        except OSError as exc:
+            self.fail(f"fifo setup failed: {exc}")
+        try:
+            before = p1t._snapshot(root)
+            self.assertIn(str(fifo.relative_to(root)), before["special"],
+                          "FIFO must be inventoried as special before observe")
+            orig_open = os.open
+            opened_leafs: list[str] = []
+
+            def _track_open(name, *a, **k):
+                fd = orig_open(name, *a, **k)
+                try:
+                    sname = name if isinstance(name, str) else os.fsdecode(name)
+                except Exception:
+                    sname = ""
+                flags = a[0] if a else k.get("flags", 0)
+                try:
+                    is_dir = bool(flags & os.O_DIRECTORY)
+                except Exception:
+                    is_dir = False
+                if not is_dir:
+                    opened_leafs.append(sname)
+                return fd
+
+            with mock.patch("os.open", side_effect=_track_open):
+                with self.assertRaises(obs.CurrentAuthorityError):
+                    _observe_with_timeout(self, obs, {"root": root, "state_path": pair["state_path"],
+                                                      "proposal_path": pair["proposal_path"],
+                                                      "manifest_path": pair["manifest_path"]},
+                                          timeout_s=30)
+            self.assertNotIn("fifo-probe", "".join(opened_leafs),
+                             "FIFO leaf must not be opened for read (refuse via lstat, no open)")
+            p1t._assert_no_write(self, before, p1t._snapshot(root), "fifo no-write")
+        finally:
+            try:
+                os.unlink(fifo)
+            except OSError as exc:
+                self.fail(f"fifo cleanup failed: {exc}")
