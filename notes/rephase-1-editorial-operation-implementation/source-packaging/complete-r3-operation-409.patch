+class StrictJsonGapTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        from scripts import survey_schema_v2 as sg
+        sg._CACHE.clear()
+        self.sg = sg
+
+    def test_nested_duplicate_refused_before_digest(self) -> None:
+        # Nested duplicate must refuse BEFORE digest/schema, even with fresh hash.
+        dup = b'{"a": {"x": 1, "x": 2}, "b": 1}'
+        with self.assertRaises(self.sg.SchemaConformanceError) as ctx:
+            self.sg.parse_json_strict_bytes(dup, "nested dup")
+        self.assertIn("duplicate", str(ctx.exception).lower())
+        # Same-value duplicate with fresh hash still refused (SHA does not excuse).
+        same_dup = b'{"a": 1, "a": 1}'
+        with self.assertRaises(self.sg.SchemaConformanceError):
+            self.sg.parse_json_strict_bytes(same_dup, "same dup")
+        # High strict wrapper must surface DUPLICATE_KEY typed, not digest.
+        from scripts import survey_editorial_publication_v2 as high
+        with self.assertRaises(high.EditorialError) as hctx:
+            high._strict_json_from_bytes(same_dup, "high dup")
+        self.assertEqual(getattr(hctx.exception, "code", ""), "DUPLICATE_KEY")
+
+    def test_invalid_plain_json_refused(self) -> None:
+        bad = b'{invalid json}'
+        with self.assertRaises(self.sg.SchemaConformanceError):
+            self.sg.parse_json_strict_bytes(bad, "bad json")
+        from scripts import survey_editorial_publication_v2 as high
+        with self.assertRaises(high.EditorialError):
+            high._strict_json_from_bytes(bad, "high bad")
+
+    def test_valid_legacy_still_valid_and_cache_fresh(self) -> None:
+        valid = {"name": "ok", "nested": {"x": 1}}
+        p = self.root / "valid.json"
+        p.write_text(json.dumps(valid), encoding="utf-8")
+        sp = self.root / "schema.json"
+        sp.write_text(json.dumps({
+            "$schema": "https://json-schema.org/draft/2020-12/schema",
+            "type": "object",
+            "additionalProperties": False,
+            "required": ["name"],
+            "properties": {"name": {"type": "string"}, "nested": {"type": "object"}},
+        }), encoding="utf-8")
+        # Strict load passes for valid legacy.
+        got = self.sg.load_json_strict(p, label="valid")
+        self.assertEqual(got["name"], "ok")
+        # Strict + schema passes.
+        got2 = self.sg.load_and_validate_json_strict(p, sp, label="valid2")
+        self.assertEqual(got2["name"], "ok")
+        # Cache holds only validators, fresh instance each call (no result caching).
+        self.assertTrue(len(self.sg._CACHE) <= 64)
+        # Mutate file, same path different bytes must miss (fresh bytes).
+        p.write_text(json.dumps({"name": "ok2", "nested": {"x": 2}}), encoding="utf-8")
+        got3 = self.sg.load_json_strict(p, label="valid3")
+        self.assertEqual(got3["name"], "ok2")
