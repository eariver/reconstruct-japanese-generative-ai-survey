+        raise _fail("PROFILE_MISMATCH", "VALIDATE", "REFUSED_PRE_WRITE", "editorial receipt Profile mismatch vs strict State")
+    try:
+        cfg = _strict_json_from_bytes(_read_bytes_bounded(repo, core.DEFAULT_CONFIG.as_posix(), "implementation config"), "implementation config")
+    except EditorialError:
+        raise
+    except (OSError, ValueError) as exc:
+        raise _fail("CONFIG_UNREADABLE", "VALIDATE", "REFUSED_PRE_WRITE", f"implementation config unreadable: {exc}") from exc
+    # Current-State canonical: validated Profile/config source_root/authoritative_filename
+    # + actual raw State path equality/no aliases; retained/cloned refused for current APIs.
+    # Historical verify_activation_history stays separate (no State); inert set remains valid
+    # against actual old current State (no requirement target already active).
+    _require_canonical_current_state(repo, cfg, state, state_rel)
+    # Strict State via existing agent validator (local import, terminates via identity, no Gate/receipt recursion).
+    try:
+        from scripts import survey_agent_control_v2 as agent
+    except ImportError as exc:
+        raise _fail("AGENT_MISSING", "VALIDATE", "REFUSED_PRE_WRITE", f"agent validator missing; need concrete validate_agent_state to root: {exc}") from exc
+    if not hasattr(agent, "validate_agent_state"):
