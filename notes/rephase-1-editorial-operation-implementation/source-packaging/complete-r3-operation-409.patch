+            raise _fail("CHECKPOINT_RESOLVE_FAILED", f"{checkpoint}/{artifact_name}: {exc}") from exc
+        # Pin wrapper (State provenance, explicit) + artifact (record SHA, explicit).
+        # resolved.checkpoint_authority should equal State provenance (validated by API).
+        try:
+            wrapper_rel = col.pinned(resolved["checkpoint_authority"], f"checkpoint wrapper {checkpoint}")
+        except Exception as exc:
+            raise _fail("WRAPPER_PIN_FAILED", f"checkpoint wrapper {checkpoint}: {exc}") from exc
+        # Load record from pinned wrapper bytes (no second-read switch, already validated by API).
+        try:
+            record = json.loads(col.files[wrapper_rel].decode("utf-8"))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise _fail("CHECKPOINT_RECORD_UNREADABLE", f"{checkpoint} record not JSON: {exc}") from exc
+        _ckpt_record_cache[checkpoint] = (wrapper_rel, record)
+        art = resolved["artifact"]
+        # resolved.artifact_path is absolute; derive rel via col (stability, SHA already verified by API).
+        arel = col.pinned({"path": art["path"], "sha256": art["sha256"]},
+                          f"checkpoint {checkpoint} {artifact_name}")
+        return arel, art, wrapper_rel
+
+    def _ckpt_add(checkpoint: str, artifact_name: str, frozen_kind: str, edge_label: str) -> str:
+        arel, art, wrel = _ckpt_resolve(checkpoint, artifact_name)
+        # Lossless roles: checkpoint-artifact provenance + upstream frozen kind (union, same KEEP).
+        graph.node(arel, art["sha256"], len(col.files[arel]),
+                   f"checkpoint-artifact:{checkpoint}:{artifact_name}", _pol(arel))
+        graph.node(arel, art["sha256"], len(col.files[arel]),
+                   f"upstream:{frozen_kind}", _pol(arel))
+        graph.edge(wrel, f"CHECKPOINT_ARTIFACT {artifact_name}", arel, art["sha256"])
+        # Also edge for frozen provenance (optional, keeps edge family explicit).
+        # Primary edge above suffices; frozen digest uses node roles.
+        return arel
+
+    # Discovery / screening (fixed names).
+    _ckpt_add("discovery", "discovery-acceptance", "discovery-acceptance", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("screening", "screening-acceptance", "screening-acceptance", "CHECKPOINT_ARTIFACT")
+    # Evidence/materiality/completeness producer (same CANDIDATES_NORMALIZED file).
+    # Views pair via active resolver (same checkpoint + binding check, no cross-run join).
+    try:
+        agent.resolve_active_evidence_views(root, cfg, state)
+    except Exception as exc:
+        raise _fail("VIEWS_RESOLVE_FAILED", f"active evidence/views: {exc}") from exc
+    # Pin evidence + views acceptances via checkpoint (exact, no guessing).
+    _ckpt_add("evidence", "evidence-acceptance", "evidence-acceptance", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("evidence", "edition-views-acceptance", "edition-views-acceptance", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("materiality", "materiality-ledger", "materiality-ledger", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("completeness", "profile-completeness", "profile-completeness", "CHECKPOINT_ARTIFACT")
+    # Selection (both matrix + selection, exact).
+    _ckpt_add("selection", "candidate-matrix", "candidate-matrix", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("selection", "candidate-selection", "candidate-selection", "CHECKPOINT_ARTIFACT")
+    # Architecture (all three, exact names from record).
+    _ckpt_add("architecture", "issue-architecture", "issue-architecture", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("architecture", "architecture-review-summary", "architecture-review-summary", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("architecture", "architecture-review-attention", "architecture-review-attention", "CHECKPOINT_ARTIFACT")
+    # Draft synthesis (fixed) + packages/results (dynamic via pinned record, no pid guessing).
+    _ckpt_add("draft", "synthesis-input", "synthesis-input", "CHECKPOINT_ARTIFACT")
+    _ckpt_add("draft", "synthesis-result", "synthesis-result", "CHECKPOINT_ARTIFACT")
+    # Discover draft package/result names from already-validated pinned draft record (no guessing).
+    if "draft" in _ckpt_record_cache:
+        _, _draft_record = _ckpt_record_cache["draft"]
+        for _row in _draft_record.get("artifacts", []) or []:
+            _n = _row.get("name", "")
+            if _n.startswith("draft-package:") or _n.startswith("draft-result:"):
+                # Pin via cached record (no redundant API revalidation, SHA from record).
+                _arel = col.pinned({"path": _row["path"], "sha256": _row["sha256"]},
+                                   f"checkpoint draft {_n}")
+                graph.node(_arel, _row["sha256"], len(col.files[_arel]),
+                           f"checkpoint-artifact:draft:{_n}", _pol(_arel))
+                graph.node(_arel, _row["sha256"], len(col.files[_arel]),
+                           f"upstream:{_n}", _pol(_arel))
+                # Wrapper rel for draft from cache.
+                _wrel, _ = _ckpt_record_cache["draft"]
+                graph.edge(_wrel, f"CHECKPOINT_ARTIFACT {_n}", _arel, _row["sha256"])
+    # Views files via acceptance views[] (validator-defined schema/path conventions).
+    # Find pinned views acceptance(s) (upstream:edition-views-acceptance nodes).
+    _views_acc_rels = [p for p, n in graph.nodes.items()
+                       if "upstream:edition-views-acceptance" in n.get("roles", [])]
+    for _vacc_rel in list(_views_acc_rels):
+        try:
+            _vacc_data = json.loads(col.files[_vacc_rel].decode("utf-8"))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise _fail("VIEWS_SHAPE", f"views acceptance not JSON: {exc}") from exc
+        _views = _vacc_data.get("views") or []
+        if not isinstance(_views, list):
+            raise _fail("VIEWS_SHAPE", "views acceptance views not a list")
+        # Import view_filename convention (validator-defined, no guessing).
+        try:
+            from scripts.survey_evidence_v2 import view_filename as _view_filename
+        except Exception as exc:
+            raise _fail("VIEWS_FILENAME_UNAVAILABLE", f"view filename convention unavailable: {exc}") from exc
+        for _vrow in _views:
+            if not isinstance(_vrow, dict):
+                raise _fail("VIEW_ROW_SHAPE", "view row not an object")
+            _tid = _vrow.get("evidence_task_id", "")
+            _vsha = _vrow.get("view_sha256", "")
+            if not _tid or len(_vsha) != 64:
+                raise _fail("VIEW_ROW_SHAPE", "view row fields invalid")
+            _fname = _view_filename(_tid)
+            _vrel = (Path(_vacc_rel).parent / "views" / _fname).as_posix()
+            col.pinned({"path": _vrel, "sha256": _vsha}, f"edition view {_tid}")
+            graph.node(_vrel, _vsha, len(col.files[_vrel]),
+                       f"upstream:edition-view:{_tid}", _pol(_vrel))
+            graph.edge(_vacc_rel, f"VIEWS_RESULT {_tid}", _vrel, _vsha)
+
+    # ---- D1: Discovery x_source_intake + raw_refs + X-manifest locals (exact, typed) ----
+    # Explicit local authority refs only ({path,sha256} + {path,sha256,byte_count});
+    # source_locator (URL), drive paths, historical SHAs stay provenance (no follow,
+    # no generic string recursion, no new intake). Research/raw KEEP+frozen;
+    # tool/prompt/control refs (none in these fixtures' manifests) would be KEEP
+    # operational — distinguished here, none required. Size bound where supplied.
+    _disc_acc_rels = [p for p, n in graph.nodes.items()
+                      if "upstream:discovery-acceptance" in n.get("roles", [])]
+    for _dacc_rel in list(_disc_acc_rels):
+        try:
+            _dacc_data = json.loads(col.files[_dacc_rel].decode("utf-8"))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise _fail("DISCOVERY_SHAPE", f"discovery acceptance not JSON: {exc}") from exc
+        # Top-level discovery raw JSONL (explicit discovery_path/sha256, no size in schema).
+        _dpath = _dacc_data.get("discovery_path", "")
+        _dsha = _dacc_data.get("discovery_sha256", "")
+        if not isinstance(_dpath, str) or not _dpath or len(_dsha) != 64:
+            raise _fail("DISCOVERY_SHAPE", "discovery path/sha invalid")
+        col.pinned({"path": _dpath, "sha256": _dsha}, "discovery raw JSONL")
+        graph.node(_dpath, _dsha, len(col.files[_dpath]),
+                   "upstream:discovery-raw-jsonl", _pol(_dpath))
+        graph.edge(_dacc_rel, "DISCOVERY_RAW_JSONL", _dpath, _dsha)
+        # REQUIRED x_source_intake manifest (explicit local authority, not URL).
+        _xref = _dacc_data.get("x_source_intake") or {}
+        if not isinstance(_xref, dict) or set(_xref) != {"path", "sha256"}:
+            raise _fail("DISCOVERY_X_SHAPE", "discovery x_source_intake fields invalid")
+        _xrel = col.pinned(_xref, "discovery x_source_intake manifest")
+        graph.node(_xrel, _xref["sha256"], len(col.files[_xrel]),
+                   "upstream:x-source-intake", _pol(_xrel))
+        graph.edge(_dacc_rel, "DISCOVERY_X_INTAKE", _xrel, _xref["sha256"])
+        # X-manifest actually required locals via schema/validator conventions.
+        try:
+            _xdata = json.loads(col.files[_xrel].decode("utf-8"))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise _fail("X_MANIFEST_SHAPE", f"X manifest not JSON: {exc}") from exc
+        _prod = _xdata.get("production_profile") or {}
+        if not isinstance(_prod, dict) or set(_prod) != {"path", "sha256"}:
+            raise _fail("X_MANIFEST_SHAPE", "X production_profile invalid")
+        _prod_rel = col.pinned(_prod, "X manifest production profile")
+        graph.node(_prod_rel, _prod["sha256"], len(col.files[_prod_rel]),
+                   "upstream:x-production-profile", _pol(_prod_rel))
+        graph.edge(_xrel, "X_MANIFEST production-profile", _prod_rel, _prod["sha256"])
+        _runs = _xdata.get("runs") or []
+        if not isinstance(_runs, list):
+            raise _fail("X_MANIFEST_SHAPE", "X runs not a list")
+        for _run in _runs:
+            if not isinstance(_run, dict):
+                raise _fail("X_RUN_SHAPE", "X run not an object")
+            _rid = _run.get("run_id", "")
+            _task = _run.get("task") or {}
+            if not isinstance(_task, dict) or set(_task) != {"path", "sha256"}:
+                raise _fail("X_TASK_SHAPE", f"X task fields invalid: {_rid}")
+            _trel = col.pinned(_task, f"X task {_rid}")
+            graph.node(_trel, _task["sha256"], len(col.files[_trel]),
+                       f"upstream:x-task:{_rid}", _pol(_trel))
+            graph.edge(_xrel, f"X_TASK {_rid}", _trel, _task["sha256"])
+            _res = _run.get("result")
+            if _res is None:
+                continue
+            if not isinstance(_res, dict):
+                raise _fail("X_RESULT_SHAPE", f"X result not an object: {_rid}")
+            _raw = _res.get("raw") or {}
+            if not isinstance(_raw, dict) or set(_raw) != {"path", "sha256", "byte_count"}:
+                raise _fail("X_RAW_SHAPE", f"X raw fields invalid: {_rid}")
+            _rrel = col.pinned({"path": _raw["path"], "sha256": _raw["sha256"]}, f"X raw {_rid}")
+            if len(col.files[_rrel]) != _raw["byte_count"]:
+                raise _fail("X_RAW_SIZE_MISMATCH", f"X raw size drifted: {_rrel}")
+            graph.node(_rrel, _raw["sha256"], _raw["byte_count"],
+                       f"upstream:x-raw:{_rid}", _pol(_rrel))
+            graph.edge(_xrel, f"X_RAW {_rid}", _rrel, _raw["sha256"])
+        # Records raw_refs (explicit, with size; outside edition tree possible, e.g. raw/source.json).
+        # source_locator (URL) deliberately NOT followed (provenance only).
+        _records = _dacc_data.get("records") or []
+        if not isinstance(_records, list) or not _records:
+            raise _fail("DISCOVERY_SHAPE", "discovery records invalid")
+        for _rec in _records:
+            if not isinstance(_rec, dict):
+                raise _fail("DISCOVERY_RECORD_SHAPE", "discovery record not an object")
+            _did = _rec.get("discovery_id", "")
+            _raws = _rec.get("raw_refs") or []
+            if not isinstance(_raws, list) or not _raws:
+                raise _fail("DISCOVERY_RAW_SHAPE", f"discovery {_did} raw_refs invalid")
+            for _raw in _raws:
+                if not isinstance(_raw, dict) or set(_raw) != {"path", "sha256", "byte_count"}:
+                    raise _fail("DISCOVERY_RAW_SHAPE", f"discovery {_did} raw ref fields invalid")
+                _rrel2 = col.pinned({"path": _raw["path"], "sha256": _raw["sha256"]},
+                                     f"discovery raw {_did}")
+                if len(col.files[_rrel2]) != _raw["byte_count"]:
+                    raise _fail("DISCOVERY_RAW_SIZE_MISMATCH", f"discovery raw size drifted: {_rrel2}")
+                graph.node(_rrel2, _raw["sha256"], _raw["byte_count"],
+                           f"upstream:discovery-raw:{_did}", _pol(_rrel2))
+                graph.edge(_dacc_rel, f"DISCOVERY_RAW {_did}", _rrel2, _raw["sha256"])
+
+    # Frozen digest: ONE entry per (kind,path) to preserve all union roles.
+    frozen: list[dict[str, str]] = []
+    seen_frozen: set[tuple[str, str]] = set()
+    for path, node in graph.nodes.items():
+        for kind in _frozen_member_kinds(node["roles"]):
+            key = (kind, path)
+            if key in seen_frozen:
+                continue
+            seen_frozen.add(key)
+            frozen.append({"kind": kind, "path": path, "sha256": node["sha256"]})
+    frozen.sort(key=lambda row: (row["kind"], row["path"]))
+    preserved_digest = core.sha256_object(frozen)
+    return graph.canonical(), frozen, preserved_digest
+
+def _retention_rows_for_graph(col: _Collector, graph: dict[str, Any], proposal_dir: str) -> list[dict[str, Any]]:
+    # Data-only rows construction + common safety/namespace checks.
+    # ONE row per node/path with sorted roles (plural only, no singular `role`);
+    # KEEP => retained_ref, COPY => retained_dest only (P1 plan has NO measured
+    # retained_sha256/retained_byte_count; those belong only to P2R manifest rows).
+    # Destinations are deterministic prospective paths disjoint from live inputs.
+    # No absence verdict here; callers apply fixed completion separately.
+    if "\\" in proposal_dir or ".." in Path(proposal_dir).parts:
+        raise _fail("RETENTION_DIR_TRAVERSAL", f"proposal dir unsafe: {proposal_dir}")
+    seen_dest: set[str] = set()
+    inputs = set(col.files)
+    rows = []
+    for node in graph["nodes"]:
+        entry: dict[str, Any] = {"roles": node["roles"],
+                                 "path": node["path"], "sha256": node["sha256"],
+                                 "byte_count": node["byte_count"], "policy": node["policy"]}
+        if node["policy"] == "KEEP_IMMUTABLE":
+            entry["retained_ref"] = {"path": node["path"], "sha256": node["sha256"]}
+        else:
+            dest = (proposal_dir + "/retained/before/" + node["path"]).replace("//", "/")
+            if "\\" in dest or ".." in Path(dest).parts:
+                raise _fail("RETENTION_DEST_TRAVERSAL", f"retention destination unsafe: {dest}")
+            # Raw ancestor alias checks even though dest is absent (prospective).
+            # Determine repo-relative parts robustly (dest is repo-relative here).
+            if Path(dest).is_absolute():
+                try:
+                    rel_parts = Path(dest).relative_to(col.root).parts
+                except ValueError:
+                    raise _fail("RETENTION_DEST_ESCAPE", f"retention destination escapes root: {dest}") from None
+            else:
+                rel_parts = Path(dest).parts
+            cursor = col.root
+            for part in rel_parts[:-1]:
+                if part in ("..", ".", ""):
+                    raise _fail("RETENTION_DEST_TRAVERSAL", f"retention destination unsafe part: {dest}")
+                cursor = cursor / part
+                try:
+                    if cursor.is_symlink():
+                        raise _fail("RETENTION_DEST_ALIAS", f"retention ancestor is symlink: {dest}")
+                except OSError as exc:
+                    raise _fail("PATH_UNREADABLE", f"retention ancestor unreadable: {dest}: {exc}") from exc
+            if dest in inputs:
+                raise _fail("RETENTION_OVERLAP", f"retention destination overlaps live input: {dest}")
+            # Namespace overlap: dest must not be ancestor/descendant of any live input.
+            for live in inputs:
+                if dest == live or dest.startswith(live.rstrip("/") + "/") or live.startswith(dest.rstrip("/") + "/"):
+                    raise _fail("RETENTION_OVERLAP", f"retention destination overlaps live input namespace: {dest}")
+            if dest in seen_dest:
+                raise _fail("RETENTION_DEST_CONFLICT", f"duplicate retention destination: {dest}")
+            seen_dest.add(dest)
+            entry["retained_dest"] = dest
+        rows.append(entry)
+    rows.sort(key=lambda row: row["path"])
+    return rows
+
+
+def _require_retention_dests_absent(col: _Collector, rows: list[dict[str, Any]]) -> None:
+    # Fixed P1 absence completion only (including dangling aliases).
+    # Never blesses unknown bytes; P2V never calls this (uses full retained verification instead).
+    for entry in rows:
+        if entry.get("policy") != "COPY_BEFORE_REPLACEMENT":
+            continue
+        dest = entry.get("retained_dest", "")
+        try:
+            if (col.root / dest).is_symlink() or (col.root / dest).exists():
+                raise _fail("RETENTION_DEST_CONFLICT",
+                            f"retention destination already present (no overwrite): {dest}")
+        except OSError as exc:
+            raise _fail("PATH_UNREADABLE", f"retention destination unreadable: {dest}: {exc}") from exc
+
+
+def _retention_plan(col: _Collector, graph: dict[str, Any], proposal_dir: str) -> list[dict[str, Any]]:
+    # Fixed P1 wrapper: rows + absence (preserves exact public P1 behavior).
+    rows = _retention_rows_for_graph(col, graph, proposal_dir)
+    _require_retention_dests_absent(col, rows)
+    return rows
+
+
+def _pipeline_data(col: _Collector, root: Path, state_path: Path, new_authored_value: str | Path,
+                    proposal_id: str,
+                    change_description: str | None = None) -> dict[str, Any]:
+    # Data-only current-basis/context derivation (no acceptance policy, no
+    # input_hashes/readiness, no stability/tree assertion). Builds rows via
+    # common safety without absence verdict; fixed completions live in callers.
+    _check_proposal_id(proposal_id)
+    state_file = col.safe(state_path, "Production State")
+    # Load State from pinned bytes (raw-first, no second-read switch).
+    try:
+        state = json.loads(col.files[col.rel(state_file)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("STATE_UNREADABLE", f"Production State bytes are not JSON: {exc}") from exc
+    if not isinstance(state, dict):
+        raise _fail("STATE_UNREADABLE", "Production State is not a JSON object")
+    # Config via safe (raw-first), loaded from pinned bytes.
+    cfg_path = col.safe(core.DEFAULT_CONFIG.as_posix(), "implementation config")
+    try:
+        cfg = json.loads(col.files[col.rel(cfg_path)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("CONFIG_UNREADABLE", f"implementation config bytes are not JSON: {exc}") from exc
+    if agent.validate_agent_state(root, cfg, state):
+        raise _fail("STATE_INVALID", "Production State fails strict validation")
+    _eligibility(state)
+    profile = _load_profile(col, state)
+    # Canonical State enforcement: State path must equal Profile/config-derived
+    # authoritative State path; an unreferenced clone is not live authority.
+    try:
+        src_root_for_state = core.repo_local_path(root, profile["paths"]["source_root"], "paths.source_root")
+        canonical_state = (src_root_for_state / cfg["state_authority"]["authoritative_filename"]).resolve()
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("STATE_CANONICAL_INVALID", f"cannot derive canonical State path: {exc}") from exc
+    if state_file.resolve() != canonical_state:
+        raise _fail("STATE_NOT_CANONICAL", "Production State path is not the canonical authoritative State")
+    route = _route_of(profile)
+    # Canonical proposal directory under validated source_root (exact, not final2 names only).
+    try:
+        source_root_rel = profile["paths"]["source_root"]
+        source_root_abs = core.repo_local_path(root, source_root_rel, "paths.source_root")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("PROFILE_ROOT_INVALID", f"profile source_root invalid: {exc}") from exc
+    expected_proposal_dir = (Path(source_root_rel) / "publication" / "v2" /
+                             "editorial-corrections" / proposal_id).as_posix()
+    # Authoring input must already be at the named proposal authoring-input.json
+    # BEFORE prepare (fixtures/operator stage it outside P1; P1 writes nothing).
+    # This avoids external-path refs silently accepted by digest alone.
+    new_authored_abs = col.safe(new_authored_value, "new publication-authored input")
+    new_authored_rel = col.rel(new_authored_abs)
+    if new_authored_rel != (expected_proposal_dir + "/authoring-input.json").replace("//", "/"):
+        raise _fail("AUTHORING_NOT_STAGED",
+                    f"authoring input must already be at {expected_proposal_dir}/authoring-input.json")
+    # Proposal dir layout checks: repo-local, no traversal/alias, disjoint from live canonical.
+    if "\\" in expected_proposal_dir or ".." in Path(expected_proposal_dir).parts:
+        raise _fail("PROPOSAL_LAYOUT", "proposal directory unsafe")
+    # Planned reader ref (prospective; file need not exist at prepare time).
+    planned_reader_rel = (expected_proposal_dir + "/reader-surface-input-v2.json").replace("//", "/")
+    original_record, original_rows = _original_checkpoint(col, root, state)
+    effective, active_record = _active_effective(col, root, cfg, state, original_rows)
+    allowed = agent._publication_revalidation_roles(root, cfg, state)
+    for row in original_rows:
+        if allowed.get(row["name"]) != row["path"]:
+            raise _fail("ROW_NOT_CANONICAL", f"original row outside configured roles: {row['name']}")
+
+    try:
+        manuscript_doc = reader.validate_manuscript_manifest(
+            root, root / effective["reader-manuscript"]["path"], issue_id=state.get("issue_id"))
+    except ValueError as exc:
+        raise _fail("MANUSCRIPT_INVALID", f"reader manuscript validation failed: {exc}") from exc
+    gate_abs = col.safe(effective["reader-surface-gate"]["path"], "active Gate record")
+    try:
+        gate_hint = json.loads(col.files[col.rel(gate_abs)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("GATE_UNREADABLE", f"active Gate record not JSON: {exc}") from exc
+    receipt_rel = ((gate_hint.get("derivation") or {}).get("receipt") or {}).get("path")
+    if not receipt_rel:
+        raise _fail("GATE_RECEIPT_SHAPE", "gate record carries no receipt binding")
+    receipt_file = col.safe(receipt_rel, "generated receipt")
+    try:
+        envelope = json.loads(col.files[col.rel(receipt_file)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("RECEIPT_UNREADABLE", f"generated receipt is not JSON: {exc}") from exc
+    if not isinstance(envelope, dict):
+        raise _fail("RECEIPT_UNREADABLE", "generated receipt is not a JSON object")
+    # Active receipt kind determines derivation route via actual `generator_route`
+    # (editorial) not old profile fakes. True repeated before-graph, not cosmetic.
+    envelope_kind = envelope.get("kind") if isinstance(envelope, dict) else None
+    if envelope_kind == "EDITORIAL_PUBLICATION_SOURCE_V1":
+        envelope_gen = envelope.get("generator_route")
+        if envelope_gen not in ("WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"):
+            raise _fail("RECEIPT_GENERATOR_ROUTE", f"active editorial generator_route invalid: {envelope_gen!r}")
+        derive_route = _derive_route_for_generator(envelope_gen)
+        # Editorial authored refs: proposed-publication-authoring + accepted-draft-archive.
+        try:
+            _auth_by_name = {r.get("name"): r.get("path") for r in envelope.get("authored_refs", []) if isinstance(r, dict)}
+            before_authored_rel = _auth_by_name.get("proposed-publication-authoring") or _auth_by_name.get("publication-semantic-input")
+            envelope_reader_rel = (envelope.get("reviewed_reader_input") or {}).get("path")
+        except (AttributeError, TypeError) as exc:
+            raise _fail("RECEIPT_REF_SHAPE", f"editorial receipt routing refs unreadable: {exc}") from exc
+        if not before_authored_rel or not envelope_reader_rel:
+            raise _fail("RECEIPT_REF_SHAPE", "editorial receipt lacks routing refs")
+    else:
+        derive_route = route
+        try:
+            before_authored_rel = next(
+                row["path"] for row in envelope.get("authored_refs", [])
+                if isinstance(row, dict) and row.get("name") == "publication-semantic-input")
+            envelope_reader_rel = (envelope.get("reviewed_reader_input") or {}).get("path")
+        except (AttributeError, TypeError, StopIteration) as exc:
+            raise _fail("RECEIPT_REF_SHAPE", f"generated receipt routing refs unreadable: {exc}") from exc
+        if not before_authored_rel or not envelope_reader_rel:
+            raise _fail("RECEIPT_REF_SHAPE", "generated receipt lacks routing refs")
+    before_context = _derive(col, root, derive_route, state_file, before_authored_rel)
+    reader_file = col.safe(envelope_reader_rel, "active-before reader input")
+    before_canonical = _canonical(derive_route, before_context["surface"])
+    if reader_file.read_bytes() != before_canonical:
+        raise _fail("NONCANONICAL_BEFORE", "active-before reader file is not canonical derivation bytes")
+
+    proposed_context = _derive(col, root, derive_route, state_file, new_authored_abs)
+    proposed_canonical = _canonical(derive_route, proposed_context["surface"])
+    if proposed_canonical == before_canonical:
+        raise _fail("NO_EDITORIAL_CHANGE", "proposed reader bytes identical to active-before bytes")
+    _proposed_upstream_check(before_context, proposed_context)
+
+    # Dispatch H validator for editorial (actual P1 after retention, public refusal maintained);
+    # old canonical Weekly/Longform constraints retained. Use returned accepted context.
+    dispatched = _dispatch_generated_receipt(root, receipt_file, state_file)
+    if dispatched is not None:
+        receipt = dispatched
+        # Editorial accepted context: H validator already proved accepted refs,
+        # contract, closure, trio, scope, replay. Generator route was derived
+        # from the envelope above; the accepted context must agree with it.
+        if receipt.get("generator_route") != envelope_gen:
+            raise _fail("EDITORIAL_RECEIPT_MISMATCH", "H validator accepted context generator_route differs from envelope")
+        # Early scope comes from the exact scope_review_ref (pinned here, exact
+        # {path,sha256}); no unchecked caller dict, no semantic_review alias
+        # (the new kind carries scope_review_ref, not semantic_review).
+        _scope_ref = receipt.get("scope_review_ref")
+        if not isinstance(_scope_ref, dict) or set(_scope_ref) != {"path", "sha256"}:
+            raise _fail("EDITORIAL_SCOPE_SHAPE", "editorial accepted context lacks exact scope_review_ref")
+        col.pinned({"path": _scope_ref["path"], "sha256": _scope_ref["sha256"]},
+                   "editorial scope review (early scope)")
+        # Actual authored role names (P1 fields, no invention).
+        _got_authored = {r.get("name") for r in receipt.get("authored_refs", []) if isinstance(r, dict)}
+        if _got_authored != {"proposed-publication-authoring", "accepted-draft-archive"}:
+            raise _fail("EDITORIAL_AUTHORED", "editorial accepted context authored roles invalid")
+        # FULL accepted list compare against before_context via the shared
+        # frozen/check mechanism (names + path + sha, no dups) -- never a
+        # single validation-checkpoint fake row. Original validation checkpoint
+        # identity comes from State/proposal/activation, not accepted_refs.
+        _frozen_names_check(receipt, before_context)
+        for _row in receipt.get("accepted_refs", []):
+            _match = next(item for item in before_context["accepted_refs"] if item["name"] == _row["name"])
+            if _match["path"] != _row["path"]:
+                raise _fail("UPSTREAM_PATH_DRIFT", f"accepted authority path differs: {_row['name']}")
+    else:
+        try:
+            if derive_route == LONGFORM_ROUTE:
+                receipt = longform_generated.validate_receipt(root, receipt_file, state_file)
+            else:
+                receipt = weekly.validate_receipt(root, receipt_file, state_file)
+        except ValueError as exc:
+            raise _fail("RECEIPT_INVALID", f"generated receipt validation failed: {exc}") from exc
+    renderer_commit = receipt["current_tools"]["repository_commit_sha"]
+    if receipt["current_tools"]["contract"] != core.contract_identity(
+            root, cfg, profile["research_profile"], profile["publication_profile"]):
+        raise _fail("RECEIPT_CONTRACT_DRIFT", "validated receipt contract differs from current contract")
+    if receipt["reviewed_reader_input"].get("path") != envelope_reader_rel:
+        raise _fail("RECEIPT_BINDING_CHANGED", "validated receipt reader binding differs from routing read")
+    if dispatched is None:
+        _frozen_names_check(receipt, before_context)
+    # Editorial already ran the shared frozen/check (names + path + sha) at
+    # dispatch; ordinary runs it here. No validation-checkpoint fake anywhere.
+
+    try:
+        gate_record = surface_gate.validate_reader_surface_gate(
+            root, root / effective["reader-surface-gate"]["path"], issue_id=state.get("issue_id"),
+            publication_profile=profile.get("publication_profile"),
+            expected_manuscript_path=root / effective["reader-manuscript"]["path"],
+            state_path=state_file)
+    except ValueError as exc:
+        raise _fail("GATE_INVALID", f"active Gate validation failed: {exc}") from exc
+    if gate_record.get("status") != "PASSED":
+        raise _fail("GATE_NOT_PASSED", "active Gate record is not PASSED")
+    if dispatched is not None:
+        # Editorial: gate-bound pre-TeX review is the exact early scope review
+        # (scope_review_ref path, pinned at dispatch). The new kind carries no
+        # semantic_review key. It targets the active-before reader (exact same
+        # proposed scope target equality, no copied review path).
+        _scope_pretex_rel = receipt["scope_review_ref"]["path"]
+        try:
+            pretex = surface_gate.load_and_validate_reader_surface_semantic_review(
+                root, _scope_pretex_rel, expected_issue_id=state.get("issue_id"),
+                expected_publication_profile=profile.get("publication_profile"),
+                expected_surface_path=envelope_reader_rel,
+                expected_surface_sha256=core.sha256_bytes(before_canonical), require_pass=True)
+        except ValueError as exc:
+            raise _fail("PRETEX_INVALID", f"editorial scope review validation failed: {exc}") from exc
+    else:
+        try:
+            pretex = surface_gate.load_and_validate_reader_surface_semantic_review(
+                root, receipt["semantic_review"]["path"], expected_issue_id=state.get("issue_id"),
+                expected_publication_profile=profile.get("publication_profile"),
+                expected_surface_path=envelope_reader_rel,
+                expected_surface_sha256=core.sha256_bytes(before_canonical), require_pass=True)
+        except ValueError as exc:
+            raise _fail("PRETEX_INVALID", f"pre-TeX review validation failed: {exc}") from exc
+    try:
+        bundle = quality.validate_bundle(
+            root, root / effective["quality-regression-bundle"]["path"], issue_id=state.get("issue_id"))
+    except ValueError as exc:
+        raise _fail("BUNDLE_INVALID", f"quality bundle validation failed: {exc}") from exc
+    state_rel = col.rel(state_file)
+    graph, frozen, preserved_digest = _build_graph(
+        col, root, cfg, state, original_rows, effective, active_record,
+        receipt, col.rel(receipt_file), gate_record, manuscript_doc, bundle, pretex,
+        state_rel, profile)
+    graph_digest = core.sha256_object(graph)
+    proposal_dir = expected_proposal_dir
+    retention = _retention_rows_for_graph(col, graph, proposal_dir)
+    # No absence, no reverify/tree here (fixed completions in callers).
+    # Re-derive planned refs from independently derived bytes (no silent file re-serialization).
+    planned_reader_sha = core.sha256_bytes(proposed_canonical)
+    planned_reader_ref = {"path": planned_reader_rel, "sha256": planned_reader_sha}
+    # Author-supplied change_description is descriptive input (nonempty), not machine approval.
+    if change_description is None:
+        effective_description = f"editorial correction proposal {proposal_id}"
+    else:
+        if not isinstance(change_description, str) or not change_description.strip():
+            raise _fail("CHANGE_DESCRIPTION_EMPTY", "change_description must be nonempty")
+        effective_description = change_description
+    new_authored_rel = col.rel(col.safe(new_authored_abs, "new publication-authored input"))
+    proposal = {
+        "schema_version": "2.0-rc1",
+        "proposal_id": proposal_id,
+        "issue_id": state.get("issue_id"),
+        "research_profile": profile.get("research_profile"),
+        "publication_profile": profile.get("publication_profile"),
+        "route": "EDITORIAL_CORRECTION_PROPOSAL_V1",
+        "status": "PROPOSED",
+        "basis": {
+            "state_ref": {"path": col.rel(state_file),
+                           "sha256": core.sha256_bytes(col.files[col.rel(state_file)])},
+            "validation_checkpoint_ref": dict((state.get("checkpoint_provenance") or {})["validation"]),
+            "active_revalidation_ref": dict(state.get("publication_revalidation_provenance"))
+            if state.get("publication_revalidation_provenance") else None,
+            "active_reader_input_ref": {"path": envelope_reader_rel,
+                                        "sha256": core.sha256_bytes(before_canonical)},
+            "before_graph_digest": graph_digest,
+            "preserved_upstream_digest": preserved_digest,
+            "generated_receipt_ref": {"path": col.rel(receipt_file),
+                                      "sha256": core.sha256_bytes(col.files[col.rel(receipt_file)])},
+            "renderer_commit": renderer_commit,
+            "contract_identity": receipt["current_tools"]["contract"],
+        },
+        "proposed": {
+            "authoring_input_ref": {"path": new_authored_rel,
+                                    "sha256": core.sha256_bytes(col.files[new_authored_rel])},
+            "proposed_reader_ref": dict(planned_reader_ref),
+            "proposed_reader_canonical_sha256": planned_reader_sha,
+            "change_description": effective_description,
+        },
+        "retention_plan": retention,
+    }
+    return {"proposal": proposal, "proposed_canonical": proposed_canonical,
+            "before_canonical": before_canonical, "graph": graph, "frozen": frozen,
+            "effective": effective, "original_rows": original_rows,
+            "active_record": active_record, "route": route,
+            "before_authored_rel": before_authored_rel,
+            "new_authored_rel": new_authored_rel, "reader_rel": envelope_reader_rel,
+            "planned_reader_ref": dict(planned_reader_ref), "proposal_dir": proposal_dir,
+            "profile": dict(profile)}
