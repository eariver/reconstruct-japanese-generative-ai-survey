+            raise SystemExit("existing complete reader input differs from current independent derivation")
+        if existing != surface:
+            raise SystemExit("existing complete reader input differs from current independent derivation")
+        # Exact raw surface bytes must equal canonical derivation (no noncanonical reuse).
