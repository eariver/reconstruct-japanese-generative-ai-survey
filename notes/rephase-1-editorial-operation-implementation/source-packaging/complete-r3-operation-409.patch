+        wrong_after = p1t._scope_review_for(
+            self, root, prepared, before_reader_rel, "scope-wrong-after.json")
+        _check_scope("wrong-after", wrong_after, "SCOPE_ORDINARY_INVALID|SCOPE_WRONG_AFTER|SCOPE_DIGEST")
+        # Stale upstream -> SCOPE_STALE_UPSTREAM.
+        stale_up = p1t._scope_review_for(self, root, prepared, staged_reader_rel, "scope-stale-up.json",
+                                         upstream_override="f" * 64)
+        _check_scope("stale-upstream", stale_up, "SCOPE_STALE_UPSTREAM")
+        # REJECT / REQUIRES_OWNER -> SCOPE_NOT_WITHIN_AUTHORITY.
+        for name, decision in (("scope-reject2.json", "REJECT"), ("scope-owner.json", "REQUIRES_OWNER_DECISION")):
