diff --git a/scripts/run_semantic_publication_v2_interactive.py b/scripts/run_semantic_publication_v2_interactive.py
index ba5aaac..a7a42ab 100644
--- a/scripts/run_semantic_publication_v2_interactive.py
+++ b/scripts/run_semantic_publication_v2_interactive.py
@@ -14,10 +14,41 @@ from scripts import survey_production_v2 as core
 from scripts import run_semantic_publication_v2_interactive_base as _base
 
 
-def _safe_owned(path: Path, root: Path) -> Path:
-    resolved = path.resolve()
-    resolved.relative_to(root.resolve())
-    return resolved
+def _raw_safe_owned(path: Path, root: Path) -> Path:
+    """Raw-first lexical ancestor lstat walk (no resolve-then-check laundering)."""
+    root_res = root.resolve()
+    lex = path if path.is_absolute() else (root_res / path)
+    try:
+        rel = lex.relative_to(root_res)
+    except ValueError as exc:
+        raise SystemExit(f"owned path escapes repository: {path}") from exc
+    if ".." in rel.parts or "\\" in str(rel):
+        raise SystemExit(f"owned path unsafe: {path}")
+    cur = root_res
+    for part in rel.parent.parts:
+        if part in ("..", ".", ""):
+            raise SystemExit(f"owned path unsafe component: {part}")
+        cur = cur / part
+        try:
+            if cur.is_symlink():
+                raise SystemExit(f"owned path has symlinked ancestor: {cur.relative_to(root_res)}")
