name: Build Special survey PDF

on:
  workflow_dispatch:
    inputs:
      production_profile_path:
        description: Repository path to the Special Production Profile
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: special-pdf-${{ inputs.production_profile_path }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact source revision
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Core v2 validation dependencies
        run: python -m pip install -r config/survey-production-v2-requirements.txt

      - name: Resolve Profile-bound Special source
        id: edition
        shell: bash
        env:
          PROFILE_PATH: ${{ inputs.production_profile_path }}
        run: |
          set -euo pipefail
          python - <<'PY' >> "$GITHUB_OUTPUT"
          import pathlib
          import os
          from scripts import survey_production_v2 as core

          root = pathlib.Path('.').resolve()
          rel = pathlib.PurePosixPath(os.environ['PROFILE_PATH'])
          if rel.is_absolute() or '..' in rel.parts:
              raise SystemExit('unsafe Production Profile path')
          profile_path = (root / rel).resolve()
          try:
              profile_path.relative_to(root)
          except ValueError as exc:
              raise SystemExit('Production Profile escapes repository') from exc
          if profile_path.is_symlink() or not profile_path.is_file():
              raise SystemExit('Production Profile missing or unsafe')

          cfg = core.load_json(root / core.DEFAULT_CONFIG)
          profile = core.load_json(profile_path)
          errors = core.validate_profile(profile, cfg)
          if errors:
              raise SystemExit('Production Profile invalid: ' + '; '.join(errors))
          if profile.get('publication_profile') != 'LONGFORM_SPECIAL':
              raise SystemExit('build-special-pdf requires LONGFORM_SPECIAL publication profile')

          survey_root = core.repo_local_path(root, profile['paths']['survey_root'], 'paths.survey_root')
          main_tex = survey_root / 'main.tex'
          if main_tex.is_symlink() or not main_tex.is_file():
              raise SystemExit('canonical reader-facing main.tex missing or unsafe')
          print(f'issue_id={profile["issue_id"]}')
          print(f'survey_root={survey_root.relative_to(root).as_posix()}')
          print(f'main_tex={main_tex.relative_to(root).as_posix()}')
          print(f'profile_path={profile_path.relative_to(root).as_posix()}')
          print(f'profile_sha256={core.sha256_file(profile_path)}')
          print(f'source_sha256={core.sha256_file(main_tex)}')
          PY

      - name: Set revision-derived reproducible PDF timestamp
        shell: bash
        run: echo "SOURCE_DATE_EPOCH=$(git show -s --format=%ct HEAD)" >> "$GITHUB_ENV"

      - name: Compile Special issue with LuaLaTeX
        uses: xu-cheng/latex-action@v4
        with:
          root_file: main.tex
          working_directory: ${{ steps.edition.outputs.survey_root }}
          texlive_version: 2026
          latexmk_use_lualatex: true

      - name: Analyze exact build output
        id: analyze
        shell: bash
        env:
          ISSUE_ID: ${{ steps.edition.outputs.issue_id }}
          SURVEY_ROOT: ${{ steps.edition.outputs.survey_root }}
          PROFILE_PATH: ${{ steps.edition.outputs.profile_path }}
          PROFILE_SHA256: ${{ steps.edition.outputs.profile_sha256 }}
          SOURCE_SHA256: ${{ steps.edition.outputs.source_sha256 }}
        run: |
          set -euo pipefail
          pdf="$SURVEY_ROOT/main.pdf"
          log="$SURVEY_ROOT/main.log"
          test -s "$pdf" && test -s "$log"
          blocking=$(grep -E -n 'LaTeX Warning: (There were undefined references|Citation .* undefined)|Package biblatex Warning: Please (re)?run|Missing character:' "$log" || true)
          layout=$(grep -E -n 'Overfull \\hbox|Underfull \\hbox' "$log" || true)
          pages=$(python - "$log" <<'PY'
          import re,sys
          text=open(sys.argv[1],encoding='utf-8',errors='replace').read()
          matches=re.findall(r'Output written on .*?\((\d+) pages?',text,re.S)
          if not matches:
              raise SystemExit('could not determine PDF page count from TeX log')
          print(matches[-1])
          PY
          )
          digest=$(sha256sum "$pdf" | awk '{print $1}')
          byte_count=$(stat -c '%s' "$pdf")
          export PDF_PATH="$pdf" LOG_PATH="$log" PAGE_COUNT="$pages" PDF_SHA256="$digest" BYTE_COUNT="$byte_count" BLOCKING="$blocking" LAYOUT="$layout"
          python - <<'PY'
          import json,os,pathlib,subprocess
          payload={
              'schema_version':'2.0-rc1',
              'issue_id':os.environ['ISSUE_ID'],
              'production_profile':{
                  'path':os.environ['PROFILE_PATH'],
                  'sha256':os.environ['PROFILE_SHA256'],
              },
              'source':{
                  'path':f"{os.environ['SURVEY_ROOT']}/main.tex",
                  'sha256':os.environ['SOURCE_SHA256'],
              },
              'pdf':{
                  'path':os.environ['PDF_PATH'],
                  'sha256':os.environ['PDF_SHA256'],
                  'byte_count':int(os.environ['BYTE_COUNT']),
                  'page_count':int(os.environ['PAGE_COUNT']),
              },
              'build':{
                  'commit_sha':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
                  'source_date_epoch':int(os.environ['SOURCE_DATE_EPOCH']),
                  'texlive_version':'2026',
                  'engine':'LuaLaTeX/latexmk',
              },
              'blocking_log_findings':os.environ['BLOCKING'].splitlines() if os.environ['BLOCKING'] else [],
              'layout_log_findings':os.environ['LAYOUT'].splitlines() if os.environ['LAYOUT'] else [],
              'status':'PASS' if not os.environ['BLOCKING'] else 'FAIL',
          }
          pathlib.Path('special-pdf-build-audit.json').write_text(
              json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf-8'
          )
          print(json.dumps(payload,ensure_ascii=False,indent=2))
          PY
          echo "page_count=$pages" >> "$GITHUB_OUTPUT"
          echo "pdf_sha256=$digest" >> "$GITHUB_OUTPUT"
          echo "byte_count=$byte_count" >> "$GITHUB_OUTPUT"
          if [ -n "$blocking" ]; then
            printf '%s\n' "$blocking"
            exit 1
          fi

      - name: Upload reproducible Special build evidence
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: special-build-${{ steps.edition.outputs.issue_id }}-${{ steps.analyze.outputs.pdf_sha256 || github.run_id }}
          path: |
            ${{ steps.edition.outputs.survey_root }}/main.pdf
            ${{ steps.edition.outputs.survey_root }}/main.log
            special-pdf-build-audit.json
          if-no-files-found: error
          retention-days: 14
