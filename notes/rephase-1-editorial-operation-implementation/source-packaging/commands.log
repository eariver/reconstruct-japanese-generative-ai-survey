fails = 0
for f in m['files']:
  rel = f['path']
  fp = proof/rel
  if not fp.exists():
    print(f'MISSING {rel}')
    fails += 1
    continue
  d = fp.read_bytes()
  if hashlib.sha256(d).hexdigest() != f['sha256'] or len(d) != f['bytes']:
    print(f'MISMATCH {rel}')
    fails += 1
print(f'PROOF_BEFORE_721 fails={fails} total={len(m["files"])}')
exit(1 if fails else 0)
