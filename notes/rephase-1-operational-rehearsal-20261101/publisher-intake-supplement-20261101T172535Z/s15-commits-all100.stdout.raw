ge":"Merge remote-tracking branch 'origin/master' into qwen4exp/qwen3.8-flash-next","tree":{"sha":"5708be88e25cb9157a12f16de30675f11a16e5d0","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/5708be88e25cb9157a12f16de30675f11a16e5d0"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23","html_url":"https://github.com/ggml-org/llama.cpp/commit/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23/comments","author":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https://api.github.com/users/ngxson/orgs","repos_url":"https://api.github.com/users/ngxson/repos","events_url":"https://api.github.com/users/ngxson/events{/privacy}","received_events_url":"https://api.github.com/users/ngxson/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https://api.github.com/users/ngxson/orgs","repos_url":"https://api.github.com/users/ngxson/repos","events_url":"https://api.github.com/users/ngxson/events{/privacy}","received_events_url":"https://api.github.com/users/ngxson/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6c5afc86ae84448ae4d744e357017e2c490ad9c3","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/6c5afc86ae84448ae4d744e357017e2c490ad9c3","html_url":"https://github.com/ggml-org/llama.cpp/commit/6c5afc86ae84448ae4d744e357017e2c490ad9c3"},{"sha":"c5fc7e34885ba31217e330809437afa993d27745","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/c5fc7e34885ba31217e330809437afa993d27745","html_url":"https://github.com/ggml-org/llama.cpp/commit/c5fc7e34885ba31217e330809437afa993d27745"}]},{"sha":"5eeb97d1e48a8467aadb6312d1ba83a0c1728a5f","node_id":"C_kwDOMU0YaNoAKDVlZWI5N2QxZTQ4YTg0NjdhYWRiNjMxMmQxYmE4M2EwYzE3MjhhNWY","commit":{"author":{"name":"Xuan Son Nguyen","email":"son@huggingface.co","date":"2026-08-27T09:57:52Z"},"committer":{"name":"Xuan Son Nguyen","email":"son@huggingface.co","date":"2026-08-27T09:57:52Z"},"message":"no more ple_hist (use master version)","tree":{"sha":"89294915d82d711566896bf4b4914e17df0e708c","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/89294915d82d711566896bf4b4914e17df0e708c"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/5eeb97d1e48a8467aadb6312d1ba83a0c1728a5f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/5eeb97d1e48a8467aadb6312d1ba83a0c1728a5f","html_url":"https://github.com/ggml-org/llama.cpp/commit/5eeb97d1e48a8467aadb6312d1ba83a0c1728a5f","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/5eeb97d1e48a8467aadb6312d1ba83a0c1728a5f/comments","author":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https://api.github.com/users/ngxson/orgs","repos_url":"https://api.github.com/users/ngxson/repos","events_url":"https://api.github.com/users/ngxson/events{/privacy}","received_events_url":"https://api.github.com/users/ngxson/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https://api.github.com/users/ngxson/orgs","repos_url":"https://api.github.com/users/ngxson/repos","events_url":"https://api.github.com/users/ngxson/events{/privacy}","received_events_url":"https://api.github.com/users/ngxson/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23","html_url":"https://github.com/ggml-org/llama.cpp/commit/b5b5fc30b3ac2595fcc1a082bbec2974fa5aaf23"}]},{"sha":"1caf6c5711ee3204b223f2e6197b8336eb6ef331","node_id":"C_kwDOMU0YaNoAKDFjYWY2YzU3MTFlZTMyMDRiMjIzZjJlNjE5N2I4MzM2ZWI2ZWYzMzE","commit":{"author":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T06:16:54Z"},"committer":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T10:01:47Z"},"message":"llama: give the qwen4exp full memory context its indexer cache\n\ngraph_reserve() walks a full memory context, and qwen4exp builds its\nsparse attention only when the context exposes an indexer cache. the\nfull-context constructor left ctx_idx null, so the reserved worst case\nwas the dense fallback: a smaller graph than the one decode executes.\nggml-alloc then had to grow the compute buffer on the first decode,\npast the size reported at load.\n\nwith -np 4 -c 32768 -fa on -ctk q8_0 -ctv q8_0 on an IQ1_S qwen4exp,\nthe reserved CUDA0 buffer was 217.00 MiB against 275.71 MiB actually\nused, and CUDA_Host 42.31 MiB against 191.14 MiB. reserving the sparse\ngraph makes both match exactly, in unified and non-unified cache mode.\n\nCo-authored-by: Pascal <admin@serveurperso.com>\nAssisted-by: Claude","tree":{"sha":"acc02a7bd2ffbc7b40e1e0cd7cfd8f503d83d45f","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/acc02a7bd2ffbc7b40e1e0cd7cfd8f503d83d45f"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/1caf6c5711ee3204b223f2e6197b8336eb6ef331","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/1caf6c5711ee3204b223f2e6197b8336eb6ef331","html_url":"https://github.com/ggml-org/llama.cpp/commit/1caf6c5711ee3204b223f2e6197b8336eb6ef331","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/1caf6c5711ee3204b223f2e6197b8336eb6ef331/comments","author":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bf5396021efd91b2a2253aa620a270e87d8955b5","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/bf5396021efd91b2a2253aa620a270e87d8955b5","html_url":"https://github.com/ggml-org/llama.cpp/commit/bf5396021efd91b2a2253aa620a270e87d8955b5"}]},{"sha":"c3259772c711c98da4144bdd1e0fd70f303639ae","node_id":"C_kwDOMU0YaNoAKGMzMjU5NzcyYzcxMWM5OGRhNDE0NGJkZDFlMGZkNzBmMzAzNjM5YWU","commit":{"author":{"name":"danielhanchen","email":"danielhanchen@users.noreply.github.com","date":"2026-08-27T07:32:16Z"},"committer":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T10:01:47Z"},"message":"qwen4exp: shrink the PLE hparams storage\n\nllama_hparams is held by value inside llm_graph_params and every llm_graph_input_*,\nand llm_graph_params is a stack local in graph_reserve and process_ubatch, so its\nwidth is paid on every worker thread stack.\n\nis_ple_impl spent 2048 bytes carrying 512 bits. It is the one per-layer flag that is\nnot moved through the loader's uint32 array templates, so a bitset costs nothing in\ncall sites and also removes the uninitialized read that non-qwen4exp archs had, since\nnothing filled the array for them.\n\nThe PLE head offsets and vocab sizes are token-space indices; the gather that consumes\nthem already truncates to int32, so 64-bit storage was never reachable. The gguf arrays\nstay uint64 for file compatibility and are narrowed on load.\n\nsizeof(llama_hparams) 34440 -> 31944, sizeof(llm_graph_params) 34872 -> 32376.","tree":{"sha":"d97ec3404c1f95a42224234e95be74eb3e512e9d","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/d97ec3404c1f95a42224234e95be74eb3e512e9d"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/c3259772c711c98da4144bdd1e0fd70f303639ae","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/c3259772c711c98da4144bdd1e0fd70f303639ae","html_url":"https://github.com/ggml-org/llama.cpp/commit/c3259772c711c98da4144bdd1e0fd70f303639ae","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/c3259772c711c98da4144bdd1e0fd70f303639ae/comments","author":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1caf6c5711ee3204b223f2e6197b8336eb6ef331","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/1caf6c5711ee3204b223f2e6197b8336eb6ef331","html_url":"https://github.com/ggml-org/llama.cpp/commit/1caf6c5711ee3204b223f2e6197b8336eb6ef331"}]},{"sha":"95da4ba86065dda8659981a508dfb52d8c3f1032","node_id":"C_kwDOMU0YaNoAKDk1ZGE0YmE4NjA2NWRkYTg2NTk5ODFhNTA4ZGZiNTJkOGMzZjEwMzI","commit":{"author":{"name":"danielhanchen","email":"unslothshared@gmail.com","date":"2026-08-27T04:20:48Z"},"committer":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T10:01:47Z"},"message":"llama: opt-in random-access mmap advice for host-resident gather tables\n\nqwen4exp keeps per_layer_token_embd on the host: 26.8 GiB at IQ4_NL, read\nby ggml_get_rows as 16 gathers of ~90-170 bytes per token, spread across\n16 head regions ~20M rows apart. Measured over 4.75M gathers, no two\nconsecutive gathers land on the same 4 KiB page, so the readahead the\nloader asks for buys nothing here and the whole table ends up cached to\nserve about 4% of itself.\n\nllama_mmap applies POSIX_FADV_SEQUENTIAL, MAP_POPULATE and a whole-file\nPOSIX_MADV_WILLNEED unconditionally. Those are right for streaming the\nfile once into buffers and wrong for whatever stays mapped afterwards.\n\nUnder LLAMA_MMAP_RANDOM the eager pull-in is skipped and the mapping is\nadvised random once every tensor has been read, so the load itself keeps\nits sequential readahead. That alone drops the table to 4.4% resident but\nserializes one NVMe latency per gather.\n\nThe second half is what pays for it: the PLE input already computes every\nrow index for the ubatch before the graph runs, so the pages those rows\nfall on are handed to the kernel in one batch and the reads overlap.\nPOSIX_MADV_WILLNEED on POSIX, PrefetchVirtualMemory on Windows, which\ntakes the discontiguous ranges in a single call.\n\nOff by default and off for every other model: the batched prefetch keys\noff \"this mapping was advised random\", which nothing sets unless the user\nopts in.\n\n  -c 512 --chunks 60, cold, IQ1_S, mean of 3:\n\n    default            35.3 s   26.82 GiB resident (100%)\n    advice only       104.5 s    1.19 GiB resident (4.4%)\n    advice + prefetch  34.2 s    1.19 GiB resident (4.4%)\n\n  PPL 4.2346 +/- 0.07862 in all three. IQ1_S KLD is unchanged in every\n  field, including Mean KLD 0.396070 +/- 0.001931 and Same top p 77.325%.","tree":{"sha":"a9de003c9445bd63503ccbafd8f2a5176134d8b0","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/a9de003c9445bd63503ccbafd8f2a5176134d8b0"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/95da4ba86065dda8659981a508dfb52d8c3f1032","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/95da4ba86065dda8659981a508dfb52d8c3f1032","html_url":"https://github.com/ggml-org/llama.cpp/commit/95da4ba86065dda8659981a508dfb52d8c3f1032","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/95da4ba86065dda8659981a508dfb52d8c3f1032/comments","author":null,"committer":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c3259772c711c98da4144bdd1e0fd70f303639ae","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/c3259772c711c98da4144bdd1e0fd70f303639ae","html_url":"https://github.com/ggml-org/llama.cpp/commit/c3259772c711c98da4144bdd1e0fd70f303639ae"}]},{"sha":"58325573c9c553d97d30a06b291b7b49bef7b3d4","node_id":"C_kwDOMU0YaNoAKDU4MzI1NTczYzljNTUzZDk3ZDMwYTA2YjI5MWI3YjQ5YmVmN2IzZDQ","commit":{"author":{"name":"danielhanchen","email":"unslothshared@gmail.com","date":"2026-08-27T06:06:07Z"},"committer":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T10:01:47Z"},"message":"llama: narrow the random-access mmap advice to the gather table\n\nThe advice was applied per mapping: every mapping the model kept got\nPOSIX_MADV_RANDOM plus a whole-file POSIX_FADV_RANDOM, and the eager\npull-in was skipped for every file. On qwen4exp that also hit\ntoken_embd.weight, which sits 0.33 GiB past the PLE table in the same\nshard and is read densely, not by sparse gathers. Measured over\n-c 512 --chunks 60 on IQ1_S it fell to 8.45% resident, against 100% with\nthe feature off.\n\nA model now nominates its gather tables (qwen4exp: per_layer_tok_embd)\nand only those byte ranges are advised. The range is rounded out to\nwhole pages, which on this model takes in 832 bytes before and 192\nafter. token_embd goes back to 86.55% resident and the PLE table still\ndrops to 4.44%; smaps shows one VM_RAND_READ VMA of exactly the table\ninstead of one over all 27.16 GiB that stays mapped.\n\nposix_fadvise is dropped from the narrowed path. POSIX_FADV_RANDOM\nignores its offset and length and marks the whole open file, and the\nFMODE_RANDOM it sets is only read by page_cache_sync_ra() on the read()\npath, which a fault on a MADV_RANDOM vma never reaches. POSIX_FADV_\nDONTNEED does take a range, so the drop mode keeps it.\n\nThe eager pull-in is now skipped only for the files holding a nominated\ntable, and re-issued as WILLNEED over the rest of such a file, so other\nshards load exactly as before.\n\nprefetch_rows() keys off the tensor being nominated rather than off a\nmapping-level flag, so the batched readahead lands only where the advice\ndid.\n\n  -c 512 --chunks 60, cold, IQ1_S, mean of 3, total wall:\n\n    default              32.50 s\n    whole mapping        30.05 s\n    narrowed             30.35 s\n\n  PPL 4.2061 in all three. IQ1_S KLD is bit-identical with the feature on\n  and off, including Mean KLD 0.396070 +/- 0.001931 and Same top p\n  77.325%. tg128 73.65 +/- 0.33 narrowed against 73.49 +/- 0.34 whole.\n\nAssisted-by: Claude","tree":{"sha":"5bbd812ffa307d27a21035a96d168d62f4a64f78","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/5bbd812ffa307d27a21035a96d168d62f4a64f78"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/58325573c9c553d97d30a06b291b7b49bef7b3d4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/58325573c9c553d97d30a06b291b7b49bef7b3d4","html_url":"https://github.com/ggml-org/llama.cpp/commit/58325573c9c553d97d30a06b291b7b49bef7b3d4","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/58325573c9c553d97d30a06b291b7b49bef7b3d4/comments","author":null,"committer":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"95da4ba86065dda8659981a508dfb52d8c3f1032","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/95da4ba86065dda8659981a508dfb52d8c3f1032","html_url":"https://github.com/ggml-org/llama.cpp/commit/95da4ba86065dda8659981a508dfb52d8c3f1032"}]},{"sha":"b8bdf73bb9baf044caadd33be2a51be70156ec57","node_id":"C_kwDOMU0YaNoAKGI4YmRmNzNiYjliYWYwNDRjYWFkZDMzYmUyYTUxYmU3MDE1NmVjNTc","commit":{"author":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T09:07:02Z"},"committer":{"name":"Daniel Han","email":"danielhanchen@gmail.com","date":"2026-08-27T10:01:47Z"},"message":"llama: fold the random-access prefetch into its own feature flag\n\nLLAMA_MMAP_RANDOM_PREFETCH existed to measure the two halves of the feature\napart, and the measurement is done: on a cold cache over the same wikitext\nrun, MADV_RANDOM without the batched readahead takes 94.4 s against 36.7 s\nfor an untouched mapping, while the pair together take 34.1 s. Suppressing\nthe kernel's readahead only pays if we replace it, so the split let a user\nselect a 2.6x regression through a documented switch.\n\nKeep the accessor, since the call site reads better than a mode comparison,\nbut derive it from the mode alone.","tree":{"sha":"56f4d9a8355022d617661117f6b69bb0b2edf3e4","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/56f4d9a8355022d617661117f6b69bb0b2edf3e4"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/b8bdf73bb9baf044caadd33be2a51be70156ec57","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/b8bdf73bb9baf044caadd33be2a51be70156ec57","html_url":"https://github.com/ggml-org/llama.cpp/commit/b8bdf73bb9baf044caadd33be2a51be70156ec57","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/b8bdf73bb9baf044caadd33be2a51be70156ec57/comments","author":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielhanchen","id":23090290,"node_id":"MDQ6VXNlcjIzMDkwMjkw","avatar_url":"https://avatars.githubusercontent.com/u/23090290?v=4","gravatar_id":"","url":"https://api.github.com/users/danielhanchen","html_url":"https://github.com/danielhanchen","followers_url":"https://api.github.com/users/danielhanchen/followers","following_url":"https://api.github.com/users/danielhanchen/following{/other_user}","gists_url":"https://api.github.com/users/danielhanchen/gists{/gist_id}","starred_url":"https://api.github.com/users/danielhanchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielhanchen/subscriptions","organizations_url":"https://api.github.com/users/danielhanchen/orgs","repos_url":"https://api.github.com/users/danielhanchen/repos","events_url":"https://api.github.com/users/danielhanchen/events{/privacy}","received_events_url":"https://api.github.com/users/danielhanchen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"58325573c9c553d97d30a06b291b7b49bef7b3d4","url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/58325573c9c553d97d30a06b291b7b49bef7b3d4","html_url":"https://github.com/ggml-org/llama.cpp/commit/58325573c9c553d97d30a06b291b7b49bef7b3d4"}]},{"sha":"69a1269f705c8f92e3e7f4f6417c5235259c072a","node_id":"C_kwDOMU0YaNoAKDY5YTEyNjlmNzA1YzhmOTJlM2U3ZjRmNjQxN2M1MjM1MjU5YzA3MmE","commit":{"author":{"name":"Xuan Son Nguyen","email":"son@huggingface.co","date":"2026-08-27T10:13:47Z"},"committer":{"name":"Xuan Son Nguyen","email":"son@huggingface.co","date":"2026-08-27T10:13:47Z"},"message":"Merge commit 'refs/pull/27742/head' of github.com:ggerganov/llama.cpp into qwen4exp/qwen3.8-flash-next","tree":{"sha":"fbf148dbc33f70b339eb1aae0d21321a69e15223","url":"https://api.github.com/repos/ggml-org/llama.cpp/git/trees/fbf148dbc33f70b339eb1aae0d21321a69e15223"},"url":"https://api.github.com/repos/ggml-org/llama.cpp/git/commits/69a1269f705c8f92e3e7f4f6417c5235259c072a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/69a1269f705c8f92e3e7f4f6417c5235259c072a","html_url":"https://github.com/ggml-org/llama.cpp/commit/69a1269f705c8f92e3e7f4f6417c5235259c072a","comments_url":"https://api.github.com/repos/ggml-org/llama.cpp/commits/69a1269f705c8f92e3e7f4f6417c5235259c072a/comments","author":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https://api.github.com/users/ngxson/orgs","repos_url":"https://api.github.com/users/ngxson/repos","events_url":"https://api.github.com/users/ngxson/events{/privacy}","received_events_url":"https://api.github.com/users/ngxson/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ngxson","id":7702203,"node_id":"MDQ6VXNlcjc3MDIyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/7702203?v=4","gravatar_id":"","url":"https://api.github.com/users/ngxson","html_url":"https://github.com/ngxson","followers_url":"https://api.github.com/users/ngxson/followers","following_url":"https://api.github.com/users/ngxson/following{/other_user}","gists_url":"https://api.github.com/users/ngxson/gists{/gist_id}","starred_url":"https://api.github.com/users/ngxson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngxson/subscriptions","organizations_url":"https