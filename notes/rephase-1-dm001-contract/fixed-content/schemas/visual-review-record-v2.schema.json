{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/visual-review-record-v2.schema.json",
  "title": "Survey Production Core v2 Visual Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "status", "publication_preview_approval_path", "publication_preview_approval_sha256", "pdf_path", "pdf_sha256", "page_count", "checks", "review_tool", "recorded_at"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "status": {"const": "PASSED"},
    "publication_preview_approval_path": {"type": "string", "minLength": 1},
    "publication_preview_approval_sha256": {"$ref": "#/$defs/sha256"},
    "pdf_path": {"type": "string", "minLength": 1},
    "pdf_sha256": {"$ref": "#/$defs/sha256"},
    "page_count": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "status", "detail"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_tool": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
