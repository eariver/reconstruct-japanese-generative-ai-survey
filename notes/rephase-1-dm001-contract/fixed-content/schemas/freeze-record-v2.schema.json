{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/freeze-record-v2.schema.json",
  "title": "Survey Production Core v2 Freeze Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "status", "publication_candidate_path", "publication_candidate_sha256", "publication_preview_approval_path", "publication_preview_approval_sha256", "visual_review_path", "visual_review_sha256", "source_path", "source_sha256", "pdf_path", "pdf_sha256", "page_count", "frozen_at"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "status": {"const": "FROZEN"},
    "publication_candidate_path": {"type": "string", "minLength": 1},
    "publication_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "publication_preview_approval_path": {"type": "string", "minLength": 1},
    "publication_preview_approval_sha256": {"$ref": "#/$defs/sha256"},
    "visual_review_path": {"type": "string", "minLength": 1},
    "visual_review_sha256": {"$ref": "#/$defs/sha256"},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "pdf_path": {"type": "string", "minLength": 1},
    "pdf_sha256": {"$ref": "#/$defs/sha256"},
    "page_count": {"type": "integer", "minimum": 1},
    "frozen_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
