{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/publication-review-record-v2.schema.json",
  "title": "Survey Production Core v2 Publication Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "research_profile",
    "publication_profile",
    "review_kind",
    "status",
    "production_profile",
    "reader_manuscript",
    "source",
    "pdf",
    "page_count",
    "checks",
    "reviewed_by",
    "recorded_at",
    "review_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
    "review_kind": {"enum": ["SEMANTIC_EDITORIAL", "VISUAL"]},
    "status": {"const": "PASSED"},
    "production_profile": {"$ref": "#/$defs/artifact"},
    "reader_manuscript": {"$ref": "#/$defs/artifact"},
    "source": {"$ref": "#/$defs/sizedArtifact"},
    "pdf": {"$ref": "#/$defs/sizedArtifact"},
    "page_count": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "detail", "evidence_locations"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "detail": {"type": "string", "minLength": 1},
          "evidence_locations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "reviewed_by": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sizedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
