@@ -0,0 +1,534 @@
+"""Increment A: exact stage-selected Reader Manuscript admission.
+
+All publication, editorial, visual, and Human authority records in this module
+are synthetic fixtures.  The tests use the real loaders, stage validator, Git
+repository, and publication revalidation path; they are not publication or
+approval evidence.
+"""
+from __future__ import annotations
+
+import importlib.util
+import tempfile
+import unittest
+from datetime import timedelta
+from pathlib import Path
+
+from scripts import survey_agent_control_v2 as agent
+from scripts import survey_production_v2 as core
+from scripts import survey_publication_v2 as publication
+from scripts import survey_reader_publication_v2 as reader
+from scripts import survey_reader_surface_gate_v2 as surface_gate
+from scripts import survey_stage_validation_v2 as stage_validation
+
+
+ROOT = Path(".").resolve()
+_FIXTURE_SPEC = importlib.util.spec_from_file_location(
+    "exact_manuscript_revalidation_fixture",
+    ROOT / "tests/test_survey_publication_revalidation_v2.py",
+)
+assert _FIXTURE_SPEC is not None and _FIXTURE_SPEC.loader is not None
+_FIXTURE_MODULE = importlib.util.module_from_spec(_FIXTURE_SPEC)
+_FIXTURE_SPEC.loader.exec_module(_FIXTURE_MODULE)
+Fixture = _FIXTURE_MODULE.Fixture
+ISSUE = _FIXTURE_MODULE.ISSUE
+T0 = _FIXTURE_MODULE.T0
+EXECUTOR = "synthetic-exact-manuscript-fixture"
+
+
+class ExactManuscriptAdmissionV2Tests(unittest.TestCase):
+    """Real-validator coverage for the bounded Increment A authority change."""
+
+    def setUp(self) -> None:
+        self.root = ROOT
+        self.cfg = core.load_json(self.root / core.DEFAULT_CONFIG)
+
+    def make_fixture(self) -> Fixture:
+        temp = tempfile.TemporaryDirectory(dir=str(self.root))
+        self.addCleanup(temp.cleanup)
+        return Fixture(self.root, Path(temp.name))
+
+    @staticmethod
+    def publication_paths(fix: Fixture) -> dict[str, Path]:
+        pub = fix.src / "publication/v2"
+        return {
+            "reader-manuscript": pub / "reader-manuscript-v2.json",
+            "validated-source": fix.survey / "main.tex",
+            "publication-pdf": fix.survey / "main.pdf",
+            "quality-regression-bundle": pub / "quality-regression-bundle-v2.json",
+            "semantic-review": pub / "semantic-editorial-review-v2.json",
+            "visual-review": pub / "visual-review-v2.json",
+            "reader-surface-gate": pub / "reader-surface-gate-v2.json",
+        }
+
+    def make_draft_complete(self, fix: Fixture) -> None:
+        state_path = fix.src / "production-state.json"
+        state = core.load_json(state_path)
+        state["lifecycle_state"] = "DRAFT_COMPLETE"
+        state["history"] = state["history"][: core.LIFECYCLE.index("DRAFT_COMPLETE") + 1]
+        completed = agent._expected_completed_checkpoints(self.cfg, "DRAFT_COMPLETE")
+        for name in core.CHECKPOINTS:
+            if name not in completed:
+                state["machine_checkpoints"][name] = "pending"
+                state["checkpoint_provenance"][name] = None
+        state.pop("publication_revalidation_provenance", None)
+        core.write_json(state_path, core.refresh_state_control(state, self.cfg))
+        self.assertEqual(agent.validate_agent_state(self.root, self.cfg, core.load_json(state_path)), [])
+
+    def build_alternate_manuscript(self, fix: Fixture, *, different_primary: bool = False) -> dict[str, Path]:
+        pub = fix.src / "publication/v2"
+        source = fix.survey / "main.tex"
+        manifest = pub / "reader-manuscript-alternate-v2.json"
+        semantic = pub / "semantic-editorial-review-alternate-v2.json"
+        visual = pub / "visual-review-alternate-v2.json"
+        original_semantic = core.load_json(pub / "semantic-editorial-review-v2.json")
+        original_visual = core.load_json(pub / "visual-review-v2.json")
+        reader.build_manuscript_manifest(
+            self.root,
+            ISSUE,
+            fix.src / "production-profile.json",
+            fix.src / "architecture-v2.json",
+            fix.src / "gates/architecture-approval.json",
+            source,
+            [{"role": "SUPPORTING_SOURCE", "path": fix.survey / "references.bib"}],
+            [
+                {
+                    "package_id": "pkg-001",
+                    "requirement": "subject identity",
+                    "status": "FULFILLED",
+                    "reader_locations": ["main.tex"],
+                    "detail": "synthetic alternate manuscript coverage",
+                }
+            ],
+            [
+                {
+                    "requirement_id": "FINAL_SYNTHESIS",
+                    "status": "FULFILLED",
+                    "reader_locations": ["main.tex"],
+                    "detail": "synthetic alternate final synthesis",
+                },
+                {
+                    "requirement_id": "WEEKLY_COMMUNITY_MOVEMENT",
+                    "status": "FULFILLED",
+                    "reader_locations": ["main.tex"],
+                    "detail": "synthetic alternate weekly movement",
+                },
+            ],
+            EXECUTOR,
+            T0 + timedelta(minutes=1),
+            manifest,
+        )
+        reader.build_review_record(
+            self.root,
+            manifest,
+            fix.survey / "main.pdf",
+            1,
+            "SEMANTIC_EDITORIAL",
+            original_semantic["checks"],
+            EXECUTOR,
+            T0 + timedelta(minutes=2),
+            semantic,
+        )
+        reader.build_review_record(
+            self.root,
+            manifest,
+            fix.survey / "main.pdf",
+            1,
+            "VISUAL",
+            original_visual["checks"],
+            EXECUTOR,
+            T0 + timedelta(minutes=3),
+            visual,
+        )
+        if different_primary:
+            source = fix.survey / "alternate-main.tex"
+            source.write_text(
+                "%% alternate schema-valid primary\n\\documentclass{article}\\begin{document}alternate\\end{document}\n",
+                encoding="utf-8",
+            )
+            manifest_doc = core.load_json(manifest)
+            manifest_doc["primary_source"] = {
+                "path": source.relative_to(self.root).as_posix(),
+                "sha256": core.sha256_file(source),
+                "byte_count": source.stat().st_size,
+            }
+            manifest_doc["manifest_sha256"] = core.sha256_object(
+                {key: value for key, value in manifest_doc.items() if key != "manifest_sha256"}
+            )
+            core.write_json(manifest, manifest_doc)
+        return {"manifest": manifest, "source": source, "semantic": semantic, "visual": visual}
+
+    def build_candidate(self, fix: Fixture, selected: dict[str, Path] | None = None) -> Path:
+        paths = self.publication_paths(fix)
+        chosen = selected or {
+            "manifest": paths["reader-manuscript"],
+            "source": paths["validated-source"],
+            "semantic": paths["semantic-review"],
+            "visual": paths["visual-review"],
+        }
+        candidate = fix.src / "publication/v2/publication-candidate-increment-a.json"
+        publication.build_candidate(
+            self.root,
+            ISSUE,
+            "WEEKLY_MAGAZINE",
+            chosen["manifest"],
+            chosen["source"],
+            paths["publication-pdf"],
+            1,
+            paths["quality-regression-bundle"],
+            chosen["semantic"],
+            chosen["visual"],
+            candidate,
+        )
+        return candidate
+
+    def validate_draft(self, fix: Fixture, artifacts: dict[str, Path], suffix: str) -> Path:
+        output = fix.src / f"execution/increment-a-draft-{suffix}.json"
+        return stage_validation.validate_stage(
+            self.root,
+            self.cfg,
+            fix.src / "production-state.json",
+            artifacts,
+            output,
+            T0 + timedelta(hours=1),
+        )
+
+    def rebind_validation_checkpoint(self, fix: Fixture, selected: dict[str, Path]) -> None:
+        """Create a synthetic historical checkpoint whose Gate selected another manifest.
+
+        This models the defect shape accepted by the parent implementation.  It
+        updates immutable fixture records before the test begins; production
+        code still performs every State/checkpoint/stage validation.
+        """
+        checkpoint_path = fix.src / "orchestration/v2/checkpoints/DRAFT_COMPLETE.json"
+        checkpoint = core.load_json(checkpoint_path)
+        replacements = {
+            "reader-manuscript": selected["manifest"],
+            "semantic-review": selected["semantic"],
+            "visual-review": selected["visual"],
+        }
+        for row in checkpoint["artifacts"]:
+            replacement = replacements.get(row["name"])
+            if replacement is not None:
+                row["path"] = replacement.relative_to(self.root).as_posix()
+                row["sha256"] = core.sha256_file(replacement)
+        core_review = next(
+            row for row in checkpoint["reviews"] if row["check_id"] == agent.CORE_STAGE_REVIEW_ID
+        )
+        report_path = self.root / core_review["result"]["path"]
+        report = core.load_json(report_path)
+        report["artifacts"] = checkpoint["artifacts"]
+        core.write_json(report_path, report)
+        core_review["result"]["sha256"] = core.sha256_file(report_path)
+        core.write_json(checkpoint_path, checkpoint)
+        state_path = fix.src / "production-state.json"
+        state = core.load_json(state_path)
+        state["checkpoint_provenance"]["validation"]["sha256"] = core.sha256_file(checkpoint_path)
+        core.write_json(state_path, state)
+        self.assertEqual(agent.validate_agent_state(self.root, self.cfg, core.load_json(state_path)), [])
+
+    @staticmethod
+    def refresh_gate_digest(gate: dict) -> None:
+        fields = (
+            "schema_version",
+            "issue_id",
+            "publication_profile",
+            "status",
+            "scanned_surfaces",
+            "rules_checked",
+            "suppressions",
+            "findings",
+            "summary",
+            "evaluated_by",
+            "recorded_at",
+            "semantic_authority",
+        )
+        gate["gate_sha256"] = core.sha256_object({key: gate[key] for key in fields})
+
+    def test_draft_complete_exact_selected_manuscript_passes(self) -> None:
+        fix = self.make_fixture()
+        self.make_draft_complete(fix)
+        report = self.validate_draft(fix, self.publication_paths(fix), "positive")
+        self.assertEqual(core.load_json(report)["status"], "PASS")
+
+    def test_draft_complete_rejects_valid_same_identity_alternate_manuscript(self) -> None:
+        fix = self.make_fixture()
+        self.make_draft_complete(fix)
+        alternate = self.build_alternate_manuscript(fix)
+        artifacts = self.publication_paths(fix)
+        artifacts["reader-manuscript"] = alternate["manifest"]
+        artifacts["semantic-review"] = alternate["semantic"]
+        artifacts["visual-review"] = alternate["visual"]
+        with self.assertRaisesRegex(
+            stage_validation.StageValidationError,
+            "MANUSCRIPT_MANIFEST does not bind the exact expected Reader Manuscript",
+        ):
+            self.validate_draft(fix, artifacts, "wrong-manuscript")
+
+    def test_validated_draft_exact_selected_manuscript_passes(self) -> None:
+        fix = self.make_fixture()
+        candidate = self.build_candidate(fix)
+        output = fix.src / "execution/increment-a-candidate-positive.json"
+        report = stage_validation.validate_stage(
+            self.root,
+            self.cfg,
+            fix.src / "production-state.json",
+            {"publication-candidate": candidate},
+            output,
+            T0 + timedelta(hours=1),
+        )
+        self.assertEqual(core.load_json(report)["status"], "PASS")
+
+    def test_validated_draft_rejects_valid_same_identity_alternate_manuscript(self) -> None:
+        fix = self.make_fixture()
+        alternate = self.build_alternate_manuscript(fix)
+        self.rebind_validation_checkpoint(fix, alternate)
+        candidate = self.build_candidate(fix, alternate)
+        with self.assertRaisesRegex(
+            stage_validation.StageValidationError,
+            "MANUSCRIPT_MANIFEST does not bind the exact expected Reader Manuscript",
+        ):
+            stage_validation.validate_stage(
+                self.root,
+                self.cfg,
+                fix.src / "production-state.json",
+                {"publication-candidate": candidate},
+                fix.src / "execution/increment-a-candidate-wrong-manuscript.json",
+                T0 + timedelta(hours=1),
+            )
+
+    def test_gate_requires_unique_manifest_and_primary_surfaces(self) -> None:
+        for case in (
+            "missing-manifest",
+            "missing-primary",
+            "duplicate-manifest",
+            "duplicate-primary",
+            "conflicting-manifest",
+            "conflicting-primary",
+        ):
+            with self.subTest(case=case):
+                fix = self.make_fixture()
+                gate_path = self.publication_paths(fix)["reader-surface-gate"]
+                gate = core.load_json(gate_path)
+                if case == "missing-manifest":
+                    gate["scanned_surfaces"] = [
+                        row for row in gate["scanned_surfaces"] if row["kind"] != "MANUSCRIPT_MANIFEST"
+                    ]
+                elif case == "missing-primary":
+                    gate["scanned_surfaces"] = [
+                        row for row in gate["scanned_surfaces"] if row["kind"] != "PRIMARY_SOURCE"
+                    ]
+                elif case == "duplicate-manifest":
+                    manifest = next(
+                        row for row in gate["scanned_surfaces"] if row["kind"] == "MANUSCRIPT_MANIFEST"
+                    )
+                    gate["scanned_surfaces"].append(dict(manifest))
+                elif case == "duplicate-primary":
+                    primary = next(
+                        row for row in gate["scanned_surfaces"] if row["kind"] == "PRIMARY_SOURCE"
+                    )
+                    gate["scanned_surfaces"].append(dict(primary))
+                elif case == "conflicting-manifest":
+                    alternate = self.build_alternate_manuscript(fix)
+                    gate["scanned_surfaces"].append(
+                        {
+                            "path": alternate["manifest"].relative_to(self.root).as_posix(),
+                            "sha256": core.sha256_file(alternate["manifest"]),
+                            "kind": "MANUSCRIPT_MANIFEST",
+                            "byte_count": alternate["manifest"].stat().st_size,
+                        }
+                    )
+                else:
+                    conflicting = fix.survey / "conflicting-primary.tex"
+                    conflicting.write_text("synthetic conflicting primary\n", encoding="utf-8")
+                    gate["scanned_surfaces"].append(
+                        {
+                            "path": conflicting.relative_to(self.root).as_posix(),
+                            "sha256": core.sha256_file(conflicting),
+                            "kind": "PRIMARY_SOURCE",
+                            "byte_count": conflicting.stat().st_size,
+                        }
+                    )
+                self.refresh_gate_digest(gate)
+                core.write_json(gate_path, gate)
+                with self.assertRaisesRegex(ValueError, "exactly one"):
+                    surface_gate.validate_reader_surface_gate(self.root, gate_path)
+
+    def test_gate_rejects_swapped_primary_from_exact_manifest(self) -> None:
