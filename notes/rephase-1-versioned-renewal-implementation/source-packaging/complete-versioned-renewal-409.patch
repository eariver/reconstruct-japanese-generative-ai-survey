+_SCOPE_SCHEMA = "schemas/reader-surface-semantic-review-v2.schema.json"
+_SCOPE_VERSION = "EDITORIAL_CORRECTION_SCOPE_V1"
+_SCOPE_CHECK_ID = "EDITORIAL_CORRECTION_SCOPE"
