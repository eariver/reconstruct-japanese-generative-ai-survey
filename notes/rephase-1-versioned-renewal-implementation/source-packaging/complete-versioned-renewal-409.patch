+                _sel_check = _versioned_active_selection(root, json.loads(col.files[col.rel(col.safe(core.DEFAULT_CONFIG.as_posix(), 'config'))].decode("utf-8")) if core.DEFAULT_CONFIG.as_posix() in col.files else {}, _st_for_check)
