+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo-root", default=".")
+    parser.add_argument("--config", default=str(core.DEFAULT_CONFIG))
+    sub = parser.add_subparsers(dest="command", required=True)
+
