+def _no_duplicate_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    obj: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in obj:
+            raise RenewalHistoryError("HISTORY_DIGEST_MISMATCH", f"duplicate JSON key refused: {key!r}")
+        obj[key] = value
