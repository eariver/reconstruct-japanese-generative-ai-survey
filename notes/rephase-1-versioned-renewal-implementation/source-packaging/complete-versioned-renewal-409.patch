+def _write_owned_file(session: Any, staged_fd: int, staged_rel: str, leaf: str,
+                      data: bytes, owned: dict[str, Any], phase: str, disp: str,
+                      dir_identity: tuple[int, int] | None = None) -> None:
+    """Exclusive no-follow create + fstat identity BEFORE any byte is written.
+
+    Attempt is recorded before open; identity once obtained; progress, byte
+    counts, fsync/close/readback state after each step. Durability seam:
+    ``os.fsync`` before close (no crash-atomicity/power-loss claim).
+    Disposition semantics (R3-5, selected, no contradiction): a write failure
+    reports the caller phase/disposition (CLAIM/OWNED_PARTIAL for source files:
+    file bytes definitely incomplete, staged SET incomplete); an fsync/close
+    failure reports INDETERMINATE_INVOCATION even for the first file — the
+    per-file bytes and close state are uncertain (complete valid file bytes
+    may exist) while the staged SET is separately incomplete (manifest/other
+    files missing, proven by FINAL inventory, not by this disposition string).
+    Per-file uncertainty and SET completeness are distinct fields in
+    ``owned["owned_files"]`` vs FINAL inventory; the disposition string alone
+    never claims SET completeness. A close/fsync failure never masks an
+    in-flight write error: the first error stays primary and later close
+    failures attach as secondary.
+    R2-6: held-fd fstat alone cannot prove entry identity (a renamed dir keeps
+    the same fd). Before EACH file creation both the held fd AND the canonical
+    entry (lstat of the staged path plus ancestor alias walk) are compared to
+    the earliest owned identity.
+    R2-7: every secondary close failure is recorded, never silently discarded;
+    failed-close descriptor state is explicit and never blindly retried on a
+    possibly reused fd number.
+    R2-3: ``bytes_written`` advances after every successful chunk so partial
+    progress survives a later failure.
+    R3-2: every canonical ancestor is compared to the ORIGINAL pinned
+    identities (Session root_id/dir_ids) before each create, not just
+    alias/type.
+    """
+    full = staged_rel + "/" + leaf
+    entry: dict[str, Any] = {"path": full, "attempted": True, "dev": "unknown", "ino": "unknown",
+                             "sha256": core.sha256_bytes(data), "byte_count": len(data),
+                             "bytes_written": 0, "fsync": "pending", "close": "pending",
+                             "readback": "pending"}
+    owned["owned_files"].append(entry)
+    if dir_identity is not None:
+        # Held-root check before each write (R2-6, part 1).
+        try:
+            dst = os.fstat(staged_fd)
+        except OSError as exc:
+            entry["error"] = f"held root fstat failed: {exc}"
+            raise _fail("STAGED_ROOT_FSTAT_FAILED", phase, disp,
+                        f"held staged root fstat failed before writing {leaf}: {exc}", owned) from exc
+        if (dst.st_dev, dst.st_ino) != dir_identity:
+            entry["error"] = "held root identity changed"
+            raise _fail("STAGED_ROOT_REPLACED", phase, disp,
+                        f"held staged root replaced before writing {leaf}", owned)
+        # Canonical entry + original-identity check before each write (R2-6/R3-2):
+        # reopen every canonical ancestor and compare to the ORIGINAL pinned
+        # identities (Session root_id/dir_ids, staged dir to earliest owned ID).
+        # A rename-away keeps the held fd unchanged but moves/replaces the
+        # canonical entry, which this detects. Uses lstat only (no extra opens,
+        # no closure masks); pins are read, never mutated.
+        try:
+            root_resolved = session.root_resolved
+            parts = staged_rel.split("/")
+            # Build ancestor rels: "." (root), each prefix, and the staged dir.
+            ancestor_rels: list[str] = ["."]
+            cur_rel = ""
+            for comp in parts:
+                if comp in ("", ".", ".."):
+                    raise OSError(f"unsafe staged component: {comp}")
+                cur_rel = comp if not cur_rel else cur_rel + "/" + comp
+                ancestor_rels.append(cur_rel)
+            for rel in ancestor_rels:
+                full_p = root_resolved if rel == "." else root_resolved / rel
+                try:
+                    lst = os.lstat(full_p)
+                except OSError as exc:
+                    raise OSError(f"canonical ancestor unreadable {rel}: {exc}") from exc
+                if _stat.S_ISLNK(lst.st_mode):
+                    raise OSError(f"canonical ancestor is symlink: {rel}")
+                if rel != staged_rel and not _stat.S_ISDIR(lst.st_mode):
+                    raise OSError(f"canonical ancestor not a dir: {rel}")
+                if rel == ".":
+                    exp = session.root_id
+                    if (lst.st_dev, lst.st_ino, _stat.S_IMODE(lst.st_mode)) != exp:
+                        raise OSError(f"repo-root identity changed: {rel}")
