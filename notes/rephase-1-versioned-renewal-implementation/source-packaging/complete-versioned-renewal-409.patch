+def _require_canonical_current_state(repo: Path, cfg: dict[str, Any], state: dict[str, Any], state_rel: str) -> str:
+    """Require supplied State path to be the canonical current State.
+
+    Derives expected path from validated Profile/config (source_root +
+    authoritative_filename), checks exact equality/no aliases, rejects
+    retained/cloned/history States for current APIs. Historical
+    verify_activation_history stays separate (no State). Inert new set remains
+    valid against actual old current State (no requirement target already active).
+    """
+    profile_ref = state.get("profile")
+    if not isinstance(profile_ref, dict) or set(profile_ref) != {"path", "sha256"}:
+        raise _fail("PROFILE_REF", "VALIDATE", "REFUSED_PRE_WRITE", "State profile ref must be exact {path,sha256}")
+    profile_rel = _lexical_rel(repo, profile_ref["path"], "Production Profile")
+    _safe(repo, profile_rel, "Production Profile")
+    try:
+        profile = _strict_json_from_bytes(_read_bytes_bounded(repo, profile_rel, "Production Profile"), "Production Profile")
+    except EditorialError:
+        raise
+    except Exception as exc:
+        raise _fail("PROFILE_UNREADABLE", "VALIDATE", "REFUSED_PRE_WRITE", f"Profile unreadable: {exc}") from exc
+    try:
+        source_root_rel = profile["paths"]["source_root"]
+    except (KeyError, TypeError) as exc:
+        raise _fail("PROFILE_ROOT", "VALIDATE", "REFUSED_PRE_WRITE", f"Profile source_root invalid: {exc}") from exc
+    if not isinstance(source_root_rel, str) or not source_root_rel or "\\" in source_root_rel or source_root_rel.startswith("/") or ".." in source_root_rel.split("/"):
+        raise _fail("PROFILE_ROOT", "VALIDATE", "REFUSED_PRE_WRITE", f"Profile source_root invalid: {source_root_rel!r}")
+    try:
+        auth_name = cfg["state_authority"]["authoritative_filename"]
+    except (KeyError, TypeError) as exc:
+        raise _fail("CONFIG_AUTHORITY", "VALIDATE", "REFUSED_PRE_WRITE", f"config authoritative_filename invalid: {exc}") from exc
+    if not isinstance(auth_name, str) or not auth_name or "/" in auth_name or "\\" in auth_name or auth_name.startswith("."):
+        raise _fail("CONFIG_AUTHORITY", "VALIDATE", "REFUSED_PRE_WRITE", f"config authoritative_filename invalid: {auth_name!r}")
+    expected_rel = (source_root_rel.rstrip("/") + "/" + auth_name).replace("//", "/")
+    # Exact equality, no aliases; retained/history/copied rejected for current APIs.
+    if state_rel != expected_rel:
+        if "/retained/" in state_rel or "/history/" in state_rel or state_rel != expected_rel:
+            raise _fail(
+                "STATE_NOT_CANONICAL",
+                "VALIDATE",
+                "REFUSED_PRE_WRITE",
+                f"current State must be canonical {expected_rel!r}, got {state_rel!r}; retained/cloned/history refused for current APIs",
+            )
+        raise _fail(
+            "STATE_NOT_CANONICAL",
+            "VALIDATE",
+            "REFUSED_PRE_WRITE",
+            f"current State must be canonical {expected_rel!r}, got {state_rel!r}",
+        )
+    # No-alias: resolved canonical path must equal expected resolved path.
+    try:
+        expected_abs = _safe(repo, expected_rel, "canonical Production State")
+        supplied_abs = _safe(repo, state_rel, "Production State")
+    except EditorialError:
+        raise
+    if expected_abs.resolve() != supplied_abs.resolve():
+        raise _fail("STATE_NOT_CANONICAL", "VALIDATE", "REFUSED_PRE_WRITE", f"State alias refused: {state_rel!r} != canonical {expected_rel!r}")
+    return expected_rel
+
+
+def _read_bytes_bounded(repo_root: Path, rel: str, label: str, max_bytes: int = 20 * 1024 * 1024) -> bytes:
+    # Bounded regular-file read with O_NOFOLLOW (no symlink laundering, no FIFO blocking).
+    # Close errors are explicitly classified: success-close failure raises CLOSE_FAILED;
+    # read-failure + close-failure reports primary + secondary (close never masks primary,
+    # never suppressed). Observed old/new/unknown preserved by callers; no record delete.
+    resolved = _check_file(repo_root, rel, label)
+    if resolved.stat().st_size > max_bytes:
+        raise _fail("SIZE_BOUND", "PIN", "REFUSED_PRE_WRITE", f"{label} exceeds bound: {rel}")
+    fd = None
+    try:
+        fd = os.open(resolved, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+    except OSError as exc:
+        raise _fail("READ_FAILED", "PIN", "REFUSED_PRE_WRITE", f"{label} open failed (symlink/FIFO?): {exc}") from exc
+    primary_exc: BaseException | None = None
+    primary_fail: EditorialError | None = None
+    try:
+        chunks: list[bytes] = []
+        total = 0
+        while True:
+            data = os.read(fd, 65536)
+            if not data:
+                break
+            total += len(data)
+            if total > max_bytes:
+                raise _fail("SIZE_BOUND", "PIN", "REFUSED_PRE_WRITE", f"{label} exceeds bound during read: {rel}")
+            chunks.append(data)
+        result = b"".join(chunks)
+    except EditorialError as exc:
+        primary_exc = exc
+        primary_fail = exc
+        raise
+    except OSError as exc:
+        primary_exc = exc
+        primary_fail = _fail("READ_FAILED", "PIN", "REFUSED_PRE_WRITE", f"{label} read failed: {exc}")
+        raise primary_fail from exc
+    finally:
+        # Explicit close handling: never suppress, never mask primary without report.
+        if fd is not None:
+            try:
+                os.close(fd)
+            except OSError as close_exc:
+                close_fail = _fail("CLOSE_FAILED", "PIN", "REFUSED_PRE_WRITE", f"{label} close failed after read: {close_exc}")
+                if primary_fail is not None:
+                    # Primary + secondary ordered: report both, chain primary.
+                    raise _fail(
+                        "READ_CLOSE_COMBINED",
+                        "PIN",
+                        "REFUSED_PRE_WRITE",
+                        f"{label} primary [{primary_fail.code}/{primary_fail.detail}] + secondary close [{close_exc}]",
+                    ) from primary_exc
+                raise close_fail from close_exc
+    return result
+
+
+def _exclusive_write_bytes(path: Path, data: bytes, label: str) -> tuple[int, int]:
+    # True exclusive writer: O_CREAT|O_EXCL|O_NOFOLLOW, no prior exists-check
+    # trusted, no tmp+rename (which can overwrite a race winner), no unlink
+    # of unknown tmp on errors. Short-write loop, fsync, fd-captured identity
+    # (dev,ino via fstat), seek+readback through same fd, expected-byte
+    # comparison. Preserves owned partial/unknown; reports primary error.
+    # Held-ancestor checks: parent must be safe (no symlink/FIFO).
+    if not isinstance(data, (bytes, bytearray)) or len(data) < 1:
+        raise _fail("EMPTY_PAYLOAD", "WRITE", "REFUSED_PRE_WRITE", f"{label} empty payload refused")
+    parent = path.parent
+    try:
+        parent.mkdir(parents=True, exist_ok=True)
+    except OSError as exc:
+        raise _fail("MKDIR_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} parent mkdir failed: {exc}") from exc
+    # Held-ancestor check on parent (lexical, lstat, no follow).
+    try:
+        if path.is_absolute():
+            # Path is already absolute under repo (from _safe); walk parents.
+            # Use resolved root comparison via parent chain lstat.
+            cur = parent
+            # Walk up to 32 levels to avoid infinite loop; refuse symlink/FIFO.
+            for _ in range(32):
+                try:
+                    st = os.lstat(cur)
+                except FileNotFoundError:
+                    break
+                except OSError as exc:
+                    raise _fail("ANCESTOR_CHECK", "WRITE", "REFUSED_PRE_WRITE", f"{label} ancestor check failed: {exc}") from exc
+                if stat.S_ISLNK(st.st_mode):
+                    raise _fail("SYMLINK_ANCESTOR", "WRITE", "REFUSED_PRE_WRITE", f"{label} symlinked ancestor: {cur}")
+                if stat.S_ISFIFO(st.st_mode) or stat.S_ISSOCK(st.st_mode):
+                    raise _fail("FIFO_ANCESTOR", "WRITE", "REFUSED_PRE_WRITE", f"{label} FIFO ancestor: {cur}")
+                # Stop at filesystem root or when parent equals itself.
+                nxt = cur.parent
+                if nxt == cur:
+                    break
+                cur = nxt
+                # Heuristic stop: if we reached a directory containing .git-like? No, walk fully.
+                if len(str(cur)) < 2:
+                    break
+    except EditorialError:
+        raise
+    except Exception as exc:
+        raise _fail("ANCESTOR_CHECK", "WRITE", "REFUSED_PRE_WRITE", f"{label} ancestor check failed: {exc}") from exc
+    flags = os.O_RDWR | os.O_CREAT | os.O_EXCL
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    if nofollow:
+        flags |= nofollow
+    fd = None
+    try:
+        fd = os.open(path, flags, 0o644)
+    except FileExistsError as exc:
+        raise _fail("TARGET_EXISTS", "WRITE", "REFUSED_PRE_WRITE", f"{label} already exists (no same-byte takeover): {path}") from exc
+    except OSError as exc:
+        raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} exclusive open failed: {exc}") from exc
+    _primary_write_exc: EditorialError | None = None
+    owned_result: tuple[int, int] | None = None
+    try:
+        # Short-write loop.
+        view = memoryview(bytes(data))
+        offset = 0
+        while offset < len(view):
+            try:
+                written = os.write(fd, view[offset:])
+            except OSError as exc:
+                raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} short write failed: {exc}") from exc
+            if written <= 0:
+                raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} short write returned 0")
+            offset += written
+        try:
+            os.fsync(fd)
+        except OSError as exc:
+            raise _fail("FSYNC_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} fsync failed; live bytes preserved for manual recovery: {path}: {exc}") from exc
+        try:
+            fst = os.fstat(fd)
+            owned_id = (fst.st_dev, fst.st_ino)
+        except OSError as exc:
+            raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} identity capture failed: {exc}") from exc
+        # Readback through same fd (lseek + read), never stat-after-close claim.
+        try:
+            os.lseek(fd, 0, os.SEEK_SET)
+        except OSError as exc:
+            raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} lseek failed: {exc}") from exc
+        chunks: list[bytes] = []
+        while True:
+            try:
+                part = os.read(fd, 65536)
+            except OSError as exc:
+                raise _fail("WRITE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} readback failed: {exc}") from exc
+            if not part:
+                break
+            chunks.append(part)
+        actual = b"".join(chunks)
+        if actual != bytes(data):
+            raise _fail("WRITE_MISMATCH", "WRITE", "PRESERVED_INCOMPLETE", f"{label} readback mismatch; live bytes preserved for manual recovery: {path}")
+        owned_result = owned_id
+    except EditorialError as primary:
+        # Preserve owned partial/unknown: never unlink on failure. Stash primary
+        # for combined close handling below (primary + secondary ordered).
+        _primary_write_exc = primary
+        owned_result = None
+        raise
+    finally:
+        # Explicit close: never suppress, never mask primary without report.
+        # Success-close failure raises CLOSE_FAILED (typed, nonzero, preserved bytes).
+        # Write-failure + close-failure reports primary + secondary ordered.
+        if fd is not None:
+            try:
+                os.close(fd)
+            except OSError as close_exc:
+                close_fail = _fail("CLOSE_FAILED", "WRITE", "PRESERVED_INCOMPLETE", f"{label} close failed; live bytes preserved for manual recovery: {path}: {close_exc}")
+                if _primary_write_exc is not None:
+                    raise _fail(
+                        "WRITE_CLOSE_COMBINED",
+                        "WRITE",
+                        "PRESERVED_INCOMPLETE",
+                        f"{label} primary [{_primary_write_exc.code}/{_primary_write_exc.detail}] + secondary close [{close_exc}]; preserved",
+                    ) from _primary_write_exc
+                # No primary (success path) but close failed: surface typed.
+                raise close_fail from close_exc
+    return owned_result  # type: ignore[return-value]
+
+
+def _exclusive_write_json(path: Path, payload: dict[str, Any], label: str) -> tuple[int, int]:
+    # Exclusive JSON writer: canonical bytes, O_EXCL|NOFOLLOW, fd identity,
+    # full-write/fsync/close/readback, final pin (re-read via safe path and
+    # compare SHA). Preserves owned partial/unknown, primary+secondary errors.
+    if not isinstance(payload, dict):
+        raise _fail("PAYLOAD_SHAPE", "WRITE", "REFUSED_PRE_WRITE", f"{label} payload must be object")
+    data = core.json_bytes(payload)
+    owned = _exclusive_write_bytes(path, data, label)
+    # Final pin: re-read via safe containment and compare SHA (not only fd).
+    try:
+        # Derive repo-relative for final pin if path is under a known repo?
+        # Caller ensures path came from _safe; here verify bytes directly.
+        if path.is_symlink() or not path.is_file():
+            raise _fail("FINAL_PIN", "WRITE", "PRESERVED_INCOMPLETE", f"{label} final pin missing: {path}")
+        if path.read_bytes() != data:
+            raise _fail("FINAL_PIN", "WRITE", "PRESERVED_INCOMPLETE", f"{label} final pin mismatch; preserved: {path}")
+    except EditorialError:
+        raise
+    except OSError as exc:
+        raise _fail("FINAL_PIN", "WRITE", "PRESERVED_INCOMPLETE", f"{label} final pin failed: {exc}") from exc
+    return owned
+
+
+def _file_ref(repo_root: Path, path: Path) -> dict[str, Any]:
+    # Final-boundary file_ref: safe path + regular-file + expected bytes at
+    # final boundary (not only before operation). Uses bounded read for SHA.
+    rel = _rel(repo_root, path)
+    resolved = _check_file(repo_root, rel, "file ref")
+    data = _read_bytes_bounded(repo_root, rel, "file ref")
+    return {"path": rel, "sha256": core.sha256_bytes(data), "byte_count": len(data)}
+
