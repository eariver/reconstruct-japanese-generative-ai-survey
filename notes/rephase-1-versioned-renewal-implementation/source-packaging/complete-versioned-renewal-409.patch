+             {"role": "STYLE", "path": str((self.survey_root / "jgaisurvey.sty").relative_to(self.root))}],
+            coverage, requirements, authored_by,
+            core.parse_instant("2026-08-22T05:10:00+09:00"), manuscript_path,
