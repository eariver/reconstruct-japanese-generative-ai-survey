+def _write_new_trio_files(repo: Path, proof: dict[str, Any],
+                           built: dict[str, Any]) -> None:
+    """Exclusive write of new R trio FILES from rendered bytes (C only)."""
+    trio = proof["output_trio_refs"]
+    for key, rendered_key in (("primary", "primary"), ("bibliography", "bibliography"),
+                              ("style", "style")):
