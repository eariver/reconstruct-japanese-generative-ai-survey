+def _pipeline(col: _Collector, root: Path, state_path: Path, new_authored_value: str | Path,
+              proposal_id: str, tree_entry: dict[str, str],
+              change_description: str | None = None) -> dict[str, Any]:
+    # Fixed P1 wrapper: data + required absence + stability/tree checks.
+    # Preserves exact public P1 behavior; no caller-selected policy.
+    data = _pipeline_data(col, root, state_path, new_authored_value,
+                          proposal_id, change_description)
+    _require_retention_dests_absent(col, data["proposal"]["retention_plan"])
+    col.reverify()
+    profile = data["profile"]
+    if _tree_map(root, Path(profile["paths"]["source_root"]),
+                 Path(profile["paths"]["survey_root"])) != tree_entry:
+        raise _fail("TREE_MOVED", "edition tree changed during inspection")
+    # Preserve historical public shape (no profile key) for existing callers.
+    return {k: data[k] for k in ("proposal", "proposed_canonical", "before_canonical",
+                                 "graph", "frozen", "effective", "original_rows",
+                                 "active_record", "route", "before_authored_rel",
+                                 "new_authored_rel", "reader_rel",
+                                 "planned_reader_ref", "proposal_dir")}
