+#!/usr/bin/env python3
+"""HIGH+consumer phase oracles — REAL behavior, fail-closed, no stub PASS.
+
+Static checks (schemas/closures/signatures/refusal shapes) run read-only
+against the containing source root. Live operation checks (prepare/finalize
+refusals, S-blocker propagation, fault handling) run against an explicitly
+supplied fixture root (isolated byte-independent DB with genuine changed-tool
+epoch and retained uncommitted old E authorities). No fixture objects are
+created in reconstruct's database; no saved packet runners are executed; no
+network. Failures/skips are reported, never converted to PASS.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+assert Path(sys.modules.get("__main__", None) and __file__ or __file__).as_posix().startswith(
+    str(ROOT)), "fixture import origin must be the containing source root"
+
+from scripts import survey_versioned_renewal_v2 as high
+
+
+def fixture_root() -> Path | None:
+    raw = os.environ.get("RENEWAL_FIXTURE_ROOT", "")
+    if not raw:
+        return None
+    return Path(raw)
+
+
+class TestHighStaticMap(unittest.TestCase):
+    def test_high_public_api_signatures(self) -> None:
+        import inspect
+        self.assertEqual(list(inspect.signature(high.prepare_renewal).parameters)[:8],
+                         ["root", "state_path", "renewal_id", "intent",
+                          "manuscript_spec_path", "toolchain_spec_path",
+                          "executor", "recorded_at"])
+        self.assertEqual(list(inspect.signature(high.finalize_renewal).parameters)[:8],
+                         ["root", "state_path", "basis_path", "checks_path",
+                          "semantic_review_path", "visual_review_path",
+                          "executor", "recorded_at"])
+        for name in ("validate_renewal_receipt", "validate_prepared_renewal_set",
+                     "activate_renewal", "resume_renewal_activation",
+                     "verify_renewal_history", "verify_renewal_rerender_equality",
+                     "observe_renewal_authority", "prepare_renewal_targets"):
+            self.assertTrue(callable(getattr(high, name)), name)
+
+    def test_high_public_state_validation_preserved(self) -> None:
+        text = (ROOT / "scripts/survey_versioned_renewal_v2.py").read_text()
+        self.assertIn("agent.validate_agent_state", text)
+        # Prohibition sentence required; no actual call site may exist.
+        self.assertIn("NEVER", text)
+        self.assertNotIn("verify_state_basis(", text)
+        self.assertNotIn("import verify_state_basis", text)
+        self.assertIn("_require_renewal_entry_window", text)
+        self.assertIn("authoritative_filename", text)
+
+    def test_high_no_pending_or_synthetic_state(self) -> None:
+        text = (ROOT / "scripts/survey_versioned_renewal_v2.py").read_text()
+        for banned in ("pending_basis", "already_verified"):
+            self.assertNotIn(banned, text)
+        import re
+        self.assertIsNone(re.search(r"synthetic_[Ss]tate\s*=", text))
+        self.assertIsNone(re.search(r"expected_contract\s*[:=]", text))
+        self.assertIsNone(re.search(r"def \w+\(.*expected_contract", text))
+
+    def test_owned_schema_branches_parse(self) -> None:
+        for rel in ("schemas/reader-manuscript-v2.schema.json",
+                    "schemas/publication-candidate-v2.schema.json",
+                    "schemas/quality-regression-bundle-v2.schema.json",
+                    "schemas/reader-surface-gate-v2.schema.json"):
+            doc = json.loads((ROOT / rel).read_text())
+            self.assertFalse(doc.get("additionalProperties", True))
+        man = json.loads((ROOT / "schemas/reader-manuscript-v2.schema.json").read_text())
+        self.assertIn("renewal_source", man["properties"])
+        self.assertIn("allOf", man)
+        cand = json.loads((ROOT / "schemas/publication-candidate-v2.schema.json").read_text())
+        self.assertIn("renewal_source_proof_ref", cand["properties"])
+        bundle = json.loads((ROOT / "schemas/quality-regression-bundle-v2.schema.json").read_text())
+        self.assertIn("renewal_source_proof_ref", bundle["properties"])
+        gate = json.loads((ROOT / "schemas/reader-surface-gate-v2.schema.json").read_text())
+        variants = gate["properties"]["derivation"]["oneOf"]
+        self.assertEqual(len(variants), 5)
+        routes = sorted(v["properties"]["route"]["const"] for v in variants)
+        self.assertIn("VERSIONED_RENEWAL_V1", routes)
+
+    def test_config_pipeline_71_schemas_only(self) -> None:
+        cfg = json.loads((ROOT / "config/survey-production-v2.json").read_text())
+        pipe = cfg["contract_files"]["pipeline"]
+        self.assertEqual(len(pipe), 71)
+        for s in ("schemas/versioned-renewal-basis-v2.schema.json",
+                  "schemas/versioned-renewal-source-manifest-v2.schema.json",
+                  "schemas/versioned-renewal-source-proof-v2.schema.json",
+                  "schemas/versioned-renewal-publication-set-v2.schema.json"):
+            self.assertIn(s, pipe)
+        self.assertFalse(any(p.startswith("scripts/") for p in pipe))
+        self.assertEqual(cfg["implementation_control_roots"],
+                         ["config", "schemas", "scripts", ".github/workflows"])
+        self.assertEqual(len(cfg["contract_files"]["quality"]), 3)
+
+    def test_closure_63_union_66(self) -> None:
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        weekly = hist._expected_receipt_closure("WEEKLY_GENERATED_V2", "NEW")
