+    def _forge_scope(self, sc: Scratch, basis_rel: str, fn, code: str, rival: bool = False):
+        from scripts import survey_versioned_renewal_source_v2 as src
+        pr = _prior(sc)
+        scope_rel = pr["receipt"]["scope_review_ref"]["path"]
+        staged_rel = pr["staged_rel"]
