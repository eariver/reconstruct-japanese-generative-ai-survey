+def _strict_json_from_bytes(data: bytes, label: str) -> Any:
+    """Bounded shared strict JSON parse: nested duplicates refused BEFORE digest/schema.
+
+    Uses survey_schema_v2 strict parser (no last-wins, no State/result caching).
+    Raises EditorialError (typed, nonzero) on duplicate/invalid/plain-non-object.
+    Valid duplicate-free legacy JSON remains valid.
