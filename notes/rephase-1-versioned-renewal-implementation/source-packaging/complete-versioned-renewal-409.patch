+    def test_verifier_state_labels_required(self) -> None:
+        # Coordinated triple mutation (S3): retained State bytes + proposal
+        # plan row + manifest row (+ proposal_ref rebind) so the I1 byte
+        # checks pass and the label check is reached. A missing or
+        # disagreeing State research/publication label refuses
+        # (LABEL_MISMATCH) with immediate verifier no-write; restoration
+        # re-verifies.
+        scratch, root = self._fresh_weekly("jgas-p2r-labels-")
+        helper = p1t._new_weekly_helper(self, root)
+        built = p1t._build_weekly_validated(self, helper)
