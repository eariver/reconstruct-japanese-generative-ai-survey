+def prepare_renewal_targets(root: str | Path, basis_path: str | Path,
+                             executor: str,
+                             recorded_at: datetime | str | None = None) -> dict[str, Any]:
+    """C-only pre-review build half (declared C preparation half, root-accepted):
+    authority -> proof -> trio FILES -> C manuscript -> real disposable
+    build/transfer -> build record -> receipt.
+
+    Manuscript and build both exist before any external review, so the
+    external reviewer (emulated by the fixture harness via the actual review
+    builders, clearly labelled synthetic; genuine in production) can target
+    the exact new manuscript/source/PDF. finalize_renewal then consumes the
+    supplied postrender reviews + fresh QA inputs. U has no targets step
+    (prior paths reused; finalize runs directly). Exclusive writes refuse on
+    re-run (no takeover); retry uses a new renewal id.
+
+    Root clarification: this entry is the declared C preparation half with
+    full same authority checks (observe_renewal_authority + detached proof
+    readbacks before/after receipt); no extra writes occur after external
+    review; no new permission/bypass is introduced. Documented here without
+    new authority.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    if not isinstance(executor, str) or not executor.strip():
+        raise _fail("ARGS", "TARGETS", "REFUSED_PRE_WRITE", "executor required")
+    ts = _now_utc(recorded_at)
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    authority = observe_renewal_authority(repo, _basis_state_path(repo, basis_rel), basis_rel)
+    entry = authority["entry"]
+    basis = authority["basis"]
+    if basis.get("requested") != "RENDER_TARGETS":
+        raise _fail("INTENT_MISMATCH", "TARGETS", "REFUSED_PRE_WRITE",
+                    "targets step is C-only (U reuses prior targets via finalize)")
+    paths = _proof_paths_for_request(basis)
+    built = _build_proof_object(repo, basis, basis_rel, entry, executor.strip(), ts)
+    proof = _assemble_new_proof(repo, basis, basis_rel, entry, built, executor.strip(), ts)
+    proof_rel = paths["proof"]
+    _write_json_bound(repo, proof_rel, proof, "proof_sha256", "renewal source proof",
+                      "TARGETS", "RENEWAL_PROOF_DIGEST")
+    try:
+        proof_file_sha = _sha_bytes(_read_bytes_bounded(repo, proof_rel, "renewal proof pin"))
+        _validate_pinned_instance(repo, proof, proof_rel, proof_file_sha,
+                                  RENEWAL_PROOF_SCHEMA, "Renewal Source Proof", "TARGETS")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "TARGETS", "REFUSED_PRE_WRITE",
+                    f"renewal proof schema invalid: {exc}") from exc
+    # New trio FILES first: S Layer-B reads trio bytes live during proof
+    # verification (FD-bound, no caller bytes). Manuscript/build/receipt follow
+    # only after the proof verifies against the actual new targets.
+    _write_new_trio_files(repo, proof, built)
+    try:
+        srcmod.verify_renewal_source_proof(repo, basis_rel, proof_rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+        raise _fail(str(code), "TARGETS", "REFUSED_PRE_WRITE",
+                    f"detached proof verification failed: {exc}") from exc
+    build_record_rel = _render_and_build_new_targets(repo, basis, basis_rel, entry, proof,
+                                                     proof_rel, built, executor.strip(), ts)
+    receipt_rel = _write_renewal_receipt(repo, basis, basis_rel, entry, proof, proof_rel,
+                                         build_record_rel, executor.strip(), ts)
+    try:
+        srcmod.verify_renewal_source_proof(repo, basis_rel, proof_rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+        raise _fail(str(code), "TARGETS", "REFUSED_PRE_WRITE",
+                    f"post-receipt proof revalidation failed: {exc}") from exc
+    _ = core
+    return {"proof_path": proof_rel, "receipt_path": receipt_rel,
+            "build_record_path": build_record_rel,
+            "manuscript_path": paths["manuscript"],
+            "trio_paths": {k: v["path"] for k, v in proof["output_trio_refs"].items()},
+            "proof_sha256": proof["proof_sha256"],
+            "disposition": "NEW_TARGETS"}
+
