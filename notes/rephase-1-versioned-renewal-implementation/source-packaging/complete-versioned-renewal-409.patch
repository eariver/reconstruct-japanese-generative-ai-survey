+        swapped_lines = [json.dumps(swapped_first, sort_keys=True)] + lines[1:]
+        swapped_bytes = ("\n".join(swapped_lines) + "\n").encode()
+        # Sanity: swapped must be different SHA but still parseable.
+        self.assertNotEqual(_sha_bytes(swapped_bytes), _sha_bytes(orig_bytes))
+        from scripts import survey_screening_v2 as smod
+        # Must preserve parse format and pass shape (so failure is hash pin, not shape).
