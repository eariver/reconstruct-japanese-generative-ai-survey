+def _proof_skeleton(sc: Scratch, basis_rel: str, basis: dict, dep: list, trio: dict, old_man: dict, old_build: dict) -> tuple[str, dict]:
+    # ROOT binding decision (contract §11.2): proof.basis_ref carries the pinned
+    # basis FILE-BYTE SHA256 — never the SELF digest in basis.basis_sha256.
+    proof = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_SOURCE_PROOF_V1",
+        "basis_ref": {"path": basis_rel, "sha256": _sha_file(sc.work / basis_rel)},
+        "issue_id": basis["issue_id"], "research_profile": basis["research_profile"],
+        "publication_profile": basis["publication_profile"], "generator_route": basis["generator_route"],
+        "reviewed_reader_ref": basis["reviewed_reader_ref"], "authoring_refs": basis["authoring_refs"],
+        "accepted_refs": basis["accepted_refs"], "supported_contract": basis["current_tool_epoch"]["contract"],
+        "supported_source_bindings": basis["observed_source_bindings"],
+        "dependency_closure": sorted(dep, key=lambda r: (r["name"], r["path"], r["sha256"])),
+        "output_trio_refs": trio,
+        "reader_digest": "0" * 64, "trio_digest": "0" * 64,
+        "comparison": {"reader_equal": True, "trio_equal": True, "disposition": "REUSED_TARGETS"},
+        "old_manuscript_ref": old_man,
+        "old_build_unit_refs": old_build,
+        "executor": "t", "recorded_at": "2026-10-24T00:00:00+00:00", "proof_sha256": "0" * 64,
+    }
+    proof["proof_sha256"] = _sha_obj({k: v for k, v in proof.items() if k != "proof_sha256"})
+    proof_rel = basis_rel.replace("renewal-basis.json", "renewal-source-proof.json")
+    (sc.work / proof_rel).write_text(json.dumps(proof, indent=1, sort_keys=True), encoding="utf-8")
+    return proof_rel, proof
+
+
+def _full_valid_proof(sc: Scratch, basis_rel: str, basis: dict) -> tuple[str, dict]:
+    """Backend-consistent FILE proof: real trio/old refs + real Layer-A digests.
+
+    proof.basis_ref carries the pinned basis FILE SHA (ROOT §11.2), never SELF.
+    Returns (proof_rel, proof). Raises unless the full verify passes.
+    """
+    from scripts import survey_versioned_renewal_source_v2 as src
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    from scripts import survey_production_v2 as core
+    current = src.load_renewal_accepted_authority(sc.work, basis_rel)
+    surface = current["surface"]
+    from scripts.survey_weekly_derivation_v2 import render_main as w_main, render_bibliography as w_bib
+    main_text, bib_text = w_main(surface), w_bib(surface)
+    trio, old_man, old_build = _real_trio_and_old_refs(sc)
+    style_data = (sc.work / trio["style"]["path"]).read_bytes()
+    reader_digest = _sha_bytes(core.json_bytes(surface))
+    trio_digest = core.sha256_object({"primary": _sha_bytes(main_text.encode("utf-8")),
+                                      "bibliography": _sha_bytes(bib_text.encode("utf-8")),
+                                      "style": _sha_bytes(style_data)})
+    route = basis["generator_route"]
+    names = list(hist._expected_receipt_closure(route, "NEW"))
+    dep = [{"name": n, "path": n, "sha256": _sha_file(sc.work / n)} for n in names]
+    proof_rel, _p = _proof_skeleton(sc, basis_rel, basis, dep, trio, old_man, old_build)
+    proof = json.loads((sc.work / proof_rel).read_bytes())
+    proof["reader_digest"] = reader_digest
+    proof["trio_digest"] = trio_digest
+    proof["proof_sha256"] = _sha_obj({k: v for k, v in proof.items() if k != "proof_sha256"})
+    (sc.work / proof_rel).write_text(json.dumps(proof, indent=1, sort_keys=True), encoding="utf-8")
+    out = src.verify_renewal_source_proof(sc.work, basis_rel, proof_rel)
+    assert out.get("CURRENT_PROOF_VALID")
+    return proof_rel, proof
+
