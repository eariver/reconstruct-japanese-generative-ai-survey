+def _commit_r1_nonemitted_comment(testcase: unittest.TestCase, root: Path) -> str:
+    """Genuine R1 owner change: a real committed PURE Python comment.
+
+    Inserts one comment-only line (column 0, no code, no docstring edit) above
+    `build_reader_input` in the actual allowed derivation source
+    (`scripts/survey_weekly_derivation_v2.py`, the only ALLOWED_CHANGED_PATH);
+    AST dumps before/after must be identical, proving zero semantic change.
+    The refresh implementation path and emitted TeX-comment path are NOT used.
+    """
+    probe = root / "scripts" / "survey_weekly_derivation_v2.py"
+    text = probe.read_text(encoding="utf-8")
+    testcase.assertNotIn(_P3S_R1_NONEMITTED_COMMENT_ANCHOR, text)
+    before = _ast.dump(_ast.parse(text))
+    lines = text.splitlines(keepends=True)
+    targets = [i for i, line in enumerate(lines)
+               if line.startswith("def build_reader_input(")]
