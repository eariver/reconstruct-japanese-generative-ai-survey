+            elif code in ("SCOPE_DIGEST_MISMATCH", "SCOPE_WRONG_AFTER", "SCOPE_STALE_UPSTREAM", "SCOPE_CHECK_NOT_PASS", "SCOPE_BLOCK_SHAPE", "SCOPE_NOT_WITHIN_AUTHORITY"):
+                # H preempts same predicates with HISTORY_DIGEST_MISMATCH +
+                # historical detail (reviewed_surface/after-reader, upstream,
+                # checks/block/decision). Accept either S late or H early with
+                # exact detail; control below qualifies scope.
+                self.assertTrue(
