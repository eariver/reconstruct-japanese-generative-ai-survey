+                 WEEKLY_SEMANTIC_PUBLICATION.as_posix())
+    else:
+        raise StagedSourceError("UNKNOWN_ROUTE", "PIN", "REFUSED_PRE_WRITE",
+                                f"unsupported staged route: {route}")
+    # Root-selected exact63 REQUIRED (same-reader renewal map): shared35 py
+    # (30 P3S + discovery + x_intake transitives + 3 new renewal modules) +
+    # shared22 schemas (14 P3S + 4 new renewal + 4 family) + route3 + staged1 +
+    # style1 + recipe1. Weekly CURRENT_CLOSURE/Longform CURRENT_CLOSURE route
+    # subsets are S-owned and unchanged here. Verify all 63 names vs actual
+    # imports + dynamic edges + file-pin-only.
+    members = (set(_SHARED_PY) | set(_SHARED_SCHEMAS) | set(extra)
+               | {STAGED_MODULE.as_posix(), STYLE_PATH.as_posix(), RECIPE_PATH.as_posix()})
+    ordered = tuple(sorted(members))
+    # 35 py +22 schemas +3 route +1 staged +1 style +1 recipe =63.
+    if len(ordered) != 35 + 22 + 3 + 1 + 1 + 1:
+        raise StagedSourceError("CODE_DEPS_SHAPE", "PIN", "REFUSED_PRE_WRITE",
+                                f"fixed renewal set changed size: {len(ordered)} != 63 "
+                                f"(_SHARED_PY={len(_SHARED_PY)} _SHARED_SCHEMAS={len(_SHARED_SCHEMAS)})")
+    if len(_SHARED_PY) != 35 or len(_SHARED_SCHEMAS) != 22:
+        raise StagedSourceError("CODE_DEPS_SHAPE", "PIN", "REFUSED_PRE_WRITE",
+                                "shared closure must be exactly 35 py +22 schemas")
+    # Edge classification (no silent omit): top-level AST + function-local dynamic (P2V observer
+    # in materialize) + file-pin-only (schemas/style/recipe/semantic producers never imported).
+    # Any actual extra import beyond this set must require expansion return flag.
+    try:
+        import ast as _ast
+        _src = Path(__file__).read_text(encoding="utf-8")
