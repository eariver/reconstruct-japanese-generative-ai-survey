+def _resolve_toolchain_executable(exe: Path, label: str) -> tuple[Path, Path, str]:
+    try:
+        link = exe if not exe.is_symlink() else Path(os.readlink(str(exe)))
+        real = exe.resolve()
+        if not real.is_file():
+            raise RenewalHighError("TOOLCHAIN_EXE", f"{label} not a file: {exe}",
+                                   phase="BUILD", disposition="REFUSED_PRE_WRITE")
+        digest = _sha_bytes(real.read_bytes())
+    except OSError as exc:
+        raise _fail("TOOLCHAIN_EXE", "BUILD", "REFUSED_PRE_WRITE",
+                    f"{label} unresolvable: {exe}: {exc}") from exc
+    return exe, real, digest
+
+
+def _execute_disposable_build(repo: Path, basis: dict[str, Any],
+                              trio: dict[str, Any]) -> dict[str, Any]:
+    """Real disposable TL build + exclusive transfer + readback (C only).
+
+    Selected actual executable under the fixed recipe; executable/recipe
+    evidence rechecked, never synthesized. Build auxiliaries stay disposable;
+    outputs transfer exclusively into R/build/ with readback.
+    """
+    import tempfile
+    from scripts import survey_editorial_publication_v2 as edpub
+    tspec_ref = basis.get("toolchain_spec_ref")
+    if not isinstance(tspec_ref, dict):
+        raise _fail("INTENT_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                    "C build requires the explicit toolchain spec")
+    tspec = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, str(tspec_ref["path"]), "toolchain spec"),
+                            "toolchain spec"), "toolchain spec")
+    exe_raw = tspec.get("absolute_executable", "")
+    if not isinstance(exe_raw, str) or not exe_raw or "\\" in exe_raw:
+        raise _fail("TOOLCHAIN_EXE", "BUILD", "REFUSED_PRE_WRITE",
+                    "toolchain executable must be a non-empty absolute string")
+    exe = Path(exe_raw)
+    if not exe.is_absolute() or ".." in exe.parts or "." in exe.parts:
+        raise _fail("TOOLCHAIN_EXE", "BUILD", "REFUSED_PRE_WRITE", "toolchain executable unsafe")
+    _link, _real, _real_sha = _resolve_toolchain_executable(exe, "toolchain executable")
+    recipe = tspec.get("recipe", "")
+    if recipe == "lualatex-biber-lualatex":
+        expected_argv = list(edpub.EXPECTED_ARGV_LUALATEX_BIBER)
+        cmds = [
+            [str(exe), "-synctex=1", "-interaction=nonstopmode", "-file-line-error",
+             "-halt-on-error", "main.tex"],
+            [str(exe.parent / "biber"), "main"],
+            [str(exe), "-synctex=1", "-interaction=nonstopmode", "-file-line-error",
+             "-halt-on-error", "main.tex"],
+            [str(exe), "-synctex=1", "-interaction=nonstopmode", "-file-line-error",
+             "-halt-on-error", "main.tex"],
+        ]
+    elif recipe == "latexmk-lualatex":
+        expected_argv = list(edpub.EXPECTED_ARGV_LATEXMK)
+        cmds = [[str(exe.parent / "latexmk"), "-pdf", "-lualatex",
+                 "-interaction=nonstopmode", "main.tex"]]
+    else:
+        raise _fail("TOOLCHAIN_RECIPE", "BUILD", "REFUSED_PRE_WRITE",
+                    f"unsupported recipe: {recipe!r}")
+    if list(tspec.get("argv", [])) != expected_argv:
+        raise _fail("TOOLCHAIN_ARGV", "BUILD", "REFUSED_PRE_WRITE",
+                    "toolchain spec argv must EXACTLY equal the fixed recipe tuple")
+    env = tspec.get("env", {})
+    if not isinstance(env, dict):
+        raise _fail("TOOLCHAIN_ENV", "BUILD", "REFUSED_PRE_WRITE", "toolchain env must be object")
+    for key, val in env.items():
+        if key not in edpub.ALLOWED_ENV_KEYS or key.startswith("GIT_") \
+                or key in ("PATH", "PYTHONPATH", "LD_LIBRARY_PATH") \
+                or not isinstance(val, str) or "\n" in val or "\x00" in val:
+            raise _fail("TOOLCHAIN_ENV", "BUILD", "REFUSED_PRE_WRITE",
+                        f"toolchain env refused: {key}")
+    recipe_bytes = _read_bytes_bounded(repo, ".latexmkrc", "build recipe")
+    recipe_text = recipe_bytes.decode("utf-8")
+    for marker in edpub.REQUIRED_RECIPE_MARKERS:
+        if marker not in recipe_text:
+            raise _fail("RECIPE_INCONSISTENT", "BUILD", "REFUSED_PRE_WRITE",
+                        f"recipe missing marker: {marker}")
+    controlled = {"PATH": str(exe.parent) + ":" + edpub.CONTROLLED_SYSTEM_PATH_SUFFIX}
+    try:
+        proc = subprocess.run([str(exe), "--version"], capture_output=True, text=True,
+                              timeout=60, env=controlled)
+        versions: dict[str, Any] = {
+            "stdout": (proc.stdout or "")[:8000], "stderr": (proc.stderr or "")[:8000],
+            "returncode": proc.returncode, "link_path": str(_link),
+            "real_path": str(_real), "real_sha256": _real_sha}
+    except Exception as exc:
+        versions = {"stdout": "", "stderr": "", "returncode": 1,
+                    "link_path": str(_link), "real_path": str(_real),
+                    "real_sha256": _real_sha, "error": str(exc)[:500]}
+    # Companion evidence DIRECTLY in toolchain.versions (H schema pins explicit
+    # biber_*/latexmk_* fields, present-vs-_error exactly): required companion
+    # is biber for the direct recipe and latexmk for the latexmk recipe; a
+    # missing/stale required companion or a failed executable probe refuses
+    # here (HIGH current probing), never surfacing later as history drift.
+    # Non-required companion absence is recorded as _error (schema-tolerated).
+    required_companion = "biber" if recipe == "lualatex-biber-lualatex" else "latexmk"
+    for companion in ("biber", "latexmk"):
+        cand = exe.parent / companion
+        try:
+            _c_link, _c_real, _c_sha = _resolve_toolchain_executable(cand, companion)
+            cp = subprocess.run([str(cand), "--version"], capture_output=True, text=True,
+                                timeout=60, env=controlled)
+            if cp.returncode != 0:
+                raise _fail("TOOLCHAIN_COMPANION", "BUILD", "REFUSED_PRE_WRITE",
+                            f"companion probe failed ({cp.returncode}): {companion}") from None
+            versions[f"{companion}_stdout"] = (cp.stdout or "")[:4000]
+            versions[f"{companion}_returncode"] = cp.returncode
+            versions[f"{companion}_link_path"] = str(_c_link)
+            versions[f"{companion}_real_path"] = str(_c_real)
+            versions[f"{companion}_real_sha256"] = _c_sha
+        except RenewalHighError as exc:
+            if companion == required_companion:
+                raise
+            versions[f"{companion}_error"] = f"{exc.code}: {exc.detail}"[:300]
+        except Exception as exc:
+            if companion == required_companion:
+                raise _fail("TOOLCHAIN_COMPANION", "BUILD", "REFUSED_PRE_WRITE",
+                            f"required companion missing/stale for {recipe}: "
+                            f"{companion}: {exc}") from exc
+            versions[f"{companion}_error"] = str(exc)[:300]
+    if versions.get("returncode") != 0:
+        raise _fail("TOOLCHAIN_EXE", "BUILD", "REFUSED_PRE_WRITE",
+                    "toolchain executable probe failed (stale executable refuses)")
+    tmp = Path(tempfile.mkdtemp(prefix="renewal-build-"))
+    try:
+        inputs: dict[str, bytes] = {}
+        for label, key, dest in (("main", "primary", "main.tex"),
+                                 ("bibliography", "bibliography", "references.bib"),
+                                 ("style", "style", "jgaisurvey.sty")):
+            data = _read_bytes_bounded(repo, _lexical_rel(repo, str(trio[key]["path"]),
+                                                          f"build input {label}"),
+                                       f"build input {label}")
+            if _sha_bytes(data) != trio[key]["sha256"]:
+                raise _fail("INPUT_DRIFT", "BUILD", "REFUSED_PRE_WRITE",
+                            f"build input drift before build: {label}")
+            inputs[dest] = data
+            dest_path = tmp / dest
+            fd = os.open(str(dest_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+            try:
+                os.write(fd, data)
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        build_env = dict(controlled)
+        for key, val in env.items():
+            build_env[str(key)] = str(val)
+        for cmd in cmds:
+            proc = subprocess.run(cmd, cwd=str(tmp), capture_output=True, text=True,
+                                  timeout=600, env=build_env)
+            if proc.returncode != 0:
+                raise _fail("BUILD_FAILED", "BUILD", "PRESERVED_INCOMPLETE",
+                            f"build step failed ({proc.returncode}): {cmd[0]} "
+                            f"{(proc.stderr or '')[-500:]}")
+        pdf_data = (tmp / "main.pdf").read_bytes()
+        log_data = (tmp / "main.log").read_bytes()
+        try:
+            from pypdf import PdfReader
+            page_count = len(PdfReader(str(tmp / "main.pdf")).pages)
+        except Exception as exc:
+            raise _fail("BUILD_FAILED", "BUILD", "PRESERVED_INCOMPLETE",
+                        f"built PDF unreadable: {exc}") from exc
+        if page_count < 1 or len(pdf_data) < 1 or len(log_data) < 1:
+            raise _fail("BUILD_FAILED", "BUILD", "PRESERVED_INCOMPLETE", "built PDF/log empty")
+    finally:
+        import shutil
+        shutil.rmtree(str(tmp), ignore_errors=True)
+    digest_text = f"{_sha_bytes(pdf_data)}  main.pdf\n".encode("utf-8")
+    outs: dict[str, Any] = {}
+    for key, data, extra in (("publication-pdf", pdf_data, {}),
+                             ("build-log", log_data, {}),
+                             ("pdf-digest", digest_text, {})):
+        # EXECUTED outputs are sizedRefs ({path,sha256,byte_count}, no
+        # page_count per #/$defs/buildRecord); page_count lives in the proof
+        # old-build pdfRef, seal roles stay fileRefs. Never add page_count here.
+        rel = f"{basis['proposal_namespace']}/renewals/{basis['renewal_id']}/build/{keyofile(key)}"
+        info = _atomic_write_new(repo, rel, data, f"build output {key}")
+        outs[key] = {"path": rel, "sha256": info["sha256"],
+                     "byte_count": info["byte_count"], **extra}
+    # Post-build live reverify: the probed binaries must still resolve to the
+    # recorded SHAs (swapped/stale toolchain during the build refuses here).
+    for _label, _sha_key in (
+            ("executable", "real_sha256"),
+            ("biber", "biber_real_sha256"),
+            ("latexmk", "latexmk_real_sha256")):
+        if _sha_key not in versions:
+            continue
+        _resolve_path = exe if _label == "executable" else exe.parent / _label
+        try:
+            _rl, _rr, _rs = _resolve_toolchain_executable(_resolve_path, _label)
+        except Exception as exc:
+            raise _fail("TOOLCHAIN_COMPANION", "BUILD", "PRESERVED_INCOMPLETE",
+                        f"post-build toolchain reverify failed: {_label}: {exc}") from exc
+        if _rs != versions[_sha_key]:
+            raise _fail("TOOLCHAIN_COMPANION", "BUILD", "PRESERVED_INCOMPLETE",
+                        f"toolchain binary changed during build: {_label}")
+    return {"fixed_steps": expected_argv,
+            "toolchain": {"executable": str(exe), "versions": versions,
+                          "argv": expected_argv,
+                          "env": {k: env[k] for k in sorted(env)}},
+            "outputs": outs}
+
+
+def keyofile(key: str) -> str:
+    return {"publication-pdf": "main.pdf", "build-log": "main.log",
+            "pdf-digest": "main.pdf.sha256"}[key]
+
+
+def _write_renewal_receipt(repo: Path, basis: dict[str, Any], basis_rel: str,
+                            entry: dict[str, Any], proof: dict[str, Any],
+                            proof_rel: str, build_record_rel: str,
+                            executor: str, ts: str) -> str:
+    """Renewal receipt AFTER the build record (binds it; never precedes it)."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    build_bytes = _read_bytes_bounded(repo, _lexical_rel(repo, build_record_rel,
+                                                         "build record"), "build record")
+    build_ref = {"path": build_record_rel, "sha256": _sha_bytes(build_bytes)}
+    receipt: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_SOURCE_V1",
+        "issue_id": basis["issue_id"], "research_profile": basis["research_profile"],
+        "publication_profile": basis["publication_profile"],
+        "generator_route": basis["generator_route"],
+        "proposal_ref": dict(basis["original_proposal_ref"]),
+        "renewal_basis_ref": _file_ref(repo, basis_rel, "receipt renewal basis"),
+        "renewal_proof_ref": _file_ref(repo, proof_rel, "receipt renewal proof"),
+        "reviewed_reader_ref": dict(basis["reviewed_reader_ref"]),
+        "authoring_refs": [dict(r) for r in basis["authoring_refs"]],
+        "accepted_refs": [dict(r) for r in basis["accepted_refs"]],
+        "current_tools": {"repository_commit_sha": basis["current_tool_epoch"]["repository_commit_sha"],
+                          "contract": dict(basis["current_tool_epoch"]["contract"]),
+                          "closure": [dict(r) for r in basis["current_tool_epoch"]["closure"]]},
+        "outputs": {k: {"path": v["path"], "sha256": v["sha256"], "byte_count": v["byte_count"]}
+                    for k, v in proof["output_trio_refs"].items()},
+        "build_record_ref": build_ref,
+    }
+    receipt["receipt_sha256"] = core.sha256_object({k: v for k, v in receipt.items()
+                                                    if k != "receipt_sha256"})
+    rel = _proof_paths_for_request(basis)["receipt"]
+    _write_json_bound(repo, rel, receipt, "receipt_sha256", "renewal source receipt",
+                      "RECEIPT", "RENEWAL_PROOF_DIGEST")
+    try:
+        receipt_file_sha = _sha_bytes(_read_bytes_bounded(repo, rel, "renewal receipt pin"))
+        _validate_pinned_instance(repo, receipt, rel, receipt_file_sha,
+                                  RENEWAL_RECEIPT_SCHEMA, "Renewal Source Receipt", "RECEIPT")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                    f"renewal receipt schema invalid: {exc}") from exc
+    return rel
+
+
+def validate_renewal_receipt(root: str | Path, receipt_path: str | Path) -> dict[str, Any]:
+    """Detached renewal receipt validation: schema/self-digest/refs + bound
+    proof Layer-B readback (which rechecks HIST + CURRENT closure/contract)."""
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    rel = _lexical_rel(repo, str(receipt_path), "renewal receipt")
+    raw = _read_bytes_bounded(repo, rel, "renewal receipt")
+    receipt = _strict_json_from_bytes(raw, "renewal receipt")
+    if not isinstance(receipt, dict):
+        raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                    "renewal receipt must be an object")
+    try:
+        _validate_pinned_instance(repo, receipt, rel, _sha_bytes(raw),
+                                  RENEWAL_RECEIPT_SCHEMA, "Renewal Source Receipt", "RECEIPT")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                    f"renewal receipt schema invalid: {exc}") from exc
+    from scripts import survey_production_v2 as core
+    if core.sha256_object({k: v for k, v in receipt.items() if k != "receipt_sha256"}) \
+            != receipt.get("receipt_sha256"):
+        raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                    "renewal receipt self-digest mismatch")
+    basis_ref = receipt.get("renewal_basis_ref", {})
+    proof_ref = receipt.get("renewal_proof_ref", {})
+    build_ref = receipt.get("build_record_ref", {})
+    for name, ref in (("basis", basis_ref), ("proof", proof_ref), ("build", build_ref)):
+        if not isinstance(ref, dict) or not isinstance(ref.get("path"), str) \
+                or not _is_hex64(ref.get("sha256")):
+            raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                        f"receipt {name} ref invalid")
+        live = _read_bytes_bounded(repo, _lexical_rel(repo, str(ref["path"]),
+                                                      f"receipt {name}"), f"receipt {name}")
+        if _sha_bytes(live) != ref["sha256"]:
+            raise _fail("RENEWAL_PROOF_DIGEST", "RECEIPT", "REFUSED_PRE_WRITE",
+                        f"receipt {name} bytes changed")
+    try:
+        proof_verdict = srcmod.verify_renewal_source_proof(repo, str(basis_ref["path"]),
+                                                           str(proof_ref["path"]))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+        raise _fail(str(code), "RECEIPT", "REFUSED_PRE_WRITE",
+                    f"bound proof readback failed: {exc}") from exc
+    _ = proof_verdict
+    return {"RECEIPT_VALID": True, "receipt": receipt, "receipt_path": rel}
+
+
+def _lineage_scope_path(repo: Path, basis: dict[str, Any]) -> str:
+    """Exact lineage scope review path from H materialization lineage.
+
+    Reads the HIST verdict on the prior record (reloaded, never a caller dict)
+    and takes the latest EDITORIAL entry's original_scope_ref (exact path+SHA,
+    live bytes verified). Same-reader renewal never changes the reader, so
+    this early scope authority remains valid for both U and C gates; a
+    replacement scope at a different path is never silently substituted.
+    """
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    prior_record = basis.get("prior_record_ref", {})
+    try:
+        verdict = hist.verify_versioned_history(repo, str(prior_record.get("path", "")))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_DIGEST_MISMATCH"
+        raise _fail(str(code), "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"lineage scope history invalid: {exc}") from exc
+    lineage = verdict.get("materialization_lineage", [])
+    editorial = [e for e in lineage if isinstance(e, dict) and e.get("kind") == "EDITORIAL"]
+    if not editorial:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "no editorial materialization producer in selected chain")
+    scope_ref = editorial[-1].get("original_scope_ref", {})
+    if not isinstance(scope_ref, dict) or not isinstance(scope_ref.get("path"), str):
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "lineage scope ref invalid")
+    rel = _lexical_rel(repo, str(scope_ref["path"]), "lineage scope review")
+    data = _read_bytes_bounded(repo, rel, "lineage scope review")
+    if _sha_bytes(data) != scope_ref.get("sha256"):
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "lineage scope review bytes changed")
+    return rel
+
+
+def _write_qa_gate_candidate(repo: Path, basis: dict[str, Any], basis_rel: str,
+                             entry: dict[str, Any], proof: dict[str, Any],
+                             proof_rel: str, receipt_rel: str, paths: dict[str, str],
+                             checks_path: str | Path,
+                             semantic_review_path: str | Path | None,
+                             visual_review_path: str | Path | None,
+                             executor: str, ts: str) -> tuple[str, str, str]:
+    """Fresh QA inputs -> bundle -> Gate -> Candidate, all bound to SAME proof.
+
+    quality.validate_checks validates the supplied results; it never executes
+    those checks. No genuine approval is produced: fixtures carry synthetic
+    external records labelled as such; production semantic quality stays NO-GO.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_quality_v2 as quality
+    from scripts import survey_publication_v2 as pubmod
+    from scripts import survey_reader_surface_gate_v2 as gatemod
+    from scripts import survey_reader_publication_v2 as reader_pub
+    proof_ref = _file_ref(repo, proof_rel, "finalize renewal proof")
+    receipt_ref = _file_ref(repo, receipt_rel, "finalize renewal receipt")
+    requested = basis.get("requested")
+    trio = proof["output_trio_refs"]
+    # The Gate's semantic input is the lineage scope review (early, exact) for
+    # BOTH U and C: the reader is unchanged in same-reader renewal, so the
+    # scope authority (reviewed_surface == proof reviewed_reader) remains
+    # valid; the gate's fresh surface checks run on the bound trio (old paths
+    # for U, new R paths for C) and the derivation binds the NEW proof+receipt.
+    # Postrender publication reviews (predecessor refs for U, new postrender
+    # for C) go to Candidate/seal, never as gate semantic input (wrong shape:
+    # no reviewed_surface). A replacement scope at a different path is never
+    # silently substituted.
+    gate_sem_path = _lineage_scope_path(repo, basis)
+    if requested == "REUSE_TARGETS":
+        prior_seal = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                                   "prior seal"), "prior seal"), "prior seal")
+        roles = prior_seal.get("roles", {})
+        man_path = str((roles.get("reader-manuscript") or {}).get("path", ""))
+        pdf_path = str((roles.get("publication-pdf") or {}).get("path", ""))
+        # Candidate/seal keep the exact predecessor postrender review records.
+        sem_path = str((roles.get("semantic-review") or {}).get("path", ""))
+        vis_path = str((roles.get("visual-review") or {}).get("path", ""))
+        if semantic_review_path is not None:
+            sem_path = _lexical_rel(repo, str(semantic_review_path), "supplied semantic review")
+        if visual_review_path is not None:
+            vis_path = _lexical_rel(repo, str(visual_review_path), "supplied visual review")
+    else:
+        man_path = paths["manuscript"]
+        build_rec = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(
+                repo, _proof_paths_for_request(basis)["build_record"], "build record"),
+                "build record"), "build record")
+        pdf_path = str((build_rec.get("outputs", {}) or {}).get("publication-pdf", {})
+                       .get("path", ""))
+        sem_path = _lexical_rel(repo, str(semantic_review_path), "C semantic review")
+        vis_path = _lexical_rel(repo, str(visual_review_path), "C visual review")
+        _require_postrender_review_targets(repo, basis, proof, sem_path, vis_path)
+    checks_rel = _lexical_rel(repo, str(checks_path), "QA checks")
+    checks_data = _read_bytes_bounded(repo, checks_rel, "QA checks")
+    checks_doc = _strict_json_from_bytes(checks_data, "QA checks")
+    # Actual supplied file shape is {"checks": [...]} (bootstrap evidence);
+    # a bare array is also accepted. Anything else refuses (no invented shape).
+    if isinstance(checks_doc, dict) and isinstance(checks_doc.get("checks"), list):
+        checks = checks_doc["checks"]
+    elif isinstance(checks_doc, list):
+        checks = checks_doc
+    else:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "QA checks file must be a non-empty array or {checks:[...]}")
+    if not checks:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE", "QA checks must be a non-empty array")
+    # Freshness: every check must be recorded at/after basis capture (this
+    # renewal's own actual run, never a copied old result). Live result SHAs
+    # are re-verified by validate_checks below; full required DETERMINISTIC
+    # kinds must be present.
+    try:
+        basis_instant = _parse_instant_str(str(basis.get("recorded_at", "")))
+    except RenewalHighError as exc:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"basis recorded_at invalid for QA freshness: {exc.detail}") from exc
+    for row in checks:
+        if not isinstance(row, dict):
+            raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE", "QA check row invalid")
+        try:
+            row_instant = _parse_instant_str(str(row.get("recorded_at", "")))
+        except RenewalHighError:
+            raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"QA check recorded_at invalid: {row.get('check_id')})") from None
+        if row_instant < basis_instant:
+            raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"stale QA refused (recorded before basis capture): {row.get('check_id')}")
+    cfg = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, "config/survey-production-v2.json", "production config"),
+        "production config")
+    try:
+        quality.validate_checks(repo, cfg, str(basis["research_profile"]),
+                                str(basis["publication_profile"]), checks,
+                                required_kinds={"DETERMINISTIC"})
+    except ValueError as exc:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"supplied QA results invalid (no fresh QA): {exc}") from exc
+    profile_rel = _lexical_rel(repo, str(basis["profile_ref"]["path"]), "Production Profile")
+    try:
+        quality.build_bundle(repo, str(basis["issue_id"]),
+                             repo / str(trio["primary"]["path"]),
+                             repo / pdf_path, checks, repo / paths["bundle"],
+                             production_profile_path=repo / profile_rel,
+                             renewal_source_proof_ref=dict(proof_ref))
+    except TypeError as exc:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "quality bundle builder lacks the renewal proof branch "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except ValueError as exc:
+        raise _fail("QA_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"QA bundle build refused: {exc}") from exc
+    try:
+        gatemod.evaluate_reader_surface_gate(
+            repo, repo / man_path,
+            semantic_review_path=repo / gate_sem_path,
+            evaluated_by=f"versioned-renewal-high {executor}", recorded_at=None,
+            output_path=repo / paths["gate"],
+            renewal_source_proof_ref=dict(proof_ref),
+            renewal_receipt_ref=dict(receipt_ref))
+    except TypeError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "gate derivation lacks the VERSIONED_RENEWAL_V1 proof/receipt branch "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except ValueError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"gate derivation refused: {exc}") from exc
+    try:
+        sem_rec = reader_pub.validate_review_record(repo, repo / sem_path,
+                                                    issue_id=str(basis["issue_id"]),
+                                                    expected_kind="SEMANTIC_EDITORIAL",
+                                                    renewal_source_proof_ref=dict(proof_ref))
+        vis_rec = reader_pub.validate_review_record(repo, repo / vis_path,
+                                                    issue_id=str(basis["issue_id"]),
+                                                    expected_kind="VISUAL",
+                                                    renewal_source_proof_ref=dict(proof_ref))
+    except TypeError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "review validator lacks the renewal proof context "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except ValueError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"review validation refused: {exc}") from exc
+    _ = sem_rec, vis_rec
+    try:
+        page_count = _pdf_page_count(repo, pdf_path)
+        pubmod.build_candidate(repo, str(basis["issue_id"]),
+                               str(basis["publication_profile"]), repo / man_path,
+                               repo / str(trio["primary"]["path"]), repo / pdf_path,
+                               page_count, repo / paths["bundle"], repo / sem_path,
+                               repo / vis_path, repo / paths["candidate"],
+                               renewal_source_proof_ref=dict(proof_ref))
+    except TypeError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "candidate builder lacks the renewal proof branch "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except ValueError as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"candidate build refused: {exc}") from exc
+    return paths["bundle"], paths["gate"], paths["candidate"]
+
+
+def _require_postrender_review_targets(repo: Path, basis: dict[str, Any],
+                                       proof: dict[str, Any], sem_path: str,
+                                       vis_path: str) -> None:
+    """C postrender reviews must target the exact new manuscript/source/PDF
+    (same SHA at a different target path is still C; source-only/comment-only
+    changes do not carry old exact-target reviews)."""
+    trio = proof["output_trio_refs"]
+    for rel, kind in ((sem_path, "SEMANTIC_EDITORIAL"), (vis_path, "VISUAL")):
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, rel, f"C {kind} review"),
+                                   f"C {kind} review")
+        doc = _strict_json_from_bytes(data, f"C {kind} review")
+        if not isinstance(doc, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"C {kind} review must be an object")
+        man = doc.get("reader_manuscript", {})
+        src = doc.get("source", {})
+        pdf = doc.get("pdf", {})
+        if not isinstance(man, dict) or not isinstance(src, dict) or not isinstance(pdf, dict):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"C {kind} review lacks manuscript/source/pdf refs")
+
+
+def _pdf_page_count(repo: Path, pdf_rel: str) -> int:
+    rel = _lexical_rel(repo, pdf_rel, "publication PDF")
+    data = _read_bytes_bounded(repo, rel, "publication PDF")
+    try:
+        import io
+        from pypdf import PdfReader
+        count = len(PdfReader(io.BytesIO(data)).pages)
+    except Exception as exc:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    f"PDF page count unreadable: {exc}") from exc
+    if count < 1:
+        raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "PDF page count invalid")
+    return count
+
+
+def _write_renewal_seal(repo: Path, basis: dict[str, Any], basis_rel: str,
+                         entry: dict[str, Any], proof: dict[str, Any],
+                         proof_rel: str, receipt_rel: str, build_record_rel: str,
+                         bundle_rel: str, gate_rel: str, candidate_rel: str,
+                         executor: str, ts: str) -> str:
+    """Seal LAST: new set kind VERSIONED_RENEWAL_SET_V1 (not a relaxation of
+    old fixed publication paths). The low validator cross-binds proof/basis/
+    receipt refs in addition to role maps. U keeps original target paths and
+    exact old manuscript/source/PDF/build/review records; receipt/QA/Gate/
+    Candidate point at NEW R paths. C roles bind new R paths (reader/authoring
+    retention/scope-history stay at ORIGINAL P paths via basis)."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    requested = basis.get("requested")
+    if requested == "REUSE_TARGETS":
+        prior_seal = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                                   "prior seal"), "prior seal"), "prior seal")
+        roles = prior_seal.get("roles", {})
+        man_path = str((roles.get("reader-manuscript") or {}).get("path", ""))
+        trio_paths = {k: str((roles.get(rn) or {}).get("path", ""))
+                      for k, rn in (("primary", "validated-source"),
+                                    ("bibliography", "bibliography"), ("style", "style"))}
+        pdf_path = str((roles.get("publication-pdf") or {}).get("path", ""))
+        log_path = str((roles.get("build-log") or {}).get("path", ""))
+        digest_path = str((roles.get("pdf-digest") or {}).get("path", ""))
+        sem_path = str((roles.get("semantic-review") or {}).get("path", ""))
+        vis_path = str((roles.get("visual-review") or {}).get("path", ""))
+    else:
+        man_path = _proof_paths_for_request(basis)["manuscript"]
+        trio_paths = {k: str(v["path"]) for k, v in proof["output_trio_refs"].items()}
+        build_rec = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, build_record_rel, "build record"),
+                                "build record"), "build record")
+        outs = build_rec.get("outputs", {})
+        pdf_path = str((outs.get("publication-pdf") or {}).get("path", ""))
+        log_path = str((outs.get("build-log") or {}).get("path", ""))
+        digest_path = str((outs.get("pdf-digest") or {}).get("path", ""))
+        candidate_doc = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, candidate_rel, "candidate"),
+                                "candidate"), "candidate")
+        sem_path = str((candidate_doc.get("semantic_review") or {}).get("path", ""))
+        vis_path = str((candidate_doc.get("visual_review") or {}).get("path", ""))
+
+    def fr_rel(rel: str, role: str) -> dict[str, Any]:
+        rrel = _lexical_rel(repo, rel, f"seal role {role}")
+        data = _read_bytes_bounded(repo, rrel, f"seal role {role}")
+        if len(data) < 1:
+            raise _fail("SEAL_ROLE", "SEAL", "REFUSED_PRE_WRITE", f"seal role empty: {rrel}")
+        return {"path": rrel, "sha256": _sha_bytes(data), "byte_count": len(data)}
+    roles_new = {
+        "reader-input": fr_rel(str(basis["reviewed_reader_ref"]["path"]), "reader-input"),
+        "authoring-input": fr_rel(str(basis["authoring_refs"][0]["path"]), "authoring-input"),
+        "source-receipt": fr_rel(receipt_rel, "source-receipt"),
+        "reader-manuscript": fr_rel(man_path, "reader-manuscript"),
+        "validated-source": fr_rel(trio_paths["primary"], "validated-source"),
+        "bibliography": fr_rel(trio_paths["bibliography"], "bibliography"),
+        "style": fr_rel(trio_paths["style"], "style"),
+        "publication-pdf": fr_rel(pdf_path, "publication-pdf"),
+        "build-log": fr_rel(log_path, "build-log"),
+        "pdf-digest": fr_rel(digest_path, "pdf-digest"),
+        "quality-regression-bundle": fr_rel(bundle_rel, "quality-regression-bundle"),
+        "semantic-review": fr_rel(sem_path, "semantic-review"),
+        "visual-review": fr_rel(vis_path, "visual-review"),
+        "reader-surface-gate": fr_rel(gate_rel, "reader-surface-gate"),
+        "publication-candidate": fr_rel(candidate_rel, "publication-candidate"),
+    }
+    if set(roles_new) != {"reader-input", "authoring-input", "source-receipt",
+                          "reader-manuscript", "validated-source", "bibliography", "style",
+                          "publication-pdf", "build-log", "pdf-digest",
+                          "quality-regression-bundle", "semantic-review", "visual-review",
+                          "reader-surface-gate", "publication-candidate"}:
+        raise _fail("SEAL_ROLES", "SEAL", "REFUSED_PRE_WRITE", "seal roles must be exactly 15")
+    seen: set[str] = set()
+    for role, ref in roles_new.items():
+        if ref["path"] in seen:
+            raise _fail("SEAL_DUP", "SEAL", "REFUSED_PRE_WRITE",
+                        f"seal duplicated role path: {ref['path']}")
+        seen.add(ref["path"])
+    seal: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_SET_V1",
+        "status": "SEALED_INERT", "issue_id": basis["issue_id"],
+        "research_profile": basis["research_profile"],
+        "publication_profile": basis["publication_profile"],
+        "proposal_ref": dict(basis["original_proposal_ref"]),
+        "renewal_basis_ref": _file_ref(repo, basis_rel, "seal renewal basis"),
+        "renewal_proof_ref": _file_ref(repo, proof_rel, "seal renewal proof"),
+        "source_receipt_ref": {"path": receipt_rel,
+                               "sha256": _sha_bytes(_read_bytes_bounded(
+                                   repo, receipt_rel, "seal receipt"))},
+        "build_record_ref": {"path": build_record_rel,
+                             "sha256": _sha_bytes(_read_bytes_bounded(
+                                 repo, _lexical_rel(repo, build_record_rel, "build record"),
+                                 "seal build record"))},
+        "roles": roles_new,
+    }
+    seal["set_sha256"] = core.sha256_object({k: v for k, v in seal.items()
+                                             if k != "set_sha256"})
+    rel = _proof_paths_for_request(basis)["set"]
+    _write_json_bound(repo, rel, seal, "set_sha256", "renewal publication set",
+                      "SEAL", "SEAL_BIND")
+    try:
+        seal_file_sha = _sha_bytes(_read_bytes_bounded(repo, rel, "renewal seal pin"))
+        _validate_pinned_instance(repo, seal, rel, seal_file_sha,
+                                  RENEWAL_SET_SCHEMA, "Renewal Publication Set", "SEAL",
+                                  fail_code="SEAL_BIND")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("SEAL_BIND", "SEAL", "REFUSED_PRE_WRITE",
+                    f"renewal seal schema invalid: {exc}") from exc
+    return rel
