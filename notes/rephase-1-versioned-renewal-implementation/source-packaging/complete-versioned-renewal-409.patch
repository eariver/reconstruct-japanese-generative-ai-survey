+class TestF1PinnedReverify(unittest.TestCase):
+    def test_f1_seam_swaps_between_check_and_reverify_weekly(self):
+        sc = Scratch("f1-seam-w", "weekly")
+        _syspath(sc.work)
+        from scripts import survey_versioned_renewal_source_v2 as src
+        basis_rel, basis = _basis_for(sc, "f1-seam-w")
+        # Healthy control first.
+        out = src.validate_renewal_basis(sc.work, basis_rel)
+        self.assertTrue(out.get("BASIS_VALID"))
+        (sc.rawdir / "f1-healthy.txt").write_text("BASIS_VALID healthy\n", encoding="utf-8")
+        # Record pre-seam file list (no-write check later).
+        pre_files = sorted(str(p.relative_to(sc.work)) for p in sc.work.rglob("*") if p.is_file() and ".git/" not in str(p))
+        # Seam: swap bytes between initial check and final reverify.
+        # Mock returns original until reverify phase starts, then swapped.
+        orig_fd = src._fd_read
+        state = {"reverify_started": False}
+
+        def _swapped(d: bytes) -> bytes:
+            if not d:
+                return b"X"
+            return d[:-1] + bytes([d[-1] ^ 0xFF])
+
+        def mocked(repo, rel, label):
+            if isinstance(label, str) and label.startswith("reverify "):
+                state["reverify_started"] = True
+                return _swapped(orig_fd(repo, rel, label))
+            if state["reverify_started"]:
+                # Old buggy code's second fresh read in final loop (normal label
+                # after reverify started) must also see swapped so old would PASS.
+                # New code has no such second read; it compares reverify(swapped)
+                # vs pinned(original) and must FAIL.
+                return _swapped(orig_fd(repo, rel, label))
+            return orig_fd(repo, rel, label)
+
+        import unittest.mock as mock
+        with mock.patch.object(src, "_fd_read", side_effect=mocked):
+            with self.assertRaises(Exception) as cm:
+                src.validate_renewal_basis(sc.work, basis_rel)
+        msg = str(cm.exception)
+        self.assertIn("BASIS_DIGEST_MISMATCH", msg, f"F1 seam must hit pinned reverify, got: {msg}")
+        self.assertIn("pinned file changed during call", msg, f"F1 must be reverify seam, got: {msg}")
+        (sc.rawdir / "f1-seam-refused.txt").write_text(msg + "\n", encoding="utf-8")
+        # Immediate no writes: file set unchanged (only rawdir outside work changed).
+        post_files = sorted(str(p.relative_to(sc.work)) for p in sc.work.rglob("*") if p.is_file() and ".git/" not in str(p))
+        self.assertEqual(pre_files, post_files, "F1 refusal must cause no writes")
+        # Repair: without mock, healthy again.
+        out2 = src.validate_renewal_basis(sc.work, basis_rel)
+        self.assertTrue(out2.get("BASIS_VALID"))
+        (sc.rawdir / "f1-repair.txt").write_text("repair PASS\n", encoding="utf-8")
+
+    def test_f1_no_global_cache_fresh_every_call(self):
+        sc = Scratch("f1-nocache-w", "weekly")
+        _syspath(sc.work)
+        from scripts import survey_versioned_renewal_source_v2 as src
+        basis_rel, basis = _basis_for(sc, "f1-nocache-w")
+        out1 = src.validate_renewal_basis(sc.work, basis_rel)
+        self.assertTrue(out1.get("BASIS_VALID"))
+        out2 = src.validate_renewal_basis(sc.work, basis_rel)
+        self.assertTrue(out2.get("BASIS_VALID"), "per-invocation pins must not use global cache")
+        # Swap file on disk between calls -> second call must fail (fresh readback).
+        target_rel = basis["accepted_refs"][0]["path"]
+        raw = (sc.work / target_rel).read_bytes()
+        try:
+            (sc.work / target_rel).write_bytes(raw + b" ")
+            with self.assertRaises(Exception) as cm:
+                src.validate_renewal_basis(sc.work, basis_rel)
+            self.assertIn("BASIS_DIGEST_MISMATCH", str(cm.exception))
+            (sc.rawdir / "f1-nocache-drift.txt").write_text(str(cm.exception) + "\n", encoding="utf-8")
+        finally:
+            (sc.work / target_rel).write_bytes(raw)
+        out3 = src.validate_renewal_basis(sc.work, basis_rel)
+        self.assertTrue(out3.get("BASIS_VALID"))
