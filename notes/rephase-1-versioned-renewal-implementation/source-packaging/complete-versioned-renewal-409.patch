+def _select_renewal_draft_archive(validated_receipt: dict[str, Any], phase: str) -> dict[str, Any]:
+    # Explicit renewal drafting-archive selection from validated authoring_refs.
+    # Renewal carries authoring_refs (same two names, different key) +
+    # reviewed_reader_ref + renewal_basis/proof/build, and has NO
+    # authored_refs/reviewed_reader_input/scope/retention/staged keys.
+    # No .get(a) or .get(b) fallback, no raw kind/digest rewrite.
+    if not isinstance(validated_receipt, dict) or validated_receipt.get("kind") != "VERSIONED_RENEWAL_SOURCE_V1":
+        raise _fail("BEFORE_RENEWAL_KIND", phase, "REFUSED_PRE_WRITE", "renewal draft selection requires VERSIONED_RENEWAL_SOURCE_V1 kind")
+    _rows = validated_receipt.get("authoring_refs")
+    if not isinstance(_rows, list):
+        raise _fail("BEFORE_AUTHORED", phase, "REFUSED_PRE_WRITE", "before renewal lacks authoring_refs list (no old-shape fallback)")
+    _by_name = {r.get("name"): r for r in _rows if isinstance(r, dict)}
+    if set(_by_name) != {"proposed-publication-authoring", "accepted-draft-archive"}:
+        raise _fail("BEFORE_AUTHORED", phase, "REFUSED_PRE_WRITE", f"before renewal authoring roles must be proposed-publication-authoring + accepted-draft-archive: {sorted(_by_name)}")
+    _draft = _by_name.get("accepted-draft-archive")
+    if not isinstance(_draft, dict) or not isinstance(_draft.get("path"), str) or not isinstance(_draft.get("sha256"), str):
