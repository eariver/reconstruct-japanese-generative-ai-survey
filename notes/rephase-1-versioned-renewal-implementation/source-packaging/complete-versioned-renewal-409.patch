+def activate_renewal(root: str | Path, state_path: str | Path, set_path: str | Path,
+                     reason: str, executor: str,
+                     recorded_at: datetime | str | None = None) -> dict[str, Any]:
+    """Explicit activation with full revalidation. After complete Candidate and
+    seal, the sole live mutation remains the existing State
+    publication_revalidation_provenance pointer: exclusive new record,
+    known-byte State temp/replace, full new active readback. Only the pointer
+    changes. A second same-reader renewal requires another genuine eligible
+    Core change and a fresh basis; retry of the exact already-active record is
+    only readonly ALREADY_ACTIVE. Truthful free-text Core-change reason
+    required; reason_class is fixed REVIEWED_VERSIONED_CORE_RENEWAL, never from
+    a CLI flag."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_agent_control_v2 as agent
+    from scripts import survey_publication_set_v2 as setmod
+    repo = Path(root).resolve()
+    if not isinstance(reason, str) or not reason.strip():
+        raise _fail("ARGS", "ACTIVATE", "REFUSED_PRE_WRITE",
+                    "truthful Core-change reason required")
+    if not isinstance(executor, str) or not executor.strip():
+        raise _fail("ARGS", "ACTIVATE", "REFUSED_PRE_WRITE", "executor required")
+    ts = _now_utc(recorded_at)
+    state_rel = _lexical_rel(repo, str(state_path), "Production State")
+    set_rel = _lexical_rel(repo, str(set_path), "renewal publication set")
+    expected_old = _read_bytes_bounded(repo, state_rel, "Production State")
+    state = _strict_json_from_bytes(expected_old, "Production State")
+    if not isinstance(state, dict):
+        raise _fail("STATE_UNREADABLE", "ACTIVATE", "REFUSED_PRE_WRITE",
+                    "Production State must be an object")
+    cfg = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, "config/survey-production-v2.json", "production config"),
+        "production config")
+    sealed = validate_prepared_renewal_set(repo, state_rel, set_rel)
+    seal = sealed["set"]
+    try:
+        selection_before = setmod.resolve_publication_selection(repo, cfg, state)
+    except Exception as exc:
+        raise _fail("SELECTION_BEFORE", "ACTIVATE", "REFUSED_PRE_WRITE",
+                    f"before selection failed: {exc}") from exc
+    try:
+        if selection_before.get("mode") == "VERSIONED_ACTIVE":
+            sel_set = selection_before.get("active_set_ref") or selection_before.get("set_ref")
+            # Selection pins carry FILE SHAs (live pins, never self-digests).
+            # Exact set/record selected path+FILE SHA and underlying identity;
+            # alias inputs REFUSE BEFORE writes, NOT ALREADY_ACTIVE by same SHA.
+            # Canonical true already-active keeps full strict CURRENT set
+            # validate/readback readonly; same helper activates/resumes before
+            # record creation; no source variable fallback aliases.
+            input_seal_sha = _sha_bytes(_read_bytes_bounded(repo, set_rel, "ALREADY_ACTIVE seal"))
+            if isinstance(sel_set, dict) and _check_already_active_set(
+                    repo, set_rel, input_seal_sha, sel_set, "ALREADY_ACTIVE set"):
+                errs = agent.validate_agent_state(repo, cfg, state)
+                if errs:
+                    raise _fail("ALREADY_ACTIVE_STATE", "ACTIVATE", "REFUSED_PRE_WRITE",
+                                "ALREADY_ACTIVE State invalid: " + "; ".join(errs))
+                validate_prepared_renewal_set(repo, state_rel, set_rel)
+                pointer = state.get("publication_revalidation_provenance")
+                if not isinstance(pointer, dict) or "path" not in pointer:
+                    raise _fail("ALREADY_ACTIVE_STATE", "ACTIVATE", "REFUSED_PRE_WRITE",
+                                "ALREADY_ACTIVE State pointer invalid")
+                return {"status": "ALREADY_ACTIVE", "record_path": pointer.get("path"),
+                        "state_path": state_rel, "observed": "new"}
+    except RenewalHighError:
+        raise
+    except Exception:
+        pass
+    proof_ref = {"path": str(seal["renewal_proof_ref"]["path"]),
+                 "sha256": str(seal["renewal_proof_ref"]["sha256"])}
+    basis_ref = {"path": str(seal["renewal_basis_ref"]["path"]),
+                 "sha256": str(seal["renewal_basis_ref"]["sha256"])}
+    basis = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, basis_ref["path"], "renewal basis"),
+                            "renewal basis"), "renewal basis")
+    authority = observe_renewal_authority(repo, state_rel, basis_ref["path"])
+    entry = authority["entry"]
+    effective7 = selection_before.get("effective7", {})
+    try:
+        digest = setmod.before_active_digest(effective7, entry["prior_candidate_ref"])
+    except Exception as exc:
+        raise _fail("SEAL_BIND", "ACTIVATE", "REFUSED_PRE_WRITE",
+                    f"before_active_digest recompute failed: {exc}") from exc
+    # Narrow fail-closed matching-intent detection BEFORE record creation.
+    # ALREADY_ACTIVE exact-set handling above stays first with full readonly
+    # validation. This scan refuses an existing INERT renewal record with the
+    # same immutable set path+SHA and same basis/before binding, directing to
+    # explicit resume only; different reason/executor/time never bypasses.
+    # Truly new sets after other inert sets still allocate the next unused
+    # sequence. Malformed/unknown/symlink/foreign records fail closed with
+    # preserve/no-delete and exact-constraint diagnostics. Scan plus the
+    # controlled O_EXCL claim below still refuses TOCTOU races; single-writer
+    # bounded only, no global CAS claim.
+    _current_set_ref = _file_ref(repo, set_rel, "activation seal")
+    _current_basis_ref = {"path": str(basis_ref["path"]), "sha256": str(basis_ref["sha256"])}
+    _current_before_ref = {"path": entry["state_rel"], "sha256": entry["state_sha"]}
+    _parent_dir = str(Path(entry["prior_record_ref"]["path"]).parent.as_posix())
+    _refuse_matching_intent_orphan(repo, _parent_dir, _current_set_ref,
+                                   _current_basis_ref, _current_before_ref,
+                                   state.get("publication_revalidation_provenance"),
+                                   "ACTIVATE")
+    record_rel = _next_record_rel(repo, entry["prior_record_ref"]["path"])
+    _lexical_rel(repo, record_rel, "activation record")
+    _walk_existing_ancestors(repo, _lexical_parts(record_rel, "activation record"),
+                             "activation record")
+    try:
+        os.lstat(repo.resolve().joinpath(*record_rel.split("/")))
+        raise _fail("RECORD_COLLISION", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "activation record already claimed (explicit resume required)")
+    except FileNotFoundError:
+        pass
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"activation record unreadable: {record_rel}: {exc}") from exc
+    _recheck_entry_pins(repo, entry, "ACTIVATE")
+    validation_ref = (state.get("checkpoint_provenance") or {}).get("validation", {})
+    record: dict[str, Any] = {
