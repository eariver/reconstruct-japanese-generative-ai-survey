+        seal_rel = pr["seal_rel"]
+        record_rel = f"sources/{sc.issue}/publication/v2/publication-surface-revalidation-r1.json"
+        basis_path = sc.work / basis_rel
+        backed = {}
+        for rel in (scope_rel, staged_rel, receipt_rel, seal_rel, record_rel, basis_rel):
+            backed[rel] = (sc.work / rel).read_bytes()
+        rival_rel = None
+        try:
+            scope = json.loads((sc.work / scope_rel).read_bytes())
+            fn(scope, sc)
+            scope["review_sha256"] = _sha_obj({k: v for k, v in scope.items() if k != "review_sha256"})
+            (sc.work / scope_rel).write_text(json.dumps(scope, indent=1, sort_keys=True), encoding="utf-8")
+            new_scope_sha = _sha_file(sc.work / scope_rel)
+            staged = json.loads((sc.work / staged_rel).read_bytes())
+            if rival:
+                rival_rel = scope_rel + ".rival.json"
+                shutil.copyfile(sc.work / scope_rel, sc.work / rival_rel)
+                staged["scope_review_ref"] = {"path": rival_rel, "sha256": _sha_file(sc.work / rival_rel)}
+            else:
+                staged["scope_review_ref"] = {"path": scope_rel, "sha256": new_scope_sha}
+            staged["manifest_digest"] = _sha_obj({k: v for k, v in staged.items() if k != "manifest_digest"})
+            (sc.work / staged_rel).write_text(json.dumps(staged, indent=1, sort_keys=True), encoding="utf-8")
+            new_staged_sha = _sha_file(sc.work / staged_rel)
+            receipt = json.loads((sc.work / receipt_rel).read_bytes())
+            if not rival:
+                receipt["scope_review_ref"] = dict(staged["scope_review_ref"])
+            receipt["staged_manifest_ref"] = {"path": staged_rel, "sha256": new_staged_sha}
+            receipt["receipt_sha256"] = _sha_obj({k: v for k, v in receipt.items() if k != "receipt_sha256"})
+            (sc.work / receipt_rel).write_text(json.dumps(receipt, indent=1, sort_keys=True), encoding="utf-8")
+            new_receipt_sha = _sha_file(sc.work / receipt_rel)
+            seal = json.loads((sc.work / seal_rel).read_bytes())
+            sr = dict(seal["roles"]["source-receipt"])
+            sr["sha256"] = new_receipt_sha
+            sr["byte_count"] = len((sc.work / receipt_rel).read_bytes())
+            seal["roles"]["source-receipt"] = sr
+            seal["staged_manifest_ref"] = {"path": staged_rel, "sha256": new_staged_sha}
+            seal["set_sha256"] = _sha_obj({k: v for k, v in seal.items() if k != "set_sha256"})
+            (sc.work / seal_rel).write_text(json.dumps(seal, indent=1, sort_keys=True), encoding="utf-8")
+            new_seal_sha = _sha_file(sc.work / seal_rel)
+            record = json.loads((sc.work / record_rel).read_bytes())
+            record["set_ref"] = {"path": seal_rel, "sha256": new_seal_sha}
+            (sc.work / record_rel).write_text(json.dumps(record, indent=1, sort_keys=True), encoding="utf-8")
+            new_record_sha = _sha_file(sc.work / record_rel)
+            basis = json.loads(basis_path.read_bytes())
+            basis["prior_selected_ref"] = {"path": seal_rel, "sha256": new_seal_sha}
