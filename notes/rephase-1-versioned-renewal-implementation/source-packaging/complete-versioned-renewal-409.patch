+def _basis_state_path(repo: Path, basis_rel: str) -> str:
+    basis = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, basis_rel, "renewal basis"), "renewal basis")
+    if not isinstance(basis, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "TARGETS", "REFUSED_PRE_WRITE",
+                    "renewal basis must be an object")
+    before = basis.get("before_state_ref", {})
+    if not isinstance(before.get("path"), str):
+        raise _fail("BASIS_DIGEST_MISMATCH", "TARGETS", "REFUSED_PRE_WRITE",
+                    "renewal basis lacks before_state_ref")
+    return str(before["path"])
