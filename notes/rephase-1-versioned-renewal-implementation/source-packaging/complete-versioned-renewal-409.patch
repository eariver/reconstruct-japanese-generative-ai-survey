+def _close_session(session: Any, phase: str, disp: str, primary: StagedSourceError | None = None) -> None:
+    """Checked close that never drops StagedSourceError diagnostics.
+
+    ``_Session._close_all`` only attaches secondaries to a ``RetentionError``
+    prior, so a ``StagedSourceError`` primary is never passed as ``prior``;
+    close failures are caught here as ``RetentionError`` and attached
+    manually (or raised when no primary is in flight).
+    """
+    try:
+        session._close_all(phase, disp)
+    except Exception as exc:
+        if primary is not None:
+            _attach_close(primary, exc)
+        else:
+            raise _fail("CLOSE_FAILED", phase, disp,
+                        f"descriptor close failed: {exc}", cause=exc) from exc
+
+
+def _snapshot_originals(session: Any, control_rels: list[str], source_root_rel: str,
+                          survey_root_rel: str, ret_rel: str, phase: str, disp: str):
+    """Full original inventory snapshot (control + edition + retained).
+
+    Uses the real snapshot helpers (no broad walk from unvalidated roots by
+    the caller). Empty dirs are included; aliases/nonregulars refuse inside
+    the helpers. Returns deep-copied plain dicts for later comparison.
+    """
+    try:
+        ctrl_files, ctrl_dirs, ctrl_sizes = retention._snapshot_expanded(
+            session, control_rels, "control", phase, disp)
+        src_files, src_dirs, src_sizes = retention._snapshot_expanded(
+            session, [source_root_rel, survey_root_rel], "edition", phase, disp)
+        ret_files, ret_dirs, ret_sizes = retention._retained_inventory(
+            session, ret_rel, phase, disp)
+    except Exception as exc:
+        if isinstance(exc, retention.RetentionError):
+            raise _fail("SNAPSHOT_FAILED", phase, disp, f"snapshot failed: {exc}",
+                        cause=exc) from exc
+        raise _fail("SNAPSHOT_FAILED", phase, disp, f"snapshot failed: {exc}",
+                    cause=exc) from exc
+    return ((dict(ctrl_files), dict(ctrl_dirs), dict(ctrl_sizes)),
+            (dict(src_files), dict(src_dirs), dict(src_sizes)),
+            (dict(ret_files), dict(ret_dirs), dict(ret_sizes)))
+
+
+def _compare_original_boundary(init_triple, session: Any, control_rels: list[str],
+                               source_root_rel: str, survey_root_rel: str, ret_rel: str,
+                               allowed_new_files: set[str], allowed_new_dirs: set[str],
+                               phase: str, disp: str, owned: dict[str, Any]) -> None:
+    """Re-inventory and compare against ORIGINAL snapshots (never rebaselined).
+
+    Deletions AND additions refuse unless exactly the admitted owned delta;
+    changed bytes/sizes/modes refuse. `Session.reverify` alone cannot see
+    newly planted files/empty dirs, so full inventories are rewalked here.
+    """
+    cur = _snapshot_originals(session, control_rels, source_root_rel, survey_root_rel,
+                              ret_rel, phase, disp)
+    labels = ("control", "edition", "retained")
+    for label, init, now in zip(labels, init_triple, cur):
+        init_files, init_dirs, init_sizes = init
+        cur_files, cur_dirs, cur_sizes = now
+        allow_files = allowed_new_files if label == "edition" else set()
+        allow_dirs = allowed_new_dirs if label == "edition" else set()
+        for rel in init_files:
+            if rel not in cur_files:
+                raise _fail("ORIGINAL_DELETED", phase, disp,
+                            f"{label} original file deleted: {rel}", owned)
+        extra_files = set(cur_files) - set(init_files)
+        if extra_files != allow_files:
+            raise _fail("ORIGINAL_DRIFT", phase, disp,
+                        f"{label} unexpected new files: {sorted(extra_files)}", owned)
+        for rel, sha in init_files.items():
+            if cur_files.get(rel) != sha:
+                raise _fail("ORIGINAL_DRIFT", phase, disp,
+                            f"{label} original file bytes changed: {rel}", owned)
+            if cur_sizes.get(rel) != init_sizes.get(rel):
+                raise _fail("ORIGINAL_DRIFT", phase, disp,
+                            f"{label} original file size changed: {rel}", owned)
+        for rel in init_dirs:
+            if rel not in cur_dirs:
+                raise _fail("ORIGINAL_DELETED", phase, disp,
+                            f"{label} original dir deleted: {rel}", owned)
+        extra_dirs = set(cur_dirs) - set(init_dirs)
+        if extra_dirs != allow_dirs:
+            raise _fail("ORIGINAL_DRIFT", phase, disp,
+                        f"{label} unexpected new dirs: {sorted(extra_dirs)}", owned)
+        for rel, mode in init_dirs.items():
+            if cur_dirs.get(rel) != mode:
+                raise _fail("ORIGINAL_DRIFT", phase, disp,
+                            f"{label} original dir mode changed: {rel}", owned)
+
+
+def _prepin_known_live_refs(live: Any, proposal_obj: dict[str, Any],
+                            phase: str, disp: str) -> tuple[dict[str, str], dict[str, str]]:
+    """Pin known explicit proposal/retention-plan live refs.
+
+    Pins via live Collector (hash-bound, no fabricated authority):
+    basis refs, proposed refs, and retention-plan live source refs. The
+    validation-checkpoint record itself is immutable-pinned (as a basis ref)
+    and its artifact rows are recorded for evidence only — they are NOT
+    live-pinned to historical sha (P1 distinguishes original checkpoint vs
+    active-before; R1 supersede legitimately changes live bytes; history is
+    covered by retained verification). Returns (retention_plan_map,
+    checkpoint_artifact_map); only the retention map is used for supplemental
+    conflict checks. Failures refuse (honest stale basis), never silently skipped.
+    """
+    retention_map: dict[str, str] = {}
+    checkpoint_map: dict[str, str] = {}
+    basis = proposal_obj.get("basis") or {}
+    for key in ("state_ref", "validation_checkpoint_ref", "active_revalidation_ref",
+                "active_reader_input_ref", "generated_receipt_ref"):
+        ref = basis.get(key)
+        if ref is None:
+            continue
+        if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+            raise _fail("BASIS_REF_SHAPE", phase, disp,
+                        f"proposal basis {key} must be exact {{path,sha256}}")
+        try:
+            # live.pinned does safe + sha equality (REF_DRIFT on mismatch).
+            live.pinned({"path": ref["path"], "sha256": ref["sha256"]},
+                        f"known basis {key}")
+        except Exception as exc:
+            # Preserve typed refusal (REF_DRIFT/PATH_*) as pre-write refusal.
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known basis {key} pin failed: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known basis {key} pin failed: {exc}") from exc
+    proposed = proposal_obj.get("proposed") or {}
+    for key in ("authoring_input_ref", "proposed_reader_ref"):
+        ref = proposed.get(key)
+        if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
+            raise _fail("PROPOSED_REF_SHAPE", phase, disp,
+                        f"proposal proposed {key} must be exact {{path,sha256}}")
+        try:
+            live.pinned({"path": ref["path"], "sha256": ref["sha256"]},
+                        f"known proposed {key}")
+        except Exception as exc:
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known proposed {key} pin failed: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known proposed {key} pin failed: {exc}") from exc
+    plan = proposal_obj.get("retention_plan")
+    if not isinstance(plan, list):
+        raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                    "proposal retention_plan must be a list")
+    for row in plan:
+        if not isinstance(row, dict):
+            raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                        "retention plan row must be an object")
+        rp = row.get("path")
+        rs = row.get("sha256")
+        if not isinstance(rp, str) or not isinstance(rs, str) or len(rs) != 64:
+            raise _fail("RETENTION_PLAN_SHAPE", phase, disp,
+                        f"retention plan row lacks exact path/sha: {row}")
+        retention_map[rp] = rs
+        try:
+            live.pinned({"path": rp, "sha256": rs},
+                        f"known retention plan {rp}")
+        except Exception as exc:
+            if isinstance(exc, ValueError) and hasattr(exc, "code"):
+                raise _fail(getattr(exc, "code", "PIN_FAILED"), phase, disp,
+                            f"known retention plan pin failed {rp}: {exc}") from exc
+            raise _fail("PIN_FAILED", phase, disp,
+                        f"known retention plan pin failed {rp}: {exc}") from exc
+    # Before-graph: validation-checkpoint record is itself immutable pinned
+    # (as a basis ref above). Its artifact rows are HISTORICAL (original
+    # checkpoint) and must NOT be required at live active paths: P1
+    # distinguishes original checkpoint (_original_checkpoint) vs active-before
+    # (_active_effective, which legitimately supersedes rows on R1 refresh —
+    # e.g. changed receipt/Gate). Requiring historical bytes live would break
+    # real R1 same-chain viability. Historical rows are checked via the actual
+    # retained representation (P2R retained verification), not live equality.
+    # Current-before exact refs come from proposal/verified retention_plan and
+    # the active-effective basis (pinned above). Record the map for evidence
+    # only; never live-pin to old sha nor conflict supplemental pins against it.
+    try:
+        vref = basis.get("validation_checkpoint_ref") or {}
+        vrel = vref.get("path")
+        vbytes = live.files.get(vrel) if isinstance(vrel, str) else None
+        if vbytes is None:
+            raise _fail("PIN_FAILED", phase, disp,
+                        "validation checkpoint bytes missing for artifact record")
+        import json as _js
+        record = _js.loads(vbytes.decode("utf-8"))
+        for art in record.get("artifacts", []) or []:
+            if not isinstance(art, dict):
+                continue
+            ap = art.get("path")
+            ah = art.get("sha256")
+            if not isinstance(ap, str) or not isinstance(ah, str) or len(ah) != 64:
+                continue
+            checkpoint_map[ap] = ah
+    except StagedSourceError:
+        raise
+    except Exception as exc:
+        raise _fail("PIN_FAILED", phase, disp,
+                    f"checkpoint artifact record read failed: {exc}") from exc
+    return retention_map, checkpoint_map
