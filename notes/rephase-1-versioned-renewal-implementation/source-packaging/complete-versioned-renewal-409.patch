+def _no_state_raise(work: Path, live_rel: str):
+    import scripts.survey_versioned_renewal_history_v2 as hist
+    real = hist.read_repo_bytes
+
+    def guarded(repo_root, rel, label):
+        if str(rel) == live_rel:
+            raise hist.RenewalHistoryError("HISTORY_BLOB_MISSING", f"patched State entry raises: {rel}")
+        return real(repo_root, rel, label)
+
+    return mock.patch.object(hist, "read_repo_bytes", side_effect=guarded)
