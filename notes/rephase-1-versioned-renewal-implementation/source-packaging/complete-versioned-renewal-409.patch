+#!/usr/bin/env python3
+"""Deterministic LONGFORM_GENERATED_V1 source rendering and receipt replay.
+
+Initial generated-Longform integration owner (LF-2I). This module is the one
+serializer/replay owner for the explicit new route:
+
+- pure ``render_main`` / ``render_bibliography`` project ONLY the reviewed
+  complete reader object (THEMATIC_FOUR_FAMILY_LINEAGE_V1) into exact
+  main.tex / references.bib bytes. Every semantic value (titles, display
+  dates/prefixes, cover/frontmatter/revision text, labels/kickers/table
+  headers, note URLs, final summary, bibliography, citation placement/order)
+  comes from the reviewed surface. Structural TeX commands mirror the
+  reference layout inventory; no post-review Draft/body/sidecar reread and no
+  arbitrary TeX escape hatch;
+- pure ``tex_escape`` reuse only (from ``render_article_draft_tex``). The
+  legacy publication writer (``run_semantic_publication_v2_interactive`` and
+  its base) is never imported or invoked here;
+- ``build_receipt`` / ``validate_receipt`` own the strict Longform source
+  receipt (``LONGFORM_GENERATED_V1``). Public replay itself reloads and
+  validates the persisted semantic review independently of the outer Gate
+  (contract F1), then re-derives the reader object and replays deterministic
+  output bytes;
+- ``verify_tool_basis`` pins the exact committed implementation closure.
+  Testing may materialize the exact selected bytes in fresh independent
+  synthetic committed Git fixtures; production dirty/untracked-source checks
+  stay strict.
+"""
+from __future__ import annotations
+
+import re
+import subprocess
+from pathlib import Path
+from typing import Any
+
+from scripts import survey_longform_derivation_v2 as longform
+from scripts import survey_production_v2 as core
+from scripts import survey_reader_surface_gate_v2 as surface_gate
+from scripts import survey_schema_v2 as schema_gate
+from scripts.render_article_draft_tex import tex_escape
+
+
+RECEIPT_SCHEMA = Path("schemas/longform-publication-source-manifest-v2.schema.json")
+STYLE_PATH = Path("templates/survey/jgaisurvey.sty")
+ROUTE = "LONGFORM_GENERATED_V1"
+SCOPE = "LONGFORM_MAIN_BIB_STYLE"
+LONGFORM_BUILD_INPUTS = {"main.tex", "references.bib", "jgaisurvey.sty"}
+LONGFORM_BUILD_OUTPUTS = {"main.pdf", "main.log", "main.pdf.sha256"}
+# Explicit new-route closure. Unlisted shared helpers (agent/stage/drafting/
+# evidence loaders, quality/fidelity/manuscript producers) are still bound by
+# the control-roots + configured contract-file equality/ancestry check inside
+# verify_tool_basis, so no unlisted change is exempt.
+CURRENT_CLOSURE = (
+    Path("scripts/survey_longform_generated_v2.py"),
+    Path("scripts/survey_longform_semantic_publication_v2.py"),
+    Path("scripts/survey_longform_derivation_v2.py"),
+    Path("scripts/survey_drafting_citation_refs_v2.py"),
+    Path("scripts/survey_bibliography_access_provenance_v2.py"),
+    Path("scripts/render_article_draft_tex.py"),
+    Path("schemas/longform-reader-input-v2.schema.json"),
+    Path("schemas/longform-publication-source-manifest-v2.schema.json"),
+    Path("schemas/reader-surface-semantic-review-v2.schema.json"),
+    Path("schemas/reader-surface-gate-v2.schema.json"),
+    Path("scripts/survey_reader_surface_gate_v2.py"),
+    Path("scripts/survey_production_v2.py"),
+    Path("scripts/survey_schema_v2.py"),
+    STYLE_PATH,
+    Path("scripts/survey_publication_set_v2.py"),
+    Path("scripts/survey_editorial_publication_v2.py"),
+    Path("scripts/survey_editorial_current_authority_v2.py"),
+    Path("schemas/editorial-publication-source-manifest-v2.schema.json"),
+    Path("schemas/editorial-publication-set-v2.schema.json"),
+    Path("schemas/editorial-publication-build-record-v2.schema.json"),
+    Path("schemas/editorial-manuscript-spec-v2.schema.json"),
+    Path("schemas/editorial-toolchain-spec-v2.schema.json"),
+    Path("schemas/reader-manuscript-v2.schema.json"),
+    Path("schemas/publication-surface-revalidation.schema.json"),
+    Path("schemas/quality-regression-bundle-v2.schema.json"),
+    Path("schemas/publication-candidate-v2.schema.json"),
+    Path(".latexmkrc"),
+    Path("scripts/survey_versioned_renewal_history_v2.py"),
+    Path("scripts/survey_versioned_renewal_source_v2.py"),
+    Path("scripts/survey_versioned_renewal_v2.py"),
+    Path("schemas/versioned-renewal-basis-v2.schema.json"),
+    Path("schemas/versioned-renewal-source-proof-v2.schema.json"),
+    Path("schemas/versioned-renewal-source-manifest-v2.schema.json"),
+    Path("schemas/versioned-renewal-publication-set-v2.schema.json"),
+)
+
+
+def _rel(root: Path, path: Path) -> str:
+    return str(path.resolve().relative_to(root.resolve())).replace("\\", "/")
+
+
+def _lexical_join(root: Path, raw: str | Path) -> Path:
+    # Raw lexical join without resolving: preserves alias information until
+    # explicit leaf/ancestor checks complete. Absolute inputs are rejected by
+    # callers via containment (all LF-2I paths are repo-relative or root-joined).
+    path = Path(raw)
+    if path.is_absolute():
+        return path
+    return root / path
+
+
+def _check_ancestors_no_symlink(root_resolved: Path, lexical: Path, label: str, raw: object) -> None:
+    # Ancestor check on lexical components via lstat (is_symlink does not
+    # follow the final component; ancestors are checked component by
+    # component so a symlinked parent is refused before any resolve).
+    try:
+        rel_parent = lexical.parent.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    current = root_resolved
+    for part in rel_parent.parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+        current = current / part
+        # lstat-style check: do not follow; a symlinked ancestor refuses.
+        if current.is_symlink():
+            raise ValueError(f"{label} has symlinked ancestor component: {current}")
+
+
+def _safe(root: Path, raw: str | Path, label: str) -> Path:
+    # Strict raw-first containment: leaf alias (including dangling) is refused
+    # before any resolve, then ancestors, then resolved containment. The raw
+    # lexical path is retained until both checks complete.
+    import os as _os
+
+    root_resolved = root.resolve()
+    lexical = _lexical_join(root_resolved, raw) if not Path(raw).is_absolute() else Path(raw)
+    # Absolute raw paths must still be contained; refuse traversal components.
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    for part in lexical.relative_to(root_resolved).parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+    _check_ancestors_no_symlink(root_resolved, lexical, label, raw)
+    # Leaf alias check BEFORE resolve: explicit review/state/input/surface file
+    # aliases (including dangling destinations) refuse here with no writes.
+    if _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    resolved = lexical.resolve()
+    try:
+        resolved.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"{label} escapes repository: {raw}") from exc
+    if resolved.is_symlink() or not resolved.is_file():
+        raise ValueError(f"{label} missing or unsafe: {raw}")
+    return resolved
+
+
+def _strict_dir_preflight(root: Path, raw: str | Path, label: str) -> Path:
+    # Directory preflight BEFORE any mkdir/write: refuses leaf aliases
+    # (including dangling), symlinked ancestors, traversal and escapes. Returns
+    # the lexical directory path (not resolved) so mkdir operates on the
+    # validated lexical location.
+    import os as _os
+
+    root_resolved = root.resolve()
+    lexical = _lexical_join(root_resolved, raw) if not Path(raw).is_absolute() else Path(raw)
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    for part in lexical.relative_to(root_resolved).parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+    # Ancestors of the directory itself (parent chain).
+    _check_ancestors_no_symlink(root_resolved, lexical, label, raw)
+    if _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    resolved = lexical.resolve()
+    try:
+        resolved.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"{label} escapes repository: {raw}") from exc
+    if resolved != lexical and _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    return lexical
+
+
+def _artifact(root: Path, name: str, path: Path) -> dict[str, str]:
+    safe = _safe(root, path, name)
+    return {"name": name, "path": _rel(root, safe), "sha256": core.sha256_file(safe)}
+
+
+def validate_survey_build_directory(root: Path, raw_survey_root: str) -> Path:
+    """Admit only declared local inputs and known non-input Longform outputs."""
+    import os as _os
+
+    raw = Path(raw_survey_root)
+    try:
+        resolved = core.repo_local_path(root, raw_survey_root, "Longform survey build directory")
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"Longform survey build directory path invalid: {exc}") from exc
+    root_resolved = root.resolve()
+    lexical = root_resolved / raw
+    # Raw-first leaf/ancestor alias refusal before any existence/resolve branch.
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"Longform survey build directory escapes repository: {raw}") from exc
+    for part in raw.parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"Longform survey build directory has unsafe path component: {part}")
+    current = root_resolved
+    for component in raw.parts:
+        current = current / component
+        if current.is_symlink():
+            raise ValueError(f"Longform survey build directory has symlinked component: {current}")
+    if _os.path.islink(lexical):
+        raise ValueError(f"Longform survey build directory leaf alias is unsafe: {raw}")
+    if lexical != resolved:
+        raise ValueError("Longform survey build directory is not at its physical canonical path")
+    if not _os.path.lexists(lexical):
+        return lexical
+    if not lexical.is_dir() or _os.path.islink(lexical):
+        raise ValueError("Longform survey build directory is not a directory")
+    allowed = LONGFORM_BUILD_INPUTS | LONGFORM_BUILD_OUTPUTS
+    for entry in lexical.iterdir():
+        if entry.is_symlink() or not entry.is_file() or entry.name not in allowed:
+            raise ValueError(f"Longform survey build directory contains undeclared entry: {entry.name}")
+    return lexical
+
+
+def _cite(ids: list[str], bib_key_by_did: dict[str, str]) -> str:
+    keys = []
+    for did in ids:
+        key = bib_key_by_did.get(did)
+        if key is None:
+            raise ValueError(f"citation Discovery ID has no reviewed bibliography key: {did}")
+        keys.append(key)
+    return "" if not keys else " \\cite{" + ",".join(keys) + "}"
+
+
+# Finite serializer syntax: headings that become \section{}/\subsection*{}
+# titles must round-trip through the existing fidelity parser
+# (_HEADING requires [^{}]+, i.e. no braces). tex_escape maps { } \ ~ ^ to
+# sequences containing braces (\{ \} \textbackslash{} \textasciitilde{}
+# \textasciicircum{}), which the parser cannot resolve. Those raw characters
+# therefore refuse BEFORE any write. Optional [...] titles (claimboundary,
+# themeoverview, technicalnote) additionally refuse ']' (and newlines), since
+# plain tex_escape is not an optional-argument policy. No universal parser is
+# introduced and fidelity is not weakened.
+_HEADING_UNSAFE = set("{}~^\\")
+_OPTIONAL_ARG_UNSAFE = set("[]\n\r")
+
+
+def _check_heading(label: str, value: Any) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{label} must be a non-empty string")
+    for char in value:
+        if char in _HEADING_UNSAFE:
+            raise ValueError(
+                f"{label} carries an unsupported TeX heading character {char!r}: "
+                "headings with braces/backslash/tilde/circumflex cannot be traced "
+                "by the existing fidelity parser; refusing before writes"
+            )
+        if ord(char) < 32 or ord(char) == 127:
+            raise ValueError(f"{label} carries an unsupported control character")
+    return value
+
+
+def _check_optional_arg(label: str, value: Any) -> str:
+    _check_heading(label, value)
+    for char in str(value):
+        if char in _OPTIONAL_ARG_UNSAFE:
+            raise ValueError(
+                f"{label} carries an unsupported optional-argument delimiter {char!r}; "
+                "refusing before writes"
+            )
+    return str(value)
+
+
+def validate_heading_syntax(surface: dict[str, Any]) -> None:
+    """Finite pre-write heading/delimiter safety over the reviewed surface."""
+    try:
+        visible = surface["visible_text"]
+        front = surface["frontmatter"]
+        cross = surface["cross_family_synthesis"]
+        summary = surface["final_summary"]
+    except (KeyError, TypeError) as exc:
+        raise ValueError(f"reviewed Longform reader object envelope invalid: {exc}") from exc
+    # Trusted visible constants that still enter TeX optional args / headings.
+    for key in ("frontmatter_boundary", "claim_boundary", "theme_overview_title",
+                "timeline_heading", "technical_notes_heading", "cross_comparison_title",
+                "cross_family_kicker", "toc_title"):
+        if key in ("frontmatter_boundary", "claim_boundary", "theme_overview_title",
+                   "cross_comparison_title"):
+            _check_optional_arg(f"visible_text.{key}", visible.get(key, ""))
+        elif key in visible:
+            _check_heading(f"visible_text.{key}", visible[key])
+    _check_heading("frontmatter.heading", front.get("heading", ""))
+    for package in surface.get("packages", []):
+        pid = package.get("package_id", "?")
+        # Canonical safe package/comment token validated before unescaped emission.
+        import re as _re
+
+        if not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", str(package.get("package_id", ""))):
+            raise ValueError(f"unsupported Longform package token for comment emission: {pid!r}")
+        _check_heading(f"{pid}.headline", package.get("headline", ""))
+        _check_heading(f"{pid}.kicker", package.get("kicker", ""))
+        for pos, section in enumerate(package.get("narrative_sections", [])):
+            _check_heading(f"{pid}.narrative_sections[{pos}].heading", section.get("heading", ""))
+        _check_heading(f"{pid}.synthesis.heading", package.get("synthesis", {}).get("heading", ""))
+        for pos, note in enumerate(package.get("technical_notes", [])):
+            _check_optional_arg(f"{pid}.technical_notes[{pos}].title", note.get("title", ""))
+    _check_heading("cross_family_synthesis.heading", cross.get("heading", ""))
+    _check_heading("final_summary.heading", summary.get("heading", ""))
+
