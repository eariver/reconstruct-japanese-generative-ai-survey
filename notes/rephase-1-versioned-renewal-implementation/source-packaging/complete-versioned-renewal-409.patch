+    def test_fault_primary_read_close_secondary_preserved(self) -> None:
+        # S2b: a primary read error plus intermediate-directory close
+        # failures preserves the primary code (PATH_UNREADABLE) and attaches
+        # the secondary close failures to its structured report instead of
+        # replacing it with CLOSE_FAILED.
+        scratch, root = self._fresh_weekly("jgas-p2r-primsec-")
+        helper = p1t._new_weekly_helper(self, root)
+        built = p1t._build_weekly_validated(self, helper)
+        chain, state_path = built["chain"], built["state_path"]
+
+        def _mut():
+            authored = core.load_json(chain["authored_path"])
+            authored["cover"]["headline"] = "Weekly primsec test, revised edition"
+            return authored
+
+        pp, _ = _prepare_proposal_for(self, root, helper, chain, state_path, "fixture-wk-ps2-1", _mut)
+        real_read = os.read
+        real_close = os.close
+        orig_open = os.open
+        fd_path: dict[int, str] = {}
+        dirfds: set[int] = set()
+        # Arm close-failures ONLY once the proposal leaf itself opens: all
+        # earlier reads (State/config/Profile + their closes) must complete
+        # normally so the proposal read is genuinely reached; otherwise the
+        # very first read would die with CLOSE_FAILED and no primary would
+        # ever exist. Ancestor + root closes after arming then fail as
+        # secondaries to the proposal-read primary.
+        armed = {"on": False}
+
+        def _open_rec(name, *a, **k):
+            fd = orig_open(name, *a, **k)
+            flags = a[0] if a else k.get("flags", 0)
+            try:
+                if flags & os.O_DIRECTORY:
+                    dirfds.add(fd)
+            except Exception:
+                pass
+            try:
+                sname = name if isinstance(name, str) else os.fsdecode(name)
+            except Exception:
+                sname = "?"
+            try:
+                is_dir_open = bool(flags & os.O_DIRECTORY)
+            except Exception:
+                is_dir_open = False
+            if sname == "proposal.json" and not is_dir_open:
+                armed["on"] = True
+            parent = k.get("dir_fd")
+            if parent is None:
+                fd_path[fd] = sname
+            else:
+                fd_path[fd] = (fd_path.get(parent, "?") + "/" + sname).replace("//", "/")
+            return fd
+
+        def _read_fail_proposal(fd, n):
+            if fd_path.get(fd, "").endswith("proposal.json"):
+                raise OSError("injected primary read failure")
+            return real_read(fd, n)
+
+        def _close_fail_dirs(fd):
+            if armed["on"] and fd in dirfds:
+                raise OSError("injected intermediate dir close failure")
+            return real_close(fd)
+
+        snap = _snapshot(root)
+        with mock.patch("os.open", side_effect=_open_rec):
+            with mock.patch("os.read", side_effect=_read_fail_proposal):
+                with mock.patch("os.close", side_effect=_close_fail_dirs):
+                    with self.assertRaisesRegex(RetentionError, "PATH_UNREADABLE") as ctx:
+                        retention.capture_retention(root, state_path, pp)
+        self.assertEqual(ctx.exception.code, "PATH_UNREADABLE")
+        secondaries = ctx.exception.owned.get("secondary_close_errors", [])
+        self.assertTrue(secondaries, "secondary close failures were discarded")
+        _assert_no_write(self, snap, _snapshot(root), "primary+secondary pre-write no-write")
