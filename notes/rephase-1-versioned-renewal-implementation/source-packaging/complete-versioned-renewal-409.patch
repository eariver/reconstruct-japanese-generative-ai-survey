+def _prior(sc: Scratch) -> dict:
+    pdir = f"sources/{sc.issue}/publication/v2/editorial-corrections/{sc.prop}"
+    seal_rel = f"{pdir}/publication/publication-set.json"
+    seal = sc.j(seal_rel)
+    receipt_rel = seal["roles"]["source-receipt"]["path"]
+    receipt = sc.j(receipt_rel)
+    staged_rel = receipt["staged_manifest_ref"]["path"]
+    staged = sc.j(staged_rel)
+    proposal_rel = receipt["proposal_ref"]["path"]
+    proposal = sc.j(proposal_rel)
+    return {"seal_rel": seal_rel, "seal": seal, "receipt_rel": receipt_rel, "receipt": receipt,
+            "staged_rel": staged_rel, "staged": staged, "proposal_rel": proposal_rel, "proposal": proposal}
