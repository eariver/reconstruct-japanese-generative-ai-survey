+def _check_supplied_review_is_predecessor(repo: Path, basis: dict[str, Any],
+                                          entry: dict[str, Any],
+                                          semantic_path: str | Path | None,
+                                          visual_path: str | Path | None) -> None:
+    """U with explicit review args: each must equal the exact predecessor record
+    ref (same path+SHA as the prior seal's semantic/visual roles). A replacement
+    review at a different path is never silently treated as reused."""
+    from scripts import survey_production_v2 as core
+    prior_seal_rel = basis["prior_selected_ref"]["path"]
+    seal = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, prior_seal_rel, "prior seal"),
+                            "prior seal"), "prior seal")
+    roles = seal.get("roles", {})
+    for arg, role_name in ((semantic_path, "semantic-review"), (visual_path, "visual-review")):
+        if arg is None:
+            continue
+        rel = _lexical_rel(repo, str(arg), f"supplied {role_name}")
+        data = _read_bytes_bounded(repo, rel, f"supplied {role_name}")
+        role = roles.get(role_name)
+        if not isinstance(role, dict) or role.get("path") != rel \
+                or role.get("sha256") != _sha_bytes(data):
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"supplied U {role_name} is not the exact predecessor record "
+                        f"(replacement reviews at different paths refuse)")
+
