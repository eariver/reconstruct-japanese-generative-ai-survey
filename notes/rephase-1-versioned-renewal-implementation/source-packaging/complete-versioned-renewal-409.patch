+        obs.observe_current_authority(root, pair["state_path"], pair["proposal_path"], pair["manifest_path"])
+        fds_after = set(os.listdir("/proc/self/fd"))
+        self.assertEqual(fds_after, fds_before, "fd leak across observe")
+        # (a) Success-path close fault at the known session boundary:
+        # fail ONLY _Session._close_all calls (stack-checked), really closing
+        # each fd before simulating the error (no leaks, no early read-close
+        # interference). On the success path exactly 3 _close_all calls occur
+        # (2 P2R-internal verify sessions + 1 outer final); the fault fires on
+        # the 3rd (outer final). Any other count fails explicitly.
+        import traceback as _tb
+        real_close = os.close
+        calls_a: list[str] = []
+        seen_a: list[int] = []
+
+        def _close_fail_outer_final(fd: int) -> None:
+            if any(fr.name == "_close_all" for fr in _tb.extract_stack()):
+                calls_a.append("close_all")
+                # Outer final is the 3rd _close_all on the success path.
+                if len(calls_a) == 3:
+                    seen_a.append(fd)
+                    try:
+                        real_close(fd)
+                    except OSError:
+                        pass
+                    raise OSError("injected P2V outer-final close fault")
+            return real_close(fd)
+
+        fds_pre_a = set(os.listdir("/proc/self/fd"))
+        with mock.patch.object(retention.os, "close", side_effect=_close_fail_outer_final):
+            with self.assertRaisesRegex(obs.CurrentAuthorityError, "CLOSE_FAILED"):
+                obs.observe_current_authority(root, pair["state_path"],
+                                              pair["proposal_path"], pair["manifest_path"])
+        self.assertEqual(len(calls_a), 3,
+                         f"success-path _close_all count changed (got {len(calls_a)}); "
+                         "fault may not have targeted the outer final")
+        self.assertTrue(seen_a, "outer-final close fault never fired")
+        fds_post_a = set(os.listdir("/proc/self/fd"))
+        self.assertEqual(fds_post_a, fds_pre_a, "fd leak after success-path close fault")
+        # Success again after fault (proves no lingering corruption).
+        before2 = p1t._snapshot(root)
+        out2 = obs.observe_current_authority(root, pair["state_path"], pair["proposal_path"], pair["manifest_path"])
+        self.assertEqual(out2["result"], "CURRENT_BASIS_OBSERVED_NEEDS_SCOPE")
+        p1t._assert_no_write(self, before2, p1t._snapshot(root), "post-fault success no-write")
+        # (b) Primary preserved with secondary close failure at the session
+        # boundary: a pre-observe KEEP mutation deterministically raises
+        # REF_DRIFT at the first retained re-pin (RETAINED phase, observer
+        # session still open); the outer _close_all (2nd _close_all call:
+        # 1 P2R-internal + 1 outer) then fails after really closing, so the
+        # primary code must survive with secondaries attached (not replaced
+        # by CLOSE_FAILED).
+        manifest_obj = core.load_json(pair["manifest_path"])
+        keep_row = next(r for r in manifest_obj["rows"] if r["policy"] == "KEEP_IMMUTABLE")
+        keep_path = root / keep_row["retained_ref"]["path"]
+        keep_rel = keep_row["retained_ref"]["path"]
+        keep_orig = keep_path.read_bytes()
+        calls_b: list[str] = []
+        seen_b: list[int] = []
+        before_mut = p1t._snapshot(root)
+        keep_path.write_bytes(keep_orig + b"\n")
+        mutated_b = p1t._snapshot(root)
+        self.assertNotEqual(mutated_b["files"].get(keep_rel), before_mut["files"].get(keep_rel))
+
+        def _close_fail_outer_only(fd: int) -> None:
+            if any(fr.name == "_close_all" for fr in _tb.extract_stack()):
+                calls_b.append("close_all")
+                # Outer session close is the 2nd _close_all on this path
+                # (1 P2R-internal verify session + 1 outer).
+                if len(calls_b) == 2:
+                    seen_b.append(fd)
+                    try:
+                        real_close(fd)
+                    except OSError:
+                        pass
+                    raise OSError("injected P2V secondary close fault")
+            return real_close(fd)
+
+        fds_pre_b = set(os.listdir("/proc/self/fd"))
+        try:
+            with mock.patch.object(retention.os, "close", side_effect=_close_fail_outer_only):
+                with self.assertRaises(obs.CurrentAuthorityError) as ctx:
+                    obs.observe_current_authority(root, pair["state_path"],
+                                                  pair["proposal_path"], pair["manifest_path"])
+            self.assertEqual(len(calls_b), 2,
+                             f"primary-path _close_all count changed (got {len(calls_b)})")
+            self.assertTrue(seen_b, "outer secondary close fault never fired")
+            err = ctx.exception
+            self.assertEqual(err.code, "REF_DRIFT",
+                             f"primary REF_DRIFT must be preserved (got: {err})")
+            self.assertIn("secondary closes", err.detail,
+                          "secondary close failures must be attached to primary")
+            # Injected-only delta BEFORE repair (KEEP +1 byte; observer wrote
