+def _build_renewal_manuscript(repo: Path, basis: dict[str, Any], entry: dict[str, Any],
+                              built: dict[str, Any], proof_ref: dict[str, str],
+                              manuscript_rel: str) -> None:
+    """C manuscript carrying the mutually exclusive renewal_source ref to the
+    source proof (XOR with editorial_source; never edits an old manuscript)."""
+    from scripts import survey_reader_publication_v2 as reader_pub
+    from datetime import datetime
+    prior_seal = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, basis["prior_selected_ref"]["path"],
+                                               "prior seal"), "prior seal"), "prior seal")
+    prior_man_path = str((prior_seal.get("roles", {}) or {}).get("reader-manuscript", {})
+                         .get("path", ""))
+    if not prior_man_path:
+        raise _fail("REVIEW_TARGET_MISMATCH", "BUILD", "REFUSED_PRE_WRITE",
+                    "prior seal lacks reader-manuscript role")
+    prior_man = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, prior_man_path, "prior manuscript"),
+                            "prior manuscript"), "prior manuscript")
+    # C manuscript binds the NEW R trio (proof output trio), keeping the prior
+    # manuscript's authority/coverage/requirement fields (same reader). It must
+    # NOT bind old trio paths (that would be U, not C). Trio paths derive from
+    # the basis namespace/id (same formula as the C proof assembly).
+    _trio_prefix = f"{basis['proposal_namespace']}/renewals/{basis['renewal_id']}/staged-source"
+    new_trio = {"primary": f"{_trio_prefix}/main.tex",
+                "bibliography": f"{_trio_prefix}/references.bib",
+                "style": f"{_trio_prefix}/jgaisurvey.sty"}
+    try:
+        reader_pub.build_manuscript_manifest(
+            repo, str(basis["issue_id"]),
+            repo / str((prior_man.get("production_profile") or {}).get("path", "")),
+            repo / str((prior_man.get("architecture") or {}).get("path", "")),
+            repo / str((prior_man.get("architecture_approval") or {}).get("path", "")),
+            repo / str(new_trio["primary"]),
+            [{"role": "BIBLIOGRAPHY", "path": str(new_trio["bibliography"])},
+             {"role": "STYLE", "path": str(new_trio["style"])}],
+            list(prior_man.get("architecture_coverage", [])),
+            list(prior_man.get("reader_requirements", [])),
+            str(prior_man.get("authored_by", "renewal")),
+            datetime.fromisoformat(ts_now()),
+            repo / manuscript_rel,
+            renewal_source=dict(proof_ref),
+        )
+    except TypeError as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    "manuscript builder lacks the renewal_source branch "
+                    "(consumer integration required): "
+                    f"{exc}") from exc
+    except ValueError as exc:
+        raise _fail("RENEWAL_PROOF_DIGEST", "BUILD", "REFUSED_PRE_WRITE",
+                    f"C manuscript build refused: {exc}") from exc
+
+
+def ts_now() -> str:
+    return _now_utc(None)
+
