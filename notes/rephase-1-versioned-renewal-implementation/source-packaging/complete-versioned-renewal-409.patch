+    base_keys = ["schema_version", "issue_id", "research_profile", "publication_profile",
+                 "status", "production_profile", "architecture", "architecture_approval",
+                 "primary_source", "supporting_files", "architecture_coverage",
+                 "reader_requirements", "authored_by", "recorded_at"]
+    if "editorial_source" in payload:
+        base_keys.append("editorial_source")
+    if "renewal_source" in payload:
+        base_keys.append("renewal_source")
+    return {k: payload[k] for k in base_keys}
