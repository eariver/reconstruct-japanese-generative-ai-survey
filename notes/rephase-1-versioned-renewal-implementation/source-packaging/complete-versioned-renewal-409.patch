+    except Exception as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"post-activation selection failed (preserved): {exc}") from exc
+    if selection_after.get("mode") != "VERSIONED_ACTIVE":
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "post-activation selection is not VERSIONED_ACTIVE (preserved)")
+    validate_prepared_renewal_set(repo, state_rel, set_rel)
+    return {"status": "ACTIVATED", "record_path": record_rel_out, "state_path": state_rel,
+            "set_path": set_rel, "observed": "new"}
