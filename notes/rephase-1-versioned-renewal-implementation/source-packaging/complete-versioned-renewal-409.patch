+def _durable_base() -> Path:
+    """Durable evidence base OUTSIDE fixture TemporaryDirectory cleanup.
+
+    When the runner provides P3S_DURABLE_OUTDIR it must point to the runner's
+    new ``outdir/fixture-raw`` directory so raw/meta are collected via a known
+    path; otherwise fallback is explicitly ``/tmp/opencode``. The directory is
+    never automatically cleaned up; evidence persists for the packet.
+    """
+    import hashlib as _hl
+    env_dir = os.environ.get("P3S_DURABLE_OUTDIR")
+    if env_dir:
+        base = Path(env_dir)
+        base.mkdir(parents=True, exist_ok=True)
+        return base
+    base = Path("/tmp/opencode")
+    base.mkdir(parents=True, exist_ok=True)
+    return base
+
+
+def _launch_durable_child(root: Path, script: str, args: list[str], timeout_s: int,
+                          label: str) -> dict:
+    """Common durable launcher: xb outputs BEFORE Popen, direct child fds.
+
+    Opens exclusive ``xb`` stdout/stderr files BEFORE launch and passes the
+    open fds directly to the child (no PIPE-then-write-after-communicate).
+    Entire lifecycle (Popen, pre-meta, wait, kill/reap, flush/close/readback,
+    final meta) runs under a single try/finally with ``proc=None``/``rc=None``
+    and explicit open-handle state, so a launch/pre-meta/interrupt/timeout
+    failure always kills+reaps the owned child group (when started) and retains
+    primary+secondary diagnostics. Flush/close/readback persistence failures
+    propagate as helper failures (never a bare rc0 acceptance), and a throwing
+    final-meta write never silently replaces an in-flight primary. Saves the
+    exact script text, its sha256, and the actual argv/cwd/sanitized env for
+    evidence. Returns terminal status plus durable paths and full bytes.
+    Timeouts are selected conservative operational bounds only (1800/600/1800/60),
+    not measured sufficiency and conferring no margin proof.
+    """
+    import hashlib as _hl
+    import time as _time
+    import signal as _signal
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_") and k != "PYTHONPATH"}
+    env.update({"GIT_NO_LAZY_FETCH": "1", "GIT_OPTIONAL_LOCKS": "0", "GIT_ALLOW_PROTOCOL": "file",
+                "PYTHONDONTWRITEBYTECODE": "1"})
+    proc = None
+    rc = None
+    fb_out = None
+    fb_err = None
+    out_b: bytes = b""
+    err_b: bytes = b""
+    primary: BaseException | None = None
+    timed_out = False
+    interrupted = False
+    close_secondaries: list[str] = []
+    base = None
+    call_dir = None
+    stdout_p = stderr_p = script_p = meta_pre_p = meta_final_p = None
+    started = _time.time()
+    script_b = script.encode("utf-8")
+    script_sha = _hl.sha256(script_b).hexdigest()
+    argv = [sys.executable, "-c", script, *args]
+    pre_meta: dict = {}
+    try:
+        base = _durable_base()
+        call_dir = Path(tempfile.mkdtemp(prefix=f"p3s-{label}-", dir=str(base)))
+        stdout_p = call_dir / "child.stdout.bin"
+        stderr_p = call_dir / "child.stderr.bin"
+        script_p = call_dir / "child.script.py"
+        meta_pre_p = call_dir / "child.meta_pre.json"
+        meta_final_p = call_dir / "child.meta.json"
+        # Save exact script bytes for evidence (no truncation).
+        with open(script_p, "xb") as _sf:
+            _sf.write(script_b)
+        # Exclusive xb outputs BEFORE Popen (fail-closed if the path exists).
+        # Direct child fd output (no PIPE).
+        try:
+            fb_out = open(stdout_p, "xb")
+        except OSError as exc:
+            raise OSError(f"durable stdout xb open failed: {exc}") from exc
+        try:
+            fb_err = open(stderr_p, "xb")
+        except OSError as exc:
+            # First handle already opened: close it and record, then propagate.
+            try:
+                fb_out.close()
+            except OSError as _ce:
+                close_secondaries.append(f"stdout-close-after-stderr-open-fail: {_ce}")
+            fb_out = None
+            raise OSError(f"durable stderr xb open failed: {exc}") from exc
+        try:
+            proc = subprocess.Popen(argv, cwd=root, stdout=fb_out, stderr=fb_err,
+                                    env=env, start_new_session=True, text=False)
+        except Exception as exc:
+            primary = exc
+            raise
+        # Exclusive pre-launch meta with pid/running record immediately.
+        pre_meta = {"label": label, "argv": [sys.executable, "-c", f"<{label}-script-sha256:{script_sha[:16]}>", *args],
+                    "actual_argc": len(argv), "cwd": str(root), "pid": proc.pid, "pgid": proc.pid,
+                    "running": True, "timeout_s": timeout_s, "started": started,
+                    "script": str(script_p), "script_sha256": script_sha, "script_bytes": len(script_b),
+                    "stdout": str(stdout_p), "stderr": str(stderr_p),
+                    "env": {"GIT_NO_LAZY_FETCH": "1", "GIT_OPTIONAL_LOCKS": "0",
+                            "GIT_ALLOW_PROTOCOL": "file", "PYTHONDONTWRITEBYTECODE": "1"}}
+        try:
+            with open(meta_pre_p, "x", encoding="utf-8") as _pf:
+                _pf.write(json.dumps(pre_meta, indent=2, sort_keys=True) + "\n")
+        except Exception as exc:
+            if primary is None:
+                primary = exc
+            # Owned child already started: kill+reap before propagating.
+            try:
+                os.killpg(proc.pid, _signal.SIGTERM)
+            except OSError:
+                pass
+            try:
+                proc.wait(timeout=10)
+            except Exception:
+                try:
+                    os.killpg(proc.pid, _signal.SIGKILL)
+                except OSError:
+                    pass
+                try:
+                    proc.wait(timeout=10)
+                except Exception as _reap2:
+                    close_secondaries.append(f"reap-after-premeta-fail: {_reap2}")
+            raise
+        try:
+            try:
+                rc = proc.wait(timeout=timeout_s)
+            except subprocess.TimeoutExpired as exc:
+                primary = exc
+                timed_out = True
+                try:
+                    os.killpg(proc.pid, _signal.SIGTERM)
+                except OSError as _e:
+                    close_secondaries.append(f"killpg-TERM-after-timeout: {_e}")
+                try:
+                    rc = proc.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    try:
+                        os.killpg(proc.pid, _signal.SIGKILL)
+                    except OSError as _e2:
+                        close_secondaries.append(f"killpg-KILL-after-timeout: {_e2}")
+                    rc = proc.wait(timeout=10)
+            except KeyboardInterrupt as exc:
+                primary = exc
+                interrupted = True
+                try:
+                    os.killpg(proc.pid, _signal.SIGTERM)
+                except OSError as _e:
+                    close_secondaries.append(f"killpg-TERM-after-interrupt: {_e}")
+                try:
+                    rc = proc.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    try:
+                        os.killpg(proc.pid, _signal.SIGKILL)
+                    except OSError as _e2:
+                        close_secondaries.append(f"killpg-KILL-after-interrupt: {_e2}")
+                    rc = proc.wait(timeout=10)
+                raise
+            else:
+                rc = proc.returncode
+        finally:
+            # Bounded reap: ensure the child is reaped without hanging.
+            if proc is not None:
+                try:
+                    if proc.poll() is None:
+                        try:
+                            os.killpg(proc.pid, _signal.SIGKILL)
+                        except OSError as _ke:
+                            close_secondaries.append(f"killpg-KILL-final-reap: {_ke}")
+                        try:
+                            proc.wait(timeout=10)
+                        except Exception as _reap_exc:
+                            if primary is None:
+                                primary = _reap_exc
+                            else:
+                                close_secondaries.append(f"final-reap: {_reap_exc}")
+                except Exception as _poll_exc:
+                    if primary is None:
+                        primary = _poll_exc
+                    else:
+                        close_secondaries.append(f"final-poll: {_poll_exc}")
+            # Close child output fds; secondary close failures attach, never mask.
+            for _fb, _nm in ((fb_out, "stdout"), (fb_err, "stderr")):
+                if _fb is None:
+                    continue
+                try:
+                    try:
+                        _fb.flush()
+                    except OSError as _fe:
+                        close_secondaries.append(f"{_nm}-flush: {_fe}")
+                    _fb.close()
+                except OSError as _ce:
+                    close_secondaries.append(f"{_nm}-close: {_ce}")
+            fb_out = None
+            fb_err = None
+            ended = _time.time()
+            try:
+                out_b = stdout_p.read_bytes()
+            except OSError as _re:
+                out_b = b""
+                close_secondaries.append(f"stdout-readback: {_re}")
+            try:
+                err_b = stderr_p.read_bytes()
+            except OSError as _re:
+                err_b = b""
+                close_secondaries.append(f"stderr-readback: {_re}")
+            final_meta = dict(pre_meta) if pre_meta else {"label": label, "cwd": str(root)}
+            try:
+                _rc_val = proc.returncode if proc is not None and proc.returncode is not None else rc
+            except Exception:
+                _rc_val = rc
+            final_meta.update({"running": False, "rc": _rc_val,
+                               "timeout": timed_out, "interrupted": interrupted,
+                               "ended": ended, "elapsed_s": ended - started,
+                               "close_secondaries": close_secondaries,
+                               "durable_dir": str(call_dir)})
+            if primary is not None:
+                final_meta["primary"] = f"{type(primary).__name__}: {primary}"[:2000]
+            try:
+                with open(meta_final_p, "x", encoding="utf-8") as _ff:
+                    _ff.write(json.dumps(final_meta, indent=2, sort_keys=True) + "\n")
+            except Exception as _fm_exc:
+                # Never silently replace an in-flight primary with a final-meta fault.
+                if primary is not None:
+                    close_secondaries.append(f"final-meta-write: {_fm_exc}")
+                else:
+                    primary = _fm_exc
+            # Persistence failures must propagate as helper failures (never bare rc0).
+            if close_secondaries and primary is None:
+                primary = OSError(f"durable persistence failed: {close_secondaries[0]};"
+                                  f" total {len(close_secondaries)} secondary diagnostics retained")
+            if primary is not None and isinstance(primary, KeyboardInterrupt):
+                raise primary
+            if primary is not None and (timed_out or interrupted):
+                # Timeout/interrupt paths return via outer handling; keep primary
+                # for the timeout/interrupt return below (do not raise here).
+                pass
+            elif primary is not None:
+                # Launch/pre-meta/persistence failure with no timeout: fail fast
+                # so the caller cannot accept a bare rc0.
+                raise primary
+    finally:
+        # Last-resort reaping/close if anything above raised before inner finally.
+        if proc is not None and proc.poll() is None:
+            try:
+                os.killpg(proc.pid, _signal.SIGKILL)
+            except OSError:
+                pass
+            try:
+                proc.wait(timeout=10)
+            except Exception:
+                pass
+        for _fb in (fb_out, fb_err):
+            if _fb is not None:
+                try:
+                    _fb.close()
+                except OSError:
+                    pass
+    out_s = out_b.decode("utf-8", "replace")
+    err_s = err_b.decode("utf-8", "replace")
+    if timed_out or interrupted:
+        return {"rc": rc, "timeout": timed_out, "interrupted": interrupted,
+                "out_b": out_b, "err_b": err_b, "out_s": out_s, "err_s": err_s,
+                "durable_dir": str(call_dir), "meta_pre": str(meta_pre_p),
+                "meta": str(meta_final_p), "stdout_p": str(stdout_p),
+                "stderr_p": str(stderr_p), "script_p": str(script_p),
+                "script_sha256": script_sha, "timeout_s": timeout_s,
+                "elapsed_s": ended - started, "pid": proc.pid if proc is not None else -1,
+                "pgid": proc.pid if proc is not None else -1,
+                "persistence_secondaries": close_secondaries,
+                "primary": f"{type(primary).__name__}: {primary}"[:2000] if primary is not None else None}
+    # Non-timeout path: persistence already raised if failed; rc may still be None
+    # on launch failure (proc never started) — report explicitly, never as rc0.
+    if proc is None or rc is None:
+        raise OSError(f"durable child never started or rc unknown;"
+                      f" primary={type(primary).__name__ if primary else None}: {primary};"
+                      f" secondaries={close_secondaries}")
+    return {"rc": rc if proc.returncode is None else proc.returncode,
+            "timeout": False, "interrupted": False,
+            "out_b": out_b, "err_b": err_b, "out_s": out_s, "err_s": err_s,
+            "durable_dir": str(call_dir), "meta_pre": str(meta_pre_p),
+            "meta": str(meta_final_p), "stdout_p": str(stdout_p),
+            "stderr_p": str(stderr_p), "script_p": str(script_p),
+            "script_sha256": script_sha, "timeout_s": timeout_s,
+            "elapsed_s": ended - started, "pid": proc.pid, "pgid": proc.pid,
+            "persistence_secondaries": close_secondaries}
+
+
+def _run_fixture_code(testcase: unittest.TestCase, root: Path, script: str,
+                      args: list[str], timeout_s: int = 1800) -> str:
+    """Run fixture-code via the common durable launcher (R1 refresh 1800s).
+
+    1800s is a conservative operational bound for a fixture refresh
+    subprocess (covers slow filesystems/runners); it is not a measured
+    sufficiency claim and confers no margin proof. Timeouts/interrupts kill
+    the whole process group and are saved explicitly with durable raw/meta.
+    """
+    res = _launch_durable_child(root, script, args, timeout_s, "fixture-code")
+    testcase.assertFalse(res["timeout"], f"fixture-code timed out after {timeout_s}s; raw in {res['durable_dir']}")
+    testcase.assertFalse(res["interrupted"], f"fixture-code interrupted; raw in {res['durable_dir']}")
+    testcase.assertEqual(res["rc"], 0,
+                         f"fixture-code step failed; raw in {res['durable_dir']}:\nSTDOUT:\n{res['out_s']}\nSTDERR:\n{res['err_s'][-4000:]}")
+    return res["out_s"]
