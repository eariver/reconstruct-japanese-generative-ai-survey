+def _render_and_build_new_targets(repo: Path, basis: dict[str, Any], basis_rel: str,
+                                  entry: dict[str, Any], proof: dict[str, Any],
+                                  proof_rel: str, built: dict[str, Any],
+                                  executor: str, ts: str) -> str:
+    """C-only: write new trio FILES, C manuscript, real disposable TL build and
+    transfer, EXECUTED_BUILD record. Manuscript and build both exist before any
+    external review. Uses the source proof, never a forged P3S manifest."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_reader_publication_v2 as reader_pub
+    trio = proof["output_trio_refs"]
+    # Trio FILES already exist (written before proof verification); re-verify
+    # bytes against the rendered inputs (no overwrite, no takeover).
+    for key, rendered_key in (("primary", "primary"), ("bibliography", "bibliography"),
+                              ("style", "style")):
+        live = _read_bytes_bounded(repo, _lexical_rel(repo, str(trio[key]["path"]),
+                                                      f"new trio {key}"), f"new trio {key}")
+        if live != built["rendered"][rendered_key]:
+            raise _fail("INPUT_DRIFT", "BUILD", "REFUSED_PRE_WRITE",
+                        f"new trio bytes drift before build: {key}")
+    proof_ref = _file_ref(repo, proof_rel, "C renewal proof")
+    manuscript_rel = _proof_paths_for_request(basis)["manuscript"]
+    _build_renewal_manuscript(repo, basis, entry, built, proof_ref, manuscript_rel)
+    build_outputs = _execute_disposable_build(repo, basis, trio)
+    record: dict[str, Any] = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_BUILD_V1",
+        "variant": "EXECUTED_BUILD", "issue_id": basis["issue_id"],
+        "proposal_ref": dict(basis["original_proposal_ref"]),
+        "renewal_basis_ref": _file_ref(repo, basis_rel, "EXECUTED renewal basis"),
+        "renewal_proof_ref": dict(proof_ref),
+        "recipe_ref": {"path": ".latexmkrc",
+                       "sha256": _sha_bytes(_read_bytes_bounded(repo, ".latexmkrc",
+                                                                "build recipe"))},
+        "recorded_at": ts,
+        "declared_inputs": {
+            "primary": {"path": trio["primary"]["path"], "sha256": trio["primary"]["sha256"]},
+            "bibliography": {"path": trio["bibliography"]["path"],
+                             "sha256": trio["bibliography"]["sha256"]},
+            "style": {"path": trio["style"]["path"], "sha256": trio["style"]["sha256"]},
+        },
+        "recipe": {"fixed_steps": list(build_outputs["fixed_steps"])},
+        "toolchain": build_outputs["toolchain"],
+        "outputs": build_outputs["outputs"],
+        "exit_code": 0,
+    }
+    record["build_sha256"] = core.sha256_object({k: v for k, v in record.items()
+                                                 if k != "build_sha256"})
+    rel = _proof_paths_for_request(basis)["build_record"]
+    _write_json_bound(repo, rel, record, "build_sha256", "renewal build record",
+                      "BUILD", "RENEWAL_PROOF_DIGEST")
+    _validate_build_record_container(repo, rel, "Renewal Build Record")
+    return rel
+
