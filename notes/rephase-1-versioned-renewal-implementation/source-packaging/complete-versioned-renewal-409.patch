+        from scripts import survey_editorial_retention_v2 as retention
+        from scripts import survey_editorial_current_authority_v2 as obs
+        from scripts import survey_agent_control_v2 as agent
+        _s, root = _make_p2v_source_root(self, "p2v-st-")
+        pair = self._build_weekly_pair(self, root, "fixture-wk-st-1", "Weekly P2V State edition")
+        proposal = pair["prepared"]["proposal"]
