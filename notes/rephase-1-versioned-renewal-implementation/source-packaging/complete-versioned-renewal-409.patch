+            except Exception:
+                pass
+            if isinstance(_st_for_check, dict) and _has_pointer(_st_for_check):
+                try:
+                    _cfg_for_check = json.loads(col.files[col.rel(col.safe(core.DEFAULT_CONFIG.as_posix(), 'config'))].decode("utf-8"))
+                except Exception:
