+def _replace_state_bytes(repo: Path, state_rel: str, expected_old: bytes,
+                         new_bytes: bytes, label: str) -> dict[str, Any]:
+    """Known-byte State temp/replace: exclusive temp, fsync, os.replace,
+    post-read verify. Write/close/fsync/replace/postread/foreign-inode seams
+    are primary/secondary classified; referenced records are never deleted."""
+    tmp_rel = f"{state_rel}.renewal-tmp"
+    _lexical_rel(repo, tmp_rel, f"{label} temp")
+    _walk_existing_ancestors(repo, _lexical_parts(tmp_rel, f"{label} temp"), label)
+    _walk_existing_ancestors(repo, _lexical_parts(state_rel, label), label)
+    try:
+        os.lstat(repo.resolve().joinpath(*tmp_rel.split("/")))
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp already exists (preserved, no overwrite): {tmp_rel}")
+    except FileNotFoundError:
+        pass
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp check failed (preserved): {exc}") from exc
+    primary: Exception | None = None
+    try:
+        fd = os.open(str(repo.resolve().joinpath(*tmp_rel.split("/"))),
+                     os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp claim failed (preserved): {exc}") from exc
+    try:
+        os.write(fd, new_bytes)
+        os.fsync(fd)
+    except OSError as exc:
+        primary = exc
+    try:
+        os.close(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+        else:
+            try:
+                os.unlink(str(repo / tmp_rel))
+            except OSError:
+                pass
+            raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} temp write failed: {exc}; close also failed: "
+                        f"{primary}") from exc
+    if primary is not None:
+        try:
+            os.unlink(str(repo / tmp_rel))
+        except OSError:
+            pass
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} temp write failed (preserved): {primary}") from primary
+    try:
+        if _fd_safe_read(repo, tmp_rel, f"{label} temp post-write") != new_bytes:
+            raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} temp post-write mismatch (preserved)")
+        before_st = os.stat(repo.resolve().joinpath(*state_rel.split("/")))
+        os.replace(str(repo.resolve().joinpath(*tmp_rel.split("/"))),
+                   str(repo.resolve().joinpath(*state_rel.split("/"))))
+        after_st = os.stat(repo.resolve().joinpath(*state_rel.split("/")))
+        observed = _fd_safe_read(repo, state_rel, f"{label} post-replace")
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} replace failed (preserved): {exc}") from exc
+    if observed != new_bytes:
+        raise _fail("INDETERMINATE", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-replace mismatch (preserved)")
+    return {"before_dev": before_st.st_dev, "before_ino": before_st.st_ino,
+            "after_dev": after_st.st_dev, "after_ino": after_st.st_ino,
+            "foreign_inode": (before_st.st_dev, before_st.st_ino)
+                             != (after_st.st_dev, after_st.st_ino)}
+
