+        "before_state_ref": {"path": entry["state_rel"], "sha256": entry["state_sha"]},
+        "retained_copy_ref": {"path": str(basis["retained_copy_ref"]["path"]),
+                              "sha256": str(basis["retained_copy_ref"]["sha256"]),
+                              "byte_count": int(basis["retained_copy_ref"]["byte_count"])},
+        "before_active_digest": digest,
+        "before_candidate_ref": dict(entry["prior_candidate_ref"]),
+        "set_ref": _file_ref(repo, set_rel, "activation seal"),
+        "renewal_basis_ref": dict(basis_ref),
+        "renewal_proof_ref": dict(proof_ref),
+        # versioned_core is FLAT (8 contract fields + implementation_commit_sha,
+        # no nested contract object) per the revalidation schema branch.
+        "core": {**entry["current_contract"],
+                 "implementation_commit_sha": entry["current_commit"]},
+        "executor": executor.strip(), "recorded_at": ts,
+        "establishment": {"state_sha256": entry["state_sha"],
+                          "lifecycle": "VALIDATED_DRAFT",
+                          "architecture_review": "approved",
+                          "publication_preview": "pending", "freeze": "pending",
+                          "release": "pending",
+                          "implementation_commit_sha": entry["current_commit"],
+                          "recorded_at": ts},
+    }
+    record_rel_out = record_rel
+    record_bytes = core.json_bytes(record)
+    _atomic_write_new(repo, record_rel_out, record_bytes, "activation record")
+    try:
+        record_file_sha = _sha_bytes(_read_bytes_bounded(repo, record_rel_out, "activation record pin"))
+        _validate_pinned_instance(repo, record, record_rel_out, record_file_sha,
+                                  "schemas/publication-surface-revalidation.schema.json",
+                                  "Renewal Activation Record", "ACTIVATE",
+                                  fail_code="SEAL_BIND")
+    except RenewalHighError:
+        raise
+    except (ValueError, OSError) as exc:
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"activation record schema invalid: {exc}") from exc
+    try:
+        setmod.validate_activation_record(repo, Path(record_rel_out))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "SEAL_BIND"
+        raise _fail(str(code), "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"low activation-record validation failed: {exc}") from exc
+    # Pre-write chain/anchor/seal/basis validation BEFORE any State mutation.
+    # New record/seal/basis/chain anchors must all equal the independently
+    # derived chain identity (latest legacy before FIRST versioned, no rolling,
+    # no originalPath fallback when kind is LEGACY). A known anchor
+    # contradiction must refuse BEFORE State write (never write bad State
+    # then report INDETERMINATE). Post-check below stays strict.
+    try:
+        from scripts import survey_versioned_renewal_history_v2 as hist
+    except ImportError as exc:
+        raise _fail("HISTORY_DIGEST_MISMATCH", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"historian unavailable for pre-write anchor check: {exc}") from exc
+    try:
+        _hist_pre = hist.verify_versioned_history(repo, record_rel_out)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_ANCESTOR"
+        raise _fail(str(code), "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"pre-write history anchor invalid (refused before State mutation): {exc}") from exc
+    _derived_pre = _hist_pre.get("canonical_anchor")
+    if not isinstance(_derived_pre, dict) or set(_derived_pre) != {"kind", "ref"}:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write historian canonical_anchor missing")
+    _rec_anchor = record.get("canonical_anchor")
+    _basis_anchor = basis.get("canonical_anchor") if isinstance(basis, dict) else None
+    if not isinstance(_rec_anchor, dict) or _rec_anchor != _derived_pre:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write new record anchor must equal chain-derived identity (refused before State mutation)")
+    if not isinstance(_basis_anchor, dict) or _basis_anchor != _derived_pre:
+        raise _fail("HISTORY_ANCESTOR", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write basis anchor must equal chain-derived identity (refused before State mutation)")
+    # No fallback: LEGACY kind must reference an actual legacy record, never
+    # the original validation checkpoint path.
+    if isinstance(_derived_pre, dict) and _derived_pre.get("kind") == "LEGACY_REVALIDATION":
+        _dr = _derived_pre.get("ref", {})
+        _vr = (state.get("checkpoint_provenance") or {}).get("validation", {})
+        if isinstance(_dr, dict) and isinstance(_vr, dict) and _dr.get("path") == _vr.get("path") and _dr.get("sha256") == _vr.get("sha256"):
