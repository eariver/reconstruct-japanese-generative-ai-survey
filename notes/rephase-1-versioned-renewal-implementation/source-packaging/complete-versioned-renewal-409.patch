+        # Preserve duplicate vs invalid distinction in detail; never allow duplicates.
+        msg = str(exc)
+        if "duplicate JSON key refused" in msg:
+            raise _fail("DUPLICATE_KEY", "PARSE", "REFUSED_PRE_WRITE", f"{label} duplicate key refused: {exc}") from exc
+        raise _fail("JSON_INVALID", "PARSE", "REFUSED_PRE_WRITE", f"{label} invalid JSON: {exc}") from exc
+
