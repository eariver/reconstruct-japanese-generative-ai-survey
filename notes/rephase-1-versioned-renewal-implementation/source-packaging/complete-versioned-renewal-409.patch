+def _check_already_active_set(repo: Path, supplied_rel: str, supplied_sha: str,
+                              selected_ref: dict[str, Any] | None, label: str) -> bool:
+    if not isinstance(selected_ref, dict) or not isinstance(selected_ref.get("path"), str) \
+            or not _is_hex64(selected_ref.get("sha256")):
+        return False
+    expected_rel = _lexical_rel(repo, str(selected_ref["path"]), f"{label} selected")
+    expected_sha = str(selected_ref["sha256"])
+    if supplied_rel == expected_rel and supplied_sha == expected_sha:
+        try:
+            if _file_identity(repo, supplied_rel, label) != _file_identity(repo, expected_rel, label):
+                raise _fail("RECORD_COLLISION", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                            f"{label} identity changed for exact spelling "
+                            f"(dev/ino differs): {supplied_rel!r}")
+        except RenewalHighError:
+            raise
+        return True
+    if supplied_rel != expected_rel and (supplied_sha == expected_sha or (
+            _file_identity(repo, supplied_rel, f"{label} supplied")[0:2] ==
+            _file_identity(repo, expected_rel, f"{label} expected")[0:2]
+            if _is_hex64(supplied_sha) else False)):
+        try:
+            s_id = _file_identity(repo, supplied_rel, f"{label} supplied")
+            e_id = _file_identity(repo, expected_rel, f"{label} expected")
+        except RenewalHighError:
+            raise _fail("RECORD_COLLISION", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} alias input refused before writes "
+                        f"(spelling {supplied_rel!r} != expected {expected_rel!r}; "
+                        "NOT ALREADY_ACTIVE by same SHA)")
+        if s_id == e_id or supplied_sha == expected_sha:
+            raise _fail("RECORD_COLLISION", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                        f"{label} alias input refused before writes "
+                        f"(spelling differs but same bytes/inode: {supplied_rel!r} vs {expected_rel!r}; "
+                        "NOT ALREADY_ACTIVE by same SHA)")
+    if supplied_rel != expected_rel:
+        try:
+            s_id = _file_identity(repo, supplied_rel, f"{label} supplied")
+            e_id = _file_identity(repo, expected_rel, f"{label} expected")
+            if s_id == e_id:
+                raise _fail("RECORD_COLLISION", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                            f"{label} alias input refused before writes "
+                            f"(hardlink same inode different spelling: {supplied_rel!r} vs {expected_rel!r}; "
+                            "NOT ALREADY_ACTIVE by same SHA)")
+        except RenewalHighError as exc:
+            if exc.code == "RECORD_COLLISION":
+                raise
+            pass
+    return False
