+    env = dict(os.environ)
+    env["GIT_OPTIONAL_LOCKS"] = "0"
+    env["GIT_CONFIG_NOSYSTEM"] = "1"
+    env["GIT_CONFIG_GLOBAL"] = "/dev/null"
+    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=30, env=env)
