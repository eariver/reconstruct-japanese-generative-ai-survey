+def _active_effective(col: _Collector, root: Path, cfg: dict[str, Any], state: dict[str, Any],
+                      original_rows: list[dict[str, str]]) -> tuple[dict[str, Any], dict[str, Any] | None]:
+    # Group C repeat support (contract §§5/8): canonical + active-set before-graphs.
+    # When L reports VERSIONED_ACTIVE, the active_effective map is the versioned
+    # map (active7 projection + versioned Candidate), never stale canonical bytes.
+    # Prior immutable versioned publication/staged/seal/Candidate bytes are KEEP;
+    # mutable live State remains COPY; first canonical capture stays conservative.
+    # Ordinary receipt never calls P2V after activation (guard in P2V module).
+    versioned = _versioned_active_selection(root, cfg, state)
+    record, errors = agent.resolve_active_publication_revalidation(root, cfg, state)
+    if errors:
+        raise _fail("ACTIVE_RECORD_INVALID", "; ".join(errors))
+    if versioned is not None:
+        # Strict: L effective7 rows are {path,sha256,byte_count,origin} (4 keys, not 3).
+        # Normalize known explicit keys; exact7; Candidate outside 7 per contract.
+        effective7 = versioned.get("effective7") or {}
+        cand_ref = versioned.get("candidate_ref")
+        if not isinstance(effective7, dict) or len(effective7) != 7:
+            raise _fail("VERSIONED_MAP_SHAPE", "VERSIONED_ACTIVE effective7 must carry exactly 7 rows")
+        if set(effective7) != {"reader-manuscript", "validated-source", "publication-pdf", "quality-regression-bundle", "semantic-review", "visual-review", "reader-surface-gate"}:
+            raise _fail("VERSIONED_MAP_SHAPE", "VERSIONED_ACTIVE effective7 must be exactly 7 publication roles")
+        effective: dict[str, Any] = {}
+        for rname, info in effective7.items():
+            if not isinstance(info, dict) or set(info) != {"path", "sha256", "byte_count", "origin"}:
+                raise _fail("VERSIONED_ROW_SHAPE", f"versioned row fields invalid (expected path/sha256/byte_count/origin): {rname}")
+            if info["origin"] not in ("ORIGINAL", "ACTIVE"):
+                raise _fail("VERSIONED_ORIGIN", f"versioned row origin invalid: {rname}")
+            rel = col.pinned({"path": info["path"], "sha256": info["sha256"]},
+                             f"versioned active-before {rname}")
+            if info["sha256"] != core.sha256_bytes(col.files[rel]):
+                raise _fail("VERSIONED_DRIFT", f"versioned active row drift: {rname}")
+            if len(col.files[rel]) != info["byte_count"]:
+                raise _fail("VERSIONED_SIZE", f"versioned active row byte_count drift: {rname}")
+            effective[rname] = {"path": rel, "sha256": info["sha256"], "byte_count": info["byte_count"], "origin": info["origin"]}
+        # Candidate outside 7 per contract; validate separately (not in effective table).
+        # Bound candidate always active versioned, no canonical copy. Effective stays exactly 7;
+        # _build_graph retrieves the active candidate via L selection (not via effective table).
+        if cand_ref is not None:
+            if not isinstance(cand_ref, dict) or set(cand_ref) != {"path", "sha256"}:
+                raise _fail("VERSIONED_CANDIDATE_SHAPE", "versioned candidate_ref must be {path,sha256}")
+            col.pinned(cand_ref, "versioned active Candidate (not stale canonical)")
+        return effective, record
+    if record is None:
+        effective: dict[str, Any] = {}
+        for row in original_rows:
+            rel = col.pinned({"path": row["path"], "sha256": row["sha256"]},
+                             f"active-before artifact {row['name']}")
+            effective[row["name"]] = {"path": rel, "sha256": row["sha256"], "origin": "ORIGINAL"}
+        return effective, None
+    superseded = {row["name"]: row for row in record.get("superseded_artifacts", [])}
+    preserved = {row["name"]: row for row in record.get("preserved_artifacts", [])}
+    prior_names = {row["name"] for row in original_rows}
+    if set(superseded) | set(preserved) != prior_names or set(superseded) & set(preserved):
+        raise _fail("ACTIVE_ROW_MISMATCH", "active record rows do not cover original roles exactly once")
+    effective = {}
+    for row in original_rows:
+        name = row["name"]
+        other = superseded.get(name) or preserved.get(name)
+        if row["path"] != other["path"]:
+            raise _fail("ACTIVE_PATH_REBIND", f"{name} path rebound by active record")
+        live = col.safe(row["path"], f"active-before artifact {name}")
+        current = core.sha256_bytes(col.files[col.rel(live)])
+        if name in superseded:
+            if current != superseded[name]["new_sha256"]:
+                raise _fail("ACTIVE_SUPERSEDED_DRIFT", f"{name} differs from active record adoption")
+        elif current != preserved[name]["sha256"]:
+            raise _fail("ACTIVE_PRESERVED_DRIFT", f"{name} differs from active record pin")
+        effective[name] = {"path": col.rel(live), "sha256": current, "origin": "ACTIVE"}
+    return effective, record
+
+
+def _load_profile(col: _Collector, state: dict[str, Any]) -> dict[str, Any]:
+    prof_ref = state.get("profile") or {}
+    if not isinstance(prof_ref, dict) or set(prof_ref) != {"path", "sha256"}:
+        raise _fail("STATE_PROFILE_SHAPE", "State lacks exact Production Profile reference")
+    profile_path = col.safe(prof_ref["path"], "Production Profile")
+    rel = col.rel(profile_path)
+    if core.sha256_bytes(col.files[rel]) != prof_ref.get("sha256"):
+        raise _fail("PROFILE_DRIFT", "State-bound Production Profile bytes drifted")
+    try:
+        profile = json.loads(col.files[rel].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("PROFILE_UNREADABLE", f"Production Profile not JSON: {exc}") from exc
+    if profile.get("issue_id") != state.get("issue_id"):
+        raise _fail("PROFILE_ISSUE_MISMATCH", "Production Profile/State issue identity mismatch")
+    return profile
