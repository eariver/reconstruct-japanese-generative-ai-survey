+            _r = _verdict.get("receipt") if isinstance(_verdict, dict) else None
+            if not isinstance(_r, dict) or _r.get("kind") != "VERSIONED_RENEWAL_SOURCE_V1":
+                raise _fail("RECEIPT_RECHECK_FAILED", f"{label} renewal recheck kind mismatch")
