+def _closure_names(work: Path, route: str) -> list[str]:
+    import sys
+    sys.path.insert(0, str(work))
+    try:
+        from scripts import survey_versioned_renewal_history_v2 as hist
+        return list(hist._expected_receipt_closure(route, "NEW"))
+    finally:
+        sys.path.remove(str(work))
