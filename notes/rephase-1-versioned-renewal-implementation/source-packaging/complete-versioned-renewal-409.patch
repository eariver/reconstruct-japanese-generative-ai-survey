+def _safe_path(repo: Path, rel: str, label: str) -> Path:
+    parts = _lexical_parts(rel, label)
+    _walk_existing_ancestors(repo, parts, label)
+    target = repo.resolve().joinpath(*parts)
+    try:
+        st = os.lstat(target)
+    except FileNotFoundError as exc:
+        raise _fail("HIGH_MISSING", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} not a regular file: {rel}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} unreadable: {rel}: {exc}") from exc
+    if stat.S_ISLNK(st.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} symlink refused: {rel}")
+    if not stat.S_ISREG(st.st_mode):
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} not a regular file: {rel}")
+    return target
+
+
+def _read_bytes_bounded(repo: Path, rel: str, label: str) -> bytes:
+    return _fd_safe_read(repo, rel, label)
+
+
+def _strict_json_from_bytes(data: bytes, label: str) -> Any:
+    if len(data) > MAX_JSON_BYTES:
+        raise _fail("HIGH_MODE", "LOAD", "REFUSED_PRE_WRITE", f"{label} JSON too large")
+    try:
+        return json.loads(data.decode("utf-8"), object_pairs_hook=_no_duplicate_object)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise _fail("HIGH_DIGEST_MISMATCH", "LOAD", "REFUSED_PRE_WRITE",
+                    f"{label} strict JSON invalid: {exc}") from exc
+
+
+def _is_hex64(value: Any) -> bool:
+    return (isinstance(value, str) and len(value) == 64
+            and all(c in "0123456789abcdef" for c in value))
+
+
+def _is_gitsha(value: Any) -> bool:
+    return (isinstance(value, str) and len(value) == 40
+            and all(c in "0123456789abcdef" for c in value))
+
+
+def _git(repo: Path, *args: str, label: str) -> str:
+    try:
+        proc = subprocess.run(
+            ["git", "--no-optional-locks", *args],
+            cwd=str(repo), capture_output=True, text=True, timeout=120,
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise _fail("HISTORY_BLOB_MISSING", "GIT", "REFUSED_PRE_WRITE",
+                    f"{label} git invocation failed: {exc}") from exc
+    if proc.returncode != 0:
+        raise _fail("HISTORY_BLOB_MISSING", "GIT", "REFUSED_PRE_WRITE",
+                    f"{label} git failed ({proc.returncode}): {proc.stderr.strip()[:300]}")
+    return proc.stdout
+
+
+def _current_commit(repo: Path) -> str:
+    out = _git(repo, "rev-parse", "HEAD", label="current tool epoch").strip()
+    if not _is_gitsha(out):
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "EPOCH", "REFUSED_PRE_WRITE",
+                    "current HEAD is not a 40-hex commit")
+    return out
+
+
+def _atomic_write_new(repo: Path, rel: str, data: bytes, label: str) -> dict[str, Any]:
+    """Exclusive new-file claim: O_CREAT|O_EXCL|O_NOFOLLOW, fsync, post-read verify.
+
+    Refuses when the target already exists (no same-byte takeover, no cleanup of
+    foreign/unknown residue). Returns observed file identity (dev/ino/size/sha).
+    Primary + secondary errors are both preserved; referenced records are never
+    deleted.
+    """
+    _lexical_rel(repo, rel, label)
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    directory = (repo / rel).parent
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+    except OSError as exc:
+        raise _fail("RECORD_COLLISION", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} parent unavailable: {rel}: {exc}") from exc
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    target = repo.resolve().joinpath(*rel.split("/"))
+    try:
+        fd = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
+    except FileExistsError as exc:
+        raise _fail("RECORD_COLLISION", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} target already claimed (fresh id required, no takeover): "
+                    f"{rel}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} exclusive claim failed: {rel}: {exc}") from exc
+    primary: Exception | None = None
+    try:
+        os.write(fd, data)
+        os.fsync(fd)
+    except OSError as exc:
+        primary = exc
+    try:
+        created_st = os.fstat(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+    try:
+        os.close(fd)
+    except OSError as exc:
+        if primary is None:
+            primary = exc
+        else:
+            raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                        f"{label} write failed: {exc}; close also failed: {primary}") from exc
+    if primary is not None:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} write failed: {primary}") from primary
+    try:
+        lst = os.lstat(target)
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write lstat failed: {rel}: {exc}") from exc
+    if stat.S_ISLNK(lst.st_mode):
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write target is symlink: {rel}")
+    if (lst.st_dev, lst.st_ino) != (created_st.st_dev, created_st.st_ino):
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write target replaced (dev/ino changed): {rel}")
+    if lst.st_nlink != 1:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} hardlink sharing refused: {rel}")
+    observed = _fd_safe_read(repo, rel, f"{label} post-write")
+    if observed != data:
+        raise _fail("HIGH_UNREADABLE", "WRITE", "PRESERVED_INCOMPLETE",
+                    f"{label} post-write bytes differ: {rel}")
+    return {"path": rel, "sha256": _sha_bytes(observed), "byte_count": len(observed),
+            "st_dev": lst.st_dev, "st_ino": lst.st_ino}
+
+
+def _write_json_bound(repo: Path, rel: str, doc: dict[str, Any], digest_key: str,
+                      label: str, phase: str, code: str) -> bytes:
+    """Exclusive JSON write with self-digest binding on reparse.
+
+    File-ref SHA is the full serialized bytes, distinct from the object
+    self-digest by design (indent=2 file bytes vs compact sorted digest).
+    The self-digest binds when the written bytes reparse to the same digest;
+    that reparse check happens here, before any schema validation or use.
+    """
+    from scripts import survey_production_v2 as core
+    data = core.json_bytes(doc)
+    _atomic_write_new(repo, rel, data, label)
+    reparsed = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, rel, f"{label} reparse"), f"{label} reparse")
+    if not isinstance(reparsed, dict) or core.sha256_object(
+            {k: v for k, v in reparsed.items() if k != digest_key}) != doc.get(digest_key):
+        raise _fail(code, phase, "REFUSED_PRE_WRITE",
+                    f"{label} written bytes do not reparse to the declared self-digest")
+    return data
+
+
+def _require_renewal_entry_window(state: dict[str, Any]) -> None:
+    """Pure named operation eligibility check on just-pinned State bytes.
+
+    Exact predicates of P1 _eligibility (lifecycle VALIDATED_DRAFT, Architecture
+    approved, Preview pending with no Preview Human provenance, downstream
+    publication_preview/freeze/release machine checkpoints all pending, Exception
+    inactive). Examines the pinned State only; never synthesizes State. This is
+    a named check, not a caller flag and not a replacement State validator.
+    """
+    problems: list[str] = []
+    if state.get("lifecycle_state") != "VALIDATED_DRAFT":
+        problems.append("requires healthy VALIDATED_DRAFT")
+    gates = state.get("human_gates", {})
+    if not isinstance(gates, dict) or gates.get("architecture_review") != "approved":
+        problems.append("requires approved Architecture Review")
+    if gates.get("publication_preview") != "pending":
+        problems.append("forbids decided Publication Preview")
+    prov = state.get("human_gate_provenance", {})
+    if isinstance(prov, dict) and prov.get("publication_preview") is not None:
+        problems.append("forbids Publication Preview Human provenance")
+    checkpoints = state.get("machine_checkpoints", {})
+    if not isinstance(checkpoints, dict) or any(
+            checkpoints.get(n) != "pending"
+            for n in ("publication_preview", "freeze", "release")):
+        problems.append("forbids resolved downstream checkpoint")
+    exc_gate = state.get("exception_gate", {})
+    if not isinstance(exc_gate, dict) or exc_gate.get("status") != "inactive":
+        problems.append("forbids active Exception Gate")
+    if problems:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", "ENTRY", "REFUSED_PRE_WRITE",
+                    "; ".join(problems))
+
+
