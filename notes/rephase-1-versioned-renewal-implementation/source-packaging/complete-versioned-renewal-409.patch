+
+def _validated_state_profile_for_tree(col: _Collector, root: Path,
+                                      state_path_value: str | Path
+                                      ) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+    """Strict State/Profile authority BEFORE any broad tree walk (C4).
+
+    Loads State/Profile ONLY via safe-pinned bytes (no broad reads), enforces
+    strict validation, eligibility, Profile SHA/issue binding and canonical
+    State path. Returns (state, cfg, profile) with validated roots. Preview
+    contents are never trusted for directory inspection.
+    """
+    state_abs = col.safe(state_path_value, "Production State")
+    try:
+        state = json.loads(col.files[col.rel(state_abs)].decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise _fail("STATE_UNREADABLE", f"Production State not JSON: {exc}") from exc
+    if not isinstance(state, dict):
+        raise _fail("STATE_UNREADABLE", "Production State is not a JSON object")
+    try:
+        cfg = json.loads(col.files[core.DEFAULT_CONFIG.as_posix()].decode("utf-8"))
+    except (KeyError, UnicodeDecodeError, ValueError) as exc:
+        raise _fail("CONFIG_UNREADABLE", f"implementation config not JSON: {exc}") from exc
+    if agent.validate_agent_state(root, cfg, state):
+        raise _fail("STATE_INVALID", "Production State fails strict validation")
+    _eligibility(state)
+    profile = _load_profile(col, state)
+    if state_abs.resolve() != _canonical_state_path(root, cfg, profile):
+        raise _fail("STATE_NOT_CANONICAL", "Production State path is not canonical authoritative State")
+    # Validate roots are repo-local (no traversal/absolute escape) before walking.
+    try:
+        core.repo_local_path(root, profile["paths"]["source_root"], "paths.source_root")
+        core.repo_local_path(root, profile["paths"]["survey_root"], "paths.survey_root")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("PROFILE_ROOT_INVALID", f"profile roots invalid: {exc}") from exc
+    return state, cfg, profile
