+def _retained_expected_sets(rows: list[dict[str, Any]], man_rel: str,
+                            retained_rel: str) -> tuple[set[str], set[str]]:
+    # Exact expected retained file set + directory closure: every COPY dest
+    # plus the manifest; the retained root plus every ancestor directory
+    # below it. Used at final re-inventory boundaries (standalone verifier
+    # and capture post-verify) so a late new file or empty directory
+    # refuses instead of escaping a known-files-only recheck.
+    expected_files: set[str] = set()
+    for r in rows:
+        if r.get("policy") == "COPY_BEFORE_REPLACEMENT":
+            expected_files.add(r["retained_dest"])
+    expected_files.add(man_rel)
+    expected_dirs: set[str] = {retained_rel}
+    for f in expected_files:
+        parts = _raw_segments(f)
+        for i in range(1, len(parts)):
+            cand = "/".join(parts[:i])
+            if cand == retained_rel or cand.startswith(retained_rel + "/"):
+                expected_dirs.add(cand)
+    return expected_files, expected_dirs
+
