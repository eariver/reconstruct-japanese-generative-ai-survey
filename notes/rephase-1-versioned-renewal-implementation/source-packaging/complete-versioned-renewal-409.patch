+        if core.sha256_bytes(prof_data) != prof_ref["sha256"]:
+            raise _fail("PROFILE_DRIFT", phase, disp, "State-bound Profile bytes drifted")
+        prop_rel, prop_data = session.safe_read(str(proposal_path),
