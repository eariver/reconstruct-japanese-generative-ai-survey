+def _validate_scope_o17(sess: _Session, exp: dict[str, Any], prior: dict[str, Any]) -> dict[str, Any]:
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    root = sess.root
+    basis = sess.basis
+    prior_seal = prior["prior_seal"]
+    seal_kind = str(prior_seal.get("kind", ""))
+    if seal_kind not in ("EDITORIAL_PUBLICATION_SET_V1", "VERSIONED_RENEWAL_SET_V1"):
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", f"prior seal kind unsupported for scope lineage: {seal_kind}")
+    for b in basis.get("observed_source_bindings", []):
+        if isinstance(b, dict) and b.get("binding") == "SCHEMA" and b.get("schema_pointer") == "/":
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", 'schema_pointer "/" selects the empty-name property, never the document root ""')
+    try:
+        verdict = hist.verify_versioned_history(root, basis["prior_record_ref"]["path"])
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_DIGEST_MISMATCH"
+        raise RenewalSourceError(str(code), f"H rederived verdict invalid for scope lineage: {exc}") from exc
+    if not isinstance(verdict, dict) or not verdict.get("HISTORICAL_IDENTITY_VERIFIED"):
+        raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", "H rederived verdict missing for scope lineage")
+    h_derived = verdict.get("observed_source_bindings", [])
+    if not isinstance(h_derived, list):
+        raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", "H rederived bindings malformed")
+    h_scope = [b for b in h_derived if isinstance(b, dict) and b.get("binding") == "SCHEMA"
+               and b.get("schema_path") == _SCOPE_SCHEMA and b.get("schema_pointer") == ""]
+    s_scope = [b for b in basis.get("observed_source_bindings", []) if isinstance(b, dict)
+               and b.get("binding") == "SCHEMA" and b.get("schema_path") == _SCOPE_SCHEMA]
+    for b in s_scope:
+        if b.get("schema_pointer") != "":
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", f"O17 schema_pointer must be empty string, got {b.get('schema_pointer')!r}")
+    if sorted(_scope_row_key(b) for b in s_scope) != sorted(_scope_row_key(b) for b in h_scope):
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "basis scope rows must equal H rederived scope rows (missing/extra/foreign refused)")
+    lineage = verdict.get("materialization_lineage", [])
+    if not isinstance(lineage, list):
+        raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", "H materialization lineage malformed")
+    editorial_entries = [e for e in lineage if isinstance(e, dict) and e.get("kind") == "EDITORIAL"]
+    if not editorial_entries:
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "no editorial materialization producer in selected chain")
+    current_ed = editorial_entries[-1]
+    scope_ref = current_ed.get("original_scope_ref")
+    proposal_ref = current_ed.get("original_proposal_ref")
+    staged_ref = current_ed.get("original_staged_ref")
+    receipt_ref = current_ed.get("original_receipt_ref")
+    for ref, name in ((scope_ref, "original_scope_ref"), (proposal_ref, "original_proposal_ref"),
+                      (staged_ref, "original_staged_ref"), (receipt_ref, "original_receipt_ref")):
+        if not isinstance(ref, dict) or not isinstance(ref.get("path"), str) or not _is_hex64(ref.get("sha256")):
+            raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", f"H lineage {name} invalid")
+    scope_rows_for_ref = [b for b in h_scope if isinstance(b.get("source_ref"), dict)
+                          and b["source_ref"].get("path") == scope_ref["path"]
+                          and b["source_ref"].get("sha256") == scope_ref["sha256"]]
+    if not scope_rows_for_ref:
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "current lineage scope ref has no matching H-derived scope row")
+    receipt_ref = current_ed.get("original_receipt_ref")
+    if not isinstance(receipt_ref, dict) or not isinstance(receipt_ref.get("path"), str) or not _is_hex64(receipt_ref.get("sha256")):
+        raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", "H lineage original_receipt_ref invalid")
+    if seal_kind == "EDITORIAL_PUBLICATION_SET_V1":
+        prior_receipt_doc = prior["prior_receipt"]
+        if (prior_receipt_doc.get("scope_review_ref") or {}).get("path") != scope_ref["path"] or \
+           (prior_receipt_doc.get("scope_review_ref") or {}).get("sha256") != scope_ref["sha256"]:
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "lineage scope ref competes with prior receipt scope ref")
+        if (prior_receipt_doc.get("proposal_ref") or {}).get("path") != proposal_ref["path"] or \
+           (prior_receipt_doc.get("proposal_ref") or {}).get("sha256") != proposal_ref["sha256"]:
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "lineage proposal ref competes with prior receipt proposal ref")
+        if (prior_receipt_doc.get("staged_manifest_ref") or {}).get("path") != staged_ref["path"] or \
+           (prior_receipt_doc.get("staged_manifest_ref") or {}).get("sha256") != staged_ref["sha256"]:
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "lineage staged ref competes with prior receipt staged ref")
+    receipt_rel = _to_rel(root, receipt_ref["path"], "lineage receipt")
+    receipt_data = sess.read(receipt_rel, "lineage receipt")
+    if _sha_bytes(receipt_data) != receipt_ref["sha256"]:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "lineage receipt bytes changed")
+    lineage_receipt = _parse_json_strict_bytes(receipt_data, "lineage receipt")
+    if not isinstance(lineage_receipt, dict):
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "lineage receipt must be an object")
+    receipt_scope = lineage_receipt.get("scope_review_ref")
+    if not isinstance(receipt_scope, dict) or receipt_scope.get("path") != scope_ref["path"] or receipt_scope.get("sha256") != scope_ref["sha256"]:
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "lineage receipt scope ref must equal lineage scope ref")
+    proposal_rel = _to_rel(root, proposal_ref["path"], "lineage proposal")
+    staged_rel = _to_rel(root, staged_ref["path"], "lineage staged manifest")
+    proposal_data = sess.read(proposal_rel, "lineage proposal")
+    staged_data = sess.read(staged_rel, "lineage staged manifest")
+    if _sha_bytes(proposal_data) != proposal_ref["sha256"]:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "lineage proposal bytes changed")
+    if _sha_bytes(staged_data) != staged_ref["sha256"]:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "lineage staged manifest bytes changed")
+    proposal = _parse_json_strict_bytes(proposal_data, "lineage proposal")
+    staged = _parse_json_strict_bytes(staged_data, "lineage staged manifest")
+    if not isinstance(proposal, dict) or not isinstance(staged, dict):
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "lineage proposal/staged manifest must be objects")
+    staged_scope = staged.get("scope_review_ref")
+    if not isinstance(staged_scope, dict) or staged_scope.get("path") != receipt_scope["path"] or staged_scope.get("sha256") != receipt_scope["sha256"]:
+        raise RenewalSourceError("REVIEW_TARGET_MISMATCH", "staged scope_review_ref must equal receipt scope_review_ref")
+    scope_rel = _to_rel(root, receipt_scope["path"], "scope review")
+    scope_data = sess.read(scope_rel, "scope review")
+    if _sha_bytes(scope_data) != receipt_scope["sha256"]:
+        raise RenewalSourceError("HISTORY_DIGEST_MISMATCH", "scope review bytes changed")
+    raw = _parse_json_strict_bytes(scope_data, "scope review")
+    if not isinstance(raw, dict):
+        raise RenewalSourceError("SCOPE_UNREADABLE", "scope review is not a JSON object")
+    scope_schema_rel = _to_rel(root, _SCOPE_SCHEMA, "scope schema")
+    _validate_pinned(raw, sess.read(scope_schema_rel, "scope schema"), "scope review", "SCOPE_ORDINARY_INVALID")
+    if raw.get("review_kind") != "SEMANTIC_EDITORIAL":
+        raise RenewalSourceError("SCOPE_ORDINARY_INVALID", "scope review_kind must be SEMANTIC_EDITORIAL (no legacy fallback)")
+    if not isinstance(raw.get("review_sha256"), str) or not _is_hex64(raw.get("review_sha256")):
+        raise RenewalSourceError("SCOPE_DIGEST_MISMATCH", "scope review_sha256 invalid")
+    from scripts import survey_production_v2 as core
+    if core.sha256_object({k: v for k, v in raw.items() if k != "review_sha256"}) != raw.get("review_sha256"):
+        raise RenewalSourceError("SCOPE_DIGEST_MISMATCH", "scope review object digest does not bind captured JSON")
+    reviewed = raw.get("reviewed_surface")
+    if not isinstance(reviewed, dict) or not isinstance(reviewed.get("path"), str) or not _is_hex64(reviewed.get("sha256")):
+        raise RenewalSourceError("SCOPE_ORDINARY_INVALID", "scope reviewed_surface fields invalid")
+    surf_rel = _to_rel(root, reviewed["path"], "scope reviewed surface")
+    surf_data = sess.read(surf_rel, "scope reviewed surface")
+    if _sha_bytes(surf_data) != reviewed["sha256"]:
+        raise RenewalSourceError("SCOPE_DIGEST_MISMATCH", "scope reviewed surface bytes changed")
+    if not isinstance(raw.get("issue_id"), str) or raw.get("issue_id") != exp.get("issue_id"):
+        raise RenewalSourceError("SCOPE_ORDINARY_INVALID", "scope issue identity mismatch")
+    profile = prior["profile"]
+    if raw.get("publication_profile") != profile.get("publication_profile"):
+        raise RenewalSourceError("SCOPE_ORDINARY_INVALID", "scope publication profile mismatch")
+    proposed = proposal.get("proposed") or {}
+    after_ref = (proposed.get("proposed_reader_ref") or {})
+    if not isinstance(after_ref.get("path"), str) or not after_ref["path"] or not _is_hex64(after_ref.get("sha256")):
+        raise RenewalSourceError("SCOPE_AFTER_SHAPE", "proposal lacks exact proposed_reader_ref for scope binding")
+    if reviewed.get("path") != after_ref["path"] or reviewed.get("sha256") != after_ref["sha256"]:
+        raise RenewalSourceError("SCOPE_WRONG_AFTER", "scope review does not target the proposed reader")
+    receipt_after = lineage_receipt.get("reviewed_reader_input")
+    if not isinstance(receipt_after, dict) or receipt_after.get("path") != after_ref["path"] or receipt_after.get("sha256") != after_ref["sha256"]:
+        raise RenewalSourceError("SCOPE_WRONG_AFTER", "scope reviewed surface must equal lineage receipt reviewed_reader_input")
+    blk = raw.get("editorial_correction_scope")
+    if blk is None:
+        raise RenewalSourceError("SCOPE_BLOCK_SHAPE", "scope block missing (review required)")
+    if not isinstance(blk, dict) or blk.get("version") != _SCOPE_VERSION:
+        raise RenewalSourceError("SCOPE_BLOCK_SHAPE", "scope block version invalid")
+    if blk.get("decision") != "WITHIN_APPROVED_AUTHORITY":
+        raise RenewalSourceError("SCOPE_NOT_WITHIN_AUTHORITY", f"scope decision cannot bind a correction: {blk.get('decision')}")
+    if blk.get("before_reader_input") != (proposal.get("basis") or {}).get("active_reader_input_ref"):
+        raise RenewalSourceError("SCOPE_WRONG_BEFORE", "scope block before-reader does not match proposal basis")
+    if blk.get("preserved_upstream_sha256") != (proposal.get("basis") or {}).get("preserved_upstream_digest"):
+        raise RenewalSourceError("SCOPE_STALE_UPSTREAM", "scope block upstream digest does not match proposal")
+    if not isinstance(blk.get("change_summary"), str) or not blk["change_summary"].strip():
+        raise RenewalSourceError("SCOPE_BLOCK_SHAPE", "scope block change_summary empty")
+    if not isinstance(blk.get("evidence_locations"), list) or not blk["evidence_locations"] or not all(isinstance(x, str) and x.strip() for x in blk["evidence_locations"]):
+        raise RenewalSourceError("SCOPE_BLOCK_SHAPE", "scope block evidence_locations empty")
+    checks = raw.get("checks")
+    if not isinstance(checks, list):
+        raise RenewalSourceError("SCOPE_CHECK_NOT_PASS", "scope checks missing")
+    scope_checks = [c for c in checks if isinstance(c, dict) and c.get("check_id") == _SCOPE_CHECK_ID]
+    if not scope_checks or any(c.get("status") != "PASS" for c in scope_checks):
+        raise RenewalSourceError("SCOPE_CHECK_NOT_PASS", "substantive scope check missing or not PASS")
+    for c in scope_checks:
+        if not isinstance(c.get("detail"), str) or not c["detail"].strip() or not isinstance(c.get("evidence_locations"), list) or not c["evidence_locations"] or not all(isinstance(x, str) and x.strip() for x in c["evidence_locations"]):
+            raise RenewalSourceError("SCOPE_CHECK_NOT_PASS", "scope check lacks substantive detail/evidence")
+    indep = [c for c in checks if isinstance(c, dict) and c.get("check_id") == _INDEPENDENCE_CHECK_ID]
+    if not indep or any(c.get("status") != "PASS" for c in indep):
+        raise RenewalSourceError("SCOPE_CHECK_NOT_PASS", "pipeline-independence check missing or not PASS")
+    for c in indep:
+        if not isinstance(c.get("detail"), str) or not c["detail"].strip() or not isinstance(c.get("evidence_locations"), list) or not c["evidence_locations"]:
+            raise RenewalSourceError("SCOPE_CHECK_NOT_PASS", "independence check lacks substantive detail/evidence")
+    if _sha_bytes(sess.read(scope_rel, "scope review reverify")) != receipt_scope["sha256"]:
+        raise RenewalSourceError("SCOPE_BYTES_SWITCHED", "scope review file changed around validation")
+    return {"scope": raw, "source_ref": {"path": receipt_scope["path"], "sha256": receipt_scope["sha256"]}, "proposal_rel": proposal_rel, "staged_rel": staged_rel}
