+    f.add_argument("--basis", required=True)
+    f.add_argument("--checks", required=True)
+    f.add_argument("--semantic-review", default=None)
+    f.add_argument("--visual-review", default=None)
+    f.add_argument("--executor", required=True)
+    f.add_argument("--recorded-at", default=None)
+    t = sub.add_parser("prepare-targets")
+    t.add_argument("--root", required=True)
+    t.add_argument("--basis", required=True)
+    t.add_argument("--executor", required=True)
+    t.add_argument("--recorded-at", default=None)
+    vr = sub.add_parser("validate-receipt")
+    vr.add_argument("--root", required=True)
+    vr.add_argument("--receipt", required=True)
+    vs = sub.add_parser("validate-set")
+    vs.add_argument("--root", required=True)
+    vs.add_argument("--state", required=True)
+    vs.add_argument("--set", required=True)
+    a = sub.add_parser("activate")
+    a.add_argument("--root", required=True)
+    a.add_argument("--state", required=True)
+    a.add_argument("--set", required=True)
+    a.add_argument("--reason", required=True)
+    a.add_argument("--executor", required=True)
+    a.add_argument("--recorded-at", default=None)
+    r = sub.add_parser("resume")
+    r.add_argument("--root", required=True)
+    r.add_argument("--state", required=True)
+    r.add_argument("--record", required=True)
+    h = sub.add_parser("history")
+    h.add_argument("--root", required=True)
+    h.add_argument("--record", required=True)
+    args = parser.parse_args(argv)
+    try:
+        if args.command == "prepare":
+            result = prepare_renewal(args.root, args.state, args.renewal_id, args.intent,
+                                     args.manuscript_spec, args.toolchain_spec,
+                                     args.executor, args.recorded_at)
+        elif args.command == "finalize":
+            result = finalize_renewal(args.root, args.state, args.basis, args.checks,
+                                      args.semantic_review, args.visual_review,
+                                      args.executor, args.recorded_at)
+        elif args.command == "prepare-targets":
+            result = prepare_renewal_targets(args.root, args.basis,
+                                             args.executor, args.recorded_at)
+        elif args.command == "validate-receipt":
+            result = validate_renewal_receipt(args.root, args.receipt)
+        elif args.command == "validate-set":
+            result = validate_prepared_renewal_set(args.root, args.state, args.set)
+        elif args.command == "activate":
+            result = activate_renewal(args.root, args.state, args.set, args.reason,
+                                      args.executor, args.recorded_at)
+        elif args.command == "resume":
+            result = resume_renewal_activation(args.root, args.state, args.record)
+        elif args.command == "history":
+            result = verify_renewal_history(args.root, args.record)
+        else:
+            parser.error(f"unknown command: {args.command}")
+    except RenewalHighError as exc:
+        print(json.dumps({"phase": exc.phase, "code": exc.code,
+                          "disposition": exc.disposition, "detail": exc.detail}),
+              file=sys.stderr)
+        return 2
+    except Exception:
+        traceback.print_exc(file=sys.stderr)
+        return 1
+    print(json.dumps({k: v for k, v in result.items()
+                      if k not in ("entry", "basis", "proof", "set", "state")}, indent=1,
+                     default=str))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
+
