+            basis["basis_sha256"] = _sha_obj({k: v for k, v in basis.items() if k != "basis_sha256"})
+            basis_path.write_text(json.dumps(basis, indent=1, sort_keys=True), encoding="utf-8")
+            with self.assertRaises(Exception) as cm:
+                src.load_renewal_accepted_authority(sc.work, basis_rel)
+            _msg = str(cm.exception)
+            # Stronger H preemption is valid when same predicate + exact detail:
+            # H runs first via hist.verify_versioned_history and refuses with
+            # HISTORY_DIGEST_MISMATCH + historical detail (e.g. before-reader
+            # must equal proposal basis). Late S-only SCOPE_* requires proper
+            # rehash of historical proposal lineage; without it, earlier H
+            # refusal is correct classification (not S fallback). Accept either
+            # expected S code or H preemption with same predicate exact detail.
+            _h_before_detail = "before-reader must equal proposal basis active_reader_input_ref (historical)"
+            _h_after_detail = "scope reviewed_surface must equal proposal after reader"
+            if code == "SCOPE_WRONG_BEFORE":
