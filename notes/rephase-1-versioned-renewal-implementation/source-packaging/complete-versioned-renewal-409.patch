+def observe_renewal_authority(root: str | Path, state_path: str | Path,
+                              basis_path: str | Path) -> dict[str, Any]:
+    """HIGH basis-bound observation after basis capture, before finalize and
+    immediately before activation. Reopens ALL inputs and demands: LIVE State
+    bytes equal the fresh before_state_ref (live-live), retained COPY equals the
+    basis binding, selected predecessor equals the State-selected seal
+    (prior-relative + lineage-reachable), and basis.current_tool_epoch equals a
+    CURRENT disk closure/contract recompute member-wise (current-current). No
+    expected_contract caller argument; no old-State-vs-new-contract compare; no
+    verify_state_basis transitively. Detached readback never calls this function.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    repo = Path(root).resolve()
+    entry = _observe_renewal_entry(repo, state_path)
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    basis_bytes = _read_bytes_bounded(repo, basis_rel, "renewal basis")
+    basis = _strict_json_from_bytes(basis_bytes, "renewal basis")
+    if not isinstance(basis, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis must be an object")
+    if basis.get("schema_version") != "2.0-rc1" or basis.get("kind") != "VERSIONED_RENEWAL_BASIS_V1":
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis kind/version mismatch")
+    if core.sha256_object({k: v for k, v in basis.items() if k != "basis_sha256"}) != basis.get("basis_sha256"):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "renewal basis self-digest mismatch")
+    before_ref = basis.get("before_state_ref")
+    if not isinstance(before_ref, dict) or before_ref.get("path") != entry["state_rel"] \
+            or before_ref.get("sha256") != entry["state_sha"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "LIVE State must equal the fresh before_state_ref (live-live)")
+    retained_ref = basis.get("retained_copy_ref")
+    if not isinstance(retained_ref, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained_copy_ref invalid")
+    retained_data = _read_bytes_bounded(repo, _lexical_rel(repo, str(retained_ref["path"]),
+                                                           "retained COPY"), "retained COPY")
+    if _sha_bytes(retained_data) != retained_ref.get("sha256") \
+            or len(retained_data) != retained_ref.get("byte_count"):
+        raise _fail("RETAINED_COPY_MISSING", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained COPY bytes changed")
+    if _sha_bytes(retained_data) != before_ref.get("sha256"):
+        raise _fail("RETAINED_COPY_MISSING", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "retained COPY SHA must equal before_state_ref")
+    for key in ("prior_record_ref", "prior_selected_ref", "prior_candidate_ref"):
+        ref = basis.get(key)
+        want = {"prior_record_ref": entry["prior_record_ref"],
+                "prior_selected_ref": entry["prior_set_ref"],
+                "prior_candidate_ref": entry["prior_candidate_ref"]}[key]
+        if not isinstance(ref, dict) or ref.get("path") != want["path"] \
+                or ref.get("sha256") != want["sha256"]:
+            raise _fail("REVIEW_TARGET_MISMATCH", "OBSERVE", "REFUSED_PRE_WRITE",
+                        f"basis.{key} must equal the State-selected predecessor (prior-relative)")
+    epoch = basis.get("current_tool_epoch", {})
+    if epoch.get("repository_commit_sha") != entry["current_commit"]:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis current epoch moved (fresh basis required)")
+    if epoch.get("contract") != entry["current_contract"]:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis current contract moved (fresh basis required)")
+    try:
+        expected_names = hist._expected_receipt_closure(entry["generator_route"], "NEW")
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "UNSUPPORTED_MIGRATION"
+        raise _fail(str(code), "OBSERVE", "REFUSED_PRE_WRITE",
+                    f"closure expectation unavailable: {exc}") from exc
+    live_closure: dict[str, str] = {}
+    for name in expected_names:
+        data = _read_bytes_bounded(repo, _lexical_rel(repo, name, f"current closure {name}"),
+                                   f"current closure {name}")
+        live_closure[name] = _sha_bytes(data)
+    pinned = {str(r.get("name")): str(r.get("sha256"))
+              for r in epoch.get("closure", []) if isinstance(r, dict)}
+    if set(pinned) != set(expected_names):
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    "basis closure membership moved")
+    drifted = sorted(n for n in expected_names if pinned.get(n) != live_closure.get(n))
+    if drifted:
+        raise _fail("BASIS_CURRENT_TOOL_DRIFT", "OBSERVE", "REFUSED_PRE_WRITE",
+                    f"current tools drifted since basis capture: {drifted[:8]}")
+    return {"entry": entry, "basis": basis, "basis_rel": basis_rel,
+            "live_current_before": {"path": entry["state_rel"], "sha256": entry["state_sha"]},
+            "retained_before": {"path": str(retained_ref["path"]),
+                                "sha256": str(retained_ref["sha256"])},
+            "selected_predecessor": entry["prior_set_ref"],
+            "current_tools": {"repository_commit_sha": entry["current_commit"],
+                              "contract": entry["current_contract"]}}
+
+
+def verify_renewal_history(root: str | Path, record_path: str | Path) -> dict[str, Any]:
+    """HIGH wrapper delegating to the typed historian loader. Historical
+    structural loading of a renewal proof never executes its current-replay
+    branch. Returns the descriptive HIST verdict, never a permit."""
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    repo = Path(root).resolve()
+    rel = _lexical_rel(repo, str(record_path), "history record")
+    try:
+        return hist.verify_versioned_history(repo, rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_DIGEST_MISMATCH"
+        raise _fail(str(code), "HISTORY", "REFUSED_PRE_WRITE",
+                    f"history verification failed: {exc}") from exc
+
+
+def _load_prior_basis(repo: Path, entry: dict[str, Any]) -> dict[str, Any]:
+    """Reload the prior basis via the prior record's renewal_basis_ref.
+
+    For renewal predecessors only (repeat/C→U→U): the R receipt does not carry
+    authored/reviewed-reader inputs, so the unchanged values come from the
+    prior basis (exact path+SHA, live bytes verified, order preserved). Never
+    a caller dict; never the new basis being constructed.
+    """
+    record_rel = entry["prior_record_ref"]["path"]
+    record = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, _lexical_rel(repo, record_rel, "prior record"),
+                            "prior record"), "prior record")
+    if not isinstance(record, dict):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "prior record must be an object")
+    basis_ref = record.get("renewal_basis_ref", {})
+    if not isinstance(basis_ref, dict) or not isinstance(basis_ref.get("path"), str) \
+            or not _is_hex64(basis_ref.get("sha256")):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "prior record lacks exact renewal_basis_ref")
+    basis_rel = _lexical_rel(repo, str(basis_ref["path"]), "prior basis")
+    basis_bytes = _read_bytes_bounded(repo, basis_rel, "prior basis")
+    if _sha_bytes(basis_bytes) != basis_ref["sha256"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "prior basis bytes changed")
+    basis = _strict_json_from_bytes(basis_bytes, "prior basis")
+    if not isinstance(basis, dict):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "prior basis must be an object")
+    return basis
+
+
+def _load_prior_graph(repo: Path, entry: dict[str, Any]) -> dict[str, Any]:
+    """Reload prior seal + prior receipt as typed historical data (prior-relative).
+
+    Prior receipt is located via the prior seal's source-receipt role (never a
+    hardcoded P/ literal). Returns seal/receipt docs plus derived P namespace
+    (parent directory of the original proposal ref). Never the new seal being
+    constructed.
+    """
+    seal_rel = entry["prior_set_ref"]["path"]
+    seal_bytes = _read_bytes_bounded(repo, _lexical_rel(repo, seal_rel, "prior seal"),
+                                     "prior seal")
+    if _sha_bytes(seal_bytes) != entry["prior_set_ref"]["sha256"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior seal bytes changed")
+    seal = _strict_json_from_bytes(seal_bytes, "prior seal")
+    if not isinstance(seal, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior seal must be an object")
+    roles = seal.get("roles")
+    if not isinstance(roles, dict):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior seal roles missing")
+    receipt_role = roles.get("source-receipt")
+    if not isinstance(receipt_role, dict) or not isinstance(receipt_role.get("path"), str) \
+            or not _is_hex64(receipt_role.get("sha256")):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior seal lacks exact source-receipt role")
+    receipt_rel = _lexical_rel(repo, str(receipt_role["path"]), "prior receipt")
+    receipt_bytes = _read_bytes_bounded(repo, receipt_rel, "prior receipt")
+    if _sha_bytes(receipt_bytes) != receipt_role["sha256"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior receipt bytes changed")
+    receipt = _strict_json_from_bytes(receipt_bytes, "prior receipt")
+    if not isinstance(receipt, dict):
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior receipt must be an object")
+    proposal_ref = receipt.get("proposal_ref")
+    if not isinstance(proposal_ref, dict) or not isinstance(proposal_ref.get("path"), str) \
+            or not _is_hex64(proposal_ref.get("sha256")):
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior receipt lacks exact proposal_ref")
+    proposal_rel = _lexical_rel(repo, str(proposal_ref["path"]), "original proposal")
+    proposal_bytes = _read_bytes_bounded(repo, proposal_rel, "original proposal")
+    if _sha_bytes(proposal_bytes) != proposal_ref["sha256"]:
+        raise _fail("BASIS_DIGEST_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "original proposal bytes changed")
+    namespace = str(Path(proposal_rel).parent.as_posix())
+    if not namespace:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "REFUSED_PRE_WRITE",
+                    "original proposal namespace underivable")
+    return {"seal": seal, "seal_rel": seal_rel, "receipt": receipt,
+            "receipt_rel": receipt_rel, "proposal_namespace": namespace,
+            "proposal_rel": proposal_rel}
+
+
+def prepare_renewal(root: str | Path, state_path: str | Path, renewal_id: str,
+                    intent: str, manuscript_spec_path: str | Path | None,
+                    toolchain_spec_path: str | Path | None, executor: str,
+                    recorded_at: datetime | str | None = None) -> dict[str, Any]:
+    """Exclusive capture: entry -> COPY claim + inventory -> basis LAST + recheck.
+
+    U (REUSE_TARGETS): toolchain_spec_path MUST be None (CLI omits the option);
+    no build is spawned. C (RENDER_TARGETS): explicit toolchain spec REQUIRED
+    (rechecked, never synthesized). Intent has no power to waive derived checks.
+    Incomplete R remains inert; retry uses a new id (no same-byte takeover, no
+    cleanup of foreign/unknown residue). U sequence continues in finalize with
+    current in-memory reader/trio comparison and exact old targets/build-unit
+    validation; C continues with derived trio at new R paths.
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_versioned_renewal_history_v2 as hist
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    if not isinstance(renewal_id, str) or RENEWAL_ID_RE.fullmatch(renewal_id) is None:
+        raise _fail("ARGS", "PREPARE", "REFUSED_PRE_WRITE",
+                    "renewal_id must match [a-z0-9][a-z0-9-]{0,63}")
+    if intent not in INTENTS:
+        raise _fail("INTENT_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    f"intent must be one of {INTENTS}")
+    requested = "REUSE_TARGETS" if intent == "REUSE_TARGETS" else "RENDER_TARGETS"
+    if requested == "REUSE_TARGETS" and toolchain_spec_path is not None:
+        raise _fail("INTENT_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "U renewal forbids a toolchain spec (no build runs)")
+    if requested == "RENDER_TARGETS" and toolchain_spec_path is None:
+        raise _fail("INTENT_MISMATCH", "PREPARE", "REFUSED_PRE_WRITE",
+                    "C renewal requires an explicit toolchain spec")
+    if manuscript_spec_path is None:
+        raise _fail("ARGS", "PREPARE", "REFUSED_PRE_WRITE", "manuscript_spec_path required")
+    if not isinstance(executor, str) or not executor.strip():
+        raise _fail("ARGS", "PREPARE", "REFUSED_PRE_WRITE", "executor required")
+    ts = _now_utc(recorded_at)
+    entry = _observe_renewal_entry(repo, state_path)
+    state = entry["state"]
+    graph = _load_prior_graph(repo, entry)
+    receipt = graph["receipt"]
+    seal = graph["seal"]
+    namespace = graph["proposal_namespace"]
+    if receipt.get("issue_id") != state.get("issue_id"):
+        raise _fail("BASIS_ISSUE_PROFILE_DIVERGENCE", "PREPARE", "REFUSED_PRE_WRITE",
+                    "prior receipt issue differs from LIVE State issue")
+    renewal_rel = f"{namespace}/renewals/{renewal_id}"
+    _lexical_rel(repo, renewal_rel, "renewal directory")
+    _walk_existing_ancestors(repo, _lexical_parts(renewal_rel, "renewal directory"), "renewal directory")
+    try:
+        if os.lstat(repo.resolve().joinpath(*renewal_rel.split("/"))):
+            raise _fail("RECORD_COLLISION", "PREPARE", "PRESERVED_INCOMPLETE",
+                        f"renewal directory already claimed (fresh id required): {renewal_rel}")
+    except FileNotFoundError:
+        pass
+    except RenewalHighError:
+        raise
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "PREPARE", "PRESERVED_INCOMPLETE",
+                    f"renewal directory unreadable: {renewal_rel}: {exc}") from exc
+    try:
+        (repo / renewal_rel).mkdir(parents=True, exist_ok=False)
+    except FileExistsError as exc:
+        raise _fail("RECORD_COLLISION", "PREPARE", "PRESERVED_INCOMPLETE",
+                    f"renewal directory race-claimed: {renewal_rel}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "PREPARE", "PRESERVED_INCOMPLETE",
+                    f"renewal directory unavailable: {renewal_rel}: {exc}") from exc
+    _walk_existing_ancestors(repo, _lexical_parts(renewal_rel, "renewal directory"), "renewal directory")
+    _recheck_entry_pins(repo, entry, "PREPARE")
+    retained_rel = f"{renewal_rel}/retained/before/{entry['state_rel']}"
+    _lexical_rel(repo, retained_rel, "retained COPY")
+    copy_info = _atomic_write_new(repo, retained_rel, entry["state_bytes"], "retained COPY")
+    if copy_info["sha256"] != entry["state_sha"]:
+        raise _fail("RETAINED_COPY_MISSING", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "retained COPY SHA must equal before_state_ref")
+    try:
+        history = hist.verify_versioned_history(repo, entry["prior_record_ref"]["path"])
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "HISTORY_DIGEST_MISMATCH"
+        raise _fail(str(code), "PREPARE", "PRESERVED_INCOMPLETE",
+                    f"prior history revalidation failed: {exc}") from exc
+    observed = history.get("observed_source_bindings", [])
+    if not isinstance(observed, list) or not observed:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "historian observed bindings empty for active chain (must be NONEMPTY)")
+    prior_accepted = receipt.get("accepted_refs")
+    if not isinstance(prior_accepted, list) or not prior_accepted:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                    "prior receipt lacks accepted_refs")
+    prior_authored = receipt.get("authored_refs")
+    reviewed = receipt.get("reviewed_reader_input")
+    if receipt.get("kind") == "VERSIONED_RENEWAL_SOURCE_V1":
+        # Renewal predecessor (repeat/C→U→U): authoring/reader are unchanged
+        # across renewals and live on the prior BASIS (the R receipt carries
+        # accepted refs but no authored/reviewed-reader inputs). Load the
+        # prior basis via the prior record's renewal_basis_ref (exact path+SHA,
+        # live bytes verified) and copy verbatim (order preserved).
+        prior_basis = _load_prior_basis(repo, entry)
+        if not isinstance(prior_basis.get("authoring_refs"), list) \
+                or len(prior_basis["authoring_refs"]) != 2:
+            raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                        "prior basis lacks len2 authored_refs")
+        prior_authored = prior_basis["authoring_refs"]
+        if not isinstance(prior_basis.get("reviewed_reader_ref"), dict):
+            raise _fail("BASIS_ACCEPTED_SET_DRIFT", "PREPARE", "PRESERVED_INCOMPLETE",
+                        "prior basis lacks reviewed_reader_ref")
+        reviewed = {"path": str(prior_basis["reviewed_reader_ref"]["path"]),
+                    "sha256": str(prior_basis["reviewed_reader_ref"]["sha256"])}
+        live_rr = _read_bytes_bounded(repo, _lexical_rel(repo, reviewed["path"],
+                                                         "prior reviewed reader"),
+                                      "prior reviewed reader")
+        if _sha_bytes(live_rr) != reviewed["sha256"]:
