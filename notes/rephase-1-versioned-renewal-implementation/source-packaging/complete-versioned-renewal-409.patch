+    rp = "WEEKLY" if sc.kind == "weekly" else "THEMATIC"
+    pp = "WEEKLY_MAGAZINE" if sc.kind == "weekly" else "LONGFORM_SPECIAL"
+    route = "WEEKLY_GENERATED_V2" if sc.kind == "weekly" else "LONGFORM_GENERATED_V1"
+    cfg = json.loads((sc.work / str(core.DEFAULT_CONFIG)).read_bytes())
+    contract = core.contract_identity(sc.work, cfg, rp, pp)
+    profile_rel = f"sources/{sc.issue}/production-profile.json"
+    profile_sha = _sha_file(sc.work / profile_rel)
+    import sys as _sys
+    _sys.path.insert(0, str(sc.work))
+    try:
+        from scripts import survey_versioned_renewal_history_v2 as _hist
+        assert _hist.__file__.startswith(str(sc.work)), "H must load from scratch, not candidate-work"
+        _verdict = _hist.verify_versioned_history(
+            sc.work, f"sources/{sc.issue}/publication/v2/publication-surface-revalidation-r1.json")
+        assert _verdict.get("HISTORICAL_IDENTITY_VERIFIED")
+        observed = _verdict["observed_source_bindings"]
+        assert isinstance(observed, list) and observed, "H observed must be NONEMPTY for active chain"
+    finally:
+        _sys.path.remove(str(sc.work))
+    if observed_extra:
+        observed = list(observed) + list(observed_extra)
+    basis = {
+        "schema_version": "2.0-rc1", "kind": "VERSIONED_RENEWAL_BASIS_V1", "renewal_id": renewal_id,
+        "proposal_namespace": prop_ns, "issue_id": sc.issue, "research_profile": rp, "publication_profile": pp,
+        "generator_route": route,
+        "original_proposal_ref": {"path": pr["proposal_rel"], "sha256": _sha_file(sc.work / pr["proposal_rel"])},
+        "profile_ref": {"path": profile_rel, "sha256": profile_sha},
+        "reviewed_reader_ref": dict(pr["receipt"]["reviewed_reader_input"]),
+        "authoring_refs": pr["receipt"]["authored_refs"],
+        "accepted_refs": pr["receipt"]["accepted_refs"],
+        "original_validation_ref": {"path": f"sources/{sc.issue}/orchestration/v2/checkpoints/DRAFT_COMPLETE.json",
+                                    "sha256": _sha_file(sc.work / f"sources/{sc.issue}/orchestration/v2/checkpoints/DRAFT_COMPLETE.json")},
+        "prior_selected_ref": {"path": pr["seal_rel"], "sha256": _sha_file(sc.work / pr["seal_rel"])},
+        "prior_record_ref": {"path": f"sources/{sc.issue}/publication/v2/publication-surface-revalidation-r1.json",
+                             "sha256": _sha_file(sc.work / f"sources/{sc.issue}/publication/v2/publication-surface-revalidation-r1.json")},
+        "prior_candidate_ref": {"path": pr["seal"]["roles"]["publication-candidate"]["path"],
+                                  "sha256": pr["seal"]["roles"]["publication-candidate"]["sha256"]},
+        "canonical_anchor": {"kind": "VALIDATION_CHECKPOINT",
+                             "ref": {"path": f"sources/{sc.issue}/orchestration/v2/checkpoints/DRAFT_COMPLETE.json",
+                                     "sha256": _sha_file(sc.work / f"sources/{sc.issue}/orchestration/v2/checkpoints/DRAFT_COMPLETE.json")}},
+        "before_state_ref": {"path": state_rel, "sha256": state_sha},
+        "retained_copy_ref": {"path": synth_ret, "sha256": state_sha, "byte_count": state_n},
+        "observed_source_bindings": sorted(observed, key=lambda b: (b.get("source_ref", {}).get("path", ""), b.get("binding", ""))),
+        "current_tool_epoch": {"repository_commit_sha": head, "contract": contract, "closure": [
+            {"name": n, "path": n, "sha256": _sha_file(sc.work / n)}
+            for n in sorted(_closure_names(sc.work, route)) if (sc.work / n).is_file()]},
+        "retention_rows": [
+            {"roles": ["state:authority"], "path": state_rel, "sha256": state_sha, "byte_count": state_n,
+             "policy": "COPY_BEFORE_REPLACEMENT", "retained_dest": synth_ret, "retained_sha256": state_sha, "retained_byte_count": state_n},
+            {"roles": ["profile:authority"], "path": profile_rel, "sha256": profile_sha,
+             "byte_count": (sc.work / profile_rel).stat().st_size,
+             "policy": "KEEP_IMMUTABLE", "retained_ref": {"path": profile_rel, "sha256": profile_sha}},
+        ],
+        "requested": "REUSE_TARGETS", "executor": "phase-S-test (synthetic, non-genuine)",
+        "recorded_at": "2026-10-24T00:00:00+00:00", "basis_sha256": "0" * 64,
+    }
+    basis["basis_sha256"] = _sha_obj({k: v for k, v in basis.items() if k != "basis_sha256"})
+    basis_rel = f"{r_base}/renewal-basis.json"
+    (sc.work / basis_rel).parent.mkdir(parents=True, exist_ok=True)
+    (sc.work / basis_rel).write_text(json.dumps(basis, indent=1, sort_keys=True), encoding="utf-8")
+    return basis_rel, basis
