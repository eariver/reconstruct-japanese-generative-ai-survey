+def finalize_renewal(root: str | Path, state_path: str | Path, basis_path: str | Path,
+                     checks_path: str | Path, semantic_review_path: str | Path | None,
+                     visual_review_path: str | Path | None, executor: str,
+                     recorded_at: datetime | str | None = None) -> dict[str, Any]:
+    """Finalize: authority -> (U: proof -> build -> receipt | C: prebuilt
+    reload) -> QA/Gate/Candidate -> seal.
+
+    U (REUSE_TARGETS, validated only): semantic/visual args are either absent
+    (derive exact predecessor record refs) or exact predecessor refs; a
+    replacement review at a different path is never silently treated as reused.
+    No new manuscript/PDF/build executable runs for U. C (RENDER_TARGETS):
+    targets prebuilt by prepare_renewal_targets (proof/trio/manuscript/build/
+    receipt reloaded + revalidated here, never rebuilt); then new external
+    postrender reviews and actual QA inputs. Manuscript and build both exist
+    before external review. Receipt binds the build record, so the receipt
+    never precedes that record. finalize/validate-set MUST refuse a renewed
+    set whose NEW Candidate/QA/Gate files lack the NEW proof ref with
+    full-set SAME-proof equality (absence -> REVIEW_TARGET_MISMATCH, never a
+    silent fallback to the embedded PRIOR proof).
+    """
+    from scripts import survey_production_v2 as core
+    from scripts import survey_schema_v2 as schema_gate
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    if not isinstance(executor, str) or not executor.strip():
+        raise _fail("ARGS", "FINALIZE", "REFUSED_PRE_WRITE", "executor required")
+    ts = _now_utc(recorded_at)
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    authority = observe_renewal_authority(repo, state_path, basis_rel)
+    entry = authority["entry"]
+    basis = authority["basis"]
+    requested = basis.get("requested")
+    paths = _proof_paths_for_request(basis)
+    if requested == "REUSE_TARGETS":
+        if semantic_review_path is not None or visual_review_path is not None:
+            _check_supplied_review_is_predecessor(repo, basis, entry,
+                                                  semantic_review_path, visual_review_path)
+    else:
+        if semantic_review_path is None or visual_review_path is None:
+            raise _fail("REVIEW_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                        "C renewal requires new external postrender semantic+visual reviews")
+    if requested == "REUSE_TARGETS":
+        built = _build_proof_object(repo, basis, basis_rel, entry, executor.strip(), ts)
+        proof = _assemble_reused_proof(repo, basis, basis_rel, entry, built, executor.strip(), ts)
+        proof_rel = paths["proof"]
+        _write_json_bound(repo, proof_rel, proof, "proof_sha256", "renewal source proof",
+                          "FINALIZE", "RENEWAL_PROOF_DIGEST")
+        try:
+            proof_file_sha = _sha_bytes(_read_bytes_bounded(repo, proof_rel, "renewal proof pin"))
+            _validate_pinned_instance(repo, proof, proof_rel, proof_file_sha,
+                                      RENEWAL_PROOF_SCHEMA, "Renewal Source Proof", "FINALIZE")
+        except RenewalHighError:
+            raise
+        except (ValueError, OSError) as exc:
+            raise _fail("RENEWAL_PROOF_DIGEST", "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"renewal proof schema invalid: {exc}") from exc
+        try:
+            srcmod.verify_renewal_source_proof(repo, basis_rel, proof_rel)
+        except Exception as exc:
+            code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+            raise _fail(str(code), "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"detached proof verification failed: {exc}") from exc
+        _verify_renewal_rerender_equality_inner(repo, basis, basis_rel, proof_rel, proof)
+        build_record_rel = _write_reused_build_record(repo, basis, basis_rel, entry, proof,
+                                                      proof_rel, executor.strip(), ts)
+        receipt_rel = _write_renewal_receipt(repo, basis, basis_rel, entry, proof, proof_rel,
+                                             build_record_rel, executor.strip(), ts)
+        try:
+            srcmod.verify_renewal_source_proof(repo, basis_rel, proof_rel)
+        except Exception as exc:
+            code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+            raise _fail(str(code), "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"post-receipt proof revalidation failed: {exc}") from exc
+    else:
+        # C: prebuilt targets reloaded + revalidated (never rebuilt here, never
+        # trusted from memory). Missing targets refuse with an explicit code
+        # directing to prepare_renewal_targets first.
+        proof_rel = paths["proof"]
+        for rel, name in ((proof_rel, "renewal source proof"),
+                          (paths["manuscript"], "C manuscript"),
+                          (_proof_paths_for_request(basis)["build_record"], "build record"),
+                          (paths["receipt"], "renewal source receipt")):
+            try:
+                _read_bytes_bounded(repo, _lexical_rel(repo, rel, name), name)
+            except RenewalHighError:
+                raise _fail("BUILD_TARGETS_MISSING", "FINALIZE", "REFUSED_PRE_WRITE",
+                            f"C {name} not built (run prepare_renewal_targets first)") from None
+        proof = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, proof_rel, "renewal source proof"), "renewal source proof")
+        if not isinstance(proof, dict):
+            raise _fail("RENEWAL_PROOF_DIGEST", "FINALIZE", "REFUSED_PRE_WRITE",
+                        "renewal source proof must be an object")
+        if core.sha256_object({k: v for k, v in proof.items() if k != "proof_sha256"}) \
+                != proof.get("proof_sha256"):
+            raise _fail("RENEWAL_PROOF_DIGEST", "FINALIZE", "REFUSED_PRE_WRITE",
+                        "prebuilt proof self-digest mismatch")
+        if proof.get("basis_ref") != _file_ref(repo, basis_rel, "prebuilt proof basis pin"):
+            raise _fail("RENEWAL_PROOF_DIGEST", "FINALIZE", "REFUSED_PRE_WRITE",
+                        "prebuilt proof does not bind this basis (FILE SHA)")
+        try:
+            srcmod.verify_renewal_source_proof(repo, basis_rel, proof_rel)
+        except Exception as exc:
+            code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+            raise _fail(str(code), "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"prebuilt proof readback failed: {exc}") from exc
+        build_record_rel = _proof_paths_for_request(basis)["build_record"]
+        receipt_rel = paths["receipt"]
+        try:
+            receipt_check = validate_renewal_receipt(repo, receipt_rel)
+        except RenewalHighError:
+            raise
+        except Exception as exc:
+            code = getattr(exc, "code", None) or "RENEWAL_PROOF_DIGEST"
+            raise _fail(str(code), "FINALIZE", "REFUSED_PRE_WRITE",
+                        f"prebuilt receipt invalid: {exc}") from exc
+        _ = receipt_check
+    bundle_rel, gate_rel, candidate_rel = _write_qa_gate_candidate(
+        repo, basis, basis_rel, entry, proof, proof_rel, receipt_rel, paths,
+        checks_path, semantic_review_path, visual_review_path, executor.strip(), ts)
+    set_rel = _write_renewal_seal(repo, basis, basis_rel, entry, proof, proof_rel, receipt_rel,
+                                  build_record_rel, bundle_rel, gate_rel, candidate_rel,
+                                  executor.strip(), ts)
+    validated = validate_prepared_renewal_set(repo, state_path, set_rel)
+    _ = validated
+    return {"set_path": set_rel, "proof_path": proof_rel, "receipt_path": receipt_rel,
+            "build_record_path": build_record_rel, "bundle_path": bundle_rel,
+            "gate_path": gate_rel, "candidate_path": candidate_rel,
+            "disposition": proof["comparison"]["disposition"]}
