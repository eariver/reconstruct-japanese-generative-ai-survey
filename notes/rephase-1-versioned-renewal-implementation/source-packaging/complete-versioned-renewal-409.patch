+class TestPhaseSHighU(unittest.TestCase):
+    def _run_u(self, kind: str):
+        sc = Scratch(f"highu2-{kind}", kind)
+        _syspath(sc.work)
+        import sys as _sys2
+        for mod in [m for m in list(_sys2.modules) if m == "scripts" or m.startswith("scripts.")]:
+            _sys2.modules.pop(mod, None)
+        _syspath(sc.work)
+        from scripts import survey_versioned_renewal_v2 as high
+        from scripts import survey_versioned_renewal_source_v2 as src
+        assert high.__file__.startswith(str(sc.work)), "high must load from scratch clone"
+        assert src.__file__.startswith(str(sc.work)), "source must load from scratch clone"
+        state_rel = f"sources/{sc.issue}/production-state.json"
+        live_before = _sha_file(sc.work / state_rel)
+        mspec_rel = f"sources/{sc.issue}/publication/v2/editorial-corrections/{sc.prop}/manuscript-spec.json"
+        rid = f"high-u1-{kind}-s"
+        prep = high.prepare_renewal(sc.work, state_rel, rid, "REUSE_TARGETS", mspec_rel, None,
+                                    "phase-S-test (synthetic, non-genuine)", "2026-10-24T14:00:00+00:00")
+        basis_rel = prep["basis_path"]
+        self.assertTrue((sc.work / basis_rel).is_file())
+        checks_rel = _fresh_checks_for_u(sc)
+        proof_rel = basis_rel.replace("renewal-basis.json", "renewal-source-proof.json")
+        fin = high.finalize_renewal(sc.work, state_rel, basis_rel, checks_rel, None, None,
+                                    "phase-S-test (synthetic, non-genuine)", "2026-10-24T15:00:00+00:00")
+        (sc.rawdir / "high-u-finalize-pass.txt").write_text(
+            f"U finalize PASS via real backend ({kind}): basis={prep.get('basis_sha256')}\n", encoding="utf-8")
+        # Real HIGH API contract (scripts/survey_versioned_renewal_v2.py
+        # finalize_renewal returns *_path keys, not bare names). TEST-ONLY
+        # oracle fix, no product fallback.
+        for key in ("receipt_path", "build_record_path", "bundle_path", "gate_path", "candidate_path", "set_path", "proof_path"):
+            self.assertIn(key, fin, f"finalize must return {key} (real contract *_path)")
+            self.assertTrue((sc.work / fin[key]).is_file(), f"finalize artifact missing: {key}")
+        out = src.verify_renewal_source_proof(sc.work, basis_rel, proof_rel)
+        self.assertTrue(out.get("CURRENT_PROOF_VALID"))
+        self.assertEqual(out.get("basis_file_sha256"), _sha_file(sc.work / basis_rel),
+                         "callback FILE digest must match pinned basis bytes")
+        self.assertEqual(out.get("basis_self_sha256"), json.loads((sc.work / basis_rel).read_bytes())["basis_sha256"],
+                         "callback SELF digest must match basis field")
+        verdict = high.verify_renewal_rerender_equality(sc.work, basis_rel, proof_rel)
+        self.assertTrue(verdict.get("reader_equal") is True and verdict.get("trio_equal") is True,
+                        f"rendering preserved (U viable): {verdict}")
+        self.assertIn("trio_digest", verdict, "rerender verdict carries trio_digest (fixed)")
+        self.assertEqual(_sha_file(sc.work / state_rel), live_before, "finalize must not mutate live State")
+        with _no_state_raise(sc.work, state_rel):
+            out2 = src.verify_renewal_source_proof(sc.work, basis_rel, proof_rel)
+        self.assertTrue(out2.get("CURRENT_PROOF_VALID"))
+        return sc, basis_rel, proof_rel
+
+    def test_high_u_finalize_weekly(self):
+        self._run_u("weekly")
+
+    def test_high_u_finalize_longform(self):
+        self._run_u("longform")
