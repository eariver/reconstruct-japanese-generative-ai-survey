+
+class Scratch:
+    """Isolated fixture DB: NEW bootstrap byte copy + exact source snapshot commit.
+
+    Authorities (bootstrap untracked edition data + synthetic test basis files)
+    stay uncommitted; source commit precedes them. No high stub.
+    """
+
+    def __init__(self, tag: str, kind: str = "weekly"):
+        self.tag = tag
+        self.kind = kind
+        self.issue, self.prop = _RT[kind]
+        self.base = _scratch_base() / f"phase-s-{tag}"
+        if self.base.exists():
+            shutil.rmtree(self.base)
+        self.base.mkdir(parents=True)
+        work = self.base / "work"
+        shutil.copytree(_bootstrap_root(kind), work, symlinks=False)
+        _copy_tree_no_git(_candidate_root(), work)
+        self.work = work
+        _run_git(work, "config", "user.email", "fixture@example.invalid")
+        _run_git(work, "config", "user.name", "fixture")
+        _run_git(work, "config", "commit.gpgsign", "false")
+        _run_git(work, "remote", "remove", "origin")
+        _run_git(work, "remote", "add", "origin", "https://example.invalid/phase-s-fixture.git")
+        add = _run_git(work, "add", *_SOURCE_PATHS)
+        assert add.returncode == 0, add.stderr[:2000]
+        cm = _run_git(work, "commit", "-m", f"phase-S {tag}: exact intended source snapshot (isolated, not public)")
+        assert cm.returncode == 0, cm.stderr[:2000]
+        self.head = _run_git(work, "rev-parse", "HEAD").stdout.decode().strip()
+        snap = [
+            f"HEAD {self.head}",
+            "--- ls-files -s (source paths) ---",
+            _run_git(work, "ls-files", "-s", "--", *_SOURCE_PATHS).stdout.decode(),
+            "--- status (source paths, must be clean) ---",
+            _run_git(work, "status", "--short", "--", *_SOURCE_PATHS).stdout.decode(),
+            "--- status (all, authorities may be untracked) ---",
+            _run_git(work, "status", "--short").stdout.decode()[:3000],
+        ]
+        self.rawdir = _scratch_base() / f"phase-s-{tag}-raw"
+        self.rawdir.mkdir(parents=True, exist_ok=True)
+        (self.rawdir / "source-snapshot.txt").write_text("\n".join(snap), encoding="utf-8")
+        src_status = _run_git(work, "status", "--short", "--", *_SOURCE_PATHS).stdout.decode().strip()
+        assert src_status == "", f"source paths not clean after snapshot commit: {src_status[:1000]}"
+        import sys
+        if str(work) not in sys.path:
+            sys.path.insert(0, str(work))
+        for mod in [m for m in list(sys.modules) if m == "scripts" or m.startswith("scripts.")]:
+            sys.modules.pop(mod, None)
+
+    def p(self, *parts: str) -> Path:
+        return self.work.joinpath(*parts)
+
+    def j(self, rel: str) -> dict:
+        return json.loads((self.work / rel).read_bytes())
+
+
+def _syspath(work: Path) -> None:
+    import sys
+    if str(work) not in sys.path:
+        sys.path.insert(0, str(work))
