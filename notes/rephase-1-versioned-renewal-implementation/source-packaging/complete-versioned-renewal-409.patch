+            (repo / jsonl_rel).write_bytes(swapped_bytes)
+            return res
+
+        import unittest.mock as mock
+        pre_files = sorted(str(p.relative_to(sc.work)) for p in sc.work.rglob("*") if p.is_file() and ".git/" not in str(p))
+        # Note: pre_files is generator; materialize.
