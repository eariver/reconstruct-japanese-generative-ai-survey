+                # Need src to use patched disc_mod: src imports disc_mod inside function,
+                # so patching sys.modules entry works.
+                import sys
+                # Ensure src re-imports patched module (it does `from scripts import ...` each call,
+                # which will hit sys.modules patched entry).
+                with self.assertRaises(Exception) as cm:
+                    src.load_renewal_accepted_authority(sc.work, basis_rel)
+            msg = str(cm.exception)
+            self.assertIn("BASIS_DIGEST_MISMATCH", msg, f"F2 must fail hash pin, got: {msg}")
+            self.assertIn("Discovery JSONL bytes changed", msg, f"F2 must be JSONL pin, got: {msg}")
+            (sc.rawdir / "f2-seam-refused.txt").write_text(msg + "\n", encoding="utf-8")
+            post_files = sorted(str(p.relative_to(sc.work)) for p in sc.work.rglob("*") if p.is_file() and ".git/" not in str(p) and "f2-seam" not in str(p))
+            # No writes inside work except swapped JSONL (which we did as seam, not product).
+            # Restore happens in finally; here just check no R/ artifacts created.
+        finally:
