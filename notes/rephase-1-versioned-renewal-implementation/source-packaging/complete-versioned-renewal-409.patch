+def resume_renewal_activation(root: str | Path, state_path: str | Path,
+                              record_path: str | Path) -> dict[str, Any]:
+    """Explicit resume: reloads record+set+basis and compares the COMPLETE
+    exact branch/issue/original checkpoint/anchor/supersedes/before-State/
+    digest/Candidate/set/basis/new-core/executor/reason/time intent, not only
+    set SHA. Recomputes before_active_digest with the existing effective7+
+    Candidate algorithm; basis/proof are additionally covered by new set and
+    record refs. Complete record + State exactly before -> ordinary activate
+    collision resolved by explicit install. State exactly expected after ->
+    readonly ALREADY_ACTIVE. Neither/unsafe -> INDETERMINATE preserve."""
+    from scripts import survey_agent_control_v2 as agent
+    from scripts import survey_publication_set_v2 as setmod
+    from scripts import survey_production_v2 as core
+    repo = Path(root).resolve()
+    state_rel = _lexical_rel(repo, str(state_path), "Production State")
+    record_rel = _lexical_rel(repo, str(record_path), "activation record")
+    record_bytes = _read_bytes_bounded(repo, record_rel, "activation record")
+    record = _strict_json_from_bytes(record_bytes, "activation record")
+    if not isinstance(record, dict) or record.get("kind") != "VERSIONED_RENEWAL_ACTIVATION_V1" \
+            or record.get("reason_class") != "REVIEWED_VERSIONED_CORE_RENEWAL":
+        raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                    "record is not a versioned renewal activation")
+    try:
+        setmod.validate_activation_record(repo, Path(record_rel))
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "RECORD_COLLISION"
+        raise _fail(str(code), "RESUME", "REFUSED_PRE_WRITE",
+                    f"record low validation failed: {exc}") from exc
+    set_ref = record.get("set_ref", {})
+    basis_ref = record.get("renewal_basis_ref", {})
+    proof_ref = record.get("renewal_proof_ref", {})
+    set_bytes = _read_bytes_bounded(repo, _lexical_rel(repo, str(set_ref.get("path", "")),
+                                                       "resume seal"), "resume seal")
+    if _sha_bytes(set_bytes) != set_ref.get("sha256"):
+        raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE", "resume seal bytes changed")
+    basis_bytes = _read_bytes_bounded(repo, _lexical_rel(repo, str(basis_ref.get("path", "")),
+                                                         "resume basis"), "resume basis")
+    if _sha_bytes(basis_bytes) != basis_ref.get("sha256"):
+        raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                    "resume basis bytes changed")
+    basis = _strict_json_from_bytes(basis_bytes, "resume basis")
+    state_bytes = _read_bytes_bounded(repo, state_rel, "Production State")
+    state = _strict_json_from_bytes(state_bytes, "Production State")
+    cfg = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, "config/survey-production-v2.json", "production config"),
+        "production config")
+    before_ref = record.get("before_state_ref", {})
+    expected_pointer = {"path": record_rel, "sha256": _sha_bytes(record_bytes)}
+    live_pointer = state.get("publication_revalidation_provenance")
+    before_rel_expected = _lexical_rel(repo, str(before_ref.get("path", "")), "before State")
+    if _sha_bytes(state_bytes) == before_ref.get("sha256") \
+            and state_rel == before_rel_expected:
+        try:
+            if _file_identity(repo, state_rel, "resume before State") != _file_identity(
+                    repo, before_rel_expected, "resume before expected"):
+                raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                            "before State identity changed for exact spelling "
+                            f"(alias?): {state_rel!r} vs {before_rel_expected!r}")
+        except RenewalHighError:
+            raise
+        _refuse_alias_unless_exact(repo, state_rel, before_rel_expected,
+                                   _sha_bytes(state_bytes), str(before_ref.get("sha256", "")),
+                                   "resume before State", "RESUME")
+        for key in ("issue_id", "reason", "executor", "recorded_at"):
+            if record.get(key) is None:
+                raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                            f"record intent incomplete: {key}")
+        try:
+            selection = setmod.resolve_publication_selection(repo, cfg, state)
+        except Exception as exc:
+            raise _fail("SELECTION_BEFORE", "RESUME", "REFUSED_PRE_WRITE",
+                        f"resume selection failed: {exc}") from exc
+        try:
+            recomputed = setmod.before_active_digest(selection.get("effective7", {}),
+                                                     record.get("before_candidate_ref", {}))
+        except Exception as exc:
+            raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                        f"resume digest recompute failed: {exc}") from exc
+        if recomputed != record.get("before_active_digest"):
+            raise _fail("RECORD_COLLISION", "RESUME", "REFUSED_PRE_WRITE",
+                        "resume before_active_digest mismatch")
+        validate_prepared_renewal_set(repo, state_rel, str(set_ref.get("path", "")))
+        observe_renewal_authority(repo, state_rel, str(basis_ref.get("path", "")))
+        new_state = dict(state)
+        new_state["publication_revalidation_provenance"] = dict(expected_pointer)
+        new_bytes = core.json_bytes(new_state)
+        _replace_state_bytes(repo, state_rel, state_bytes, new_bytes, "resume State")
+        post_state = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, state_rel, "resumed State"), "resumed State")
+        post_errors = agent.validate_agent_state(repo, cfg, post_state)
+        if post_errors:
+            raise _fail("INDETERMINATE", "RESUME", "PRESERVED_INCOMPLETE",
+                        "post-resume State invalid (preserved): " + "; ".join(post_errors))
+        validate_prepared_renewal_set(repo, state_rel, str(set_ref.get("path", "")))
+        return {"status": "ACTIVATED", "record_path": record_rel, "state_path": state_rel,
+                "observed": "resumed"}
+    if _check_already_active_record(repo, record_rel, _sha_bytes(record_bytes),
+                                    live_pointer, "resume record", "RESUME"):
+        post_errors = agent.validate_agent_state(repo, cfg, state)
+        if post_errors:
+            raise _fail("ALREADY_ACTIVE_STATE", "RESUME", "REFUSED_PRE_WRITE",
+                        "ALREADY_ACTIVE State invalid: " + "; ".join(post_errors))
+        validate_prepared_renewal_set(repo, state_rel, str(set_ref.get("path", "")))
+        return {"status": "ALREADY_ACTIVE", "record_path": record_rel,
+                "state_path": state_rel, "observed": "new"}
+    observed = "unknown"
+    try:
+        observed = f"sha={_sha_bytes(state_bytes)[:12]}"
+    except RenewalHighError:
+        pass
+    raise _fail("INDETERMINATE", "RESUME", "PRESERVED_INCOMPLETE",
+                f"State neither before nor expected after ({observed}); "
+                f"preserved, no rollback/overwrite/adoption")
+
+
+def _verify_renewal_rerender_equality_inner(repo: Path, basis: dict[str, Any],
+                                            basis_rel: str, proof_rel: str,
+                                            proof: dict[str, Any]) -> dict[str, Any]:
+    verdict = verify_renewal_rerender_equality(repo, basis_rel, proof_rel)
+    if verdict.get("reader_equal") is not True or verdict.get("trio_equal") is not True:
+        raise _fail("REUSE_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "in-memory rederivation does not equal old targets")
+    if proof.get("reader_digest") != verdict.get("reader_digest") \
+            or proof.get("trio_digest") != verdict.get("trio_digest"):
+        raise _fail("REUSE_TARGET_MISMATCH", "FINALIZE", "REFUSED_PRE_WRITE",
+                    "proof digests differ from independent rederivation")
+    return verdict
+
+
+def verify_renewal_rerender_equality(root: str | Path, basis_path: str | Path,
+                                     proof_path: str | Path) -> dict[str, Any]:
+    """U NEW: CURRENT renderer/style to disposable temp trio + complete reader
+    vs OLD prior-relative bytes at PRIOR paths (never P/publication vs R
+    confusion). Mismatch -> REUSE_TARGET_MISMATCH, no auto-convert to C."""
+    from scripts import survey_production_v2 as core
+    from scripts import survey_versioned_renewal_source_v2 as srcmod
+    repo = Path(root).resolve()
+    basis_rel = _lexical_rel(repo, str(basis_path), "renewal basis")
+    proof_rel = _lexical_rel(repo, str(proof_path), "renewal proof")
+    basis = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, basis_rel, "renewal basis"), "renewal basis")
+    proof = _strict_json_from_bytes(
+        _read_bytes_bounded(repo, proof_rel, "renewal proof"), "renewal proof")
+    try:
+        current = srcmod.load_renewal_accepted_authority(repo, basis_rel)
+    except Exception as exc:
+        code = getattr(exc, "code", None) or "BASIS_ACCEPTED_SET_DRIFT"
+        raise _fail(str(code), "RERENDER", "REFUSED_PRE_WRITE",
+                    f"accepted-authority assembly failed: {exc}") from exc
+    surface = current.get("surface")
+    route = basis.get("generator_route")
+    if route == WEEKLY_ROUTE:
+        reader_bytes = core.json_bytes(surface)
+        from scripts.survey_weekly_derivation_v2 import (
+            render_bibliography as _w_render_bib, render_main as _w_render_main)
+        main_bytes = _w_render_main(surface).encode("utf-8")
+        bib_bytes = _w_render_bib(surface).encode("utf-8")
+    elif route == LONGFORM_ROUTE:
+        from scripts.survey_longform_derivation_v2 import (
+            canonical_reader_bytes as _lf_bytes)
+        from scripts.survey_longform_generated_v2 import (
+            render_bibliography as _lf_render_bib, render_main as _lf_render_main)
+        reader_bytes = _lf_bytes(surface)
+        main_bytes = _lf_render_main(surface).encode("utf-8")
+        bib_bytes = _lf_render_bib(surface).encode("utf-8")
+    else:
+        raise _fail("BASIS_ACCEPTED_SET_DRIFT", "RERENDER", "REFUSED_PRE_WRITE",
+                    f"unsupported route: {route}")
+    reviewed = basis.get("reviewed_reader_ref", {})
+    live_reader = _read_bytes_bounded(repo, _lexical_rel(repo, str(reviewed.get("path", "")),
+                                                         "reviewed reader"), "reviewed reader")
+    reader_equal = (live_reader == reader_bytes)
+    trio = proof.get("output_trio_refs", {})
+    trio_equal = True
+    for key, rendered in (("primary", main_bytes), ("bibliography", bib_bytes)):
+        ref = trio.get(key, {})
+        live = _read_bytes_bounded(repo, _lexical_rel(repo, str(ref.get("path", "")),
+                                                      f"rerender trio {key}"),
+                                   f"rerender trio {key}")
+        if live != rendered or _sha_bytes(live) != ref.get("sha256"):
+            trio_equal = False
+    from scripts.survey_editorial_staged_source_v2 import STYLE_PATH as _rerender_style_const
+    current_style_data = _read_bytes_bounded(
+        repo, _lexical_rel(repo, _rerender_style_const.as_posix(), "current style template"),
+        "current style template")
+    style_ref = trio.get("style", {})
+    style_live = _read_bytes_bounded(repo, _lexical_rel(repo, str(style_ref.get("path", "")),
+                                                       "rerender trio style"),
+                                     "rerender trio style")
+    if _sha_bytes(style_live) != style_ref.get("sha256"):
+        trio_equal = False
+    if _sha_bytes(current_style_data) != _sha_bytes(style_live):
+        trio_equal = False
+    # Descriptive digests recomputed with the EXACT Layer-B formulas (weekly:
+    # json_bytes surface; trio object {primary,bibliography,style} via
+    # sha256_object) using CURRENT style input for both C writes and U proof
+    # old output (ROOT clarification). S must compare the same current style;
+    # if S needs a change, report the exact interface for root to coordinate.
+    trio_digest = core.sha256_object({
+        "primary": _sha_bytes(main_bytes),
+        "bibliography": _sha_bytes(bib_bytes),
+        "style": _sha_bytes(current_style_data)})
+    disposition = "REUSED_TARGETS" if (reader_equal and trio_equal) else "MISMATCH"
+    return {"reader_equal": reader_equal, "trio_equal": trio_equal,
+            "disposition": disposition, "reader_digest": _sha_bytes(reader_bytes),
+            "trio_digest": trio_digest}
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="survey_versioned_renewal_v2",
+                                     description="Versioned same-reader renewal HIGH operation")
+    sub = parser.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("prepare")
+    p.add_argument("--root", required=True)
+    p.add_argument("--state", required=True)
+    p.add_argument("--renewal-id", required=True)
+    p.add_argument("--intent", required=True, choices=list(INTENTS))
