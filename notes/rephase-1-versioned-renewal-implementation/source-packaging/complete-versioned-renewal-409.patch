+def basis_proof_trio_placeholder(repo: Path, basis: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """Resolve the proof trio location by request kind (paths only, no bytes claim).
+
+    U reuses the immediate predecessor trio (prior-relative seal roles); C uses
+    new R/ trio paths derived after proof. This helper returns the path triple
+    the proof will bind; byte validation happens in Layer-B readback.
+    """
+    requested = basis.get("requested")
+    if requested == "REUSE_TARGETS":
+        prior_seal_rel = basis["prior_selected_ref"]["path"]
+        seal = _strict_json_from_bytes(
+            _read_bytes_bounded(repo, _lexical_rel(repo, prior_seal_rel, "prior seal"),
+                                "prior seal"), "prior seal")
+        roles = seal.get("roles", {})
+        trio = {}
+        for proof_key, role_name in (("primary", "validated-source"),
+                                     ("bibliography", "bibliography"), ("style", "style")):
+            fr = roles.get(role_name)
+            if not isinstance(fr, dict):
+                raise _fail("REVIEW_TARGET_MISMATCH", "PROOF", "REFUSED_PRE_WRITE",
+                            f"prior seal lacks trio role: {role_name}")
+            trio[proof_key] = {"path": str(fr["path"]), "sha256": str(fr.get("sha256", "")),
+                               "byte_count": int(fr.get("byte_count", 0))}
+        return trio
+    namespace = basis.get("proposal_namespace", "")
+    rid = basis.get("renewal_id", "")
+    prefix = f"{namespace}/renewals/{rid}/staged-source"
+    return {"primary": {"path": f"{prefix}/main.tex", "sha256": "", "byte_count": 0},
+            "bibliography": {"path": f"{prefix}/references.bib", "sha256": "", "byte_count": 0},
+            "style": {"path": f"{prefix}/jgaisurvey.sty", "sha256": "", "byte_count": 0}}
+
+
+def _proof_paths_for_request(basis: dict[str, Any]) -> dict[str, str]:
+    renewal_rel = f"{basis['proposal_namespace']}/renewals/{basis['renewal_id']}"
+    return {
+        "renewal_dir": renewal_rel,
+        "proof": f"{renewal_rel}/renewal-source-proof.json",
+        "receipt": f"{renewal_rel}/validated-source-manifest.json",
+        "build_record": f"{renewal_rel}/build-record.json",
+        "bundle": f"{renewal_rel}/quality-regression-bundle-v2.json",
+        "gate": f"{renewal_rel}/reader-surface-gate-v2.json",
+        "candidate": f"{renewal_rel}/publication-candidate-v2.json",
+        "set": f"{renewal_rel}/publication-set.json",
+        "manuscript": f"{renewal_rel}/reader-manuscript-v2.json",
+    }
