+        manifest = core.load_json(pair["manifest_path"])
+        mstate_rows = [r for r in manifest["rows"] if "state:authority" in (r.get("roles") or [])]
+        self.assertEqual(len(mstate_rows), 1, "unique state:authority manifest row required")
+        self.assertEqual(mstate_rows[0]["policy"], "COPY_BEFORE_REPLACEMENT")
+        # Append whitespace to live State bytes ONLY: same parsed JSON and
