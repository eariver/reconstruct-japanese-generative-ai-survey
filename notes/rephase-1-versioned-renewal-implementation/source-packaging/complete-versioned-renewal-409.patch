+def load_renewal_accepted_authority(root: Path | str, basis_path: Path | str) -> dict[str, Any]:
+    """Layer-A accepted-authority assembly (NO Git, NO State, NO impl SHA).
+
+    Returns ONLY {surface, records, accepted_refs, authored_refs} (descriptive).
+    Callback API naming: every {name,path,sha256} row and every {path,sha256}
+    ref in accepted_refs/authored_refs carries a FILE digest (pinned file
+    bytes SHA); no SELF digests appear in this return.
+    """
+    repo = Path(root).resolve()
+    sess = _session_from_basis(repo, basis_path)
+    exp = _expectations_from_session(sess)
+    if not exp.get("issue_id") or not exp.get("research_profile") or not exp.get("canonical_state_path"):
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "basis expectations incomplete")
+    # Canonical SOURCE path must match before source path (same canonical path, §11.3).
+    # Verify canonical via Profile source_root + config authoritative_filename (P1 1575-1583 rule, no State validation).
+    from scripts import survey_production_v2 as core
+    basis = sess.basis
+    profile_rel = basis["profile_ref"]["path"]
+    profile = sess.load(profile_rel, "basis Profile")
+    cfg = sess.load(str(core.DEFAULT_CONFIG), "production config")
+    try:
+        source_root_rel = profile.get("paths", {}).get("source_root")
+        auth_file = cfg.get("state_authority", {}).get("authoritative_filename")
+        if not isinstance(source_root_rel, str) or not isinstance(auth_file, str):
+            raise RenewalSourceError("BASIS_STATE_PATH_IDENTITY", "Profile/config canonical State path missing")
+        # Same source-root rule as P1 1575-1583: repo_local_path(source_root) / auth_file
+        source_root = core.repo_local_path(repo, source_root_rel, "Profile source_root")
+        # Derive canonical repo-relative path without requiring live State validation.
+        # source_root is absolute (repo-local); auth_file is filename (no traversal).
+        if Path(auth_file).is_absolute() or ".." in Path(auth_file).parts:
+            raise RenewalSourceError("BASIS_STATE_PATH_IDENTITY", "authoritative_filename unsafe")
+        canonical_abs = (source_root / auth_file).resolve()
+        canonical_rel = str(canonical_abs.relative_to(repo))
+    except RenewalSourceError:
+        raise
+    except Exception as exc:
+        raise RenewalSourceError("BASIS_STATE_PATH_IDENTITY", f"canonical State path derivation failed: {exc}") from exc
+    if canonical_rel.replace("\\", "/") != str(exp["canonical_state_path"]).replace("\\", "/"):
+        raise RenewalSourceError("BASIS_STATE_PATH_IDENTITY", f"basis before_state path differs from Profile-derived canonical: {canonical_rel} vs {exp['canonical_state_path']}")
+    # BEFORE path must also equal original package state_path for screening/evidence packages?
+    # (Enforced inside package content validators via canonical_state_path; here enforce that
+    # basis.before_state_ref.path == canonical (same canonical SOURCE path, §11.3).
+    if str(basis["before_state_ref"]["path"]).replace("\\", "/") != canonical_rel.replace("\\", "/"):
+        raise RenewalSourceError("BASIS_STATE_PATH_IDENTITY", "basis before_state_ref differs from canonical SOURCE path")
+    prior = _verify_prior_receipt_match(sess, exp)
+    graph = _trace_checkpoint_graph(sess, exp, prior)
+    scope_out = _validate_scope_o17(sess, exp, prior)
+    by_name: dict[str, dict[str, str]] = {}
+    for r in basis.get("accepted_refs", []):
+        by_name[str(r.get("name"))] = {"path": str(r.get("path")), "sha256": str(r.get("sha256"))}
+    typed_by_name: dict[str, dict[str, str]] = {}
+    for (tname, tpath, tsha), trow in graph["typed"].items():
+        if tname in typed_by_name:
+            raise RenewalSourceError("REVIEW_TARGET_MISMATCH", f"duplicate typed artifact name: {tname}")
+        typed_by_name[tname] = trow
+    _REVERSE_PRODUCERS: dict[str, str] = {
+        "discovery-acceptance": "discovery",
+        "screening-acceptance": "screening",
+        "evidence-acceptance": "evidence",
+        "edition-views-acceptance": "evidence",
+        "materiality-ledger": "materiality",
+        "profile-completeness": "completeness",
+        "candidate-matrix": "selection",
+        "candidate-selection": "selection",
+        "issue-architecture": "architecture",
+        "architecture-review-summary": "architecture",
+        "architecture-review-attention": "architecture",
+        "synthesis-input": "draft",
+        "synthesis-result": "draft",
+    }
+    def _need(name: str) -> Path:
+        if name not in by_name:
+            raise RenewalSourceError("BASIS_ACCEPTED_SET_DRIFT", f"missing accepted row: {name}")
+        rel = _to_rel(repo, by_name[name]["path"], f"accepted {name}")
+        data = sess.read(rel, f"accepted {name}")
+        if _sha_bytes(data) != by_name[name]["sha256"]:
+            raise RenewalSourceError("BASIS_DIGEST_MISMATCH", f"accepted row bytes changed: {name}")
+        return repo / rel
+    # Common accepted files (both routes; longform has extra archive/authored handling below).
+    # Names per weekly/longform derivation accepted_refs (see load_derivation).
+    # Required for both: production-profile? Actually accepted_refs includes production-profile?
+    # Weekly accepted_refs includes production-profile, issue-architecture, synthesis-*, draft-*, evidence-acceptance, candidate-matrix, materiality-ledger, discovery-acceptance, + cards.
+    # Basis.accepted_refs should include those (11? Actually weekly receipt accepted_refs len 11? Let's see: production-profile + issue-architecture + synthesis-input/result (2) + draft-package/result per pid? For wk-boot-1 with 1 package? Then draft-package:pid + draft-result:pid (2) + evidence-acceptance + candidate-matrix + materiality-ledger + discovery-acceptance = 1+1+2+2+1+1+1+1 =10? Plus cards? Cards are separate card_refs, not in accepted_refs? Actually weekly accepted_refs includes card_refs? In load_derivation, accepted_refs extends with card_refs (evidence-card:*). So accepted_refs includes cards. Good.
+    # For Layer-A, need to locate: profile, architecture, synthesis-input/result, draft-package/result per pid, evidence-acceptance, matrix, ledger, discovery-acceptance, plus X manifest + discovery JSONL + screening package? Actually screening/evidence packages are not in accepted_refs directly? Evidence-acceptance's package is in same run dir (package.json), screening acceptance similarly. Discovery JSONL path is via discovery acceptance's discovery_path? X manifest via discovery acceptance's x_source_intake? Good – derive via those files.
+    # Load profile (already loaded above as `profile`), architecture, synthesis, draft ordered, etc. via checkpoint artifacts? Simpler: load via accepted rows by name.
+    # Discover root records for screening effective (session root, no State): need raw discovery JSONL records (for screening expansion).
+    # Discovery JSONL path: from discovery acceptance's discovery_path? Load discovery acceptance first (pure, no State).
+    # Order: discovery/X -> screening -> evidence/views/ledger/completeness -> selection/synthesis/architecture/approval/draft -> records/surface.
+    from scripts import survey_screening_v2 as screening_mod
+    # Discovery acceptance (pure, no State). Pin via sess BEFORE content
+    # validation to bind basis.accepted row bytes; reverify live still equals
+    # pinned immediately after validation to close swap-between-pin-and-check.
+    disc_acc_rel = by_name.get("discovery-acceptance", {}).get("path")
+    if not disc_acc_rel:
+        raise RenewalSourceError("BASIS_ACCEPTED_SET_DRIFT", "missing discovery-acceptance row")
+    disc_acc_rel = _to_rel(repo, disc_acc_rel, "discovery-acceptance")
+    disc_acc_expected = by_name.get("discovery-acceptance", {}).get("sha256")
+    disc_acc_pinned = sess.read(disc_acc_rel, "discovery-acceptance")
+    if not _is_hex64(disc_acc_expected) or _sha_bytes(disc_acc_pinned) != disc_acc_expected:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "discovery-acceptance bytes changed")
+    disc_acc_path = repo / disc_acc_rel
+    from scripts import survey_discovery_v2 as disc_mod
+    disc_acceptance = disc_mod.validate_acceptance_content(repo, disc_acc_path)
+    # Immediate reverify: live file must still equal pinned bytes observed
+    # before validation (no swap between sess pin and content check).
+    if _fd_read(repo, disc_acc_rel, "reverify discovery-acceptance") != disc_acc_pinned:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "pinned file changed during call: discovery-acceptance")
+    # X manifest via discovery acceptance's x_source_intake (pure, cfg from current disk, no State).
+    from scripts import survey_x_intake_v2 as x_mod
+    x_ref = disc_acceptance.get("x_source_intake")
+    if not isinstance(x_ref, dict) or "path" not in x_ref:
+        raise RenewalSourceError("BASIS_ACCEPTED_SET_DRIFT", "discovery acceptance lacks x_source_intake")
+    x_rel = _to_rel(repo, x_ref["path"], "x_source_intake")
+    if _sha_bytes(sess.read(x_rel, "x_source_intake")) != x_ref["sha256"]:
+        raise RenewalSourceError("BASIS_DIGEST_MISMATCH", "x_source_intake bytes changed")
+    x_manifest = x_mod.validate_manifest_content(repo, cfg, repo / x_rel, require_complete=True)
+    x_path = repo / x_rel
+    # Screening root records for effective basis: raw discovery JSONL records
+    # (from discovery acceptance's discovery_path). FD-bound sess read ONLY:
+    # verify exact discovery_sha256 from the accepted record, then parse the
+    # SAME pinned bytes (no second file open via screening.read_jsonl, no
+    # caller dict, no State calls). Downstream content helpers receive these
+    # pinned records + the pinned path; they must not re-read the JSONL.
+    disc_jsonl_rel = disc_acceptance.get("discovery_path")
+    if not isinstance(disc_jsonl_rel, str):
+        raise RenewalSourceError("BASIS_ACCEPTED_SET_DRIFT", "discovery acceptance lacks discovery_path")
+    disc_jsonl_rel = _to_rel(repo, disc_jsonl_rel, "Discovery JSONL")
+    disc_jsonl_pinned = sess.read(disc_jsonl_rel, "Discovery JSONL")
+    expected_disc_sha = disc_acceptance.get("discovery_sha256")
+    if not _is_hex64(expected_disc_sha) or _sha_bytes(disc_jsonl_pinned) != expected_disc_sha:
