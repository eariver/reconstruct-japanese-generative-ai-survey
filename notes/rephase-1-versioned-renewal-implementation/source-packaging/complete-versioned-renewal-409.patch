+        recipe_text = _read_bytes_bounded(repo, ".latexmkrc", "build recipe").decode("utf-8")
+    except RenewalHighError as exc:
+        raise _fail(exc.code, "ENTRY", "REFUSED_PRE_WRITE",
+                    f"recipe unavailable: {exc.detail}") from exc
+    for marker in ("$pdf_mode", "$lualatex", "$biber", "$max_repeat"):
+        if marker not in recipe_text:
+            raise _fail("RECIPE_INCONSISTENT", "ENTRY", "REFUSED_PRE_WRITE",
+                        f"build recipe missing required marker: {marker}")
+    return {"state": state, "state_rel": state_rel, "state_sha": state_sha,
+            "state_bytes": state_bytes, "cfg": cfg, "cfg_rel": _lexical_rel(repo, cfg_rel, "implementation config"),
+            "cfg_sha": _sha_bytes(cfg_bytes), "cfg_bytes": cfg_bytes,
+            "profile": profile, "profile_rel": profile_rel, "profile_sha": _sha_bytes(profile_bytes),
+            "profile_bytes": profile_bytes, "expected_state_rel": expected_state_rel,
+            "source_root": source_root, "selection": selection,
+            "prior_record_ref": {"path": str(record_ref["path"]), "sha256": str(record_ref["sha256"])},
+            "prior_set_ref": {"path": str(set_ref["path"]), "sha256": str(set_ref["sha256"])},
+            "prior_candidate_ref": {"path": str(candidate_ref["path"]),
+                                    "sha256": str(candidate_ref["sha256"])},
+            "prior_history": prior_history, "research_profile": research_profile,
+            "publication_profile": publication_profile, "generator_route": route,
+            "current_commit": current_commit, "current_contract": current_contract}
+
+
+def _recheck_entry_pins(repo: Path, entry: dict[str, Any], phase: str) -> None:
+    if _sha_bytes(_read_bytes_bounded(repo, entry["state_rel"], f"{phase} State pin")) != entry["state_sha"]:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", phase, "REFUSED_PRE_WRITE",
+                    "State bytes moved before write (selected zero-delta pins)")
+    if _sha_bytes(_read_bytes_bounded(repo, entry["cfg_rel"], f"{phase} config pin")) != entry["cfg_sha"]:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", phase, "REFUSED_PRE_WRITE",
+                    "implementation config bytes moved before write "
+                    "(selected zero-delta pins; cfg drift refuses)")
+    if _sha_bytes(_read_bytes_bounded(repo, entry["profile_rel"], f"{phase} Profile pin")) != entry["profile_sha"]:
+        raise _fail("BASIS_ENTRY_INELIGIBLE", phase, "REFUSED_PRE_WRITE",
+                    "Production Profile bytes moved before write "
+                    "(selected zero-delta pins; Profile drift refuses)")
+
+
+def _validate_pinned_instance(repo: Path, obj: Any, obj_rel: str, obj_expected_sha: str,
+                              schema_rel: str, label: str, phase: str,
+                              fail_code: str = "RENEWAL_PROOF_DIGEST") -> None:
+    from scripts import survey_schema_v2 as schema_gate
+    schema_bytes = _read_bytes_bounded(repo, schema_rel, f"{label} schema")
+    _strict_json_from_bytes(schema_bytes, f"{label} schema")
+    try:
+        schema_gate.validate_instance(obj, repo / schema_rel, label=label)
+    except (ValueError, OSError) as exc:
+        raise _fail(fail_code, phase, "REFUSED_PRE_WRITE",
+                    f"{label} schema invalid: {exc}") from exc
+    if _sha_bytes(_read_bytes_bounded(repo, obj_rel, f"{label} recheck")) != obj_expected_sha:
+        raise _fail(fail_code, phase, "REFUSED_PRE_WRITE",
+                    f"{label} bytes moved during schema validation")
+    if _sha_bytes(_read_bytes_bounded(repo, schema_rel, f"{label} schema recheck")) != _sha_bytes(schema_bytes):
+        raise _fail(fail_code, phase, "REFUSED_PRE_WRITE",
+                    f"{label} schema bytes moved during validation")
+
+
+def _file_identity(repo: Path, rel: str, label: str) -> tuple[int, int]:
+    _lexical_rel(repo, rel, label)
+    _walk_existing_ancestors(repo, _lexical_parts(rel, label), label)
+    target = repo.resolve().joinpath(*rel.split("/"))
+    try:
+        st = os.stat(target)
+    except FileNotFoundError as exc:
+        raise _fail("HIGH_MISSING", "ALIAS", "REFUSED_PRE_WRITE",
+                    f"{label} missing for identity: {rel}: {exc}") from exc
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "ALIAS", "REFUSED_PRE_WRITE",
+                    f"{label} identity unreadable: {rel}: {exc}") from exc
+    return (st.st_dev, st.st_ino)
+
+
+def _refuse_alias_unless_exact(repo: Path, supplied_rel: str, expected_rel: str,
+                               supplied_sha: str, expected_sha: str, label: str,
+                               phase: str) -> None:
+    if supplied_rel != expected_rel:
+        try:
+            supplied_id = _file_identity(repo, supplied_rel, f"{label} supplied")
+            expected_id = _file_identity(repo, expected_rel, f"{label} expected")
+        except RenewalHighError:
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"{label} alias path refused before writes "
+                        f"(spelling {supplied_rel!r} != expected {expected_rel!r})")
+        if supplied_id == expected_id or supplied_sha == expected_sha:
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"{label} alias input refused before writes "
+                        f"(spelling differs but same bytes/inode: {supplied_rel!r} vs {expected_rel!r}; "
+                        "NOT ALREADY_ACTIVE by same SHA)")
+        raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                    f"{label} path mismatch before writes: {supplied_rel!r} vs {expected_rel!r}")
+
