+            return authored
+
+        pp, _ = _prepare_proposal_for(self, root, helper, chain, state_path, "fixture-wk-lb-1", _mut)
+        out = retention.capture_retention(root, state_path, pp)
+        manifest_path = root / out["manifest_path"]
+        good_manifest = manifest_path.read_bytes()
+        ppath = root / (pp.relative_to(root) if isinstance(pp, Path) and pp.is_absolute() else pp)
+        good_proposal = ppath.read_bytes()
+        manifest = core.load_json(manifest_path)
+        state_rows = [r for r in manifest["rows"] if "state:authority" in r["roles"]]
+        self.assertEqual(len(state_rows), 1)
+        state_dest_rel = state_rows[0]["retained_dest"]
+        state_row_path = state_rows[0]["path"]
+        state_ref_path = manifest["basis"]["state_ref"]["path"]
+        self.assertEqual(state_row_path, state_ref_path)
+        state_file = root / state_dest_rel
+        orig_state_bytes = state_file.read_bytes()
+
+        def _check_labels(mut_state, pattern: str, label: str) -> None:
+            state_data = json.loads(orig_state_bytes.decode("utf-8"))
+            mut_state(state_data)
+            new_state_bytes = (json.dumps(state_data, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+            new_sha = core.sha256_bytes(new_state_bytes)
+            new_size = len(new_state_bytes)
+            pbad = json.loads(good_proposal.decode("utf-8"))
+            mbad = json.loads(good_manifest.decode("utf-8"))
+            for prow in pbad["retention_plan"]:
+                if "state:authority" in prow["roles"]:
+                    prow["sha256"] = new_sha
+                    prow["byte_count"] = new_size
+            for mrow in mbad["rows"]:
+                if "state:authority" in mrow["roles"]:
+                    mrow["sha256"] = new_sha
+                    mrow["byte_count"] = new_size
+                    mrow["retained_sha256"] = new_sha
+                    mrow["retained_byte_count"] = new_size
+            pbad["basis"]["state_ref"] = {"path": state_ref_path, "sha256": new_sha}
+            mbad["basis"]["state_ref"] = {"path": state_ref_path, "sha256": new_sha}
+            pbytes = core.json_bytes(pbad)
+            mbad["proposal_ref"]["sha256"] = core.sha256_bytes(pbytes)
+            for e in mbad["capture_inputs"]:
+                if e["path"] == state_row_path:
+                    e["sha256"] = new_sha
+            state_file.write_bytes(new_state_bytes)
+            ppath.write_bytes(pbytes)
+            manifest_path.write_bytes(core.json_bytes(mbad))
+            pre = _snapshot(root)
+            try:
+                with self.assertRaisesRegex(RetentionError, pattern):
+                    retention.verify_retention(root, pp, manifest_path)
+            finally:
+                post = _snapshot(root)
+            _assert_no_write(self, pre, post, f"state labels {label} no-write")
+            state_file.write_bytes(orig_state_bytes)
+            ppath.write_bytes(good_proposal)
+            manifest_path.write_bytes(good_manifest)
+            self.assertEqual(retention.verify_retention(root, pp, manifest_path)["result"],
+                             "RETAINED_SET_VERIFIED")
+
+        def _drop_research(state_data):
+            del state_data["research_profile"]
+        _check_labels(_drop_research, "LABEL_MISMATCH", "missing-research")
+
+        def _disagree_publication(state_data):
+            state_data["publication_profile"] = "WRONG-PROFILE"
+        _check_labels(_disagree_publication, "LABEL_MISMATCH", "disagreeing-publication")
