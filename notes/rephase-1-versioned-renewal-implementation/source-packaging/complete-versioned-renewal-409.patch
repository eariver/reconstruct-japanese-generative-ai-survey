+                    "pre-write hypothetical post-State invalid (refused before State mutation): " + "; ".join(_pre_errors))
+    try:
+        _sel_pre = setmod.resolve_publication_selection(repo, cfg, _hypo_state)
+    except Exception as exc:
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    f"pre-write hypothetical post-State selection failed (refused before mutation): {exc}") from exc
+    if _sel_pre.get("mode") != "VERSIONED_ACTIVE":
+        raise _fail("SEAL_BIND", "ACTIVATE", "PRESERVED_INCOMPLETE",
+                    "pre-write hypothetical post-State is not VERSIONED_ACTIVE (refused before mutation)")
+    new_state = dict(state)
+    new_state["publication_revalidation_provenance"] = {"path": record_rel_out,
+                                                        "sha256": _sha_bytes(record_bytes)}
+    new_bytes = core.json_bytes(new_state)
+    _replace_state_bytes(repo, state_rel, expected_old, new_bytes, "activation State")
+    post_bytes = _read_bytes_bounded(repo, state_rel, "activated State")
+    post_state = _strict_json_from_bytes(post_bytes, "activated State")
+    post_errors = agent.validate_agent_state(repo, cfg, post_state)
+    if post_errors:
