+def _refuse_matching_intent_orphan(
+    repo: Path,
+    parent_dir_rel: str,
+    current_set_ref: dict[str, Any],
+    current_basis_ref: dict[str, Any],
+    current_before_ref: dict[str, Any],
+    live_pointer: Any,
+    phase: str = "ACTIVATE",
+) -> None:
+    """Narrow fail-closed matching-intent detection BEFORE record creation.
+
+    ROOT failure/resume disposition (astra-integration-corrections.md appended
+    S, 2026-10-25): ordinary ``activate_renewal`` allocating ``r3`` while a
+    complete ``r2`` for the SAME sealed set/basis is still inert and State is
+    still before is a product defect against the selected explicit-resume
+    contract, not a passing max-advance. Ordinary activation must refuse the
+    existing matching intent before creating another record; changing
+    free-text reason/time or choosing the next global sequence must not bypass
+    this refusal. Explicit ``resume_renewal_activation(record_path)`` still
+    performs complete current revalidation and full 15-field intent equality.
+
+    Same intent is narrow: same immutable set path+SHA AND same renewal basis
+    path+SHA AND same before-State path+SHA for an existing INERT renewal
+    record in the reserved revalidation namespace. Different free-text
+    reason/executor/recorded_at never bypass same-set identity; full 15-field
+    equality still applies to explicit resume matching that record. Do NOT
+    adopt the existing record automatically or infer latest. A truly new R set
+    after another complete inert set may allocate the next unused sequence per
+    contract (no global ban on all unselected records).
+
+    Reserved namespace is scanned with safe FD reads, strict JSON, schema and
+    kind. Malformed/unknown reserved records cannot grant permission;
+    fail-closed preserve/diagnostic when ownership cannot be determined, with
+    no cleanup/deletion/overwrite/force-resume. Partial-record recovery gets
+    no broad new framework/schema/intent file; the diagnostic returns the
+    exact constraint when a root decision is needed. ALREADY_ACTIVE exact-set
+    handling runs before this scan with full readonly validation. Alias
+    inputs refuse per B3 with no same-SHA path rebind. Scan plus the
+    controlled ``O_EXCL`` claim after the scan still refuses TOCTOU races;
+    this is single-writer/held-descriptor bounded, never a global CAS claim.
+    """
+    for label, ref in (("current set", current_set_ref),
+                       ("current basis", current_basis_ref),
+                       ("current before", current_before_ref)):
+        if not isinstance(ref, dict) or not isinstance(ref.get("path"), str) \
+                or not _is_hex64(ref.get("sha256")):
+            raise _fail("ARGS", phase, "REFUSED_PRE_WRITE",
+                        f"matching-intent {label} ref must be exact {{path,sha256}}")
+        _lexical_rel(repo, str(ref["path"]), f"matching-intent {label}")
+    _lexical_rel(repo, parent_dir_rel, "activation record directory")
+    _walk_existing_ancestors(repo, _lexical_parts(parent_dir_rel, "activation record directory"),
+                             "activation record directory")
+    try:
+        dir_abs = repo.resolve().joinpath(*parent_dir_rel.split("/"))
+        names = [p.name for p in dir_abs.iterdir()]
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", phase, "REFUSED_PRE_WRITE",
+                    f"reserved record directory unreadable (preserved, no delete): "
+                    f"{parent_dir_rel}: {exc}") from exc
+    live_path = live_pointer.get("path") if isinstance(live_pointer, dict) else None
+    for name in sorted(names):
+        match = re.fullmatch(r"publication-surface-revalidation-r(\d+)\.json", name)
+        if not match:
+            continue
+        seq = match.group(1)
+        if len(seq) > 1 and seq.startswith("0"):
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record has non-canonical sequence (preserved, no delete/overwrite): "
+                        f"{parent_dir_rel}/{name}; requires root decision, no broad recovery")
+        rel = f"{parent_dir_rel}/{name}"
+        if isinstance(live_path, str) and rel == live_path:
+            continue
+        try:
+            lst = os.lstat(repo.resolve().joinpath(*rel.split("/")))
+        except FileNotFoundError:
+            continue
+        except OSError as exc:
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record lstat failed (preserved, no delete): "
+                        f"{rel}: {exc}") from exc
+        if stat.S_ISLNK(lst.st_mode):
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"reserved record is symlink/foreign (preserved, no unowned delete, "
+                        f"no takeover): {rel}; explicit resume requires exact prior intent, "
+                        f"malformed/foreign never grants permission")
+        if not stat.S_ISREG(lst.st_mode):
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record is not a regular file (preserved, no delete): "
+                        f"{rel}; requires root decision, no broad recovery")
+        if lst.st_nlink != 1:
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"reserved record hardlink sharing refused (preserved, no delete, "
+                        f"NOT ALREADY_ACTIVE by same SHA): {rel} nlink={lst.st_nlink}")
+        try:
+            data = _read_bytes_bounded(repo, rel, "reserved activation record")
+        except RenewalHighError as exc:
+            if getattr(exc, "code", None) == "HIGH_MISSING":
+                continue
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record unreadable (preserved, no delete/overwrite): "
+                        f"{rel}: {exc.code}: {exc.detail}") from exc
+        try:
+            doc = _strict_json_from_bytes(data, "reserved activation record")
+        except RenewalHighError as exc:
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record malformed/partial (preserved, no delete/overwrite/force-resume): "
+                        f"{rel}: {exc.detail}; requires root decision, no broad framework") from exc
+        if not isinstance(doc, dict):
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record malformed (preserved, no delete): "
+                        f"{rel}; requires root decision, no broad recovery")
+        is_renewal = (doc.get("kind") == "VERSIONED_RENEWAL_ACTIVATION_V1"
+                      and doc.get("reason_class") == "REVIEWED_VERSIONED_CORE_RENEWAL")
+        is_editorial = (doc.get("kind") == "EDITORIAL_PUBLICATION_ACTIVATION_V1"
+                        and doc.get("reason_class") == "REVIEWED_EDITORIAL_CORRECTION")
+        is_legacy = (doc.get("reason_class") == "REVIEWED_CORE_CHANGE" and "kind" not in doc)
+        if not is_renewal:
+            if is_editorial or is_legacy:
+                continue
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved record unknown branch (preserved, no delete/overwrite/force-resume): "
+                        f"{rel} kind={doc.get('kind')!r} reason_class={doc.get('reason_class')!r}; "
+                        f"cannot determine ownership, requires root decision")
+        file_sha = _sha_bytes(data)
+        try:
+            _validate_pinned_instance(repo, doc, rel, file_sha,
+                                      "schemas/publication-surface-revalidation.schema.json",
+                                      "Reserved activation record", phase,
+                                      fail_code="RECORD_COLLISION")
+        except RenewalHighError as exc:
+            raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"reserved renewal record schema/partial invalid (preserved, no delete/overwrite): "
+                        f"{rel}: {exc.detail}; requires root decision, no broad recovery") from exc
+        for key in ("set_ref", "renewal_basis_ref", "before_state_ref"):
+            ref = doc.get(key)
+            if not isinstance(ref, dict) or not isinstance(ref.get("path"), str) \
+                    or not _is_hex64(ref.get("sha256")):
+                raise _fail("RECORD_COLLISION", phase, "REFUSED_PRE_WRITE",
+                            f"reserved renewal record lacks exact {key} (preserved, no delete): "
+                            f"{rel}; cannot determine ownership, requires root decision")
+        existing_set = doc.get("set_ref")
+        existing_basis = doc.get("renewal_basis_ref")
+        existing_before = doc.get("before_state_ref")
+        if (existing_set.get("sha256") == current_set_ref.get("sha256")
+                and existing_set.get("path") != current_set_ref.get("path")):
+            raise _fail("RECORD_COLLISION", phase, "PRESERVED_INCOMPLETE",
+                        f"reserved set alias input refused before writes "
+                        f"(spelling {current_set_ref.get('path')!r} != "
+                        f"existing {existing_set.get('path')!r} but same SHA "
+                        f"{existing_set.get('sha256')}; NOT ALREADY_ACTIVE by same SHA; "
+                        f"no same-SHA path rebind, preserved, no delete)")
+        set_exact = (existing_set.get("path") == current_set_ref.get("path")
+                     and existing_set.get("sha256") == current_set_ref.get("sha256"))
+        basis_exact = (existing_basis.get("path") == current_basis_ref.get("path")
+                       and existing_basis.get("sha256") == current_basis_ref.get("sha256"))
+        before_exact = (existing_before.get("path") == current_before_ref.get("path")
+                        and existing_before.get("sha256") == current_before_ref.get("sha256"))
+        if set_exact and basis_exact and before_exact:
+            raise _fail("INTENT_COLLISION", phase, "REFUSED_PRE_WRITE",
+                        f"matching inert renewal intent already exists (preserved, no new record/State change): "
+                        f"{rel} same set {existing_set.get('path')} sha {existing_set.get('sha256')[:12]} "
+                        f"basis {existing_basis.get('path')} before {existing_before.get('path')}; "
+                        f"different reason/executor/time does not bypass same-set identity; "
+                        f"explicit resume_renewal_activation({rel!r}) with full 15-field equality required, "
+                        f"no auto-adopt, no latest inference")
+
+
+def _next_record_rel(repo: Path, prior_record_rel: str) -> str:
+    parent = str(Path(prior_record_rel).parent.as_posix())
+    _lexical_rel(repo, parent, "activation record directory")
+    _walk_existing_ancestors(repo, _lexical_parts(parent, "activation record directory"),
+                             "activation record directory")
+    try:
+        names = [p.name for p in (repo.resolve().joinpath(*parent.split("/"))).iterdir()]
+    except OSError as exc:
+        raise _fail("HIGH_UNREADABLE", "ACTIVATE", "REFUSED_PRE_WRITE",
+                    f"record directory unreadable: {parent}: {exc}") from exc
+    best = 0
+    for name in names:
+        match = re.fullmatch(r"publication-surface-revalidation-r(\d+)\.json", name)
+        if match:
+            best = max(best, int(match.group(1)))
+    return f"{parent}/publication-surface-revalidation-r{best + 1}.json"
+
