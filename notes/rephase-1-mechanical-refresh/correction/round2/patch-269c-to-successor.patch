+    def test_r1_post_rename_readback_failure_no_dangling_pointer(self) -> None:
+        """R1 correction: failure AFTER real os.replace but before helper return.
+
+        The replacement has succeeded, so live State already references the new
+        record when the post-rename readback raises. The handler must classify
+        the actual State disposition (exact known new) rather than trusting the
+        helper return flag, roll State back to original first, and only then
+        delete the now-orphaned record. The State pointer must never dangle at
+        a missing record, and a referenced record must never be deleted.
+        """
+        import os as _os
+
+        temp, fix = self.make_fixture()
+        try:
+            state_path = fix.src / "production-state.json"
+            self.regenerate(fix)
+            state_before = state_path.read_bytes()
+            expected_record = agent._revalidation_record_path(
+                self.root, self.cfg, core.load_json(state_path), 1
+            )
+            real_replace = _os.replace
+            _calls = {"n": 0}
+
+            def failing_replace(src, dst):
+                _calls["n"] += 1
+                if _calls["n"] == 1:
+                    # Fail ONLY the original State replacement (after the real
+                    # rename succeeded); the rollback replacement must use the
+                    # real os.replace so recovery can complete.
+                    real_replace(src, dst)
+                    raise OSError("injected post-rename readback failure")
+                return real_replace(src, dst)
+
+            with mock.patch.object(_os, "replace", side_effect=failing_replace):
+                with self.assertRaises(agent.AgentControlError):
+                    agent.revalidate_publication_surface(
+                        self.root, self.cfg, state_path, "REVIEWED_CORE_CHANGE",
+                        "post-rename failure", EXECUTOR, T0 + timedelta(hours=1), None,
+                    )
+            # State rolled back to original; record removed only after it was
+            # orphaned, so no dangling pointer remains.
+            self.assertEqual(state_path.read_bytes(), state_before)
+            self.assertFalse(expected_record.exists())
+            self.assertIsNone(core.load_json(state_path).get("publication_revalidation_provenance"))
+        finally:
+            temp.cleanup()
+
