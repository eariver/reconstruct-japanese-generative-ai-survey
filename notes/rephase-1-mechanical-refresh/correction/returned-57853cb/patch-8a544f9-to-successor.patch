+    def test_r1_temp_ownership_same_inode_and_swap(self) -> None:
+        """R1 correction: temp helper publishes/removes only own identity+bytes.
+
+        Lightweight fault injection on `_atomic_replace_state_bytes` (tmp-dir
+        only, no fixture): same-inode content change and identical-bytes inode
+        swap are both refused before publish; live stays original; unknown temp
+        bytes are preserved with a precise retained-file error.
+        """
+        import os as _os
+        import tempfile
+
+        with tempfile.TemporaryDirectory(prefix="jgas-r1-reval-tmp-") as tmp:
+            state_path = Path(tmp).resolve() / "production-state.json"
+            original = b'{"lifecycle_state": "VALIDATED_DRAFT"}\n'
+            new = b'{"lifecycle_state": "VALIDATED_DRAFT", "n": 2}\n'
+            state_path.write_bytes(original)
+            tmp_path = state_path.parent / f".{state_path.name}.tmp-reval-{core.sha256_bytes(new)[:16]}"
+            # (a) Same-inode content change between verification and publish.
+            real_read = Path.read_bytes
+            tampered = {"n": 0}
+
+            def tampering_read(self):
+                if self == tmp_path:
+                    tampered["n"] += 1
+                    if tampered["n"] == 2:
+                        tmp_path.write_bytes(b'{"tampered": true}\n')
+                return real_read(self)
+
+            with mock.patch.object(Path, "read_bytes", autospec=True, side_effect=tampering_read):
+                with self.assertRaisesRegex(agent.AgentControlError, "temp bytes changed before replace"):
+                    agent._atomic_replace_state_bytes(state_path, original, new, "unit State")
+            self.assertEqual(state_path.read_bytes(), original)
+            self.assertEqual(tmp_path.read_bytes(), b'{"tampered": true}\n')
+            tmp_path.unlink(missing_ok=True)
+            # (b) Inode swap with identical bytes refused by identity.
+            real_stat = _os.stat
+            swapped = {"done": False}
+
+            def swapping_stat(path, *args, **kwargs):
+                try:
+                    result = real_stat(path, *args, **kwargs)
+                except OSError:
+                    raise
+                if path == tmp_path and not swapped["done"]:
+                    try:
+                        if tmp_path.read_bytes() == new:
+                            swapped["done"] = True
+                            sib = state_path.parent / "sibling-identical.json"
+                            sib.write_bytes(new)
+                            real_replace(sib, tmp_path)
+                            result = real_stat(path, *args, **kwargs)
+                    except OSError:
+                        pass
+                return result
+
+            real_replace = _os.replace
+            with mock.patch.object(_os, "stat", side_effect=swapping_stat):
+                with self.assertRaisesRegex(agent.AgentControlError, "temp identity changed before replace"):
+                    agent._atomic_replace_state_bytes(state_path, original, new, "unit State")
+            self.assertTrue(swapped["done"])
+            self.assertEqual(state_path.read_bytes(), original)
+            self.assertEqual(tmp_path.read_bytes(), new)
+
