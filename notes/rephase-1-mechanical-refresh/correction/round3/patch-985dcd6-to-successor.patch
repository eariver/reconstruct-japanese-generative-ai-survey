+    def test_r1_same_byte_replacement_retained_never_unlinked(self) -> None:
+        """R1 correction: same-byte foreign record (identical content, new inode).
+
+        Ownership is the fd-captured identity plus expected bytes. A replacement
+        with identical bytes introduced before the injected post-write failure
+        must be retained (never unlinked as 'ours'), with State restored and no
+        dangling pointer. No global race-free CAS is claimed; detection plus
+        fail-closed retention is.
+        """
+        import os as _os
+
+        temp, fix = self.make_fixture()
+        try:
+            state_path = fix.src / "production-state.json"
+            self.regenerate(fix)
+            state_before = state_path.read_bytes()
+            expected_record = agent._revalidation_record_path(
+                self.root, self.cfg, core.load_json(state_path), 1
+            )
+            real_validate = agent.validate_agent_state
+            swapped = {"done": False}
+
+            def swapping_validate(repo_root, cfg, state):
+                errors = real_validate(repo_root, cfg, state)
+                if state.get("publication_revalidation_provenance") is not None and not swapped["done"]:
+                    # Post-write check with the new State: swap the just-created
+                    # record inode with byte-identical content, then fail.
+                    swapped["done"] = True
+                    original = expected_record.read_bytes()
+                    sib = expected_record.parent / "sibling-identical.json"
+                    sib.write_bytes(original)
+                    _os.replace(sib, expected_record)
+                    return ["injected post-write failure"]
+                return errors
+
+            with mock.patch.object(agent, "validate_agent_state", side_effect=swapping_validate):
+                with self.assertRaisesRegex(agent.AgentControlError, "identity|foreign evidence|manual recovery"):
+                    agent.revalidate_publication_surface(
+                        self.root, self.cfg, state_path, "REVIEWED_CORE_CHANGE",
+                        "same-byte swap", EXECUTOR, T0 + timedelta(hours=1), None,
+                    )
+            self.assertTrue(swapped["done"])
+            # Foreign same-byte record preserved (not deleted as ours).
+            self.assertTrue(expected_record.is_file())
+            # State restored to original (no dangling pointer at a removed record).
+            self.assertEqual(state_path.read_bytes(), state_before)
+            self.assertIsNone(core.load_json(state_path).get("publication_revalidation_provenance"))
+        finally:
+            temp.cleanup()
+
     def test_r1_state_atomic_temp_replace_no_truncate(self) -> None:
