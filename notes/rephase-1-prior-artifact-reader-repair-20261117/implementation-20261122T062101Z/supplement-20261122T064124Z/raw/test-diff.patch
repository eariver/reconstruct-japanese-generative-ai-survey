+class TestPriorArtifactLateGuardPrepublish(unittest.TestCase):
+    """Actual PREARCH late (post-semantics/prepublish) guard — TEST-ONLY supplement.
+
+    Genuine tiny HIGH adopt +7 outputs; wraps ORIGINAL _validate_stage_semantics
+    then injects owned guard right before return (never replacing with PASS).
+    unittest.mock is non-authority probe only, not a fake validator.
+    """
+
+    def test_prearch_late_guard_refuses_prepublish_no_report(self) -> None:
+        import unittest.mock as mock
+        from scripts import survey_stage_validation_v2 as stage_validation
+        from scripts import survey_research_authority_v2 as low
+        _, chain, state_abs, root, source_root, _ = _adopted_prearch_with_outputs(self, "WEEKLY", "late")
+        cfg = chain["cfg"]
+        state = core.load_json(state_abs)
+        profile = core.load_json(root / state["profile"]["path"])
+        source_root_real = root / profile["paths"]["source_root"]
+        guard = low.guard_path_for(source_root_real)
+        self.assertFalse(guard.exists())
+        state_before = state_abs.read_bytes()
+        matrix_before = (source_root / "candidate-matrix-v2.json").read_bytes()
+        selection_before = (source_root / "candidate-selection-v2.json").read_bytes()
+        orig_semantics = stage_validation._validate_stage_semantics
+
+        def _inject_then_return(*args, **kwargs):
+            ret = orig_semantics(*args, **kwargs)
+            guard.parent.mkdir(parents=True, exist_ok=True)
+            guard.write_text("late-guard", encoding="utf-8")
+            return ret
+
+        out = source_root / "orchestration/v2/stage-validation/EVIDENCE-late-bad.json"
+        with mock.patch.object(stage_validation, "_validate_stage_semantics", side_effect=_inject_then_return):
+            with self.assertRaisesRegex(ValueError, "DM022_TRANSITION_ACTIVE|guard"):
+                stage_validation.validate_stage(root, cfg, state_abs,
+                    {"candidate-matrix": source_root / "candidate-matrix-v2.json",
+                     "candidate-selection": source_root / "candidate-selection-v2.json"},
+                    out, datetime(2026, 10, 28, 3, 0, 0, tzinfo=timezone.utc))
+        self.assertFalse(out.exists())
+        # State/artifacts immediate unchanged except intentional guard.
+        self.assertEqual(state_abs.read_bytes(), state_before)
+        self.assertEqual((source_root / "candidate-matrix-v2.json").read_bytes(), matrix_before)
+        self.assertEqual((source_root / "candidate-selection-v2.json").read_bytes(), selection_before)
+        self.assertTrue(guard.is_file())
+        # Restore own fault; recovery run is separate, not immediate proof of refusal.
+        guard.unlink()
+        self.assertFalse(guard.exists())
+        out2 = source_root / "orchestration/v2/stage-validation/EVIDENCE-late-restore.json"
+        stage_validation.validate_stage(root, cfg, state_abs,
+            {"candidate-matrix": source_root / "candidate-matrix-v2.json",
+             "candidate-selection": source_root / "candidate-selection-v2.json"},
+            out2, datetime(2026, 10, 28, 3, 2, 0, tzinfo=timezone.utc))
+        self.assertTrue(out2.is_file())
+
