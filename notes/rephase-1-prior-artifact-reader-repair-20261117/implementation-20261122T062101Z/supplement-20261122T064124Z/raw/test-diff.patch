+class TestPriorArtifactDirectCollisionPrearchMerge(unittest.TestCase):
+    """Direct _prior_artifacts collision in PREARCH merge — TEST-ONLY supplement.
+
+    Direct helper negative (fault State argument copy only), not a genuine
+    accepted malformed State. Reuses actual LEGACY screening checkpoint as
+    genuine-prior-shaped base, copies record+report to disposable files, adds
+    deliberate contradictory evidence-acceptance row (different path) so LEGACY
+    merges first then PREARCH merge hits disagree. PREARCH record/proof stay
+    valid, role triplet kept, no real/shipping config modified.
+    Old _merge_artifacts temp-file probe remains different coverage.
+    """
+
+    def test_direct_prior_collision_hits_prearch_merge_disagree(self) -> None:
+        from scripts import survey_stage_validation_v2 as stage_validation
+        from scripts import survey_agent_control_v2 as agent
+        _, chain, state_abs, root, source_root, _ = _adopted_prearch_with_outputs(self, "WEEKLY", "collide")
+        cfg = chain["cfg"]
+        state = core.load_json(state_abs)
+        # PREARCH stays valid: triplet + proof pass before fault.
+        ev_ref = dict(state["checkpoint_provenance"]["evidence"])
+        self.assertEqual(agent._validate_checkpoint_record(root, cfg, state, "evidence", ev_ref, revalidation=None, pending_basis=None), [])
+        precord = core.load_json(root / ev_ref["path"])
+        pre_ev = [r for r in precord["artifacts"] if r["name"] == "evidence-acceptance"][0]
+        # Genuine LEGACY base: screening checkpoint + report.
+        scr_ref = dict(state["checkpoint_provenance"]["screening"])
+        scr_abs = root / scr_ref["path"]
+        scr_doc = core.load_json(scr_abs)
+        scr_review = [r for r in scr_doc["reviews"] if r.get("check_id") == "CORE_STAGE_CONTRACT"][0]
+        rep_abs = root / scr_review["result"]["path"]
+        rep_doc = core.load_json(rep_abs)
+        # Contradictory path: screening-acceptance file, different from PREARCH evidence path.
+        other_rel = scr_doc["artifacts"][0]["path"]
+        other_abs = root / other_rel
+        self.assertNotEqual(other_abs.resolve(), (root / pre_ev["path"]).resolve())
+        other_sha = core.sha256_file(other_abs)
+        # Disposable copies inside independent DB (chain root temp DB).
+        disp_rec = root / "sources" / chain["issue_id"] / "disposable-screening-collision.json"
+        disp_rep = root / "sources" / chain["issue_id"] / "disposable-screening-collision-report.json"
+        new_rec = copy.deepcopy(scr_doc)
+        new_rep = copy.deepcopy(rep_doc)
+        extra = {"name": "evidence-acceptance", "path": other_rel, "sha256": other_sha}
+        new_rec["artifacts"] = list(new_rec["artifacts"]) + [extra]
+        new_rep["artifacts"] = list(new_rep["artifacts"]) + [extra]
+        _write(disp_rep, new_rep)
+        new_rec["reviews"] = [dict(scr_review, result={"path": str(disp_rep.relative_to(root)), "sha256": _sha_file(disp_rep)})]
+        _write(disp_rec, new_rec)
+        new_sha = _sha_file(disp_rec)
+        bad_state = copy.deepcopy(state)
+        bad_state["checkpoint_provenance"]["screening"] = {"path": str(disp_rec.relative_to(root)), "sha256": new_sha}
+        # LEGACY disposable part itself validates (so failure is merge, not early schema).
+        self.assertEqual(agent._validate_checkpoint_record(root, cfg, bad_state, "screening", bad_state["checkpoint_provenance"]["screening"], revalidation=None, pending_basis=None), [])
+        # PREARCH evidence still validates alone.
+        self.assertEqual(agent._validate_checkpoint_record(root, cfg, bad_state, "evidence", ev_ref, revalidation=None, pending_basis=None), [])
+        # Direct helper must hit PREARCH merge disagree, not early failure.
+        with self.assertRaisesRegex(ValueError, "prior Stage Checkpoints disagree on artifact name: evidence-acceptance"):
+            stage_validation._prior_artifacts(root, cfg, bad_state)
+
