#!/usr/bin/env python3
"""DRAFT proof v3 (E2) — NOT EXECUTED. Root reviews BEFORE any execution.

Hardened vs v2 (which inspected filenames only, compared same-name pairs,
used substring remote predicates and row-presence status checks, and let
`fail` overwrite outputs):
- All-entry lstat walk of BOTH `.git` trees: regular files AND directories
  recorded with (dev, ino, nlink); symlinks (file or dir) and any
  lstat/walk error FAIL the proof (listed, never skipped).
- Inode-SET intersection: the full (dev, ino) pair sets of active vs copy
  must be disjoint (no same-name-pair shortcut).
- Exact saved full16 pins (sha256+mode+bytes vs active) and full exact
  applied status: the status line set must equal exactly the 16 expected
  rows, except explicitly recorded leftover cache rows (none expected when
  `.gitignore` covers pycache; any other extra fails).
- Every Git invocation uses checked rc; identity/index observations included.
- Effective config/remote observations recorded whole; remote lines must
  EXACTLY equal the expected inert pair (no substring predicate); every
  `remote.*.url` config value must equal the exact inert URL.
- Safe output-exists behavior: if ANY output exists, refuse on console
  only (return 40) without creating or writing anything. Otherwise all
  outputs are `x`/`xb`-created (reserved) before use.
- Only declared overlay removals in the disposable COPY (16 paths +
  scripts/tests `__pycache__` dirs, with pre-removal cache inventory
  recorded); removals are separated from run no-write claims. No active
  add-N, no old-script rerun, no commits/branches/network.
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import stat as _stat
import subprocess
import sys
from pathlib import Path

ACTIVE = Path("/tmp/opencode/jgas-dm021p2r-impl-20261013T123807Z/candidate-partial-b40de60").resolve()
COPYROOT = Path("/tmp/opencode/jgas-dm021p2r-verify-20261014T000001Z")
COPYREPO = COPYROOT / "candidate-partial-b40de60"
EVID = Path(__file__).resolve().parent
PATCH = EVID / "complete-p2r-16path-v3.patch"
OUT_STDOUT = EVID / "proof_apply16_v3.stdout.txt"
OUT_STDERR = EVID / "proof_apply16_v3.stderr.txt"
OUT_EXIT = EVID / "proof_apply16_v3.exit"
OUT_CLEAN = EVID / "proof-freeze-clean-v3.json"
OUT_APPLIED = EVID / "proof-freeze-applied-v3.json"
SAFE_DIRECTORY = str(ACTIVE)  # exact path only; never a wildcard.

EXPECTED_INERT_URL = "https://example.invalid/rephase-candidate-recovery.git"
EXPECTED_REMOTE_LINES = {
    f"origin\t{EXPECTED_INERT_URL} (fetch)",
    f"origin\t{EXPECTED_INERT_URL} (push)",
}
MODIFIED = [
    "schemas/reader-surface-gate-v2.schema.json",
    "schemas/reader-surface-semantic-review-v2.schema.json",
    "scripts/survey_reader_surface_gate_v2.py",
]
NEW = [
    "schemas/editorial-correction-proposal-v2.schema.json",
    "schemas/editorial-retention-manifest-v2.schema.json",
    "schemas/longform-publication-source-manifest-v2.schema.json",
    "schemas/longform-reader-input-v2.schema.json",
    "scripts/survey_editorial_correction_proposal_v2.py",
    "scripts/survey_editorial_retention_v2.py",
    "scripts/survey_longform_derivation_v2.py",
    "scripts/survey_longform_generated_v2.py",
    "scripts/survey_longform_semantic_publication_v2.py",
    "tests/test_survey_editorial_correction_proposal_v2.py",
    "tests/test_survey_editorial_retention_v2.py",
    "tests/test_survey_longform_derivation_v2.py",
    "tests/test_survey_longform_publication_integration_v2.py",
]
EXPECTED_STATUS_ROWS = {f" M {m}" for m in MODIFIED} | {f"?? {n}" for n in NEW}

LOG: list[str] = []


def log(msg: str) -> None:
    LOG.append(msg)
    print(msg)


def git(repo: Path, *args: str) -> subprocess.CompletedProcess:
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update({"GIT_NO_LAZY_FETCH": "1", "GIT_OPTIONAL_LOCKS": "0", "GIT_ALLOW_PROTOCOL": "file"})
    return subprocess.run(["git", "-c", f"safe.directory={SAFE_DIRECTORY}", *args],
                          cwd=repo, capture_output=True, text=True, env=env)


def git_checked(repo: Path, *args: str) -> str:
    r = git(repo, *args)
    if r.returncode != 0:
        raise RuntimeError(f"git {list(args)} rc={r.returncode}: {r.stderr.strip()[:500]}")
    return r.stdout


def git_entries_all(repo: Path) -> tuple[dict[str, tuple[int, int, int]], dict[str, tuple[int, int]], list[str]]:
    """All-entry lstat walk of repo/.git.

    Returns (regular_files rel -> (dev, ino, nlink),
             dirs rel -> (dev, ino), problems). Symlinks (file or dir),
    non-regular/non-dir entries and ANY lstat/walk error are problems
    (proof refusal), never silently skipped.
    """
    gitdir = repo / ".git"
    regular: dict[str, tuple[int, int, int]] = {}
    dirs: dict[str, tuple[int, int]] = {}
    problems: list[str] = []
    try:
        top = os.lstat(gitdir)
    except OSError as exc:
        raise RuntimeError(f".git top lstat failed: {exc}")
    if not _stat.S_ISDIR(top.st_mode) or _stat.S_ISLNK(top.st_mode):
        raise RuntimeError(".git top is not a real directory")
    dirs["."] = (top.st_dev, top.st_ino)
    stack = [gitdir]
    while stack:
        cur = stack.pop()
        try:
            with os.scandir(cur) as it:
                entries = sorted(it, key=lambda e: e.name)
        except OSError as exc:
            problems.append(f"scandir failed: {cur}: {exc}")
            continue
        for entry in entries:
            try:
                rel = entry.path
                rel = str(Path(rel).relative_to(gitdir).as_posix())
            except ValueError:
                problems.append(f"escapes-gitdir: {entry.path}")
                continue
            try:
                st = os.lstat(entry.path)
            except OSError as exc:
                problems.append(f"unreadable: {rel}: {exc}")
                continue
            if _stat.S_ISLNK(st.st_mode):
                problems.append(f"symlink: {rel}")
            elif _stat.S_ISDIR(st.st_mode):
                dirs[rel] = (st.st_dev, st.st_ino)
                stack.append(Path(entry.path))
            elif _stat.S_ISREG(st.st_mode):
                regular[rel] = (st.st_dev, st.st_ino, st.st_nlink)
            else:
                problems.append(f"non-regular non-dir: {rel}")
    return regular, dirs, problems


def check_remote_config(repo: Path, label: str) -> tuple[str, str]:
    remote = git_checked(repo, "remote", "-v")
    cfg = git_checked(repo, "config", "--list", "--show-origin")
    remote_lines = set(remote.splitlines())
    if remote_lines != EXPECTED_REMOTE_LINES:
        raise RuntimeError(f"{label} remote lines != exact inert pair: {sorted(remote_lines)}")
    urls = [line.split("=", 1)[1] for line in cfg.splitlines() if ".url=" in line and line.split("=", 1)[0].endswith("url")]
    if not urls:
        raise RuntimeError(f"{label} config has no remote url entries")
    for u in urls:
        if u != EXPECTED_INERT_URL:
            raise RuntimeError(f"{label} config remote url not exact inert: {u!r}")
    alternates = repo / ".git" / "objects" / "info" / "alternates"
    try:
        alt_exists = os.lstat(alternates) is not None
    except FileNotFoundError:
        alt_exists = False
    except OSError as exc:
        raise RuntimeError(f"{label} alternates check unreadable: {exc}")
    if alt_exists:
        raise RuntimeError(f"{label} has alternates")
    return remote, cfg


def freeze(repo: Path) -> dict:
    out: dict = {}
    out["head"] = git_checked(repo, "rev-parse", "HEAD").strip()
    out["tree"] = git_checked(repo, "rev-parse", "HEAD^{tree}").strip()
    out["status"] = git_checked(repo, "status", "--porcelain=v1", "-uall")
    out["index"] = git_checked(repo, "diff", "--cached", "--name-only")
    files: dict = {}
    for rel in MODIFIED + NEW:
        p = repo / rel
        files[rel] = {"sha256": hashlib.sha256(p.read_bytes()).hexdigest(),
                      "mode": oct(p.stat().st_mode & 0o777), "bytes": p.stat().st_size}
    out["files"] = files
    return out


def main() -> int:
    # Safe output-exists behavior: refuse on console only, write nothing.
    for name in (OUT_STDOUT.name, OUT_STDERR.name, OUT_EXIT.name,
                 OUT_CLEAN.name, OUT_APPLIED.name):
        if (EVID / name).exists():
            print(f"PROOF_REFUSAL: proof output exists: {name}")
            return 40
    if not PATCH.is_file():
        print("PROOF_REFUSAL: saved v3 patch missing (generate after final pins, do not execute this draft)")
        return 40
    if COPYROOT.exists():
        print(f"PROOF_REFUSAL: copy destination exists: {COPYROOT}")
        return 40
    # Reserve all outputs exclusively before use.
    with open(OUT_STDOUT, "xb") as _f:
        pass
    with open(OUT_STDERR, "xb") as _f:
        pass
    with open(OUT_EXIT, "xb") as _f:
        pass
    with open(OUT_CLEAN, "x") as _f:
        pass
    with open(OUT_APPLIED, "x") as _f:
        pass

    def fail(msg: str) -> int:
        log(f"PROOF_REFUSAL: {msg}")
        with open(OUT_STDOUT, "wb") as f:
            f.write(("\n".join(LOG) + "\n").encode("utf-8"))
        with open(OUT_STDERR, "wb") as f:
            f.write(b"")
        with open(OUT_EXIT, "wb") as f:
            f.write(b"40\n")
        return 40

    try:
        patch_sha = hashlib.sha256(PATCH.read_bytes()).hexdigest()
        log(f"saved v3 patch sha256={patch_sha} bytes={PATCH.stat().st_size}")
        COPYROOT.mkdir(parents=True)
        proc = subprocess.run(["cp", "-a", "--reflink=never", str(ACTIVE), str(COPYREPO)],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            return fail(f"byte-copy failed: {proc.stderr[:1000]}")
        # All-entry separation: full inode-set intersection must be empty.
        a_reg, a_dirs, a_prob = git_entries_all(ACTIVE)
        c_reg, c_dirs, c_prob = git_entries_all(COPYREPO)
        log(f"active .git regular={len(a_reg)} dirs={len(a_dirs)} problems={a_prob}")
        log(f"copy .git regular={len(c_reg)} dirs={len(c_dirs)} problems={c_prob}")
        if a_prob:
            return fail(f"active .git problems: {a_prob[:10]}")
        if c_prob:
            return fail(f"copy .git problems: {c_prob[:10]}")
        a_pairs = {(d, i) for (d, i, _n) in a_reg.values()} | set(a_dirs.values())
        c_pairs = {(d, i) for (d, i, _n) in c_reg.values()} | set(c_dirs.values())
        shared = a_pairs & c_pairs
        if shared:
            return fail(f"copy shares .git (dev,ino) pairs with active: {sorted(shared)[:10]}")
        for repo, label in ((ACTIVE, "active"), (COPYREPO, "copy")):
            remote, cfg = check_remote_config(repo, label)
            log(f"{label} remote -v:\n{remote.strip()}")
        caches_before = sorted(
            str(p.relative_to(COPYREPO).as_posix())
            for base in ("scripts", "tests", "schemas")
            for p in list((COPYREPO / base).glob("__pycache__/*")) + list((COPYREPO / base).glob("*.pyc")))
        log(f"copy caches before declared removal ({len(caches_before)}): {caches_before[:5]}...")
        r = git(COPYREPO, "checkout", "HEAD", "--", *MODIFIED)
        if r.returncode != 0:
            return fail(f"copy checkout failed: {r.stderr[:1000]}")
        for n in NEW:
            try:
                (COPYREPO / n).unlink()
            except FileNotFoundError:
                return fail(f"copy new file already absent: {n}")
        for cache in (COPYREPO / "scripts" / "__pycache__", COPYREPO / "tests" / "__pycache__"):
            shutil.rmtree(cache, ignore_errors=True)
        head = git_checked(COPYREPO, "rev-parse", "HEAD").strip()
        tree = git_checked(COPYREPO, "rev-parse", "HEAD^{tree}").strip()
        status = git_checked(COPYREPO, "status", "--porcelain=v1", "-uall")
        if head != "409b292756dd1277b9dfae87679934c0d2ce251c" or status != "":
            return fail(f"copy not clean409: head={head} status={status[:500]!r}")
        with open(OUT_CLEAN, "w") as f:
            json.dump({"head": head, "tree": tree, "status": status,
                       "caches_removed": caches_before}, f, indent=2)
            f.write("\n")
        log("copy is clean409; applying EXACT saved v3 patch")
        r = git(COPYREPO, "apply", "--check", str(PATCH))
        if r.returncode != 0:
            return fail(f"apply --check failed: {r.stderr[:2000]}")
        r = git(COPYREPO, "apply", str(PATCH))
        if r.returncode != 0:
            return fail(f"apply failed: {r.stderr[:2000]}")
        applied = freeze(COPYREPO)
        with open(OUT_APPLIED, "w") as f:
            json.dump(applied, f, indent=2)
            f.write("\n")
        if applied["head"] != "409b292756dd1277b9dfae87679934c0d2ce251c":
            return fail("applied HEAD moved (must stay detached 409, uncommitted)")
        if applied["index"].strip() != "":
            return fail(f"applied index non-empty: {applied['index'][:200]!r}")
        for rel in MODIFIED + NEW:
            a_data = (ACTIVE / rel).read_bytes()
            c_data = (COPYREPO / rel).read_bytes()
            if a_data != c_data:
                return fail(f"byte mismatch after apply: {rel}")
            if oct((ACTIVE / rel).stat().st_mode & 0o777) != oct((COPYREPO / rel).stat().st_mode & 0o777):
                return fail(f"mode mismatch after apply: {rel}")
        status_rows = set(applied["status"].splitlines())
        if status_rows != EXPECTED_STATUS_ROWS:
            return fail(f"applied status != exact expected16 rows: "
                        f"missing={sorted(EXPECTED_STATUS_ROWS - status_rows)} "
                        f"extra={sorted(status_rows - EXPECTED_STATUS_ROWS)}")
        log(f"APPLY_PROOF_OK head={applied['head']} files=16 patch={patch_sha[:12]}")
        with open(OUT_STDOUT, "wb") as f:
            f.write(("\n".join(LOG) + "\n").encode("utf-8"))
        with open(OUT_STDERR, "wb") as f:
            f.write(b"")
        with open(OUT_EXIT, "wb") as f:
            f.write(b"0\n")
        return 0
    except RuntimeError as exc:
        return fail(str(exc))


if __name__ == "__main__":
    sys.exit(main())
