{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/longform-reader-input-v2.schema.json",
  "title": "Survey Production Core v2 Longform Generated Reader Input (THEMATIC four-family lineage v1)",
  "description": "Reader content only. No provenance, tool hashes, runner, review-reference free text, recorded-at, receipt or audit fields. Mechanical context travels in a separate in-memory return value and must never be written into this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "format", "issue_id", "research_profile", "publication_profile", "issue_metadata", "visible_text", "cover", "frontmatter", "packages", "cross_family_synthesis", "final_summary", "bibliography"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "route": {"const": "LONGFORM_GENERATED_V1"},
    "format": {"const": "THEMATIC_FOUR_FAMILY_LINEAGE_V1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"const": "THEMATIC"},
    "publication_profile": {"const": "LONGFORM_SPECIAL"},
    "issue_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "display_as_of"],
      "properties": {
        "title": {"const": "Japanese Generative AI Technical Survey Special"},
        "display_as_of": {"type": "string", "minLength": 1}
      }
    },
    "visible_text": {
      "type": "object", "additionalProperties": false,
      "required": ["frontmatter_boundary", "claim_boundary", "theme_overview_title", "timeline_heading", "technical_notes_heading", "note_chronology_label", "note_points_label", "note_limitation_label", "note_url_label", "cross_family_kicker", "cross_comparison_title", "cross_table_header", "issue_summary_kicker", "references_title", "edition_descriptor", "toc_title", "cover_cutoff_label", "cover_repository_label", "cover_build_label", "repository_value", "build_value", "strapline", "date_history_prefix", "date_boundary_prefix"],
      "properties": {
        "frontmatter_boundary": {"const": "Scope / attribution boundary"},
        "claim_boundary": {"const": "Claim boundary"},
        "theme_overview_title": {"const": "Theme at a glance"},
        "timeline_heading": {"const": "Transition timeline"},
        "technical_notes_heading": {"const": "Source-backed Technical Notes"},
        "note_chronology_label": {"const": "Chronology:"},
        "note_points_label": {"const": "Technical points:"},
        "note_limitation_label": {"const": "Limitation / attribution:"},
        "note_url_label": {"const": "Primary URL:"},
        "cross_family_kicker": {"const": "CROSS-FAMILY SYNTHESIS"},
        "cross_comparison_title": {"const": "Cross-family comparison"},
        "cross_table_header": {"const": ["観点", "GLM", "Qwen", "DeepSeek", "Kimi"]},
        "issue_summary_kicker": {"const": "ISSUE SYNTHESIS"},
        "references_title": {"const": "References / Source Notes"},
        "edition_descriptor": {"const": "Thematic Longform Special"},
        "toc_title": {"const": "目次"},
        "cover_cutoff_label": {"const": "Editorial cutoff"},
        "cover_repository_label": {"const": "Repository"},
        "cover_build_label": {"const": "Build"},
        "repository_value": {"const": "eariver/japanese-generative-ai-survey"},
        "build_value": {"const": "LuaLaTeX / jlreq / LuaTeX-ja"},
        "strapline": {"const": "一次情報・論文・OSS・X上の技術反応を分離し、検証可能なEvidence chainとして編成する"},
        "date_history_prefix": {"const": "Thematic history / as of "},
        "date_boundary_prefix": {"const": "As-of boundary: "}
      }
    },
    "cover": {"$ref": "#/$defs/cover"},
    "frontmatter": {"$ref": "#/$defs/frontmatter"},
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package_id", "drafting_order", "headline", "deck", "deck_discovery_ids", "kicker", "theme_at_a_glance", "narrative_sections", "timeline", "synthesis", "reader_claim_boundary", "technical_notes"],
        "properties": {
          "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "drafting_order": {"type": "integer", "minimum": 1},
          "headline": {"type": "string", "minLength": 1},
          "deck": {"type": "string", "minLength": 1},
          "deck_discovery_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_id"}},
          "kicker": {"type": "string", "minLength": 1},
          "theme_at_a_glance": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["label", "text", "discovery_ids"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "discovery_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_id"}}
              }
            }
          },
          "narrative_sections": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["heading", "paragraphs"],
              "properties": {
                "heading": {"type": "string", "minLength": 1},
                "paragraphs": {"$ref": "#/$defs/paragraph_rows"}
              }
            }
          },
          "timeline": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["label", "text", "discovery_ids"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "discovery_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_id"}}
              }
            }
          },
          "synthesis": {
            "type": "object", "additionalProperties": false,
            "required": ["heading", "paragraphs"],
            "properties": {
              "heading": {"type": "string", "minLength": 1},
              "paragraphs": {"$ref": "#/$defs/paragraph_rows"}
            }
          },
          "reader_claim_boundary": {"$ref": "#/$defs/paragraph_rows"},
          "technical_notes": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "discovery_id", "chronology", "technical_points", "limitation", "primary_url"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "discovery_id": {"$ref": "#/$defs/discovery_id"},
                "chronology": {"type": "string", "minLength": 1},
                "technical_points": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
                "limitation": {"type": "string", "minLength": 1},
                "primary_url": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "cross_family_synthesis": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "paragraphs", "comparison_rows"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "paragraphs": {"$ref": "#/$defs/paragraph_rows"},
        "comparison_rows": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dimension", "glm", "qwen", "deepseek", "kimi", "discovery_ids"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "glm": {"type": "string", "minLength": 1},
              "qwen": {"type": "string", "minLength": 1},
              "deepseek": {"type": "string", "minLength": 1},
              "kimi": {"type": "string", "minLength": 1},
              "discovery_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_id"}}
            }
          }
        }
      }
    },
    "final_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "paragraphs", "placement"],
      "properties": {
        "heading": {"const": "この号の総括"},
        "paragraphs": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "placement": {"const": "END_OF_PUBLICATION_BEFORE_REFERENCES_OR_END_MATTER"}
      }
    },
    "bibliography": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bibliography"}}
  },
  "$defs": {
    "discovery_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+-D[0-9]{3,}$"},
    "citation_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:._-]*$"},
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "deck", "anchors"],
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "deck": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "frontmatter": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "lede", "scope_notes"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "lede": {"type": "string", "minLength": 1},
        "scope_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "paragraph_rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "discovery_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "discovery_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_id"}}
        }
      }
    },
    "bibliography": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery_id", "key", "title", "author", "url", "urldate"],
      "properties": {
        "discovery_id": {"$ref": "#/$defs/discovery_id"},
        "key": {"$ref": "#/$defs/citation_key"},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "urldate": {"type": "string", "format": "date"}
      }
    }
  }
}
