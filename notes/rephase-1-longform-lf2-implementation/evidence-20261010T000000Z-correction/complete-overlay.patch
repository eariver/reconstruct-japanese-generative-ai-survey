+def _snapshot(root: Path) -> dict:
+    files: dict[str, str] = {}
+    dirs: list[str] = []
+    symlinks: dict[str, str] = {}
+    for path in sorted(root.rglob("*")):
+        if ".git" in path.parts:
+            continue
+        rel = str(path.relative_to(root))
+        if path.is_symlink():
+            try:
