+
+def _rel(root: Path, path: Path) -> str:
+    return str(path.resolve().relative_to(root.resolve())).replace("\\", "/")
+
+
+def _lexical_join(root: Path, raw: str | Path) -> Path:
+    # Raw lexical join without resolving: preserves alias information until
+    # explicit leaf/ancestor checks complete. Absolute inputs are rejected by
+    # callers via containment (all LF-2I paths are repo-relative or root-joined).
+    path = Path(raw)
+    if path.is_absolute():
+        return path
+    return root / path
+
+
+def _check_ancestors_no_symlink(root_resolved: Path, lexical: Path, label: str, raw: object) -> None:
+    # Ancestor check on lexical components via lstat (is_symlink does not
+    # follow the final component; ancestors are checked component by
+    # component so a symlinked parent is refused before any resolve).
+    try:
+        rel_parent = lexical.parent.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    current = root_resolved
+    for part in rel_parent.parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+        current = current / part
+        # lstat-style check: do not follow; a symlinked ancestor refuses.
+        if current.is_symlink():
+            raise ValueError(f"{label} has symlinked ancestor component: {current}")
+
+
+def _safe(root: Path, raw: str | Path, label: str) -> Path:
+    # Strict raw-first containment: leaf alias (including dangling) is refused
+    # before any resolve, then ancestors, then resolved containment. The raw
+    # lexical path is retained until both checks complete.
+    import os as _os
+
+    root_resolved = root.resolve()
+    lexical = _lexical_join(root_resolved, raw) if not Path(raw).is_absolute() else Path(raw)
+    # Absolute raw paths must still be contained; refuse traversal components.
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    for part in lexical.relative_to(root_resolved).parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+    _check_ancestors_no_symlink(root_resolved, lexical, label, raw)
+    # Leaf alias check BEFORE resolve: explicit review/state/input/surface file
+    # aliases (including dangling destinations) refuse here with no writes.
+    if _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    resolved = lexical.resolve()
+    try:
+        resolved.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"{label} escapes repository: {raw}") from exc
+    if resolved.is_symlink() or not resolved.is_file():
+        raise ValueError(f"{label} missing or unsafe: {raw}")
+    return resolved
+
+
+def _strict_dir_preflight(root: Path, raw: str | Path, label: str) -> Path:
+    # Directory preflight BEFORE any mkdir/write: refuses leaf aliases
+    # (including dangling), symlinked ancestors, traversal and escapes. Returns
+    # the lexical directory path (not resolved) so mkdir operates on the
+    # validated lexical location.
+    import os as _os
+
+    root_resolved = root.resolve()
+    lexical = _lexical_join(root_resolved, raw) if not Path(raw).is_absolute() else Path(raw)
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError:
+        raise ValueError(f"{label} escapes repository: {raw}")
+    for part in lexical.relative_to(root_resolved).parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"{label} has unsafe path component: {part}")
+    # Ancestors of the directory itself (parent chain).
+    _check_ancestors_no_symlink(root_resolved, lexical, label, raw)
+    if _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    resolved = lexical.resolve()
+    try:
+        resolved.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"{label} escapes repository: {raw}") from exc
+    if resolved != lexical and _os.path.islink(lexical):
+        raise ValueError(f"{label} leaf alias is unsafe: {raw}")
+    return lexical
+
+
+def _artifact(root: Path, name: str, path: Path) -> dict[str, str]:
+    safe = _safe(root, path, name)
+    return {"name": name, "path": _rel(root, safe), "sha256": core.sha256_file(safe)}
+
+
+def validate_survey_build_directory(root: Path, raw_survey_root: str) -> Path:
+    """Admit only declared local inputs and known non-input Longform outputs."""
+    import os as _os
+
+    raw = Path(raw_survey_root)
+    try:
+        resolved = core.repo_local_path(root, raw_survey_root, "Longform survey build directory")
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"Longform survey build directory path invalid: {exc}") from exc
+    root_resolved = root.resolve()
+    lexical = root_resolved / raw
+    # Raw-first leaf/ancestor alias refusal before any existence/resolve branch.
+    try:
+        lexical.relative_to(root_resolved)
+    except ValueError as exc:
+        raise ValueError(f"Longform survey build directory escapes repository: {raw}") from exc
+    for part in raw.parts:
+        if part in ("..", ".", ""):
+            raise ValueError(f"Longform survey build directory has unsafe path component: {part}")
+    current = root_resolved
+    for component in raw.parts:
+        current = current / component
+        if current.is_symlink():
+            raise ValueError(f"Longform survey build directory has symlinked component: {current}")
+    if _os.path.islink(lexical):
+        raise ValueError(f"Longform survey build directory leaf alias is unsafe: {raw}")
+    if lexical != resolved:
+        raise ValueError("Longform survey build directory is not at its physical canonical path")
+    if not _os.path.lexists(lexical):
+        return lexical
+    if not lexical.is_dir() or _os.path.islink(lexical):
+        raise ValueError("Longform survey build directory is not a directory")
+    allowed = LONGFORM_BUILD_INPUTS | LONGFORM_BUILD_OUTPUTS
+    for entry in lexical.iterdir():
+        if entry.is_symlink() or not entry.is_file() or entry.name not in allowed:
+            raise ValueError(f"Longform survey build directory contains undeclared entry: {entry.name}")
+    return lexical
