+def _cite(ids: list[str], bib_key_by_did: dict[str, str]) -> str:
+    keys = []
+    for did in ids:
+        key = bib_key_by_did.get(did)
+        if key is None:
+            raise ValueError(f"citation Discovery ID has no reviewed bibliography key: {did}")
+        keys.append(key)
+    return "" if not keys else " \\cite{" + ",".join(keys) + "}"
+
+
+# Finite serializer syntax: headings that become \section{}/\subsection*{}
+# titles must round-trip through the existing fidelity parser
+# (_HEADING requires [^{}]+, i.e. no braces). tex_escape maps { } \ ~ ^ to
+# sequences containing braces (\{ \} \textbackslash{} \textasciitilde{}
+# \textasciicircum{}), which the parser cannot resolve. Those raw characters
+# therefore refuse BEFORE any write. Optional [...] titles (claimboundary,
+# themeoverview, technicalnote) additionally refuse ']' (and newlines), since
+# plain tex_escape is not an optional-argument policy. No universal parser is
+# introduced and fidelity is not weakened.
+_HEADING_UNSAFE = set("{}~^\\")
+_OPTIONAL_ARG_UNSAFE = set("[]\n\r")
+
+
+def _check_heading(label: str, value: Any) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{label} must be a non-empty string")
+    for char in value:
+        if char in _HEADING_UNSAFE:
+            raise ValueError(
+                f"{label} carries an unsupported TeX heading character {char!r}: "
+                "headings with braces/backslash/tilde/circumflex cannot be traced "
+                "by the existing fidelity parser; refusing before writes"
+            )
+        if ord(char) < 32 or ord(char) == 127:
+            raise ValueError(f"{label} carries an unsupported control character")
+    return value
+
+
+def _check_optional_arg(label: str, value: Any) -> str:
+    _check_heading(label, value)
+    for char in str(value):
+        if char in _OPTIONAL_ARG_UNSAFE:
+            raise ValueError(
+                f"{label} carries an unsupported optional-argument delimiter {char!r}; "
+                "refusing before writes"
+            )
+    return str(value)
+
+
+def validate_heading_syntax(surface: dict[str, Any]) -> None:
+    """Finite pre-write heading/delimiter safety over the reviewed surface."""
+    try:
+        visible = surface["visible_text"]
+        front = surface["frontmatter"]
+        cross = surface["cross_family_synthesis"]
+        summary = surface["final_summary"]
+    except (KeyError, TypeError) as exc:
+        raise ValueError(f"reviewed Longform reader object envelope invalid: {exc}") from exc
+    # Trusted visible constants that still enter TeX optional args / headings.
+    for key in ("frontmatter_boundary", "claim_boundary", "theme_overview_title",
+                "timeline_heading", "technical_notes_heading", "cross_comparison_title",
+                "cross_family_kicker", "toc_title"):
+        if key in ("frontmatter_boundary", "claim_boundary", "theme_overview_title",
+                   "cross_comparison_title"):
+            _check_optional_arg(f"visible_text.{key}", visible.get(key, ""))
+        elif key in visible:
+            _check_heading(f"visible_text.{key}", visible[key])
+    _check_heading("frontmatter.heading", front.get("heading", ""))
+    for package in surface.get("packages", []):
+        pid = package.get("package_id", "?")
+        # Canonical safe package/comment token validated before unescaped emission.
+        import re as _re
+
+        if not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", str(package.get("package_id", ""))):
+            raise ValueError(f"unsupported Longform package token for comment emission: {pid!r}")
+        _check_heading(f"{pid}.headline", package.get("headline", ""))
+        _check_heading(f"{pid}.kicker", package.get("kicker", ""))
+        for pos, section in enumerate(package.get("narrative_sections", [])):
+            _check_heading(f"{pid}.narrative_sections[{pos}].heading", section.get("heading", ""))
+        _check_heading(f"{pid}.synthesis.heading", package.get("synthesis", {}).get("heading", ""))
+        for pos, note in enumerate(package.get("technical_notes", [])):
+            _check_optional_arg(f"{pid}.technical_notes[{pos}].title", note.get("title", ""))
+    _check_heading("cross_family_synthesis.heading", cross.get("heading", ""))
+    _check_heading("final_summary.heading", summary.get("heading", ""))
+
