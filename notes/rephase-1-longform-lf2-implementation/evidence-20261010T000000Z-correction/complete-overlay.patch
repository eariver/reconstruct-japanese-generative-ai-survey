+    git: dict[str, str] = {}
+    for args, key in (
+        (["git", "rev-parse", "HEAD"], "head"),
+        (["git", "status", "--porcelain=v1", "--untracked-files=all"], "status"),
+        (["git", "diff", "--name-only", "HEAD"], "diff"),
+    ):
+        proc = subprocess.run(args, cwd=root, capture_output=True, text=True)
+        git[key] = proc.stdout
+        git[key + ":exit"] = str(proc.returncode)
