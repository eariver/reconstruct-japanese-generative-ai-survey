+def _check_completion_slots_fresh(repo_root: Path, source_root: Path, checkpoint_ref: dict[str, str]) -> None:
+    """Lightweight seven-plan/inventory/expected_after recompute (no full AG).
+
+    Preserves historical completion semantics via shared extraction: retention
+    inventory 7 rows exactly bound to manifest snapshots, expected_after
+    recomputed from retained COPY, seven_plan vs inventory vs lstat with
+    legitimate-regeneration tolerance (old-absent/new-content/same-byte-new-inode
+    allowed, same-inode stale/nonregular/unreadable refuses). No cleanup/retry.
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    source_root = _norm_path(source_root, "source_root")
+    _artifact_ref_shape(checkpoint_ref, "checkpoint_ref")
+    cp_rel = str(checkpoint_ref["path"])
+    # Load record + manifest via pinned paths (no State).
+    abs_cp = _repo_rel(repo_root, cp_rel, "completion checkpoint")
+    raw_cp = _safe_read_bytes(abs_cp, "completion checkpoint")
+    if hashlib.sha256(raw_cp).hexdigest() != checkpoint_ref["sha256"]:
+        raise ResearchAuthorityError("completion checkpoint FILE sha drift")
+    typed = load_typed_checkpoint_record(repo_root, abs_cp)
+    if typed.get("family") != "PREARCH":
+        raise ResearchAuthorityError("completion checkpoint not PREARCH")
+    record = typed.get("record")
+    rev_root = record.get("revision_root")
+    if not isinstance(rev_root, str) or not rev_root:
+        raise ResearchAuthorityError("revision_root missing (slots)")
+    man_abs = _repo_rel(repo_root, f"{rev_root.rstrip('/')}/revision-manifest.json", "slots manifest")
+    man_raw = _safe_read_bytes(man_abs, "slots manifest")
+    man_doc = _strict_parse_object(man_raw, "slots manifest")
+    inv_abs = _repo_rel(repo_root, f"{rev_root.rstrip('/')}/retention/inventory.json", "slots inventory")
+    inv_raw = _safe_read_bytes(inv_abs, "slots inventory")
+    inv_doc = _strict_parse_object(inv_raw, "slots inventory")
+    comp_abs = _repo_rel(repo_root, f"{rev_root.rstrip('/')}/completion/cleanup-completion.json", "slots completion")
+    comp_raw = _safe_read_bytes(comp_abs, "slots completion")
+    comp_doc = _strict_parse_object(comp_raw, "slots completion")
+    copy_abs = _repo_rel(repo_root, f"{rev_root.rstrip('/')}/retention/state-before.json", "slots COPY")
+    copy_raw = _safe_read_bytes(copy_abs, "slots COPY")
+    # Inventory 7 rows exactly bound to manifest snapshots.
+    inv_rows = inv_doc.get("rows")
+    man_rows = (man_doc.get("retention_snapshots") or [])
+    if not isinstance(inv_rows, list) or len(inv_rows) != 7:
+        raise ResearchAuthorityError("slots inventory must have exactly 7 rows")
+    if not isinstance(man_rows, list) or len(man_rows) != 7:
+        raise ResearchAuthorityError("slots manifest must have exactly 7 rows")
+    man_by_slot = {r.get("slot"): r for r in man_rows if isinstance(r, dict)}
+    for row in inv_rows:
+        slot = row.get("slot")
+        if slot not in SEVEN_SLOTS:
+            raise ResearchAuthorityError(f"slots inventory unknown slot: {slot!r}")
+        other = man_by_slot.get(slot)
+        if not isinstance(other, dict) or row != other:
+            raise ResearchAuthorityError(f"slots inventory row != manifest snapshot: {slot}")
+    # Expected_after recomputed from COPY (never trusted).
+    exp_raw = _expected_after_state_bytes(copy_raw, {"path": comp_doc.get("checkpoint", {}).get("path"), "sha256": comp_doc.get("checkpoint", {}).get("sha256")})
+    if hashlib.sha256(exp_raw).hexdigest() != comp_doc.get("expected_after_state", {}).get("sha256"):
+        raise ResearchAuthorityError("slots expected_after sha != COPY recompute")
+    if len(exp_raw) != comp_doc.get("expected_after_state", {}).get("byte_count"):
+        raise ResearchAuthorityError("slots expected_after len != COPY recompute")
+    # Seven_plan vs inventory vs lstat with legitimate-regeneration tolerance.
+    seven = comp_doc.get("seven_plan", [])
+    if not isinstance(seven, list) or len(seven) != 7:
+        raise ResearchAuthorityError("slots seven_plan must have exactly 7 rows")
+    inv_by_slot = {r.get("slot"): r for r in inv_rows}
+    seen: set[str] = set()
+    for row in seven:
+        slot = row.get("slot")
+        if slot not in SEVEN_SLOTS:
+            raise ResearchAuthorityError(f"slots seven_plan unknown slot: {slot!r}")
+        if slot in seen:
+            raise ResearchAuthorityError(f"slots seven_plan duplicate: {slot}")
+        seen.add(slot)
+        if row.get("disposition") not in ("cleared", "absent_legitimate"):
+            raise ResearchAuthorityError(f"slots seven_plan disposition invalid: {slot}")
+        inv = inv_by_slot.get(slot)
+        if inv is None:
+            raise ResearchAuthorityError(f"slots seven_plan missing inventory: {slot}")
+        if inv.get("present"):
+            if row.get("disposition") != "cleared":
+                raise ResearchAuthorityError(f"slots seven_plan must be cleared for retained: {slot}")
+            if row.get("captured_sha") != inv.get("source_sha256") or row.get("copy_sha") != inv.get("copy_sha256"):
+                raise ResearchAuthorityError(f"slots seven_plan sha != inventory: {slot}")
+        else:
+            if row.get("disposition") != "absent_legitimate":
+                raise ResearchAuthorityError(f"slots seven_plan must be absent_legitimate for never-present: {slot}")
+            if row.get("captured_sha") is not None or row.get("copy_sha") is not None:
+                raise ResearchAuthorityError(f"slots seven_plan shas must be null for never-present: {slot}")
+        obs = lstat_slot(source_root, slot)
+        if not obs.get("present"):
+            continue
+        if not inv.get("present"):
+            continue
+        if obs.get("lstat_kind") != "regular":
+            raise ResearchAuthorityError(f"DM022_TRANSITION_ACTIVE: nonregular present slot: {slot}")
+        try:
+            cur_raw = _safe_read_bytes(source_root / slot, f"slot {slot}")
+        except ResearchAuthorityError:
+            raise ResearchAuthorityError(f"DM022_TRANSITION_ACTIVE: unreadable present slot: {slot}")
+        if hashlib.sha256(cur_raw).hexdigest() != inv.get("copy_sha256"):
+            continue
+        captured_ino = inv.get("source_ino")
+        if isinstance(captured_ino, int) and obs.get("ino") != captured_ino:
+            continue
+        raise ResearchAuthorityError(f"DM022_TRANSITION_ACTIVE: stale slot still present: {slot}")
+
 
 
