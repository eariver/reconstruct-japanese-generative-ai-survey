+def _require_no_symlink_ancestors(repo_root: Path, abs_path: Path, label: str) -> None:
+    """Fail-closed ancestor symlink/containment check for captured pins."""
+    try:
+        root = repo_root.resolve()
+    except OSError as exc:
+        raise ResearchAuthorityError(f"{label} repo resolve failed: {exc}") from exc
+    try:
+        cur_resolved = abs_path.resolve()
+    except OSError as exc:
+        raise ResearchAuthorityError(f"{label} resolve failed: {abs_path}: {exc}") from exc
+    try:
+        cur_resolved.relative_to(root)
+    except ValueError as exc:
+        raise ResearchAuthorityError(f"{label} escapes repository: {abs_path}") from exc
+    # Walk repo-relative parts, refusing any symlinked component (lstat, no follow).
+    try:
+        rel = cur_resolved.relative_to(root).as_posix()
+    except ValueError as exc:
+        raise ResearchAuthorityError(f"{label} escapes repository: {abs_path}") from exc
+    cur = root
+    for part in Path(rel).parts:
+        cur = cur / part
+        try:
+            if cur.is_symlink():
+                raise ResearchAuthorityError(f"{label} traverses symlink: {rel}")
+        except OSError as exc:
+            raise ResearchAuthorityError(f"{label} lstat failed: {cur}: {exc}") from exc
+
+
+def _pin_observed(repo_root: Path, abs_path: Path, label: str) -> tuple:
+    """Pin observed file bytes (no external SHA). Fail-closed on missing/symlink."""
+    raw = _safe_read_bytes(abs_path, label)
+    sha = hashlib.sha256(raw).hexdigest()
+    _require_no_symlink_ancestors(repo_root, abs_path, label)
+    return ((label, abs_path, sha, len(raw)), raw)
+
+
+def _pin_with_expected(repo_root: Path, abs_path: Path, label: str, expected_sha: str, expected_len: int | None = None) -> tuple:
+    """Pin file bytes, requiring expected SHA (and len if given). Same-bytes parse follows."""
+    raw = _safe_read_bytes(abs_path, label)
+    actual_sha = hashlib.sha256(raw).hexdigest()
+    if actual_sha != expected_sha:
+        raise ResearchAuthorityError(f"{label} FILE sha drift (capture): {abs_path}")
+    if expected_len is not None and len(raw) != expected_len:
+        raise ResearchAuthorityError(f"{label} byte_count mismatch (capture): {abs_path}")
+    _require_no_symlink_ancestors(repo_root, abs_path, label)
+    return ((label, abs_path, expected_sha, len(raw)), raw)
+
+
+def _parse_object_same(raw: bytes, label: str) -> dict[str, Any]:
+    return _strict_parse_object(raw, label)
+
+
+def _parse_jsonl_same(raw: bytes, label: str) -> list[dict[str, Any]]:
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ResearchAuthorityError(f"{label} JSONL decode failed: {exc}") from exc
+    out: list[dict[str, Any]] = []
+    for lineno, line in enumerate(text.splitlines(), start=1):
+        if not line.strip():
+            continue
+        try:
+            import json as _json
+            from scripts import survey_production_v2 as _core
+            val = _json.loads(line, object_pairs_hook=_core._strict_object_pairs)
+        except Exception as exc:
+            raise ResearchAuthorityError(f"{label} JSONL line {lineno} invalid: {exc}") from exc
+        if not isinstance(val, dict):
+            raise ResearchAuthorityError(f"{label} JSONL line {lineno} must be object")
+        out.append(val)
+    return out
+
