+def _recheck_selection_read_set(repo_root: Path, state_path: Path, read_set: _SelectionReadSet) -> None:
+    """Recheck full read set (FILE pin rechecks + ancestors + exact sets + FULL own-epoch).
+
+    Drift -> fail-closed. Never expected=observed. Includes FULL own-epoch
+    object batch for PREARCH unconditionally; LEGACY skips own-epoch batch.
+    Manifest/request missing refuses (own empty cannot pass for PREARCH).
+    """
+    repo_root = _norm_path(repo_root, "repo_root")
+    for label, path, exp_sha, exp_len in read_set.pins:
+        raw = _safe_read_bytes(Path(path), f"{label} (recheck)")
+        if len(raw) != exp_len or hashlib.sha256(raw).hexdigest() != exp_sha:
+            raise ResearchAuthorityError(f"{label} bytes changed (recheck): {path}")
+        # Ancestor/symlink re-derivation for repo-local pins.
+        try:
+            _require_no_symlink_ancestors(repo_root, Path(path), f"{label} ancestor (recheck)")
+        except ResearchAuthorityError as exc:
+            # Outside repo (e.g., temp input) skips ancestor re-derivation; SHA/len already bound.
+            # Only skip if path is genuinely outside repo.
+            try:
+                Path(path).resolve().relative_to(repo_root.resolve())
+            except ValueError:
+                pass
+            else:
+                raise
+    for label, dpath, exp_names in read_set.dir_sets:
+        d = Path(dpath)
+        # Dir itself must not be symlink and must be within repo.
+        try:
+            lst = os.lstat(d)
+        except OSError as exc:
+            raise ResearchAuthorityError(f"{label} directory unreadable (recheck): {d}: {exc}") from exc
+        if not _stat.S_ISDIR(lst.st_mode):
+            raise ResearchAuthorityError(f"{label} not a directory (recheck): {d}")
+        if _stat.S_ISLNK(lst.st_mode):
+            raise ResearchAuthorityError(f"{label} directory is symlink (recheck): {d}")
+        _require_no_symlink_ancestors(repo_root, d, f"{label} directory (recheck)")
+        try:
+            entries = list(os.listdir(d))
+        except OSError as exc:
+            raise ResearchAuthorityError(f"{label} directory unreadable (recheck): {d}: {exc}") from exc
+        if sorted(entries) != sorted(list(exp_names)):
+            raise ResearchAuthorityError(f"{label} directory set changed (recheck): {d}")
+        for name in entries:
+            p = d / name
+            try:
+                st = os.lstat(p)
+            except OSError as exc:
+                raise ResearchAuthorityError(f"{label} lstat failed (recheck): {p}: {exc}") from exc
+            if not _stat.S_ISREG(st.st_mode):
+                raise ResearchAuthorityError(f"{label} nonregular present (recheck): {p}")
+            # Leaf symlink already refused via S_ISREG? lstat S_ISLNK would be symlink, not regular, so refused. Explicit:
+            if _stat.S_ISLNK(st.st_mode):
+                raise ResearchAuthorityError(f"{label} symlink present (recheck): {p}")
+            _require_no_symlink_ancestors(repo_root, p, f"{label} entry (recheck)")
+    if read_set.is_prearch:
+        own = read_set.own_epoch or {}
+        rec = own.get("record")
+        man = own.get("manifest")
+        req = own.get("request")
+        if not isinstance(rec, dict) or not rec or not isinstance(man, dict) or not man or not isinstance(req, dict) or not req:
+            raise ResearchAuthorityError("PREARCH own epoch incomplete (recheck): manifest/request missing refuses")
+        _verify_own_epoch_commit(repo_root, rec, man, req)
+    # LEGACY skips own-epoch batch (no PREARCH proof).
