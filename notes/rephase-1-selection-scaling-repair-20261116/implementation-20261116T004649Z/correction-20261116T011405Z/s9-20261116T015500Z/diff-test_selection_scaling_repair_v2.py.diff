+        "issue_id": chain["issue_id"],
+        "revision_id": revision_id,
+        "manifest_ref": {"path": out["manifest_ref"]["path"], "sha256": out["manifest_ref"]["sha256"], "byte_count": out["manifest_ref"]["byte_count"]},
