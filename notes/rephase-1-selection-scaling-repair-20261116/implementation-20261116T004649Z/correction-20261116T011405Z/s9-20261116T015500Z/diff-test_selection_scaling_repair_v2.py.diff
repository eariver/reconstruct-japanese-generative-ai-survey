+    req_path, dec_path = helper._build_request_and_decision(chain, state_abs, revision_id, [discovery_id])
+    # Attach supplement_manifest SizedRef (genuine manifest bytes).
+    import json as _js
+    _req_doc = json.loads(req_path.read_bytes().decode())
+    _supp_rel = str(supp_manifest.relative_to(root))
+    import hashlib as _hl3
+    _supp_raw = supp_manifest.read_bytes()
