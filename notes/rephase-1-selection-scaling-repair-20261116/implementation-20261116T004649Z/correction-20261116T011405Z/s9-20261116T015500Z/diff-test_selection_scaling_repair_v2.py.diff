+        "recorded_at": "2026-10-28T00:00:00Z",
+    }
+    dec_path.write_bytes(_js.dumps(_decision, ensure_ascii=False, indent=2, sort_keys=True).encode() + b"\n")
+    rev_rel = out["revision_root"]
+    adopted = high.adopt_revision(root, state_abs, root / rev_rel, dec_path)
