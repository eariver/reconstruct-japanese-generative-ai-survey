#!/usr/bin/env python3
"""DM022 pre-Architecture acceptance operation (HIGH, sole mutator) — A2 correction.

Binding: contract a345bb95 INCLUDING S11, pre-code ROOT S5, R4 md/json +
five literal schemas, R5 families, R6 roles. R3 mechanics as overridden.

Role: SOLE mutator while a bound guard exists. Owns ALL writes: new
revision R/package/task/card/view/acceptance/ledger/completeness/COPY
snapshots/manifests/proof/report/checkpoint/guard/completion/State triplet
switch + checked 7-slot clearing. Exclusive O_CREAT|O_EXCL + short-write
loop + fsync + checked close + replace + dirfsync + postread. NEVER
core.write_json / shutil.copy2 / Path.is_file for absence (single os.lstat
per path per phase; ENOENT = absent legitimate; symlink/nonregular/unreadable
= refuse).

Top-level ONLY: core, schema_gate, LOW (survey_research_authority_v2).
agent/evidence/screening/completeness/discovery imports are function-local
inside each entry. CLI is a real argparse wrapper over the four entries;
no new caller flags/verified dicts.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat as _stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from scripts import survey_production_v2 as core
from scripts import survey_schema_v2 as schema_gate
from scripts import survey_research_authority_v2 as low

DM022_SCHEMA_VERSION = "2.0-rc1"
_REVISION_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
_HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
_HEX40_RE = re.compile(r"^[0-9a-f]{40}$")


class AcceptanceError(ValueError):
    """Typed HIGH failure (retains primary/secondary + observed bytes)."""


def _norm_path(value: Any, label: str) -> Path:
    """Coerce a documented Path-or-string filesystem input (no IO).

    Accepts exactly Path or non-empty string; anything else raises the typed
    error instead of an AttributeError or a silent misresolution. Callers
    still apply repo containment and no-follow reads after normalization.
    """
    if isinstance(value, Path):
        return value
    if isinstance(value, str) and value:
        return Path(value)
    raise AcceptanceError(f"{label} must be a Path or non-empty string, got {type(value).__name__}")


def _lstat_single(path: Path, label: str) -> os.stat_result | None:
    try:
        return os.lstat(path)
    except OSError as exc:
        import errno as _errno

        if exc.errno == _errno.ENOENT:
            return None
        raise AcceptanceError(f"{label} lstat failed: {path}: errno={exc.errno}") from exc


def _require_regular(st: os.stat_result, path: Path, label: str) -> None:
    if not _stat.S_ISREG(st.st_mode):
        raise AcceptanceError(f"{label} is not a regular file: {path} (mode={oct(st.st_mode)})")


_TRY_TMP_COUNTER = 0


def _exclusive_write_bytes(path: Path, data: bytes, label: str) -> dict[str, Any]:
    """Atomic exclusive claim for immutable R/guard/checkpoint/completion files.

    Single atomic claim, no check-then-act race: bytes go to a sibling temp
    (O_CREAT|O_EXCL, short-write loop, fsync, checked close, re-read verify),
    then the final name is claimed atomically with os.link (fails EEXIST when
    the final already exists — never overwrites an immutable artifact).
    Partial temp files are PRESERVED on failure (path reported in the error;
    no hidden unlink) so interrupted attempts stay diagnosable; callers treat
    an existing final as refuse (new bounded attempt per contract F2), never
    as overwrite. The State triplet switch (replace_state_triplet) is the ONLY
    replace-over-existing path (single-writer, held-descriptor, known-byte,
    inode-pinned); this helper never replaces.
    """
    global _TRY_TMP_COUNTER
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise AcceptanceError(f"{label} parent dir create failed: {path.parent}: errno={exc.errno}") from exc
    _TRY_TMP_COUNTER += 1
    tmp = path.with_name(
        path.name
        + f".tmp.{os.getpid()}.{_TRY_TMP_COUNTER}."
        + hashlib.sha256(data).hexdigest()[:8]
    )
    try:
        fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except OSError as exc:
        raise AcceptanceError(f"{label} exclusive temp create failed: {tmp}: errno={exc.errno}") from exc
    try:
        view = memoryview(data)
        while view:
            try:
                n = os.write(fd, view)
            except OSError as exc:
                raise AcceptanceError(f"{label} short-write failed, partial temp preserved at {tmp}: {exc}") from exc
            if n <= 0:
                raise AcceptanceError(f"{label} short-write returned {n}, partial temp preserved at {tmp}")
            view = view[n:]
        try:
            os.fsync(fd)
        except OSError as exc:
            raise AcceptanceError(f"{label} fsync failed, partial temp preserved at {tmp}: {exc}") from exc
    finally:
        try:
            os.close(fd)
        except OSError as exc:
            raise AcceptanceError(f"{label} checked close failed, partial temp preserved at {tmp}: {exc}") from exc
    try:
        rfd = os.open(tmp, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise AcceptanceError(f"{label} temp re-open failed, temp preserved at {tmp}: {exc}") from exc
    try:
        fst = os.fstat(rfd)
        if not _stat.S_ISREG(fst.st_mode):
            raise AcceptanceError(f"{label} temp fstat not regular, temp preserved at {tmp}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(rfd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        temp_bytes = b"".join(chunks)
    except OSError as exc:
        raise AcceptanceError(f"{label} temp re-read failed, temp preserved at {tmp}: {exc}") from exc
    finally:
        try:
            os.close(rfd)
        except OSError as exc:
            raise AcceptanceError(f"{label} temp re-close failed, temp preserved at {tmp}: {exc}") from exc
    if temp_bytes != data:
        raise AcceptanceError(f"{label} temp bytes differ after write, temp preserved at {tmp}")
    try:
        os.link(tmp, path)
    except OSError as exc:
        raise AcceptanceError(f"{label} atomic link claim refused (final present or error; no overwrite): {path}: errno={exc.errno}; temp preserved at {tmp}") from exc
    try:
        os.unlink(tmp)
    except OSError as exc:
        raise AcceptanceError(f"{label} temp unlink after link failed (final claimed at {path}; stale temp preserved at {tmp}): {exc}") from exc
    try:
        dir_fd = os.open(path.parent, os.O_RDONLY)
    except OSError as exc:
        raise AcceptanceError(f"{label} dir open failed: {exc}") from exc
    try:
        try:
            os.fsync(dir_fd)
        except OSError as exc:
            raise AcceptanceError(f"{label} dir fsync failed: {exc}") from exc
    finally:
        os.close(dir_fd)
    final_raw = _safe_read_bytes(path, label + " postread")
    if final_raw != data:
        raise AcceptanceError(f"{label} postread bytes differ at claimed final: {path}")
    final_st = _lstat_single(path, label)
    if final_st is None:
        raise AcceptanceError(f"{label} missing after link claim: {path}")
    return {"dev": final_st.st_dev, "ino": final_st.st_ino, "size": final_st.st_size}


def _safe_read_bytes(path: Path, label: str) -> bytes:
    try:
        lst = os.lstat(path)
    except OSError as exc:
        raise AcceptanceError(f"{label} absent: {path}: errno={exc.errno}") from exc
    if not _stat.S_ISREG(lst.st_mode):
        raise AcceptanceError(f"{label} is not a regular file: {path} (mode={oct(lst.st_mode)})")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise AcceptanceError(f"{label} open(O_NOFOLLOW) failed: errno={exc.errno}") from exc
    try:
        fst = os.fstat(fd)
        if not _stat.S_ISREG(fst.st_mode):
            raise AcceptanceError(f"{label} fstat not regular: {path}")
        if (fst.st_dev, fst.st_ino) != (lst.st_dev, lst.st_ino):
            raise AcceptanceError(f"{label} inode changed between lstat and open (replaced): {path}")
        chunks: list[bytes] = []
        while True:
            data = os.read(fd, 65536)
            if not data:
                break
            chunks.append(data)
        return b"".join(chunks)
    except OSError as exc:
        raise AcceptanceError(f"{label} read failed: {exc}") from exc
    finally:
        try:
            os.close(fd)
        except OSError as exc:
            raise AcceptanceError(f"{label} checked close failed: {exc}") from exc


def _copy_regular_exclusive(src: Path, dst: Path, label: str) -> dict[str, Any]:
    """Backup-verified exclusive COPY (source re-read must equal capture)."""
    if _lstat_single(dst, label + " copy target") is not None:
        raise AcceptanceError(f"{label} copy target already exists (no overwrite): {dst}")
    src_bytes = _safe_read_bytes(src, label + " source")
    src_st = _lstat_single(src, label + " source")
    if src_st is None:
        raise AcceptanceError(f"{label} source vanished")
    info = _exclusive_write_bytes(dst, src_bytes, label + " copy")
    re_bytes = _safe_read_bytes(src, label + " source re-verify")
    if re_bytes != src_bytes:
        raise AcceptanceError(f"{label} source changed during COPY")
    dst_st = _lstat_single(dst, label + " copy")
    if dst_st is None:
        raise AcceptanceError(f"{label} copy vanished")
    if (dst_st.st_dev, dst_st.st_ino) == (src_st.st_dev, src_st.st_ino):
        raise AcceptanceError(f"{label} COPY shares inode with source")
    return {
        "sha256": hashlib.sha256(src_bytes).hexdigest(),
        "byte_count": len(src_bytes),
        "source_dev": src_st.st_dev,
        "source_ino": src_st.st_ino,
        "copy_dev": dst_st.st_dev,
        "copy_ino": dst_st.st_ino,
    }


def _current_head_tree(repo_root: Path) -> dict[str, str]:
    repo_root = _norm_path(repo_root, "repo_root")
    try:
        head = subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=repo_root, check=True,
            capture_output=True, text=True,
        ).stdout.strip()
        tree = subprocess.run(
            ["git", "rev-parse", "HEAD^{tree}"], cwd=repo_root, check=True,
            capture_output=True, text=True,
        ).stdout.strip()
    except Exception as exc:
        raise AcceptanceError(f"HEAD/tree observation failed: {exc}") from exc
    if not _HEX40_RE.fullmatch(head) or not _HEX40_RE.fullmatch(tree):
        raise AcceptanceError("HEAD/tree observation not 40-hex")
    return {"head": head, "tree": tree}


def _revision_root_for(source_root: Path, revision_id: str) -> Path:
    source_root = _norm_path(source_root, "source_root")
    if not _REVISION_ID_RE.fullmatch(revision_id):
        raise AcceptanceError(f"invalid revision_id: {revision_id!r}")
    return Path(source_root) / "research" / "v2" / "acceptance-revisions" / revision_id


def _profile_and_source(repo_root: Path, state: dict[str, Any]) -> tuple[Path, dict[str, Any], Path]:
    repo_root = _norm_path(repo_root, "repo_root")
    profile_ref = state.get("profile")
    if not isinstance(profile_ref, dict) or set(profile_ref) != {"path", "sha256"}:
        raise AcceptanceError("state.profile authority fields invalid")
    try:
        profile_abs = core.repo_local_path(repo_root, profile_ref["path"], "state.profile.path")
    except ValueError as exc:
        raise AcceptanceError(f"Production Profile path invalid: {exc}") from exc
    profile_raw = _safe_read_bytes(profile_abs, "Production Profile")
    if hashlib.sha256(profile_raw).hexdigest() != profile_ref.get("sha256"):
        raise AcceptanceError("Production Profile bytes differ from State authority")
    try:
        profile = schema_gate.parse_json_strict_bytes(profile_raw, "Production Profile")
    except Exception as exc:
        raise AcceptanceError(f"Production Profile strict parse failed: {exc}") from exc
    try:
        schema_gate.validate_instance(profile, repo_root / "schemas/survey-production-profile.schema.json", label="Production Profile")
    except Exception as exc:
        raise AcceptanceError(f"Production Profile schema invalid: {exc}") from exc
    try:
        source_rel = profile["paths"]["source_root"]
    except (KeyError, TypeError) as exc:
        raise AcceptanceError(f"profile source_root invalid: {exc}") from exc
    try:
        source_root = core.repo_local_path(repo_root, source_rel, "paths.source_root")
    except ValueError as exc:
        raise AcceptanceError(f"source_root invalid: {exc}") from exc
    return profile_abs, profile, source_root


def verify_live_eligibility(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any]) -> list[str]:
    """HIGH-ONLY full strict LIVE State validation (no synthetic bypass).

    Calls public agent.validate_agent_state on the same LIVE bytes, then
    enforces the exact S3 EVIDENCE_REVIEWED window with actual State shapes:
    lifecycle, passed Discovery/Screening/Evidence/Materiality/Completeness with
    valid provenance, no accepted downstream (selection/architecture/draft/
    validation/publication_preview/freeze/release must be pending/None), no
    Human approval/provenance (both gates pending, both provenances null, no
    approval files), no active Exception (status must be inactive), null
    publication revalidation pointer. Returns error list (empty = eligible).
    Never writes.
    """
    from scripts import survey_agent_control_v2 as agent

    repo_root = _norm_path(repo_root, "repo_root")
    errors: list[str] = []
    try:
        agent_errors = agent.validate_agent_state(repo_root, cfg, state)
    except Exception as exc:
        return [f"agent strict State validation raised: {exc}"]
    if agent_errors:
        return [f"agent strict State invalid: {agent_errors[0]}"] + agent_errors[1:]
    if state.get("lifecycle_state") != "EVIDENCE_REVIEWED":
        errors.append("lifecycle_state must be exactly EVIDENCE_REVIEWED")
    prov = state.get("checkpoint_provenance", {})
    if not isinstance(prov, dict):
        errors.append("checkpoint_provenance invalid")
    else:
        for key in ("evidence", "materiality", "completeness"):
            ref = prov.get(key)
            if not isinstance(ref, dict) or set(ref) != {"path", "sha256"}:
                errors.append(f"checkpoint_provenance.{key} authority fields invalid")
        for key in ("selection", "architecture", "draft", "validation", "publication_preview", "freeze", "release"):
            if prov.get(key) is not None:
                errors.append(f"checkpoint_provenance.{key} must be pending (no accepted downstream)")
    gates = state.get("human_gates", {})
    if not isinstance(gates, dict):
        errors.append("human_gates invalid")
    else:
        for name in ("architecture_review", "publication_preview"):
            if gates.get(name) != "pending":
                errors.append(f"human gate {name} must be pending in S3 window (got {gates.get(name)!r})")
    gate_prov = state.get("human_gate_provenance", {})
    if not isinstance(gate_prov, dict):
        errors.append("human_gate_provenance invalid")
    else:
        for name in ("architecture_review", "publication_preview"):
            if gate_prov.get(name) is not None:
                errors.append(f"human_gate_provenance.{name} must be null in S3 window (no prior Human review)")
    exc_gate = state.get("exception_gate", {})
    if not isinstance(exc_gate, dict):
        errors.append("exception_gate invalid")
    else:
        if exc_gate.get("status") != "inactive":
            errors.append(f"exception_gate.status must be inactive in S3 window (got {exc_gate.get('status')!r})")
    if state.get("publication_revalidation_provenance") is not None:
        errors.append("publication_revalidation_provenance must be null in S3 window")
    return errors


def _rel_of(repo_root: Path, abs_path: Path) -> str:
    return str(abs_path.resolve().relative_to(repo_root.resolve()))


def _prove_before_graph_unbound(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any], source_root: Path, issue_id: str) -> None:
    """Prove no accepted downstream and no prior Human presentation/review.

    Strict State + review/presentation absence + exact prior refs: downstream
    machine_checkpoints/provenance pending/None, both Human gates pending with
    null provenances, no approval files under source_root/gates review paths,
    and NO prior recorded Human Gate review/decision of ANY kind in a valid
    review index — including REQUEST_CHANGES, even when the current gates read
    pending/null and every one of the seven canonical slots is absent. The
    selected DM022 entry window excludes prior Human presentation/review, not
    just active approval; absent artifacts or differing SHAs never waive it.
    An absent index, or a present index that is schema-valid, issue-matched and
    genuinely empty (reviews: []), remains eligible — absence alone never
    confers approval. Malformed/unreadable/issue-mismatched index content
    refuses fail-closed. Raises on any bound or historical evidence: the
    caller must refuse retention/clearing before any COPY. This predicate
    applies at DM022 entry (prepare, re-verified at adopt) only — never on
    the adopted readback/READY path, where the creation window must not be
    reapplied.
    """
    for key in ("selection", "architecture", "draft", "validation", "publication_preview", "freeze", "release"):
        if state.get("machine_checkpoints", {}).get(key) != "pending":
            raise AcceptanceError(f"slot retention refused: machine checkpoint {key} is not pending (accepted downstream exists)")
        if state.get("checkpoint_provenance", {}).get(key) is not None:
            raise AcceptanceError(f"slot retention refused: checkpoint_provenance.{key} carries accepted downstream")
    for name in ("architecture_review", "publication_preview"):
        if state.get("human_gates", {}).get(name) != "pending":
            raise AcceptanceError(f"slot retention refused: human gate {name} is not pending")
        if state.get("human_gate_provenance", {}).get(name) is not None:
            raise AcceptanceError(f"slot retention refused: human_gate_provenance.{name} is set (prior Human review)")
    authority = cfg.get("state_authority", {})
    for key in ("architecture_approval_path", "publication_preview_approval_path"):
        rel = authority.get(key)
        if not isinstance(rel, str) or not rel:
            raise AcceptanceError(f"slot retention refused: state_authority.{key} missing from config")
        probe = source_root / rel
        st = _lstat_single(probe, f"Human approval probe {rel}")
        if st is not None:
            raise AcceptanceError(f"slot retention refused: Human-bound approval file present: {rel}")
    idx_rel = authority.get("human_review_index_path")
    if not isinstance(idx_rel, str) or not idx_rel:
        raise AcceptanceError("slot retention refused: state_authority.human_review_index_path missing from config")
    idx_abs = source_root / idx_rel
    if _lstat_single(idx_abs, "Human review index probe") is None:
        return
    idx_raw = _safe_read_bytes(idx_abs, "Human review index")
    try:
        idx_doc = schema_gate.parse_json_strict_bytes(idx_raw, "Human review index")
    except Exception as exc:
        raise AcceptanceError(f"slot retention refused: review index unparseable: {exc}") from exc
    try:
        schema_gate.validate_instance(idx_doc, repo_root / "schemas/human-gate-review-index-v2.schema.json", label="Human review index")
    except Exception as exc:
        raise AcceptanceError(f"slot retention refused: review index schema invalid: {exc}") from exc
    if idx_doc.get("issue_id") != issue_id:
        raise AcceptanceError("slot retention refused: review index issue mismatch")
    rows = idx_doc.get("reviews", [])
    if not isinstance(rows, list):
        raise AcceptanceError("slot retention refused: review index reviews must be an array")
    for row in rows:
        if not isinstance(row, dict):
            raise AcceptanceError("slot retention refused: review index row malformed")
        gate = row.get("gate")
        decision = row.get("decision")
        if gate not in ("ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW") or decision not in ("APPROVED", "REQUEST_CHANGES"):
            raise AcceptanceError(f"slot retention refused: review index row has unknown gate/decision: {row.get('gate')}/{row.get('decision')}")
        raise AcceptanceError(
            f"slot retention refused: prior Human Gate {decision} recorded for {gate} "
            f"(DM022 entry requires no prior Human presentation/review, not just no active approval)"
        )
    return None


def _contract_and_tools(repo_root: Path, cfg: dict[str, Any], state: dict[str, Any]) -> tuple[dict[str, Any], list[dict[str, str]]]:
    contract = core.contract_identity(repo_root, cfg, state.get("research_profile"), state.get("publication_profile"))
    tool_paths = sorted({str(p) for p in [
        "scripts/survey_research_authority_v2.py",
        "scripts/survey_prearchitecture_acceptance_v2.py",
        "schemas/dm022-revision-request-v2.schema.json",
        "schemas/dm022-revision-manifest-v2.schema.json",
        "schemas/dm022-revision-proof-v2.schema.json",
        "schemas/dm022-preadoption-report-v2.schema.json",
        "schemas/dm022-supersession-checkpoint-v2.schema.json",
    ]})
    tool_shas = []
    for rel in tool_paths:
        abs_p = core.repo_local_path(repo_root, rel, "tool pin")
        raw = _safe_read_bytes(abs_p, f"tool pin {rel}")
        tool_shas.append({"path": rel, "sha256": hashlib.sha256(raw).hexdigest()})
    return contract, tool_shas


def prepare_revision(repo_root: Path, state_path: Path, request_path: Path, revision_id: str) -> dict:
    """Pin basis + immutable R snapshots + truthful candidate (no guard/State).

    Inert preparation: no canonical writes, no State writes, no guard claim.
    Writes ONLY new owned R files via exclusive primitive. Calls FULL content
    validators after each write (package/cards/views/acceptances/ledger/
    completeness). Returns {"revision_root", "manifest_ref", "retention",
    "planned_files"}.
    """
    from scripts import survey_agent_control_v2 as agent

    repo_root = _norm_path(repo_root, "repo_root")
    state_path = _norm_path(state_path, "state path")
    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
    state_raw = _safe_read_bytes(abs_state, "LIVE production state")
    try:
        state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE production state")
    except Exception as exc:
        raise AcceptanceError(f"LIVE State strict parse failed: {exc}") from exc
    if not isinstance(state, dict):
        raise AcceptanceError("LIVE State must be an object")
    cfg = core.load_json(repo_root / str(core.DEFAULT_CONFIG))
    eligibility = verify_live_eligibility(repo_root, cfg, state)
    if eligibility:
        raise AcceptanceError("LIVE eligibility refused: " + "; ".join(eligibility))
    _, profile, source_root = _profile_and_source(repo_root, state)
    # Canonical State path check: state_path must be the canonical
    # <source_root>/production-state.json (not a COPY or temp).
    try:
        canonical_state = core.repo_local_path(repo_root, f"{profile['paths']['source_root']}/production-state.json", "canonical state")
    except ValueError as exc:
        raise AcceptanceError(f"canonical State path invalid: {exc}") from exc
    if abs_state.resolve() != canonical_state.resolve():
        raise AcceptanceError("state_path must be the canonical LIVE production-state.json (not a COPY)")
    rev_root = _revision_root_for(source_root, revision_id)
    try:
        rev_rel_str = str(rev_root.resolve().relative_to(repo_root.resolve()))
    except ValueError:
        raise AcceptanceError("revision root must be under repo_root")
    low.require_no_active_guard(source_root)
    # Human-window entry check BEFORE any R writes or COPY: refuse prior
    # recorded Human presentation/review/decision (even REQUEST_CHANGES, even
    # with all slots absent). Must precede the first exclusive write below.
    _prove_before_graph_unbound(repo_root, cfg, state, source_root, state.get("issue_id", ""))
    head_tree = _current_head_tree(repo_root)
    request_path = _norm_path(request_path, "revision request path")
    request_abs = request_path if request_path.is_absolute() else (repo_root / str(request_path))
    request_raw = _safe_read_bytes(request_abs, "revision request")
    try:
        request = schema_gate.parse_json_strict_bytes(request_raw, "revision request")
    except Exception as exc:
        raise AcceptanceError(f"request strict parse failed: {exc}") from exc
    schema_gate.validate_instance(request, repo_root / "schemas/dm022-revision-request-v2.schema.json", label="revision request")
    # Preserve original entry bytes/refs for late-boundary recheck (no tautology:
    # manifest field must equal originally captured values + actual file bytes,
    # not the current in-memory assignment).
    import copy as _copy_mod

    original_request_raw = request_raw
    original_request_sha = hashlib.sha256(request_raw).hexdigest()
    original_request_len = len(request_raw)
    original_supp_ref = _copy_mod.deepcopy(request.get("supplement_manifest"))
    if request.get("revision_id") != revision_id:
        raise AcceptanceError("request.revision_id must equal revision_id argument")
    work = request.get("work", {})
    if work.get("expected_head") != head_tree["head"] or work.get("expected_tree") != head_tree["tree"]:
        raise AcceptanceError("request work HEAD/tree does not match LIVE invocation HEAD/tree")
    # Contract + tool pins must bind actual current files (no stale pins).
    live_contract, live_tools = _contract_and_tools(repo_root, cfg, state)
    req_contract = (request.get("tool_pins") or {}).get("contract")
    if req_contract != live_contract:
        raise AcceptanceError("request tool_pins.contract does not match LIVE contract_identity (stale pins refused)")
    req_tools = {e.get("path"): e.get("sha256") for e in (request.get("tool_pins") or {}).get("tool_shas", []) or []}
    live_map = {e["path"]: e["sha256"] for e in live_tools}
    if req_tools != live_map:
        raise AcceptanceError("request tool_pins.tool_shas do not match LIVE tool SHAs (stale pins refused)")
    # Immutable snapshots: S_before COPY + every present 7-slot COPY.
    before_ref = request.get("before_state", {})
    live_rel = before_ref.get("path")
    if not isinstance(live_rel, str) or not live_rel:
        raise AcceptanceError("request.before_state.path missing")
    live_abs = core.repo_local_path(repo_root, live_rel, "before_state.path")
    if live_abs.resolve() != abs_state.resolve():
        raise AcceptanceError("request.before_state.path must be the canonical LIVE State path")
    live_raw = _safe_read_bytes(live_abs, "LIVE state-before")
    if hashlib.sha256(live_raw).hexdigest() != before_ref.get("sha256"):
        raise AcceptanceError("LIVE state-before bytes != request.before_state.sha256")
    if len(live_raw) != before_ref.get("byte_count"):
        raise AcceptanceError("LIVE state-before byte_count mismatch")
    # Profile/support P1-P4 new-operation eligibility BEFORE the first State
    # COPY below: current PATH loader + source classification over all R/E
    # source rows including DROP + per-(parent,OID) declaration-loss gate on
    # the DM022 seven-field request (never the ordinary 3/5 validator). Any
    # refusal happens before any exclusive write or COPY.
    from scripts import survey_evidence_v2 as _evidence_mod
    from scripts import survey_screening_v2 as _screening_mod

    try:
        current_ctx = low.derive_current_root_effective_context(repo_root, request_abs, abs_state)
    except Exception as exc:
        raise AcceptanceError(f"HIGH current root/effective context refused before first COPY: {exc}") from exc
    try:
        for _rec in list(current_ctx.get("root_records", [])) + list(current_ctx.get("effective_records", [])):
            if not isinstance(_rec, dict):
                raise AcceptanceError("current Discovery record must be an object")
            _source = _rec.get("source")
            if not isinstance(_source, dict):
                raise AcceptanceError(f"current Discovery record lacks source: {_rec.get('discovery_id')!r}")
            _evidence_mod._source_class(_source.get("source_type"))
    except AcceptanceError:
        raise
    except Exception as exc:
        raise AcceptanceError(f"HIGH source classification refused before first COPY: {exc}") from exc
    try:
        _uncovered = _screening_mod.find_declaration_loss(current_ctx.get("root_records", []), current_ctx.get("effective_records", []))
    except Exception as exc:
        raise AcceptanceError(f"HIGH declaration-loss check failed before first COPY: {exc}") from exc
    if _uncovered:
        raise AcceptanceError(
            "HIGH DECLARATION_LOSS refused before first COPY: "
            f"uncovered={sorted(_uncovered)[:8]}"
        )
    retention_dir = rev_root / "retention"
    state_copy = retention_dir / "state-before.json"
    state_copy_info = _copy_regular_exclusive(live_abs, state_copy, "state-before COPY")
    # Previous checkpoint for OLD prompt/contracts + OLD completeness dimension
    # fallback: from request.before_checkpoint evidence ref.
    prev_ev_ref = (request.get("before_checkpoint") or {}).get("evidence")
    if not isinstance(prev_ev_ref, dict):
        raise AcceptanceError("request.before_checkpoint.evidence missing")
    prev_abs_for_old = core.repo_local_path(repo_root, prev_ev_ref["path"], "previous checkpoint")
    prev_raw_for_old = _safe_read_bytes(prev_abs_for_old, "previous checkpoint")
    if hashlib.sha256(prev_raw_for_old).hexdigest() != prev_ev_ref.get("sha256"):
        raise AcceptanceError("previous checkpoint FILE sha drift (prepare)")
    prev_typed_for_old = low.load_typed_checkpoint_record(repo_root, prev_abs_for_old)
    prev_rec_for_old = prev_typed_for_old["record"]
    # OLD completeness for dimension/description fallback.
    old_art_by_name = {r.get("name"): r for r in prev_rec_for_old.get("artifacts", []) if isinstance(r, dict)}
    old_comp_ref = old_art_by_name.get("profile-completeness")
    if old_comp_ref is None:
        raise AcceptanceError("previous record lacks profile-completeness artifact")
    old_comp_abs = core.repo_local_path(repo_root, old_comp_ref["path"], "OLD completeness")
    old_comp_raw = _safe_read_bytes(old_comp_abs, "OLD completeness")
    if hashlib.sha256(old_comp_raw).hexdigest() != old_comp_ref.get("sha256"):
        raise AcceptanceError("OLD completeness FILE sha drift")
    old_comp_path_rel = str(old_comp_abs.resolve().relative_to(repo_root.resolve()))
    # accepted_bound/gate_bound False below is the PROVEN outcome of the entry
    # window check above (no accepted downstream, no prior Human presentation/
    # review of any kind), never an unobserved constant.
    slot_rows: list[dict[str, Any]] = []
    for slot in low.SEVEN_SLOTS:
        slot_abs = source_root / slot
        slot_rel = f"{profile['paths']['source_root']}/{slot}"
        st = low.lstat_slot(source_root, slot)
        # lstat_slot returns present True/False; for present nonregular refuse.
        if st["lstat_kind"] == "nonregular":
            raise AcceptanceError(f"slot {slot} is nonregular (refuse; never coerce)")
        if st["lstat_kind"] == "refused":
            raise AcceptanceError(f"slot {slot} lstat refused (fail-closed)")
        copy_rel = f"{rev_rel_str}/retention/slots/{slot.replace('/', '__')}"
        copy_abs = repo_root / copy_rel
        if not st["present"]:
            slot_rows.append({
                "slot": slot, "source_rel": slot_rel, "copy_rel": copy_rel,
                "present": False, "source_sha256": None, "copy_sha256": None,
                "byte_count": None, "source_dev": None, "source_ino": None,
                "copy_dev": None, "copy_ino": None,
                "accepted_bound": False, "gate_bound": False,
            })
            continue
        cur_st = _lstat_single(slot_abs, f"slot {slot}")
        if cur_st is None:
            raise AcceptanceError(f"slot {slot} vanished between lstat and read")
        slot_raw = _safe_read_bytes(slot_abs, f"slot {slot}")
        slot_sha = hashlib.sha256(slot_raw).hexdigest()
        # No per-slot record scan here: the global before-graph proof above
        # already refuses ANY prior recorded Human review/decision, so no
        # presented slot can reach the COPY.
        info = _copy_regular_exclusive(slot_abs, copy_abs, f"slot {slot} COPY")
        slot_rows.append({
            "slot": slot, "source_rel": slot_rel, "copy_rel": copy_rel,
            "present": True, "source_sha256": slot_sha,
            "copy_sha256": info["sha256"], "byte_count": len(slot_raw),
            "source_dev": info["source_dev"], "source_ino": info["source_ino"],
            "copy_dev": info["copy_dev"], "copy_ino": info["copy_ino"],
            "accepted_bound": False, "gate_bound": False,
        })
    # Candidate generation via LOW pure builders (in-memory; HIGH writes).
    # Package (REAL Discovery/Screening/tasks, REAL prompt/contracts from OLD).
    # HIGH supplement binding seam: verify request SizedRef bytes before any
    # package/task write; LOW builder validates full supplement closure with
    # effective DS and sets package authority. HIGH rechecks equality here
    # (before writes) and again before manifest (no duplicate full validator).
    _req_supp = request.get("supplement_manifest")
    if _req_supp is None:
        pass
    else:
        try:
            low._sized_ref_shape(_req_supp, "request.supplement_manifest")
        except Exception as exc:
            raise AcceptanceError(f"request supplement_manifest shape invalid: {exc}") from exc
        try:
            low._verify_sized_ref_bytes(repo_root, _req_supp, "request supplement_manifest")
        except Exception as exc:
            raise AcceptanceError(f"request supplement_manifest bytes invalid: {exc}") from exc
    built_pkg = low.build_revision_package_from_paths(repo_root, request_abs, state_copy, rev_root / "candidate")
    pkg_payload = built_pkg["package"]
    # Recheck package authority equals validated request manifest (exact
    # {path,sha256}, not OLD path when replaced; null => no authority).
    if _req_supp is None:
        if pkg_payload.get("authority_supplement") is not None:
            raise AcceptanceError("package must have no authority_supplement when request supplement_manifest is null")
        if isinstance(pkg_payload.get("contracts"), dict) and "supplement" in pkg_payload["contracts"]:
            raise AcceptanceError("package must have no supplement contract when request supplement_manifest is null")
        for _tm in pkg_payload.get("tasks", []):
            if "authority_supplement_source_ids" in _tm:
                raise AcceptanceError("package tasks must have no supplement IDs when request supplement_manifest is null")
    else:
        _pkg_auth = pkg_payload.get("authority_supplement")
        if not isinstance(_pkg_auth, dict) or set(_pkg_auth) != {"path", "sha256"}:
            raise AcceptanceError("package authority_supplement fields invalid")
        if _pkg_auth.get("path") != _req_supp.get("path") or _pkg_auth.get("sha256") != _req_supp.get("sha256"):
            raise AcceptanceError("package authority_supplement must equal validated request supplement_manifest {path,sha256}")
    _exclusive_write_bytes(rev_root / "candidate" / "package.json", core.json_bytes(pkg_payload), "R package")
    for meta in built_pkg["tasks"]:
        task_raw = core.json_bytes(meta["_task"])
        _exclusive_write_bytes(rev_root / "candidate" / "tasks" / Path(meta["path"]).name, task_raw, f"R task {meta['evidence_task_id']}")
    # Cards/views (REAL _build_card/_build_view + REAL validators).
    results_dir = rev_root / "candidate" / "results"
    views_dir = rev_root / "candidate" / "views"
    results_dir.mkdir(parents=True, exist_ok=True)
    views_dir.mkdir(parents=True, exist_ok=True)
    # Build cards/views in-memory first (LOW pure reads package file we wrote).
    # LOW builder reads tasks from package-adjacent tasks dir (we wrote them).
    from scripts import survey_evidence_v2 as _ev

    cv = low.build_revision_cards_views_from_paths(repo_root, rev_root / "candidate" / "package.json", request_abs, results_dir, views_dir, before_copy_path=state_copy)
    # Write each card/view DIRECTLY under its exact acceptance filename
    # (package task basename / view_filename): single atomic exclusive claim
    # per file, no temp-rename dance, no unlinks of owned outputs.
    pkg_tasks = {m["evidence_task_id"]: m for m in pkg_payload.get("tasks", [])}
    if not cv["cards"] or not cv["views"]:
        raise AcceptanceError("revision produced empty card/view set (refuse empty acceptance inputs)")
    for card in cv["cards"]:
        meta = pkg_tasks.get(card["evidence_task_id"])
        if meta is None:
            raise AcceptanceError(f"card task missing in package: {card['evidence_task_id']}")
        _exclusive_write_bytes(results_dir / Path(meta["path"]).name, core.json_bytes(card), f"R card {Path(meta['path']).name}")
    for view in cv["views"]:
        _exclusive_write_bytes(views_dir / _ev.view_filename(view["evidence_task_id"]), core.json_bytes(view), f"R view {_ev.view_filename(view['evidence_task_id'])}")
    # Acceptances (REAL validators + REAL digests). HIGH writes into
    # digest-named run dirs to satisfy run_dir.name == digest.
    # First compute acceptances in-memory via LOW (reads results/views dirs).
    # LOW needs profile_path + accepted roots (planned R dirs); it returns
    # payloads, HIGH chooses digest-named paths.
    # Use temp planned roots under R/candidate for LOW computation (no writes by LOW).
    acc = low.accept_revision_evidence_views_from_paths(
        repo_root, rev_root / "candidate" / "package.json", results_dir, views_dir,
        core.repo_local_path(repo_root, request["profile_ref"]["path"], "profile"),
        rev_root / "candidate" / "evidence-runs", rev_root / "candidate" / "views-runs",
        request_path=request_abs, before_copy_path=state_copy,
    )
    ev_acc = acc["evidence_acceptance"]
    vw_acc = acc["views_acceptance"]
    ev_run_dir = rev_root / "candidate" / "evidence-runs" / ev_acc["result_set_sha256"]
    vw_run_dir = rev_root / "candidate" / "views-runs" / vw_acc["view_set_sha256"]
    if _lstat_single(ev_run_dir, "evidence run dir") is not None:
        raise AcceptanceError("evidence run dir already exists (no overwrite)")
    if _lstat_single(vw_run_dir, "views run dir") is not None:
        raise AcceptanceError("views run dir already exists (no overwrite)")
    ev_run_dir.mkdir(parents=True, exist_ok=False)
    (ev_run_dir / "tasks").mkdir(parents=True, exist_ok=False)
    (ev_run_dir / "results").mkdir(parents=True, exist_ok=False)
    vw_run_dir.mkdir(parents=True, exist_ok=False)
    (vw_run_dir / "views").mkdir(parents=True, exist_ok=False)
    # Copy package + tasks + results into evidence run dir (exclusive).
    _exclusive_write_bytes(ev_run_dir / "package.json", core.json_bytes(pkg_payload), "evidence run package")
    for meta in pkg_payload.get("tasks", []):
        task_src = rev_root / "candidate" / meta["path"]
        task_raw = _safe_read_bytes(task_src, f"package task {meta['evidence_task_id']}")
        _exclusive_write_bytes(ev_run_dir / "tasks" / Path(meta["path"]).name, task_raw, "evidence run task")
        res_src = results_dir / Path(meta["path"]).name
        res_raw = _safe_read_bytes(res_src, f"result {meta['evidence_task_id']}")
        _exclusive_write_bytes(ev_run_dir / "results" / Path(meta["path"]).name, res_raw, "evidence run result")
    _exclusive_write_bytes(ev_run_dir / "evidence-accepted.json", core.json_bytes(ev_acc), "evidence acceptance")
    # Copy views into views run dir.
    for row in vw_acc.get("views", []):
        src = views_dir / _ev.view_filename(row["evidence_task_id"])
        raw_v = _safe_read_bytes(src, f"view {row['evidence_task_id']}")
        _exclusive_write_bytes(vw_run_dir / "views" / _ev.view_filename(row["evidence_task_id"]), raw_v, "views run view")
    _exclusive_write_bytes(vw_run_dir / "edition-views-accepted.json", core.json_bytes(vw_acc), "views acceptance")
    # FULL validation of the written acceptances via real _content cores.
    from scripts import survey_evidence_v2 as evidence_mod

    expectations = {"issue_id": request["issue_id"], "research_profile": request["research_profile"], "canonical_state_path": before_ref["path"]}
    try:
        evidence_mod._validate_evidence_acceptance_content(repo_root, ev_run_dir / "evidence-accepted.json", expectations, current_ctx["root_records"], current_ctx["root_path"])
    except Exception as exc:
        raise AcceptanceError(f"written evidence acceptance FULL validation failed: {exc}") from exc
    profile_abs_for_views = core.repo_local_path(repo_root, request["profile_ref"]["path"], "profile")
    try:
        evidence_mod._validate_edition_views_acceptance_content(repo_root, profile_abs_for_views, ev_run_dir / "evidence-accepted.json", vw_run_dir / "edition-views-accepted.json", expectations, current_ctx["root_records"], current_ctx["root_path"])
    except Exception as exc:
        raise AcceptanceError(f"written views acceptance FULL validation failed: {exc}") from exc
    # Ledger (REAL basis/rows + REAL row validation).
    ledger_built = low.build_versioned_ledger_from_paths(
        repo_root, core.repo_local_path(repo_root, request["profile_ref"]["path"], "profile"),
        core.repo_local_path(repo_root, request["discovery_ref"]["path"], "discovery"),
        core.repo_local_path(repo_root, request["screening_ref"]["path"], "screening"),
        ev_run_dir / "evidence-accepted.json", vw_run_dir / "edition-views-accepted.json",
        request_path=request_abs, before_copy_path=state_copy,
    )
    ledger = ledger_built["ledger"]
    _exclusive_write_bytes(rev_root / "candidate" / "materiality-ledger.json", core.json_bytes(ledger), "R ledger")
    # Completeness (REAL union + REAL overall_status + REAL closure).
    comp_built = low.build_versioned_completeness_from_paths(
        repo_root, core.repo_local_path(repo_root, request["profile_ref"]["path"], "profile"),
        core.repo_local_path(repo_root, request["discovery_ref"]["path"], "discovery"),
        core.repo_local_path(repo_root, request["screening_ref"]["path"], "screening"),
        ev_run_dir / "evidence-accepted.json", vw_run_dir / "edition-views-accepted.json",
        rev_root / "candidate" / "materiality-ledger.json",
        request_abs, repo_root / old_comp_path_rel,
        before_copy_path=state_copy,
    )
    completeness = comp_built["completeness"]
    _exclusive_write_bytes(rev_root / "candidate" / "profile-completeness.json", core.json_bytes(completeness), "R completeness")
    # Manifest (immutable prepare inventory; FILE SHA is identity, no self digest).
    def _sized(rel: str) -> dict[str, Any]:
        abs_p = repo_root / rel
        raw = _safe_read_bytes(abs_p, f"manifest entry {rel}")
        return {"path": rel, "sha256": hashlib.sha256(raw).hexdigest(), "byte_count": len(raw)}

    # Per-file bindings for every produced task/card/view (code-enforced
    # non-empty: an empty array with existing tasks is a binding gap, refuse).
    # Tasks/cards/views reference the validated accepted-run copies (the exact
    # bytes the content validators checked), sorted for determinism.
    ordered_task_metas = sorted(pkg_payload.get("tasks", []), key=lambda m: Path(m["path"]).name)
    if not ordered_task_metas:
        raise AcceptanceError("revision produced empty task set (refuse empty binding)")
    task_refs = [_sized(f"{rev_rel_str}/candidate/evidence-runs/{ev_acc['result_set_sha256']}/tasks/{Path(m['path']).name}") for m in ordered_task_metas]
    card_refs = [_sized(f"{rev_rel_str}/candidate/evidence-runs/{ev_acc['result_set_sha256']}/results/{Path(m['path']).name}") for m in ordered_task_metas]
    ordered_view_rows = sorted(vw_acc.get("views", []), key=lambda r: r["evidence_task_id"])
    if not ordered_view_rows:
        raise AcceptanceError("revision produced empty view set (refuse empty binding)")
    view_refs = [_sized(f"{rev_rel_str}/candidate/views-runs/{vw_acc['view_set_sha256']}/views/{_ev.view_filename(r['evidence_task_id'])}") for r in ordered_view_rows]

    # Late publication boundary: request file must not have drifted between entry,
    # builder, manifest, and request copy. Re-read actual bytes and compare to
    # originally captured entry bytes (preserved, not current in-memory).
    try:
        late_request_raw = _safe_read_bytes(request_abs, "revision request (late recheck)")
    except Exception as exc:
        raise AcceptanceError(f"late request re-read failed: {exc}") from exc
    if late_request_raw != original_request_raw or hashlib.sha256(late_request_raw).hexdigest() != original_request_sha or len(late_request_raw) != original_request_len:
        raise AcceptanceError("request file bytes changed between entry and manifest (late drift refused)")
    # Re-verify request SizedRef bytes at late boundary (profile/discovery/
    # screening + supplement manifest). Preserves original expected values.
    for _rk in ("profile_ref", "discovery_ref", "screening_ref"):
        try:
            low._sized_ref_shape(request.get(_rk), f"request.{_rk}")
            low._verify_sized_ref_bytes(repo_root, request[_rk], f"request {_rk} (late recheck)")
        except Exception as exc:
            raise AcceptanceError(f"request {_rk} late bytes invalid: {exc}") from exc
    if original_supp_ref is None:
        if request.get("supplement_manifest") is not None:
            raise AcceptanceError("request supplement_manifest changed from null to non-null (late drift refused)")
    else:
        try:
            low._sized_ref_shape(original_supp_ref, "original request.supplement_manifest")
            low._verify_sized_ref_bytes(repo_root, original_supp_ref, "original request supplement_manifest (late recheck)")
        except Exception as exc:
            raise AcceptanceError(f"original request supplement_manifest late bytes invalid: {exc}") from exc
        if request.get("supplement_manifest") != original_supp_ref:
            raise AcceptanceError("request supplement_manifest changed between entry and manifest (late drift refused)")
    manifest = {
        "schema_version": DM022_SCHEMA_VERSION, "issue_id": request["issue_id"],
        "revision_id": revision_id, "revision_root": rev_rel_str,
        "request": _sized(str(request_abs.resolve().relative_to(repo_root.resolve()))),
        "before_state": {"path": live_rel, "sha256": hashlib.sha256(live_raw).hexdigest(), "byte_count": len(live_raw)},
        "before_checkpoint": {
            "evidence": state["checkpoint_provenance"]["evidence"],
            "materiality": state["checkpoint_provenance"]["materiality"],
            "completeness": state["checkpoint_provenance"]["completeness"],
        },
        "profile_ref": request["profile_ref"], "discovery_ref": request["discovery_ref"],
        "screening_ref": request["screening_ref"],
        "retention_snapshots": [
            {k: row[k] for k in ("slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "byte_count", "source_dev", "source_ino", "copy_dev", "copy_ino", "accepted_bound", "gate_bound")}
            for row in slot_rows
        ],
        "candidate_outputs": {
            "package": _sized(f"{rev_rel_str}/candidate/package.json"),
            "tasks": task_refs,
            "cards": card_refs,
            "views": view_refs,
            "evidence_acceptance": _sized(f"{rev_rel_str}/candidate/evidence-runs/{ev_acc['result_set_sha256']}/evidence-accepted.json"),
            "views_acceptance": _sized(f"{rev_rel_str}/candidate/views-runs/{vw_acc['view_set_sha256']}/edition-views-accepted.json"),
            "ledger": _sized(f"{rev_rel_str}/candidate/materiality-ledger.json"),
            "completeness": _sized(f"{rev_rel_str}/candidate/profile-completeness.json"),
            "supplement_manifest": _copy_mod.deepcopy(original_supp_ref),
        },
        "tool_pins": request.get("tool_pins"),
        "work": {"expected_head": head_tree["head"], "expected_tree": head_tree["tree"]},
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "executor": "HIGH prepare_revision",
    }
    # HIGH manifest recheck: candidate_outputs.supplement_manifest must equal the
    # originally captured request value + actual file bytes (not a tautological
    # in-memory assignment). Null enforces no authority downstream (prove checks).
    if manifest["candidate_outputs"].get("supplement_manifest") != original_supp_ref:
        raise AcceptanceError("manifest candidate_outputs.supplement_manifest must equal original request supplement_manifest")
    schema_gate.validate_instance(manifest, repo_root / "schemas/dm022-revision-manifest-v2.schema.json", label="revision manifest")
    manifest_raw = core.json_bytes(manifest)
    _exclusive_write_bytes(rev_root / "revision-manifest.json", manifest_raw, "R manifest")
    _exclusive_write_bytes(rev_root / "request.json", original_request_raw, "R/request.json")
    # Retention inventory carries the FULL row (identical key set to the stored
    # manifest retention_snapshots above) so completion/readiness can exactly
    # bind seven_plan rows to captured bytes AND inodes.
    retention_manifest = {
        "schema_version": DM022_SCHEMA_VERSION, "issue_id": request["issue_id"],
        "revision_id": revision_id,
        "rows": [
            {k: row[k] for k in ("slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "byte_count", "source_dev", "source_ino", "copy_dev", "copy_ino", "accepted_bound", "gate_bound")}
            for row in slot_rows
        ],
    }
    _exclusive_write_bytes(retention_dir / "inventory.json", core.json_bytes(retention_manifest), "R retention inventory")
    return {
        "revision_root": rev_rel_str,
        "manifest_ref": {"path": f"{rev_rel_str}/revision-manifest.json", "sha256": hashlib.sha256(manifest_raw).hexdigest(), "byte_count": len(manifest_raw)},
        "retention": retention_manifest,
        "planned_files": ["request.json", "candidate/*", "revision-manifest.json", "retention/inventory.json"],
    }


def claim_guard(
    repo_root: Path, state_path: Path, rev: str, request_ref: dict, retention_ref: dict,
    planned_checkpoint_bytes: bytes, expected_after_sha: str, executor: dict, work: dict,
) -> dict:
    """Claim the fixed canonical guard (immutable bytes after claim).

    Nonce is deterministic from planned bytes (no urandom, no time-based
    novelty). Refuses if guard already present. Returns {guard, guard_path}.
    """
    repo_root = _norm_path(repo_root, "repo_root")
    state_path = _norm_path(state_path, "state path")
    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
    state_raw = _safe_read_bytes(abs_state, "LIVE state for guard")
    state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE state for guard")
    _, _, source_root = _profile_and_source(repo_root, state)
    guard_abs = low.guard_path_for(source_root)
    if _lstat_single(guard_abs, "guard pre-claim") is not None:
        raise AcceptanceError("DM022_TRANSITION_ACTIVE: guard already present")
    planned_sha = hashlib.sha256(planned_checkpoint_bytes).hexdigest()
    nonce = hashlib.sha256(b"dm022-nonce:" + planned_checkpoint_bytes).hexdigest()[:16]
    if len(nonce) < 16 or not re.fullmatch(r"[0-9a-f]{16,}", nonce):
        raise AcceptanceError("guard nonce derivation failed")
    guard = {
        "schema_version": "1.0", "issue_id": state.get("issue_id"), "revision_id": rev,
        "attempt_nonce": nonce,
        "guard_path": low.DM022_GUARD_REL,
        "planned_checkpoint_ref": {"path": f"{retention_ref.get('revision_root', rev)}/checkpoint.planned.json", "sha256": planned_sha, "byte_count": len(planned_checkpoint_bytes)},
        "before_state_sha256": hashlib.sha256(state_raw).hexdigest(),
        "expected_after_state_sha256": expected_after_sha,
        "work": work, "executor": executor,
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
    }
    _exclusive_write_bytes(guard_abs, core.json_bytes(guard), "guard claim")
    return {"guard": guard, "guard_path": str(guard_abs)}


def _bound_context(repo_root: Path, guard: dict[str, Any]) -> dict[str, Any]:
    """Extract bound adopt context from a guard dict (fail-closed if detached)."""
    for key in ("repo_root", "state_path", "rev_root", "source_root", "planned_bytes", "expected_sha", "retention", "manifest"):
        if key not in guard:
            raise AcceptanceError(f"{key} requires HIGH adopt context; see adopt_revision (no detached misuse)")
    return guard


def write_checkpoint_as_planned(guard: dict) -> dict:
    """Write actual checkpoint as byte-identical copy of planned bytes."""
    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
    if ctx is None:
        raise AcceptanceError("write_checkpoint_as_planned requires HIGH adopt context; see adopt_revision")
    repo_root = _norm_path(ctx["repo_root"], "repo_root")
    rev_root = Path(ctx["rev_root"])
    planned_bytes: bytes = ctx["planned_bytes"]
    planned_sha = hashlib.sha256(planned_bytes).hexdigest()
    checkpoint_rel = f"{ctx['manifest']['revision_root']}/checkpoint/record.json"
    checkpoint_abs = repo_root / checkpoint_rel
    st = _lstat_single(checkpoint_abs, "checkpoint record")
    if st is not None:
        existing = _safe_read_bytes(checkpoint_abs, "checkpoint record")
        if hashlib.sha256(existing).hexdigest() != planned_sha:
            raise AcceptanceError("checkpoint record already exists with different bytes (no overwrite)")
        return {"path": checkpoint_rel, "sha256": planned_sha, "idempotent": True}
    _exclusive_write_bytes(checkpoint_abs, planned_bytes, "checkpoint record")
    if hashlib.sha256(_safe_read_bytes(checkpoint_abs, "checkpoint record")).hexdigest() != planned_sha:
        raise AcceptanceError("checkpoint FILE sha != planned sha (INDETERMINATE, preserve guard)")
    return {"path": checkpoint_rel, "sha256": planned_sha, "idempotent": False}


def replace_state_triplet(guard: dict) -> dict:
    """ONE known-byte State file switch (guard-held, single-writer, inode-pinned)."""
    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
    if ctx is None:
        raise AcceptanceError("replace_state_triplet requires HIGH adopt context; see adopt_revision")
    repo_root = _norm_path(ctx["repo_root"], "repo_root")
    ctx_state_path = _norm_path(ctx["state_path"], "state path")
    abs_state = ctx_state_path if ctx_state_path.is_absolute() else (repo_root / str(ctx_state_path))
    expected_raw: bytes = ctx["expected_raw"]
    expected_sha: str = ctx["expected_sha"]
    before_sha: str = ctx["guard"]["before_state_sha256"]
    nonce: str = ctx["guard"]["attempt_nonce"]
    live_raw = _safe_read_bytes(abs_state, "LIVE recheck before switch")
    if hashlib.sha256(live_raw).hexdigest() == expected_sha:
        return {"switched": False, "already_after": True, "sha256": expected_sha}
    if hashlib.sha256(live_raw).hexdigest() != before_sha:
        raise AcceptanceError("LIVE State is not exactly before-State at switch (INDETERMINATE, preserve guard)")
    live_st_before = _lstat_single(abs_state, "LIVE before switch")
    if live_st_before is None:
        raise AcceptanceError("LIVE State vanished before switch")
    tmp_state = abs_state.with_name(abs_state.name + f".tmp.{nonce}")
    if _lstat_single(tmp_state, "temp expected State") is not None:
        raise AcceptanceError("temp State already exists (no overwrite)")
    _exclusive_write_bytes(tmp_state, expected_raw, "temp expected State")
    live_recheck = _safe_read_bytes(abs_state, "LIVE recheck at replace")
    live_recheck_st = _lstat_single(abs_state, "LIVE recheck stat")
    if hashlib.sha256(live_recheck).hexdigest() != before_sha:
        raise AcceptanceError("LIVE State moved during temp write (INDETERMINATE, preserve temp+guard)")
    if live_recheck_st is None or live_st_before is None or (live_recheck_st.st_dev, live_recheck_st.st_ino) != (live_st_before.st_dev, live_st_before.st_ino):
        raise AcceptanceError("LIVE State inode changed before replace (INDETERMINATE)")
    try:
        os.replace(tmp_state, abs_state)
    except OSError as exc:
        raise AcceptanceError(f"State atomic replace failed (INDETERMINATE): {exc}") from exc
    try:
        dir_fd = os.open(abs_state.parent, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError as exc:
        raise AcceptanceError(f"State dir fsync failed (INDETERMINATE): {exc}") from exc
    after_raw = _safe_read_bytes(abs_state, "LIVE postread")
    if hashlib.sha256(after_raw).hexdigest() != expected_sha:
        raise AcceptanceError("LIVE postread != expected_after (INDETERMINATE, preserve guard)")
    return {"switched": True, "already_after": False, "sha256": expected_sha}


def clear_remaining_exact_slots(guard: dict) -> dict:
    """Checked clearing of remaining exact old slots (guard-held only)."""
    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
    if ctx is None:
        raise AcceptanceError("clear_remaining_exact_slots requires HIGH adopt context; see adopt_revision")
    repo_root = _norm_path(ctx["repo_root"], "repo_root")
    source_root = Path(ctx["source_root"])
    retention = ctx["retention"]
    cleared: list[dict[str, Any]] = []
    for row in retention.get("rows", []):
        slot = row["slot"]
        slot_abs = source_root / slot
        st = _lstat_single(slot_abs, f"slot {slot} pre-clear")
        if st is None:
            # Missing at clear time: if retained present, the slot was removed
            # outside the single-writer window (operator recovery after a
            # foreign plant was refused); record cleared with the captured
            # SHAs preserved (F12 missing-cleared). If never present, record
            # absent_legitimate with null SHAs. Either way the end state
            # (absent) plus captured identity is attested, never a bare flag.
            if row.get("present"):
                cleared.append({"slot": slot, "disposition": "cleared", "captured_sha": row.get("source_sha256"), "copy_sha": row.get("copy_sha256")})
            else:
                cleared.append({"slot": slot, "disposition": "absent_legitimate", "captured_sha": None, "copy_sha": None})
            continue
        _require_regular(st, slot_abs, f"slot {slot} pre-clear")
        cur = _safe_read_bytes(slot_abs, f"slot {slot} pre-clear")
        cur_st = _lstat_single(slot_abs, f"slot {slot} stat")
        if row.get("present"):
            if hashlib.sha256(cur).hexdigest() != row.get("source_sha256"):
                raise AcceptanceError(f"slot {slot} changed since capture (foreign/replaced; refuse)")
            if cur_st is not None and row.get("source_ino") is not None and (cur_st.st_dev, cur_st.st_ino) != (row.get("source_dev"), row.get("source_ino")):
                raise AcceptanceError(f"slot {slot} inode changed since capture (foreign file with same bytes; refuse)")
            copy_abs = repo_root / row["copy_rel"]
            copy_raw = _safe_read_bytes(copy_abs, f"COPY {slot}")
            if hashlib.sha256(copy_raw).hexdigest() != row.get("copy_sha256"):
                raise AcceptanceError(f"COPY drift for slot {slot}")
        else:
            raise AcceptanceError(f"slot {slot} present but retention planned absent (foreign planted; no unowned unlink)")
        try:
            os.unlink(slot_abs)
        except OSError as exc:
            raise AcceptanceError(f"slot {slot} unlink failed: {exc}") from exc
        try:
            dir_fd = os.open(slot_abs.parent, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError as exc:
            raise AcceptanceError(f"slot {slot} dir fsync failed: {exc}") from exc
        if _lstat_single(slot_abs, f"slot {slot} post-clear") is not None:
            raise AcceptanceError(f"slot {slot} still present after unlink")
        cleared.append({"slot": slot, "disposition": "cleared", "captured_sha": row.get("source_sha256"), "copy_sha": row.get("copy_sha256")})
    return {"seven_plan": cleared}


def write_cleanup_completion(guard: dict) -> dict:
    """Write owned completion receipt (owned R, not canonical) after verification."""
    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
    if ctx is None:
        raise AcceptanceError("write_cleanup_completion requires HIGH adopt context; see adopt_revision")
    repo_root = _norm_path(ctx["repo_root"], "repo_root")
    rev_root = Path(ctx["rev_root"])
    manifest = ctx["manifest"]
    seven_plan = ctx.get("seven_plan") or []
    expected_sha = ctx["expected_sha"]
    guard_doc = ctx["guard"]
    checkpoint_rel = f"{manifest['revision_root']}/checkpoint/record.json"
    checkpoint_abs = repo_root / checkpoint_rel
    checkpoint_raw = _safe_read_bytes(checkpoint_abs, "checkpoint record")
    checkpoint_sha = hashlib.sha256(checkpoint_raw).hexdigest()
    # COPY-derived expected_after cross-binding (recompute, no trusted booleans).
    copy_abs = rev_root / "retention" / "state-before.json"
    copy_raw = _safe_read_bytes(copy_abs, "retained COPY")
    expected_recomputed = _expected_state_bytes(copy_raw, {"path": checkpoint_rel, "sha256": checkpoint_sha})
    if hashlib.sha256(expected_recomputed).hexdigest() != expected_sha:
        raise AcceptanceError("completion expected_after does not match COPY-derived recomputation (no trusted booleans)")
    # Postread: LIVE must equal expected_after + triplet same-record + FULL
    # adopted-graph validation (recomputes triplet_match/artifacts_rehashed
    # instead of trusting booleans; forward lifecycle tolerated).
    ctx_state_path = _norm_path(ctx["state_path"], "state path")
    abs_state = ctx_state_path if ctx_state_path.is_absolute() else (repo_root / str(ctx_state_path))
    after_raw = _safe_read_bytes(abs_state, "LIVE postread for completion")
    if hashlib.sha256(after_raw).hexdigest() != expected_sha:
        raise AcceptanceError("LIVE postread != expected_after at completion (INDETERMINATE)")
    after_state = schema_gate.parse_json_strict_bytes(after_raw, "LIVE postread")
    structural = low._resolve_research_from_state_bytes(repo_root, after_state)
    low.require_same_triplet(after_state, structural)
    if structural.get("checkpoint_path") != checkpoint_rel or structural.get("checkpoint_sha256") != checkpoint_sha:
        raise AcceptanceError("LIVE postread triplet does not reference this completion checkpoint")
    try:
        rel_cp = str(checkpoint_abs.resolve().relative_to(repo_root.resolve()))
    except ValueError:
        rel_cp = checkpoint_rel
    try:
        low._verify_adopted_graph_full(repo_root, rel_cp, checkpoint_sha)
    except Exception as exc:
        raise AcceptanceError(f"postread FULL adopted-graph validation failed (INDETERMINATE): {exc}") from exc
    completion = {
        "schema_version": "1.0", "issue_id": manifest["issue_id"], "revision_id": manifest["revision_id"],
        "attempt_nonce": guard_doc["attempt_nonce"],
        "checkpoint": {"path": checkpoint_rel, "sha256": checkpoint_sha, "byte_count": len(checkpoint_raw)},
        "expected_after_state": {"path": manifest["before_state"]["path"], "sha256": expected_sha, "byte_count": len(expected_recomputed)},
        "seven_plan": seven_plan,
        "postread": {"state_sha": expected_sha, "triplet_match": True, "artifacts_rehashed": True},
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "executor": "HIGH adopt_revision",
    }
    completion_abs = rev_root / "completion" / "cleanup-completion.json"
    if _lstat_single(completion_abs, "completion") is not None:
        # Immutable completion timestamp: an existing receipt is revalidated
        # for EXACT intent reuse (semantic equality excluding recorded_at) and
        # reused WITHOUT rewrite — never regenerate fresh bytes over it.
        existing_raw = _safe_read_bytes(completion_abs, "completion")
        try:
            existing = schema_gate.parse_json_strict_bytes(existing_raw, "completion")
        except Exception as exc:
            raise AcceptanceError(f"existing completion unparseable (no overwrite): {exc}") from exc
        if {k: v for k, v in existing.items() if k != "recorded_at"} != {k: v for k, v in completion.items() if k != "recorded_at"}:
            raise AcceptanceError("completion already exists with different intent (no overwrite)")
        return {"path": str(completion_abs), "idempotent": True}
    _exclusive_write_bytes(completion_abs, core.json_bytes(completion), "R completion")
    return {"path": str(completion_abs), "idempotent": False}


def release_guard(guard: dict) -> dict:
    """Release OWN guard (held-by-self verified) + verify absent."""
    ctx = _bound_context(Path(guard["repo_root"]), guard) if "repo_root" in guard else None
    if ctx is None:
        raise AcceptanceError("release_guard requires HIGH adopt context; see adopt_revision")
    repo_root = _norm_path(ctx["repo_root"], "repo_root")
    source_root = Path(ctx["source_root"])
    guard_doc = ctx["guard"]
    guard_abs = low.guard_path_for(source_root)
    st = _lstat_single(guard_abs, "guard at release")
    if st is None:
        raise AcceptanceError("guard absent at release (lost-guard window; INDETERMINATE, writers must still require completion; do NOT silently proceed)")
    guard_cur = _safe_read_bytes(guard_abs, "guard at release")
    if guard_cur != core.json_bytes(guard_doc):
        raise AcceptanceError("guard changed before release (foreign/mismatched; refuse, no takeover/delete)")
    try:
        os.unlink(guard_abs)
    except OSError as exc:
        raise AcceptanceError(f"guard release unlink failed: {exc}") from exc
    try:
        dir_fd = os.open(guard_abs.parent, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError as exc:
        raise AcceptanceError(f"guard dir fsync failed: {exc}") from exc
    if _lstat_single(guard_abs, "guard post-release") is not None:
        raise AcceptanceError("guard still present after release")
    return {"released": True}


def _expected_state_bytes(live_raw: bytes, checkpoint_ref: dict[str, str]) -> bytes:
    live = json.loads(live_raw.decode("utf-8"))
    live = dict(live)
    prov = dict(live.get("checkpoint_provenance", {}))
    for key in ("evidence", "materiality", "completeness"):
        prov[key] = dict(checkpoint_ref)
    live["checkpoint_provenance"] = prov
    return core.json_bytes(live)


def adopt_revision(repo_root: Path, state_path: Path, revision_path: Path, decision_path: Path) -> dict:
    """Validate decision + seal + guard + record + switch + clear + verify.

    Destructive order: pin basis -> reverify retention -> claim+revalidate
    guard -> deterministic proof -> pre-adoption report -> planned checkpoint
    -> State switch -> checked clearing -> postread -> completion -> release.
    Unknown LIVE is never rewritten; failures preserve records/bytes/guard
    with explicit INDETERMINATE posture (no automatic rollback). Original
    anchor is preserved on repeat (previous PREARCH original_anchor carried;
    first correction anchors to before evidence).
    """
    repo_root = _norm_path(repo_root, "repo_root")
    state_path = _norm_path(state_path, "state path")
    revision_path = _norm_path(revision_path, "revision path")
    decision_path = _norm_path(decision_path, "decision path")
    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
    rev_abs = revision_path if revision_path.is_absolute() else (repo_root / str(revision_path))
    dec_abs = decision_path if decision_path.is_absolute() else (repo_root / str(decision_path))
    state_raw = _safe_read_bytes(abs_state, "LIVE state at adopt")
    try:
        state = schema_gate.parse_json_strict_bytes(state_raw, "LIVE state at adopt")
    except Exception as exc:
        raise AcceptanceError(f"LIVE State strict parse failed: {exc}") from exc
    cfg = core.load_json(repo_root / str(core.DEFAULT_CONFIG))
    eligibility = verify_live_eligibility(repo_root, cfg, state)
    if eligibility:
        raise AcceptanceError("LIVE eligibility refused at adopt: " + "; ".join(eligibility))
    _, profile, source_root = _profile_and_source(repo_root, state)
    manifest_raw = _safe_read_bytes(rev_abs / "revision-manifest.json", "revision manifest")
    manifest = schema_gate.parse_json_strict_bytes(manifest_raw, "revision manifest")
    schema_gate.validate_instance(manifest, repo_root / "schemas/dm022-revision-manifest-v2.schema.json", label="revision manifest")
    # HEAD/tree/contract/tool recheck (no stale pins, no silent overwrite).
    head_tree_now = _current_head_tree(repo_root)
    if head_tree_now["head"] != manifest["work"]["expected_head"] or head_tree_now["tree"] != manifest["work"]["expected_tree"]:
        raise AcceptanceError("LIVE HEAD/tree moved since prepare (stale pins; NEW bounded attempt required, no silent expected_head overwrite)")
    live_contract_now, live_tools_now = _contract_and_tools(repo_root, cfg, state)
    if (manifest.get("tool_pins") or {}).get("contract") != live_contract_now:
        raise AcceptanceError("contract drift since prepare (refuse; NEW attempt required)")
    manifest_tools = {e.get("path"): e.get("sha256") for e in (manifest.get("tool_pins") or {}).get("tool_shas", []) or []}
    if manifest_tools != {e["path"]: e["sha256"] for e in live_tools_now}:
        raise AcceptanceError("tool SHAs drift since prepare (refuse; NEW attempt required)")
    if hashlib.sha256(state_raw).hexdigest() != manifest["before_state"]["sha256"]:
        raise AcceptanceError("LIVE State is not exactly before-State at adopt (stale/advanced)")
    retention_raw = _safe_read_bytes(rev_abs / "retention" / "inventory.json", "retention inventory")
    retention = schema_gate.parse_json_strict_bytes(retention_raw, "retention inventory")
    # Exact bind: retention inventory rows must equal the stored manifest
    # retention_snapshots per slot (identical key sets incl. inodes/byte_count).
    man_snapshots = {r.get("slot"): r for r in manifest.get("retention_snapshots", []) if isinstance(r, dict)}
    if set(man_snapshots) != set(low.SEVEN_SLOTS):
        raise AcceptanceError("stored manifest retention_snapshots must cover exactly the 7 slots")
    for row in retention.get("rows", []):
        other = man_snapshots.get(row.get("slot"))
        if not isinstance(other, dict) or row != other:
            raise AcceptanceError(f"retention inventory row != stored manifest snapshot for slot: {row.get('slot')}")
    for row in retention.get("rows", []):
        if row.get("present"):
            slot_abs = source_root / row["slot"]
            cur = _safe_read_bytes(slot_abs, f"retained slot {row['slot']}")
            if hashlib.sha256(cur).hexdigest() != row.get("copy_sha256") and hashlib.sha256(cur).hexdigest() != row.get("source_sha256"):
                raise AcceptanceError(f"retention drift for slot {row['slot']}")
    # Re-verify the no-prior-Human-review entry window at adopt time (a review
    # recorded between prepare and adopt refuses adoption before any
    # guard/checkpoint/State mutation or R proof/report writes).
    _prove_before_graph_unbound(repo_root, cfg, state, source_root, state.get("issue_id", ""))
    # Profile/support P1-P4 adopt re-verification: current PATH loader +
    # source classification (all R/E rows incl DROP) + per-(parent,OID) loss
    # gate on the DM022 seven-field request (never ordinary 3/5), before ANY
    # guard claim and before the proof write below. LIVE still equals
    # before-State here (checked above), so the current loader binds.
    from scripts import survey_evidence_v2 as _adopt_evidence_mod
    from scripts import survey_screening_v2 as _adopt_screening_mod

    _adopt_req_abs = core.repo_local_path(repo_root, manifest["request"]["path"], "manifest request")
    try:
        _adopt_ctx = low.derive_current_root_effective_context(repo_root, _adopt_req_abs, abs_state)
    except Exception as exc:
        raise AcceptanceError(f"HIGH adopt current root/effective context refused: {exc}") from exc
    try:
        for _rec in list(_adopt_ctx.get("root_records", [])) + list(_adopt_ctx.get("effective_records", [])):
            if not isinstance(_rec, dict):
                raise AcceptanceError("adopt Discovery record must be an object")
            _adopt_source = _rec.get("source")
            if not isinstance(_adopt_source, dict):
                raise AcceptanceError(f"adopt Discovery record lacks source: {_rec.get('discovery_id')!r}")
            _adopt_evidence_mod._source_class(_adopt_source.get("source_type"))
    except AcceptanceError:
        raise
    except Exception as exc:
        raise AcceptanceError(f"HIGH adopt source classification refused: {exc}") from exc
    try:
        _adopt_uncovered = _adopt_screening_mod.find_declaration_loss(_adopt_ctx.get("root_records", []), _adopt_ctx.get("effective_records", []))
    except Exception as exc:
        raise AcceptanceError(f"HIGH adopt declaration-loss check failed: {exc}") from exc
    if _adopt_uncovered:
        raise AcceptanceError(
            "HIGH adopt DECLARATION_LOSS refused: "
            f"uncovered={sorted(_adopt_uncovered)[:8]}"
        )
    dec_raw = _safe_read_bytes(dec_abs, "supplied decision")
    try:
        decision = schema_gate.parse_json_strict_bytes(dec_raw, "supplied decision")
    except Exception as exc:
        raise AcceptanceError(f"decision strict parse failed: {exc}") from exc
    if decision.get("revision_id") != manifest.get("revision_id"):
        raise AcceptanceError("decision revision_id does not match manifest")
    man_sha = hashlib.sha256(manifest_raw).hexdigest()
    if decision.get("manifest_ref", {}).get("sha256") != man_sha:
        raise AcceptanceError("decision manifest_ref does not bind manifest FILE sha")
    if decision.get("before_state", {}).get("sha256") != manifest["before_state"]["sha256"]:
        raise AcceptanceError("decision before_state does not match manifest")
    proved = low.prove_revision_from_paths(repo_root, rev_abs / "revision-manifest.json", dec_abs, rev_abs / "retention" / "state-before.json")
    proof = proved["proof"]
    _exclusive_write_bytes(rev_abs / "proof" / "proposed-graph-proof.json", core.json_bytes(proof), "R proof")
    # Pre-adoption report (NO checkpoint/afterState/guard refs).
    try:
        dec_rel = str(dec_abs.resolve().relative_to(repo_root.resolve()))
    except ValueError:
        dec_rel = str(dec_abs)
    rev_rel = manifest["revision_root"]
    _proof_bytes = core.json_bytes(proof)
    report_body = {
        "schema_version": DM022_SCHEMA_VERSION, "issue_id": manifest["issue_id"],
        "revision_id": manifest["revision_id"], "revision_root": rev_rel,
        "request": manifest["request"],
        "manifest": {"path": f"{rev_rel}/revision-manifest.json", "sha256": man_sha, "byte_count": len(manifest_raw)},
        "proof": {"path": f"{rev_rel}/proof/proposed-graph-proof.json", "sha256": hashlib.sha256(_proof_bytes).hexdigest(), "byte_count": len(_proof_bytes)},
        "decision": {"path": dec_rel, "sha256": hashlib.sha256(dec_raw).hexdigest(), "byte_count": len(dec_raw)},
        "before_state": manifest["before_state"], "before_checkpoint": manifest["before_checkpoint"],
        "proposed_artifacts": {
            "evidence_acceptance": manifest["candidate_outputs"]["evidence_acceptance"],
            "views_acceptance": manifest["candidate_outputs"]["views_acceptance"],
            "ledger": manifest["candidate_outputs"]["ledger"],
            "completeness": manifest["candidate_outputs"]["completeness"],
        },
        "operation": {"from_state": "EVIDENCE_REVIEWED", "to_state": "EVIDENCE_REVIEWED"},
        "producer_boundary": {"from_state": "CANDIDATES_NORMALIZED", "to_state": "EVIDENCE_REVIEWED"},
        "affected_ids": decision.get("affected_ids", []),
        "mechanical_projections": proof.get("unaffected_comparison", {}).get("mechanical_projections", []),
        "tool_pins": manifest.get("tool_pins"),
        "work_ref": {"repository_commit_sha": manifest["work"]["expected_head"], "tree_sha": manifest["work"]["expected_tree"], "contract": manifest["tool_pins"]["contract"]},
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "executor": "HIGH adopt_revision",
    }
    report_noself = dict(report_body)
    report_body["preadoption_report_sha256"] = core.sha256_object(report_noself)
    schema_gate.validate_instance(report_body, repo_root / "schemas/dm022-preadoption-report-v2.schema.json", label="pre-adoption report")
    _exclusive_write_bytes(rev_abs / "proof" / "supersession-report.json", core.json_bytes(report_body), "R report")
    # Lineage: preserve original_anchor on repeat (previous PREARCH), else anchor
    # to before evidence. Parent is previous record; supersedes appends previous.
    before_ev = manifest["before_checkpoint"]["evidence"]
    prev_abs_lineage = core.repo_local_path(repo_root, before_ev["path"], "previous checkpoint")
    prev_typed_lineage = low.load_typed_checkpoint_record(repo_root, prev_abs_lineage)
    prev_rec_lineage = prev_typed_lineage["record"]
    if prev_typed_lineage["family"] == "PREARCH":
        parent_ref = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
        original_anchor = prev_rec_lineage.get("original_anchor")
        prev_sup = prev_rec_lineage.get("supersedes", []) or []
        supersedes = list(prev_sup) + [{"path": before_ev["path"], "sha256": before_ev["sha256"], "revision_id": prev_rec_lineage.get("revision_id")}]
    else:
        parent_ref = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
        original_anchor = {"path": before_ev["path"], "sha256": before_ev["sha256"]}
        supersedes = []
    checkpoint_body = {
        "schema_version": DM022_SCHEMA_VERSION, "kind": low.DM022_KIND,
        "reason": low.DM022_REASON, "issue_id": manifest["issue_id"],
        "operation": {"from_state": "EVIDENCE_REVIEWED", "to_state": "EVIDENCE_REVIEWED"},
        "producer_boundary": {"from_state": "CANDIDATES_NORMALIZED", "to_state": "EVIDENCE_REVIEWED"},
        "checkpoints": ["evidence", "materiality", "completeness"],
        "artifacts": [
            {"name": "evidence-acceptance", "path": manifest["candidate_outputs"]["evidence_acceptance"]["path"], "sha256": manifest["candidate_outputs"]["evidence_acceptance"]["sha256"]},
            {"name": "edition-views-acceptance", "path": manifest["candidate_outputs"]["views_acceptance"]["path"], "sha256": manifest["candidate_outputs"]["views_acceptance"]["sha256"]},
            {"name": "materiality-ledger", "path": manifest["candidate_outputs"]["ledger"]["path"], "sha256": manifest["candidate_outputs"]["ledger"]["sha256"]},
            {"name": "profile-completeness", "path": manifest["candidate_outputs"]["completeness"]["path"], "sha256": manifest["candidate_outputs"]["completeness"]["sha256"]},
        ],
        "before_state": manifest["before_state"], "before_checkpoint": manifest["before_checkpoint"],
        "parent_checkpoint": parent_ref,
        "original_anchor": original_anchor,
        "supersedes": supersedes, "revision_id": manifest["revision_id"], "revision_root": rev_rel,
        "request": manifest["request"],
        "retention_plan": {"path": f"{rev_rel}/retention/inventory.json", "sha256": hashlib.sha256(retention_raw).hexdigest(), "byte_count": len(retention_raw)},
        "proof": report_body["proof"], "decision": report_body["decision"],
        "report": {"path": f"{rev_rel}/proof/supersession-report.json", "sha256": hashlib.sha256(core.json_bytes(report_body)).hexdigest(), "byte_count": len(core.json_bytes(report_body))},
        "contract": manifest["tool_pins"]["contract"],
        "implementation": {"repository_commit_sha": manifest["work"]["expected_head"], "orchestrator_version": manifest["tool_pins"]["orchestrator_version"]},
        "profile": {"path": manifest["profile_ref"]["path"], "sha256": manifest["profile_ref"]["sha256"]},
        "executor": "HIGH adopt_revision",
        "recorded_at": report_body["recorded_at"],
        "reviews": [{"check_id": low.DM022_PROOF_CHECK_ID, "kind": "DETERMINISTIC", "status": "PASS", "executor": "HIGH adopt_revision", "evidence": f"{rev_rel}/proof/proposed-graph-proof.json", "result": report_body["proof"]}],
        "summary": "DM022 same-State accepted-upstream supersession (EVIDENCE_REVIEWED->EVIDENCE_REVIEWED)",
    }
    cp_noself = {k: v for k, v in checkpoint_body.items() if k != "supersession_checkpoint_sha256"}
    checkpoint_body["supersession_checkpoint_sha256"] = core.sha256_object(cp_noself)
    schema_gate.validate_instance(checkpoint_body, repo_root / "schemas/dm022-supersession-checkpoint-v2.schema.json", label="supersession checkpoint")
    planned_bytes = core.json_bytes(checkpoint_body)
    planned_sha = hashlib.sha256(planned_bytes).hexdigest()
    expected_raw = _expected_state_bytes(state_raw, {"path": f"{rev_rel}/checkpoint/record.json", "sha256": planned_sha})
    expected_sha = hashlib.sha256(expected_raw).hexdigest()
    head_tree = {"head": manifest["work"]["expected_head"], "tree": manifest["work"]["expected_tree"]}
    nonce = hashlib.sha256(b"dm022-nonce:" + planned_bytes).hexdigest()[:16]
    guard_doc = {
        "schema_version": "1.0", "issue_id": manifest["issue_id"], "revision_id": manifest["revision_id"],
        "attempt_nonce": nonce, "guard_path": low.DM022_GUARD_REL,
        "planned_checkpoint_ref": {"path": f"{rev_rel}/checkpoint.planned.json", "sha256": planned_sha, "byte_count": len(planned_bytes)},
        "before_state_sha256": hashlib.sha256(state_raw).hexdigest(),
        "expected_after_state_sha256": expected_sha,
        "work": head_tree, "executor": {"actor": "HIGH adopt_revision"},
        "recorded_at": report_body["recorded_at"],
    }
    guard_abs = low.guard_path_for(source_root)
    if _lstat_single(guard_abs, "guard pre-claim") is not None:
        raise AcceptanceError("DM022_TRANSITION_ACTIVE: guard already present at adopt")
    _exclusive_write_bytes(guard_abs, core.json_bytes(guard_doc), "guard claim")
    _exclusive_write_bytes(rev_abs / "checkpoint.planned.json", planned_bytes, "R planned checkpoint")
    _exclusive_write_bytes(rev_abs / "checkpoint.planned.sha256", (planned_sha + "\n").encode(), "R planned sha")
    bound = {
        "repo_root": str(repo_root), "state_path": str(abs_state), "rev_root": str(rev_abs),
        "source_root": str(source_root), "planned_bytes": planned_bytes, "expected_raw": expected_raw,
        "expected_sha": expected_sha, "retention": retention, "manifest": manifest, "guard": guard_doc,
    }
    write_checkpoint_as_planned(bound)
    replace_state_triplet(bound)
    cleared = clear_remaining_exact_slots(bound)
    bound["seven_plan"] = cleared["seven_plan"]
    write_cleanup_completion(bound)
    release_guard(bound)
    return {
        "status": "ADOPTED",
        "revision_id": manifest["revision_id"],
        "checkpoint_ref": {"path": f"{rev_rel}/checkpoint/record.json", "sha256": planned_sha},
        "expected_after_state_sha256": expected_sha,
        "seven_plan": cleared["seven_plan"],
        "guard_released": True,
    }


def _classify_live(repo_root: Path, abs_state: Path, before_sha: str, expected_sha: str) -> tuple[str, bytes, str]:
    try:
        live_raw = _safe_read_bytes(abs_state, "LIVE at resume")
    except AcceptanceError as exc:
        raise AcceptanceError(f"INDETERMINATE: LIVE unreadable at resume: {exc}") from exc
    live_sha = hashlib.sha256(live_raw).hexdigest()
    if live_sha == before_sha:
        return "B", live_raw, live_sha
    if live_sha == expected_sha:
        return "E", live_raw, live_sha
    return "UNKNOWN", live_raw, live_sha


def resume_bound_attempt(repo_root: Path, state_path: Path, revision_path: Path) -> dict:
    """Explicit resume with BOUNDED remaining execution (no blind takeover).

    Known old/new/unknown/nonce-bound context from the retained guard +
    retention + planned bytes. Executes the remaining state/slot/completion
    steps (not advice): S==B performs switch+clear+completion+release; S==E
    clears remaining exact old slots + completion + release; S==E + completion
    + guard absent reports ALREADY_ACTIVE (no writes); otherwise INDETERMINATE
    (preserve, no automatic restoration/deletion).
    """
    repo_root = _norm_path(repo_root, "repo_root")
    state_path = _norm_path(state_path, "state path")
    revision_path = _norm_path(revision_path, "revision path")
    abs_state = state_path if state_path.is_absolute() else (repo_root / str(state_path))
    rev_abs = revision_path if revision_path.is_absolute() else (repo_root / str(revision_path))
    manifest = schema_gate.parse_json_strict_bytes(_safe_read_bytes(rev_abs / "revision-manifest.json", "manifest"), "manifest")
    before_sha = manifest["before_state"]["sha256"]
    # Planned expected_after: recompute from retained planned bytes or checkpoint.
    planned_candidates = [rev_abs / "checkpoint.planned.json", rev_abs / "checkpoint" / "record.json"]
    planned_raw = None
    for cand in planned_candidates:
        if _lstat_single(cand, "planned candidate") is not None:
            planned_raw = _safe_read_bytes(cand, "planned candidate")
            break
    if planned_raw is None:
        return {"status": "INDETERMINATE", "reason": "no planned/record bytes; preserve guard+retention; manual resolution required"}
    planned_sha = hashlib.sha256(planned_raw).hexdigest()
    copy_raw = _safe_read_bytes(rev_abs / "retention" / "state-before.json", "retained COPY")
    rev_rel = manifest["revision_root"]
    # Checkpoint rel for expected State: prefer actual record path if present.
    checkpoint_rel = f"{rev_rel}/checkpoint/record.json"
    expected_raw = _expected_state_bytes(copy_raw, {"path": checkpoint_rel, "sha256": planned_sha})
    expected_sha = hashlib.sha256(expected_raw).hexdigest()
    try:
        disposition, live_raw, live_sha = _classify_live(repo_root, abs_state, before_sha, expected_sha)
    except AcceptanceError as exc:
        return {"status": "INDETERMINATE", "reason": f"LIVE state unreadable at resume; preserve records/bytes/guard: {exc}", "live_sha256": None}
    if disposition == "UNKNOWN":
        return {"status": "INDETERMINATE", "reason": "State neither before nor expected-after; preserve records/bytes/guard; no automatic restoration", "live_sha256": live_sha}
    # Guard context (nonce-bound): load guard if present, verify intent.
    try:
        _, _, source_root = _profile_and_source(repo_root, schema_gate.parse_json_strict_bytes(live_raw, "LIVE at resume"))
    except AcceptanceError as exc:
        return {"status": "INDETERMINATE", "reason": f"LIVE state unloadable at resume; preserve records/bytes/guard: {exc}", "live_sha256": live_sha}
    guard_abs = low.guard_path_for(source_root)
    guard_st = _lstat_single(guard_abs, "guard at resume")
    if disposition == "B":
        if guard_st is None:
            return {"status": "INDETERMINATE", "reason": "State still before but guard absent (lost-guard window before switch); preserve retention; NEW bounded attempt or manual resolution required", "expected_after_state_sha256": expected_sha}
        guard_doc = schema_gate.parse_json_strict_bytes(_safe_read_bytes(guard_abs, "guard at resume"), "guard")
        if guard_doc.get("planned_checkpoint_ref", {}).get("sha256") != planned_sha:
            return {"status": "INDETERMINATE", "reason": "guard planned sha does not match retained intent; preserve; no takeover", "live_sha256": live_sha}
        if guard_doc.get("before_state_sha256") != before_sha or guard_doc.get("expected_after_state_sha256") != expected_sha:
            return {"status": "INDETERMINATE", "reason": "guard before/expected shas do not match retained intent; preserve; no takeover", "live_sha256": live_sha}
        # Execute remaining: ensure checkpoint present, switch, clear, complete, release.
        retention = schema_gate.parse_json_strict_bytes(_safe_read_bytes(rev_abs / "retention" / "inventory.json", "retention"), "retention")
        man_snapshots = {r.get("slot"): r for r in manifest.get("retention_snapshots", []) if isinstance(r, dict)}
        for row in retention.get("rows", []):
            other = man_snapshots.get(row.get("slot"))
            if not isinstance(other, dict) or row != other:
                return {"status": "INDETERMINATE", "reason": f"retention inventory row != stored manifest snapshot for slot: {row.get('slot')}; preserve; manual resolution required", "live_sha256": live_sha}
        bound = {"repo_root": str(repo_root), "state_path": str(abs_state), "rev_root": str(rev_abs), "source_root": str(source_root), "planned_bytes": planned_raw, "expected_raw": expected_raw, "expected_sha": expected_sha, "retention": retention, "manifest": manifest, "guard": guard_doc}
        write_checkpoint_as_planned(bound)
        replace_state_triplet(bound)
        cleared = clear_remaining_exact_slots(bound)
        bound["seven_plan"] = cleared["seven_plan"]
        write_cleanup_completion(bound)
        release_guard(bound)
        return {"status": "RESUME_ADOPTED", "reason": "State was before; executed switch+clear+completion+release under bound guard", "expected_after_state_sha256": expected_sha}
    # disposition == E
    if guard_st is None:
        # Guard absent after switch: require completion for ALREADY_ACTIVE.
        try:
            low.require_completion_consistent(source_root, {"path": checkpoint_rel, "sha256": planned_sha})
        except Exception as exc:
            return {"status": "INDETERMINATE", "reason": f"State already after but guard absent and completion unverifiable (lost-guard window): {exc}; preserve; manual resolution required", "expected_after_state_sha256": expected_sha}
        return {"status": "ALREADY_ACTIVE", "reason": "State already after with guard absent + completion verified; no new acceptance or approval", "expected_after_state_sha256": expected_sha}
    guard_doc = schema_gate.parse_json_strict_bytes(_safe_read_bytes(guard_abs, "guard"), "guard")
    if guard_doc.get("planned_checkpoint_ref", {}).get("sha256") != planned_sha:
        return {"status": "INDETERMINATE", "reason": "guard planned sha does not match retained intent; preserve; no takeover", "live_sha256": live_sha}
    retention = schema_gate.parse_json_strict_bytes(_safe_read_bytes(rev_abs / "retention" / "inventory.json", "retention"), "retention")
    man_snapshots_e = {r.get("slot"): r for r in manifest.get("retention_snapshots", []) if isinstance(r, dict)}
    for row in retention.get("rows", []):
        other = man_snapshots_e.get(row.get("slot"))
        if not isinstance(other, dict) or row != other:
            return {"status": "INDETERMINATE", "reason": f"retention inventory row != stored manifest snapshot for slot: {row.get('slot')}; preserve; manual resolution required", "live_sha256": live_sha}
    bound = {"repo_root": str(repo_root), "state_path": str(abs_state), "rev_root": str(rev_abs), "source_root": str(source_root), "planned_bytes": planned_raw, "expected_raw": expected_raw, "expected_sha": expected_sha, "retention": retention, "manifest": manifest, "guard": guard_doc}
    # Ensure checkpoint present (idempotent), then clear remaining + complete + release.
    write_checkpoint_as_planned(bound)
    cleared = clear_remaining_exact_slots(bound)
    bound["seven_plan"] = cleared["seven_plan"]
    write_cleanup_completion(bound)
    release_guard(bound)
    return {"status": "RESUME_CLEARED", "reason": "State already after; removed remaining exact old slots + completion + release under bound guard", "expected_after_state_sha256": expected_sha}


def resume_revision(repo_root: Path, state_path: Path, revision_path: Path) -> dict:
    """Resume dispatcher (same explicit algorithm as resume_bound_attempt)."""
    return resume_bound_attempt(repo_root, state_path, revision_path)


def readback_revision(repo_root: Path, state_path: Path, revision_path: Path | None = None) -> dict:
    """Truthful same-State readback + separate producer boundary.

    Reports the adopted operation (triplet same-record, lineage, retained
    context, completion) WITHOUT claiming publication activation. The separate
    artifact-producer boundary (Matrix/Selection/Architecture regeneration)
    is reported as a distinct section, never merged. Works after forward
    progress (no LIVE EVIDENCE_REVIEWED window re-imposed; genuine-typed public
    advance reads the adopted record via retained lineage, not a LIVE creation
    window).
    """
    repo_root = _norm_path(repo_root, "repo_root")
    state_path = _norm_path(state_path, "state path")
    resolved = low.resolve_research_authority(repo_root, state_path)
    out: dict[str, Any] = {
        "research_acceptance": {
            "family": resolved["family"],
            "checkpoint_path": (resolved["lineage"] or {}).get("checkpoint_path"),
            "triplet": (resolved["lineage"] or {}).get("triplet", False),
            "lineage": resolved.get("lineage", {}),
        },
        "artifact_producer_boundary": {
            "note": "Matrix/Selection/Architecture regeneration is a separate normal-producer operation; readback here reports research authority only, not regenerated outputs.",
            "regenerated": None,
        },
    }
    if revision_path is not None:
        revision_path = _norm_path(revision_path, "revision path")
        rev_abs = revision_path if revision_path.is_absolute() else (repo_root / str(revision_path))
        st = _lstat_single(rev_abs / "completion" / "cleanup-completion.json", "completion at readback")
        out["research_acceptance"]["completion_present"] = st is not None
    return out


def main(argv: list[str] | None = None) -> int:
    """Actual CLI with four operations: prepare/adopt/resume/readback."""
    parser = argparse.ArgumentParser(prog="survey_prearchitecture_acceptance_v2", description="DM022 pre-Architecture acceptance operation (HIGH, sole mutator).")
    sub = parser.add_subparsers(dest="op", required=True)
    p = sub.add_parser("prepare", help="Pin basis + immutable R snapshots + truthful candidate.")
    p.add_argument("--repo-root", required=True)
    p.add_argument("--state-path", required=True)
    p.add_argument("--request-path", required=True)
    p.add_argument("--revision-id", required=True)
    a = sub.add_parser("adopt", help="Validate decision + seal + guard + switch + clear + verify.")
    a.add_argument("--repo-root", required=True)
    a.add_argument("--state-path", required=True)
    a.add_argument("--revision-path", required=True)
    a.add_argument("--decision-path", required=True)
    r = sub.add_parser("resume", help="Explicit bound resume (executes remaining steps).")
    r.add_argument("--repo-root", required=True)
    r.add_argument("--state-path", required=True)
    r.add_argument("--revision-path", required=True)
    b = sub.add_parser("readback", help="Truthful same-State readback + producer boundary.")
    b.add_argument("--repo-root", required=True)
    b.add_argument("--state-path", required=True)
    b.add_argument("--revision-path", required=False, default=None)
    args = parser.parse_args(argv)
    try:
        if args.op == "prepare":
            out = prepare_revision(Path(args.repo_root), Path(args.state_path), Path(args.request_path), args.revision_id)
        elif args.op == "adopt":
            out = adopt_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path), Path(args.decision_path))
        elif args.op == "resume":
            out = resume_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path))
        elif args.op == "readback":
            out = readback_revision(Path(args.repo_root), Path(args.state_path), Path(args.revision_path) if args.revision_path else None)
        else:
            parser.error(f"unknown op {args.op}")
            return 2
    except (AcceptanceError, ValueError, OSError) as exc:
        print(json.dumps({"status": "REFUSED", "error": str(exc)}, indent=2), file=sys.stderr)
        return 1
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

