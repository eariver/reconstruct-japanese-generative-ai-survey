      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "variant",
        "issue_id",
        "proposal_ref",
        "renewal_basis_ref",
        "renewal_proof_ref",
        "recipe_ref",
        "recorded_at",
        "build_sha256"
      ],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "kind": {"const": "VERSIONED_RENEWAL_BUILD_V1"},
        "variant": {"enum": ["REUSED_BUILD", "EXECUTED_BUILD"]},
        "issue_id": {"type": "string", "minLength": 1},
        "proposal_ref": {"$ref": "#/$defs/ref"},
        "renewal_basis_ref": {"$ref": "#/$defs/ref"},
        "renewal_proof_ref": {"$ref": "#/$defs/ref"},
        "recipe_ref": {"$ref": "#/$defs/ref"},
