13f7e144b5252470813aa9f4f4f6a2e56baa1f65 blob 2234
# Source Screening v2

You are performing **research-scope triage**, not article drafting and not final editorial selection.

Inputs are discovery records already collected with immutable provenance. The Production Profile defines the research question, inclusion/exclusion policy, scope dimensions, and temporal policy.

For every input discovery record, emit exactly one decision:

- `KEEP` — materially relevant enough to proceed to Evidence verification;
- `MAYBE` — plausibly relevant but significance is not yet clear;
- `DROP` — not materially relevant to the supplied research scope, duplicate noise, or otherwise unsuitable;
- `INSPECT` — a decision requires more source inspection before Evidence work.

Each decision must contain:

- `discovery_id` exactly as supplied;
- `decision`;
- a concise evidence/research-scope reason;
- zero or more free-form `scope_tags` derived from the supplied Profile, not from a universal topic-lane enum;
- `duplicate_group` when known, otherwise `null`;
- concrete `verification_targets` for claims, dates, identity, source boundaries, metrics, licensing/access status, or other facts requiring Evidence review;
- confidence `low`, `medium`, or `high`.

## Core rules

1. Do not invent facts absent from the discovery record.
2. Do not convert vendor/project/author claims into independent conclusions.
3. Do not use a universal `why_now` requirement. Weekly current relevance is Profile interpretation handled later; Thematic research may be historically material without being current.
4. Do not use fixed A–L topic lanes. Use only `scope_tags` that help the supplied research question.
5. A discovery relation such as `REFERENCE_EXPANSION`, `PARALLEL_EXPANSION`, or `COMPETING_EXPANSION` is provenance, not proof of materiality.
6. Preserve uncertainty. Use `INSPECT` when source identity/content is insufficient.
7. Duplicates still receive an explicit decision; never silently drop a discovery record.
8. Output exactly one decision for every discovery record in the batch and no decisions for records outside the batch.

The result must conform exactly to `schemas/screening-v2-batch-result.schema.json` and must repeat the exact basis hashes supplied by the run package.

1f1e5e6aa8ce9042987b01fdc87edae9551e3d4b blob 4524
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-v2-run-package.schema.json",
  "title": "Survey Production Core v2 Evidence Run Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "prompt", "contracts", "tasks", "expected_outputs", "rules"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "authority_supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_path", "profile_sha256", "state_path", "state_sha256", "discovery_path", "discovery_sha256", "screening_acceptance_path", "screening_acceptance_sha256"],
      "properties": {
        "profile_path": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "state_path": {"type": "string", "minLength": 1},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_path": {"type": "string", "minLength": 1},
        "discovery_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_path": {"type": "string", "minLength": 1},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "config/prompts/evidence-verification-v2.md"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_package", "task", "card"],
      "properties": {
        "run_package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-run-package.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-task.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-card.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "supplement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-authority-supplement-v2.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_task_id", "path", "sha256", "discovery_ids"],
        "properties": {
          "evidence_task_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^tasks/task-[0-9a-f]{20}\\.json$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_supplement_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^supplement-src-[0-9a-f]{16}$"}}
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_result_per_task", "filename_rule"],
      "properties": {
        "one_result_per_task": {"const": true},
        "filename_rule": {"const": "same-basename-as-task"}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

