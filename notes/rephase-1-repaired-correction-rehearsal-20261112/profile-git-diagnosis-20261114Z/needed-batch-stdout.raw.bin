    "accepted_refs",
    "supported_contract",
    "supported_source_bindings",
    "dependency_closure",
    "output_trio_refs",
    "reader_digest",
    "trio_digest",
    "comparison",
    "executor",
    "recorded_at",
    "proof_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "kind": {"const": "VERSIONED_RENEWAL_SOURCE_PROOF_V1"},
    "basis_ref": {"$ref": "#/$defs/ref"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "THEMATIC"]},
    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
    "generator_route": {"enum": ["WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"]},
    "reviewed_reader_ref": {"$ref": "#/$defs/ref"},
    "authoring_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "accepted_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "supported_contract": {"$ref": "#/$defs/contract8"},
    "supported_source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observedSourceBinding"},
      "uniqueItems": true
    },
    "dependency_closure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "output_trio_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "bibliography", "style"],
      "properties": {
        "primary": {"$ref": "#/$defs/sizedRef"},
        "bibliography": {"$ref": "#/$defs/sizedRef"},
        "style": {"$ref": "#/$defs/sizedRef"}
      }
    },
    "reader_digest": {"$ref": "#/$defs/sha256"},
    "trio_digest": {"$ref": "#/$defs/sha256"},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reader_equal", "trio_equal", "disposition"],
      "properties": {
        "reader_equal": {"type": "boolean"},
        "trio_equal": {"type": "boolean"},
        "disposition": {"enum": ["REUSED_TARGETS", "NEW_TARGETS"]}
      }
    },
    "old_manuscript_ref": {"$ref": "#/$defs/sizedRef"},
    "old_build_unit_refs": {"$ref": "#/$defs/oldBuildUnit"},
    "executor": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "proof_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"comparison": {"properties": {"disposition": {"const": "REUSED_TARGETS"}}}}},
      "then": {"required": ["old_manuscript_ref", "old_build_unit_refs"]}
    },
    {
      "if": {"properties": {"comparison": {"properties": {"disposition": {"const": "NEW_TARGETS"}}}}},
      "then": {"not": {"anyOf": [{"required": ["old_manuscript_ref"]}, {"required": ["old_build_unit_refs"]}]}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "namedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_contract_version",
        "pipeline_contract_sha256",
        "quality_contract_version",
        "quality_contract_sha256",
        "research_profile_version",
        "research_profile_sha256",
        "publication_profile_version",
        "publication_profile_sha256"
      ],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observedSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "binding", "repository_commit_sha"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/ref"},
        "binding": {"enum": ["RECEIPT_CURRENT_TOOLS", "STAGED_PRODUCER", "SCHEMA"]},
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "schema_path": {"type": "string", "minLength": 1},
        "schema_pointer": {"type": "string"},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"binding": {"const": "SCHEMA"}}},
          "then": {"required": ["source_ref", "binding", "repository_commit_sha", "schema_path", "schema_pointer", "schema_sha256"]}
        },
        {
          "if": {"properties": {"binding": {"enum": ["RECEIPT_CURRENT_TOOLS", "STAGED_PRODUCER"]}}},
          "then": {"not": {"anyOf": [{"required": ["schema_path"]}, {"required": ["schema_pointer"]}, {"required": ["schema_sha256"]}]}}
        }
      ]
    },
    "pdfRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "page_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "oldBuildUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "log", "digest", "record"],
      "properties": {
        "pdf": {"$ref": "#/$defs/pdfRef"},
        "log": {"$ref": "#/$defs/sizedRef"},
        "digest": {"$ref": "#/$defs/sizedRef"},
        "record": {"$ref": "#/$defs/ref"}
      }
    }
  }
}

