    "publication_approval":{"allOf":[{"$ref":"#/$defs/approval_fields"},{"properties":{"kind":{"const":"RECORD_PUBLICATION_PREVIEW_APPROVAL"}}}]},
    "architecture_revision":{"type":"object","additionalProperties":false,"required":["kind","state_path","expected_revision","reviewed_repository_commit_sha","regeneration_boundary","requested_changes","reviewed_by","reviewed_at","review_reference"],"properties":{"kind":{"const":"REQUEST_ARCHITECTURE_REVISION"},"state_path":{"$ref":"#/$defs/repo_path"},"expected_revision":{"type":"integer","minimum":1},"reviewed_repository_commit_sha":{"$ref":"#/$defs/sha40"},"regeneration_boundary":{"enum":["ISSUE_INITIALIZED","DISCOVERY_COLLECTED","CANDIDATES_NORMALIZED","EVIDENCE_REVIEWED","SELECTION_COMPLETE"]},"requested_changes":{"type":"string","minLength":1},"reviewed_by":{"type":"string","minLength":1},"reviewed_at":{"type":"string","format":"date-time"},"review_reference":{"type":"string","minLength":1}}},
    "publication_revision":{"type":"object","additionalProperties":false,"required":["kind","state_path","expected_revision","reviewed_repository_commit_sha","regeneration_boundary","requested_changes","reviewed_by","reviewed_at","review_reference"],"properties":{"kind":{"const":"REQUEST_PUBLICATION_PREVIEW_REVISION"},"state_path":{"$ref":"#/$defs/repo_path"},"expected_revision":{"type":"integer","minimum":1},"reviewed_repository_commit_sha":{"$ref":"#/$defs/sha40"},"regeneration_boundary":{"enum":["ISSUE_INITIALIZED","DISCOVERY_COLLECTED","CANDIDATES_NORMALIZED","EVIDENCE_REVIEWED","SELECTION_COMPLETE","ARCHITECTURE_ESTABLISHED","DRAFT_COMPLETE","VALIDATED_DRAFT"]},"requested_changes":{"type":"string","minLength":1},"reviewed_by":{"type":"string","minLength":1},"reviewed_at":{"type":"string","format":"date-time"},"review_reference":{"type":"string","minLength":1}}}
