fabdd657e3f2efa7f23a2039aa187581682d7989 blob 11682
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/stage-checkpoint-v2.schema.json",
  "title": "Survey Production Core v2 Agent Stage Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "from_state",
    "to_state",
    "checkpoints",
    "recorded_at",
    "implementation",
    "contract",
    "artifacts",
    "reviews",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "from_state": {"$ref": "#/$defs/lifecycle"},
    "to_state": {"$ref": "#/$defs/lifecycle"},
    "checkpoints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/checkpoint"}
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "orchestrator_version"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "orchestrator_version": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_contract_version",
        "pipeline_contract_sha256",
        "quality_contract_version",
        "quality_contract_sha256",
        "research_profile_version",
        "research_profile_sha256",
        "publication_profile_version",
        "publication_profile_sha256"
      ],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedAuthority"}
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "kind", "status", "executor", "evidence", "result"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["DETERMINISTIC", "AGENT_RESEARCH", "AGENT_EDITORIAL", "AGENT_VISUAL"]},
          "status": {"const": "PASS"},
          "executor": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/nullableAuthority"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "DETERMINISTIC"}}, "required": ["kind"]},
            "then": {"properties": {"result": {"$ref": "#/$defs/artifactAuthority"}}}
          }
        ]
      }
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"$ref": "#/$defs/localStageValidationReview"},
    {"$ref": "#/$defs/issueInitializedArtifacts"},
    {"$ref": "#/$defs/screeningArtifacts"},
    {"$ref": "#/$defs/evidenceArtifacts"},
    {"$ref": "#/$defs/selectionArtifacts"},
    {"$ref": "#/$defs/architectureArtifacts"},
    {"$ref": "#/$defs/draftArtifacts"},
    {"$ref": "#/$defs/validationArtifacts"},
    {"$ref": "#/$defs/publicationCandidateArtifacts"},
    {"$ref": "#/$defs/freezeArtifacts"},
    {"$ref": "#/$defs/releaseArtifacts"},
    {"$ref": "#/$defs/releaseStageValidationReview"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableAuthority": {
      "oneOf": [
        {"$ref": "#/$defs/artifactAuthority"},
        {"type": "null"}
      ]
    },
    "namedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "localStageValidationReview": {
      "if": {
        "properties": {
          "from_state": {
            "enum": [
              "ISSUE_INITIALIZED",
              "DISCOVERY_COLLECTED",
              "CANDIDATES_NORMALIZED",
              "EVIDENCE_REVIEWED",
              "SELECTION_COMPLETE",
              "ARCHITECTURE_ESTABLISHED",
              "DRAFT_COMPLETE",
              "VALIDATED_DRAFT",
              "RELEASE_CANDIDATE",
              "FROZEN"
            ]
          }
        },
        "required": ["from_state"]
      },
      "then": {
        "properties": {
          "reviews": {
            "contains": {
              "type": "object",
              "properties": {
                "check_id": {"const": "CORE_STAGE_CONTRACT"},
                "kind": {"const": "DETERMINISTIC"},
                "status": {"const": "PASS"},
                "result": {"$ref": "#/$defs/artifactAuthority"}
              },
              "required": ["check_id", "kind", "status", "result"]
            }
          }
        }
      }
    },
    "releaseStageValidationReview": {
      "if": {"properties": {"from_state": {"const": "FROZEN"}}, "required": ["from_state"]},
      "then": {
        "properties": {
          "reviews": {
            "contains": {
              "type": "object",
              "properties": {
                "check_id": {"const": "RELEASE_EXACT_BYTE_RECONCILIATION"},
                "kind": {"const": "DETERMINISTIC"},
                "status": {"const": "PASS"},
                "result": {"$ref": "#/$defs/artifactAuthority"}
              },
              "required": ["check_id", "kind", "status", "result"]
            }
          }
        }
      }
    },
    "issueInitializedArtifacts": {
      "if": {"properties": {"from_state": {"const": "ISSUE_INITIALIZED"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"contains": {"type": "object", "properties": {"name": {"const": "discovery-acceptance"}}, "required": ["name"]}}}}
    },
    "screeningArtifacts": {
      "if": {"properties": {"from_state": {"const": "DISCOVERY_COLLECTED"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"contains": {"type": "object", "properties": {"name": {"const": "screening-acceptance"}}, "required": ["name"]}}}}
    },
    "evidenceArtifacts": {
      "if": {"properties": {"from_state": {"const": "CANDIDATES_NORMALIZED"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "evidence-acceptance"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "edition-views-acceptance"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "materiality-ledger"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "profile-completeness"}}, "required": ["name"]}}
      ]}}}
    },
    "selectionArtifacts": {
      "if": {"properties": {"from_state": {"const": "EVIDENCE_REVIEWED"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "candidate-matrix"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "candidate-selection"}}, "required": ["name"]}}
      ]}}}
    },
    "architectureArtifacts": {
      "if": {"properties": {"from_state": {"const": "SELECTION_COMPLETE"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "issue-architecture"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "architecture-review-summary"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "architecture-review-attention"}}, "required": ["name"]}}
      ]}}}
    },
    "draftArtifacts": {
      "if": {"properties": {"from_state": {"const": "ARCHITECTURE_ESTABLISHED"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "synthesis-input"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "synthesis-result"}}, "required": ["name"]}}
      ]}}}
    },
    "validationArtifacts": {
      "if": {"properties": {"from_state": {"const": "DRAFT_COMPLETE"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "validated-source"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "publication-pdf"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "quality-regression-bundle"}}, "required": ["name"]}}
      ]}}}
    },
    "publicationCandidateArtifacts": {
      "if": {"properties": {"from_state": {"const": "VALIDATED_DRAFT"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"contains": {"type": "object", "properties": {"name": {"const": "publication-candidate"}}, "required": ["name"]}}}}
    },
    "freezeArtifacts": {
      "if": {"properties": {"from_state": {"const": "RELEASE_CANDIDATE"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "visual-review-record"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "freeze-record"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "release-manifest"}}, "required": ["name"]}}
      ]}}}
    },
    "releaseArtifacts": {
      "if": {"properties": {"from_state": {"const": "FROZEN"}}, "required": ["from_state"]},
      "then": {"properties": {"artifacts": {"allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "merge-verification"}}, "required": ["name"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "release-record"}}, "required": ["name"]}}
      ]}}}
    },
    "checkpoint": {
      "enum": [
        "discovery",
        "screening",
        "evidence",
        "materiality",
        "completeness",
        "selection",
        "architecture",
        "draft",
        "validation",
        "publication_preview",
        "freeze",
        "release"
      ]
    },
    "lifecycle": {
      "enum": [
        "ISSUE_INITIALIZED",
        "DISCOVERY_COLLECTED",
        "CANDIDATES_NORMALIZED",
        "EVIDENCE_REVIEWED",
        "SELECTION_COMPLETE",
        "ARCHITECTURE_ESTABLISHED",
        "DRAFT_COMPLETE",
        "VALIDATED_DRAFT",
        "RELEASE_CANDIDATE",
        "FROZEN",
        "RELEASED"
      ]
    }
  }
}

8eebf50d4b22bdaf254e28ad3f88d802e5588e1b blob 2368
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/review-finding-v2.schema.json",
  "title": "Survey Production Core v2 Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "edition", "stage", "observed_problem",
    "expected_behavior", "actual_behavior", "production_workaround",
    "classification", "requires_regression", "provenance", "improvement_action",
    "regression_fixture", "resolved_by_repair_set_id", "status"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "finding_id": {"type": "string", "minLength": 1},
    "edition": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "observed_problem": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "actual_behavior": {"type": "string", "minLength": 1},
    "production_workaround": {"type": ["string", "null"]},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "defect_kind", "confidence"],
      "properties": {
        "scope": {"enum": ["EDITION_LOCAL", "WEEKLY_PROFILE", "PERIOD_PROFILE", "THEMATIC_PROFILE", "CORE", "PUBLICATION_PROFILE", "QUALITY_CONTRACT", "SERIES_LAYER", "UNCLASSIFIED"]},
        "defect_kind": {"enum": ["CORRECTNESS", "TRACEABILITY", "COVERAGE", "EDITORIAL", "PUBLICATION", "ORCHESTRATION", "COMPATIBILITY", "OTHER"]},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "requires_regression": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "relevant_artifacts", "human_review_reference"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "relevant_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "human_review_reference": {"type": ["string", "null"]}
      }
    },
    "improvement_action": {"type": ["string", "null"]},
    "regression_fixture": {"type": ["string", "null"]},
    "resolved_by_repair_set_id": {"type": ["string", "null"]},
    "status": {"enum": ["OPEN", "CLASSIFIED", "FIXED_LOCAL", "FIXED_GENERIC", "DEFERRED", "CLOSED"]}
  }
}

f56db18437c2d4f56b0999a8afe31187ae4c5533 blob 2190
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/repair-set-v2.schema.json",
  "title": "Survey Production Core v2 Repair Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair_set_id", "finding_ids", "affected_components", "actual_layers_changed", "disposition", "implementation_commits", "regression_fixtures", "compatibility_impact", "validation_results", "verification_editions", "status"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "repair_set_id": {"type": "string", "minLength": 1},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "affected_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actual_layers_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["EDITION_LOCAL", "WEEKLY_PROFILE", "PERIOD_PROFILE", "THEMATIC_PROFILE", "CORE", "PUBLICATION_PROFILE", "QUALITY_CONTRACT", "SERIES_LAYER"]}
    },
    "disposition": {"enum": ["LOCAL_ONLY", "PROFILE_FIX", "CORE_FIX", "PUBLICATION_FIX", "QUALITY_CONTRACT_FIX", "SERIES_FIX", "DEFERRED"]},
    "implementation_commits": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "regression_fixtures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility_impact": {"type": "string", "minLength": 1},
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "reference"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "PENDING"]},
          "reference": {"type": ["string", "null"]}
        }
      }
    },
    "verification_editions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["PROPOSED", "IMPLEMENTED", "VALIDATED", "DEFERRED", "CLOSED"]}
  }
}

f2f4c74e0eea64ffbc046dec7c6ef6c201d88f43 blob 8322
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/versioned-renewal-basis-v2.schema.json",
  "title": "Survey Versioned Same-Reader Renewal Basis (VERSIONED_RENEWAL_BASIS_V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "renewal_id",
    "proposal_namespace",
    "issue_id",
    "research_profile",
    "publication_profile",
    "generator_route",
    "original_proposal_ref",
    "profile_ref",
    "reviewed_reader_ref",
    "authoring_refs",
    "accepted_refs",
    "original_validation_ref",
    "prior_selected_ref",
    "prior_record_ref",
    "prior_candidate_ref",
    "canonical_anchor",
    "before_state_ref",
    "retained_copy_ref",
    "observed_source_bindings",
    "current_tool_epoch",
    "retention_rows",
    "requested",
    "executor",
    "recorded_at",
    "basis_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "kind": {"const": "VERSIONED_RENEWAL_BASIS_V1"},
    "renewal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "proposal_namespace": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "THEMATIC"]},
    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
    "generator_route": {"enum": ["WEEKLY_GENERATED_V2", "LONGFORM_GENERATED_V1"]},
    "original_proposal_ref": {"$ref": "#/$defs/ref"},
    "profile_ref": {"$ref": "#/$defs/ref"},
    "reviewed_reader_ref": {"$ref": "#/$defs/ref"},
    "authoring_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "accepted_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "original_validation_ref": {"$ref": "#/$defs/ref"},
    "prior_selected_ref": {"$ref": "#/$defs/ref"},
    "prior_record_ref": {"$ref": "#/$defs/ref"},
    "prior_candidate_ref": {"$ref": "#/$defs/ref"},
    "canonical_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["VALIDATION_CHECKPOINT", "LEGACY_REVALIDATION"]},
        "ref": {"$ref": "#/$defs/ref"}
      }
    },
    "before_state_ref": {"$ref": "#/$defs/ref"},
    "retained_copy_ref": {"$ref": "#/$defs/sizedRef"},
    "observed_source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observedSourceBinding"},
      "uniqueItems": true
    },
    "current_tool_epoch": {"$ref": "#/$defs/toolEpoch"},
    "retention_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/retentionRow"},
      "uniqueItems": true
    },
    "requested": {"enum": ["REUSE_TARGETS", "RENDER_TARGETS"]},
    "toolchain_spec_ref": {"$ref": "#/$defs/ref"},
    "manuscript_spec_ref": {"$ref": "#/$defs/ref"},
    "executor": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "basis_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"requested": {"const": "REUSE_TARGETS"}}},
      "then": {"not": {"required": ["toolchain_spec_ref"]}}
    },
    {
      "if": {"properties": {"requested": {"const": "RENDER_TARGETS"}}},
      "then": {"required": ["toolchain_spec_ref", "manuscript_spec_ref"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "namedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_contract_version",
        "pipeline_contract_sha256",
        "quality_contract_version",
        "quality_contract_sha256",
        "research_profile_version",
        "research_profile_sha256",
        "publication_profile_version",
        "publication_profile_sha256"
      ],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "contract", "closure"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "contract": {"$ref": "#/$defs/contract8"},
        "closure": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/namedRow"},
          "uniqueItems": true
        }
      }
    },
    "observedSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "binding", "repository_commit_sha"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/ref"},
        "binding": {"enum": ["RECEIPT_CURRENT_TOOLS", "STAGED_PRODUCER", "SCHEMA"]},
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "schema_path": {"type": "string", "minLength": 1},
        "schema_pointer": {"type": "string"},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"binding": {"const": "SCHEMA"}}},
          "then": {"required": ["source_ref", "binding", "repository_commit_sha", "schema_path", "schema_pointer", "schema_sha256"]}
        },
        {
          "if": {"properties": {"binding": {"enum": ["RECEIPT_CURRENT_TOOLS", "STAGED_PRODUCER"]}}},
          "then": {"not": {"anyOf": [{"required": ["schema_path"]}, {"required": ["schema_pointer"]}, {"required": ["schema_sha256"]}]}}
        }
      ]
    },
    "retentionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "path", "sha256", "byte_count", "policy"],
      "properties": {
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "policy": {"enum": ["KEEP_IMMUTABLE", "COPY_BEFORE_REPLACEMENT"]},
        "retained_ref": {"$ref": "#/$defs/ref"},
        "retained_dest": {"type": "string", "minLength": 1},
        "retained_sha256": {"$ref": "#/$defs/sha256"},
        "retained_byte_count": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"policy": {"const": "KEEP_IMMUTABLE"}}},
          "then": {"required": ["retained_ref"], "not": {"anyOf": [{"required": ["retained_dest"]}, {"required": ["retained_sha256"]}, {"required": ["retained_byte_count"]}]}}
        },
        {
          "if": {"properties": {"policy": {"const": "COPY_BEFORE_REPLACEMENT"}}},
          "then": {"required": ["retained_dest", "retained_sha256", "retained_byte_count"], "not": {"required": ["retained_ref"]}}
        }
      ]
    }
  }
}

