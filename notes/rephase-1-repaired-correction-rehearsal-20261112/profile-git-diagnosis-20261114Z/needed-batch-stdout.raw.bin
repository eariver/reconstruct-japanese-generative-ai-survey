          "properties": {
            "interpretation": {"type": "string", "minLength": 1},
            "event_semantics": {"type": "string", "minLength": 1},
            "provenance_check": {"type": "string", "minLength": 1}
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
