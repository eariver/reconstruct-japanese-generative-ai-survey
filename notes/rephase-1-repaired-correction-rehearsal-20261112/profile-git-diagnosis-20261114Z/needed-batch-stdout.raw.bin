        "validated-source": {"$ref": "#/$defs/fileRef"},
        "bibliography": {"$ref": "#/$defs/fileRef"},
        "style": {"$ref": "#/$defs/fileRef"},
        "publication-pdf": {"$ref": "#/$defs/fileRef"},
        "build-log": {"$ref": "#/$defs/fileRef"},
        "pdf-digest": {"$ref": "#/$defs/fileRef"},
        "quality-regression-bundle": {"$ref": "#/$defs/fileRef"},
        "semantic-review": {"$ref": "#/$defs/fileRef"},
        "visual-review": {"$ref": "#/$defs/fileRef"},
        "reader-surface-gate": {"$ref": "#/$defs/fileRef"},
        "publication-candidate": {"$ref": "#/$defs/fileRef"}
      }
    },
