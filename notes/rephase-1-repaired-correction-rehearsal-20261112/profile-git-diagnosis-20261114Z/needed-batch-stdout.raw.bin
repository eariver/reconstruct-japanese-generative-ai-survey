      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}

a6370f16f274bace1d6d9e396e42f828d2bb53e9 blob 14629
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dm022-preadoption-report-v2.schema.json",
  "title": "DM022 pre-adoption report (no checkpoint/afterState/guard-hash refs) R4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "revision_id", "revision_root", "request", "manifest", "proof", "decision", "before_state", "before_checkpoint", "proposed_artifacts", "operation", "producer_boundary", "affected_ids", "mechanical_projections", "tool_pins", "work_ref", "recorded_at", "executor", "preadoption_report_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision_root": {"$ref": "#/$defs/safePath"},
    "request": {"$ref": "#/$defs/SizedRef"},
    "manifest": {"$ref": "#/$defs/SizedRef"},
    "proof": {"$ref": "#/$defs/SizedRef"},
    "decision": {"$ref": "#/$defs/SizedRef"},
    "before_state": {"$ref": "#/$defs/SizedRef"},
    "before_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "materiality", "completeness"],
      "properties": {
        "evidence": {"$ref": "#/$defs/ArtifactRef"},
        "materiality": {"$ref": "#/$defs/ArtifactRef"},
        "completeness": {"$ref": "#/$defs/ArtifactRef"}
      }
    },
    "proposed_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_acceptance", "views_acceptance", "ledger", "completeness"],
      "properties": {
        "evidence_acceptance": {"$ref": "#/$defs/SizedRef"},
        "views_acceptance": {"$ref": "#/$defs/SizedRef"},
        "ledger": {"$ref": "#/$defs/SizedRef"},
        "completeness": {"$ref": "#/$defs/SizedRef"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state"],
      "properties": {
        "from_state": {"const": "EVIDENCE_REVIEWED"},
        "to_state": {"const": "EVIDENCE_REVIEWED"}
      }
    },
    "producer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state"],
      "properties": {
        "from_state": {"const": "CANDIDATES_NORMALIZED"},
        "to_state": {"const": "EVIDENCE_REVIEWED"}
      }
    },
    "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mechanical_projections": {"type": "array", "items": {"$ref": "#/$defs/mechanicalProjection"}},
    "tool_pins": {"$ref": "#/$defs/toolPins"},
    "work_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "tree_sha", "contract"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "tree_sha": {"$ref": "#/$defs/gitsha"},
        "contract": {"$ref": "#/$defs/contract8"}
      }
    },
    "guard_claimed": {"type": "boolean"},
    "guard_path": {"$ref": "#/$defs/safePath"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1},
    "preadoption_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$"},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "SizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "NamedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "old_sha256", "new_sha256", "reason"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1},
        "old_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "new_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_contract_version", "pipeline_contract_sha256", "quality_contract_version", "quality_contract_sha256", "research_profile_version", "research_profile_sha256", "publication_profile_version", "publication_profile_sha256"],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "orchestrator_version", "contract", "tool_shas"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "orchestrator_version": {"type": "string", "minLength": 1},
        "contract": {"$ref": "#/$defs/contract8"},
        "tool_shas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/safePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "roleSchemaRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence-acceptance", "edition-views-acceptance", "materiality-ledger", "profile-completeness", "candidate-matrix", "candidate-selection"],
      "properties": {
        "evidence-acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/dm022-revision-proof-v2.schema.json"},
            "def_pointer": {"const": "#/$defs/evidenceAcceptance"},
            "validator": {"const": "survey_evidence_v2._validate_evidence_acceptance_content"},
            "digest_field": {"const": "result_set_sha256"}
          }
        },
        "edition-views-acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/dm022-revision-proof-v2.schema.json"},
            "def_pointer": {"const": "#/$defs/viewsAcceptance"},
            "validator": {"const": "survey_evidence_v2._validate_edition_views_acceptance_content"},
            "digest_field": {"const": "view_set_sha256"}
          }
        },
        "materiality-ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/materiality-ledger.schema.json"},
            "def_pointer": {"const": "#"},
            "validator": {"const": "survey_evidence_v2._validate_materiality_ledger_content"},
            "digest_field": {"const": "basis-discrete-SHAs-no-self-digest"}
          }
        },
        "profile-completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/profile-completeness-result.schema.json"},
            "def_pointer": {"const": "#"},
            "validator": {"const": "survey_completeness_v2._validate_profile_completeness_content"},
            "digest_field": {"const": "basis.materiality_ledger_sha256"}
          }
        },
        "candidate-matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/candidate-matrix-v2.schema.json"},
            "def_pointer": {"const": "#"},
            "validator": {"const": "survey_architecture_v2_base.validate_selection"},
            "digest_field": {"const": "basis-SHAs"}
          }
        },
        "candidate-selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_file", "def_pointer", "validator", "digest_field"],
          "properties": {
            "schema_file": {"const": "schemas/candidate-selection-v2.schema.json"},
            "def_pointer": {"const": "#"},
            "validator": {"const": "survey_architecture_v2_base.validate_architecture"},
            "digest_field": {"const": "basis-SHAs"}
          }
        }
      }
    },
    "retentionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "revision_id", "rows"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "rows": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "accepted_bound", "gate_bound"],
            "properties": {
              "slot": {"enum": ["candidate-matrix-v2.json", "candidate-selection-v2.json", "architecture-v2.json", "architecture-review-summary-v2.json", "architecture-review-attention-v2.json", "orchestration/v2/interactive/selection-architecture-input.json", "orchestration/v2/interactive/selection-architecture-audit.json"]},
              "source_rel": {"$ref": "#/$defs/safePath"},
              "copy_rel": {"$ref": "#/$defs/safePath"},
              "present": {"type": "boolean"},
              "source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "copy_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "accepted_bound": {"type": "boolean"},
              "gate_bound": {"type": "boolean"}
            }
          }
        }
      }
    },
    "guardIntentCoord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_path", "issue_id", "revision_id", "attempt_nonce", "planned_checkpoint_ref", "before_state_sha256", "expected_after_state_sha256", "work"],
      "properties": {
        "guard_path": {"const": "orchestration/v2/acceptance-revision.guard.json"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "attempt_nonce": {"type": "string", "pattern": "^[0-9a-f]{16,}$"},
        "planned_checkpoint_ref": {"$ref": "#/$defs/SizedRef"},
        "before_state_sha256": {"$ref": "#/$defs/sha256"},
        "expected_after_state_sha256": {"$ref": "#/$defs/sha256"},
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "tree"],
          "properties": {
            "head": {"$ref": "#/$defs/gitsha"},
            "tree": {"$ref": "#/$defs/gitsha"}
          }
        }
      }
    },
    "completionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "revision_id", "attempt_nonce", "checkpoint", "expected_after_state", "seven_plan", "postread", "recorded_at", "executor"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "issue_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "attempt_nonce": {"type": "string", "pattern": "^[0-9a-f]{16,}$"},
        "checkpoint": {"$ref": "#/$defs/SizedRef"},
        "expected_after_state": {"$ref": "#/$defs/SizedRef"},
        "seven_plan": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "disposition", "captured_sha", "copy_sha"],
            "properties": {
              "slot": {"enum": ["candidate-matrix-v2.json", "candidate-selection-v2.json", "architecture-v2.json", "architecture-review-summary-v2.json", "architecture-review-attention-v2.json", "orchestration/v2/interactive/selection-architecture-input.json", "orchestration/v2/interactive/selection-architecture-audit.json"]},
              "disposition": {"enum": ["cleared", "absent_legitimate"]},
              "captured_sha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "copy_sha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
            }
          }
        },
        "postread": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_sha", "triplet_match", "artifacts_rehashed"],
          "properties": {
            "state_sha": {"$ref": "#/$defs/sha256"},
            "triplet_match": {"const": true},
            "artifacts_rehashed": {"const": true}
          }
        },
        "recorded_at": {"type": "string", "format": "date-time"},
        "executor": {"type": "string", "minLength": 1}
      }
    }
  }
}

5a72345798e6a493ca746b79f3de7b32353595e3 blob 8773
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dm022-revision-manifest-v2.schema.json",
  "title": "DM022 revision manifest (immutable prepare inventory, no self digest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "revision_id", "revision_root", "request", "before_state", "before_checkpoint", "profile_ref", "discovery_ref", "screening_ref", "retention_snapshots", "candidate_outputs", "tool_pins", "work", "recorded_at", "executor"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision_root": {"$ref": "#/$defs/safePath"},
    "request": {"$ref": "#/$defs/SizedRef"},
    "before_state": {"$ref": "#/$defs/SizedRef"},
    "before_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "materiality", "completeness"],
      "properties": {
        "evidence": {"$ref": "#/$defs/ArtifactRef"},
        "materiality": {"$ref": "#/$defs/ArtifactRef"},
        "completeness": {"$ref": "#/$defs/ArtifactRef"}
      }
    },
    "profile_ref": {"$ref": "#/$defs/SizedRef"},
    "discovery_ref": {"$ref": "#/$defs/SizedRef"},
    "screening_ref": {"$ref": "#/$defs/SizedRef"},
    "retention_snapshots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/retentionRow"}
    },
    "candidate_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "tasks", "cards", "views", "evidence_acceptance", "views_acceptance", "ledger", "completeness", "supplement_manifest"],
      "properties": {
        "package": {"$ref": "#/$defs/SizedRef"},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "views": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "evidence_acceptance": {"$ref": "#/$defs/SizedRef"},
        "views_acceptance": {"$ref": "#/$defs/SizedRef"},
        "ledger": {"$ref": "#/$defs/SizedRef"},
        "completeness": {"$ref": "#/$defs/SizedRef"},
        "supplement_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/SizedRef"}]}
      }
    },
    "tool_pins": {"$ref": "#/$defs/toolPins"},
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_head", "expected_tree"],
      "properties": {
        "expected_head": {"$ref": "#/$defs/gitsha"},
        "expected_tree": {"$ref": "#/$defs/gitsha"}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "properties": {
        "retention_snapshots": {
          "allOf": [
            {"contains": {"type": "object", "properties": {"slot": {"const": "candidate-matrix-v2.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "candidate-selection-v2.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "architecture-v2.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "architecture-review-summary-v2.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "architecture-review-attention-v2.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "orchestration/v2/interactive/selection-architecture-input.json"}}, "required": ["slot"]}},
            {"contains": {"type": "object", "properties": {"slot": {"const": "orchestration/v2/interactive/selection-architecture-audit.json"}}, "required": ["slot"]}}
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$"},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "SizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "NamedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retentionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "byte_count", "source_dev", "source_ino", "copy_dev", "copy_ino", "accepted_bound", "gate_bound"],
      "properties": {
        "slot": {"enum": ["candidate-matrix-v2.json", "candidate-selection-v2.json", "architecture-v2.json", "architecture-review-summary-v2.json", "architecture-review-attention-v2.json", "orchestration/v2/interactive/selection-architecture-input.json", "orchestration/v2/interactive/selection-architecture-audit.json"]},
        "source_rel": {"$ref": "#/$defs/safePath"},
        "copy_rel": {"$ref": "#/$defs/safePath"},
        "present": {"type": "boolean"},
        "source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "copy_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "byte_count": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "source_dev": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "source_ino": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "copy_dev": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "copy_ino": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "accepted_bound": {"type": "boolean"},
        "gate_bound": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"present": {"const": true}}, "required": ["present"]},
          "then": {"required": ["slot", "source_rel", "copy_rel", "present", "source_sha256", "copy_sha256", "byte_count", "accepted_bound", "gate_bound"]}
        },
        {
          "if": {"properties": {"present": {"const": false}}, "required": ["present"]},
          "then": {"properties": {"source_sha256": {"type": "null"}, "copy_sha256": {"type": "null"}, "byte_count": {"type": "null"}}}
        }
      ]
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_contract_version", "pipeline_contract_sha256", "quality_contract_version", "quality_contract_sha256", "research_profile_version", "research_profile_sha256", "publication_profile_version", "publication_profile_sha256"],
      "properties": {
        "pipeline_contract_version": {"type": "string", "minLength": 1},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_version": {"type": "string", "minLength": 1},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "research_profile_version": {"type": "string", "minLength": 1},
        "research_profile_sha256": {"$ref": "#/$defs/sha256"},
        "publication_profile_version": {"type": "string", "minLength": 1},
        "publication_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "orchestrator_version", "contract", "tool_shas"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "orchestrator_version": {"type": "string", "minLength": 1},
        "contract": {"$ref": "#/$defs/contract8"},
        "tool_shas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/safePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  }
}

ad2a587c35f3d5db07404b8893ef6ff531fed501 blob 7403
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dm022-revision-proof-v2.schema.json",
  "title": "DM022 revision proof (deterministic, proposed-bytes only) R4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "revision_id", "revision_root", "manifest", "decision", "before_state", "proposed", "affected_ids", "unaffected_comparison", "validations", "recorded_at", "executor", "revision_proof_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision_root": {"$ref": "#/$defs/safePath"},
    "manifest": {"$ref": "#/$defs/SizedRef"},
    "decision": {"$ref": "#/$defs/SizedRef"},
    "before_state": {"$ref": "#/$defs/SizedRef"},
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "tasks", "cards", "views", "evidence_acceptance", "views_acceptance", "ledger", "completeness", "result_set_sha256", "view_set_sha256"],
      "properties": {
        "package": {"$ref": "#/$defs/SizedRef"},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "views": {"type": "array", "items": {"$ref": "#/$defs/SizedRef"}},
        "evidence_acceptance": {"$ref": "#/$defs/SizedRef"},
        "views_acceptance": {"$ref": "#/$defs/SizedRef"},
        "ledger": {"$ref": "#/$defs/SizedRef"},
        "completeness": {"$ref": "#/$defs/SizedRef"},
        "result_set_sha256": {"$ref": "#/$defs/sha256"},
        "view_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unaffected_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows_checked", "mechanical_projections"],
      "properties": {
        "rows_checked": {"type": "integer", "minimum": 0},
        "mechanical_projections": {"type": "array", "items": {"$ref": "#/$defs/mechanicalProjection"}}
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "kind", "status", "executor", "evidence", "result"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "kind": {"const": "DETERMINISTIC"},
          "status": {"const": "PASS"},
          "executor": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/SizedRef"}
        }
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1},
    "revision_proof_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$"},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "SizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "NamedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "old_sha256", "new_sha256", "reason"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1},
        "old_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "new_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidenceAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "research_profile", "result_set_sha256", "package_sha256", "screening_acceptance_sha256", "result_count", "results"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
        "result_set_sha256": {"$ref": "#/$defs/sha256"},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "result_count": {"type": "integer", "minimum": 1},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_task_id", "discovery_ids", "sha256", "status", "filename"],
            "properties": {
              "evidence_task_id": {"type": "string", "minLength": 1},
              "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "sha256": {"$ref": "#/$defs/sha256"},
              "status": {"enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"]},
              "filename": {"type": "string", "pattern": "^task-[0-9a-f]{20}\\.json$"}
            }
          }
        }
      }
    },
    "viewsAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_id", "research_profile", "view_set_sha256", "profile_sha256", "evidence_acceptance_sha256", "views"],
      "properties": {
        "schema_version": {"const": "2.0-rc1"},
        "issue_id": {"type": "string", "minLength": 1},
        "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
        "view_set_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_task_id", "evidence_sha256", "view_sha256", "materiality", "scope_dimensions"],
            "properties": {
              "evidence_task_id": {"type": "string", "minLength": 1},
              "evidence_sha256": {"$ref": "#/$defs/sha256"},
              "view_sha256": {"$ref": "#/$defs/sha256"},
              "materiality": {"enum": ["MATERIAL", "CONTEXT", "NON_MATERIAL", "HOLD"]},
              "scope_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}

