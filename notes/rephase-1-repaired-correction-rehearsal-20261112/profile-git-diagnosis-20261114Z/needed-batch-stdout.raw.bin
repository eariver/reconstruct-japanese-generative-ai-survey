{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/versioned-renewal-source-proof-v2.schema.json",
  "title": "Survey Versioned Same-Reader Renewal Source Proof (VERSIONED_RENEWAL_SOURCE_PROOF_V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "basis_ref",
    "issue_id",
    "research_profile",
    "publication_profile",
    "generator_route",
    "reviewed_reader_ref",
