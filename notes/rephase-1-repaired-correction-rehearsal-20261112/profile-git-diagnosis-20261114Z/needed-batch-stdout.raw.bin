        "original_log_ref": {"$ref": "#/$defs/sizedRef"},
        "original_digest_ref": {"$ref": "#/$defs/sizedRef"},
        "renewal_tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["old", "new"],
          "properties": {
            "old": {"$ref": "#/$defs/gitsha"},
            "new": {"$ref": "#/$defs/gitsha"}
          }
        },
        "no_rebuild": {"const": true},
        "declared_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "bibliography", "style"],
          "properties": {
            "primary": {"$ref": "#/$defs/ref"},
            "bibliography": {"$ref": "#/$defs/ref"},
            "style": {"$ref": "#/$defs/ref"}
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixed_steps"],
          "properties": {
            "fixed_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publication-pdf", "build-log", "pdf-digest"],
          "properties": {
            "publication-pdf": {"$ref": "#/$defs/sizedRef"},
            "build-log": {"$ref": "#/$defs/sizedRef"},
            "pdf-digest": {"$ref": "#/$defs/sizedRef"}
          }
        },
        "exit_code": {"const": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"variant": {"const": "REUSED_BUILD"}}},
          "then": {
            "required": ["original_record_ref", "original_pdf_ref", "original_log_ref", "original_digest_ref", "renewal_tools", "no_rebuild"],
            "not": {"anyOf": [{"required": ["declared_inputs"]}, {"required": ["recipe"]}, {"required": ["toolchain"]}, {"required": ["outputs"]}, {"required": ["exit_code"]}]}
          }
        },
        {
          "if": {"properties": {"variant": {"const": "EXECUTED_BUILD"}}},
          "then": {
            "required": ["declared_inputs", "recipe", "toolchain", "outputs", "exit_code"],
            "not": {"anyOf": [{"required": ["original_record_ref"]}, {"required": ["original_pdf_ref"]}, {"required": ["original_log_ref"]}, {"required": ["original_digest_ref"]}, {"required": ["renewal_tools"]}, {"required": ["no_rebuild"]}]}
          }
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "versions", "argv", "env"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "versions": {"$ref": "#/$defs/toolchainVersions"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "env": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {"type": "string"}
          }
        }
      }
    },
    "toolchainVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr", "returncode", "link_path", "real_path", "real_sha256"],
      "properties": {
        "stdout": {"type": "string", "maxLength": 8000},
        "stderr": {"type": "string", "maxLength": 8000},
        "returncode": {"type": "integer"},
        "link_path": {"type": "string", "minLength": 1},
        "real_path": {"type": "string", "minLength": 1},
        "real_sha256": {"$ref": "#/$defs/sha256"},
        "error": {"type": "string", "maxLength": 500},
        "biber_stdout": {"type": "string", "maxLength": 4000},
        "biber_returncode": {"type": "integer"},
        "biber_link_path": {"type": "string", "minLength": 1},
        "biber_real_path": {"type": "string", "minLength": 1},
        "biber_real_sha256": {"$ref": "#/$defs/sha256"},
        "biber_error": {"type": "string", "maxLength": 300},
        "latexmk_stdout": {"type": "string", "maxLength": 4000},
        "latexmk_returncode": {"type": "integer"},
        "latexmk_link_path": {"type": "string", "minLength": 1},
        "latexmk_real_path": {"type": "string", "minLength": 1},
        "latexmk_real_sha256": {"$ref": "#/$defs/sha256"},
        "latexmk_error": {"type": "string", "maxLength": 300}
      },
      "allOf": [
        {
          "if": {"required": ["biber_error"]},
          "then": {"not": {"anyOf": [{"required": ["biber_stdout"]}, {"required": ["biber_returncode"]}, {"required": ["biber_link_path"]}, {"required": ["biber_real_path"]}, {"required": ["biber_real_sha256"]}]}},
          "else": {"required": ["biber_stdout", "biber_returncode", "biber_link_path", "biber_real_path", "biber_real_sha256"]}
        },
        {
          "if": {"required": ["latexmk_error"]},
          "then": {"not": {"anyOf": [{"required": ["latexmk_stdout"]}, {"required": ["latexmk_returncode"]}, {"required": ["latexmk_link_path"]}, {"required": ["latexmk_real_path"]}, {"required": ["latexmk_real_sha256"]}]}},
          "else": {"required": ["latexmk_stdout", "latexmk_returncode", "latexmk_link_path", "latexmk_real_path", "latexmk_real_sha256"]}
        }
      ]
    },
    "pdfRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "page_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}

