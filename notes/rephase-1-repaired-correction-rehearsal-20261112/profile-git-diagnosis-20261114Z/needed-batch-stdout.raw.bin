    "authoring_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "accepted_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedRow"},
      "uniqueItems": true
    },
    "current_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit_sha", "contract", "closure"],
      "properties": {
        "repository_commit_sha": {"$ref": "#/$defs/gitsha"},
        "contract": {"$ref": "#/$defs/contract8"},
        "closure": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/namedRow"},
          "uniqueItems": true
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "bibliography", "style"],
      "properties": {
        "primary": {"$ref": "#/$defs/sizedRef"},
        "bibliography": {"$ref": "#/$defs/sizedRef"},
        "style": {"$ref": "#/$defs/sizedRef"}
      }
    },
    "build_record_ref": {"$ref": "#/$defs/ref"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sizedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "namedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract8": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_contract_version",
        "pipeline_contract_sha256",
        "quality_contract_version",
        "quality_contract_sha256",
        "research_profile_version",
        "research_profile_sha256",
